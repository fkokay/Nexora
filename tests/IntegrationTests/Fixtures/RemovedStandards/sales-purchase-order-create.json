{
  "screenKey": "sales-purchase-order-create", "title": "Yeni satınalma siparişi",
  "description": "Tedarikçiye doğrudan sipariş açın: başlık, stok satırları, alış fiyatı ve satır tutarları.", "module": "Satın Alma",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu (Siparişi kaydet)", "requires": ["component:siparisiAcDugmesi", "component:listeyeDonDugmesi", "query:olustur"]},
    "component:baslik": {"since": 1, "label": "Başlık"},
    "component:zorunluNotu": {"since": 1, "label": "Zorunlu alanlar notu"},
    "component:siparisBilgileri": {"since": 1, "label": "Kart bölümü: Sipariş", "requires": ["component:tedarikci", "component:siparisNo", "component:doviz", "component:siparisTarihi", "component:teslimTarihi", "component:depo"]},
    "component:tedarikci": {"since": 1, "label": "Alan: Tedarikçi", "requires": ["query:tedarikciler"]},
    "component:tedarikciTuru": {"since": 1, "label": "Tedarikçi seçici: cari türü (gizli)"},
    "component:tedarikciDurumu": {"since": 1, "label": "Tedarikçi seçici: durum (gizli)"},
    "component:siparisNo": {"since": 1, "label": "Alan: Sipariş no"},
    "component:doviz": {"since": 1, "label": "Alan: Döviz (tedarikçi dövizi)", "requires": ["component:tedarikci"]},
    "component:siparisTarihi": {"since": 1, "label": "Alan: Sipariş tarihi"},
    "component:teslimTarihi": {"since": 1, "label": "Alan: Beklenen teslim"},
    "component:depo": {"since": 1, "label": "Alan: Hedef depo", "requires": ["query:depolar"]},
    "component:notKarti": {"since": 1, "label": "Kart bölümü: Not", "requires": ["component:siparisNotu"]},
    "component:siparisNotu": {"since": 1, "label": "Alan: Sipariş notu"},
    "component:kalemler": {"since": 1, "label": "Sipariş satırları", "requires": ["query:stoklar", "query:birimler"]},
    "component:toplamlar": {"since": 1, "label": "Sipariş toplamları", "requires": ["component:kalemler", "component:doviz"]},
    "component:hesapNotu": {"since": 1, "label": "Tutar hesabı notu"},
    "component:siparisiAcDugmesi": {"since": 1, "label": "Kayıttan sonra: siparişi aç", "requires": ["query:olustur"]},
    "component:listeyeDonDugmesi": {"since": 1, "label": "Sipariş listesine dön"},
    "query:tedarikciler": {"since": 1, "label": "Tedarikçi seçenekleri", "requires": ["component:tedarikci", "component:tedarikciTuru", "component:tedarikciDurumu"]},
    "query:depolar": {"since": 1, "label": "Depoları listele"},
    "query:stoklar": {"since": 1, "label": "Stok kartı arama", "requires": ["component:kalemler"]},
    "query:birimler": {"since": 1, "label": "Satırdaki stok kartının birimleri", "requires": ["component:kalemler"]},
    "query:olustur": {"since": 1, "label": "Satınalma siparişi oluştur",
      "requires": ["component:tedarikci", "component:siparisNo", "component:doviz", "component:siparisTarihi", "component:teslimTarihi", "component:depo",
                   "component:siparisNotu", "component:kalemler"]}
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "saveQuery": "olustur", "afterSaveButton": "siparisiAcDugmesi", "moreButtons": ["listeyeDonDugmesi"],
                   "hiddenCommands": ["new", "open", "delete", "filter", "print", "export"] } },
      { "id": "baslik", "type": "heading", "name": "baslik",
        "props": { "text": "Yeni satınalma siparişi", "pageTitle": true } },
      { "id": "zorunluNotu", "type": "text", "name": "zorunluNotu",
        "props": { "text": "* işaretli alanlar zorunludur. Döviz tedarikçi kartının dövizi olmalıdır; tedarikçi seçilince kartın dövizi gelir." } },

      { "id": "siparisBilgileri", "type": "formCard", "name": "siparisBilgileri",
        "props": { "title": "Sipariş", "columns": 3, "width": 12, "inputs": ["tedarikci", "siparisNo", "doviz", "siparisTarihi", "teslimTarihi", "depo"] } },
      { "id": "tedarikci", "type": "input", "name": "tedarikci",
        "props": { "inputType": "lookup", "label": "Tedarikçi", "required": true, "optionsQuery": "tedarikciler", "optionValueColumn": "id",
                   "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0 } },
      { "id": "tedarikciTuru", "type": "input", "name": "tedarikciTuru",
        "props": { "inputType": "text", "label": "Tedarikçi seçici cari türü", "hidden": true, "defaultValue": "Supplier,Both" } },
      { "id": "tedarikciDurumu", "type": "input", "name": "tedarikciDurumu",
        "props": { "inputType": "text", "label": "Tedarikçi seçici durumu", "hidden": true, "defaultValue": "Active" } },
      { "id": "siparisNo", "type": "input", "name": "siparisNo",
        "props": { "inputType": "text", "label": "Sipariş no", "required": true, "maxLength": 32, "upperCase": true, "placeholder": "Örn. PO-2026-001" } },
      { "id": "doviz", "type": "input", "name": "doviz",
        "props": { "inputType": "text", "label": "Döviz", "required": true, "maxLength": 3, "upperCase": true,
                   "pattern": "^[A-Z]{3}$", "patternMessage": "Üç harfli para birimi kodu girin (ör. TRY).", "placeholder": "TRY",
                   "defaultValue": "{{tedarikci.seciliSatir.currencyCode}}", "emptyDefault": "TRY" } },
      { "id": "siparisTarihi", "type": "input", "name": "siparisTarihi",
        "props": { "inputType": "date", "label": "Sipariş tarihi", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "teslimTarihi", "type": "input", "name": "teslimTarihi",
        "props": { "inputType": "date", "label": "Beklenen teslim" } },
      { "id": "depo", "type": "input", "name": "depo",
        "props": { "inputType": "lookup", "label": "Hedef depo", "optionsQuery": "depolar", "optionValueColumn": "id", "optionLabelColumn": "name",
                   "optionDescriptionColumn": "code", "minChars": 0, "allowClear": true, "placeholder": "Mal kabulde seçilir",
                   "optionsWhen": "satir.isActive == true" } },

      { "id": "notKarti", "type": "formCard", "name": "notKarti",
        "props": { "title": "Not", "columns": 1, "width": 12, "inputs": ["siparisNotu"] } },
      { "id": "siparisNotu", "type": "input", "name": "siparisNotu",
        "props": { "inputType": "text", "label": "Sipariş notu", "maxLength": 1000, "placeholder": "Tedarikçiye iletilecek not" } },

      { "id": "kalemler", "type": "editableGrid", "name": "kalemler",
        "props": { "gridMode": "list", "title": "Sipariş satırları", "addLabel": "Satır ekle", "maxRows": 100, "minRows": 1,
                   "gridColumns": ["stockItemId|Stok kartı|lookup:stoklar:id:code:name|required",
                                   "unitCode|Birim|lookup:birimler:unitCode:unitCode",
                                   "quantity|Miktar|number|required,min:0.0001,step:0.0001",
                                   "unitPrice|Birim fiyat|number|required,min:0,step:0.0001",
                                   "discountPercent|İskonto %|number|min:0,max:100,step:0.01",
                                   "vatPercent|KDV %|number|min:0,max:100,step:0.01",
                                   "lineNet|Net tutar|number",
                                   "lineVat|KDV tutarı|number",
                                   "lineTotal|Satır toplamı|number"],
                   "columnOptionsWhen": ["stockItemId=satir.isActive == true", "unitCode=satir.isActive == true"],
                   "columnStaticOptions": ["unitCode==Ana birim"],
                   "lookupFills": { "stockItemId": { "unitCode": "unitCode", "unitPrice": "purchaseListPrice",
                                                     "discountPercent": "purchaseDiscountPercent", "vatPercent": "purchaseVatPercent" } },
                   "formulas": { "lineNet": "quantity * unitPrice - quantity * unitPrice * discountPercent / 100",
                                 "lineVat": "lineNet * vatPercent / 100",
                                 "lineTotal": "lineNet + lineVat" },
                   "totals": ["lineNet", "lineVat", "lineTotal"] } },
      { "id": "toplamlar", "type": "text", "name": "toplamlar",
        "props": { "title": "Toplamlar",
                   "text": "Satır: {{kalemler.satirSayisi}} · Net: {{kalemler.toplam.lineNet}} · KDV: {{kalemler.toplam.lineVat}} · Genel toplam: {{kalemler.toplam.lineTotal}} {{doviz.value}}" } },
      { "id": "hesapNotu", "type": "text", "name": "hesapNotu",
        "props": { "text": "Stok seçilince kartın alış fiyatı, alış iskontosu, alış KDV oranı ve birimi gelir; değiştirebilirsiniz. Tutarlar önizlemedir: sunucu her adımı iki ondalığa yuvarlayarak yeniden hesaplar, kuruş farkı olabilir." } },

      { "id": "siparisiAcDugmesi", "type": "button", "name": "siparisiAcDugmesi",
        "props": { "text": "Siparişi aç", "actionType": "erpPage", "pageKey": "sales-purchasing", "target": "sameTab",
                   "params": ["purchaseOrderId={{olustur.sonuc.id}}"] } },
      { "id": "listeyeDonDugmesi", "type": "button", "name": "listeyeDonDugmesi",
        "props": { "text": "Sipariş listesi", "actionType": "erpPage", "pageKey": "sales-purchasing", "target": "sameTab" } }
    ],
    "queries": [
      { "id": "tedarikciler", "name": "tedarikciler", "kind": "read", "operation": "cari.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{tedarikci.search}}", "type": "text" },
          { "name": "type", "binding": "{{tedarikciTuru.value}}", "type": "text" },
          { "name": "status", "binding": "{{tedarikciDurumu.value}}", "type": "text" } ] },
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "runOn": "load", "parameters": [] },
      { "id": "stoklar", "name": "stoklar", "kind": "read", "operation": "stok.kart.listele", "runOn": "load",
        "parameters": [ { "name": "q", "binding": "{{kalemler.arama}}", "type": "text" } ] },
      { "id": "birimler", "name": "birimler", "kind": "read", "operation": "stok.kart.birimleri", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{kalemler.satir.stockItemId}}", "type": "guid" } ] },
      { "id": "olustur", "name": "olustur", "kind": "insert", "operation": "satinalma.siparis.olustur", "runOn": "manual",
        "parameters": [
          { "name": "code", "binding": "{{siparisNo.value}}", "type": "text" },
          { "name": "supplierId", "binding": "{{tedarikci.value}}", "type": "guid" },
          { "name": "orderDate", "binding": "{{siparisTarihi.value}}", "type": "date" },
          { "name": "currencyCode", "binding": "{{doviz.value}}", "type": "text" },
          { "name": "notes", "binding": "{{siparisNotu.value}}", "type": "text" },
          { "name": "expectedReceiptDate", "binding": "{{teslimTarihi.value}}", "type": "date" },
          { "name": "targetWarehouseId", "binding": "{{depo.value}}", "type": "guid" },
          { "name": "lines", "binding": "{{kalemler.satirlar}}", "type": "list" } ] }
    ]
  }
}
