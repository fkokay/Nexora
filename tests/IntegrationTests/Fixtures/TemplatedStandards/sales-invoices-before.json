{
  "schemaVersion": 2,
  "components": [
    {
      "id": "komutlar",
      "type": "actionBar",
      "name": "komutlar",
      "props": {
        "newButton": "yeniDugmesi",
        "openButton": "acDugmesi",
        "deleteQuery": "faturaSil",
        "deleteConfirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.customerName}} faturası silinsin mi?",
        "focusInput": "suzgec",
        "exportTable": "liste",
        "titleCount": "{{faturalar.meta.totalCount}}",
        "moreButtons": [
          "iptalMenu"
        ],
        "commandWhen": [
          "delete=kullanici.rol == 'TenantAdmin' && liste.seciliSatir.status == 'Voided'"
        ],
        "hiddenCommands": [
          "save",
          "print"
        ]
      }
    },
    {
      "id": "yeniDugmesi",
      "type": "button",
      "name": "yeniDugmesi",
      "props": {
        "text": "Yeni fatura",
        "actionType": "erpPage",
        "pageKey": "sales-invoice-create",
        "target": "newTab",
        "legacyScreen": true,
        "params": [
          "customerId={{sayfa.parametre.customerId}}"
        ]
      }
    },
    {
      "id": "acDugmesi",
      "type": "button",
      "name": "acDugmesi",
      "props": {
        "text": "Aç",
        "icon": "open",
        "actionType": "openDialog",
        "dialogId": "faturaPenceresi",
        "disabledWhen": "liste.seciliSatir.id == null",
        "disabledReason": "Önce bir kayıt seçin"
      }
    },
    {
      "id": "iptalMenu",
      "type": "button",
      "name": "iptalMenu",
      "props": {
        "text": "İptal et",
        "actionType": "query",
        "queryId": "faturaIptal",
        "confirmEnabled": true,
        "confirmText": "“{{fatura.rows[0].code}}” iptal edilecek ve cari hareketi ters kayıtla kapatılacak.",
        "visibleWhen": "kullanici.rol == 'TenantAdmin' && liste.seciliSatir.status == 'Posted'",
        "disabledWhen": "fatura.rows[0].id != liste.seciliSatir.id",
        "disabledReason": "Fatura yükleniyor…",
        "successMessage": "Fatura iptal edildi; cari hareketi ters kayıtla kapatıldı.",
        "refreshQueries": [
          "faturalar",
          "fatura"
        ]
      }
    },
    {
      "id": "kesilenGostergesi",
      "type": "metric",
      "name": "kesilenGostergesi",
      "props": {
        "title": "Kesilen",
        "value": "{{faturalar.meta.pageGrandTotal}}",
        "format": "money",
        "width": 3,
        "icon": "receipt",
        "variant": "success",
        "description": "{{faturalar.meta.pagePostedCount}} fatura · bu sayfa · {{faturalar.meta.pageCurrencyCode}}",
        "visibleWhen": "faturalar.meta.pageMixedCurrencies != true"
      }
    },
    {
      "id": "kesilenKarisik",
      "type": "metric",
      "name": "kesilenKarisik",
      "props": {
        "title": "Kesilen",
        "value": "—",
        "width": 3,
        "icon": "receipt",
        "description": "{{faturalar.meta.pagePostedCount}} fatura · bu sayfa · birden çok para birimi",
        "visibleWhen": "faturalar.meta.pageMixedCurrencies == true"
      }
    },
    {
      "id": "iptalGostergesi",
      "type": "metric",
      "name": "iptalGostergesi",
      "props": {
        "title": "İptal",
        "query": "faturalar",
        "countWhen": "faturalar.satir.status == 'Voided'",
        "format": "number",
        "width": 3,
        "icon": "ban",
        "description": "bu sayfa"
      }
    },
    {
      "id": "cariNotu",
      "type": "alert",
      "name": "cariNotu",
      "props": {
        "variant": "info",
        "title": "Seçili carinin faturaları gösteriliyor.",
        "width": 12,
        "visibleWhen": "sayfa.parametre.customerId != null"
      }
    },
    {
      "id": "suzgec",
      "type": "filterBar",
      "name": "suzgec",
      "props": {
        "table": "liste",
        "width": 10,
        "search": true,
        "searchPlaceholder": "Fatura no veya müşteriyle ara",
        "searchParam": "q"
      }
    },
    {
      "id": "liste",
      "type": "dataTable",
      "name": "liste",
      "props": {
        "title": "Satış faturaları",
        "query": "faturalar",
        "paging": "server",
        "pageSize": 25,
        "width": 12,
        "columns": [
          "code",
          "deliveryCode",
          "orderCode",
          "customerName",
          "invoiceDate",
          "lineCount",
          "grandTotal",
          "status"
        ],
        "columnLabels": [
          "code=Fatura no",
          "deliveryCode=İrsaliye",
          "orderCode=Sipariş",
          "customerName=Müşteri",
          "invoiceDate=Fatura tarihi",
          "lineCount=Satır",
          "grandTotal=Genel toplam",
          "status=Durum",
          "customerTaxNumber=Müşteri vergi no",
          "invoiceType=Fatura türü",
          "currencyCode=Döviz",
          "createdAt=Oluşturulma"
        ],
        "columnFormats": [
          "code=code",
          "deliveryCode=code",
          "orderCode=code",
          "invoiceDate=date",
          "lineCount=number",
          "grandTotal=money",
          "status=status",
          "createdAt=date"
        ],
        "columnUnits": [
          "grandTotal=currencyCode"
        ],
        "valueLabels": [
          "status:Posted=Kesildi",
          "status:Voided=İptal",
          "invoiceType:Wholesale=Toptan · KDV hariç",
          "invoiceType:Retail=Perakende · KDV dâhil"
        ],
        "toneMap": [
          "Kesildi=success",
          "İptal=info"
        ],
        "rowOpenAction": "acDugmesi",
        "openParam": "invoiceId",
        "emptyText": "Aramanızla eşleşen fatura yok."
      }
    },
    {
      "id": "faturaPenceresi",
      "type": "dialog",
      "name": "faturaPenceresi",
      "props": {
        "presentation": "dialog",
        "size": "xl",
        "title": "Satış faturası · {{fatura.rows[0].code}}",
        "contains": [
          "faturaBasligi",
          "faturaDurumu",
          "faturaSekmeleri"
        ]
      }
    },
    {
      "id": "faturaBasligi",
      "type": "recordHeader",
      "name": "faturaBasligi",
      "props": {
        "icon": "receipt",
        "title": "{{fatura.rows[0].code}} · {{fatura.rows[0].customerName}}",
        "subtitle": "{{fatura.rows[0].invoiceDate}} · irsaliye {{fatura.rows[0].deliveryCode}} · sipariş {{fatura.rows[0].orderCode}}",
        "fields": [
          "Genel toplam={{fatura.rows[0].grandTotal}}",
          "Ara toplam={{fatura.rows[0].subtotal}}",
          "KDV={{fatura.rows[0].taxTotal}}",
          "Tahsil edilen={{fatura.rows[0].paidAmount}}",
          "İade edilen={{fatura.rows[0].returnedAmount}}",
          "Açık bakiye={{fatura.rows[0].outstandingAmount}}"
        ],
        "fieldFormats": [
          "Genel toplam=money",
          "Ara toplam=money",
          "KDV=money",
          "Tahsil edilen=money",
          "İade edilen=money",
          "Açık bakiye=money"
        ],
        "fieldUnits": [
          "Genel toplam={{fatura.rows[0].currencyCode}}",
          "Ara toplam={{fatura.rows[0].currencyCode}}",
          "KDV={{fatura.rows[0].currencyCode}}",
          "Tahsil edilen={{fatura.rows[0].currencyCode}}",
          "İade edilen={{fatura.rows[0].currencyCode}}",
          "Açık bakiye={{fatura.rows[0].currencyCode}}"
        ],
        "buttons": [
          "faturaIptalDugmesi",
          "iadeEkleDugmesi"
        ]
      }
    },
    {
      "id": "faturaIptalDugmesi",
      "type": "button",
      "name": "faturaIptalDugmesi",
      "props": {
        "text": "Faturayı iptal et",
        "actionType": "query",
        "queryId": "faturaIptal",
        "confirmEnabled": true,
        "confirmText": "“{{fatura.rows[0].code}}” iptal edilecek ve cari hareketi ters kayıtla kapatılacak.",
        "visibleWhen": "kullanici.rol == 'TenantAdmin' && fatura.rows[0].status == 'Posted'",
        "disabledWhen": "fatura.rows[0].paidAmount > 0 || fatura.rows[0].returnedAmount > 0",
        "disabledReason": "Önce tahsilat ve iadeleri iptal edin.",
        "successMessage": "Fatura iptal edildi; cari hareketi ters kayıtla kapatıldı.",
        "refreshQueries": [
          "fatura",
          "faturalar"
        ]
      }
    },
    {
      "id": "iadeEkleDugmesi",
      "type": "button",
      "name": "iadeEkleDugmesi",
      "props": {
        "text": "İade ekle ›",
        "actionType": "erpPage",
        "pageKey": "sales-invoices",
        "target": "sameTab",
        "legacyScreen": true,
        "params": [
          "invoiceId={{fatura.rows[0].id}}"
        ],
        "visibleWhen": "fatura.rows[0].status == 'Posted'"
      }
    },
    {
      "id": "faturaDurumu",
      "type": "section",
      "name": "faturaDurumu",
      "props": {
        "width": 12
      },
      "children": [
        {
          "id": "rozetKesildi",
          "type": "badge",
          "name": "rozetKesildi",
          "props": {
            "text": "Kesildi",
            "variant": "success",
            "visibleWhen": "fatura.rows[0].status == 'Posted'"
          }
        },
        {
          "id": "rozetIptal",
          "type": "badge",
          "name": "rozetIptal",
          "props": {
            "text": "İptal",
            "variant": "info",
            "visibleWhen": "fatura.rows[0].status == 'Voided'"
          }
        },
        {
          "id": "rozetTur",
          "type": "badge",
          "name": "rozetTur",
          "props": {
            "text": "{{fatura.rows[0].invoiceType}}",
            "variant": "info",
            "visibleWhen": "fatura.rows[0].id != null"
          }
        },
        {
          "id": "eBelgeOzeti",
          "type": "text",
          "name": "eBelgeOzeti",
          "props": {
            "text": "E-belge: {{fatura.rows[0].eDocumentScenario}} {{fatura.rows[0].eDocumentTypeCode}} {{fatura.rows[0].eDocumentRecipientAlias}}",
            "visibleWhen": "fatura.rows[0].eDocumentScenario != null"
          }
        },
        {
          "id": "faturaNotuMetni",
          "type": "text",
          "name": "faturaNotuMetni",
          "props": {
            "text": "Not: {{fatura.rows[0].notes}}",
            "visibleWhen": "fatura.rows[0].notes != null"
          }
        },
        {
          "id": "detayIrsaliyeAc",
          "type": "button",
          "name": "detayIrsaliyeAc",
          "props": {
            "text": "Siparişi aç ›",
            "actionType": "erpPage",
            "pageKey": "sales-orders",
            "target": "newTab",
            "params": [
              "orderId={{fatura.rows[0].orderId}}"
            ],
            "visibleWhen": "fatura.rows[0].orderId != null"
          }
        }
      ]
    },
    {
      "id": "faturaSekmeleri",
      "type": "tabs",
      "name": "faturaSekmeleri",
      "props": {
        "tabs": [
          "Satırlar {{satirlar.satirSayisi}}=satirTablosu",
          "Tahsilatlar {{tahsilatlar.satirSayisi}}=tahsilatBolumu",
          "İadeler {{iadeler.satirSayisi}}=iadeTablosu"
        ]
      }
    },
    {
      "id": "satirTablosu",
      "type": "dataTable",
      "name": "satirTablosu",
      "props": {
        "title": "Fatura satırları",
        "query": "satirlar",
        "width": 12,
        "showGridSearch": false,
        "showColumnFilters": false,
        "showColumnChooser": false,
        "showExport": false,
        "showPivot": false,
        "showCsv": false,
        "showSelectedExport": false,
        "columns": [
          "orderLineNumber",
          "stockCode",
          "stockName",
          "quantity",
          "unitPrice",
          "discountAmount",
          "discountPercent",
          "taxAmount",
          "vatPercent",
          "lineTotal"
        ],
        "columnLabels": [
          "orderLineNumber=#",
          "stockCode=Stok kodu",
          "stockName=Stok adı",
          "quantity=Miktar",
          "unitPrice=Birim fiyat",
          "discountAmount=İskonto",
          "discountPercent=İsk. %",
          "taxAmount=KDV",
          "vatPercent=KDV %",
          "lineTotal=Toplam"
        ],
        "columnFormats": [
          "stockCode=code",
          "orderLineNumber=number",
          "quantity=number",
          "unitPrice=money",
          "discountAmount=money",
          "discountPercent=number",
          "taxAmount=money",
          "vatPercent=number",
          "lineTotal=money"
        ],
        "columnUnits": [
          "quantity=unitCode"
        ],
        "totals": [
          "discountAmount",
          "taxAmount",
          "lineTotal"
        ],
        "emptyText": "Fatura satırı yok."
      }
    },
    {
      "id": "tahsilatBolumu",
      "type": "section",
      "name": "tahsilatBolumu",
      "props": {
        "width": 12
      },
      "children": [
        {
          "id": "tahsilatFormu",
          "type": "formCard",
          "name": "tahsilatFormu",
          "props": {
            "title": "Tahsilat ekle",
            "columns": 3,
            "inputs": [
              "tahsilatTarihi",
              "tahsilatTutari",
              "odemeYontemi",
              "finansHesabi",
              "tahsilatReferansi",
              "tahsilatKimligi"
            ],
            "visibleWhen": "fatura.rows[0].status == 'Posted' && fatura.rows[0].outstandingAmount > 0"
          }
        },
        {
          "id": "tahsilatEkleDugmesi",
          "type": "button",
          "name": "tahsilatEkleDugmesi",
          "props": {
            "text": "Tahsilatı kaydet",
            "actionType": "query",
            "queryId": "tahsilatEkle",
            "visibleWhen": "fatura.rows[0].status == 'Posted' && fatura.rows[0].outstandingAmount > 0",
            "successMessage": "Tahsilat kaydedildi; cari alacak ve kasa / banka girişi yazıldı.",
            "refreshQueries": [
              "fatura",
              "tahsilatlar",
              "faturalar"
            ]
          }
        },
        {
          "id": "tahsilatTablosu",
          "type": "dataTable",
          "name": "tahsilatTablosu",
          "props": {
            "title": "Tahsilatlar",
            "query": "tahsilatlar",
            "width": 12,
            "showGridSearch": false,
            "showColumnFilters": false,
            "showColumnChooser": false,
            "showExport": false,
            "showPivot": false,
            "showCsv": false,
            "showSelectedExport": false,
            "columns": [
              "code",
              "collectionDate",
              "paymentMethod",
              "reference",
              "financialAccountName",
              "amount",
              "status"
            ],
            "columnLabels": [
              "code=Fiş no",
              "collectionDate=Tarih",
              "paymentMethod=Yöntem",
              "reference=Referans",
              "financialAccountName=Kasa / banka",
              "amount=Tutar",
              "status=Durum",
              "createdAt=Oluşturulma"
            ],
            "columnFormats": [
              "code=code",
              "collectionDate=date",
              "amount=money",
              "status=status",
              "createdAt=date"
            ],
            "columnUnits": [
              "amount=currencyCode"
            ],
            "valueLabels": [
              "paymentMethod:Bank transfer=Havale/EFT",
              "paymentMethod:Cash=Nakit",
              "paymentMethod:Card=Kart",
              "paymentMethod:Check=Çek",
              "status:Posted=Alındı",
              "status:Voided=İptal"
            ],
            "toneMap": [
              "Alındı=success",
              "İptal=info"
            ],
            "rowActions": [
              "tahsilatIptalDugmesi"
            ],
            "emptyText": "Henüz tahsilat yok."
          }
        }
      ]
    },
    {
      "id": "tahsilatTarihi",
      "type": "input",
      "name": "tahsilatTarihi",
      "props": {
        "inputType": "date",
        "label": "Tahsilat tarihi",
        "required": true,
        "defaultValue": "{{bugun}}"
      }
    },
    {
      "id": "tahsilatTutari",
      "type": "input",
      "name": "tahsilatTutari",
      "props": {
        "inputType": "number",
        "label": "Tutar · {{fatura.rows[0].currencyCode}}",
        "required": true,
        "min": 0.01,
        "step": 0.01,
        "defaultValue": "{{fatura.rows[0].outstandingAmount}}"
      }
    },
    {
      "id": "odemeYontemi",
      "type": "input",
      "name": "odemeYontemi",
      "props": {
        "inputType": "select",
        "label": "Ödeme yöntemi",
        "required": true,
        "defaultValue": "Bank transfer",
        "staticOptions": [
          "Bank transfer=Havale/EFT",
          "Cash=Nakit",
          "Card=Kart",
          "Check=Çek"
        ],
        "clearsOnChange": [
          "finansHesabi"
        ]
      }
    },
    {
      "id": "finansHesabi",
      "type": "input",
      "name": "finansHesabi",
      "props": {
        "inputType": "lookup",
        "label": "Kasa / banka hesabı",
        "optionsQuery": "hesaplar",
        "optionValueColumn": "id",
        "optionLabelColumn": "name",
        "optionDescriptionColumn": "code",
        "minChars": 0,
        "optionsWhen": "satir.isActive == true && satir.currencyCode == fatura.rows[0].currencyCode",
        "visibleWhen": "odemeYontemi.value == 'Cash' || odemeYontemi.value == 'Bank transfer'",
        "requiredWhen": "odemeYontemi.value == 'Cash' || odemeYontemi.value == 'Bank transfer'"
      }
    },
    {
      "id": "tahsilatReferansi",
      "type": "input",
      "name": "tahsilatReferansi",
      "props": {
        "inputType": "text",
        "label": "Referans",
        "maxLength": 100
      }
    },
    {
      "id": "tahsilatKimligi",
      "type": "input",
      "name": "tahsilatKimligi",
      "props": {
        "inputType": "text",
        "label": "Tekrar deneme kimliği",
        "hidden": true,
        "autoId": true
      }
    },
    {
      "id": "tahsilatIptalDugmesi",
      "type": "button",
      "name": "tahsilatIptalDugmesi",
      "props": {
        "text": "İptal et",
        "actionType": "query",
        "queryId": "tahsilatIptal",
        "confirmEnabled": true,
        "confirmText": "“{{tahsilatTablosu.seciliSatir.code}}” tahsilatı iptal edilsin mi? Cari alacak ve kasa / banka hareketi ters kayıtla kapatılır.",
        "visibleWhen": "tahsilatTablosu.seciliSatir.status == 'Posted'",
        "successMessage": "Tahsilat iptal edildi.",
        "refreshQueries": [
          "fatura",
          "tahsilatlar",
          "faturalar"
        ]
      }
    },
    {
      "id": "iadeTablosu",
      "type": "dataTable",
      "name": "iadeTablosu",
      "props": {
        "title": "Satış iadeleri",
        "query": "iadeler",
        "width": 12,
        "showGridSearch": false,
        "showColumnFilters": false,
        "showColumnChooser": false,
        "showExport": false,
        "showPivot": false,
        "showCsv": false,
        "showSelectedExport": false,
        "columns": [
          "code",
          "returnDate",
          "warehouseName",
          "lineCount",
          "grandTotal",
          "status"
        ],
        "columnLabels": [
          "code=İade no",
          "returnDate=Tarih",
          "warehouseName=Depo",
          "lineCount=Satır",
          "grandTotal=Tutar",
          "status=Durum"
        ],
        "columnFormats": [
          "code=code",
          "returnDate=date",
          "lineCount=number",
          "grandTotal=money",
          "status=status"
        ],
        "valueLabels": [
          "status:Posted=İşlendi",
          "status:Voided=İptal"
        ],
        "toneMap": [
          "İşlendi=success",
          "İptal=info"
        ],
        "rowActions": [
          "iadeIptalDugmesi"
        ],
        "emptyText": "Satış iadesi yok. İade eklemek için “İade ekle” eski ekranı açar."
      }
    },
    {
      "id": "iadeIptalDugmesi",
      "type": "button",
      "name": "iadeIptalDugmesi",
      "props": {
        "text": "İptal et",
        "actionType": "query",
        "queryId": "iadeIptal",
        "confirmEnabled": true,
        "confirmText": "“{{iadeTablosu.seciliSatir.code}}” iadesi iptal edilsin mi? Stok girişi ve cari alacak ters kayıtla kapatılır.",
        "visibleWhen": "iadeTablosu.seciliSatir.status == 'Posted'",
        "successMessage": "İade iptal edildi.",
        "refreshQueries": [
          "fatura",
          "iadeler",
          "faturalar"
        ]
      }
    }
  ],
  "queries": [
    {
      "id": "faturalar",
      "name": "faturalar",
      "kind": "read",
      "operation": "satis.fatura.listele",
      "runOn": "load",
      "parameters": [
        {
          "name": "q",
          "binding": "{{suzgec.q}}",
          "type": "text"
        },
        {
          "name": "customerId",
          "binding": "{{sayfa.parametre.customerId}}",
          "type": "guid"
        },
        {
          "name": "page",
          "binding": "{{liste.sayfa}}",
          "type": "int"
        },
        {
          "name": "pageSize",
          "binding": "{{liste.sayfaBoyutu}}",
          "type": "int"
        }
      ]
    },
    {
      "id": "fatura",
      "name": "fatura",
      "kind": "read",
      "operation": "satis.fatura.getir",
      "runOn": "load",
      "parameters": [
        {
          "name": "id",
          "binding": "{{liste.seciliSatir.id}}",
          "type": "guid"
        }
      ]
    },
    {
      "id": "satirlar",
      "name": "satirlar",
      "kind": "read",
      "operation": "satis.fatura.satirlari",
      "runOn": "load",
      "parameters": [
        {
          "name": "id",
          "binding": "{{liste.seciliSatir.id}}",
          "type": "guid"
        }
      ]
    },
    {
