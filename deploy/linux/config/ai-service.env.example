# Copy to /etc/nexora/ai-service.env, replace every CHANGE_ME value, then chmod 600.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5081
ConnectionStrings__Platform=Server=sql.example.com,1433;Database=AIERPPlatform;User Id=aierp_runtime;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
# AIERPStudio is the shared Studio/control database; ERP company data lives in its own tenant database.
ConnectionStrings__AIStudio=Server=sql.example.com,1433;Database=AIERPStudio;User Id=aierp_data_runtime;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
Database__SeparationEnabled=true
Authentication__Issuer=AIERP
Authentication__Audience=AIERP
Authentication__SigningKey=CHANGE_ME_USE_THE_SAME_VALUE_AS_PLATFORM_API
PlatformApi__BaseUrl=http://127.0.0.1:5080
WorkspaceRunner__BaseUrl=
ReleaseDeployer__BaseUrl=
Frontend__Origins__0=https://erp.example.com
Frontend__Origins__1=https://studio.example.com
