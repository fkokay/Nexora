# Copy to /etc/nexora/platform-api.env, replace every CHANGE_ME value, then chmod 600.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
ConnectionStrings__Platform=Server=sql.example.com,1433;Database=AIERPPlatform;User Id=aierp_runtime;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
# New deployments must provision per-company AIERPTenant_<tenant-guid> and AIERPStudio_<tenant-guid> databases before starting.
# The router replaces the database name in this base connection string from the ready tenant catalog entry.
# Endpoint/TLS template only. Per-company SQL credentials are read from Vault.
ConnectionStrings__Tenant=Server=sql.example.com,1433;Database=AIERPPlatform;Encrypt=True;TrustServerCertificate=False
# Endpoint/TLS template only; per-company Studio SQL credentials are read from Vault.
ConnectionStrings__AIStudio=Server=sql.example.com,1433;Database=AIERPStudio;Encrypt=True;TrustServerCertificate=False
Database__SeparationEnabled=true
Vault__Address=https://vault.example.internal
Vault__Mount=secret
Vault__TenantSqlCredentialReader__RoleIdFile=/etc/nexora/secrets/vault_tenant_sql_reader_role_id
Vault__TenantSqlCredentialReader__SecretIdFile=/etc/nexora/secrets/vault_tenant_sql_reader_secret_id
Vault__AllowHttpForLocalDevelopment=false
Authentication__Issuer=AIERP
Authentication__Audience=AIERP
Authentication__SigningKey=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
PluginHost__SigningKey=CHANGE_ME_DIFFERENT_SECRET_AT_LEAST_32_BYTES
# Optional when integration queue encryption is enabled; base64 of exactly 32 random bytes.
# IntegrationQueue__EncryptionKey=
AIService__BaseUrl=http://127.0.0.1:5081
PluginHost__BaseUrl=
IntegrationHost__BaseUrl=
Frontend__Origins__0=https://erp.example.com
Frontend__Origins__1=https://studio.example.com
