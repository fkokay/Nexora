<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ACME HTTP-01 challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/(.*)$" />
          <action type="None" />
        </rule>
        <rule name="Redirect public HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Nexora ERP frontend" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^nexoraerp\.ozgurteknolojiyazilim\.com(?::\d+)?$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5173/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="Nexora Development Studio frontend" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^nexorastudio\.ozgurteknolojiyazilim\.com(?::\d+)?$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5174/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="Nexora Platform API" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^nexoraapi\.ozgurteknolojiyazilim\.com(?::\d+)?$" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5080/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
