<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\AIERP.Api.dll" stdoutLogEnabled="false" hostingModel="outofprocess" requestTimeout="00:02:00">
      <environmentVariables />
    </aspNetCore>
  </system.webServer>
</configuration>
