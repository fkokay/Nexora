<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\AIERP.AIService.dll" stdoutLogEnabled="false" hostingModel="outofprocess" requestTimeout="00:04:00">
      <environmentVariables />
    </aspNetCore>
  </system.webServer>
</configuration>
