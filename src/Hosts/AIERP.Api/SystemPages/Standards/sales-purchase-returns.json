{
  "screenKey": "sales-purchase-returns", "title": "Satınalma İadeleri",
  "description": "Tedarikçilere geri gönderilen ürünler. İade stoktan düşülür ve tedarikçi borcunu azaltır.", "module": "Satın Alma",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:yeniIadeDugmesi", "component:acDugmesi", "component:iptalMenuDugmesi", "component:faturaAcDugmesi", "component:eskiEkranDugmesi", "query:iadeler"]},
    "component:olusturmaNotu": {"since": 1, "label": "İade oluşturma notu"},
    "component:iptalGostergesi": {"since": 1, "label": "İptal göstergesi (bu sayfa)", "requires": ["query:iadeler"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:gorunumKarti": {"since": 1, "label": "Detay paneli anahtarı kartı", "requires": ["component:detayPaneli"]},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:liste": {"since": 1, "label": "Alış iadeleri listesi", "requires": ["component:detayPaneli", "component:acDugmesi", "component:iptalSatir", "query:iadeler"]},
    "component:acDugmesi": {"since": 1, "label": "Belgeyi aç komutu", "requires": ["component:belgePenceresi", "component:liste"]},
    "component:iptalSatir": {"since": 1, "label": "İptal et satır düğmesi", "requires": ["component:liste", "query:iadeIptalSatir", "query:iadeler"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:ozetPaneli", "component:panelZinciri", "component:panelSatirlari", "component:belgePenceresi", "query:iade"]},
    "component:ozetPaneli": {"since": 1, "label": "Detay: Özet", "requires": ["component:liste"]},
    "component:panelZinciri": {"since": 1, "label": "Detay: Belge zinciri", "requires": ["component:liste"]},
    "component:panelSatirlari": {"since": 1, "label": "Detay: Satırlar", "requires": ["query:iadeSatirlari"]},
    "component:belgePenceresi": {"since": 1, "label": "Alış iadesi belgesi", "requires": ["component:belgeBasligi", "component:belgeTutarlari", "component:belgeAkisi", "component:belgeSatirlari", "component:islendiNotu", "component:iptalNotu"]},
    "component:belgeBasligi": {"since": 1, "label": "Belge: İade bilgileri", "requires": ["query:iade"]},
    "component:belgeTutarlari": {"since": 1, "label": "Belge: Toplamlar", "requires": ["query:iade"]},
    "component:belgeAkisi": {"since": 1, "label": "Belge: Durum akışı", "requires": ["query:iade"]},
    "component:belgeSatirlari": {"since": 1, "label": "Belge: Satırlar", "requires": ["query:iadeSatirlari"]},
    "component:islendiNotu": {"since": 1, "label": "Belge: İşlenmiş iade notu", "requires": ["query:iade"]},
    "component:iptalNotu": {"since": 1, "label": "Belge: İptal edilmiş iade notu", "requires": ["query:iade"]},
    "component:yeniIadeDugmesi": {"since": 1, "label": "Yeni iade komutu (eski fatura ekranı)", "requires": ["component:liste"]},
    "component:iptalMenuDugmesi": {"since": 1, "label": "İptal et komutu", "requires": ["component:liste", "query:iadeIptal", "query:iadeler", "query:iade"]},
    "component:faturaAcDugmesi": {"since": 1, "label": "Faturayı aç komutu (eski ekran)", "requires": ["component:liste"]},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Eski ekranda aç komutu"},
    "query:iadeler": {"since": 1, "label": "Alış iadelerini listele", "requires": ["component:suzgec", "component:liste"]},
    "query:iade": {"since": 1, "label": "Seçili alış iadesi", "requires": ["component:liste"]},
    "query:iadeSatirlari": {"since": 1, "label": "Seçili iadenin satırları", "requires": ["component:liste"]},
    "query:iadeIptal": {"since": 1, "label": "Alış iadesini iptal et (menü)", "requires": ["query:iade"]},
    "query:iadeIptalSatir": {"since": 1, "label": "Alış iadesini iptal et (satır)", "requires": ["component:liste"]}
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "newButton": "yeniIadeDugmesi", "openButton": "acDugmesi", "focusInput": "suzgec", "exportTable": "liste",
                   "titleCount": "{{iadeler.meta.totalCount}}",
                   "moreButtons": ["iptalMenuDugmesi", "faturaAcDugmesi", "eskiEkranDugmesi"],
                   "hiddenCommands": ["save", "delete", "print"] } },
      { "id": "olusturmaNotu", "type": "text", "name": "olusturmaNotu",
        "props": { "text": "İade, alış faturasının detayından oluşturulur.", "width": 9 } },
      { "id": "iptalGostergesi", "type": "metric", "name": "iptalGostergesi",
        "props": { "title": "İptal", "query": "iadeler", "countWhen": "iadeler.satir.status == 'Voided'", "icon": "ban",
                   "description": "bu sayfa", "width": 3 } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 10, "search": true, "searchPlaceholder": "İade no, fatura veya tedarikçi ara", "searchParam": "q" } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": { "title": "Görünüm", "layout": "inline", "width": 2, "inputs": ["detayPaneli"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Alış iadeleri", "query": "iadeler", "paging": "server", "pageSize": 25, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.id != null",
                   "columns": ["code", "returnDate", "supplierName", "invoiceCode", "warehouseName", "lineCount", "grandTotal", "status"],
                   "columnLabels": ["code=İade no", "returnDate=Tarih", "supplierName=Tedarikçi", "invoiceCode=Fatura", "warehouseName=Depo",
                                    "lineCount=Satır", "grandTotal=Tutar", "status=Durum", "currencyCode=Döviz", "createdAt=Oluşturulma"],
                   "columnUnits": ["grandTotal=currencyCode"],
                   "columnFormats": ["code=code", "returnDate=date", "invoiceCode=code", "lineCount=number", "grandTotal=money", "status=status",
                                     "createdAt=date"],
                   "valueLabels": ["status:Posted=İşlendi", "status:Voided=İptal"],
                   "toneMap": ["İşlendi=success", "İptal=info"],
                   "rowActions": ["acDugmesi", "iptalSatir"], "rowOpenAction": "acDugmesi",
                   "emptyText": "Henüz alış iadesi yok. İade, kayıtlı bir alış faturasının detayından oluşturulur." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "openDialog", "dialogId": "belgePenceresi",
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "iptalSatir", "type": "button", "name": "iptalSatir",
        "props": { "text": "İptal et", "actionType": "query", "queryId": "iadeIptalSatir", "confirmEnabled": true,
                   "confirmText": "{{liste.seciliSatir.code}} alış iadesi iptal edilsin mi? Stok ve cari hareketleri ters kaydedilecek.",
                   "successMessage": "Alış iadesi iptal edildi; stok ve cari kayıtları ters hareketle korundu.",
                   "errorMessage": "Alış iadesi iptal edilemedi.", "refreshQueries": ["iadeler", "iade"],
                   "visibleWhen": "liste.seciliSatir.status == 'Posted'" } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.code}}", "description": "{{liste.seciliSatir.supplierName}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayIslendi", "type": "badge", "name": "detayIslendi",
            "props": { "text": "İşlendi", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Posted'" } },
          { "id": "detayIptal", "type": "badge", "name": "detayIptal",
            "props": { "text": "İptal", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Voided'" } },
          { "id": "genelToplamGostergesi", "type": "metric", "name": "genelToplamGostergesi",
            "props": { "title": "Genel toplam", "value": "{{iade.rows[0].grandTotal}}", "format": "money", "width": 6, "icon": "receipt",
                       "description": "{{iade.rows[0].currencyCode}}" } },
          { "id": "araToplamGostergesi", "type": "metric", "name": "araToplamGostergesi",
            "props": { "title": "Ara toplam", "value": "{{iade.rows[0].subtotal}}", "format": "money", "width": 6, "icon": "calculator",
                       "description": "{{iade.rows[0].currencyCode}}" } },
          { "id": "iskontoGostergesi", "type": "metric", "name": "iskontoGostergesi",
            "props": { "title": "İskonto", "value": "{{iade.rows[0].discountTotal}}", "format": "money", "width": 6, "icon": "percent",
                       "description": "{{iade.rows[0].currencyCode}}" } },
          { "id": "kdvGostergesi", "type": "metric", "name": "kdvGostergesi",
            "props": { "title": "KDV", "value": "{{iade.rows[0].taxTotal}}", "format": "money", "width": 6, "icon": "landmark",
                       "description": "{{iade.rows[0].currencyCode}}" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetPaneli,panelZinciri", "Satırlar=panelSatirlari"] } },
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Belgeyi aç ›", "actionType": "openDialog", "dialogId": "belgePenceresi" } }
        ] },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["returnDate=İade tarihi", "warehouseName=Depo", "invoiceCode=Alış faturası", "currencyCode=Döviz", "lineCount=Satır sayısı"] } },
      { "id": "panelZinciri", "type": "text", "name": "panelZinciri",
        "props": { "title": "Belge zinciri", "text": "Alış faturası {{liste.seciliSatir.invoiceCode}} → Bu iade {{liste.seciliSatir.code}}" } },
      { "id": "panelSatirlari", "type": "dataTable", "name": "panelSatirlari",
        "props": { "title": "Satırlar", "query": "iadeSatirlari", "width": 12, "showGridSearch": false, "showColumnFilters": false,
                   "showColumnChooser": false, "showExport": false, "showPivot": false, "showCsv": false, "showSelectedExport": false,
                   "columns": ["stockName", "quantity", "lineTotal"],
                   "columnLabels": ["stockName=Stok", "quantity=Miktar", "lineTotal=Toplam"],
                   "columnUnits": ["stockName=stockCode", "quantity=unitCode"],
                   "columnFormats": ["quantity=number", "lineTotal=money"],
                   "emptyText": "Satır yok." } },

      { "id": "belgePenceresi", "type": "dialog", "name": "belgePenceresi",
        "props": { "presentation": "dialog", "size": "xl", "title": "Alış iadesi · {{iade.rows[0].code}}",
                   "contains": ["belgeBasligi", "belgeTutarlari", "belgeAkisi", "belgeSatirlari", "islendiNotu", "iptalNotu"] } },
      { "id": "belgeBasligi", "type": "recordHeader", "name": "belgeBasligi",
        "props": { "icon": "truck", "title": "{{iade.rows[0].code}}", "subtitle": "{{iade.rows[0].supplierName}}",
                   "fields": ["İade tarihi={{iade.rows[0].returnDate}}", "İadenin çıktığı depo={{iade.rows[0].warehouseName}}",
                              "Kaynak fatura={{iade.rows[0].invoiceCode}}", "Para birimi={{iade.rows[0].currencyCode}}"],
                   "fieldFormats": ["İade tarihi=date"] } },
      { "id": "belgeTutarlari", "type": "recordHeader", "name": "belgeTutarlari",
        "props": { "title": "Toplamlar",
                   "fields": ["Ara toplam={{iade.rows[0].subtotal}}", "İskonto={{iade.rows[0].discountTotal}}",
                              "KDV={{iade.rows[0].taxTotal}}", "Genel toplam={{iade.rows[0].grandTotal}}"],
                   "fieldFormats": ["Ara toplam=money", "İskonto=money", "KDV=money", "Genel toplam=money"],
                   "fieldUnits": ["Ara toplam={{iade.rows[0].currencyCode}}", "İskonto={{iade.rows[0].currencyCode}}",
                                  "KDV={{iade.rows[0].currencyCode}}", "Genel toplam={{iade.rows[0].currencyCode}}"] } },
      { "id": "belgeAkisi", "type": "steps", "name": "belgeAkisi",
        "props": { "steps": ["İşlendi", "İptal"],
                   "activeWhen": ["iade.rows[0].status == 'Posted'", "iade.rows[0].status == 'Voided'"] } },
      { "id": "belgeSatirlari", "type": "dataTable", "name": "belgeSatirlari",
        "props": { "title": "Satırlar", "query": "iadeSatirlari", "width": 12, "showPivot": false,
                   "columns": ["orderLineNumber", "stockCode", "stockName", "quantity", "enteredQuantity", "unitPrice", "discountAmount", "vatPercent", "taxAmount", "lineTotal"],
                   "columnLabels": ["orderLineNumber=#", "stockCode=Stok kodu", "stockName=Stok adı", "quantity=Miktar", "enteredQuantity=Girilen miktar",
                                    "unitPrice=Birim fiyat", "discountAmount=İskonto", "vatPercent=KDV %", "taxAmount=KDV", "lineTotal=Toplam",
                                    "lineSubtotal=Ara toplam", "discountPercent=İskonto %"],
                   "columnUnits": ["quantity=unitCode", "enteredQuantity=enteredUnitCode"],
                   "columnFormats": ["orderLineNumber=number", "stockCode=code", "quantity=number", "enteredQuantity=number", "unitPrice=number",
                                     "discountAmount=money", "vatPercent=number", "taxAmount=money", "lineTotal=money", "lineSubtotal=money",
                                     "discountPercent=number"],
                   "emptyText": "Satır yok." } },
      { "id": "islendiNotu", "type": "text", "name": "islendiNotu",
        "props": { "text": "İade stoktan düşülür ve tedarikçi borcunu azaltır.", "visibleWhen": "iade.rows[0].status == 'Posted'" } },
      { "id": "iptalNotu", "type": "text", "name": "iptalNotu",
        "props": { "text": "Bu iade iptal edildi; stok ve cari hareketleri ters kayıtla geri alındı.", "visibleWhen": "iade.rows[0].status == 'Voided'" } },

      { "id": "yeniIadeDugmesi", "type": "button", "name": "yeniIadeDugmesi",
        "props": { "text": "Yeni iade", "actionType": "erpPage", "pageKey": "sales-purchase-invoices", "legacyScreen": true, "target": "newTab",
                   "params": ["purchaseInvoiceId={{liste.seciliSatir.purchaseInvoiceId}}"] } },
      { "id": "iptalMenuDugmesi", "type": "button", "name": "iptalMenuDugmesi",
        "props": { "text": "İadeyi iptal et", "actionType": "query", "queryId": "iadeIptal", "confirmEnabled": true,
                   "confirmText": "{{liste.seciliSatir.code}} alış iadesi iptal edilsin mi? Stok ve cari hareketleri ters kaydedilecek.",
                   "successMessage": "Alış iadesi iptal edildi; stok ve cari kayıtları ters hareketle korundu.",
                   "errorMessage": "Alış iadesi iptal edilemedi.", "refreshQueries": ["iadeler", "iade"],
                   "visibleWhen": "liste.seciliSatir.status == 'Posted'" } },
      { "id": "faturaAcDugmesi", "type": "button", "name": "faturaAcDugmesi",
        "props": { "text": "Faturayı aç", "actionType": "erpPage", "pageKey": "sales-purchase-invoices", "legacyScreen": true, "target": "newTab",
                   "params": ["purchaseInvoiceId={{liste.seciliSatir.purchaseInvoiceId}}"],
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "eskiEkranDugmesi", "type": "button", "name": "eskiEkranDugmesi",
        "props": { "text": "Eski ekranda aç", "actionType": "erpPage", "pageKey": "sales-purchase-returns", "legacyScreen": true } }
    ],
    "queries": [
      { "id": "iadeler", "name": "iadeler", "kind": "read", "operation": "satinalma.iade.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "iade", "name": "iade", "kind": "read", "operation": "satinalma.iade.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "iadeSatirlari", "name": "iadeSatirlari", "kind": "read", "operation": "satinalma.iade.satirlari", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "iadeIptal", "name": "iadeIptal", "kind": "update", "operation": "satinalma.iade.iptal", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{iade.rows[0].id}}", "type": "guid" } ] },
      { "id": "iadeIptalSatir", "name": "iadeIptalSatir", "kind": "update", "operation": "satinalma.iade.iptal", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] }
    ]
  }
}
