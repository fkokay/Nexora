  },
  "screenViews": [
    {"key": "purchase-invoices", "component": "liste", "fields": {"code": "code", "supplierName": "supplierName", "receiptCode": "receiptCode", "purchaseOrderCode": "purchaseOrderCode", "invoiceDate": "invoiceDate", "dueDate": "dueDate", "currencyCode": "currencyCode", "grandTotal": "grandTotal", "paidAmount": "paidAmount", "outstandingAmount": "displayOutstanding", "lineCount": "lineCount", "status": "paymentState"}}
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"newAction": "page", "newPageCode": "@purchase-invoice-document", "newTarget": "newTab", "openAction": "page", "openPageCode": "@purchase-invoice-document", "openTarget": "newTab", "openTable": "liste", "openParams": ["id={{liste.seciliSatir.id}}"], "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{faturalar.meta.totalCount}}", "moreButtons": ["odemeEkleDugmesi", "iadeDugmesi", "iptalMenuDugmesi", "taslaklarDugmesi"], "hiddenCommands": ["save", "delete", "print"], "slot": "commands"}},
      {"id": "acDugmesi", "type": "button", "name": "acDugmesi", "props": {"text": "Aç", "icon": "open", "actionType": "erpPage", "pageKey": "purchase-invoice-document", "target": "sameTab", "params": ["id={{liste.seciliSatir.id}}"], "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin", "slot": "rowActions"}},
      {"id": "odemeEkleSatir", "type": "button", "name": "odemeEkleSatir", "props": {"text": "Ödeme ekle", "actionType": "openDialog", "dialogId": "odemePenceresi", "visibleWhen": "liste.seciliSatir.status == 'Posted' && liste.seciliSatir.outstandingAmount > 0", "slot": "rowActions"}},
      {"id": "iptalSatir", "type": "button", "name": "iptalSatir", "props": {"text": "İptal et", "actionType": "query", "queryId": "faturaIptalSatir", "confirmEnabled": true, "confirmText": "{{liste.seciliSatir.code}} alış faturası iptal edilsin mi? Cari borç ters kayıtla kapatılacak.", "successMessage": "Alış faturası iptal edildi; cari hareket ters kaydedildi.", "errorMessage": "Alış faturası iptal edilemedi.", "refreshQueries": ["faturalar", "fatura"], "visibleWhen": "liste.seciliSatir.status == 'Posted'", "disabledWhen": "liste.seciliSatir.paidAmount > 0", "disabledReason": "İptal için önce ödemeleri iptal edin.", "slot": "rowActions"}},
      {"id": "odemeEkleDugmesi", "type": "button", "name": "odemeEkleDugmesi", "props": {"text": "Ödeme ekle", "actionType": "openDialog", "dialogId": "odemePenceresi", "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.status != 'Posted' || liste.seciliSatir.outstandingAmount <= 0", "disabledReason": "Ödeme yalnız işlenmiş ve kalan tutarı olan bir faturaya eklenir.", "slot": "actions"}},
      {"id": "iadeDugmesi", "type": "button", "name": "iadeDugmesi", "props": {"text": "İade oluştur", "actionType": "erpPage", "pageKey": "sales-purchase-returns", "target": "newTab", "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.status != 'Posted'", "disabledReason": "İade yalnız işlenmiş bir faturadan oluşturulur.", "slot": "actions"}},
      {"id": "iptalMenuDugmesi", "type": "button", "name": "iptalMenuDugmesi", "props": {"text": "İptal et (ters kayıt)", "actionType": "query", "queryId": "faturaIptal", "confirmEnabled": true, "confirmText": "{{liste.seciliSatir.code}} alış faturası iptal edilsin mi? Cari borç ters kayıtla kapatılacak.", "successMessage": "Alış faturası iptal edildi; cari hareket ters kaydedildi.", "errorMessage": "Alış faturası iptal edilemedi.", "refreshQueries": ["faturalar", "fatura"], "visibleWhen": "liste.seciliSatir.status == 'Posted'", "disabledWhen": "liste.seciliSatir.paidAmount > 0", "disabledReason": "İptal için önce ödemeleri iptal edin.", "slot": "actions"}},
      {"id": "taslaklarDugmesi", "type": "button", "name": "taslaklarDugmesi", "props": {"text": "Mal kabulsüz fatura", "actionType": "erpPage", "pageKey": "sales-purchase-invoice-drafts", "target": "newTab", "slot": "actions"}},
      {"id": "vadesiGecenGostergesi", "type": "metric", "name": "vadesiGecenGostergesi", "props": {"title": "Vadesi geçen", "query": "faturalar", "countWhen": "faturalar.satir.paymentState == 'Overdue'", "icon": "calendar-x", "variant": "danger", "description": "bu sayfa · kalanı olan", "slot": "indicators"}},
      {"id": "kismiGostergesi", "type": "metric", "name": "kismiGostergesi", "props": {"title": "Kısmen ödendi", "query": "faturalar", "countWhen": "faturalar.satir.paymentState == 'Partial'", "icon": "hourglass", "variant": "warning", "description": "bu sayfa", "slot": "indicators"}},
      {"id": "iptalGostergesi", "type": "metric", "name": "iptalGostergesi", "props": {"title": "İptal", "query": "faturalar", "countWhen": "faturalar.satir.paymentState == 'Voided'", "icon": "ban", "description": "bu sayfa", "slot": "indicators"}},
      {"id": "tedarikciNotu", "type": "alert", "name": "tedarikciNotu", "props": {"variant": "info", "title": "Seçili tedarikçinin faturaları gösteriliyor.", "visibleWhen": "sayfa.parametre.supplierId != null", "slot": "above"}},
      {"id": "suzgec", "type": "filterBar", "name": "suzgec", "props": {"table": "liste", "search": true, "searchPlaceholder": "Fatura no, tedarikçi veya mal kabul ara", "searchParam": "q", "filters": ["paymentState|select|row||Durum", "supplierName|select|row||Tedarikçi"], "slot": "filters"}},
      {"id": "liste", "type": "dataTable", "name": "liste", "props": {"title": "Alış faturaları", "query": "faturalar", "paging": "server", "pageSize": 25, "columns": ["code", "invoiceDate", "supplierName", "receiptCode", "dueDate", "overdueDays", "grandTotal", "paidAmount", "displayOutstanding", "paymentState"], "columnLabels": ["code=Fatura no", "invoiceDate=Tarih", "supplierName=Tedarikçi", "receiptCode=Mal kabul", "dueDate=Vade", "overdueDays=Gecikme (gün)", "grandTotal=Genel toplam", "paidAmount=Ödenen", "displayOutstanding=Kalan", "paymentState=Durum", "purchaseOrderCode=Sipariş no", "currencyCode=Döviz", "lineCount=Satır", "status=Kayıt durumu", "outstandingAmount=Ödenmemiş"], "columnUnits": ["grandTotal=currencyCode", "paidAmount=currencyCode", "displayOutstanding=currencyCode"], "columnFormats": ["code=code", "invoiceDate=date", "receiptCode=code", "dueDate=date", "overdueDays=number", "grandTotal=money", "paidAmount=money", "displayOutstanding=money", "paymentState=status", "purchaseOrderCode=code", "lineCount=number", "status=status", "outstandingAmount=money"], "valueLabels": ["paymentState:Voided=İptal", "paymentState:Paid=Ödendi", "paymentState:Overdue=Vadesi geçti", "paymentState:Partial=Kısmen ödendi", "paymentState:Posted=İşlendi", "overdueDays:0=—", "status:Posted=İşlendi", "status:Voided=İptal"], "toneMap": ["Ödendi=success", "Vadesi geçti=danger", "Kısmen ödendi=warning", "İşlendi=info", "İptal=info"], "rowOpenAction": "acDugmesi", "openParam": "id", "emptyText": "Alış faturası yok. Fatura eklemek için faturalanabilir bir mal kabul seçin.", "slot": "list"}},
      {"id": "detayKarti", "type": "card", "name": "detayKarti", "props": {"variant": "panel", "title": "{{liste.seciliSatir.code}}", "description": "{{liste.seciliSatir.supplierName}}", "slot": "detail"}, "children": [{"id": "detayOdendi", "type": "badge", "name": "detayOdendi", "props": {"text": "Ödendi", "variant": "success", "visibleWhen": "liste.seciliSatir.paymentState == 'Paid'"}}, {"id": "detayVadesiGecti", "type": "badge", "name": "detayVadesiGecti", "props": {"text": "Vadesi geçti · {{liste.seciliSatir.overdueDays}} gün", "variant": "danger", "visibleWhen": "liste.seciliSatir.paymentState == 'Overdue'"}}, {"id": "detayKismi", "type": "badge", "name": "detayKismi", "props": {"text": "Kısmen ödendi", "variant": "warning", "visibleWhen": "liste.seciliSatir.paymentState == 'Partial'"}}, {"id": "detayIslendi", "type": "badge", "name": "detayIslendi", "props": {"text": "İşlendi", "variant": "info", "visibleWhen": "liste.seciliSatir.paymentState == 'Posted'"}}, {"id": "detayIptal", "type": "badge", "name": "detayIptal", "props": {"text": "İptal", "variant": "info", "visibleWhen": "liste.seciliSatir.paymentState == 'Voided'"}}, {"id": "genelToplamGostergesi", "type": "metric", "name": "genelToplamGostergesi", "props": {"title": "Genel toplam", "value": "{{liste.seciliSatir.grandTotal}}", "format": "money", "icon": "receipt", "description": "{{liste.seciliSatir.currencyCode}}"}}, {"id": "kalanGostergesi", "type": "metric", "name": "kalanGostergesi", "props": {"title": "Kalan", "value": "{{liste.seciliSatir.displayOutstanding}}", "format": "money", "icon": "wallet", "description": "Ödenen {{liste.seciliSatir.paidAmount}} {{liste.seciliSatir.currencyCode}}", "visibleWhen": "liste.seciliSatir.paymentState != 'Overdue' && liste.seciliSatir.paymentState != 'Voided'"}}, {"id": "gecikenKalanGostergesi", "type": "metric", "name": "gecikenKalanGostergesi", "props": {"title": "Kalan", "value": "{{liste.seciliSatir.displayOutstanding}}", "format": "money", "icon": "alert", "variant": "danger", "description": "{{liste.seciliSatir.overdueDays}} gün gecikti", "visibleWhen": "liste.seciliSatir.paymentState == 'Overdue'"}}, {"id": "vadeGostergesi", "type": "metric", "name": "vadeGostergesi", "props": {"title": "Vade", "value": "{{liste.seciliSatir.dueDate}}", "format": "date", "icon": "calendar"}}, {"id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli", "props": {"table": "liste", "fields": ["receiptCode=Mal kabul", "purchaseOrderCode=Sipariş", "invoiceDate=Fatura tarihi", "dueDate=Vade", "paidAmount=Ödenen", "currencyCode=Döviz", "lineCount=Satır sayısı"]}}, {"id": "eBelgeNotu", "type": "text", "name": "eBelgeNotu", "props": {"title": "Gelen e-belge", "text": "{{fatura.rows[0].providerScenario}} · {{fatura.rows[0].providerInvoiceTypeCode}} · ETTN {{fatura.rows[0].providerInvoiceUuid}}", "visibleWhen": "fatura.rows[0].providerScenario != null || fatura.rows[0].providerInvoiceUuid != null"}}, {"id": "detayAc", "type": "button", "name": "detayAc", "props": {"text": "Belgeyi aç ›", "actionType": "openDialog", "dialogId": "belgePenceresi"}}, {"id": "detayOdemeEkle", "type": "button", "name": "detayOdemeEkle", "props": {"text": "Ödeme ekle ›", "actionType": "openDialog", "dialogId": "odemePenceresi", "visibleWhen": "liste.seciliSatir.status == 'Posted' && liste.seciliSatir.outstandingAmount > 0"}}]},
      {"id": "belgePenceresi", "type": "dialog", "name": "belgePenceresi", "props": {"presentation": "dialog", "size": "xl", "title": "Alış faturası · {{fatura.rows[0].code}}", "contains": ["belgeBasligi", "belgeDurumu", "belgeSekmeleri"], "slot": "dialogs"}},
      {"id": "belgeBasligi", "type": "recordHeader", "name": "belgeBasligi", "props": {"icon": "receipt", "title": "{{fatura.rows[0].code}}", "subtitle": "{{fatura.rows[0].supplierName}} · vergi profili {{fatura.rows[0].accountingProfileCode}}", "fields": ["Fatura tarihi={{fatura.rows[0].invoiceDate}}", "Vade={{fatura.rows[0].dueDate}}", "Vergi={{fatura.rows[0].taxTotal}}", "Genel toplam={{fatura.rows[0].grandTotal}}", "Ödenen={{fatura.rows[0].paidAmount}}", "Kalan={{fatura.rows[0].displayOutstanding}}"], "fieldFormats": ["Fatura tarihi=date", "Vade=date", "Vergi=money", "Genel toplam=money", "Ödenen=money", "Kalan=money"], "fieldUnits": ["Vergi={{fatura.rows[0].currencyCode}}", "Genel toplam={{fatura.rows[0].currencyCode}}", "Ödenen={{fatura.rows[0].currencyCode}}", "Kalan={{fatura.rows[0].currencyCode}}"], "slot": "dialog"}},
      {"id": "belgeDurumu", "type": "section", "name": "belgeDurumu", "props": {"slot": "dialog"}, "children": [{"id": "belgeIslendiRozeti", "type": "badge", "name": "belgeIslendiRozeti", "props": {"text": "İşlendi", "variant": "success", "visibleWhen": "fatura.rows[0].status == 'Posted'"}}, {"id": "belgeIptalRozeti", "type": "badge", "name": "belgeIptalRozeti", "props": {"text": "İptal", "variant": "info", "visibleWhen": "fatura.rows[0].status == 'Voided'"}}, {"id": "belgeAraToplam", "type": "text", "name": "belgeAraToplam", "props": {"text": "Ara toplam {{fatura.rows[0].subtotal}} · İskonto {{fatura.rows[0].discountTotal}} · Vergi {{fatura.rows[0].taxTotal}} {{fatura.rows[0].currencyCode}}", "visibleWhen": "fatura.rows[0].id != null"}}, {"id": "belgeZinciri", "type": "text", "name": "belgeZinciri", "props": {"title": "Belge zinciri", "text": "Sipariş {{fatura.rows[0].purchaseOrderCode}} → Mal kabul {{fatura.rows[0].receiptCode}} → Fatura {{fatura.rows[0].code}} · İade {{iadeler.satirSayisi}}"}}]},
      {"id": "belgeSekmeleri", "type": "tabs", "name": "belgeSekmeleri", "props": {"tabs": ["Satırlar=belgeSatirlari", "Ödemeler {{odemeler.satirSayisi}}=belgeOdemeleri,odemeIptalNotu", "İadeler {{iadeler.satirSayisi}}=belgeIadeleri"], "slot": "dialog"}},
      {"id": "belgeSatirlari", "type": "dataTable", "name": "belgeSatirlari", "props": {"title": "Satırlar", "query": "faturaSatirlari", "showPivot": false, "columns": ["orderLineNumber", "stockCode", "stockName", "quantity", "unitPrice", "discountAmount", "vatPercent", "taxAmount", "lineTotal"], "columnLabels": ["orderLineNumber=#", "stockCode=Stok kodu", "stockName=Stok adı", "quantity=Miktar", "unitPrice=Birim fiyat", "discountAmount=İskonto", "vatPercent=KDV %", "taxAmount=Vergi", "lineTotal=Toplam", "lineSubtotal=Ara toplam", "discountPercent=İskonto %"], "columnUnits": ["quantity=unitCode"], "columnFormats": ["orderLineNumber=number", "stockCode=code", "quantity=number", "unitPrice=number", "discountAmount=money", "vatPercent=number", "taxAmount=money", "lineTotal=money", "lineSubtotal=money", "discountPercent=number"], "emptyText": "Satır yok.", "slot": "dialog"}},
      {"id": "belgeOdemeleri", "type": "dataTable", "name": "belgeOdemeleri", "props": {"title": "Ödemeler", "query": "odemeler", "showPivot": false, "columns": ["code", "paymentDate", "paymentMethod", "financialAccountName", "reference", "amount", "status"], "columnLabels": ["code=Ödeme", "paymentDate=Tarih", "paymentMethod=Yöntem", "financialAccountName=Hesap", "reference=Referans", "amount=Tutar", "status=Durum"], "columnUnits": ["amount=currencyCode"], "columnFormats": ["code=code", "paymentDate=date", "amount=money", "status=status"], "valueLabels": ["paymentMethod:Cash=Nakit", "paymentMethod:Bank transfer=Havale / EFT", "paymentMethod:Card=Kart", "paymentMethod:Check=Çek", "status:Posted=İşlendi", "status:Voided=İptal"], "toneMap": ["İşlendi=success", "İptal=info"], "rowActions": ["odemeIptalSatir"], "emptyText": "Henüz ödeme yok.", "slot": "dialog"}},
      {"id": "odemeIptalSatir", "type": "button", "name": "odemeIptalSatir", "props": {"text": "Ödemeyi iptal et", "actionType": "query", "queryId": "odemeIptal", "confirmEnabled": true, "confirmText": "{{belgeOdemeleri.seciliSatir.code}} ödemesi iptal edilsin mi? Tedarikçi cari hareketi ters kaydedilecek.", "successMessage": "Ödeme iptal edildi; tedarikçi borcu ters kayıtla yeniden açıldı.", "errorMessage": "Ödeme iptal edilemedi.", "refreshQueries": ["odemeler", "fatura", "faturalar"], "visibleWhen": "belgeOdemeleri.seciliSatir.status == 'Posted'", "slot": "rowActions"}},
      {"id": "odemeIptalNotu", "type": "text", "name": "odemeIptalNotu", "props": {"text": "Kaydedilen ödemenin muhasebe fişi vardır; ödeme, fiş ters kayıtla kapatılmadan iptal edilemez.", "slot": "dialog"}},
