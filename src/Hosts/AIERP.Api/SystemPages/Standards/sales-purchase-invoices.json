{
  "screenKey": "sales-purchase-invoices", "title": "Satınalma Faturaları",
  "description": "Mal kabullerinden oluşan tedarikçi faturalarını, vadeleri ve kalan borçları izleyin.", "module": "Satın Alma",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:acDugmesi", "component:odemeEkleDugmesi", "component:iadeDugmesi", "component:iptalMenuDugmesi", "component:taslaklarDugmesi", "component:eskiEkranDugmesi", "query:faturalar"]},
    "component:vadesiGecenGostergesi": {"since": 1, "label": "Vadesi geçen göstergesi (bu sayfa)", "requires": ["query:faturalar"]},
    "component:kismiGostergesi": {"since": 1, "label": "Kısmen ödendi göstergesi (bu sayfa)", "requires": ["query:faturalar"]},
    "component:iptalGostergesi": {"since": 1, "label": "İptal göstergesi (bu sayfa)", "requires": ["query:faturalar"]},
    "component:tedarikciSecimi": {"since": 1, "label": "Tedarikçi süzgeci (gizli, sayfa parametresi)"},
    "component:tedarikciCipi": {"since": 1, "label": "Tedarikçi süzgeci göstergesi", "requires": ["component:tedarikciSecimi", "query:faturalar"]},
    "component:tedarikciKaldir": {"since": 1, "label": "Tedarikçi süzgecini kaldır", "requires": ["component:tedarikciSecimi"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:gorunumKarti": {"since": 1, "label": "Detay paneli anahtarı kartı", "requires": ["component:detayPaneli"]},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:liste": {"since": 1, "label": "Alış faturaları listesi", "requires": ["component:detayPaneli", "component:acDugmesi", "component:odemeEkleSatir", "component:iptalSatir", "query:faturalar"]},
    "component:acDugmesi": {"since": 1, "label": "Belgeyi aç komutu", "requires": ["component:belgePenceresi", "component:liste"]},
    "component:odemeEkleSatir": {"since": 1, "label": "Ödeme ekle satır düğmesi", "requires": ["component:odemePenceresi", "component:liste"]},
    "component:iptalSatir": {"since": 1, "label": "İptal et satır düğmesi", "requires": ["component:liste", "query:faturaIptalSatir", "query:faturalar"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:ozetPaneli", "component:eBelgeNotu", "component:panelSatirlari", "component:panelOdemeleri", "component:odemePenceresi", "component:belgePenceresi", "query:fatura"]},
    "component:ozetPaneli": {"since": 1, "label": "Detay: Özet", "requires": ["component:liste"]},
    "component:eBelgeNotu": {"since": 1, "label": "Detay: Gelen e-belge", "requires": ["query:fatura"]},
    "component:panelSatirlari": {"since": 1, "label": "Detay: Satırlar", "requires": ["query:faturaSatirlari"]},
    "component:panelOdemeleri": {"since": 1, "label": "Detay: Ödemeler", "requires": ["query:odemeler"]},
    "component:belgePenceresi": {"since": 1, "label": "Alış faturası belgesi", "requires": ["component:belgeBasligi", "component:belgeTutarlari", "component:belgeAkisi", "component:belgeZinciri", "component:belgeSekmeleri"]},
    "component:belgeBasligi": {"since": 1, "label": "Belge: Fatura bilgileri", "requires": ["query:fatura"]},
    "component:belgeTutarlari": {"since": 1, "label": "Belge: Toplamlar", "requires": ["query:fatura"]},
    "component:belgeAkisi": {"since": 1, "label": "Belge: Durum akışı", "requires": ["query:fatura"]},
    "component:belgeZinciri": {"since": 1, "label": "Belge: Belge zinciri", "requires": ["query:fatura"]},
    "component:belgeSekmeleri": {"since": 1, "label": "Belge: Satırlar, ödemeler, iadeler", "requires": ["component:belgeSatirlari", "component:belgeOdemeleri", "component:odemeIptalNotu", "component:belgeIadeleri"]},
    "component:belgeSatirlari": {"since": 1, "label": "Belge: Satırlar", "requires": ["query:faturaSatirlari"]},
    "component:belgeOdemeleri": {"since": 1, "label": "Belge: Ödemeler", "requires": ["component:odemeIptalSatir", "query:odemeler"]},
    "component:odemeIptalSatir": {"since": 1, "label": "Ödemeyi iptal et satır düğmesi", "requires": ["component:belgeOdemeleri", "query:odemeIptal", "query:odemeler", "query:fatura", "query:faturalar"]},
    "component:odemeIptalNotu": {"since": 1, "label": "Ödeme iptali notu"},
    "component:belgeIadeleri": {"since": 1, "label": "Belge: İadeler", "requires": ["query:iadeler"]},
    "component:odemePenceresi": {"since": 1, "label": "Tedarikçi ödemesi penceresi", "requires": ["component:odemeBilgileri", "component:istekKimligi", "component:odemeNotu", "component:hesapYokUyarisi", "query:odemeEkle", "query:faturalar", "query:fatura", "query:odemeler"]},
    "component:odemeBilgileri": {"since": 1, "label": "Ödeme bilgileri", "requires": ["component:odemeTarihi", "component:tutar", "component:yontem", "component:hesap", "component:referans"]},
    "component:odemeTarihi": {"since": 1, "label": "Ödeme alanı: Ödeme tarihi"},
    "component:tutar": {"since": 1, "label": "Ödeme alanı: Tutar"},
    "component:yontem": {"since": 1, "label": "Ödeme alanı: Ödeme yöntemi", "requires": ["component:hesap"]},
    "component:hesap": {"since": 1, "label": "Ödeme alanı: Kasa / banka hesabı", "requires": ["component:yontem", "query:hesaplar", "query:fatura"]},
    "component:referans": {"since": 1, "label": "Ödeme alanı: Referans"},
    "component:istekKimligi": {"since": 1, "label": "Tekrar deneme kimliği (gizli)"},
    "component:odemeNotu": {"since": 1, "label": "Ödenebilir tutar notu", "requires": ["query:fatura"]},
    "component:hesapYokUyarisi": {"since": 1, "label": "Uygun hesap yok uyarısı", "requires": ["component:yontem"]},
    "component:odemeEkleDugmesi": {"since": 1, "label": "Ödeme ekle komutu", "requires": ["component:odemePenceresi", "component:liste"]},
    "component:iadeDugmesi": {"since": 1, "label": "İade oluştur komutu (eski ekran)", "requires": ["component:liste"]},
    "component:iptalMenuDugmesi": {"since": 1, "label": "İptal et komutu", "requires": ["component:liste", "query:faturaIptal", "query:faturalar", "query:fatura"]},
    "component:taslaklarDugmesi": {"since": 1, "label": "Mal kabulsüz fatura komutu"},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Eski ekranda aç komutu", "requires": ["component:liste", "component:tedarikciSecimi"]},
    "query:faturalar": {"since": 1, "label": "Alış faturalarını listele", "requires": ["component:suzgec", "component:tedarikciSecimi", "component:liste"]},
    "query:fatura": {"since": 1, "label": "Seçili alış faturası", "requires": ["component:liste"]},
    "query:faturaSatirlari": {"since": 1, "label": "Seçili faturanın satırları", "requires": ["component:liste"]},
    "query:odemeler": {"since": 1, "label": "Seçili faturanın ödemeleri", "requires": ["component:liste"]},
    "query:iadeler": {"since": 1, "label": "Seçili faturanın iadeleri", "requires": ["component:liste"]},
    "query:hesaplar": {"since": 1, "label": "Kasa ve banka hesapları"},
    "query:faturaIptal": {"since": 1, "label": "Alış faturasını iptal et (menü)", "requires": ["query:fatura"]},
    "query:faturaIptalSatir": {"since": 1, "label": "Alış faturasını iptal et (satır)", "requires": ["component:liste"]},
    "query:odemeEkle": {"since": 1, "label": "Tedarikçi ödemesi ekle",
      "requires": ["component:istekKimligi", "component:odemeTarihi", "component:tutar", "component:yontem", "component:hesap", "component:referans", "query:fatura"]},
    "query:odemeIptal": {"since": 1, "label": "Tedarikçi ödemesini iptal et", "requires": ["component:belgeOdemeleri"]}
  },
  "screenViews": [ { "key": "purchase-invoices", "component": "liste",
                     "fields": { "code": "code", "supplierName": "supplierName", "receiptCode": "receiptCode", "purchaseOrderCode": "purchaseOrderCode",
                                 "invoiceDate": "invoiceDate", "dueDate": "dueDate", "currencyCode": "currencyCode", "grandTotal": "grandTotal",
                                 "paidAmount": "paidAmount", "outstandingAmount": "displayOutstanding", "lineCount": "lineCount",
                                 "status": "paymentState" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "newAction": "page", "newPageCode": "@sales-purchase-invoice-entry", "newTarget": "newTab", "openButton": "acDugmesi",
                   "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{faturalar.meta.totalCount}}",
                   "moreButtons": ["odemeEkleDugmesi", "iadeDugmesi", "iptalMenuDugmesi", "taslaklarDugmesi", "eskiEkranDugmesi"],
                   "hiddenCommands": ["save", "delete", "print"] } },

      { "id": "vadesiGecenGostergesi", "type": "metric", "name": "vadesiGecenGostergesi",
        "props": { "title": "Vadesi geçen", "query": "faturalar", "countWhen": "faturalar.satir.paymentState == 'Overdue'", "icon": "calendar-x",
                   "variant": "danger", "description": "bu sayfa · kalanı olan", "width": 3 } },
      { "id": "kismiGostergesi", "type": "metric", "name": "kismiGostergesi",
        "props": { "title": "Kısmen ödendi", "query": "faturalar", "countWhen": "faturalar.satir.paymentState == 'Partial'", "icon": "hourglass",
                   "variant": "warning", "description": "bu sayfa", "width": 3 } },
      { "id": "iptalGostergesi", "type": "metric", "name": "iptalGostergesi",
        "props": { "title": "İptal", "query": "faturalar", "countWhen": "faturalar.satir.paymentState == 'Voided'", "icon": "ban",
                   "description": "bu sayfa", "width": 3 } },

      { "id": "tedarikciSecimi", "type": "input", "name": "tedarikciSecimi",
        "props": { "inputType": "text", "label": "Tedarikçi", "hidden": true, "defaultValue": "{{sayfa.parametre.supplierId}}" } },
      { "id": "tedarikciCipi", "type": "text", "name": "tedarikciCipi",
        "props": { "text": "Tedarikçi: {{faturalar.rows[0].supplierName}}", "width": 4, "visibleWhen": "tedarikciSecimi.value != null" } },
      { "id": "tedarikciKaldir", "type": "button", "name": "tedarikciKaldir",
        "props": { "text": "Tüm tedarikçiler ✕", "actionType": "setInput", "assignments": ["tedarikciSecimi="], "width": 2,
                   "visibleWhen": "tedarikciSecimi.value != null" } },
      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 10, "search": true, "searchPlaceholder": "Fatura no, tedarikçi veya mal kabul ara", "searchParam": "q" } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": { "title": "Görünüm", "layout": "inline", "width": 2, "inputs": ["detayPaneli"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Alış faturaları", "query": "faturalar", "paging": "server", "pageSize": 25, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.id != null",
                   "columns": ["code", "invoiceDate", "supplierName", "receiptCode", "dueDate", "overdueDays", "grandTotal", "paidAmount", "displayOutstanding", "paymentState"],
                   "columnLabels": ["code=Fatura no", "invoiceDate=Tarih", "supplierName=Tedarikçi", "receiptCode=Mal kabul", "dueDate=Vade",
                                    "overdueDays=Gecikme (gün)", "grandTotal=Genel toplam", "paidAmount=Ödenen", "displayOutstanding=Kalan",
                                    "paymentState=Durum", "purchaseOrderCode=Sipariş no", "currencyCode=Döviz", "lineCount=Satır",
                                    "status=Kayıt durumu", "outstandingAmount=Ödenmemiş"],
                   "columnUnits": ["grandTotal=currencyCode", "paidAmount=currencyCode", "displayOutstanding=currencyCode"],
                   "columnFormats": ["code=code", "invoiceDate=date", "receiptCode=code", "dueDate=date", "overdueDays=number", "grandTotal=money",
                                     "paidAmount=money", "displayOutstanding=money", "paymentState=status", "purchaseOrderCode=code",
                                     "lineCount=number", "status=status", "outstandingAmount=money"],
                   "valueLabels": ["paymentState:Voided=İptal", "paymentState:Paid=Ödendi", "paymentState:Overdue=Vadesi geçti",
                                   "paymentState:Partial=Kısmen ödendi", "paymentState:Posted=İşlendi", "overdueDays:0=—",
                                   "status:Posted=İşlendi", "status:Voided=İptal"],
                   "toneMap": ["Ödendi=success", "Vadesi geçti=danger", "Kısmen ödendi=warning", "İşlendi=info", "İptal=info"],
                   "rowActions": ["acDugmesi", "odemeEkleSatir", "iptalSatir"], "rowOpenAction": "acDugmesi",
                   "emptyText": "Alış faturası yok. Fatura eklemek için faturalanabilir bir mal kabul seçin." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "openDialog", "dialogId": "belgePenceresi",
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "odemeEkleSatir", "type": "button", "name": "odemeEkleSatir",
        "props": { "text": "Ödeme ekle", "actionType": "openDialog", "dialogId": "odemePenceresi",
                   "visibleWhen": "liste.seciliSatir.status == 'Posted' && liste.seciliSatir.outstandingAmount > 0" } },
      { "id": "iptalSatir", "type": "button", "name": "iptalSatir",
        "props": { "text": "İptal et", "actionType": "query", "queryId": "faturaIptalSatir", "confirmEnabled": true,
                   "confirmText": "{{liste.seciliSatir.code}} alış faturası iptal edilsin mi? Cari borç ters kayıtla kapatılacak.",
                   "successMessage": "Alış faturası iptal edildi; cari hareket ters kaydedildi.",
                   "errorMessage": "Alış faturası iptal edilemedi.", "refreshQueries": ["faturalar", "fatura"],
                   "visibleWhen": "liste.seciliSatir.status == 'Posted'",
                   "disabledWhen": "liste.seciliSatir.paidAmount > 0", "disabledReason": "İptal için önce ödemeleri iptal edin." } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.code}}", "description": "{{liste.seciliSatir.supplierName}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayOdendi", "type": "badge", "name": "detayOdendi",
            "props": { "text": "Ödendi", "variant": "success", "visibleWhen": "liste.seciliSatir.paymentState == 'Paid'" } },
          { "id": "detayVadesiGecti", "type": "badge", "name": "detayVadesiGecti",
            "props": { "text": "Vadesi geçti · {{liste.seciliSatir.overdueDays}} gün", "variant": "danger", "visibleWhen": "liste.seciliSatir.paymentState == 'Overdue'" } },
          { "id": "detayKismi", "type": "badge", "name": "detayKismi",
            "props": { "text": "Kısmen ödendi", "variant": "warning", "visibleWhen": "liste.seciliSatir.paymentState == 'Partial'" } },
          { "id": "detayIslendi", "type": "badge", "name": "detayIslendi",
            "props": { "text": "İşlendi", "variant": "info", "visibleWhen": "liste.seciliSatir.paymentState == 'Posted'" } },
          { "id": "detayIptal", "type": "badge", "name": "detayIptal",
            "props": { "text": "İptal", "variant": "info", "visibleWhen": "liste.seciliSatir.paymentState == 'Voided'" } },
          { "id": "genelToplamGostergesi", "type": "metric", "name": "genelToplamGostergesi",
            "props": { "title": "Genel toplam", "value": "{{liste.seciliSatir.grandTotal}}", "format": "money", "width": 6, "icon": "receipt",
                       "description": "{{liste.seciliSatir.currencyCode}}" } },
          { "id": "kalanGostergesi", "type": "metric", "name": "kalanGostergesi",
            "props": { "title": "Kalan", "value": "{{liste.seciliSatir.displayOutstanding}}", "format": "money", "width": 6, "icon": "wallet",
                       "description": "Ödenen {{liste.seciliSatir.paidAmount}} {{liste.seciliSatir.currencyCode}}",
                       "visibleWhen": "liste.seciliSatir.paymentState != 'Overdue' && liste.seciliSatir.paymentState != 'Voided'" } },
          { "id": "gecikenKalanGostergesi", "type": "metric", "name": "gecikenKalanGostergesi",
            "props": { "title": "Kalan", "value": "{{liste.seciliSatir.displayOutstanding}}", "format": "money", "width": 6, "icon": "alert",
                       "variant": "danger", "description": "{{liste.seciliSatir.overdueDays}} gün gecikti",
                       "visibleWhen": "liste.seciliSatir.paymentState == 'Overdue'" } },
          { "id": "vadeGostergesi", "type": "metric", "name": "vadeGostergesi",
            "props": { "title": "Vade", "value": "{{liste.seciliSatir.dueDate}}", "format": "date", "width": 6, "icon": "calendar" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetPaneli,eBelgeNotu", "Satırlar=panelSatirlari", "Ödemeler=panelOdemeleri"] } },
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Belgeyi aç ›", "actionType": "openDialog", "dialogId": "belgePenceresi" } },
          { "id": "detayOdemeEkle", "type": "button", "name": "detayOdemeEkle",
            "props": { "text": "Ödeme ekle ›", "actionType": "openDialog", "dialogId": "odemePenceresi",
                       "visibleWhen": "liste.seciliSatir.status == 'Posted' && liste.seciliSatir.outstandingAmount > 0" } }
        ] },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["receiptCode=Mal kabul", "purchaseOrderCode=Sipariş", "invoiceDate=Fatura tarihi", "dueDate=Vade",
                              "paidAmount=Ödenen", "currencyCode=Döviz", "lineCount=Satır sayısı"] } },
      { "id": "eBelgeNotu", "type": "text", "name": "eBelgeNotu",
        "props": { "title": "Gelen e-belge",
                   "text": "{{fatura.rows[0].providerScenario}} · {{fatura.rows[0].providerInvoiceTypeCode}} · ETTN {{fatura.rows[0].providerInvoiceUuid}}",
                   "visibleWhen": "fatura.rows[0].providerScenario != null || fatura.rows[0].providerInvoiceUuid != null" } },
      { "id": "panelSatirlari", "type": "dataTable", "name": "panelSatirlari",
        "props": { "title": "Satırlar", "query": "faturaSatirlari", "width": 12, "showGridSearch": false, "showColumnFilters": false,
                   "showColumnChooser": false, "showExport": false, "showPivot": false, "showCsv": false, "showSelectedExport": false,
                   "columns": ["stockName", "quantity", "lineTotal"],
                   "columnLabels": ["stockName=Stok", "quantity=Miktar", "lineTotal=Toplam"],
                   "columnUnits": ["stockName=stockCode", "quantity=unitCode"],
                   "columnFormats": ["quantity=number", "lineTotal=money"],
                   "emptyText": "Satır yok." } },
      { "id": "panelOdemeleri", "type": "dataTable", "name": "panelOdemeleri",
        "props": { "title": "Ödemeler", "query": "odemeler", "width": 12, "showGridSearch": false, "showColumnFilters": false,
                   "showColumnChooser": false, "showExport": false, "showPivot": false, "showCsv": false, "showSelectedExport": false,
                   "columns": ["code", "paymentDate", "paymentMethod", "amount", "status"],
                   "columnLabels": ["code=Ödeme", "paymentDate=Tarih", "paymentMethod=Yöntem", "amount=Tutar", "status=Durum"],
                   "columnUnits": ["amount=currencyCode"],
                   "columnFormats": ["code=code", "paymentDate=date", "amount=money", "status=status"],
                   "valueLabels": ["paymentMethod:Cash=Nakit", "paymentMethod:Bank transfer=Havale / EFT", "paymentMethod:Card=Kart",
                                   "paymentMethod:Check=Çek", "status:Posted=İşlendi", "status:Voided=İptal"],
                   "toneMap": ["İşlendi=success", "İptal=info"],
                   "emptyText": "Henüz ödeme yok." } },

      { "id": "belgePenceresi", "type": "dialog", "name": "belgePenceresi",
        "props": { "presentation": "dialog", "size": "xl", "title": "Alış faturası · {{fatura.rows[0].code}}",
                   "contains": ["belgeBasligi", "belgeTutarlari", "belgeAkisi", "belgeZinciri", "belgeSekmeleri"] } },
      { "id": "belgeBasligi", "type": "recordHeader", "name": "belgeBasligi",
        "props": { "icon": "receipt", "title": "{{fatura.rows[0].code}}", "subtitle": "{{fatura.rows[0].supplierName}}",
                   "fields": ["Fatura tarihi={{fatura.rows[0].invoiceDate}}", "Vade={{fatura.rows[0].dueDate}}",
                              "Gecikme={{fatura.rows[0].overdueDays}}", "Genel toplam={{fatura.rows[0].grandTotal}}",
                              "Ödenen={{fatura.rows[0].paidAmount}}", "Kalan={{fatura.rows[0].displayOutstanding}}"],
                   "fieldFormats": ["Fatura tarihi=date", "Vade=date", "Gecikme=number", "Genel toplam=money", "Ödenen=money", "Kalan=money"],
                   "fieldUnits": ["Gecikme=gün", "Genel toplam={{fatura.rows[0].currencyCode}}", "Ödenen={{fatura.rows[0].currencyCode}}",
                                  "Kalan={{fatura.rows[0].currencyCode}}"] } },
      { "id": "belgeTutarlari", "type": "recordHeader", "name": "belgeTutarlari",
        "props": { "title": "Toplamlar", "subtitle": "Vergi profili: {{fatura.rows[0].accountingProfileCode}}",
                   "fields": ["Ara toplam={{fatura.rows[0].subtotal}}", "İskonto={{fatura.rows[0].discountTotal}}",
                              "Vergi={{fatura.rows[0].taxTotal}}", "Genel toplam={{fatura.rows[0].grandTotal}}",
                              "Mal kabul={{fatura.rows[0].receiptCode}}", "Sipariş={{fatura.rows[0].purchaseOrderCode}}"],
                   "fieldFormats": ["Ara toplam=money", "İskonto=money", "Vergi=money", "Genel toplam=money"],
                   "fieldUnits": ["Ara toplam={{fatura.rows[0].currencyCode}}", "İskonto={{fatura.rows[0].currencyCode}}",
                                  "Vergi={{fatura.rows[0].currencyCode}}", "Genel toplam={{fatura.rows[0].currencyCode}}"] } },
      { "id": "belgeAkisi", "type": "steps", "name": "belgeAkisi",
        "props": { "steps": ["İşlendi", "İptal"],
                   "activeWhen": ["fatura.rows[0].status == 'Posted'", "fatura.rows[0].status == 'Voided'"] } },
      { "id": "belgeZinciri", "type": "text", "name": "belgeZinciri",
        "props": { "title": "Belge zinciri",
                   "text": "Sipariş {{fatura.rows[0].purchaseOrderCode}} → Mal kabul {{fatura.rows[0].receiptCode}} → Fatura {{fatura.rows[0].code}} · İade {{iadeler.satirSayisi}}" } },
      { "id": "belgeSekmeleri", "type": "tabs", "name": "belgeSekmeleri",
        "props": { "tabs": ["Satırlar=belgeSatirlari", "Ödemeler {{odemeler.satirSayisi}}=belgeOdemeleri,odemeIptalNotu", "İadeler {{iadeler.satirSayisi}}=belgeIadeleri"] } },
      { "id": "belgeSatirlari", "type": "dataTable", "name": "belgeSatirlari",
        "props": { "title": "Satırlar", "query": "faturaSatirlari", "width": 12, "showPivot": false,
                   "columns": ["orderLineNumber", "stockCode", "stockName", "quantity", "unitPrice", "discountAmount", "vatPercent", "taxAmount", "lineTotal"],
                   "columnLabels": ["orderLineNumber=#", "stockCode=Stok kodu", "stockName=Stok adı", "quantity=Miktar", "unitPrice=Birim fiyat",
                                    "discountAmount=İskonto", "vatPercent=KDV %", "taxAmount=Vergi", "lineTotal=Toplam",
                                    "lineSubtotal=Ara toplam", "discountPercent=İskonto %"],
                   "columnUnits": ["quantity=unitCode"],
                   "columnFormats": ["orderLineNumber=number", "stockCode=code", "quantity=number", "unitPrice=number", "discountAmount=money",
                                     "vatPercent=number", "taxAmount=money", "lineTotal=money", "lineSubtotal=money", "discountPercent=number"],
                   "emptyText": "Satır yok." } },
      { "id": "belgeOdemeleri", "type": "dataTable", "name": "belgeOdemeleri",
        "props": { "title": "Ödemeler", "query": "odemeler", "width": 12, "showPivot": false,
                   "columns": ["code", "paymentDate", "paymentMethod", "financialAccountName", "reference", "amount", "status"],
                   "columnLabels": ["code=Ödeme", "paymentDate=Tarih", "paymentMethod=Yöntem", "financialAccountName=Hesap", "reference=Referans",
                                    "amount=Tutar", "status=Durum"],
                   "columnUnits": ["amount=currencyCode"],
                   "columnFormats": ["code=code", "paymentDate=date", "amount=money", "status=status"],
                   "valueLabels": ["paymentMethod:Cash=Nakit", "paymentMethod:Bank transfer=Havale / EFT", "paymentMethod:Card=Kart",
                                   "paymentMethod:Check=Çek", "status:Posted=İşlendi", "status:Voided=İptal"],
                   "toneMap": ["İşlendi=success", "İptal=info"],
                   "rowActions": ["odemeIptalSatir"],
                   "emptyText": "Henüz ödeme yok." } },
      { "id": "odemeIptalSatir", "type": "button", "name": "odemeIptalSatir",
        "props": { "text": "Ödemeyi iptal et", "actionType": "query", "queryId": "odemeIptal", "confirmEnabled": true,
                   "confirmText": "{{belgeOdemeleri.seciliSatir.code}} ödemesi iptal edilsin mi? Tedarikçi cari hareketi ters kaydedilecek.",
                   "successMessage": "Ödeme iptal edildi; tedarikçi borcu ters kayıtla yeniden açıldı.",
                   "errorMessage": "Ödeme iptal edilemedi.", "refreshQueries": ["odemeler", "fatura", "faturalar"],
                   "visibleWhen": "belgeOdemeleri.seciliSatir.status == 'Posted'" } },
      { "id": "odemeIptalNotu", "type": "text", "name": "odemeIptalNotu",
        "props": { "text": "Kaydedilen ödemenin muhasebe fişi vardır; ödeme, fiş ters kayıtla kapatılmadan iptal edilemez." } },
      { "id": "belgeIadeleri", "type": "dataTable", "name": "belgeIadeleri",
        "props": { "title": "İadeler", "query": "iadeler", "width": 12, "showPivot": false,
                   "columns": ["code", "returnDate", "warehouseName", "lineCount", "grandTotal", "status"],
                   "columnLabels": ["code=İade no", "returnDate=Tarih", "warehouseName=Depo", "lineCount=Satır", "grandTotal=Tutar", "status=Durum"],
                   "columnFormats": ["code=code", "returnDate=date", "lineCount=number", "grandTotal=money", "status=status"],
                   "valueLabels": ["status:Posted=İşlendi", "status:Voided=İptal"],
                   "toneMap": ["İşlendi=success", "İptal=info"],
                   "emptyText": "Bu faturadan iade yapılmadı. İade, faturalanan miktarı ve depodaki stoğu aşamaz." } },

      { "id": "odemePenceresi", "type": "dialog", "name": "odemePenceresi",
        "props": { "presentation": "dialog", "size": "lg", "title": "Tedarikçi ödemesi · {{fatura.rows[0].code}}",
                   "contains": ["odemeBilgileri", "istekKimligi", "odemeNotu", "hesapYokUyarisi"],
                   "saveQuery": "odemeEkle", "saveLabel": "Ödeme kaydet", "closeOnSave": true, "resetOnOpen": true,
                   "refreshQueries": ["faturalar", "fatura", "odemeler"] } },
      { "id": "odemeBilgileri", "type": "formCard", "name": "odemeBilgileri",
        "props": { "title": "Ödeme bilgileri", "columns": 2, "inputs": ["odemeTarihi", "tutar", "yontem", "hesap", "referans"] } },
      { "id": "odemeTarihi", "type": "input", "name": "odemeTarihi",
        "props": { "inputType": "date", "label": "Ödeme tarihi", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "tutar", "type": "input", "name": "tutar",
        "props": { "inputType": "number", "label": "Tutar ({{fatura.rows[0].currencyCode}})", "required": true, "min": 0.01, "step": 0.01 } },
      { "id": "yontem", "type": "input", "name": "yontem",
        "props": { "inputType": "select", "label": "Ödeme yöntemi", "required": true, "defaultValue": "Bank transfer",
                   "staticOptions": ["Bank transfer=Havale / EFT", "Cash=Nakit", "Card=Kart", "Check=Çek"], "clearsOnChange": ["hesap"] } },
      { "id": "hesap", "type": "input", "name": "hesap",
        "props": { "inputType": "select", "label": "Kasa / banka hesabı", "optionsQuery": "hesaplar", "optionValueColumn": "id",
                   "optionLabelColumn": "name", "optionDescriptionColumn": "code",
                   "optionsWhen": "satir.isActive == true && satir.currencyCode == fatura.rows[0].currencyCode && (yontem.value == 'Cash' && satir.type == 'Cash' || yontem.value == 'Bank transfer' && satir.type == 'Bank')",
                   "visibleWhen": "yontem.value in ['Cash', 'Bank transfer']", "requiredWhen": "yontem.value in ['Cash', 'Bank transfer']" } },
      { "id": "referans", "type": "input", "name": "referans",
        "props": { "inputType": "text", "label": "Referans", "maxLength": 100, "placeholder": "Dekont veya işlem numarası" } },
      { "id": "istekKimligi", "type": "input", "name": "istekKimligi",
        "props": { "inputType": "text", "label": "Tekrar deneme kimliği", "hidden": true, "autoId": true } },
      { "id": "odemeNotu", "type": "text", "name": "odemeNotu",
        "props": { "text": "En fazla {{fatura.rows[0].displayOutstanding}} {{fatura.rows[0].currencyCode}} ödenebilir. Ödeme tedarikçi cari borcundan düşülür." } },
      { "id": "hesapYokUyarisi", "type": "alert", "name": "hesapYokUyarisi",
        "props": { "title": "Hesap gerekli", "variant": "info",
                   "text": "Nakit ve havale ödemesinde fatura dövizinde aktif bir kasa ya da banka hesabı seçilir. Uygun hesap yoksa önce Finans ekranından hesap açın.",
                   "visibleWhen": "yontem.value in ['Cash', 'Bank transfer']" } },

      { "id": "odemeEkleDugmesi", "type": "button", "name": "odemeEkleDugmesi",
        "props": { "text": "Ödeme ekle", "actionType": "openDialog", "dialogId": "odemePenceresi",
                   "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.status != 'Posted' || liste.seciliSatir.outstandingAmount <= 0",
                   "disabledReason": "Ödeme yalnız işlenmiş ve kalan tutarı olan bir faturaya eklenir." } },
      { "id": "iadeDugmesi", "type": "button", "name": "iadeDugmesi",
        "props": { "text": "İade oluştur", "actionType": "erpPage", "pageKey": "sales-purchase-invoices", "legacy": true,
                   "params": ["purchaseInvoiceId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.status != 'Posted'",
                   "disabledReason": "İade yalnız işlenmiş bir faturadan oluşturulur." } },
      { "id": "iptalMenuDugmesi", "type": "button", "name": "iptalMenuDugmesi",
        "props": { "text": "İptal et (ters kayıt)", "actionType": "query", "queryId": "faturaIptal", "confirmEnabled": true,
                   "confirmText": "{{liste.seciliSatir.code}} alış faturası iptal edilsin mi? Cari borç ters kayıtla kapatılacak.",
                   "successMessage": "Alış faturası iptal edildi; cari hareket ters kaydedildi.",
                   "errorMessage": "Alış faturası iptal edilemedi.", "refreshQueries": ["faturalar", "fatura"],
                   "visibleWhen": "liste.seciliSatir.status == 'Posted'",
                   "disabledWhen": "liste.seciliSatir.paidAmount > 0", "disabledReason": "İptal için önce ödemeleri iptal edin." } },
      { "id": "taslaklarDugmesi", "type": "button", "name": "taslaklarDugmesi",
        "props": { "text": "Mal kabulsüz fatura", "actionType": "erpPage", "pageKey": "sales-purchase-invoice-drafts", "target": "newTab" } },
      { "id": "eskiEkranDugmesi", "type": "button", "name": "eskiEkranDugmesi",
        "props": { "text": "Eski ekranda aç", "actionType": "erpPage", "pageKey": "sales-purchase-invoices", "legacy": true,
                   "params": ["purchaseInvoiceId={{liste.seciliSatir.id}}", "supplierId={{tedarikciSecimi.value}}"] } }
    ],
    "queries": [
      { "id": "faturalar", "name": "faturalar", "kind": "read", "operation": "satinalma.fatura.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "supplierId", "binding": "{{tedarikciSecimi.value}}", "type": "guid" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "fatura", "name": "fatura", "kind": "read", "operation": "satinalma.fatura.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "faturaSatirlari", "name": "faturaSatirlari", "kind": "read", "operation": "satinalma.fatura.satirlari", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "odemeler", "name": "odemeler", "kind": "read", "operation": "satinalma.fatura.odemeleri", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "iadeler", "name": "iadeler", "kind": "read", "operation": "satinalma.fatura.iadeleri", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "hesaplar", "name": "hesaplar", "kind": "read", "operation": "satinalma.fatura.odemeHesaplari", "runOn": "load", "parameters": [] },
      { "id": "faturaIptal", "name": "faturaIptal", "kind": "update", "operation": "satinalma.fatura.iptal", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{fatura.rows[0].id}}", "type": "guid" } ] },
      { "id": "faturaIptalSatir", "name": "faturaIptalSatir", "kind": "update", "operation": "satinalma.fatura.iptal", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "odemeEkle", "name": "odemeEkle", "kind": "insert", "operation": "satinalma.fatura.odemeEkle", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{fatura.rows[0].id}}", "type": "guid" },
          { "name": "requestId", "binding": "{{istekKimligi.value}}", "type": "guid" },
          { "name": "paymentDate", "binding": "{{odemeTarihi.value}}", "type": "date" },
          { "name": "amount", "binding": "{{tutar.value}}", "type": "decimal" },
          { "name": "paymentMethod", "binding": "{{yontem.value}}", "type": "text" },
          { "name": "reference", "binding": "{{referans.value}}", "type": "text" },
          { "name": "financialAccountId", "binding": "{{hesap.value}}", "type": "guid" } ] },
      { "id": "odemeIptal", "name": "odemeIptal", "kind": "update", "operation": "satinalma.fatura.odemeIptal", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{belgeOdemeleri.seciliSatir.id}}", "type": "guid" } ] }
    ]
  }
}
