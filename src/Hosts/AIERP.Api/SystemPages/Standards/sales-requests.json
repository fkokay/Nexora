{
  "screenKey": "sales-requests", "title": "Satınalma talepleri",
  "description": "İhtiyaçları kaydedin, onayları ve tedarikçi tekliflerini takip edin.", "module": "Satın Alma",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:yeniTalepDugmesi", "component:acDugmesi", "component:onaylaDugmesi", "component:reddetDugmesi", "component:teklifEkleDugmesi", "component:siparisOlusturDugmesi", "component:siparisiAcDugmesi", "component:alanlarDugmesi", "query:talepler"]},
    "component:onayBekliyorGostergesi": {"since": 1, "label": "Onay bekliyor göstergesi", "requires": ["component:durumSecimi", "query:sayOnayBekliyor"]},
    "component:onaylandiGostergesi": {"since": 1, "label": "Onaylandı göstergesi", "requires": ["component:durumSecimi", "query:sayOnaylandi"]},
    "component:siparisGostergesi": {"since": 1, "label": "Siparişe dönüştü göstergesi", "requires": ["component:durumSecimi", "query:sayDonustu"]},
    "component:reddedildiGostergesi": {"since": 1, "label": "Reddedildi göstergesi", "requires": ["component:durumSecimi", "query:sayReddedildi"]},
    "component:durumOnayBekliyor": {"since": 1, "label": "Sayaç durumu: Onay bekliyor (gizli)"},
    "component:durumOnaylandi": {"since": 1, "label": "Sayaç durumu: Onaylandı (gizli)"},
    "component:durumDonustu": {"since": 1, "label": "Sayaç durumu: Siparişe dönüştü (gizli)"},
    "component:durumReddedildi": {"since": 1, "label": "Sayaç durumu: Reddedildi (gizli)"},
    "component:sayacSayfaBoyutu": {"since": 1, "label": "Sayaç sayfa boyutu (gizli)"},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:secimCipleri": {"since": 1, "label": "Durum seçimi çipleri", "requires": ["component:durumSecimi"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeç seçimleri kartı", "requires": ["component:durumSecimi"]},
    "component:durumSecimi": {"since": 1, "label": "Durum seçimi"},
    "component:gorunumKarti": {"since": 1, "label": "Detay paneli anahtarı kartı", "requires": ["component:detayPaneli"]},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:liste": {"since": 1, "label": "Talep listesi", "requires": ["component:detayPaneli", "component:acDugmesi", "query:talepler"]},
    "component:acDugmesi": {"since": 1, "label": "Talebi aç (eski ekran)", "requires": ["component:liste"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:ozetPaneli", "component:enIyiTeklif", "component:kalemTablosu", "component:teklifTablosu", "component:alanTablosu", "component:panelOnayla", "component:panelReddet", "query:teklifler"]},
    "component:ozetPaneli": {"since": 1, "label": "Detay: Özet", "requires": ["component:liste"]},
    "component:enIyiTeklif": {"since": 1, "label": "Detay: En iyi teklif", "requires": ["query:teklifler"]},
    "component:kalemTablosu": {"since": 1, "label": "Detay: Kalemler", "requires": ["query:kalemler"]},
    "component:teklifTablosu": {"since": 1, "label": "Detay: Teklifler", "requires": ["query:teklifler"]},
    "component:alanTablosu": {"since": 1, "label": "Detay: Özel alanlar", "requires": ["query:ozelDegerler"]},
    "component:panelOnayla": {"since": 1, "label": "Detay: Onayla", "requires": ["component:liste", "query:panelOnay", "query:talepler"]},
    "component:panelReddet": {"since": 1, "label": "Detay: Reddet", "requires": ["component:liste", "query:panelRet", "query:talepler"]},
    "component:yeniTalepDugmesi": {"since": 1, "label": "Yeni talep komutu (eski ekran)"},
    "component:onaylaDugmesi": {"since": 1, "label": "Onayla komutu", "requires": ["component:liste", "query:onay", "query:talepler"]},
    "component:reddetDugmesi": {"since": 1, "label": "Reddet komutu", "requires": ["component:liste", "query:ret", "query:talepler"]},
    "component:teklifEkleDugmesi": {"since": 1, "label": "Teklif ekle komutu (eski ekran)", "requires": ["component:liste"]},
    "component:siparisOlusturDugmesi": {"since": 1, "label": "Siparişe dönüştür komutu (eski ekran)", "requires": ["component:liste"]},
    "component:siparisiAcDugmesi": {"since": 1, "label": "Siparişi aç komutu", "requires": ["component:liste"]},
    "component:alanlarDugmesi": {"since": 1, "label": "Alanlar komutu (eski ekran)"},
    "query:talepler": {"since": 1, "label": "Satınalma taleplerini listele", "requires": ["component:suzgec", "component:durumSecimi", "component:liste"]},
    "query:sayOnayBekliyor": {"since": 1, "label": "Onay bekleyen talep sayısı", "requires": ["component:suzgec", "component:durumOnayBekliyor", "component:sayacSayfaBoyutu"]},
    "query:sayOnaylandi": {"since": 1, "label": "Onaylanan talep sayısı", "requires": ["component:suzgec", "component:durumOnaylandi", "component:sayacSayfaBoyutu"]},
    "query:sayDonustu": {"since": 1, "label": "Siparişe dönüşen talep sayısı", "requires": ["component:suzgec", "component:durumDonustu", "component:sayacSayfaBoyutu"]},
    "query:sayReddedildi": {"since": 1, "label": "Reddedilen talep sayısı", "requires": ["component:suzgec", "component:durumReddedildi", "component:sayacSayfaBoyutu"]},
    "query:kalemler": {"since": 1, "label": "Seçili talebin kalemleri", "requires": ["component:liste"]},
    "query:teklifler": {"since": 1, "label": "Seçili talebin tedarikçi teklifleri", "requires": ["component:liste"]},
    "query:ozelDegerler": {"since": 1, "label": "Seçili talebin özel alanları", "requires": ["component:liste"]},
    "query:onay": {"since": 1, "label": "Talebi onayla (komut)", "requires": ["component:liste", "component:onaylaDugmesi"]},
    "query:ret": {"since": 1, "label": "Talebi reddet (komut)", "requires": ["component:liste", "component:reddetDugmesi"]},
    "query:panelOnay": {"since": 1, "label": "Talebi onayla (panel)", "requires": ["component:liste", "component:panelOnayla"]},
    "query:panelRet": {"since": 1, "label": "Talebi reddet (panel)", "requires": ["component:liste", "component:panelReddet"]}
  },
  "screenViews": [ { "key": "purchase-requests", "component": "liste",
                     "fields": { "code": "code", "description": "description", "requestedByName": "requestedByName", "requestDate": "requestDate",
                                 "neededByDate": "neededByDate", "lineCount": "lineCount", "status": "status",
                                 "purchaseOrderCode": "purchaseOrderCode" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "newButton": "yeniTalepDugmesi", "openButton": "acDugmesi", "focusInput": "suzgec", "exportTable": "liste",
                   "titleCount": "{{talepler.meta.totalCount}}",
                   "moreButtons": ["onaylaDugmesi", "reddetDugmesi", "teklifEkleDugmesi", "siparisOlusturDugmesi", "siparisiAcDugmesi", "alanlarDugmesi"],
                   "hiddenCommands": ["save", "delete", "print"] } },

      { "id": "onayBekliyorGostergesi", "type": "metric", "name": "onayBekliyorGostergesi",
        "props": { "title": "Onay bekliyor", "value": "{{sayOnayBekliyor.meta.totalCount}}", "format": "number", "width": 3, "icon": "hourglass",
                   "variant": "warning", "description": "tıkla: süz", "filterInput": "durumSecimi", "filterValue": "Submitted" } },
      { "id": "onaylandiGostergesi", "type": "metric", "name": "onaylandiGostergesi",
        "props": { "title": "Onaylandı", "value": "{{sayOnaylandi.meta.totalCount}}", "format": "number", "width": 3, "icon": "check",
                   "description": "tıkla: süz", "filterInput": "durumSecimi", "filterValue": "Approved" } },
      { "id": "siparisGostergesi", "type": "metric", "name": "siparisGostergesi",
        "props": { "title": "Siparişe dönüştü", "value": "{{sayDonustu.meta.totalCount}}", "format": "number", "width": 3, "icon": "shopping-cart",
                   "variant": "success", "description": "tıkla: süz", "filterInput": "durumSecimi", "filterValue": "Ordered" } },
      { "id": "reddedildiGostergesi", "type": "metric", "name": "reddedildiGostergesi",
        "props": { "title": "Reddedildi", "value": "{{sayReddedildi.meta.totalCount}}", "format": "number", "width": 3, "icon": "x-circle",
                   "description": "tıkla: süz", "filterInput": "durumSecimi", "filterValue": "Rejected" } },
      { "id": "durumOnayBekliyor", "type": "input", "name": "durumOnayBekliyor",
        "props": { "inputType": "text", "label": "Sayaç durumu", "hidden": true, "defaultValue": "Submitted" } },
      { "id": "durumOnaylandi", "type": "input", "name": "durumOnaylandi",
        "props": { "inputType": "text", "label": "Sayaç durumu", "hidden": true, "defaultValue": "Approved" } },
      { "id": "durumDonustu", "type": "input", "name": "durumDonustu",
        "props": { "inputType": "text", "label": "Sayaç durumu", "hidden": true, "defaultValue": "Ordered" } },
      { "id": "durumReddedildi", "type": "input", "name": "durumReddedildi",
        "props": { "inputType": "text", "label": "Sayaç durumu", "hidden": true, "defaultValue": "Rejected" } },
      { "id": "sayacSayfaBoyutu", "type": "input", "name": "sayacSayfaBoyutu",
        "props": { "inputType": "text", "label": "Sayaç sayfa boyutu", "hidden": true, "defaultValue": "1" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 6, "search": true, "searchPlaceholder": "Talep no, açıklama veya talep sahibi ile ara", "searchParam": "search" } },
      { "id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri",
        "props": { "title": "Süzgeçler", "layout": "inline", "width": 4, "inputs": ["durumSecimi"] } },
      { "id": "durumSecimi", "type": "input", "name": "durumSecimi",
        "props": { "inputType": "select", "label": "Durum",
                   "staticOptions": ["=Tümü", "Submitted=Onay bekliyor", "Approved=Onaylandı", "Ordered=Siparişe dönüştü", "Rejected=Reddedildi"] } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": { "title": "Görünüm", "layout": "inline", "width": 2, "inputs": ["detayPaneli"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": { "width": 12, "inputs": ["durumSecimi"] } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Satınalma talepleri", "query": "talepler", "paging": "server", "pageSize": 25, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.id != null",
                   "columns": ["code", "description", "requestedByName", "requestDate", "neededByDate", "neededByDays", "lineCount", "quoteCount", "status"],
                   "columnLabels": ["code=Talep no", "description=Açıklama", "requestedByName=Talep sahibi", "requestDate=Talep tarihi",
                                    "neededByDate=İhtiyaç tarihi", "neededByDays=Kalan gün", "lineCount=Kalem", "quoteCount=Teklif",
                                    "status=Durum", "purchaseOrderCode=Bağlı sipariş", "reviewedByName=Karar veren", "createdAt=Oluşturulma"],
                   "columnFormats": ["code=code", "requestDate=date", "neededByDate=date", "neededByDays=number", "lineCount=number",
                                     "quoteCount=number", "status=status", "purchaseOrderCode=code", "createdAt=date"],
                   "valueLabels": ["status:Submitted=Onay bekliyor", "status:Approved=Onaylandı", "status:Ordered=Siparişe dönüştü",
                                   "status:Rejected=Reddedildi"],
                   "toneMap": ["Onay bekliyor=warning", "Onaylandı=info", "Siparişe dönüştü=success", "Reddedildi=danger"],
                   "rowOpenAction": "acDugmesi",
                   "emptyText": "Filtrelerle eşleşen satın alma talebi yok." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true,
                   "params": ["requestId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin" } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.code}}", "description": "{{liste.seciliSatir.requestedByName}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Talep belgesini aç ›", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true,
                       "params": ["requestId={{liste.seciliSatir.id}}"] } },
          { "id": "durumOnayBekliyorRozeti", "type": "badge", "name": "durumOnayBekliyorRozeti",
            "props": { "text": "Onay bekliyor", "variant": "warning", "visibleWhen": "liste.seciliSatir.status == 'Submitted'" } },
          { "id": "durumOnaylandiRozeti", "type": "badge", "name": "durumOnaylandiRozeti",
            "props": { "text": "Onaylandı", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Approved'" } },
          { "id": "durumSiparisRozeti", "type": "badge", "name": "durumSiparisRozeti",
            "props": { "text": "Siparişe dönüştü", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Ordered'" } },
          { "id": "durumRetRozeti", "type": "badge", "name": "durumRetRozeti",
            "props": { "text": "Reddedildi", "variant": "danger", "visibleWhen": "liste.seciliSatir.status == 'Rejected'" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetPaneli,enIyiTeklif,panelOnayla,panelReddet", "Kalemler=kalemTablosu",
                                "Teklifler {{teklifler.satirSayisi}}=teklifTablosu", "Alanlar=alanTablosu"] } }
        ] },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["requestDate=Talep tarihi", "neededByDate=İhtiyaç tarihi", "neededByDays=Kalan gün", "lineCount=Kalem",
                              "description=Açıklama", "reviewedByName=Karar veren", "reviewNote=Karar notu", "purchaseOrderCode=Sipariş"] } },
      { "id": "enIyiTeklif", "type": "text", "name": "enIyiTeklif",
        "props": { "title": "En iyi teklif",
                   "text": "{{teklifler.rows[0].supplierName}} · {{teklifler.rows[0].comparableGrandTotal}} {{teklifler.rows[0].baseCurrencyCode}} ({{teklifler.satirSayisi}} teklif)",
                   "visibleWhen": "teklifler.rows[0].comparableGrandTotal != null" } },
      { "id": "kalemTablosu", "type": "dataTable", "name": "kalemTablosu",
        "props": { "title": "İstenen kalemler", "query": "kalemler", "width": 12, "variant": "list",
                   "columns": ["stockCode", "stockName", "quantity"],
                   "columnLabels": ["stockCode=Stok kodu", "stockName=Stok adı", "quantity=Miktar"],
                   "columnUnits": ["quantity=unitCode"], "columnFormats": ["stockCode=code", "quantity=number"],
                   "emptyText": "Kalem yok." } },
      { "id": "teklifTablosu", "type": "dataTable", "name": "teklifTablosu",
        "props": { "title": "Tedarikçi teklifleri", "query": "teklifler", "width": 12, "variant": "list",
                   "columns": ["supplierName", "code", "validUntil", "grandTotal", "comparableGrandTotal", "status"],
                   "columnLabels": ["supplierName=Tedarikçi", "code=Teklif no", "validUntil=Geçerlilik", "grandTotal=Genel toplam",
                                    "comparableGrandTotal=Kıyas", "status=Durum"],
                   "columnUnits": ["grandTotal=currencyCode", "comparableGrandTotal=baseCurrencyCode"],
                   "columnFormats": ["code=code", "validUntil=date", "grandTotal=money", "comparableGrandTotal=money", "status=status"],
                   "valueLabels": ["status:Submitted=Değerlendiriliyor", "status:Selected=Seçildi", "status:NotSelected=Seçilmedi"],
                   "toneMap": ["Seçildi=success", "Değerlendiriliyor=info"],
                   "emptyText": "Henüz tedarikçi teklifi kaydedilmedi." } },
      { "id": "alanTablosu", "type": "dataTable", "name": "alanTablosu",
        "props": { "title": "Talep özel alanları", "query": "ozelDegerler", "width": 12, "variant": "list",
                   "columns": ["label", "value"], "columnLabels": ["label=Alan", "value=Değer"],
                   "emptyText": "Özel alan değeri yok." } },
      { "id": "panelOnayla", "type": "button", "name": "panelOnayla",
        "props": { "text": "Onayla", "actionType": "query", "queryId": "panelOnay",
                   "promptLabel": "Karar notu (isteğe bağlı)", "promptMaxLength": 500,
                   "promptText": "{{liste.seciliSatir.code}} talebi onaylansın mı? Talep sahibi kendi talebini onaylayamaz.",
                   "successMessage": "{{liste.seciliSatir.code}} talebi onaylandı.", "refreshQueries": ["talepler", "sayOnayBekliyor", "sayOnaylandi"],
                   "visibleWhen": "liste.seciliSatir.status == 'Submitted'" } },
      { "id": "panelReddet", "type": "button", "name": "panelReddet",
        "props": { "text": "Reddet", "actionType": "query", "queryId": "panelRet",
                   "promptLabel": "Ret gerekçesi", "promptRequired": true, "promptMaxLength": 500,
                   "promptText": "{{liste.seciliSatir.code}} talebi reddedilsin mi? Ret için açıklama zorunludur.",
                   "successMessage": "{{liste.seciliSatir.code}} talebi reddedildi.", "refreshQueries": ["talepler", "sayOnayBekliyor", "sayReddedildi"],
                   "visibleWhen": "liste.seciliSatir.status == 'Submitted'" } },

      { "id": "yeniTalepDugmesi", "type": "button", "name": "yeniTalepDugmesi",
        "props": { "text": "Yeni talep", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true } },
      { "id": "onaylaDugmesi", "type": "button", "name": "onaylaDugmesi",
        "props": { "text": "Onayla", "actionType": "query", "queryId": "onay",
                   "promptLabel": "Karar notu (isteğe bağlı)", "promptMaxLength": 500,
                   "promptText": "{{liste.seciliSatir.code}} talebi onaylansın mı? Talep sahibi kendi talebini onaylayamaz.",
                   "successMessage": "{{liste.seciliSatir.code}} talebi onaylandı.", "refreshQueries": ["talepler", "sayOnayBekliyor", "sayOnaylandi"],
                   "disabledWhen": "liste.seciliSatir.status != 'Submitted'", "disabledReason": "Yalnız onay bekleyen talep karara bağlanır." } },
      { "id": "reddetDugmesi", "type": "button", "name": "reddetDugmesi",
        "props": { "text": "Reddet", "actionType": "query", "queryId": "ret",
                   "promptLabel": "Ret gerekçesi", "promptRequired": true, "promptMaxLength": 500,
                   "promptText": "{{liste.seciliSatir.code}} talebi reddedilsin mi? Ret için açıklama zorunludur.",
                   "successMessage": "{{liste.seciliSatir.code}} talebi reddedildi.", "refreshQueries": ["talepler", "sayOnayBekliyor", "sayReddedildi"],
                   "disabledWhen": "liste.seciliSatir.status != 'Submitted'", "disabledReason": "Yalnız onay bekleyen talep karara bağlanır." } },
      { "id": "teklifEkleDugmesi", "type": "button", "name": "teklifEkleDugmesi",
        "props": { "text": "Teklif ekle", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true,
                   "params": ["requestId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.status != 'Approved'", "disabledReason": "Teklif yalnız onaylanmış talebe eklenir." } },
      { "id": "siparisOlusturDugmesi", "type": "button", "name": "siparisOlusturDugmesi",
        "props": { "text": "Siparişe dönüştür", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true,
                   "params": ["requestId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.status != 'Approved' || liste.seciliSatir.purchaseOrderId != null",
                   "disabledReason": "Yalnız siparişi olmayan onaylı talep siparişe dönüştürülür." } },
      { "id": "siparisiAcDugmesi", "type": "button", "name": "siparisiAcDugmesi",
        "props": { "text": "Siparişi aç", "actionType": "erpPage", "pageKey": "sales-purchasing",
                   "params": ["purchaseOrderId={{liste.seciliSatir.purchaseOrderId}}"],
                   "disabledWhen": "liste.seciliSatir.purchaseOrderId == null", "disabledReason": "Bu talebin siparişi yok." } },
      { "id": "alanlarDugmesi", "type": "button", "name": "alanlarDugmesi",
        "props": { "text": "Alanlar", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true } }
    ],
    "queries": [
      { "id": "talepler", "name": "talepler", "kind": "read", "operation": "satinalma.talep.listele", "runOn": "load",
        "parameters": [
          { "name": "search", "binding": "{{suzgec.search}}", "type": "text" },
          { "name": "status", "binding": "{{durumSecimi.value}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "sayOnayBekliyor", "name": "sayOnayBekliyor", "kind": "read", "operation": "satinalma.talep.listele", "runOn": "load",
        "parameters": [
          { "name": "search", "binding": "{{suzgec.search}}", "type": "text" },
          { "name": "status", "binding": "{{durumOnayBekliyor.value}}", "type": "text" },
          { "name": "pageSize", "binding": "{{sayacSayfaBoyutu.value}}", "type": "int" } ] },
      { "id": "sayOnaylandi", "name": "sayOnaylandi", "kind": "read", "operation": "satinalma.talep.listele", "runOn": "load",
        "parameters": [
