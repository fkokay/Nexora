{
  "screenKey": "customer-ledger", "title": "Cari Hesap Hareketleri",
  "description": "Cari hesabı seçin; tarih aralığındaki borç ve alacak hareketleri (ekstre) hemen listelenir.", "module": "Satış & cari",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:liste", "query:ekstre"]},
    "component:cariSecimi": {"since": 1, "label": "Cari seçimi", "requires": ["query:cariListesi"]},
    "component:secimIpucu": {"since": 1, "label": "Cari seçin ipucu", "requires": ["component:cariSecimi"]},
    "component:secilenCari": {"since": 1, "label": "Seçili cari özeti", "requires": ["component:cariSecimi", "query:ekstre"]},
    "component:suzgecKarti": {"since": 1, "label": "Cari ve dönem", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]},
    "component:baslangic": {"since": 1, "label": "Başlangıç tarihi"},
    "component:bitis": {"since": 1, "label": "Bitiş tarihi"},
    "component:buAy": {"since": 1, "label": "Dönem: Bu ay", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]},
    "component:sonUcAy": {"since": 1, "label": "Dönem: Son 3 ay", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]},
    "component:yilBasindan": {"since": 1, "label": "Dönem: Yıl başından", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]},
    "component:tarihUyarisi": {"since": 1, "label": "Tarih aralığı uyarısı", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]},
    "component:dovizUyarisi": {"since": 1, "label": "Farklı döviz uyarısı", "requires": ["component:cariSecimi", "query:ekstre"]},
    "component:liste": {"since": 1, "label": "Ekstre tablosu", "requires": ["component:cariSecimi", "query:ekstre"]},
    "component:altBilgi": {"since": 1, "label": "B/A ve ters kayıt notu", "requires": ["component:cariSecimi"]},
    "query:cariListesi": {"since": 1, "label": "Cari seçimi seçenekleri", "requires": ["component:cariSecimi"]},
    "query:ekstre": {"since": 1, "label": "Cari hesap ekstresi", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]}
  },
  "screenViews": [ { "key": "customer-ledger-entries", "component": "liste",
                     "fields": { "entryDate": "entryDate", "description": "description", "direction": "direction",
                                 "debit": "debitAmount", "credit": "creditAmount", "balance": "balanceAmount",
                                 "currencyCode": "currencyCode" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "exportTable": "liste", "titleCount": "{{ekstre.satirSayisi}}",
                   "hiddenCommands": ["new", "open", "save", "delete", "filter", "print"] } },

      { "id": "cariSecimi", "type": "input", "name": "cariSecimi",
        "props": { "inputType": "lookup", "label": "Cari", "placeholder": "Cari kodu veya unvanıyla ara", "optionsQuery": "cariListesi",
                   "optionValueColumn": "id", "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0,
                   "defaultValue": "{{sayfa.parametre.customerId}}" } },
      { "id": "secimIpucu", "type": "alert", "name": "secimIpucu",
        "props": { "title": "Cari seçin", "variant": "info", "width": 12,
                   "text": "Ekstreyi görmek için yukarıdan bir cari hesap seçin.", "visibleWhen": "cariSecimi.value == null" } },

      { "id": "secilenCari", "type": "recordHeader", "name": "secilenCari",
        "props": { "visibleWhen": "cariSecimi.value != null", "icon": "users",
                   "title": "{{ekstre.meta.customerCode}}",
                   "subtitle": "{{ekstre.meta.customerName}} · {{ekstre.meta.currencyCode}}",
                   "fields": ["Açılış={{ekstre.meta.openingAmount}}", "Açılış tarihi={{ekstre.meta.openingAsOf}}",
                              "Dönem borç={{ekstre.meta.debitTotal}}", "Dönem alacak={{ekstre.meta.creditTotal}}",
                              "Net={{ekstre.meta.netMovement}}", "Kapanış={{ekstre.meta.closingAmount}}"],
                   "fieldFormats": ["Açılış=money", "Açılış tarihi=date", "Dönem borç=money", "Dönem alacak=money", "Net=money", "Kapanış=money"],
                   "fieldUnits": ["Açılış={{ekstre.meta.openingSide}} {{ekstre.meta.currencyCode}}",
                                  "Dönem borç={{ekstre.meta.currencyCode}}", "Dönem alacak={{ekstre.meta.currencyCode}}",
                                  "Net={{ekstre.meta.currencyCode}}",
                                  "Kapanış={{ekstre.meta.closingSide}} {{ekstre.meta.currencyCode}}"] } },

      { "id": "suzgecKarti", "type": "formCard", "name": "suzgecKarti",
        "props": { "title": "Cari ve dönem", "layout": "inline", "width": 12, "inputs": ["cariSecimi", "baslangic", "bitis"] } },
      { "id": "baslangic", "type": "input", "name": "baslangic",
        "props": { "inputType": "date", "label": "Başlangıç tarihi", "required": true, "defaultValue": "{{tarih.yilBasi}}" } },
      { "id": "bitis", "type": "input", "name": "bitis",
        "props": { "inputType": "date", "label": "Bitiş tarihi", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "buAy", "type": "button", "name": "buAy",
        "props": { "text": "Bu ay", "actionType": "setInput", "width": 2,
                   "assignments": ["baslangic={{tarih.ayBasi}}", "bitis={{bugun}}"] } },
      { "id": "sonUcAy", "type": "button", "name": "sonUcAy",
        "props": { "text": "Son 3 ay", "actionType": "setInput", "width": 2,
                   "assignments": ["baslangic={{tarih.ucAyOnce}}", "bitis={{bugun}}"] } },
      { "id": "yilBasindan", "type": "button", "name": "yilBasindan",
        "props": { "text": "Yıl başından", "actionType": "setInput", "width": 2,
                   "assignments": ["baslangic={{tarih.yilBasi}}", "bitis={{bugun}}"] } },

      { "id": "tarihUyarisi", "type": "alert", "name": "tarihUyarisi",
        "props": { "title": "Tarih aralığı geçersiz", "variant": "danger", "width": 12,
                   "text": "Bitiş tarihi başlangıç tarihinden önce olamaz.",
                   "visibleWhen": "cariSecimi.value != null && bitis.value < baslangic.value" } },
      { "id": "dovizUyarisi", "type": "alert", "name": "dovizUyarisi",
        "props": { "title": "Farklı dövizli hareket var", "variant": "warning", "width": 12,
                   "text": "Toplamlar ve bakiye dövize göre ayrıştırılmaz; tutarlar kur çevrimi yapılmadan toplanır.",
                   "visibleWhen": "cariSecimi.value != null && ekstre.meta.hasForeignCurrency == true" } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Hesap hareketleri", "query": "ekstre", "width": 12, "visibleWhen": "cariSecimi.value != null",
                   "columns": ["entryDate", "description", "direction", "debitAmount", "creditAmount", "balanceAmount", "isReversal", "hasReversal"],
                   "columnLabels": ["entryDate=Tarih", "description=Açıklama", "direction=Yön", "debitAmount=Borç", "creditAmount=Alacak",
                                    "balanceAmount=Bakiye", "currencyCode=Döviz", "isReversal=Ters kayıt", "hasReversal=Ters çevrildi"],
                   "columnUnits": ["debitAmount=foreignCurrencyCode", "creditAmount=foreignCurrencyCode", "balanceAmount=balanceSide"],
                   "columnFormats": ["entryDate=date", "direction=status", "debitAmount=money", "creditAmount=money", "balanceAmount=money",
                                     "isReversal=status", "hasReversal=status"],
                   "valueLabels": ["direction:Debit=Borç", "direction:Credit=Alacak", "isReversal:true=Ters kayıt", "isReversal:false=—",
                                   "hasReversal:true=Ters çevrildi", "hasReversal:false=—"],
                   "toneMap": ["Ters kayıt=info", "Ters çevrildi=warning"],
                   "totals": ["debitAmount", "creditAmount"],
                   "emptyText": "Seçilen tarih aralığında hareket bulunmuyor." } },
      { "id": "altBilgi", "type": "text", "name": "altBilgi",
        "props": { "text": "B borç bakiyesi · A alacak bakiyesi · Ters kayıt orijinal hareketin karşı kaydıdır; hareketler silinmez.",
                   "visibleWhen": "cariSecimi.value != null" } }
    ],
    "queries": [
      { "id": "cariListesi", "name": "cariListesi", "kind": "read", "operation": "cari.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{cariSecimi.search}}", "type": "text" } ] },
      { "id": "ekstre", "name": "ekstre", "kind": "read", "operation": "cari.ekstre", "runOn": "load",
        "parameters": [
          { "name": "id", "binding": "{{cariSecimi.value}}", "type": "guid" },
          { "name": "from", "binding": "{{baslangic.value}}", "type": "date" },
          { "name": "to", "binding": "{{bitis.value}}", "type": "date" } ] }
    ]
  }
}
