{
  "screenKey": "customer-ledger", "title": "Cari Hesap Hareketleri", "description": "Cari hesabı seçin; tarih aralığındaki borç ve alacak hareketleri (ekstre) hemen listelenir.", "module": "Satış & cari", "version": 3, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:liste", "query:ekstre"]},
    "component:borcGostergesi": {"since": 3, "label": "Borç toplamı göstergesi", "requires": ["query:ekstre"]},
    "component:alacakGostergesi": {"since": 3, "label": "Alacak toplamı göstergesi", "requires": ["query:ekstre"]},
    "component:bakiyeGostergesi": {"since": 3, "label": "Dönem sonu bakiye göstergesi", "requires": ["query:ekstre"]},
    "component:cariSecimi": {"since": 1, "label": "Cari seçimi", "requires": ["query:cariListesi"]},
    "component:baslangic": {"since": 1, "label": "Başlangıç tarihi"},
    "component:bitis": {"since": 1, "label": "Bitiş tarihi"},
    "component:suzgecKarti": {"since": 1, "label": "Cari ve dönem", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]},
    "component:secimIpucu": {"since": 1, "label": "Cari seçin ipucu", "requires": ["component:cariSecimi"]},
    "component:tarihUyarisi": {"since": 1, "label": "Tarih aralığı uyarısı", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]},
    "component:dovizUyarisi": {"since": 1, "label": "Farklı döviz uyarısı", "requires": ["component:cariSecimi", "query:ekstre"]},
    "component:liste": {"since": 1, "label": "Ekstre tablosu", "requires": ["component:cariSecimi", "query:ekstre"]},
    "component:belgeSatisFaturasi": {"since": 2, "label": "Belgeye git: satış faturası", "requires": ["component:liste"]},
    "component:belgeTahsilat": {"since": 2, "label": "Belgeye git: tahsilatın faturası", "requires": ["component:liste"]},
    "component:belgeSatisIadesi": {"since": 2, "label": "Belgeye git: satış iadesi", "requires": ["component:liste"]},
    "component:belgeAlisFaturasi": {"since": 2, "label": "Belgeye git: alış faturası / ödeme", "requires": ["component:liste"]},
    "component:belgeAlisIadesi": {"since": 2, "label": "Belgeye git: alış iadesi", "requires": ["component:liste"]},
    "component:belgeTaslak": {"since": 2, "label": "Belgeye git: alış faturası taslağı", "requires": ["component:liste"]},
    "component:altBilgi": {"since": 1, "label": "B/A ve ters kayıt notu", "requires": ["component:cariSecimi"]},
    "query:cariListesi": {"since": 1, "label": "Cari seçimi seçenekleri", "requires": ["component:cariSecimi"]},
    "query:ekstre": {"since": 1, "label": "Cari hesap ekstresi", "requires": ["component:cariSecimi", "component:baslangic", "component:bitis"]}
  },
  "screenViews": [
    {"key": "customer-ledger-entries", "component": "liste", "fields": {"entryDate": "entryDate", "source": "sourceCode", "description": "description", "direction": "direction", "debit": "debitAmount", "credit": "creditAmount", "balance": "balanceAmount", "currencyCode": "currencyCode"}}
  ],
  "definition": {
    "schemaVersion": 2,
    "template": {"name": "list"},
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"exportTable": "liste", "titleCount": "{{ekstre.satirSayisi}}", "hiddenCommands": ["new", "open", "save", "delete", "filter", "print"], "slot": "commands"}},
      {"id": "borcGostergesi", "type": "metric", "name": "borcGostergesi", "props": {"title": "Borç toplamı", "value": "{{ekstre.meta.debitTotal}}", "format": "money", "icon": "trending-up", "description": "{{ekstre.meta.currencyCode}} · dönem", "visibleWhen": "cariSecimi.value != null", "slot": "indicators"}},
      {"id": "alacakGostergesi", "type": "metric", "name": "alacakGostergesi", "props": {"title": "Alacak toplamı", "value": "{{ekstre.meta.creditTotal}}", "format": "money", "icon": "trending-down", "description": "{{ekstre.meta.currencyCode}} · dönem", "visibleWhen": "cariSecimi.value != null", "slot": "indicators"}},
      {"id": "bakiyeGostergesi", "type": "metric", "name": "bakiyeGostergesi", "props": {"title": "Dönem sonu bakiye", "value": "{{ekstre.meta.closingAmount}}", "format": "money", "icon": "wallet", "description": "{{ekstre.meta.closingSide}} · {{ekstre.meta.currencyCode}}", "visibleWhen": "cariSecimi.value != null", "slot": "indicators"}},
      {"id": "cariSecimi", "type": "input", "name": "cariSecimi", "props": {"inputType": "lookup", "label": "Cari", "placeholder": "Cari kodu veya unvanıyla ara", "optionsQuery": "cariListesi", "optionValueColumn": "id", "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "defaultValue": "{{sayfa.parametre.customerId}}", "slot": "above"}},
      {"id": "baslangic", "type": "input", "name": "baslangic", "props": {"inputType": "date", "label": "Başlangıç tarihi", "required": true, "defaultValue": "{{tarih.yilBasi}}", "slot": "above"}},
      {"id": "bitis", "type": "input", "name": "bitis", "props": {"inputType": "date", "label": "Bitiş tarihi", "required": true, "defaultValue": "{{bugun}}", "slot": "above"}},
      {"id": "suzgecKarti", "type": "formCard", "name": "suzgecKarti", "props": {"title": "Cari ve dönem", "layout": "inline", "inputs": ["cariSecimi", "baslangic", "bitis"], "slot": "above"}},
      {"id": "secimIpucu", "type": "alert", "name": "secimIpucu", "props": {"title": "Cari seçin", "variant": "info", "text": "Ekstreyi görmek için yukarıdan bir cari hesap seçin.", "visibleWhen": "cariSecimi.value == null", "slot": "above"}},
      {"id": "tarihUyarisi", "type": "alert", "name": "tarihUyarisi", "props": {"title": "Tarih aralığı geçersiz", "variant": "danger", "text": "Bitiş tarihi başlangıç tarihinden önce olamaz.", "visibleWhen": "cariSecimi.value != null && bitis.value < baslangic.value", "slot": "above"}},
      {"id": "dovizUyarisi", "type": "alert", "name": "dovizUyarisi", "props": {"title": "Farklı dövizli hareket var", "variant": "warning", "text": "Toplamlar ve bakiye dövize göre ayrıştırılmaz; tutarlar kur çevrimi yapılmadan toplanır.", "visibleWhen": "cariSecimi.value != null && ekstre.meta.hasForeignCurrency == true", "slot": "above"}},
      {"id": "liste", "type": "dataTable", "name": "liste", "props": {"title": "Hesap hareketleri", "query": "ekstre", "visibleWhen": "cariSecimi.value != null", "columns": ["entryDate", "sourceType", "sourceCode", "description", "direction", "debitAmount", "creditAmount", "balanceAmount", "isReversal", "hasReversal"], "columnLabels": ["entryDate=Tarih", "sourceType=Belge türü", "sourceCode=Belge no", "description=Açıklama", "direction=Yön", "debitAmount=Borç", "creditAmount=Alacak", "balanceAmount=Bakiye", "currencyCode=Döviz", "isReversal=Ters kayıt", "hasReversal=Ters çevrildi"], "columnUnits": ["debitAmount=foreignCurrencyCode", "creditAmount=foreignCurrencyCode", "balanceAmount=balanceSide"], "columnFormats": ["entryDate=date", "sourceType=status", "sourceCode=code", "direction=status", "debitAmount=money", "creditAmount=money", "balanceAmount=money", "isReversal=status", "hasReversal=status"], "valueLabels": ["direction:Debit=Borç", "direction:Credit=Alacak", "isReversal:true=Ters kayıt", "isReversal:false=—", "hasReversal:true=Ters çevrildi", "hasReversal:false=—", "sourceType:SalesInvoice=Satış faturası", "sourceType:CustomerCollection=Tahsilat", "sourceType:SalesReturn=Satış iadesi", "sourceType:PurchaseInvoice=Alış faturası", "sourceType:PurchaseInvoiceDraft=Alış faturası taslağı", "sourceType:SupplierPayment=Tedarikçi ödemesi", "sourceType:SupplierReturn=Alış iadesi"], "toneMap": ["Ters kayıt=info", "Ters çevrildi=warning", "Satış faturası=info", "Tahsilat=info", "Satış iadesi=info", "Alış faturası=info", "Alış faturası taslağı=info", "Tedarikçi ödemesi=info", "Alış iadesi=info"], "rowActions": ["belgeSatisFaturasi", "belgeTahsilat", "belgeSatisIadesi", "belgeAlisFaturasi", "belgeAlisIadesi", "belgeTaslak"], "totals": ["debitAmount", "creditAmount"], "emptyText": "Seçilen tarih aralığında hareket bulunmuyor.", "slot": "list"}},
      {"id": "belgeSatisFaturasi", "type": "button", "name": "belgeSatisFaturasi", "props": {"text": "Belgeye git ›", "actionType": "erpPage", "pageKey": "sales-invoices", "target": "newTab", "legacyScreen": true, "params": ["invoiceId={{liste.seciliSatir.sourceOpenId}}"], "visibleWhen": "liste.seciliSatir.sourceType == 'SalesInvoice'", "disabledWhen": "liste.seciliSatir.sourceOpenId == null", "disabledReason": "Bağlı belge açılamıyor.", "slot": "rowActions"}},
      {"id": "belgeTahsilat", "type": "button", "name": "belgeTahsilat", "props": {"text": "Belgeye git ›", "actionType": "erpPage", "pageKey": "sales-invoices", "target": "newTab", "legacyScreen": true, "params": ["invoiceId={{liste.seciliSatir.sourceOpenId}}", "tab=transactions"], "visibleWhen": "liste.seciliSatir.sourceType == 'CustomerCollection'", "disabledWhen": "liste.seciliSatir.sourceOpenId == null", "disabledReason": "Bağlı belge açılamıyor.", "slot": "rowActions"}},
      {"id": "belgeSatisIadesi", "type": "button", "name": "belgeSatisIadesi", "props": {"text": "Belgeye git ›", "actionType": "erpPage", "pageKey": "sales-returns", "target": "newTab", "legacyScreen": true, "params": ["returnId={{liste.seciliSatir.sourceOpenId}}"], "visibleWhen": "liste.seciliSatir.sourceType == 'SalesReturn'", "disabledWhen": "liste.seciliSatir.sourceOpenId == null", "disabledReason": "Bağlı belge açılamıyor.", "slot": "rowActions"}},
      {"id": "belgeAlisFaturasi", "type": "button", "name": "belgeAlisFaturasi", "props": {"text": "Belgeye git ›", "actionType": "erpPage", "pageKey": "sales-purchase-invoices", "target": "newTab", "legacyScreen": true, "params": ["invoiceId={{liste.seciliSatir.sourceOpenId}}"], "visibleWhen": "liste.seciliSatir.sourceType == 'PurchaseInvoice' || liste.seciliSatir.sourceType == 'SupplierPayment'", "disabledWhen": "liste.seciliSatir.sourceOpenId == null", "disabledReason": "Bağlı belge açılamıyor.", "slot": "rowActions"}},
      {"id": "belgeAlisIadesi", "type": "button", "name": "belgeAlisIadesi", "props": {"text": "Belgeye git ›", "actionType": "erpPage", "pageKey": "sales-purchase-returns", "target": "newTab", "legacyScreen": true, "params": ["returnId={{liste.seciliSatir.sourceOpenId}}"], "visibleWhen": "liste.seciliSatir.sourceType == 'SupplierReturn'", "disabledWhen": "liste.seciliSatir.sourceOpenId == null", "disabledReason": "Bağlı belge açılamıyor.", "slot": "rowActions"}},
      {"id": "belgeTaslak", "type": "button", "name": "belgeTaslak", "props": {"text": "Belgeye git ›", "actionType": "erpPage", "pageKey": "sales-purchase-invoice-drafts", "target": "newTab", "legacyScreen": true, "params": ["draftId={{liste.seciliSatir.sourceOpenId}}"], "visibleWhen": "liste.seciliSatir.sourceType == 'PurchaseInvoiceDraft'", "disabledWhen": "liste.seciliSatir.sourceOpenId == null", "disabledReason": "Bağlı belge açılamıyor.", "slot": "rowActions"}},
      {"id": "altBilgi", "type": "text", "name": "altBilgi", "props": {"text": "B borç bakiyesi · A alacak bakiyesi · Ters kayıt orijinal hareketin karşı kaydıdır; hareketler silinmez.", "visibleWhen": "cariSecimi.value != null", "slot": "below"}}
    ],
    "queries": [
      {"id": "cariListesi", "name": "cariListesi", "kind": "read", "operation": "cari.listele", "runOn": "load", "parameters": [{"name": "q", "binding": "{{cariSecimi.search}}", "type": "text"}]},
      {"id": "ekstre", "name": "ekstre", "kind": "read", "operation": "cari.ekstre", "runOn": "load", "parameters": [{"name": "id", "binding": "{{cariSecimi.value}}", "type": "guid"}, {"name": "from", "binding": "{{baslangic.value}}", "type": "date"}, {"name": "to", "binding": "{{bitis.value}}", "type": "date"}]}
    ]
  }
}
