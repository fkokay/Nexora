{
  "screenKey": "inventory-warehouses", "title": "Depo Yönetimi", "description": "Depoları ve kullanım durumlarını yönetin.",
  "module": "Stok & Depo", "version": 2, "stage": "preview",
  "items": {
    "component:depoListesi": { "since": 1, "label": "Depo listesi", "requires": ["query:depolar"] },
    "query:depolar": { "since": 1, "label": "Depoları listele" },

    "component:komutlar": { "since": 2, "label": "İşlem çubuğu",
      "requires": ["query:olustur", "query:ozelKaydet", "query:guncelle", "component:depoKodu", "component:depoAdi", "component:ozelAlanlar",
                   "component:suzgec", "component:devreDisiBirak", "component:etkinlestir", "component:listeyiYenile"] },
    "component:suzgec": { "since": 2, "label": "Süzgeç alanı (arama, durum)" },
    "component:depoKarti": { "since": 2, "label": "Depo kaydı (sağ bölme)",
      "requires": ["component:depoKimligi", "component:ozelAlanlar", "component:pasifNotu", "query:konumlar"] },
    "component:depoKimligi": { "since": 2, "label": "Form bölümü: Depo Kimliği", "requires": ["component:depoKodu", "component:depoAdi"] },
    "component:depoKodu": { "since": 2, "label": "Alan: Depo kodu" },
    "component:depoAdi": { "since": 2, "label": "Alan: Depo adı" },
    "component:ozelAlanlar": { "since": 2, "label": "Depo Özel Alanları", "requires": ["query:ozelTanimlar", "query:ozelDegerler"] },
    "component:pasifNotu": { "since": 2, "label": "Devre dışı depo notu" },
    "component:devreDisiBirak": { "since": 2, "label": "Devre dışı bırak düğmesi",
      "requires": ["query:pasifeAl", "component:depoKodu", "component:depoAdi", "component:ozelAlanlar"] },
    "component:etkinlestir": { "since": 2, "label": "Yeniden etkinleştir düğmesi",
      "requires": ["query:aktifEt", "component:depoKodu", "component:depoAdi", "component:ozelAlanlar"] },
    "component:listeyiYenile": { "since": 2, "label": "Kayıttan sonra listeyi yenile" },
    "query:ozelTanimlar": { "since": 2, "label": "Depo özel alan tanımları" },
    "query:ozelDegerler": { "since": 2, "label": "Seçili deponun özel alan değerleri" },
    "query:konumlar": { "since": 2, "label": "Seçili deponun konumları" },
    "query:olustur": { "since": 2, "label": "Depo oluştur", "requires": ["component:depoKodu", "component:depoAdi", "component:ozelAlanlar"] },
    "query:guncelle": { "since": 2, "label": "Depo güncelle", "requires": ["component:depoKodu", "component:depoAdi"] },
    "query:ozelKaydet": { "since": 2, "label": "Depo özel alanlarını kaydet", "requires": ["component:ozelAlanlar", "query:ozelDegerler"] },
    "query:pasifeAl": { "since": 2, "label": "Depoyu pasife al" },
    "query:aktifEt": { "since": 2, "label": "Depoyu etkinleştir" }
  },
  "screenViews": [ { "key": "inventory-warehouses", "component": "depoListesi",
                     "fields": { "code": "code", "name": "name", "status": "isActive" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "newInputs": ["depoKodu", "depoAdi"], "newAction": "clear",
                   "saveSequence": ["olustur", "ozelKaydet", "guncelle"], "stopOnError": true,
                   "sequenceWhen": ["olustur=depoListesi.seciliSatir.id == null",
                                    "ozelKaydet=depoListesi.seciliSatir.id != null && depoListesi.seciliSatir.isActive == true && ozelAlanlar.degisti == true",
                                    "guncelle=depoListesi.seciliSatir.id != null && (depoKodu.value != depoListesi.seciliSatir.code || depoAdi.value != depoListesi.seciliSatir.name)"],
                   "afterSaveButton": "listeyiYenile",
                   "moreButtons": ["devreDisiBirak", "etkinlestir"], "focusInput": "suzgec", "exportTable": "depoListesi",
                   "titleCount": "{{depolar.rowCount}}" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "depoListesi", "search": true, "searchPlaceholder": "Depo kodu veya adıyla ara", "searchColumns": ["code", "name"],
                   "filters": ["isActive|select|row||Durum"] } },
      { "id": "depoListesi", "type": "dataTable", "name": "depoListesi",
        "props": { "title": "Depolar", "query": "depolar", "width": 6, "columns": ["code", "name", "isActive"],
                   "columnLabels": ["code=Depo kodu", "name=Depo adı", "isActive=Durum"],
                   "columnFormats": ["code=code", "isActive=status"],
                   "valueLabels": ["isActive:true=Aktif", "isActive:false=Pasif"], "toneMap": ["Aktif=success", "Pasif=info"],
                   "emptyText": "Henüz depo tanımlanmamış" } },

      { "id": "depoKarti", "type": "card", "name": "depoKarti",
        "props": { "variant": "panel", "width": 6, "title": "{{depoListesi.seciliSatir.name}}", "description": "{{depoListesi.seciliSatir.code}}" },
        "children": [
          { "id": "depoAktifEtiketi", "type": "badge", "name": "depoAktifEtiketi",
            "props": { "text": "Aktif", "variant": "success", "visibleWhen": "depoListesi.seciliSatir.isActive == true" } },
          { "id": "depoPasifEtiketi", "type": "badge", "name": "depoPasifEtiketi",
            "props": { "text": "Pasif", "variant": "info", "visibleWhen": "depoListesi.seciliSatir.isActive == false" } },
          { "id": "yeniDepoBasligi", "type": "heading", "name": "yeniDepoBasligi",
            "props": { "text": "Yeni depo", "visibleWhen": "depoListesi.seciliSatir.id == null" } },
          { "id": "depoSekmeleri", "type": "tabs", "name": "depoSekmeleri",
            "props": { "tabs": ["Depo=depoKimligi,ozelAlanlar,pasifNotu"] } },
          { "id": "konumTablosu", "type": "dataTable", "name": "konumTablosu",
            "props": { "title": "Lokasyonlar", "query": "konumlar", "columns": ["code", "name", "isActive"],
                       "columnLabels": ["code=Kod", "name=Ad", "isActive=Durum"], "columnFormats": ["code=code", "isActive=status"],
                       "valueLabels": ["isActive:true=Aktif", "isActive:false=Pasif"], "toneMap": ["Aktif=success", "Pasif=info"],
                       "emptyText": "Bu depoda henüz konum yok.", "visibleWhen": "depoListesi.seciliSatir.id != null",
                       "showGridSearch": false, "showColumnFilters": false, "showColumnChooser": false, "showExport": false, "showPivot": false } },
          { "id": "konumlariYonet", "type": "button", "name": "konumlariYonet",
            "props": { "text": "{{konumlar.rowCount}} · Tümünü yönet ›", "actionType": "page", "pageCode": "@inventory-locations", "target": "newTab",
                       "params": ["warehouseId={{depoListesi.seciliSatir.id}}"], "visibleWhen": "depoListesi.seciliSatir.id != null" } },
          { "id": "lokasyonEkle", "type": "button", "name": "lokasyonEkle",
            "props": { "text": "Lokasyon ekle", "actionType": "page", "pageCode": "@inventory-locations", "target": "newTab",
                       "params": ["warehouseId={{depoListesi.seciliSatir.id}}"],
                       "visibleWhen": "kullanici.rol == 'TenantAdmin' && depoListesi.seciliSatir.isActive == true" } }
        ] },
      { "id": "depoKimligi", "type": "formCard", "name": "depoKimligi",
        "props": { "title": "Depo Kimliği", "columns": 2, "inputs": ["depoKodu", "depoAdi"],
                   "recordKey": "{{depoListesi.seciliSatir.id}}:{{depoListesi.seciliSatir.rowVersion}}", "trackChanges": true } },
      { "id": "depoKodu", "type": "input", "name": "depoKodu",
        "props": { "inputType": "text", "label": "Depo kodu", "required": true, "maxLength": 40, "upperCase": true,
                   "defaultValue": "{{depoListesi.seciliSatir.code}}" } },
      { "id": "depoAdi", "type": "input", "name": "depoAdi",
        "props": { "inputType": "text", "label": "Depo adı", "required": true, "maxLength": 120,
                   "defaultValue": "{{depoListesi.seciliSatir.name}}" } },
      { "id": "ozelAlanlar", "type": "customFieldsBlock", "name": "ozelAlanlar",
        "props": { "title": "Depo Özel Alanları", "definitionsQuery": "ozelTanimlar", "valuesQuery": "ozelDegerler", "columns": 2,
                   "disabledWhen": "depoListesi.seciliSatir.isActive == false" } },
      { "id": "pasifNotu", "type": "text", "name": "pasifNotu",
        "props": { "text": "Devre dışı depoda değerler kaydedilemez.", "visibleWhen": "depoListesi.seciliSatir.isActive == false" } },

      { "id": "devreDisiBirak", "type": "button", "name": "devreDisiBirak",
        "props": { "text": "Devre dışı bırak", "actionType": "query", "queryId": "pasifeAl", "confirmEnabled": true,
                   "confirmText": "{{depoListesi.seciliSatir.code}} · {{depoListesi.seciliSatir.name}} devre dışı bırakılsın mı? Depoda sıfırdan farklı stok varsa işlem reddedilir.",
                   "successMessage": "Depo devre dışı bırakıldı.", "refreshQueries": ["depolar"],
                   "visibleWhen": "depoListesi.seciliSatir.isActive == true",
                   "disabledWhen": "depoKodu.value != depoListesi.seciliSatir.code || depoAdi.value != depoListesi.seciliSatir.name || ozelAlanlar.degisti == true",
                   "disabledReason": "Önce değişiklikleri kaydedin veya vazgeçin" } },
      { "id": "etkinlestir", "type": "button", "name": "etkinlestir",
        "props": { "text": "Yeniden etkinleştir", "actionType": "query", "queryId": "aktifEt", "confirmEnabled": true,
                   "confirmText": "{{depoListesi.seciliSatir.code}} · {{depoListesi.seciliSatir.name}} yeniden etkinleştirilsin mi?",
                   "successMessage": "Depo yeniden etkinleştirildi.", "refreshQueries": ["depolar"],
                   "visibleWhen": "depoListesi.seciliSatir.isActive == false",
                   "disabledWhen": "depoKodu.value != depoListesi.seciliSatir.code || depoAdi.value != depoListesi.seciliSatir.name || ozelAlanlar.degisti == true",
                   "disabledReason": "Önce değişiklikleri kaydedin veya vazgeçin" } },
      { "id": "listeyiYenile", "type": "button", "name": "listeyiYenile",
        "props": { "text": "Listeyi yenile", "actionType": "query", "queryId": "depolar" } }
    ],
    "queries": [
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "parameters": [], "runOn": "load" },
      { "id": "ozelTanimlar", "name": "ozelTanimlar", "kind": "read", "operation": "depo.ozelAlanTanimlari", "runOn": "load", "parameters": [] },
      { "id": "ozelDegerler", "name": "ozelDegerler", "kind": "read", "operation": "depo.ozelAlanDegerleri", "runOn": "load",
        "parameters": [ { "name": "warehouseId", "binding": "{{depoListesi.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "konumlar", "name": "konumlar", "kind": "read", "operation": "depo.konumlari", "runOn": "load",
        "parameters": [ { "name": "warehouseId", "binding": "{{depoListesi.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "olustur", "name": "olustur", "kind": "insert", "operation": "depo.olustur", "runOn": "manual",
        "parameters": [
          { "name": "code", "binding": "{{depoKodu.value}}", "type": "text" },
          { "name": "name", "binding": "{{depoAdi.value}}", "type": "text" },
          { "name": "customFields", "binding": "{{ozelAlanlar.degerler}}", "type": "map" } ] },
      { "id": "ozelKaydet", "name": "ozelKaydet", "kind": "update", "operation": "depo.ozelAlanKaydet", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{depoListesi.seciliSatir.id}}", "type": "guid" },
          { "name": "values", "binding": "{{ozelAlanlar.degerler}}", "type": "map" } ] },
      { "id": "guncelle", "name": "guncelle", "kind": "update", "operation": "depo.guncelle", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{depoListesi.seciliSatir.id}}", "type": "guid" },
          { "name": "code", "binding": "{{depoKodu.value}}", "type": "text" },
          { "name": "name", "binding": "{{depoAdi.value}}", "type": "text" },
          { "name": "rowVersion", "binding": "{{depoListesi.seciliSatir.rowVersion}}", "type": "text" } ] },
      { "id": "pasifeAl", "name": "pasifeAl", "kind": "update", "operation": "depo.pasifeAl", "runOn": "manual",
        "parameters": [ { "name": "warehouseId", "binding": "{{depoListesi.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "aktifEt", "name": "aktifEt", "kind": "update", "operation": "depo.aktifEt", "runOn": "manual",
        "parameters": [ { "name": "warehouseId", "binding": "{{depoListesi.seciliSatir.id}}", "type": "guid" } ] }
    ]
  }
}
