{
  "screenKey": "inventory-warehouses",
  "title": "Depo Yönetimi",
  "description": "Depoları ve kullanım durumlarını yönetin.",
  "module": "Stok & Depo",
  "version": 4,
  "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1,"label": "İşlem çubuğu","requires": ["component:suzgec","component:depoListesi","component:yeniDepoDugmesi","component:duzenleDugmesi"]},
    "component:suzgec": {"since": 1,"label": "Süzgeç alanı (arama, durum)","requires": ["component:depoListesi"]},
    "component:depoListesi": {"since": 1,"label": "Depo listesi","requires": ["query:depolar","component:konumlarDugmesi","component:devreDisiBirak","component:etkinlestir"]},
    "component:yeniDepoDugmesi": {"since": 1,"label": "Yeni depo komutu","requires": ["component:yeniDepoPenceresi"]},
    "component:duzenleDugmesi": {"since": 1,"label": "Düzenle komutu","requires": ["component:duzenlePenceresi","component:depoListesi"]},
    "component:konumlarDugmesi": {"since": 1,"label": "Konumlar satır eylemi","requires": ["component:depoListesi"]},
    "component:devreDisiBirak": {"since": 1,"label": "Pasife al satır eylemi","requires": ["query:pasifeAl","component:depoListesi"]},
    "component:etkinlestir": {"since": 1,"label": "Etkinleştir satır eylemi","requires": ["query:aktifEt","component:depoListesi"]},
    "component:depoKarti": {"since": 1,"label": "Depo kartı (sağ bölme)","requires": ["component:depoListesi","query:konumlar"]},
    "component:yeniDepoPenceresi": {"since": 1,"label": "Yeni depo penceresi","requires": ["component:yeniDepoFormu","query:olustur","query:depolar"]},
    "component:yeniDepoFormu": {"since": 1,"label": "Yeni depo formu","requires": ["component:yeniDepoKodu","component:yeniDepoAdi"]},
    "component:yeniDepoKodu": {"since": 1,"label": "Alan: Depo kodu (yeni)"},
    "component:yeniDepoAdi": {"since": 1,"label": "Alan: Depo adı (yeni)"},
    "component:duzenlePenceresi": {"since": 1,"label": "Depo penceresi (düzenle)","requires": ["component:duzenleFormu","query:guncelle","query:depolar","component:depoListesi","component:depoOzelAlanlar","query:ozelKaydet","query:ozelTanimlar","query:ozelDegerler"]},
    "component:duzenleFormu": {"since": 1,"label": "Depo formu (düzenle)","requires": ["component:depoKodu","component:depoAdi"]},
    "component:depoKodu": {"since": 1,"label": "Alan: Depo kodu","requires": ["component:depoListesi"]},
    "component:depoAdi": {"since": 1,"label": "Alan: Depo adı","requires": ["component:depoListesi"]},
    "query:depolar": {"since": 1,"label": "Depoları listele"},
    "query:konumlar": {"since": 1,"label": "Seçili deponun konumları","requires": ["component:depoListesi"]},
    "query:olustur": {"since": 1,"label": "Depo oluştur","requires": ["component:yeniDepoKodu","component:yeniDepoAdi"]},
    "query:guncelle": {"since": 1,"label": "Depo güncelle","requires": ["component:depoListesi","component:depoKodu","component:depoAdi","component:depoOzelAlanlar","query:ozelKaydet","query:ozelTanimlar","query:ozelDegerler"]},
    "query:pasifeAl": {"since": 1,"label": "Depoyu pasife al","requires": ["component:depoListesi"]},
    "query:aktifEt": {"since": 1,"label": "Depoyu etkinleştir","requires": ["component:depoListesi"]},
    "query:ozelTanimlar": {"since": 4,"label": "Depo ?zel alan tan?mlar?"},
    "query:ozelDegerler": {"since": 4,"label": "Se?ili deponun ?zel alan de?erleri"},
    "query:ozelKaydet": {"since": 4,"label": "Depo Özel alanlar?n? kaydet"},
    "component:depoOzelAlanlar": {"since": 4,"label": "Depo Özel alanlar?"}
  },
  "screenViews": [{"key": "inventory-warehouses","component": "depoListesi","fields": {"code": "code","name": "name","status": "isActive"}}],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {"id": "komutlar","type": "actionBar","name": "komutlar","props": {"newButton": "yeniDepoDugmesi","openButton": "duzenleDugmesi","focusInput": "suzgec","exportTable": "depoListesi","titleCount": "{{depolar.rowCount}}","hiddenCommands": ["save","delete","print"],"slot": "commands"}},
      {"id": "yeniDepoDugmesi","type": "button","name": "yeniDepoDugmesi","props": {"text": "Yeni depo","actionType": "openDialog","dialogId": "yeniDepoPenceresi","slot": "actions"}},
      {"id": "duzenleDugmesi","type": "button","name": "duzenleDugmesi","props": {"text": "Düzenle","actionType": "openDialog","dialogId": "duzenlePenceresi","disabledWhen": "depoListesi.seciliSatir.id == null","disabledReason": "Önce bir depo seçin","slot": "actions"}},
      {"id": "suzgec","type": "filterBar","name": "suzgec","props": {"table": "depoListesi","search": true,"searchPlaceholder": "Depo kodu veya adıyla ara","searchColumns": ["code","name"],"filters": ["isActive|select|row||Durum"],"slot": "filters"}},
      {"id": "depoListesi","type": "dataTable","name": "depoListesi","props": {"title": "Depolar","query": "depolar","columns": ["code","name","isActive"],"columnLabels": ["code=Depo kodu","name=Depo adı","isActive=Durum"],"columnFormats": ["code=code","isActive=status"],"valueLabels": ["isActive:true=Aktif","isActive:false=Pasif"],"toneMap": ["Aktif=success","Pasif=info"],"rowActions": ["konumlarDugmesi","devreDisiBirak","etkinlestir"],"emptyText": "Henüz depo tanımlanmamış","slot": "list"}},
      {"id": "konumlarDugmesi","type": "button","name": "konumlarDugmesi","props": {"text": "Konumlar ›","actionType": "page","pageCode": "@inventory-locations","target": "newTab","params": ["warehouseId={{depoListesi.seciliSatir.id}}"],"slot": "rowActions"}},
      {"id": "devreDisiBirak","type": "button","name": "devreDisiBirak","props": {"text": "Pasife al","actionType": "query","queryId": "pasifeAl","confirmEnabled": true,"confirmText": "{{depoListesi.seciliSatir.code}} · {{depoListesi.seciliSatir.name}} pasife alınsın mı? Depoda sıfırdan farklı stok varsa işlem reddedilir.","successMessage": "Depo pasife alındı.","refreshQueries": ["depolar"],"visibleWhen": "depoListesi.seciliSatir.isActive == true","slot": "rowActions"}},
      {"id": "etkinlestir","type": "button","name": "etkinlestir","props": {"text": "Etkinleştir","actionType": "query","queryId": "aktifEt","confirmEnabled": true,"confirmText": "{{depoListesi.seciliSatir.code}} · {{depoListesi.seciliSatir.name}} yeniden etkinleştirilsin mi?","successMessage": "Depo yeniden etkinleştirildi.","refreshQueries": ["depolar"],"visibleWhen": "depoListesi.seciliSatir.isActive == false","slot": "rowActions"}},
      {"id": "depoKarti","type": "card","name": "depoKarti","props": {"variant": "panel","title": "{{depoListesi.seciliSatir.name}}","description": "{{depoListesi.seciliSatir.code}}","slot": "detail"},"children": [{"id": "depoAktifEtiketi","type": "badge","name": "depoAktifEtiketi","props": {"text": "Aktif","variant": "success","visibleWhen": "depoListesi.seciliSatir.isActive == true"}},{"id": "depoPasifEtiketi","type": "badge","name": "depoPasifEtiketi","props": {"text": "Pasif","variant": "info","visibleWhen": "depoListesi.seciliSatir.isActive == false"}},{"id": "depoSecin","type": "text","name": "depoSecin","props": {"text": "Bir depo seçin; ayrıntıları burada görün.","visibleWhen": "depoListesi.seciliSatir.id == null"}},{"id": "konumSayisi","type": "metric","name": "konumSayisi","props": {"title": "Konum sayısı","value": "{{konumlar.rowCount}}","format": "number","icon": "box","visibleWhen": "depoListesi.seciliSatir.id != null"}},{"id": "depoBilgi","type": "contextPanel","name": "depoBilgi","props": {"table": "depoListesi","visibleWhen": "depoListesi.seciliSatir.id != null","fields": ["code=Kod","name=Ad"]}},{"id": "pasifNotu","type": "text","name": "pasifNotu","props": {"text": "Devre dışı depoda hareket girilemez.","visibleWhen": "depoListesi.seciliSatir.isActive == false"}}]},
      {"id": "yeniDepoPenceresi","type": "dialog","name": "yeniDepoPenceresi","props": {"presentation": "dialog","size": "sm","title": "Yeni depo","contains": ["yeniDepoFormu"],"saveQuery": "olustur","saveLabel": "Kaydet","closeOnSave": true,"resetOnOpen": true,"refreshQueries": ["depolar"],"slot": "dialogs"}},
      {"id": "yeniDepoFormu","type": "formCard","name": "yeniDepoFormu","props": {"columns": 2,"inputs": ["yeniDepoKodu","yeniDepoAdi"],"slot": "dialog"}},
      {"id": "yeniDepoKodu","type": "input","name": "yeniDepoKodu","props": {"inputType": "text","label": "Depo kodu","required": true,"maxLength": 40,"upperCase": true,"slot": "dialog"}},
      {"id": "yeniDepoAdi","type": "input","name": "yeniDepoAdi","props": {"inputType": "text","label": "Depo adı","required": true,"maxLength": 120,"slot": "dialog"}},
      {"id": "duzenlePenceresi","type": "dialog","name": "duzenlePenceresi","props": {"presentation": "dialog","size": "sm","title": "Depo · {{depoListesi.seciliSatir.code}}","contains": ["duzenleFormu","depoOzelAlanlar"],"saveSequence": ["guncelle","ozelKaydet"],"stopOnError": true,"saveLabel": "Kaydet","closeOnSave": true,"resetOnOpen": true,"refreshQueries": ["depolar","ozelDegerler"],"slot": "dialogs"}},
      {"id": "duzenleFormu","type": "formCard","name": "duzenleFormu","props": {"columns": 2,"inputs": ["depoKodu","depoAdi"],"slot": "dialog"}},
      {"id": "depoKodu","type": "input","name": "depoKodu","props": {"inputType": "text","label": "Depo kodu","required": true,"maxLength": 40,"upperCase": true,"defaultValue": "{{depoListesi.seciliSatir.code}}","slot": "dialog"}},
      {"id": "depoAdi","type": "input","name": "depoAdi","props": {"inputType": "text","label": "Depo adı","required": true,"maxLength": 120,"defaultValue": "{{depoListesi.seciliSatir.name}}","slot": "dialog"}},
      {"id": "depoOzelAlanlar","type": "customFieldsBlock","name": "depoOzelAlanlar","props": {"title": "Özel alanlar","definitionsQuery": "ozelTanimlar","valuesQuery": "ozelDegerler","columns": 2,"slot": "dialog"}}
    ],
    "queries": [
      {"id": "depolar","name": "depolar","kind": "read","operation": "depo.listele","parameters": [],"runOn": "load"},
      {"id": "konumlar","name": "konumlar","kind": "read","operation": "depo.konumlari","runOn": "load","parameters": [{"name": "warehouseId","binding": "{{depoListesi.seciliSatir.id}}","type": "guid"}]},
      {"id": "olustur","name": "olustur","kind": "insert","operation": "depo.olustur","runOn": "manual","parameters": [{"name": "code","binding": "{{yeniDepoKodu.value}}","type": "text"},{"name": "name","binding": "{{yeniDepoAdi.value}}","type": "text"}]},
      {"id": "guncelle","name": "guncelle","kind": "update","operation": "depo.guncelle","runOn": "manual","parameters": [{"name": "warehouseId","binding": "{{depoListesi.seciliSatir.id}}","type": "guid"},{"name": "code","binding": "{{depoKodu.value}}","type": "text"},{"name": "name","binding": "{{depoAdi.value}}","type": "text"},{"name": "rowVersion","binding": "{{depoListesi.seciliSatir.rowVersion}}","type": "text"}]},
      {"id": "pasifeAl","name": "pasifeAl","kind": "update","operation": "depo.pasifeAl","runOn": "manual","parameters": [{"name": "warehouseId","binding": "{{depoListesi.seciliSatir.id}}","type": "guid"}]},
      {"id": "aktifEt","name": "aktifEt","kind": "update","operation": "depo.aktifEt","runOn": "manual","parameters": [{"name": "warehouseId","binding": "{{depoListesi.seciliSatir.id}}","type": "guid"}]},
      {"id": "ozelTanimlar","name": "ozelTanimlar","kind": "read","operation": "depo.ozelAlanTanimlari","runOn": "load","parameters": []},
      {"id": "ozelDegerler","name": "ozelDegerler","kind": "read","operation": "depo.ozelAlanDegerleri","runOn": "load","parameters": [{"name": "warehouseId","binding": "{{depoListesi.seciliSatir.id}}","type": "guid"}]},
      {"id": "ozelKaydet","name": "ozelKaydet","kind": "update","operation": "depo.ozelAlanKaydet","runOn": "manual","parameters": [{"name": "warehouseId","binding": "{{depoListesi.seciliSatir.id}}","type": "guid"},{"name": "values","binding": "{{depoOzelAlanlar.degerler}}","type": "map"}]}
    ],
    "template": {"name": "list"}
  }
}
