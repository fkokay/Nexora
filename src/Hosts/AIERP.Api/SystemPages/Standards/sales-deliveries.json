{
  "screenKey": "sales-deliveries", "title": "Satış İrsaliyeleri",
  "description": "Sevk edilen sipariş satırlarını, depoları ve bağlı faturaları izleyin.", "module": "Satış & cari",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:acDugmesi", "component:eskiEkranDugmesi", "component:faturaAcMenu", "component:faturalastirMenu", "component:iptalMenu", "component:liste", "component:suzgec", "component:yeniDugmesi", "query:irsaliyeSil", "query:irsaliyeler"]},
    "component:yeniDugmesi": {"since": 1, "label": "Yeni irsaliye komutu (eski ekran)"},
    "component:acDugmesi": {"since": 1, "label": "İrsaliyeyi aç komutu", "requires": ["component:irsaliyePenceresi", "component:liste"]},
    "component:faturalastirMenu": {"since": 1, "label": "Faturalaştır komutu", "requires": ["component:irsaliyePenceresi", "component:liste"]},
    "component:faturaAcMenu": {"since": 1, "label": "Faturayı aç komutu", "requires": ["component:liste"]},
    "component:iptalMenu": {"since": 1, "label": "İptal et komutu", "requires": ["component:liste", "query:irsaliye", "query:irsaliyeIptal", "query:irsaliyeler"]},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Siparişsiz irsaliyeyi eski ekranda aç", "requires": ["component:liste"]},
    "component:faturalanmamisGostergesi": {"since": 1, "label": "Faturalanmamış göstergesi", "requires": ["component:faturaSecimi", "query:irsaliyeler"]},
    "component:iptalGostergesi": {"since": 1, "label": "İptal göstergesi", "requires": ["query:irsaliyeler"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:secimCipleri": {"since": 1, "label": "Durum ve fatura seçimi", "requires": ["component:durumSecimi", "component:faturaSecimi"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeç seçimleri kartı", "requires": ["component:durumSecimi", "component:faturaSecimi"]},
    "component:durumSecimi": {"since": 1, "label": "Durum seçimi"},
    "component:faturaSecimi": {"since": 1, "label": "Faturalanmamış seçimi"},
    "component:liste": {"since": 1, "label": "Satış irsaliyeleri listesi (birleşik)", "requires": ["component:acDugmesi", "component:faturaAcSatir", "query:irsaliyeler"]},
    "component:faturaAcSatir": {"since": 1, "label": "Satırdaki faturayı aç", "requires": ["component:liste"]},
    "component:irsaliyePenceresi": {"since": 1, "label": "İrsaliye detayı penceresi", "requires": ["component:irsaliyeBasligi", "component:irsaliyeDurumu", "component:irsaliyeSekmeleri", "query:irsaliye"]},
    "component:irsaliyeBasligi": {"since": 1, "label": "İrsaliye detayı başlığı", "requires": ["query:irsaliye", "query:kalemler"]},
    "component:irsaliyeDurumu": {"since": 1, "label": "İrsaliye durumu ve işlemleri", "requires": ["query:irsaliye", "query:irsaliyeIptal", "query:irsaliyeler"]},
    "component:irsaliyeSekmeleri": {"since": 1, "label": "İrsaliye detayı sekmeleri", "requires": ["component:faturaBolumu", "component:kalemTablosu"]},
    "component:kalemTablosu": {"since": 1, "label": "İrsaliye kalemleri", "requires": ["query:kalemler"]},
    "component:faturaBolumu": {"since": 1, "label": "Faturalaştırma formu", "requires": ["component:aliciEtiketi", "component:eBelgeSenaryosu", "component:eBelgeTuru", "component:faturaNotu", "component:faturaTuru", "query:faturaAlanTanimlari", "query:faturalastir", "query:irsaliye", "query:irsaliyeler"]},
    "component:faturaTuru": {"since": 1, "label": "Fatura türü"},
    "component:eBelgeSenaryosu": {"since": 1, "label": "E-belge senaryosu"},
    "component:eBelgeTuru": {"since": 1, "label": "E-belge tür kodu"},
    "component:aliciEtiketi": {"since": 1, "label": "Alıcı e-Fatura etiketi"},
    "component:faturaNotu": {"since": 1, "label": "Fatura notu"},
    "query:irsaliyeler": {"since": 1, "label": "Satış irsaliyelerini listele (siparişli ve siparişsiz)", "requires": ["component:durumSecimi", "component:faturaSecimi", "component:liste", "component:suzgec"]},
    "query:irsaliye": {"since": 1, "label": "Seçili irsaliye", "requires": ["component:liste"]},
    "query:kalemler": {"since": 1, "label": "Seçili irsaliyenin kalemleri", "requires": ["component:liste"]},
    "query:faturaAlanTanimlari": {"since": 1, "label": "Fatura özel alan tanımları"},
    "query:irsaliyeIptal": {"since": 1, "label": "İrsaliyeyi iptal et", "requires": ["component:liste"]},
    "query:irsaliyeSil": {"since": 1, "label": "İrsaliyeyi sil", "requires": ["component:liste"]},
    "query:faturalastir": {"since": 1, "label": "İrsaliyeyi faturalaştır", "requires": ["component:aliciEtiketi", "component:eBelgeSenaryosu", "component:eBelgeTuru", "component:faturaBolumu", "component:faturaNotu", "component:faturaTuru", "component:liste"]}
  },
  "screenViews": [
    {"key": "sales-deliveries", "component": "liste", "fields": {"code": "code", "orderCode": "orderCode", "deliveryDate": "deliveryDate", "warehouseName": "warehouseName", "lineCount": "lineCount", "status": "status", "invoiceStatus": "invoiceStatus"}}
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": {
          "newButton": "yeniDugmesi",
          "openButton": "acDugmesi",
          "deleteQuery": "irsaliyeSil", "deleteConfirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.customerName}} irsaliyesi silinsin mi?",
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{irsaliyeler.meta.totalCount}}",
          "moreButtons": ["faturalastirMenu", "faturaAcMenu", "iptalMenu", "eskiEkranDugmesi"],
          "commandWhen": ["delete=kullanici.rol == 'TenantAdmin' && liste.seciliSatir.status == 'Voided' && liste.seciliSatir.isStandalone != true"],
          "hiddenCommands": ["save", "print"] } },
      { "id": "yeniDugmesi", "type": "button", "name": "yeniDugmesi",
        "props": {
          "text": "Yeni irsaliye",
          "actionType": "erpPage",
          "pageKey": "sales-delivery-create",
          "target": "newTab" } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": {
          "text": "Aç",
          "icon": "open",
          "actionType": "openDialog",
          "dialogId": "irsaliyePenceresi",
          "disabledWhen": "liste.seciliSatir.salesDeliveryId == null",
          "disabledReason": "Önce bir kayıt seçin. Siparişsiz irsaliye eski ekranda açılır: İşlemler › Eski ekranda aç." } },
      { "id": "faturalastirMenu", "type": "button", "name": "faturalastirMenu",
        "props": {
          "text": "Faturalaştır",
          "actionType": "openDialog",
          "dialogId": "irsaliyePenceresi",
          "visibleWhen": "liste.seciliSatir.kind == 'Order' && liste.seciliSatir.status == 'Posted' && liste.seciliSatir.hasSalesInvoice == false" } },
      { "id": "faturaAcMenu", "type": "button", "name": "faturaAcMenu",
        "props": {
          "text": "Faturayı aç",
          "actionType": "erpPage",
          "pageKey": "sales-invoices",
          "target": "newTab",
          "params": ["invoiceId={{liste.seciliSatir.invoiceId}}"],
          "visibleWhen": "liste.seciliSatir.invoiceId != null" } },
      { "id": "iptalMenu", "type": "button", "name": "iptalMenu",
        "props": {
          "text": "İptal et",
          "actionType": "query",
          "queryId": "irsaliyeIptal",
          "confirmEnabled": true,
          "confirmText": "“{{irsaliye.rows[0].code}}” iptal edilecek. Stok çıkışı ters hareketle geri alınır.",
          "visibleWhen": "kullanici.rol == 'TenantAdmin' && liste.seciliSatir.isStandalone != true && liste.seciliSatir.status == 'Posted'",
          "disabledWhen": "liste.seciliSatir.invoiceStatus == 'Posted' || irsaliye.rows[0].id != liste.seciliSatir.salesDeliveryId",
          "disabledReason": "Önce bağlı satış faturasını iptal edin.",
          "successMessage": "İrsaliye iptal edildi; stok çıkışı ters hareketle geri alındı.",
          "refreshQueries": ["irsaliyeler", "irsaliye"] } },
      { "id": "eskiEkranDugmesi", "type": "button", "name": "eskiEkranDugmesi",
        "props": {
          "text": "Eski ekranda aç (siparişsiz irsaliye)",
          "actionType": "erpPage",
          "pageKey": "sales-delivery-create",
          "target": "newTab",
          "params": ["customerId={{liste.seciliSatir.customerId}}"],
          "visibleWhen": "liste.seciliSatir.isStandalone == true" } },
      { "id": "faturalanmamisGostergesi", "type": "metric", "name": "faturalanmamisGostergesi",
        "props": {
          "title": "Faturalanmamış",
          "query": "irsaliyeler",
          "countWhen": "irsaliyeler.satir.status == 'Posted' && irsaliyeler.satir.hasSalesInvoice == false",
          "format": "number",
          "width": 3,
          "icon": "alert",
          "variant": "warning",
          "description": "bu sayfa · tıklayınca süzer",
          "filterInput": "faturaSecimi",
          "filterValue": "true" } },
      { "id": "iptalGostergesi", "type": "metric", "name": "iptalGostergesi",
        "props": {
          "title": "İptal",
          "query": "irsaliyeler",
          "countWhen": "irsaliyeler.satir.status == 'Voided'",
          "format": "number",
          "width": 3,
          "icon": "ban",
          "description": "bu sayfa" } },
      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": {
          "table": "liste",
          "width": 4,
          "search": true,
          "searchPlaceholder": "İrsaliye, sipariş veya müşteri ara",
          "searchParam": "q" } },
      { "id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri",
        "props": { "title": "Süzgeçler", "layout": "inline", "width": 8, "inputs": ["durumSecimi", "faturaSecimi"] } },
      { "id": "durumSecimi", "type": "input", "name": "durumSecimi",
        "props": {
          "inputType": "select",
          "label": "Durum",
          "staticOptions": ["=Tümü", "Posted=Sevk edildi", "Draft=Taslak", "Voided=İptal"] } },
      { "id": "faturaSecimi", "type": "input", "name": "faturaSecimi",
        "props": {
          "inputType": "select",
          "label": "Fatura",
          "staticOptions": ["=Tümü", "true=Faturalanmamış"] } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": {
          "width": 12,
          "inputs": ["durumSecimi", "faturaSecimi"] } },
      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": {
          "title": "Satış irsaliyeleri",
          "query": "irsaliyeler",
          "paging": "server",
          "pageSize": 25,
          "width": 12,
          "columns": ["code", "kind", "orderCode", "customerName", "deliveryDate", "warehouseName", "lineCount", "status", "invoiceCode", "invoiceStatus"],
          "columnLabels": ["code=İrsaliye no", "kind=Tür", "orderCode=Sipariş no", "customerName=Müşteri", "deliveryDate=Sevk tarihi", "warehouseName=Depo", "lineCount=Satır", "status=Durum", "invoiceCode=Fatura no", "invoiceStatus=Fatura", "createdAt=Oluşturulma"],
          "columnFormats": ["code=code", "kind=status", "deliveryDate=date", "lineCount=number", "status=status", "invoiceCode=code", "invoiceStatus=status", "createdAt=date"],
          "valueLabels": ["kind:Order=Siparişli", "kind:Invoice=Siparişsiz", "kind:Standalone=Siparişsiz", "status:Posted=Sevk edildi", "status:Voided=İptal", "status:Draft=Taslak", "invoiceStatus:Posted=Kesildi", "invoiceStatus:Voided=İptal", "invoiceStatus:=Yok"],
          "toneMap": ["Siparişsiz=warning", "Sevk edildi=success", "Kesildi=success", "Taslak=info", "İptal=info"],
          "rowActions": ["faturaAcSatir"],
          "rowOpenAction": "acDugmesi",
          "emptyText": "Henüz satış irsaliyesi yok. İrsaliye, açık sipariş ayrıntısından oluşturulur." } },
      { "id": "faturaAcSatir", "type": "button", "name": "faturaAcSatir",
        "props": {
          "text": "Faturayı aç",
          "actionType": "erpPage",
          "pageKey": "sales-invoices",
          "target": "newTab",
          "params": ["invoiceId={{liste.seciliSatir.invoiceId}}"],
          "visibleWhen": "liste.seciliSatir.invoiceId != null" } },
      { "id": "irsaliyePenceresi", "type": "dialog", "name": "irsaliyePenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Satış irsaliyesi · {{irsaliye.rows[0].code}}",
          "contains": ["irsaliyeBasligi", "irsaliyeDurumu", "irsaliyeSekmeleri"] } },
      { "id": "irsaliyeBasligi", "type": "recordHeader", "name": "irsaliyeBasligi",
        "props": {
          "icon": "truck",
          "title": "{{irsaliye.rows[0].code}}",
          "subtitle": "{{irsaliye.rows[0].warehouseName}} · sevk {{irsaliye.rows[0].deliveryDate}}",
          "fields": ["Bağlı sipariş={{irsaliye.rows[0].orderCode}}", "Sevk deposu={{irsaliye.rows[0].warehouseName}}", "Sevk tarihi={{irsaliye.rows[0].deliveryDate}}", "Satır={{kalemler.satirSayisi}}"],
          "fieldFormats": ["Sevk tarihi=date", "Satır=number"] } },
      { "id": "irsaliyeDurumu", "type": "section", "name": "irsaliyeDurumu",
        "props": {
          "width": 12 },
        "children": [
          { "id": "rozetSevk", "type": "badge", "name": "rozetSevk",
            "props": {
              "text": "Sevk edildi",
              "variant": "success",
              "visibleWhen": "irsaliye.rows[0].status == 'Posted'" } },
          { "id": "rozetIptal", "type": "badge", "name": "rozetIptal",
            "props": {
              "text": "İptal",
              "variant": "info",
              "visibleWhen": "irsaliye.rows[0].status == 'Voided'" } },
          { "id": "rozetSiparissiz", "type": "badge", "name": "rozetSiparissiz",
            "props": {
              "text": "Siparişsiz",
              "variant": "warning",
              "visibleWhen": "irsaliye.rows[0].id != null && irsaliye.rows[0].orderId == null" } },
          { "id": "rozetFaturali", "type": "badge", "name": "rozetFaturali",
            "props": {
              "text": "Faturası kesildi",
              "variant": "success",
              "visibleWhen": "irsaliye.rows[0].invoiceStatus == 'Posted'" } },
          { "id": "rozetFaturaIptal", "type": "badge", "name": "rozetFaturaIptal",
            "props": {
              "text": "Fatura iptal edildi",
              "variant": "info",
              "visibleWhen": "irsaliye.rows[0].invoiceStatus == 'Voided'" } },
          { "id": "rozetFaturaBekliyor", "type": "badge", "name": "rozetFaturaBekliyor",
            "props": {
              "text": "Fatura bekliyor",
              "variant": "warning",
              "visibleWhen": "irsaliye.rows[0].status == 'Posted' && irsaliye.rows[0].hasSalesInvoice == false" } },
          { "id": "detayIptal", "type": "button", "name": "detayIptal",
            "props": {
              "text": "İptal et",
              "actionType": "query",
              "queryId": "irsaliyeIptal",
              "confirmEnabled": true,
              "confirmText": "“{{irsaliye.rows[0].code}}” iptal edilecek. Stok çıkışı ters hareketle geri alınır.",
              "visibleWhen": "kullanici.rol == 'TenantAdmin' && irsaliye.rows[0].status == 'Posted'",
              "disabledWhen": "irsaliye.rows[0].invoiceStatus == 'Posted'",
              "disabledReason": "Önce bağlı satış faturasını iptal edin.",
              "successMessage": "İrsaliye iptal edildi; stok çıkışı ters hareketle geri alındı.",
              "refreshQueries": ["irsaliyeler", "irsaliye"] } },
          { "id": "detayFaturaAc", "type": "button", "name": "detayFaturaAc",
            "props": {
              "text": "Faturayı aç ›",
              "actionType": "erpPage",
              "pageKey": "sales-invoices",
              "target": "newTab",
              "params": ["invoiceId={{irsaliye.rows[0].invoiceId}}"],
              "visibleWhen": "irsaliye.rows[0].invoiceId != null" } },
          { "id": "detaySiparisAc", "type": "button", "name": "detaySiparisAc",
            "props": {
              "text": "Siparişi aç ›",
              "actionType": "erpPage",
              "pageKey": "sales-orders",
              "target": "newTab",
              "params": ["orderId={{irsaliye.rows[0].orderId}}"],
              "visibleWhen": "irsaliye.rows[0].orderId != null" } }
        ] },
      { "id": "irsaliyeSekmeleri", "type": "tabs", "name": "irsaliyeSekmeleri",
        "props": {
          "tabs": ["İrsaliye Bilgileri=kalemTablosu", "Fatura İşlemleri=faturaBolumu"] } },
      { "id": "kalemTablosu", "type": "dataTable", "name": "kalemTablosu",
        "props": {
          "title": "İrsaliye kalemleri",
          "query": "kalemler",
          "width": 12,
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showExport": false,
          "showPivot": false,
          "showCsv": false,
          "showSelectedExport": false,
          "columns": ["orderLineNumber", "stockCode", "stockName", "quantity", "unitPrice", "discountPercent", "vatPercent"],
          "columnLabels": ["orderLineNumber=Sipariş satırı", "stockCode=Stok kodu", "stockName=Stok adı", "quantity=Sevk miktarı", "unitPrice=Birim fiyat", "discountPercent=İsk. %", "vatPercent=KDV %"],
          "columnFormats": ["stockCode=code", "orderLineNumber=number", "quantity=number", "unitPrice=money", "discountPercent=number", "vatPercent=number"],
          "columnUnits": ["quantity=unitCode", "unitPrice=currencyCode"],
          "emptyText": "İrsaliye kalemi bulunamadı." } },
      { "id": "faturaBolumu", "type": "section", "name": "faturaBolumu",
        "props": {
          "width": 12,
          "title": "Fatura",
          "description": "Bu irsaliyeyi faturalaştırarak satış faturasını ve cari borç kaydını oluşturun. Fatura fiyatları sipariş satırlarından alınır; zorunlu fatura özel alanlarını tamamlayın." },
        "children": [
          { "id": "faturaVarNotu", "type": "text", "name": "faturaVarNotu",
            "props": {
              "text": "Fatura oluşturulmuş. Faturayı yukarıdaki “Faturayı aç” ile açabilirsiniz.",
              "visibleWhen": "irsaliye.rows[0].hasSalesInvoice == true" } },
          { "id": "siparissizNotu", "type": "text", "name": "siparissizNotu",
            "props": {
              "text": "Siparişsiz irsaliyenin faturası birlikte kesilmiştir.",
              "visibleWhen": "irsaliye.rows[0].id != null && irsaliye.rows[0].orderId == null && irsaliye.rows[0].hasSalesInvoice != true" } },
          { "id": "faturaFormu", "type": "formCard", "name": "faturaFormu",
            "props": {
              "title": "Fatura bilgileri",
              "columns": 3,
              "inputs": ["faturaTuru", "eBelgeSenaryosu", "eBelgeTuru", "aliciEtiketi", "faturaNotu"],
              "visibleWhen": "irsaliye.rows[0].orderId != null && irsaliye.rows[0].status == 'Posted' && irsaliye.rows[0].hasSalesInvoice == false" } },
          { "id": "faturaAlanlari", "type": "customFieldsBlock", "name": "faturaAlanlari",
            "props": {
              "title": "Fatura özel alanları",
              "definitionsQuery": "faturaAlanTanimlari",
              "columns": 2,
              "visibleWhen": "irsaliye.rows[0].orderId != null && irsaliye.rows[0].status == 'Posted' && irsaliye.rows[0].hasSalesInvoice == false" } },
          { "id": "faturalastirDugmesi", "type": "button", "name": "faturalastirDugmesi",
            "props": {
              "text": "Faturalaştır",
              "actionType": "query",
              "queryId": "faturalastir",
              "confirmEnabled": true,
              "confirmText": "“{{irsaliye.rows[0].code}}” için satış faturası ve cari borç kaydı oluşturulsun mu?",
              "visibleWhen": "irsaliye.rows[0].orderId != null && irsaliye.rows[0].status == 'Posted' && irsaliye.rows[0].hasSalesInvoice == false",
              "successMessage": "Satış faturası oluşturuldu.",
              "refreshQueries": ["irsaliye", "irsaliyeler"] } }
        ] },
      { "id": "faturaTuru", "type": "input", "name": "faturaTuru",
        "props": {
          "inputType": "select",
          "label": "Fatura türü",
          "defaultValue": "Wholesale",
          "staticOptions": ["Wholesale=Toptan satış · KDV hariç", "Retail=Perakende satış · KDV dâhil"] } },
      { "id": "eBelgeSenaryosu", "type": "input", "name": "eBelgeSenaryosu",
        "props": {
          "inputType": "select",
          "label": "Belge senaryosu",
          "staticOptions": ["=Seçilmedi", "TEMELFATURA=TEMELFATURA", "TICARIFATURA=TICARIFATURA", "EARSIVFATURA=EARSIVFATURA", "IHRACAT=IHRACAT", "YOLCUBERABERFATURA=YOLCUBERABERFATURA", "KAMU=KAMU", "HKS=HKS", "ENERJI=ENERJI", "ILAC_TIBBICIHAZ=ILAC_TIBBICIHAZ"] } },
      { "id": "eBelgeTuru", "type": "input", "name": "eBelgeTuru",
        "props": {
          "inputType": "select",
          "label": "Belge tür kodu",
          "staticOptions": ["=Seçilmedi", "SATIS=SATIS", "IADE=IADE", "TEVKIFAT=TEVKIFAT", "ISTISNA=ISTISNA", "OZELMATRAH=OZELMATRAH", "IHRACKAYITLI=IHRACKAYITLI", "TEVKIFATIADE=TEVKIFATIADE", "HKSSATIS=HKSSATIS", "HKSKOMISYONCU=HKSKOMISYONCU"] } },
      { "id": "aliciEtiketi", "type": "input", "name": "aliciEtiketi",
        "props": {
          "inputType": "text",
          "label": "Alıcı e-Fatura etiketi",
          "maxLength": 255,
          "placeholder": "urn:mail:…" } },
      { "id": "faturaNotu", "type": "input", "name": "faturaNotu",
        "props": {
          "inputType": "text",
          "label": "Fatura notu",
          "maxLength": 1000 } }
    ],
    "queries": [
