{
  "screenKey": "inventory-tracking", "title": "Lot / Seri İzleme",
  "description": "Depolardaki izlenen lot ve seri numaralarının güncel bakiyesini ve son hareket tarihini bulun.", "module": "Stok & Depo",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": { "since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "query:bakiye"] },
    "component:suresiGecmis": { "since": 1, "label": "Süresi geçmiş sayacı", "requires": ["query:bakiye"] },
    "component:suresiYaklasan": { "since": 1, "label": "30 gün içinde dolacak sayacı", "requires": ["query:bakiye"] },
    "component:suzgec": { "since": 1, "label": "Süzgeç alanı (arama, iz türü, depo)",
      "requires": ["component:liste", "query:bakiye", "query:depolar"] },
    "component:liste": { "since": 1, "label": "Lot / seri bakiyeleri listesi", "requires": ["query:bakiye", "component:suzgec"] },
    "component:detayKarti": { "since": 1, "label": "Detay paneli (seçili lot / seri)", "requires": ["component:liste"] },
    "component:sinirNotu": { "since": 1, "label": "Bakiye hesabı notu" },
    "query:bakiye": { "since": 1, "label": "Lot / seri bakiyeleri (sayfalı)" },
    "query:depolar": { "since": 1, "label": "Depoları listele" }
  },
  "screenViews": [ { "key": "inventory-trace-balances", "component": "liste",
    "fields": { "trackingCode": "trackingCode", "trackingMode": "trackingMode", "stockItem": "stockItemName", "warehouse": "warehouseName",
                "quantityOnHand": "quantityOnHand", "expiryDate": "expiryDate", "lastMovementDate": "lastMovementDate" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar", "props": { "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{bakiye.meta.totalCount}}", "hiddenCommands": ["new", "open", "save", "delete", "print"], "slot": "commands" } },
      { "id": "suresiGecmis", "type": "metric", "name": "suresiGecmis", "props": { "title": "Süresi geçmiş", "query": "bakiye", "variant": "danger", "icon": "calendar-x", "description": "bu sayfa", "countWhen": "bakiye.satir.expiryDate < bugun", "slot": "indicators" } },
      { "id": "suresiYaklasan", "type": "metric", "name": "suresiYaklasan", "props": { "title": "30 gün içinde dolacak", "query": "bakiye", "variant": "warning", "icon": "calendar-clock", "description": "bu sayfa", "countWhen": "bakiye.satir.expiryDate >= bugun && bakiye.satir.expiryDate <= bugun + 30", "slot": "indicators" } },
      { "id": "suzgec", "type": "filterBar", "name": "suzgec", "props": { "table": "liste", "search": true, "searchPlaceholder": "Lot/seri kodu, stok veya depo ara", "searchParam": "q", "filters": ["trackingMode|select|row|trackingMode|İz türü", "warehouseId|select|row|warehouseId|Depo|depolar:id:code:name|searchable"], "slot": "filters" } },
      { "id": "liste", "type": "dataTable", "name": "liste", "props": { "title": "Lot / seri bakiyeleri", "query": "bakiye", "paging": "server", "pageSize": 50, "columns": ["trackingCode", "trackingMode", "stockItemName", "stockItemCode", "warehouseCode", "warehouseName", "quantityOnHand", "expiryDate", "lastMovementDate"], "columnLabels": ["trackingCode=Lot / seri", "trackingMode=İz türü", "stockItemName=Stok", "stockItemCode=Stok kodu", "warehouseCode=Depo kodu", "warehouseName=Depo", "quantityOnHand=Mevcut miktar", "expiryDate=Son kullanma", "lastMovementDate=Son hareket"], "columnUnits": ["quantityOnHand=unitCode"], "columnFormats": ["trackingCode=code", "trackingMode=status", "stockItemCode=code", "warehouseCode=code", "quantityOnHand=number", "expiryDate=date", "lastMovementDate=date"], "valueLabels": ["trackingMode:Lot=Lot", "trackingMode:Serial=Seri"], "toneMap": ["Lot=info"], "emptyText": "Aktif lot veya seri bakiyesi bulunamadı.", "slot": "list" } },
      { "id": "detayKarti", "type": "card", "name": "detayKarti", "props": { "variant": "panel", "title": "{{liste.seciliSatir.trackingCode}}", "description": "{{liste.seciliSatir.stockItemCode}}", "slot": "detail" },
        "children": [
          { "id": "detayLot", "type": "badge", "name": "detayLot", "props": { "text": "Lot", "variant": "info", "visibleWhen": "liste.seciliSatir.trackingMode == 'Lot'" } },
          { "id": "detaySeri", "type": "badge", "name": "detaySeri", "props": { "text": "Seri", "variant": "info", "visibleWhen": "liste.seciliSatir.trackingMode == 'Serial'" } },
          { "id": "detaySuresiGecti", "type": "badge", "name": "detaySuresiGecti", "props": { "text": "Süresi geçti", "variant": "danger", "visibleWhen": "liste.seciliSatir.expiryDate < bugun" } },
          { "id": "detaySuresiYaklasiyor", "type": "badge", "name": "detaySuresiYaklasiyor", "props": { "text": "Süresi yaklaşıyor", "variant": "warning", "visibleWhen": "liste.seciliSatir.expiryDate >= bugun && liste.seciliSatir.expiryDate <= bugun + 30" } },
          { "id": "detayBos", "type": "text", "name": "detayBos", "props": { "text": "Bir lot veya seri seçin; ayrıntıları burada görün.", "visibleWhen": "liste.seciliSatir.trackingCode == null" } },
          { "id": "detayMiktar", "type": "metric", "name": "detayMiktar", "props": { "title": "Mevcut miktar", "value": "{{liste.seciliSatir.quantityOnHand}}", "format": "number", "description": "{{liste.seciliSatir.unitCode}}", "visibleWhen": "liste.seciliSatir.trackingCode != null" } },
          { "id": "detayBilgi", "type": "contextPanel", "name": "detayBilgi", "props": { "table": "liste", "visibleWhen": "liste.seciliSatir.trackingCode != null", "fields": ["expiryDate=Son kullanma", "stockItemName=Stok", "warehouseCode=Depo kodu", "warehouseName=Depo", "lastMovementDate=Son hareket"] } },
          { "id": "detayNot", "type": "text", "name": "detayNot", "props": { "text": "Bu ekran salt okunurdur. Stok hareketleri ilgili stok ve ambar ekranından yönetilir.", "visibleWhen": "liste.seciliSatir.trackingCode != null" } }
        ] },
      { "id": "sinirNotu", "type": "alert", "name": "sinirNotu", "props": { "title": "Bakiye yalnız iz kodu bulunan stok hareketlerinden hesaplanır.", "variant": "info", "icon": "shield", "text": "Geçmişte konum veya iz kodu kaydedilmemiş hareketler geriye dönük atanmaz.", "slot": "below" } }
    ],
    "queries": [
      { "id": "bakiye", "name": "bakiye", "kind": "read", "operation": "stok.izleme.bakiyeler", "runOn": "load", "parameters": [{ "name": "q", "binding": "{{suzgec.q}}", "type": "text" }, { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" }, { "name": "trackingMode", "binding": "{{suzgec.trackingMode}}", "type": "text" }, { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" }, { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" }] },
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "runOn": "load", "parameters": [] }
    ],
    "template": { "name": "list" }
  }
}
