{
  "screenKey": "customers", "title": "Cari Hesaplar",
  "description": "Müşteri ve tedarikçi kartlarını firma bazında yönetin.", "module": "Satış & cari",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:yeniTeklif", "component:yeniSiparis", "component:yeniIrsaliye", "component:yeniFatura", "component:faturalarDugmesi", "component:adreslerDugmesi", "component:pasifeAlDugmesi", "component:etkinlestirDugmesi", "component:hareketlerDugmesi", "query:cariler", "query:kartSil"]},
    "component:kartGostergesi": {"since": 1, "label": "Cari kartı göstergesi", "requires": ["query:sayaclar"]},
    "component:pasifGostergesi": {"since": 1, "label": "Pasif göstergesi", "requires": ["component:durumSecimi", "query:sayaclar"]},
    "component:eFaturaGostergesi": {"since": 1, "label": "E-Fatura mükellefi göstergesi", "requires": ["query:sayaclar"]},
    "component:riskGostergesi": {"since": 1, "label": "Risk limiti tanımlı göstergesi", "requires": ["query:sayaclar"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:secimCipleri": {"since": 1, "label": "Tür ve durum seçimi", "requires": ["component:turSecimi", "component:durumSecimi"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeç seçimleri kartı", "requires": ["component:turSecimi", "component:durumSecimi"]},
    "component:turSecimi": {"since": 1, "label": "Cari türü seçimi"},
    "component:durumSecimi": {"since": 1, "label": "Durum seçimi"},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:liste": {"since": 1, "label": "Cari kartları listesi", "requires": ["component:detayPaneli", "component:acDugmesi", "query:cariler", "query:kartSil"]},
    "component:acDugmesi": {"since": 1, "label": "Satırı aç (cari kart)", "requires": ["component:liste"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:genelPaneli", "component:varsayilanAdres", "component:adresYok", "component:haritaKonumu", "component:finansPaneli", "component:dovizNotu", "component:iletisimPaneli", "query:bakiye"]},
    "component:genelPaneli": {"since": 1, "label": "Detay: Genel", "requires": ["component:liste"]},
    "component:varsayilanAdres": {"since": 1, "label": "Detay: Varsayılan adres", "requires": ["query:kart"]},
    "component:adresYok": {"since": 1, "label": "Detay: Varsayılan adres yok notu", "requires": ["query:kart"]},
    "component:haritaKonumu": {"since": 1, "label": "Detay: Harita konumu", "requires": ["query:kart"]},
    "component:finansPaneli": {"since": 1, "label": "Detay: Finans", "requires": ["component:liste"]},
    "component:dovizNotu": {"since": 1, "label": "Detay: Döviz notu"},
    "component:iletisimPaneli": {"since": 1, "label": "Detay: İletişim", "requires": ["component:liste"]},
    "component:yeniTeklif": {"since": 1, "label": "Yeni teklif komutu", "requires": ["component:liste"]},
    "component:yeniSiparis": {"since": 1, "label": "Yeni sipariş komutu", "requires": ["component:liste"]},
    "component:yeniIrsaliye": {"since": 1, "label": "Yeni irsaliye komutu", "requires": ["component:liste"]},
    "component:yeniFatura": {"since": 1, "label": "Yeni fatura komutu", "requires": ["component:liste"]},
    "component:faturalarDugmesi": {"since": 1, "label": "Satış faturaları komutu", "requires": ["component:liste"]},
    "component:adreslerDugmesi": {"since": 1, "label": "Adresler komutu", "requires": ["component:liste"]},
    "component:pasifeAlDugmesi": {"since": 1, "label": "Pasife al komutu", "requires": ["component:liste", "query:cariler", "query:sayaclar", "query:kart", "query:pasifeAl"]},
    "component:etkinlestirDugmesi": {"since": 1, "label": "Etkinleştir komutu", "requires": ["component:liste", "query:cariler", "query:sayaclar", "query:kart", "query:aktifEt"]},
    "component:hareketlerDugmesi": {"since": 1, "label": "Cari Hesap Hareketleri komutu", "requires": ["component:liste"]},
    "query:cariler": {"since": 1, "label": "Cari kartlarını listele", "requires": ["component:suzgec", "component:turSecimi", "component:durumSecimi", "component:liste"]},
    "query:sayaclar": {"since": 1, "label": "Cari sayaçları", "requires": ["component:suzgec"]},
    "query:kart": {"since": 1, "label": "Seçili cari kartı", "requires": ["component:liste"]},
    "query:bakiye": {"since": 1, "label": "Seçili carinin bakiyesi", "requires": ["component:liste"]},
    "query:pasifeAl": {"since": 1, "label": "Cari kartı pasife al", "requires": ["query:kart"]},
    "query:aktifEt": {"since": 1, "label": "Cari kartı etkinleştir", "requires": ["query:kart"]},
    "query:kartSil": {"since": 1, "label": "Cari kartı sil (hiç kaydı olmayan)", "requires": ["component:liste"]}
  },
  "screenViews": [ { "key": "customers", "component": "liste",
                     "fields": { "code": "code", "name": "name", "groupName": "groupName", "type": "type", "currencyCode": "currencyCode",
                                 "paymentTermDays": "paymentTermDays", "taxNumber": "taxNumber", "status": "isActive",
                                 "identityNumber": "identityNumber", "taxOffice": "taxOffice", "riskLimit": "riskLimit",
                                 "parentCompanyName": "parentCompanyName", "subsidiaryCount": "subsidiaryCount", "createdAt": "createdAt" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "deleteQuery": "kartSil", "deleteConfirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}} cari kartı silinsin mi?", "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{cariler.meta.totalCount}}",
                   "newAction": "page", "newPageCode": "@customer-create", "newTarget": "newTab",
                   "openAction": "page", "openPageCode": "@customer-create", "openTarget": "newTab", "openTable": "liste",
                   "openParams": ["customerId={{liste.seciliSatir.id}}"],
                   "moreButtons": ["yeniTeklif", "yeniSiparis", "yeniIrsaliye", "yeniFatura", "faturalarDugmesi", "adreslerDugmesi",
                                   "pasifeAlDugmesi", "etkinlestirDugmesi", "hareketlerDugmesi"],
                   "hiddenCommands": ["save", "print"] } },

      { "id": "kartGostergesi", "type": "metric", "name": "kartGostergesi",
        "props": { "title": "Cari kartı", "value": "{{sayaclar.rows[0].totalCount}}", "format": "number", "width": 3, "icon": "users",
                   "description": "tüm kayıtlar · {{sayaclar.rows[0].activeCount}} aktif" } },
      { "id": "pasifGostergesi", "type": "metric", "name": "pasifGostergesi",
        "props": { "title": "Pasif", "value": "{{sayaclar.rows[0].inactiveCount}}", "format": "number", "width": 3, "icon": "ban",
                   "description": "tüm kayıtlar", "filterInput": "durumSecimi", "filterValue": "Inactive" } },
      { "id": "eFaturaGostergesi", "type": "metric", "name": "eFaturaGostergesi",
        "props": { "title": "e-Fatura mükellefi", "value": "{{sayaclar.rows[0].eInvoiceRegisteredCount}}", "format": "number", "width": 3,
                   "icon": "file-text", "description": "tüm kayıtlar" } },
      { "id": "riskGostergesi", "type": "metric", "name": "riskGostergesi",
        "props": { "title": "Risk limiti tanımlı", "value": "{{sayaclar.rows[0].riskLimitDefinedCount}}", "format": "number", "width": 3,
                   "icon": "shield", "variant": "warning", "description": "tüm kayıtlar" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 6, "search": true, "searchPlaceholder": "Cari kodu, unvanı veya vergi no ile ara", "searchParam": "q" } },
      { "id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri",
        "props": { "title": "Süzgeçler", "layout": "inline", "width": 6, "inputs": ["turSecimi", "durumSecimi"] } },
      { "id": "turSecimi", "type": "input", "name": "turSecimi",
        "props": { "inputType": "select", "label": "Cari türü",
                   "staticOptions": ["=Tümü", "Customer=Müşteri", "Supplier=Tedarikçi", "Both=Müşteri & Tedarikçi", "Dealer=Bayi", "Employee=Personel"] } },
      { "id": "durumSecimi", "type": "input", "name": "durumSecimi",
        "props": { "inputType": "select", "label": "Durum", "staticOptions": ["=Tümü", "Active=Aktif", "Inactive=Pasif"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": { "width": 12, "inputs": ["turSecimi", "durumSecimi"] } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Cari kartları", "query": "cariler", "paging": "server", "pageSize": 25, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.id != null",
                   "detailToggleInput": "detayPaneli",
                   "columns": ["code", "name", "groupName", "type", "currencyCode", "paymentTermDays", "taxNumber", "isActive"],
                   "columnLabels": ["code=Cari kodu", "name=Ünvan", "groupName=Cari grubu", "type=Tür", "currencyCode=Döviz",
                                    "paymentTermDays=Vade", "taxNumber=Vergi no", "isActive=Durum", "identityNumber=T.C. kimlik no",
                                    "taxOffice=Vergi dairesi", "riskLimit=Risk limiti", "parentCompanyName=Ana firma",
                                    "subsidiaryCount=Bağlı firma sayısı", "createdAt=Oluşturulma tarihi"],
                   "columnFormats": ["code=code", "type=status", "paymentTermDays=number", "isActive=status", "riskLimit=money",
                                     "subsidiaryCount=number", "createdAt=date"],
                   "valueLabels": ["type:Customer=Müşteri", "type:Supplier=Tedarikçi", "type:Both=Müşteri & Tedarikçi", "type:Dealer=Bayi",
                                   "type:Employee=Personel", "isActive:true=Aktif", "isActive:false=Pasif"],
                   "toneMap": ["Aktif=success", "Tedarikçi=warning", "Müşteri=info", "Müşteri & Tedarikçi=info", "Bayi=info"],
                   "rowOpenAction": "acDugmesi", "bulkDeleteQuery": "kartSil",
                   "emptyText": "Aramanızla eşleşen cari kartı yok." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@customer-create", "target": "newTab",
                   "params": ["customerId={{liste.seciliSatir.id}}"] } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.name}}", "description": "{{liste.seciliSatir.code}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@customer-create", "target": "newTab",
                       "params": ["customerId={{liste.seciliSatir.id}}"] } },
          { "id": "detayAktif", "type": "badge", "name": "detayAktif",
            "props": { "text": "Aktif", "variant": "success", "visibleWhen": "liste.seciliSatir.isActive == true" } },
          { "id": "detayPasif", "type": "badge", "name": "detayPasif",
            "props": { "text": "Pasif", "variant": "info", "visibleWhen": "liste.seciliSatir.isActive == false" } },
          { "id": "detayEFatura", "type": "badge", "name": "detayEFatura",
            "props": { "text": "e-Fatura", "variant": "info", "visibleWhen": "liste.seciliSatir.isEInvoiceRegistered == true" } },
          { "id": "bakiyeGostergesi", "type": "metric", "name": "bakiyeGostergesi",
            "props": { "title": "Bakiye", "value": "{{bakiye.rows[0].balanceAmount}} {{bakiye.rows[0].currencyCode}} {{bakiye.rows[0].balanceSideCode}}",
                       "format": "money", "width": 6, "icon": "wallet", "description": "B: borç, A: alacak bakiyesi" } },
          { "id": "riskLimitiGostergesi", "type": "metric", "name": "riskLimitiGostergesi",
            "props": { "title": "Risk limiti", "value": "{{bakiye.rows[0].riskLimit}}", "format": "money", "width": 6, "icon": "shield",
                       "description": "{{bakiye.rows[0].currencyCode}}" } },
          { "id": "limitGostergesi", "type": "metric", "name": "limitGostergesi",
            "props": { "title": "Limit kullanımı %", "value": "{{bakiye.rows[0].limitUsagePercent}}", "format": "number", "width": 6,
                       "icon": "percent", "description": "risk limitine göre",
                       "visibleWhen": "bakiye.rows[0].limitUsagePercent != null && bakiye.rows[0].limitUsagePercent <= 100" } },
          { "id": "limitAsimiGostergesi", "type": "metric", "name": "limitAsimiGostergesi",
            "props": { "title": "Limit kullanımı %", "value": "{{bakiye.rows[0].limitUsagePercent}}", "format": "number", "width": 6,
                       "icon": "alert", "variant": "danger", "description": "risk limiti aşıldı",
                       "visibleWhen": "bakiye.rows[0].limitUsagePercent > 100" } },
          { "id": "vadeGostergesi", "type": "metric", "name": "vadeGostergesi",
            "props": { "title": "Vade", "value": "{{liste.seciliSatir.paymentTermDays}}", "format": "number", "width": 6, "icon": "calendar",
                       "description": "gün" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Genel=genelPaneli,varsayilanAdres,adresYok,haritaKonumu", "Finans=finansPaneli,dovizNotu",
                                "İletişim=iletisimPaneli"] } },
          { "id": "detayHareketler", "type": "button", "name": "detayHareketler",
            "props": { "text": "Cari Hesap Hareketleri ›", "actionType": "page", "pageCode": "@customer-ledger", "target": "newTab",
                       "params": ["customerId={{liste.seciliSatir.id}}"] } },
          { "id": "detayFaturalar", "type": "button", "name": "detayFaturalar",
            "props": { "text": "Satış faturaları ›", "actionType": "erpPage", "pageKey": "sales-invoices", "target": "newTab",
                       "params": ["customerId={{liste.seciliSatir.id}}"], "visibleWhen": "liste.seciliSatir.type != 'Supplier'" } },
          { "id": "detayAdresler", "type": "button", "name": "detayAdresler",
            "props": { "text": "Adresler ›", "actionType": "page", "pageCode": "@customer-create", "target": "newTab",
                       "params": ["customerId={{liste.seciliSatir.id}}", "tab=Adresler"] } }
        ] },
      { "id": "genelPaneli", "type": "contextPanel", "name": "genelPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["type=Cari türü", "groupName=Cari grubu", "taxNumber=Vergi no", "taxOffice=Vergi dairesi", "identityNumber=T.C. kimlik no",
                              "parentCompanyName=Ana firma"] } },
      { "id": "varsayilanAdres", "type": "text", "name": "varsayilanAdres",
        "props": { "title": "Varsayılan adres",
                   "text": "{{kart.rows[0].defaultAddressLabel}} · {{kart.rows[0].defaultAddressLine}} · {{kart.rows[0].defaultAddressDistrict}} / {{kart.rows[0].defaultAddressCity}} · {{kart.rows[0].defaultAddressPostalCode}} {{kart.rows[0].defaultAddressCountryCode}}",
                   "visibleWhen": "kart.rows[0].defaultAddressId != null" } },
      { "id": "adresYok", "type": "text", "name": "adresYok",
        "props": { "text": "Varsayılan genel adres tanımlı değil.", "visibleWhen": "kart.rows[0].id != null && kart.rows[0].defaultAddressId == null" } },
      { "id": "haritaKonumu", "type": "text", "name": "haritaKonumu",
        "props": { "text": "Harita konumu: {{kart.rows[0].defaultAddressLatitude}}, {{kart.rows[0].defaultAddressLongitude}}",
                   "visibleWhen": "kart.rows[0].defaultAddressLatitude != null" } },
      { "id": "finansPaneli", "type": "contextPanel", "name": "finansPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["currencyCode=Döviz", "paymentTermDays=Vade (gün)", "riskLimit=Risk limiti", "priceListCode=Fiyat listesi",
                              "receivableAccountCode=Alıcı hesabı", "payableAccountCode=Satıcı hesabı"] } },
      { "id": "dovizNotu", "type": "text", "name": "dovizNotu",
        "props": { "text": "Bakiye cari dövizindedir; farklı dövizli hareketler ayrıştırılmaz." } },
      { "id": "iletisimPaneli", "type": "contextPanel", "name": "iletisimPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["phone=Telefon", "email=Kurumsal e-posta", "contactName=Yetkili kişi", "contactPhone=Yetkili telefonu",
                              "eInvoiceRecipientAlias=E-Fatura alıcı etiketi"] } },

      { "id": "yeniTeklif", "type": "button", "name": "yeniTeklif",
        "props": { "text": "Yeni teklif", "actionType": "erpPage", "pageKey": "sales-quote-create", "target": "newTab",
                   "params": ["customerId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier' || liste.seciliSatir.type == 'Employee'",
                   "disabledReason": "Önce bir müşteri veya bayi kartı seçin; satış işlemleri yalnız müşteri ve bayi kartlarında." } },
      { "id": "yeniSiparis", "type": "button", "name": "yeniSiparis",
        "props": { "text": "Yeni sipariş", "actionType": "erpPage", "pageKey": "sales-order-create", "target": "newTab",
                   "params": ["customerId={{liste.seciliSatir.id}}", "orderDate={{bugun}}"],
                   "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier' || liste.seciliSatir.type == 'Employee'",
                   "disabledReason": "Önce bir müşteri veya bayi kartı seçin; satış işlemleri yalnız müşteri ve bayi kartlarında." } },
      { "id": "yeniIrsaliye", "type": "button", "name": "yeniIrsaliye",
        "props": { "text": "Yeni irsaliye", "actionType": "erpPage", "pageKey": "sales-delivery-create", "target": "newTab",
                   "params": ["customerId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier' || liste.seciliSatir.type == 'Employee'",
                   "disabledReason": "Önce bir müşteri veya bayi kartı seçin; satış işlemleri yalnız müşteri ve bayi kartlarında." } },
      { "id": "yeniFatura", "type": "button", "name": "yeniFatura",
        "props": { "text": "Yeni fatura", "actionType": "erpPage", "pageKey": "sales-invoice-create", "target": "newTab",
                   "params": ["customerId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier' || liste.seciliSatir.type == 'Employee'",
                   "disabledReason": "Önce bir müşteri veya bayi kartı seçin; satış işlemleri yalnız müşteri ve bayi kartlarında." } },
      { "id": "faturalarDugmesi", "type": "button", "name": "faturalarDugmesi",
        "props": { "text": "Satış faturaları", "actionType": "erpPage", "pageKey": "sales-invoices", "target": "newTab",
                   "params": ["customerId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier'",
                   "disabledReason": "Önce tedarikçi olmayan bir cari kartı seçin." } },
      { "id": "adreslerDugmesi", "type": "button", "name": "adreslerDugmesi",
        "props": { "text": "Adresler", "actionType": "page", "pageCode": "@customer-create", "target": "newTab",
                   "params": ["customerId={{liste.seciliSatir.id}}", "tab=Adresler"],
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "pasifeAlDugmesi", "type": "button", "name": "pasifeAlDugmesi",
        "props": { "text": "Pasife al", "actionType": "query", "queryId": "pasifeAl", "confirmEnabled": true,
                   "confirmText": "“{{liste.seciliSatir.name}}” pasife alınsın mı? Pasif cariye yeni hareket eklenemez ve satış faturası kesilemez.",
                   "successMessage": "Cari kart pasife alındı.", "refreshQueries": ["cariler", "sayaclar", "kart"],
                   "visibleWhen": "liste.seciliSatir.isActive == true" } },
      { "id": "etkinlestirDugmesi", "type": "button", "name": "etkinlestirDugmesi",
        "props": { "text": "Etkinleştir", "actionType": "query", "queryId": "aktifEt", "confirmEnabled": true,
                   "confirmText": "“{{liste.seciliSatir.name}}” yeniden etkinleştirilsin mi?",
                   "successMessage": "Cari kart etkinleştirildi.", "refreshQueries": ["cariler", "sayaclar", "kart"],
                   "visibleWhen": "liste.seciliSatir.isActive == false" } },
      { "id": "hareketlerDugmesi", "type": "button", "name": "hareketlerDugmesi",
        "props": { "text": "Cari Hesap Hareketleri", "actionType": "page", "pageCode": "@customer-ledger", "target": "newTab",
                   "params": ["customerId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin" } }
    ],
    "queries": [
      { "id": "cariler", "name": "cariler", "kind": "read", "operation": "cari.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "type", "binding": "{{turSecimi.value}}", "type": "text" },
          { "name": "status", "binding": "{{durumSecimi.value}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "sayaclar", "name": "sayaclar", "kind": "read", "operation": "cari.sayaclar", "runOn": "load",
        "parameters": [ { "name": "q", "binding": "{{suzgec.q}}", "type": "text" } ] },
      { "id": "kart", "name": "kart", "kind": "read", "operation": "cari.getir", "runOn": "load",
