  "screenViews": [
    {"key": "customers", "component": "liste", "fields": {"code": "code", "name": "name", "groupName": "groupName", "type": "type", "currencyCode": "currencyCode", "paymentTermDays": "paymentTermDays", "taxNumber": "taxNumber", "status": "isActive", "identityNumber": "identityNumber", "taxOffice": "taxOffice", "riskLimit": "riskLimit", "parentCompanyName": "parentCompanyName", "subsidiaryCount": "subsidiaryCount", "createdAt": "createdAt"}}
  ],
  "definition": {
    "schemaVersion": 2,
    "template": {"name": "list"},
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"deleteQuery": "kartSil", "deleteConfirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}} cari kartı silinsin mi?", "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{cariler.meta.totalCount}}", "newAction": "page", "newPageCode": "@customer-create", "newTarget": "newTab", "openAction": "page", "openPageCode": "@customer-create", "openTarget": "newTab", "openTable": "liste", "openParams": ["customerId={{liste.seciliSatir.id}}"], "moreButtons": ["yeniTeklif", "yeniSiparis", "yeniIrsaliye", "yeniFatura", "pasifeAlDugmesi", "etkinlestirDugmesi", "hareketlerDugmesi"], "hiddenCommands": ["save", "print"], "slot": "commands"}},
      {"id": "kartGostergesi", "type": "metric", "name": "kartGostergesi", "props": {"title": "Cari kartı", "value": "{{sayaclar.rows[0].totalCount}}", "format": "number", "icon": "users", "description": "tüm kayıtlar · {{sayaclar.rows[0].activeCount}} aktif", "slot": "indicators"}},
      {"id": "pasifGostergesi", "type": "metric", "name": "pasifGostergesi", "props": {"title": "Pasif", "value": "{{sayaclar.rows[0].inactiveCount}}", "format": "number", "icon": "ban", "description": "tüm kayıtlar", "filterInput": "suzgec.status", "filterValue": "Inactive", "slot": "indicators"}},
      {"id": "eFaturaGostergesi", "type": "metric", "name": "eFaturaGostergesi", "props": {"title": "e-Fatura mükellefi", "value": "{{sayaclar.rows[0].eInvoiceRegisteredCount}}", "format": "number", "icon": "file-text", "description": "tüm kayıtlar", "slot": "indicators"}},
      {"id": "riskGostergesi", "type": "metric", "name": "riskGostergesi", "props": {"title": "Risk limiti tanımlı", "value": "{{sayaclar.rows[0].riskLimitDefinedCount}}", "format": "number", "icon": "shield", "variant": "warning", "description": "tüm kayıtlar", "slot": "indicators"}},
      {"id": "suzgec", "type": "filterBar", "name": "suzgec", "props": {"table": "liste", "search": true, "searchPlaceholder": "Cari kodu, unvanı veya vergi no ile ara", "searchParam": "q", "filters": ["type|select|row|type|Cari türü", "status|select|row|status|Durum"], "slot": "filters"}},
      {"id": "liste", "type": "dataTable", "name": "liste", "props": {"title": "Cari kartları", "query": "cariler", "paging": "server", "pageSize": 25, "columns": ["code", "name", "groupName", "type", "currencyCode", "paymentTermDays", "taxNumber", "isActive"], "columnLabels": ["code=Cari kodu", "name=Ünvan", "groupName=Cari grubu", "type=Tür", "currencyCode=Döviz", "paymentTermDays=Vade", "taxNumber=Vergi no", "isActive=Durum", "identityNumber=T.C. kimlik no", "taxOffice=Vergi dairesi", "riskLimit=Risk limiti", "parentCompanyName=Ana firma", "subsidiaryCount=Bağlı firma sayısı", "createdAt=Oluşturulma tarihi"], "columnFormats": ["code=code", "type=status", "paymentTermDays=number", "isActive=status", "riskLimit=money", "subsidiaryCount=number", "createdAt=date"], "valueLabels": ["type:Customer=Müşteri", "type:Supplier=Tedarikçi", "type:Both=Müşteri & Tedarikçi", "type:Dealer=Bayi", "type:Employee=Personel", "isActive:true=Aktif", "isActive:false=Pasif", "status:Active=Aktif", "status:Inactive=Pasif"], "toneMap": ["Aktif=success", "Tedarikçi=warning", "Müşteri=info", "Müşteri & Tedarikçi=info", "Bayi=info"], "rowOpenAction": "acDugmesi", "bulkDeleteQuery": "kartSil", "emptyText": "Aramanızla eşleşen cari kartı yok.", "slot": "list"}},
      {"id": "acDugmesi", "type": "button", "name": "acDugmesi", "props": {"text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@customer-create", "target": "newTab", "params": ["customerId={{liste.seciliSatir.id}}"], "slot": "rowActions"}},
      {"id": "detayKarti", "type": "card", "name": "detayKarti", "props": {"variant": "panel", "title": "{{liste.seciliSatir.name}}", "description": "{{liste.seciliSatir.code}}", "slot": "detail"}, "children": [{"id": "detayBos", "type": "text", "name": "detayBos", "props": {"text": "Bir cari seçin; ayrıntıları burada görün.", "visibleWhen": "liste.seciliSatir.id == null"}}, {"id": "detayAktif", "type": "badge", "name": "detayAktif", "props": {"text": "Aktif", "variant": "success", "visibleWhen": "liste.seciliSatir.isActive == true"}}, {"id": "detayPasif", "type": "badge", "name": "detayPasif", "props": {"text": "Pasif", "variant": "info", "visibleWhen": "liste.seciliSatir.isActive == false"}}, {"id": "detayEFatura", "type": "badge", "name": "detayEFatura", "props": {"text": "e-Fatura", "variant": "info", "visibleWhen": "liste.seciliSatir.isEInvoiceRegistered == true"}}, {"id": "bakiyeGostergesi", "type": "metric", "name": "bakiyeGostergesi", "props": {"title": "Bakiye", "value": "{{bakiye.rows[0].balanceAmount}} {{bakiye.rows[0].currencyCode}} {{bakiye.rows[0].balanceSideCode}}", "format": "money", "icon": "wallet", "description": "B: borç, A: alacak bakiyesi"}}, {"id": "limitGostergesi", "type": "metric", "name": "limitGostergesi", "props": {"title": "Limit kullanımı %", "value": "{{bakiye.rows[0].limitUsagePercent}}", "format": "number", "icon": "percent", "description": "risk limitine göre", "visibleWhen": "bakiye.rows[0].limitUsagePercent != null && bakiye.rows[0].limitUsagePercent <= 100"}}, {"id": "limitAsimiGostergesi", "type": "metric", "name": "limitAsimiGostergesi", "props": {"title": "Limit kullanımı %", "value": "{{bakiye.rows[0].limitUsagePercent}}", "format": "number", "icon": "alert", "variant": "danger", "description": "risk limiti aşıldı", "visibleWhen": "bakiye.rows[0].limitUsagePercent > 100"}}, {"id": "detayBilgi", "type": "contextPanel", "name": "detayBilgi", "props": {"table": "liste", "visibleWhen": "liste.seciliSatir.id != null", "fields": ["type=Cari türü", "groupName=Cari grubu", "taxNumber=Vergi no", "paymentTermDays=Vade (gün)", "riskLimit=Risk limiti", "currencyCode=Döviz", "phone=Telefon"]}}, {"id": "varsayilanAdres", "type": "text", "name": "varsayilanAdres", "props": {"title": "Varsayılan adres", "text": "{{kart.rows[0].defaultAddressLabel}} · {{kart.rows[0].defaultAddressLine}} · {{kart.rows[0].defaultAddressDistrict}} / {{kart.rows[0].defaultAddressCity}} · {{kart.rows[0].defaultAddressPostalCode}} {{kart.rows[0].defaultAddressCountryCode}}", "visibleWhen": "kart.rows[0].defaultAddressId != null"}}, {"id": "adresYok", "type": "text", "name": "adresYok", "props": {"text": "Varsayılan genel adres tanımlı değil.", "visibleWhen": "kart.rows[0].id != null && kart.rows[0].defaultAddressId == null"}}, {"id": "dovizNotu", "type": "text", "name": "dovizNotu", "props": {"text": "Bakiye cari dövizindedir; farklı dövizli hareketler ayrıştırılmaz.", "visibleWhen": "liste.seciliSatir.id != null"}}]},
      {"id": "yeniTeklif", "type": "button", "name": "yeniTeklif", "props": {"text": "Yeni teklif", "actionType": "erpPage", "pageKey": "sales-quote-create", "target": "newTab", "params": ["customerId={{liste.seciliSatir.id}}"], "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier' || liste.seciliSatir.type == 'Employee'", "disabledReason": "Önce bir müşteri veya bayi kartı seçin; satış işlemleri yalnız müşteri ve bayi kartlarında.", "slot": "actions"}},
      {"id": "yeniSiparis", "type": "button", "name": "yeniSiparis", "props": {"text": "Yeni sipariş", "actionType": "erpPage", "pageKey": "sales-order-document", "target": "newTab", "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier' || liste.seciliSatir.type == 'Employee'", "disabledReason": "Önce bir müşteri veya bayi kartı seçin; satış işlemleri yalnız müşteri ve bayi kartlarında.", "slot": "actions"}},
      {"id": "yeniIrsaliye", "type": "button", "name": "yeniIrsaliye", "props": {"text": "Yeni irsaliye", "actionType": "erpPage", "pageKey": "sales-delivery-create", "target": "newTab", "params": ["customerId={{liste.seciliSatir.id}}"], "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier' || liste.seciliSatir.type == 'Employee'", "disabledReason": "Önce bir müşteri veya bayi kartı seçin; satış işlemleri yalnız müşteri ve bayi kartlarında.", "slot": "actions"}},
      {"id": "yeniFatura", "type": "button", "name": "yeniFatura", "props": {"text": "Yeni fatura", "actionType": "erpPage", "pageKey": "sales-invoice-create", "target": "newTab", "params": ["customerId={{liste.seciliSatir.id}}"], "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.type == 'Supplier' || liste.seciliSatir.type == 'Employee'", "disabledReason": "Önce bir müşteri veya bayi kartı seçin; satış işlemleri yalnız müşteri ve bayi kartlarında.", "slot": "actions"}},
      {"id": "pasifeAlDugmesi", "type": "button", "name": "pasifeAlDugmesi", "props": {"text": "Pasife al", "actionType": "query", "queryId": "pasifeAl", "confirmEnabled": true, "confirmText": "“{{liste.seciliSatir.name}}” pasife alınsın mı? Pasif cariye yeni hareket eklenemez ve satış faturası kesilemez.", "successMessage": "Cari kart pasife alındı.", "refreshQueries": ["cariler", "sayaclar", "kart"], "visibleWhen": "liste.seciliSatir.isActive == true", "slot": "actions"}},
      {"id": "etkinlestirDugmesi", "type": "button", "name": "etkinlestirDugmesi", "props": {"text": "Etkinleştir", "actionType": "query", "queryId": "aktifEt", "confirmEnabled": true, "confirmText": "“{{liste.seciliSatir.name}}” yeniden etkinleştirilsin mi?", "successMessage": "Cari kart etkinleştirildi.", "refreshQueries": ["cariler", "sayaclar", "kart"], "visibleWhen": "liste.seciliSatir.isActive == false", "slot": "actions"}},
      {"id": "hareketlerDugmesi", "type": "button", "name": "hareketlerDugmesi", "props": {"text": "Cari Hesap Hareketleri", "actionType": "page", "pageCode": "@customer-ledger", "target": "newTab", "params": ["customerId={{liste.seciliSatir.id}}"], "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin", "slot": "actions"}}
    ],
    "queries": [
      {"id": "cariler", "name": "cariler", "kind": "read", "operation": "cari.listele", "runOn": "load", "parameters": [{"name": "q", "binding": "{{suzgec.q}}", "type": "text"}, {"name": "type", "binding": "{{suzgec.type}}", "type": "text"}, {"name": "status", "binding": "{{suzgec.status}}", "type": "text"}, {"name": "page", "binding": "{{liste.sayfa}}", "type": "int"}, {"name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int"}]},
      {"id": "sayaclar", "name": "sayaclar", "kind": "read", "operation": "cari.sayaclar", "runOn": "load", "parameters": [{"name": "q", "binding": "{{suzgec.q}}", "type": "text"}]},
      {"id": "kart", "name": "kart", "kind": "read", "operation": "cari.getir", "runOn": "load", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]},
      {"id": "bakiye", "name": "bakiye", "kind": "read", "operation": "cari.bakiye", "runOn": "load", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]},
      {"id": "pasifeAl", "name": "pasifeAl", "kind": "update", "operation": "cari.pasifeAl", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid"}]},
      {"id": "aktifEt", "name": "aktifEt", "kind": "update", "operation": "cari.aktifEt", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid"}]},
      {"id": "kartSil", "name": "kartSil", "kind": "delete", "operation": "cari.sil", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]}
    ]
  }
}
