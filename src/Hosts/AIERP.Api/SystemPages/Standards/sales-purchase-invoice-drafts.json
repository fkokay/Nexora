{
  "screenKey": "sales-purchase-invoice-drafts",
  "title": "Satınalma faturası taslakları",
  "description": "Satınalma faturası taslaklarını izleyin; düzenleme Belge sayfasında açılır.",
  "module": "Satın Alma",
  "version": 2,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "İşlem çubuğu",
      "requires": [
        "component:suzgec",
        "component:liste",
        "component:duzenleDugmesi",
        "component:muhasebelestirDugmesi",
        "query:taslaklar"
      ]
    },
    "component:suzgec": {
      "since": 1,
      "label": "Arama süzgeci",
      "requires": [
        "component:liste"
      ]
    },
    "component:liste": {
      "since": 1,
      "label": "Fatura taslakları listesi",
      "requires": [
        "query:taslaklar"
      ]
    },
    "component:duzenleDugmesi": {
      "since": 2,
      "label": "Taslağı Belge sayfasında düzenle"
    },
    "component:muhasebelestirDugmesi": {
      "since": 1,
      "label": "Muhasebeleştir komutu",
      "requires": [
        "query:muhasebelestir",
        "query:taslaklar"
      ]
    },
    "component:muhasebelestirSatir": {
      "since": 2,
      "label": "Satır muhasebeleştir komutu",
      "requires": [
        "component:liste",
        "query:muhasebelestir"
      ]
    },
    "query:taslaklar": {
      "since": 1,
      "label": "Fatura taslaklarını listele",
      "requires": [
        "component:liste",
        "component:suzgec"
      ]
    },
    "query:muhasebelestir": {
      "since": 1,
      "label": "Fatura taslağını muhasebeleştir",
      "requires": [
        "component:liste"
      ]
    }
  },
  "screenViews": [
    {
      "key": "standalone-invoice-drafts",
      "component": "liste",
      "fields": {
        "invoiceNumber": "invoiceNumber",
        "supplierName": "supplierName",
        "invoiceDate": "invoiceDate",
        "dueDate": "dueDate",
        "currencyCode": "currencyCode",
        "grandTotal": "grandTotal",
        "status": "status"
      }
    }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "newAction": "page",
          "newPageCode": "@purchase-invoice-document",
          "newTarget": "newTab",
          "openAction": "page",
          "openPageCode": "@purchase-invoice-document",
          "openTarget": "newTab",
          "openTable": "liste",
          "openParams": [
            "id={{liste.seciliSatir.id}}"
          ],
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{taslaklar.meta.totalCount}}",
          "moreButtons": [
            "muhasebelestirDugmesi"
          ],
          "hiddenCommands": [
            "save",
            "delete",
            "print"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "duzenleDugmesi",
        "type": "button",
        "name": "duzenleDugmesi",
        "props": {
          "text": "Düzenle",
          "actionType": "erpPage",
          "pageKey": "purchase-invoice-document",
          "target": "newTab",
          "params": [
            "id={{liste.seciliSatir.id}}"
          ],
          "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.status != 'Draft'",
          "disabledReason": "Yalnız taslaklar düzenlenebilir.",
          "slot": "rowActions"
        }
      },
      {
        "id": "muhasebelestirDugmesi",
        "type": "button",
        "name": "muhasebelestirDugmesi",
        "props": {
          "text": "Muhasebeleştir",
          "actionType": "query",
          "queryId": "muhasebelestir",
          "confirmEnabled": true,
          "refreshQueries": [
            "taslaklar"
          ],
          "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.status != 'Draft'",
          "disabledReason": "Yalnız taslaklar muhasebeleştirilebilir.",
          "slot": "actions"
        }
      },
      {
        "id": "muhasebelestirSatir",
        "type": "button",
        "name": "muhasebelestirSatir",
        "props": {
          "text": "Muhasebeleştir",
          "actionType": "query",
          "queryId": "muhasebelestir",
          "confirmEnabled": true,
          "refreshQueries": [
            "taslaklar"
          ],
          "visibleWhen": "liste.seciliSatir.status == 'Draft'",
          "slot": "rowActions"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "search": true,
          "searchPlaceholder": "Fatura no veya tedarikçi ara",
          "searchParam": "q",
          "filters": [
            "status|select|row||Durum"
          ],
          "slot": "filters"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Fatura taslakları",
          "query": "taslaklar",
          "paging": "server",
          "pageSize": 25,
          "columns": [
            "invoiceNumber",
            "supplierName",
            "invoiceDate",
            "dueDate",
            "status",
            "grandTotal",
            "currencyCode"
          ],
          "columnLabels": [
            "invoiceNumber=Fatura no",
            "supplierName=Tedarikçi",
            "invoiceDate=Tarih",
            "dueDate=Vade",
            "status=Durum",
            "grandTotal=Toplam"
          ],
          "columnUnits": [
            "grandTotal=currencyCode"
          ],
          "columnFormats": [
            "invoiceNumber=code",
            "invoiceDate=date",
            "dueDate=date",
            "grandTotal=money",
            "status=status"
          ],
          "valueLabels": [
            "status:Draft=Taslak",
            "status:Posted=Muhasebeleşti"
          ],
          "rowActions": [
            "duzenleDugmesi",
            "muhasebelestirSatir"
          ],
          "rowOpenAction": "duzenleDugmesi",
          "emptyText": "Fatura taslağı yok.",
          "slot": "table"
        }
      }
    ],
    "queries": [
      {
        "id": "taslaklar",
        "name": "taslaklar",
        "kind": "read",
        "operation": "satinalma.faturaTaslagi.listele",
        "runOn": "load",
        "parameters": [
          {
            "name": "q",
            "binding": "{{suzgec.q}}",
            "type": "text"
          },
          {
            "name": "page",
            "binding": "{{liste.sayfa}}",
            "type": "int"
          },
          {
            "name": "pageSize",
            "binding": "{{liste.sayfaBoyutu}}",
            "type": "int"
          }
        ]
      },
      {
        "id": "muhasebelestir",
        "name": "muhasebelestir",
        "kind": "update",
        "operation": "satinalma.faturaTaslagi.muhasebelestir",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      }
    ],
    "template": {
      "name": "list"
    }
  }
}
