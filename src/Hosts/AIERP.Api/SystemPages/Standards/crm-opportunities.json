{
  "screenKey": "crm-opportunities", "title": "CRM Fırsatları", "description": "Satış fırsatlarını aşama, tahmini değer ve takip tarihine göre izleyin.", "module": "Satış & cari", "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:acDugmesi", "query:firsatlar", "query:sil"]},
    "component:acikGostergesi": {"since": 1, "label": "Açık fırsat göstergesi", "requires": ["query:ozet"]},
    "component:kazanildiGostergesi": {"since": 1, "label": "Kazanıldı göstergesi", "requires": ["query:ozet"]},
    "component:degerGostergesi": {"since": 1, "label": "Açık fırsat değeri göstergesi", "requires": ["query:ozet"]},
    "component:takipGostergesi": {"since": 1, "label": "Takibi geçmiş göstergesi", "requires": ["query:ozet"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:liste": {"since": 1, "label": "Fırsat listesi", "requires": ["component:acDugmesi", "query:firsatlar"]},
    "component:acDugmesi": {"since": 1, "label": "Satırı aç (fırsat kartı)", "requires": ["component:liste"]},
    "component:nitelikliDugmesi": {"since": 1, "label": "Sıradaki aşama: Nitelikli (satır eylemi)", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:nitelikli"]},
    "component:teklifDugmesi": {"since": 1, "label": "Sıradaki aşama: Teklif (satır eylemi)", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:teklif"]},
    "component:muzakereDugmesi": {"since": 1, "label": "Sıradaki aşama: Müzakere (satır eylemi)", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:muzakere"]},
    "component:kazanildiDugmesi": {"since": 1, "label": "Sıradaki aşama: Kazanıldı (satır eylemi)", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:kazanildi"]},
    "component:kaybedildiDugmesi": {"since": 1, "label": "Kaybedildi olarak işaretle", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:kaybedildi"]},
    "component:detayKarti": {"since": 1, "label": "Detay kartı (aşama, değer, olasılık, müşteri, takip, not)", "requires": ["component:liste"]},
    "query:firsatlar": {"since": 1, "label": "CRM fırsatlarını listele", "requires": ["component:suzgec", "component:liste"]},
    "query:ozet": {"since": 1, "label": "CRM fırsat özeti", "requires": ["component:suzgec"]},
    "query:sil": {"since": 1, "label": "CRM fırsatını sil", "requires": ["component:liste"]},
    "query:nitelikli": {"since": 1, "label": "Nitelikli aşamasına taşı", "requires": ["component:liste"]},
    "query:teklif": {"since": 1, "label": "Teklif aşamasına taşı", "requires": ["component:liste"]},
    "query:muzakere": {"since": 1, "label": "Müzakere aşamasına taşı", "requires": ["component:liste"]},
    "query:kazanildi": {"since": 1, "label": "Kazanıldı olarak işaretle", "requires": ["component:liste"]},
    "query:kaybedildi": {"since": 1, "label": "Kaybedildi olarak işaretle", "requires": ["component:liste"]}
  },
  "screenViews": [
    {"key": "crm-opportunities", "component": "liste", "fields": {"code": "code", "name": "name", "customerName": "customerName", "stage": "stage", "estimatedValue": "estimatedValue", "probabilityPercent": "probabilityPercent", "expectedCloseDate": "expectedCloseDate", "nextActivityAt": "nextActivityAt"}}
  ],
  "definition": {
    "schemaVersion": 2,
    "template": {"name": "list"},
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{firsatlar.meta.totalCount}}", "deleteQuery": "sil", "deleteConfirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}} fırsatı silinsin mi?", "newAction": "page", "newPageCode": "@crm-opportunity-create", "newTarget": "newTab", "openButton": "acDugmesi", "hiddenCommands": ["save", "print"], "slot": "commands"}},
      {"id": "acikGostergesi", "type": "metric", "name": "acikGostergesi", "props": {"title": "Açık fırsat", "value": "{{ozet.rows[0].openCount}}", "format": "number", "icon": "target", "description": "tüm kayıtlar", "slot": "indicators"}},
      {"id": "kazanildiGostergesi", "type": "metric", "name": "kazanildiGostergesi", "props": {"title": "Kazanıldı", "value": "{{ozet.rows[0].wonCount}}", "format": "number", "icon": "check", "variant": "success", "description": "tüm kayıtlar", "slot": "indicators"}},
      {"id": "degerGostergesi", "type": "metric", "name": "degerGostergesi", "props": {"title": "Açık fırsat değeri", "value": "{{ozet.rows[0].openValueAmount}}", "format": "money", "icon": "wallet", "description": "tüm kayıtlar · {{ozet.rows[0].openValueCurrencyCode}}", "slot": "indicators"}},
      {"id": "takipGostergesi", "type": "metric", "name": "takipGostergesi", "props": {"title": "Takibi geçmiş", "value": "{{ozet.rows[0].overdueCount}}", "format": "number", "icon": "calendar-x", "variant": "warning", "description": "tüm kayıtlar", "slot": "indicators"}},
      {"id": "suzgec", "type": "filterBar", "name": "suzgec", "props": {"table": "liste", "search": true, "searchPlaceholder": "Kod, fırsat veya müşteri ara", "searchParam": "q", "filters": ["stage|select|row|stage|Aşama"], "slot": "filters"}},
      {"id": "liste", "type": "dataTable", "name": "liste", "props": {"title": "CRM fırsatları", "query": "firsatlar", "paging": "server", "pageSize": 50, "columns": ["code", "name", "customerName", "stage", "estimatedValue", "probabilityPercent", "expectedCloseDate", "nextActivityAt"], "columnLabels": ["code=Fırsat kodu", "name=Fırsat", "customerName=Müşteri", "stage=Aşama", "estimatedValue=Tahmini değer", "probabilityPercent=Olasılık", "expectedCloseDate=Beklenen kapanış", "nextActivityAt=Sonraki takip"], "columnFormats": ["code=code", "stage=status", "estimatedValue=money", "probabilityPercent=number", "expectedCloseDate=date", "nextActivityAt=datetime"], "columnUnits": ["estimatedValue=currencyCode"], "valueLabels": ["stage:Prospecting=İlk temas", "stage:Qualified=Nitelikli", "stage:Proposal=Teklif", "stage:Negotiation=Müzakere", "stage:Won=Kazanıldı", "stage:Lost=Kaybedildi"], "toneMap": ["İlk temas=info", "Nitelikli=info", "Teklif=warning", "Müzakere=warning", "Kazanıldı=success"], "rowOpenAction": "acDugmesi", "emptyText": "Satış hattınız henüz boş ya da bu aramayla eşleşen fırsat yok.", "slot": "list", "rowActions": ["nitelikliDugmesi", "teklifDugmesi", "muzakereDugmesi", "kazanildiDugmesi", "kaybedildiDugmesi"]}},
      {"id": "acDugmesi", "type": "button", "name": "acDugmesi", "props": {"text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@crm-opportunity-create", "target": "newTab", "params": ["opportunityId={{liste.seciliSatir.id}}"], "visibleWhen": "liste.seciliSatir.id != null", "disabledWhen": "liste.seciliSatir.stage == 'Won' || liste.seciliSatir.stage == 'Lost'", "disabledReason": "Kapanmış fırsat düzenlenemez", "slot": "rowActions"}},
      {"id": "nitelikliDugmesi", "type": "button", "name": "nitelikliDugmesi", "props": {"text": "Nitelikliye taşı", "actionType": "query", "queryId": "nitelikli", "successMessage": "{{liste.seciliSatir.name}}: Nitelikli aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"], "visibleWhen": "liste.seciliSatir.stage == 'Prospecting'", "slot": "rowActions"}},
      {"id": "teklifDugmesi", "type": "button", "name": "teklifDugmesi", "props": {"text": "Teklife taşı", "actionType": "query", "queryId": "teklif", "successMessage": "{{liste.seciliSatir.name}}: Teklif aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"], "visibleWhen": "liste.seciliSatir.stage == 'Qualified'", "slot": "rowActions"}},
      {"id": "muzakereDugmesi", "type": "button", "name": "muzakereDugmesi", "props": {"text": "Müzakereye taşı", "actionType": "query", "queryId": "muzakere", "successMessage": "{{liste.seciliSatir.name}}: Müzakere aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"], "visibleWhen": "liste.seciliSatir.stage == 'Proposal'", "slot": "rowActions"}},
      {"id": "kazanildiDugmesi", "type": "button", "name": "kazanildiDugmesi", "props": {"text": "Kazanıldı", "actionType": "query", "queryId": "kazanildi", "successMessage": "{{liste.seciliSatir.name}}: Kazanıldı aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"], "visibleWhen": "liste.seciliSatir.stage == 'Negotiation'", "disabledWhen": "liste.seciliSatir.customerId == null", "disabledReason": "Kazanılan fırsat için önce bir müşteri carisi bağlayın.", "slot": "rowActions"}},
      {"id": "kaybedildiDugmesi", "type": "button", "name": "kaybedildiDugmesi", "props": {"text": "Kaybedildi", "actionType": "query", "queryId": "kaybedildi", "confirmEnabled": true, "confirmText": "“{{liste.seciliSatir.name}}” kaybedildi olarak işaretlensin mi? Kapanan fırsat yeniden açılamaz.", "successMessage": "{{liste.seciliSatir.name}}: Kaybedildi aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"], "visibleWhen": "liste.seciliSatir.id != null && liste.seciliSatir.stage != 'Won' && liste.seciliSatir.stage != 'Lost'", "slot": "rowActions"}},
      {"id": "detayKarti", "type": "card", "name": "detayKarti", "props": {"variant": "panel", "title": "{{liste.seciliSatir.name}}", "description": "{{liste.seciliSatir.code}}", "slot": "detail"}, "children": [{"id": "detayBos", "type": "text", "name": "detayBos", "props": {"text": "Bir fırsat seçin; ayrıntıları burada görün.", "visibleWhen": "liste.seciliSatir.id == null"}}, {"id": "asamaIlkTemas", "type": "badge", "name": "asamaIlkTemas", "props": {"text": "İlk temas", "variant": "info", "visibleWhen": "liste.seciliSatir.stage == 'Prospecting'"}}, {"id": "asamaNitelikli", "type": "badge", "name": "asamaNitelikli", "props": {"text": "Nitelikli", "variant": "info", "visibleWhen": "liste.seciliSatir.stage == 'Qualified'"}}, {"id": "asamaTeklif", "type": "badge", "name": "asamaTeklif", "props": {"text": "Teklif", "variant": "warning", "visibleWhen": "liste.seciliSatir.stage == 'Proposal'"}}, {"id": "asamaMuzakere", "type": "badge", "name": "asamaMuzakere", "props": {"text": "Müzakere", "variant": "warning", "visibleWhen": "liste.seciliSatir.stage == 'Negotiation'"}}, {"id": "asamaKazanildi", "type": "badge", "name": "asamaKazanildi", "props": {"text": "Kazanıldı", "variant": "success", "visibleWhen": "liste.seciliSatir.stage == 'Won'"}}, {"id": "asamaKaybedildi", "type": "badge", "name": "asamaKaybedildi", "props": {"text": "Kaybedildi", "variant": "info", "visibleWhen": "liste.seciliSatir.stage == 'Lost'"}}, {"id": "asamaYolu", "type": "text", "name": "asamaYolu", "props": {"text": "İlk temas › Nitelikli › Teklif › Müzakere › Kazanıldı", "visibleWhen": "liste.seciliSatir.id != null && liste.seciliSatir.stage != 'Lost'"}}, {"id": "tahminiDeger", "type": "metric", "name": "tahminiDeger", "props": {"title": "Tahmini değer", "value": "{{liste.seciliSatir.estimatedValue}}", "format": "money", "icon": "wallet", "description": "{{liste.seciliSatir.currencyCode}}"}}, {"id": "olasilik", "type": "metric", "name": "olasilik", "props": {"title": "Kazanma olasılığı", "value": "{{liste.seciliSatir.probabilityPercent}}", "format": "number", "icon": "percent", "description": "%"}}, {"id": "detayBilgi", "type": "contextPanel", "name": "detayBilgi", "props": {"table": "liste", "visibleWhen": "liste.seciliSatir.id != null", "fields": ["customerName=Müşteri", "expectedCloseDate=Beklenen kapanış", "nextActivityAt=Sonraki takip"]}}, {"id": "musteriYok", "type": "text", "name": "musteriYok", "props": {"title": "Müşteri", "text": "Müşteri bağlanmadı", "visibleWhen": "liste.seciliSatir.customerId == null"}}, {"id": "notMetni", "type": "text", "name": "notMetni", "props": {"title": "Not", "text": "{{liste.seciliSatir.notes}}", "visibleWhen": "liste.seciliSatir.notes != null"}}, {"id": "notYok", "type": "text", "name": "notYok", "props": {"text": "Bu fırsat için not girilmemiş.", "visibleWhen": "liste.seciliSatir.notes == null"}}, {"id": "kayipNotu", "type": "alert", "name": "kayipNotu", "props": {"title": "Kaybedildi", "variant": "info", "text": "Kaybedildi · aşama geçmişi tutulmuyor", "visibleWhen": "liste.seciliSatir.stage == 'Lost'"}}]}
    ],
    "queries": [
      {"id": "firsatlar", "name": "firsatlar", "kind": "read", "operation": "crm.firsat.listele", "runOn": "load", "parameters": [{"name": "q", "binding": "{{suzgec.q}}", "type": "text"}, {"name": "stage", "binding": "{{suzgec.stage}}", "type": "text"}, {"name": "page", "binding": "{{liste.sayfa}}", "type": "int"}, {"name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int"}]},
      {"id": "ozet", "name": "ozet", "kind": "read", "operation": "crm.firsat.ozet", "runOn": "load", "parameters": [{"name": "q", "binding": "{{suzgec.q}}", "type": "text"}]},
      {"id": "sil", "name": "sil", "kind": "delete", "operation": "crm.firsat.sil", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]},
      {"id": "nitelikli", "name": "nitelikli", "kind": "update", "operation": "crm.firsat.nitelikliYap", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]},
      {"id": "teklif", "name": "teklif", "kind": "update", "operation": "crm.firsat.teklifeGecir", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]},
      {"id": "muzakere", "name": "muzakere", "kind": "update", "operation": "crm.firsat.muzakereyeGecir", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]},
      {"id": "kazanildi", "name": "kazanildi", "kind": "update", "operation": "crm.firsat.kazanildi", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]},
      {"id": "kaybedildi", "name": "kaybedildi", "kind": "update", "operation": "crm.firsat.kaybedildi", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]}
    ]
  }
}
