{
  "screenKey": "crm-opportunities", "title": "CRM Fırsatları",
  "description": "Satış fırsatlarını aşama, tahmini değer ve takip tarihine göre izleyin.", "module": "Satış & cari",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:acDugmesi", "component:nitelikliDugmesi", "component:teklifDugmesi", "component:muzakereDugmesi", "component:kazanildiDugmesi", "component:kaybedildiDugmesi", "query:firsatlar", "query:sil"]},
    "component:acikGostergesi": {"since": 1, "label": "Açık fırsat göstergesi", "requires": ["query:ozet"]},
    "component:kazanildiGostergesi": {"since": 1, "label": "Kazanıldı göstergesi", "requires": ["component:asamaSecimi", "query:ozet"]},
    "component:degerGostergesi": {"since": 1, "label": "Açık fırsat değeri göstergesi", "requires": ["query:ozet"]},
    "component:degerCokDovizGostergesi": {"since": 1, "label": "Açık fırsat değeri göstergesi (birden çok döviz)", "requires": ["query:ozet"]},
    "component:takipGostergesi": {"since": 1, "label": "Takibi geçmiş göstergesi", "requires": ["query:ozet"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:secimCipleri": {"since": 1, "label": "Aşama seçimi çipleri", "requires": ["component:asamaSecimi"]},
    "component:asamaSecimi": {"since": 1, "label": "Aşama seçimi"},
    "component:gorunumKarti": {"since": 1, "label": "Detay paneli anahtarı kartı", "requires": ["component:detayPaneli"]},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:liste": {"since": 1, "label": "Fırsat listesi", "requires": ["component:detayPaneli", "component:acDugmesi", "query:firsatlar"]},
    "component:acDugmesi": {"since": 1, "label": "Satırı aç (fırsat kartı)", "requires": ["component:liste"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:ozetBolumu", "component:musteriPaneli", "component:musteriYok", "component:asamaAkisi", "component:kayipNotu", "component:notMetni", "component:notYok"]},
    "component:ozetBolumu": {"since": 1, "label": "Detay: Özet", "requires": ["component:liste"]},
    "component:bosSecim": {"since": 1, "label": "Detay paneli: seçim yok notu", "requires": ["component:detayPaneli", "component:liste"]},
    "component:musteriPaneli": {"since": 1, "label": "Detay: Müşteri", "requires": ["component:liste"]},
    "component:musteriYok": {"since": 1, "label": "Detay: Müşteri bağlanmadı notu", "requires": ["component:liste"]},
    "component:asamaAkisi": {"since": 1, "label": "Detay: Aşama akışı", "requires": ["component:liste"]},
    "component:kayipNotu": {"since": 1, "label": "Detay: Kaybedildi notu", "requires": ["component:liste"]},
    "component:notMetni": {"since": 1, "label": "Detay: Not", "requires": ["component:liste"]},
    "component:notYok": {"since": 1, "label": "Detay: Not yok notu", "requires": ["component:liste"]},
    "component:nitelikliDugmesi": {"since": 1, "label": "Aşamayı ilerlet: Nitelikli", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:nitelikli"]},
    "component:teklifDugmesi": {"since": 1, "label": "Aşamayı ilerlet: Teklif", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:teklif"]},
    "component:muzakereDugmesi": {"since": 1, "label": "Aşamayı ilerlet: Müzakere", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:muzakere"]},
    "component:kazanildiDugmesi": {"since": 1, "label": "Aşamayı ilerlet: Kazanıldı", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:kazanildi"]},
    "component:kaybedildiDugmesi": {"since": 1, "label": "Kaybedildi olarak işaretle", "requires": ["component:liste", "query:firsatlar", "query:ozet", "query:kaybedildi"]},
    "query:firsatlar": {"since": 1, "label": "CRM fırsatlarını listele", "requires": ["component:suzgec", "component:asamaSecimi", "component:liste"]},
    "query:ozet": {"since": 1, "label": "CRM fırsat özeti", "requires": ["component:suzgec"]},
    "query:sil": {"since": 1, "label": "CRM fırsatını sil", "requires": ["component:liste"]},
    "query:nitelikli": {"since": 1, "label": "Nitelikli aşamasına taşı", "requires": ["component:liste"]},
    "query:teklif": {"since": 1, "label": "Teklif aşamasına taşı", "requires": ["component:liste"]},
    "query:muzakere": {"since": 1, "label": "Müzakere aşamasına taşı", "requires": ["component:liste"]},
    "query:kazanildi": {"since": 1, "label": "Kazanıldı olarak işaretle", "requires": ["component:liste"]},
    "query:kaybedildi": {"since": 1, "label": "Kaybedildi olarak işaretle", "requires": ["component:liste"]}
  },
  "screenViews": [ { "key": "crm-opportunities", "component": "liste",
                     "fields": { "code": "code", "name": "name", "customerName": "customerName", "stage": "stage",
                                 "estimatedValue": "estimatedValue", "probabilityPercent": "probabilityPercent",
                                 "expectedCloseDate": "expectedCloseDate", "nextActivityAt": "nextActivityAt" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{firsatlar.meta.totalCount}}", "deleteQuery": "sil",
                   "newAction": "page", "newPageCode": "@crm-opportunity-create", "newTarget": "newTab",
                   "openButton": "acDugmesi",
                   "moreButtons": ["nitelikliDugmesi", "teklifDugmesi", "muzakereDugmesi", "kazanildiDugmesi", "kaybedildiDugmesi"],
                   "hiddenCommands": ["save", "print"] } },

      { "id": "acikGostergesi", "type": "metric", "name": "acikGostergesi",
        "props": { "title": "Açık fırsat", "value": "{{ozet.rows[0].openCount}}", "format": "number", "width": 3, "icon": "target",
                   "description": "tüm kayıtlar" } },
      { "id": "kazanildiGostergesi", "type": "metric", "name": "kazanildiGostergesi",
        "props": { "title": "Kazanıldı", "value": "{{ozet.rows[0].wonCount}}", "format": "number", "width": 3, "icon": "check",
                   "variant": "success", "description": "tüm kayıtlar", "filterInput": "asamaSecimi", "filterValue": "Won" } },
      { "id": "degerGostergesi", "type": "metric", "name": "degerGostergesi",
        "props": { "title": "Açık fırsat değeri", "value": "{{ozet.rows[0].openValueAmount}}", "format": "money", "width": 3, "icon": "wallet",
                   "description": "tüm kayıtlar · {{ozet.rows[0].openValueCurrencyCode}}",
                   "visibleWhen": "ozet.rows[0].otherCurrencyCount == null || ozet.rows[0].otherCurrencyCount == 0" } },
      { "id": "degerCokDovizGostergesi", "type": "metric", "name": "degerCokDovizGostergesi",
        "props": { "title": "Açık fırsat değeri", "value": "{{ozet.rows[0].openValueAmount}}", "format": "money", "width": 3, "icon": "wallet",
                   "description": "tüm kayıtlar · {{ozet.rows[0].openValueCurrencyCode}} · + {{ozet.rows[0].otherCurrencyCount}} dövizde",
                   "visibleWhen": "ozet.rows[0].otherCurrencyCount > 0" } },
      { "id": "takipGostergesi", "type": "metric", "name": "takipGostergesi",
        "props": { "title": "Takibi geçmiş", "value": "{{ozet.rows[0].overdueCount}}", "format": "number", "width": 3, "icon": "calendar-x",
                   "variant": "warning", "description": "tüm kayıtlar" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 5, "search": true, "searchPlaceholder": "Kod, fırsat veya müşteri ara", "searchParam": "q" } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": { "width": 5, "inputs": ["asamaSecimi"] } },
      { "id": "asamaSecimi", "type": "input", "name": "asamaSecimi",
        "props": { "inputType": "select", "label": "Aşama",
                   "staticOptions": ["=Tümü", "Prospecting=İlk temas", "Qualified=Nitelikli", "Proposal=Teklif", "Negotiation=Müzakere",
                                     "Won=Kazanıldı", "Lost=Kaybedildi"] } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": { "title": "Görünüm", "layout": "inline", "width": 2, "inputs": ["detayPaneli"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "CRM fırsatları", "query": "firsatlar", "paging": "server", "pageSize": 50, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true",
                   "columns": ["code", "name", "customerName", "stage", "estimatedValue", "probabilityPercent", "expectedCloseDate", "nextActivityAt"],
                   "columnLabels": ["code=Fırsat kodu", "name=Fırsat", "customerName=Müşteri", "stage=Aşama", "estimatedValue=Tahmini değer",
                                    "probabilityPercent=Olasılık", "expectedCloseDate=Beklenen kapanış", "nextActivityAt=Sonraki takip"],
                   "columnFormats": ["code=code", "stage=status", "estimatedValue=money", "probabilityPercent=number", "expectedCloseDate=date",
                                     "nextActivityAt=datetime"],
                   "columnUnits": ["estimatedValue=currencyCode"],
                   "valueLabels": ["stage:Prospecting=İlk temas", "stage:Qualified=Nitelikli", "stage:Proposal=Teklif", "stage:Negotiation=Müzakere",
                                   "stage:Won=Kazanıldı", "stage:Lost=Kaybedildi"],
                   "toneMap": ["İlk temas=info", "Nitelikli=info", "Teklif=warning", "Müzakere=warning", "Kazanıldı=success"],
                   "rowOpenAction": "acDugmesi",
                   "emptyText": "Satış hattınız henüz boş ya da bu aramayla eşleşen fırsat yok." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@crm-opportunity-create", "target": "newTab",
                   "params": ["opportunityId={{liste.seciliSatir.id}}"], "visibleWhen": "liste.seciliSatir.id != null",
                   "disabledWhen": "liste.seciliSatir.stage == 'Won' || liste.seciliSatir.stage == 'Lost'",
                   "disabledReason": "Kapanmış fırsat düzenlenemez" } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.name}}", "description": "{{liste.seciliSatir.code}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@crm-opportunity-create", "target": "newTab",
                       "params": ["opportunityId={{liste.seciliSatir.id}}"],
                       "disabledWhen": "liste.seciliSatir.stage == 'Won' || liste.seciliSatir.stage == 'Lost'",
                       "disabledReason": "Kapanmış fırsat düzenlenemez" } },
          { "id": "asamaIlkTemas", "type": "badge", "name": "asamaIlkTemas",
            "props": { "text": "İlk temas", "variant": "info", "visibleWhen": "liste.seciliSatir.stage == 'Prospecting'" } },
          { "id": "asamaNitelikli", "type": "badge", "name": "asamaNitelikli",
            "props": { "text": "Nitelikli", "variant": "info", "visibleWhen": "liste.seciliSatir.stage == 'Qualified'" } },
          { "id": "asamaTeklif", "type": "badge", "name": "asamaTeklif",
            "props": { "text": "Teklif", "variant": "warning", "visibleWhen": "liste.seciliSatir.stage == 'Proposal'" } },
          { "id": "asamaMuzakere", "type": "badge", "name": "asamaMuzakere",
            "props": { "text": "Müzakere", "variant": "warning", "visibleWhen": "liste.seciliSatir.stage == 'Negotiation'" } },
          { "id": "asamaKazanildi", "type": "badge", "name": "asamaKazanildi",
            "props": { "text": "Kazanıldı", "variant": "success", "visibleWhen": "liste.seciliSatir.stage == 'Won'" } },
          { "id": "asamaKaybedildi", "type": "badge", "name": "asamaKaybedildi",
            "props": { "text": "Kaybedildi", "variant": "info", "visibleWhen": "liste.seciliSatir.stage == 'Lost'" } },
          { "id": "kapandiEtiketi", "type": "badge", "name": "kapandiEtiketi",
            "props": { "text": "Kapandı", "variant": "info", "visibleWhen": "liste.seciliSatir.stage == 'Won' || liste.seciliSatir.stage == 'Lost'" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetBolumu,musteriPaneli,musteriYok,asamaAkisi,kayipNotu", "Not=notMetni,notYok"] } }
        ] },
      { "id": "ozetBolumu", "type": "section", "name": "ozetBolumu",
        "props": { "width": 12 },
        "children": [
          { "id": "tahminiDeger", "type": "metric", "name": "tahminiDeger",
            "props": { "title": "Tahmini değer", "value": "{{liste.seciliSatir.estimatedValue}}", "format": "money", "width": 6, "icon": "wallet",
                       "description": "{{liste.seciliSatir.currencyCode}}" } },
          { "id": "olasilik", "type": "metric", "name": "olasilik",
            "props": { "title": "Kazanma olasılığı", "value": "{{liste.seciliSatir.probabilityPercent}}", "format": "number", "width": 6,
                       "icon": "percent", "description": "%" } },
          { "id": "kapanisTarihi", "type": "metric", "name": "kapanisTarihi",
            "props": { "title": "Beklenen kapanış", "value": "{{liste.seciliSatir.expectedCloseDate}}", "format": "date", "width": 6,
                       "icon": "calendar", "visibleWhen": "liste.seciliSatir.expectedCloseDate != null" } },
          { "id": "kapanisYok", "type": "metric", "name": "kapanisYok",
            "props": { "title": "Beklenen kapanış", "value": "Belirtilmedi", "width": 6, "icon": "calendar",
                       "visibleWhen": "liste.seciliSatir.expectedCloseDate == null" } },
          { "id": "sonrakiTakip", "type": "metric", "name": "sonrakiTakip",
            "props": { "title": "Sonraki takip", "value": "{{liste.seciliSatir.nextActivityAt}}", "format": "datetime", "width": 6,
                       "icon": "calendar-clock", "visibleWhen": "liste.seciliSatir.nextActivityAt != null" } },
          { "id": "takipYok", "type": "metric", "name": "takipYok",
            "props": { "title": "Sonraki takip", "value": "Planlanmadı", "width": 6, "icon": "calendar-clock",
                       "visibleWhen": "liste.seciliSatir.nextActivityAt == null" } }
        ] },
      { "id": "bosSecim", "type": "text", "name": "bosSecim",
        "props": { "text": "Özetini görmek için listeden bir fırsat seçin.", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id == null" } },
      { "id": "musteriPaneli", "type": "contextPanel", "name": "musteriPaneli",
        "props": { "table": "liste", "width": 12, "fields": ["customerName=Müşteri"],
                   "visibleWhen": "liste.seciliSatir.customerId != null" } },
      { "id": "musteriYok", "type": "text", "name": "musteriYok",
        "props": { "title": "Müşteri", "text": "Müşteri bağlanmadı", "visibleWhen": "liste.seciliSatir.customerId == null" } },
      { "id": "asamaAkisi", "type": "steps", "name": "asamaAkisi",
        "props": { "steps": ["İlk temas", "Nitelikli", "Teklif", "Müzakere", "Kazanıldı"],
                   "activeWhen": ["liste.seciliSatir.stage == 'Prospecting'", "liste.seciliSatir.stage == 'Qualified'",
                                  "liste.seciliSatir.stage == 'Proposal'", "liste.seciliSatir.stage == 'Negotiation'",
                                  "liste.seciliSatir.stage == 'Won'"],
                   "visibleWhen": "liste.seciliSatir.stage != 'Lost'" } },
      { "id": "kayipNotu", "type": "alert", "name": "kayipNotu",
        "props": { "title": "Kaybedildi", "variant": "info", "width": 12, "text": "Kaybedildi · aşama geçmişi tutulmuyor",
                   "visibleWhen": "liste.seciliSatir.stage == 'Lost'" } },
      { "id": "notMetni", "type": "text", "name": "notMetni",
        "props": { "title": "Not", "text": "{{liste.seciliSatir.notes}}", "visibleWhen": "liste.seciliSatir.notes != null" } },
      { "id": "notYok", "type": "text", "name": "notYok",
        "props": { "text": "Bu fırsat için not girilmemiş.", "visibleWhen": "liste.seciliSatir.notes == null" } },

      { "id": "nitelikliDugmesi", "type": "button", "name": "nitelikliDugmesi",
        "props": { "text": "Aşamayı ilerlet: Nitelikli", "actionType": "query", "queryId": "nitelikli",
                   "successMessage": "{{liste.seciliSatir.name}}: Nitelikli aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"],
                   "visibleWhen": "liste.seciliSatir.stage == 'Prospecting'" } },
      { "id": "teklifDugmesi", "type": "button", "name": "teklifDugmesi",
        "props": { "text": "Aşamayı ilerlet: Teklif", "actionType": "query", "queryId": "teklif",
                   "successMessage": "{{liste.seciliSatir.name}}: Teklif aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"],
                   "visibleWhen": "liste.seciliSatir.stage == 'Qualified'" } },
      { "id": "muzakereDugmesi", "type": "button", "name": "muzakereDugmesi",
        "props": { "text": "Aşamayı ilerlet: Müzakere", "actionType": "query", "queryId": "muzakere",
                   "successMessage": "{{liste.seciliSatir.name}}: Müzakere aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"],
                   "visibleWhen": "liste.seciliSatir.stage == 'Proposal'" } },
      { "id": "kazanildiDugmesi", "type": "button", "name": "kazanildiDugmesi",
        "props": { "text": "Aşamayı ilerlet: Kazanıldı", "actionType": "query", "queryId": "kazanildi",
                   "successMessage": "{{liste.seciliSatir.name}}: Kazanıldı aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"],
                   "visibleWhen": "liste.seciliSatir.stage == 'Negotiation'",
                   "disabledWhen": "liste.seciliSatir.customerId == null",
                   "disabledReason": "Kazanılan fırsat için önce bir müşteri carisi bağlayın." } },
      { "id": "kaybedildiDugmesi", "type": "button", "name": "kaybedildiDugmesi",
        "props": { "text": "Kaybedildi olarak işaretle", "actionType": "query", "queryId": "kaybedildi", "confirmEnabled": true,
                   "confirmText": "“{{liste.seciliSatir.name}}” kaybedildi olarak işaretlensin mi? Kapanan fırsat yeniden açılamaz.",
                   "successMessage": "{{liste.seciliSatir.name}}: Kaybedildi aşamasına taşındı.", "refreshQueries": ["firsatlar", "ozet"],
                   "visibleWhen": "liste.seciliSatir.id != null && liste.seciliSatir.stage != 'Won' && liste.seciliSatir.stage != 'Lost'" } }
    ],
    "queries": [
      { "id": "firsatlar", "name": "firsatlar", "kind": "read", "operation": "crm.firsat.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "stage", "binding": "{{asamaSecimi.value}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "ozet", "name": "ozet", "kind": "read", "operation": "crm.firsat.ozet", "runOn": "load",
        "parameters": [ { "name": "q", "binding": "{{suzgec.q}}", "type": "text" } ] },
      { "id": "sil", "name": "sil", "kind": "delete", "operation": "crm.firsat.sil", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "nitelikli", "name": "nitelikli", "kind": "update", "operation": "crm.firsat.nitelikliYap", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "teklif", "name": "teklif", "kind": "update", "operation": "crm.firsat.teklifeGecir", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "muzakere", "name": "muzakere", "kind": "update", "operation": "crm.firsat.muzakereyeGecir", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "kazanildi", "name": "kazanildi", "kind": "update", "operation": "crm.firsat.kazanildi", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "kaybedildi", "name": "kaybedildi", "kind": "update", "operation": "crm.firsat.kaybedildi", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] }
    ]
  }
}
