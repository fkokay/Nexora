{
  "screenKey": "manufacturing-order-create", "title": "Yeni üretim emri",
  "description": "Aktif reçeteden stoka veya satış siparişine üretim emri planlayın; emir Planlandı durumunda açılır.", "module": "Üretim",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["query:olustur"]},
    "component:baslik": {"since": 1, "label": "Başlık"},
    "component:aciklama": {"since": 1, "label": "Açıklama"},
    "component:vazgecDugmesi": {"since": 1, "label": "Vazgeç (üretim emirlerine dön)"},
    "component:zorunluNotu": {"since": 1, "label": "Zorunlu alanlar notu"},
    "component:emirKarti": {"since": 1, "label": "Kart bölümü: Emir", "requires": ["component:emirKodu", "component:planTarihi", "component:depo", "component:recete", "component:miktar", "component:uretimTuru"]},
    "component:emirKodu": {"since": 1, "label": "Alan: Emir kodu"},
    "component:planTarihi": {"since": 1, "label": "Alan: Plan tarihi"},
    "component:depo": {"since": 1, "label": "Alan: Üretim deposu", "requires": ["query:depolar"]},
    "component:recete": {"since": 1, "label": "Alan: Reçete", "requires": ["query:receteler"]},
    "component:receteDurumu": {"since": 1, "label": "Reçete seçici: yalnız aktif (gizli)"},
    "component:miktar": {"since": 1, "label": "Alan: Planlanan miktar"},
    "component:uretimTuru": {"since": 1, "label": "Alan: Üretim türü", "requires": ["component:siparis", "component:siparisSatiri"]},
    "component:siparisKarti": {"since": 1, "label": "Kart bölümü: Satış siparişi", "requires": ["component:siparis", "component:siparisSatiri", "component:uretimTuru"]},
    "component:siparis": {"since": 1, "label": "Alan: Satış siparişi", "requires": ["query:siparisler", "component:siparisSatiri"]},
    "component:siparisSatiri": {"since": 1, "label": "Alan: Sipariş satırı", "requires": ["query:siparisSatirlari"]},
    "component:siparisNotu": {"since": 1, "label": "Sipariş satırı notu", "requires": ["component:uretimTuru"]},
    "component:icerikTablosu": {"since": 1, "label": "Reçete içeriği (birim başına)", "requires": ["query:receteBilesenleri"]},
    "component:icerikNotu": {"since": 1, "label": "Reçete içeriği notu"},
    "component:ozetKarti": {"since": 1, "label": "Reçete özeti", "requires": ["query:receteOzeti"]},
    "query:depolar": {"since": 1, "label": "Depoları listele"},
    "query:receteler": {"since": 1, "label": "Aktif reçeteler", "requires": ["component:recete", "component:receteDurumu"]},
    "query:receteBilesenleri": {"since": 1, "label": "Seçili reçetenin bileşenleri", "requires": ["component:recete"]},
    "query:receteOzeti": {"since": 1, "label": "Seçili reçete", "requires": ["component:recete"]},
    "query:siparisler": {"since": 1, "label": "Satış siparişleri", "requires": ["component:siparis"]},
    "query:siparisSatirlari": {"since": 1, "label": "Seçili siparişin satırları", "requires": ["component:siparis"]},
    "query:olustur": {"since": 1, "label": "Üretim emri planla", "requires": ["component:emirKodu", "component:planTarihi", "component:depo", "component:recete", "component:miktar", "component:siparis", "component:siparisSatiri"]}
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "saveQuery": "olustur",
                   "newAction": "page", "newPageCode": "@manufacturing-order-create", "newTarget": "sameTab",
                   "afterSaveAction": "page", "afterSavePageCode": "@manufacturing-orders", "afterSaveTarget": "sameTab", "afterSaveRefresh": true,
                   "hiddenCommands": ["open", "delete", "filter", "print", "export"] } },
      { "id": "baslik", "type": "heading", "name": "baslik",
        "props": { "text": "Üretim emri planlama", "pageTitle": true } },
      { "id": "aciklama", "type": "text", "name": "aciklama",
        "props": { "text": "Emir Planlandı durumunda açılır; kapasiteye çizelgeleme Üretim emirleri listesinden yapılır.", "width": 10 } },
      { "id": "vazgecDugmesi", "type": "button", "name": "vazgecDugmesi",
        "props": { "text": "Vazgeç", "actionType": "page", "pageCode": "@manufacturing-orders", "target": "sameTab", "width": 2 } },
      { "id": "zorunluNotu", "type": "text", "name": "zorunluNotu",
        "props": { "text": "* işaretli alanlar zorunludur. Emir kodu elle girilir (otomatik numara yok)." } },

      { "id": "emirKarti", "type": "formCard", "name": "emirKarti",
        "props": { "title": "Emir", "columns": 3, "inputs": ["emirKodu", "planTarihi", "depo", "recete", "miktar", "uretimTuru"], "trackChanges": true } },
      { "id": "emirKodu", "type": "input", "name": "emirKodu",
        "props": { "inputType": "text", "label": "Emir kodu", "required": true, "maxLength": 48, "upperCase": true, "placeholder": "URE-2026-001",
                   "pattern": "^[A-Z][A-Z0-9_-]*$", "patternMessage": "Kod harfle başlamalı; harf, rakam, tire veya alt çizgi içermelidir." } },
      { "id": "planTarihi", "type": "input", "name": "planTarihi",
        "props": { "inputType": "date", "label": "Plan tarihi", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "depo", "type": "input", "name": "depo",
        "props": { "inputType": "lookup", "label": "Üretim deposu", "required": true, "optionsQuery": "depolar", "optionValueColumn": "id",
                   "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "placeholder": "Depo seçin",
                   "optionsWhen": "satir.isActive == true" } },
      { "id": "recete", "type": "input", "name": "recete",
        "props": { "inputType": "lookup", "label": "Reçete", "required": true, "optionsQuery": "receteler", "optionValueColumn": "id",
                   "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "placeholder": "Aktif reçete seçin" } },
      { "id": "receteDurumu", "type": "input", "name": "receteDurumu",
        "props": { "inputType": "text", "label": "Reçete seçici durumu", "hidden": true, "defaultValue": "true" } },
      { "id": "miktar", "type": "input", "name": "miktar",
        "props": { "inputType": "number", "label": "Planlanan miktar", "required": true, "min": 0.0001, "step": 0.0001, "defaultValue": "1" } },
      { "id": "uretimTuru", "type": "input", "name": "uretimTuru",
        "props": { "inputType": "select", "label": "Üretim türü", "required": true, "defaultValue": "Stock",
                   "staticOptions": ["Stock=Stoka üretim", "SalesOrder=Satış siparişine üretim"],
                   "clearsOnChange": ["siparis", "siparisSatiri"] } },

      { "id": "siparisKarti", "type": "formCard", "name": "siparisKarti",
        "props": { "title": "Satış siparişi", "columns": 2, "inputs": ["siparis", "siparisSatiri"], "trackChanges": true,
                   "visibleWhen": "uretimTuru.value == 'SalesOrder'" } },
      { "id": "siparis", "type": "input", "name": "siparis",
        "props": { "inputType": "lookup", "label": "Satış siparişi", "requiredWhen": "uretimTuru.value == 'SalesOrder'", "optionsQuery": "siparisler",
                   "optionValueColumn": "id", "optionLabelColumn": "code", "optionDescriptionColumn": "customerName", "minChars": 0,
                   "optionsWhen": "satir.status == 'Open'", "allowClear": true, "clearsOnChange": ["siparisSatiri"] } },
      { "id": "siparisSatiri", "type": "input", "name": "siparisSatiri",
        "props": { "inputType": "lookup", "label": "Sipariş satırı", "requiredWhen": "uretimTuru.value == 'SalesOrder'", "optionsQuery": "siparisSatirlari",
                   "optionValueColumn": "lineNumber", "optionLabelColumn": "stockName", "optionDescriptionColumn": "stockCode", "minChars": 0,
                   "optionsWhen": "satir.remainingQuantity > 0", "allowClear": true } },
      { "id": "siparisNotu", "type": "text", "name": "siparisNotu",
        "props": { "text": "Reçete, miktar ve plan tarihi sipariş satırından doldurulmaz; sunucu satırın mamulle eşleştiğini denetler.",
                   "visibleWhen": "uretimTuru.value == 'SalesOrder'" } },

      { "id": "icerikTablosu", "type": "dataTable", "name": "icerikTablosu",
        "props": { "title": "Reçete içeriği (birim başına)", "query": "receteBilesenleri", "width": 8,
                   "showGridSearch": false, "showColumnFilters": false, "showColumnChooser": false, "showExport": false, "showPivot": false,
                   "showCsv": false, "showSelectedExport": false,
                   "columns": ["componentName", "quantity", "scrapPercent", "standardUnitCostBase"],
                   "columnLabels": ["componentName=Bileşen", "quantity=Miktar", "scrapPercent=Fire %", "standardUnitCostBase=Birim maliyet"],
                   "columnFormats": ["quantity=number", "scrapPercent=number", "standardUnitCostBase=money"],
                   "emptyText": "Reçete seçilmeden içerik boş kalır." } },
      { "id": "icerikNotu", "type": "text", "name": "icerikNotu",
        "props": { "text": "Emirdeki gereken miktar = miktar × (1 + fire) × planlanan ÷ çıktı. Kesin rakamlar kayıttan sonra emrin Bileşenler sekmesinde.",
                   "width": 8 } },
      { "id": "ozetKarti", "type": "card", "name": "ozetKarti",
        "props": { "title": "Reçete özeti", "width": 4 },
        "children": [
          { "id": "ozetMamul", "type": "text", "name": "ozetMamul",
            "props": { "text": "Mamul: {{receteOzeti.rows[0].productName}}", "visibleWhen": "receteOzeti.rows[0].id != null" } },
          { "id": "ozetIcerik", "type": "text", "name": "ozetIcerik",
            "props": { "text": "{{receteOzeti.rows[0].lineCount}} bileşen · {{receteOzeti.rows[0].operationCount}} operasyon · çıktı {{receteOzeti.rows[0].outputQuantity}}",
                       "visibleWhen": "receteOzeti.rows[0].id != null" } },
          { "id": "ozetBos", "type": "text", "name": "ozetBos",
            "props": { "text": "Reçete seçilmeden özet boş kalır.", "visibleWhen": "receteOzeti.rows[0].id == null" } }
        ] }
    ],
    "queries": [
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "runOn": "load", "parameters": [] },
      { "id": "receteler", "name": "receteler", "kind": "read", "operation": "uretim.recete.tumunuListele", "runOn": "load",
        "parameters": [ { "name": "isActive", "binding": "{{receteDurumu.value}}", "type": "bool" } ] },
      { "id": "receteBilesenleri", "name": "receteBilesenleri", "kind": "read", "operation": "uretim.recete.bilesenleri", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{recete.value}}", "type": "guid" } ] },
      { "id": "receteOzeti", "name": "receteOzeti", "kind": "read", "operation": "uretim.recete.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{recete.value}}", "type": "guid" } ] },
      { "id": "siparisler", "name": "siparisler", "kind": "read", "operation": "satis.siparis.listele", "runOn": "load",
        "parameters": [ { "name": "q", "binding": "{{siparis.search}}", "type": "text" } ] },
      { "id": "siparisSatirlari", "name": "siparisSatirlari", "kind": "read", "operation": "satis.siparis.kalemleri", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{siparis.value}}", "type": "guid" } ] },
      { "id": "olustur", "name": "olustur", "kind": "insert", "operation": "uretim.emir.olustur", "runOn": "manual",
        "parameters": [
          { "name": "code", "binding": "{{emirKodu.value}}", "type": "text" },
          { "name": "plannedDate", "binding": "{{planTarihi.value}}", "type": "date" },
          { "name": "warehouseId", "binding": "{{depo.value}}", "type": "guid" },
          { "name": "billOfMaterialId", "binding": "{{recete.value}}", "type": "guid" },
          { "name": "plannedQuantity", "binding": "{{miktar.value}}", "type": "decimal" },
          { "name": "sourceSalesOrderId", "binding": "{{siparis.value}}", "type": "guid" },
          { "name": "sourceSalesOrderLineNumber", "binding": "{{siparisSatiri.value}}", "type": "int" } ] }
    ]
  }
}
