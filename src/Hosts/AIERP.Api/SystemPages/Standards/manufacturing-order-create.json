  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "saveQuery": "olustur",
          "newAction": "page",
          "newPageCode": "@manufacturing-order-create",
          "newTarget": "sameTab",
          "afterSaveAction": "page",
          "afterSavePageCode": "@manufacturing-orders",
          "afterSaveTarget": "sameTab",
          "afterSaveRefresh": true,
          "hiddenCommands": [
            "open",
            "delete",
            "filter",
            "print",
            "export"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "ozet",
        "type": "recordHeader",
        "name": "ozet",
        "props": {
          "icon": "factory",
          "title": "Yeni üretim emri",
          "subtitle": "Planlandı · aktif reçeteden üretim",
          "slot": "summary"
        }
      },
      {
        "id": "sekme",
        "type": "tabs",
        "name": "sekme",
        "props": {
          "tabs": [
            "Emir=emirKarti,siparisKarti",
            "Reçete içeriği=icerikNotu"
          ],
          "slot": "tabs"
        }
      },
      {
        "id": "emirKarti",
        "type": "formCard",
        "name": "emirKarti",
        "props": {
          "title": "Emir",
          "columns": 2,
          "inputs": [
            "emirKodu",
            "planTarihi",
            "depo",
            "recete",
            "receteDurumu",
            "miktar",
            "uretimTuru"
          ],
          "slot": "section"
        }
      },
      {
        "id": "siparisKarti",
        "type": "formCard",
        "name": "siparisKarti",
        "props": {
          "title": "Satış siparişi",
          "columns": 2,
          "inputs": [
            "siparis",
            "siparisSatiri"
          ],
          "visibleWhen": "uretimTuru.value == 'SalesOrder'",
          "slot": "section"
        }
      },
      {
        "id": "emirKodu",
        "type": "input",
        "name": "emirKodu",
        "props": {
          "inputType": "text",
          "label": "Emir kodu",
          "required": true,
          "maxLength": 48,
          "upperCase": true,
          "placeholder": "URE-2026-001",
          "pattern": "^[A-Z][A-Z0-9_-]*$",
          "patternMessage": "Kod harfle başlamalı; harf, rakam, tire veya alt çizgi içermelidir.",
          "slot": "field"
        }
      },
      {
        "id": "planTarihi",
        "type": "input",
        "name": "planTarihi",
        "props": {
          "inputType": "date",
          "label": "Plan tarihi",
          "required": true,
          "defaultValue": "{{bugun}}",
          "slot": "field"
        }
      },
      {
        "id": "depo",
        "type": "input",
        "name": "depo",
        "props": {
          "inputType": "lookup",
          "label": "Üretim deposu",
          "required": true,
          "optionsQuery": "depolar",
          "optionValueColumn": "id",
          "optionLabelColumn": "name",
          "optionDescriptionColumn": "code",
          "minChars": 0,
          "placeholder": "Depo seçin",
          "optionsWhen": "satir.isActive == true",
          "slot": "field"
        }
      },
      {
        "id": "recete",
        "type": "input",
        "name": "recete",
        "props": {
          "inputType": "lookup",
          "label": "Reçete",
          "required": true,
          "optionsQuery": "receteler",
          "optionValueColumn": "id",
          "optionLabelColumn": "name",
          "optionDescriptionColumn": "code",
          "minChars": 0,
          "placeholder": "Aktif reçete seçin",
          "slot": "field"
        }
      },
      {
        "id": "receteDurumu",
        "type": "input",
        "name": "receteDurumu",
        "props": {
          "inputType": "text",
          "label": "Reçete seçici durumu",
          "hidden": true,
          "defaultValue": "true",
          "slot": "field"
        }
      },
      {
        "id": "miktar",
        "type": "input",
        "name": "miktar",
        "props": {
          "inputType": "number",
          "label": "Planlanan miktar",
          "required": true,
          "min": 0.0001,
          "step": 0.0001,
          "defaultValue": "1",
          "slot": "field"
        }
      },
      {
        "id": "uretimTuru",
        "type": "input",
        "name": "uretimTuru",
        "props": {
          "inputType": "select",
          "label": "Üretim türü",
          "required": true,
          "defaultValue": "Stock",
          "staticOptions": [
            "Stock=Stoka üretim",
            "SalesOrder=Satış siparişine üretim"
          ],
          "clearsOnChange": [
            "siparis",
            "siparisSatiri"
          ],
          "slot": "field"
        }
      },
      {
        "id": "siparis",
        "type": "input",
        "name": "siparis",
        "props": {
          "inputType": "lookup",
          "label": "Satış siparişi",
          "requiredWhen": "uretimTuru.value == 'SalesOrder'",
          "optionsQuery": "siparisler",
          "optionValueColumn": "id",
          "optionLabelColumn": "code",
          "optionDescriptionColumn": "customerName",
          "minChars": 0,
          "optionsWhen": "satir.status == 'Open'",
          "allowClear": true,
          "clearsOnChange": [
            "siparisSatiri"
          ],
          "slot": "field"
        }
      },
      {
        "id": "siparisSatiri",
        "type": "input",
        "name": "siparisSatiri",
        "props": {
          "inputType": "lookup",
          "label": "Sipariş satırı",
          "requiredWhen": "uretimTuru.value == 'SalesOrder'",
          "optionsQuery": "siparisSatirlari",
          "optionValueColumn": "lineNumber",
          "optionLabelColumn": "stockName",
          "optionDescriptionColumn": "stockCode",
          "minChars": 0,
          "optionsWhen": "satir.remainingQuantity > 0",
          "allowClear": true,
          "slot": "field"
        }
      },
      {
        "id": "icerikTablosu",
        "type": "dataTable",
        "name": "icerikTablosu",
        "props": {
          "title": "Reçete içeriği (birim başına)",
          "query": "receteBilesenleri",
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showExport": false,
          "showPivot": false,
          "showCsv": false,
          "showSelectedExport": false,
          "columns": [
            "componentName",
            "quantity",
            "scrapPercent",
            "standardUnitCostBase"
          ],
          "columnLabels": [
            "componentName=Bileşen",
            "quantity=Miktar",
            "scrapPercent=Fire %",
            "standardUnitCostBase=Birim maliyet"
          ],
          "columnFormats": [
            "quantity=number",
            "scrapPercent=number",
            "standardUnitCostBase=money"
          ],
          "emptyText": "Reçete seçilmeden içerik boş kalır.",
          "slot": "below"
        }
      },
      {
        "id": "icerikNotu",
        "type": "text",
        "name": "icerikNotu",
        "props": {
          "text": "Mamul: {{receteOzeti.rows[0].productName}} · {{receteOzeti.rows[0].lineCount}} bileşen · {{receteOzeti.rows[0].operationCount}} operasyon · çıktı {{receteOzeti.rows[0].outputQuantity}}",
          "visibleWhen": "receteOzeti.rows[0].id != null",
          "slot": "note"
        }
      },
      {
        "id": "vazgecDugmesi",
        "type": "button",
        "name": "vazgecDugmesi",
        "props": {
          "text": "Vazgeç",
          "actionType": "page",
          "pageCode": "@manufacturing-orders",
          "target": "sameTab",
          "slot": "actions"
        }
      },
      {
        "id": "aciklama",
        "type": "text",
        "name": "aciklama",
        "props": {
          "text": "Emir Planlandı durumunda açılır; kapasiteye çizelgeleme Üretim emirleri listesinden yapılır.",
          "slot": "above"
        }
      },
      {
        "id": "zorunluNotu",
        "type": "text",
        "name": "zorunluNotu",
        "props": {
          "text": "* işaretli alanlar zorunludur. Emir kodu elle girilir (otomatik numara yok).",
          "slot": "above"
        }
      }
    ],
    "queries": [
      {
        "id": "depolar",
        "name": "depolar",
        "kind": "read",
        "operation": "depo.listele",
        "runOn": "load",
        "parameters": []
      },
      {
        "id": "receteler",
        "name": "receteler",
        "kind": "read",
        "operation": "uretim.recete.tumunuListele",
        "runOn": "load",
        "parameters": [
          {
            "name": "isActive",
            "binding": "{{receteDurumu.value}}",
            "type": "bool"
          }
        ]
      },
      {
        "id": "receteBilesenleri",
        "name": "receteBilesenleri",
        "kind": "read",
        "operation": "uretim.recete.bilesenleri",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{recete.value}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "receteOzeti",
        "name": "receteOzeti",
        "kind": "read",
        "operation": "uretim.recete.getir",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{recete.value}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "siparisler",
        "name": "siparisler",
        "kind": "read",
        "operation": "satis.siparis.listele",
        "runOn": "load",
        "parameters": [
          {
            "name": "q",
            "binding": "{{siparis.search}}",
            "type": "text"
          }
        ]
      },
      {
        "id": "siparisSatirlari",
        "name": "siparisSatirlari",
        "kind": "read",
        "operation": "satis.siparis.kalemleri",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{siparis.value}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "olustur",
        "name": "olustur",
        "kind": "insert",
        "operation": "uretim.emir.olustur",
        "runOn": "manual",
        "parameters": [
          {
            "name": "code",
            "binding": "{{emirKodu.value}}",
            "type": "text"
          },
          {
            "name": "plannedDate",
            "binding": "{{planTarihi.value}}",
            "type": "date"
          },
          {
            "name": "warehouseId",
            "binding": "{{depo.value}}",
            "type": "guid"
          },
          {
            "name": "billOfMaterialId",
            "binding": "{{recete.value}}",
            "type": "guid"
          },
          {
            "name": "plannedQuantity",
            "binding": "{{miktar.value}}",
            "type": "decimal"
          },
          {
            "name": "sourceSalesOrderId",
            "binding": "{{siparis.value}}",
            "type": "guid"
          },
          {
            "name": "sourceSalesOrderLineNumber",
            "binding": "{{siparisSatiri.value}}",
            "type": "int"
          }
        ]
      }
    ],
    "template": {
      "name": "record"
    }
  }
}
