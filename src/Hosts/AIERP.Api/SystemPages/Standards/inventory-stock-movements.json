{
  "screenKey": "inventory-stock-movements", "title": "Stok Hareketleri",
  "description": "Stoku seçin; o stokun depo hareket geçmişi hemen listelenir.", "module": "Stok & Depo",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": { "since": 1, "label": "İşlem çubuğu", "requires": ["component:liste", "query:gecmis"] },
    "component:mevcutGostergesi": { "since": 1, "label": "Mevcut miktar göstergesi", "requires": ["query:stokOzeti", "component:suzgec"] },
    "component:degerGostergesi": { "since": 1, "label": "Stok değeri göstergesi", "requires": ["query:stokOzeti", "component:suzgec"] },
    "component:suzgec": { "since": 1, "label": "Süzgeç alanı (stok, depo)", "requires": ["component:liste", "query:gecmis", "query:stokBakiyeleri", "query:depolar"] },
    "component:secimIpucu": { "since": 1, "label": "Stok seçin ipucu", "requires": ["component:suzgec"] },
    "component:liste": { "since": 1, "label": "Stok hareketleri listesi", "requires": ["query:gecmis", "component:suzgec", "component:tersKayitDugmesi"] },
    "component:tersKayitDugmesi": { "since": 1, "label": "Ters kayıt satır eylemi", "requires": ["query:tersKayit", "query:gecmis", "query:stokOzeti"] },
    "query:depolar": { "since": 1, "label": "Depoları listele" },
    "query:stokBakiyeleri": { "since": 1, "label": "Stok seçimi seçenekleri" },
    "query:stokOzeti": { "since": 1, "label": "Seçili stokun bakiyesi", "requires": ["component:suzgec"] },
    "query:gecmis": { "since": 1, "label": "Stok hareket geçmişi", "requires": ["component:suzgec", "component:liste"] },
    "query:tersKayit": { "since": 1, "label": "Hareketi ters kayıtla düzelt", "requires": ["component:liste", "component:tersKayitDugmesi"] }
  },
  "screenViews": [ { "key": "inventory-movement-history", "component": "liste",
                     "fields": { "entryDate": "entryDate", "direction": "direction", "quantity": "displayQuantity",
                                 "warehouse": "warehouseCode", "storageLocation": "storageLocationCode", "tracking": "trackingText",
                                 "description": "description", "unitCostBase": "unitCostBase" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{gecmis.meta.totalCount}}",
                   "hiddenCommands": ["new", "open", "save", "delete", "print"], "slot": "commands" } },

      { "id": "mevcutGostergesi", "type": "metric", "name": "mevcutGostergesi",
        "props": { "title": "Mevcut", "value": "{{stokOzeti.rows[0].balance.quantityOnHand}}", "format": "number",
                   "description": "{{stokOzeti.rows[0].balance.unitCode}}", "icon": "box",
                   "visibleWhen": "suzgec.stockItemId != null", "slot": "indicators" } },
      { "id": "degerGostergesi", "type": "metric", "name": "degerGostergesi",
        "props": { "title": "Stok değeri", "value": "{{stokOzeti.rows[0].balance.valuationAmountBase}}", "format": "money",
                   "description": "{{stokOzeti.rows[0].balance.baseCurrencyCode}}", "icon": "wallet",
                   "visibleWhen": "suzgec.stockItemId != null", "slot": "indicators" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste",
                   "filters": ["stockItemId|select|row|stockItemId|Stok|stokBakiyeleri:balance.stockItemId:balance.name:balance.code|searchable",
                               "warehouseId|select|row|warehouseId|Depo|depolar:id:name:code|searchable"],
                   "slot": "filters" } },
      { "id": "secimIpucu", "type": "alert", "name": "secimIpucu",
        "props": { "title": "Stok seçin", "variant": "info", "text": "Hareketleri görmek için yukarıdan bir stok seçin.",
                   "visibleWhen": "suzgec.stockItemId == null", "slot": "above" } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Stok hareketleri", "query": "gecmis", "paging": "server", "pageSize": 50,
                   "visibleWhen": "suzgec.stockItemId != null",
                   "columns": ["entryDate", "direction", "isReversal", "displayQuantity", "warehouseCode", "storageLocationCode",
                               "trackingText", "description"],
                   "columnLabels": ["entryDate=Tarih", "direction=Yön", "isReversal=Ters kayıt", "displayQuantity=Miktar",
                                    "warehouseCode=Depo", "storageLocationCode=Konum", "trackingText=Lot / seri",
                                    "description=Açıklama", "unitCostBase=Birim maliyet"],
                   "columnUnits": ["displayQuantity=displayUnitCode", "warehouseCode=warehouseName",
                                   "storageLocationCode=storageLocationName"],
                   "columnFormats": ["entryDate=date", "direction=status", "isReversal=status", "displayQuantity=number",
                                     "unitCostBase=number"],
                   "valueLabels": ["direction:Receipt=Giriş", "direction:Issue=Çıkış", "isReversal:true=İade", "isReversal:false=—"],
                   "toneMap": ["Giriş=success", "Çıkış=info"],
                   "rowActions": ["tersKayitDugmesi"],
                   "emptyText": "Seçili stok ve depoda hareket bulunmuyor.", "slot": "list" } },
      { "id": "tersKayitDugmesi", "type": "button", "name": "tersKayitDugmesi",
        "props": { "text": "Ters kayıt", "actionType": "query", "queryId": "tersKayit",
                   "promptLabel": "Ters kayıt gerekçesi", "promptRequired": true,
                   "disabledWhen": "liste.seciliSatir.hasReversal == true || liste.seciliSatir.isReversal == true",
                   "disabledReason": "Bu hareket zaten ters kayıtla düzeltilmiş ya da kendisi bir ters kayıt.",
                   "successMessage": "Ters kayıt oluşturuldu; önceki hareket korundu.",
                   "refreshQueries": ["gecmis", "stokOzeti"], "slot": "rowActions" } }
    ],
    "queries": [
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "runOn": "load", "parameters": [] },
      { "id": "stokBakiyeleri", "name": "stokBakiyeleri", "kind": "read", "operation": "stok.bakiye.sayfa", "runOn": "load", "parameters": [] },
      { "id": "stokOzeti", "name": "stokOzeti", "kind": "read", "operation": "stok.bakiye.kart", "runOn": "load",
        "parameters": [
          { "name": "stockItemId", "binding": "{{suzgec.stockItemId}}", "type": "guid" },
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" } ] },
      { "id": "gecmis", "name": "gecmis", "kind": "read", "operation": "stok.hareket.gecmisi", "runOn": "load",
        "parameters": [
          { "name": "stockItemId", "binding": "{{suzgec.stockItemId}}", "type": "guid" },
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "tersKayit", "name": "tersKayit", "kind": "insert", "operation": "stok.hareket.tersKayit", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{liste.seciliSatir.warehouseId}}", "type": "guid" },
          { "name": "stockItemId", "binding": "{{suzgec.stockItemId}}", "type": "guid" },
          { "name": "entryId", "binding": "{{liste.seciliSatir.id}}", "type": "guid" },
          { "name": "reason", "binding": "{{tersKayitDugmesi.yanit}}", "type": "text" } ] }
    ],
    "template": { "name": "list" }
  }
}
