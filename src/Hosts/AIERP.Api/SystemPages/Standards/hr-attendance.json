{
  "screenKey": "hr-attendance", "title": "Puantaj",
  "description": "Günlük çalışma ve fazla mesai sürelerini dakika olarak kaydedin, düzeltin ve onaylayın.", "module": "İnsan Kaynakları",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:liste", "component:kayitDugmesi", "component:duzeltDugmesi", "component:onaylaDugmesi", "component:eskiEkranDugmesi", "query:puantajlar"]},
    "component:kayitDugmesi": {"since": 1, "label": "Puantaj kaydı komutu", "requires": ["component:kayitPenceresi"]},
    "component:duzeltDugmesi": {"since": 1, "label": "Düzelt komutu", "requires": ["component:liste", "component:duzeltPenceresi"]},
    "component:onaylaDugmesi": {"since": 1, "label": "Onayla", "requires": ["component:liste", "query:onayla", "query:puantajlar"]},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Eski ekranda aç"},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeç seçimleri kartı", "requires": ["component:baslangicSecimi", "component:bitisSecimi", "component:personelSecimi", "component:onaySecimi"]},
    "component:baslangicSecimi": {"since": 1, "label": "Başlangıç (ayın 1'i)"},
    "component:bitisSecimi": {"since": 1, "label": "Bitiş (bugün)"},
    "component:personelSecimi": {"since": 1, "label": "Personel süzgeci", "requires": ["query:suzgecPersonelleri"]},
    "component:onaySecimi": {"since": 1, "label": "Onay durumu seçimi"},
    "component:secimCipleri": {"since": 1, "label": "Etkin süzgeç çipleri", "requires": ["component:baslangicSecimi", "component:bitisSecimi", "component:personelSecimi", "component:onaySecimi"]},
    "component:liste": {"since": 1, "label": "Puantaj listesi", "requires": ["component:duzeltDugmesi", "query:puantajlar"]},
    "component:kayitPenceresi": {"since": 1, "label": "Puantaj kaydı penceresi", "requires": ["component:kayitBilgileri", "component:kayitNotu", "component:personelSayfaBoyutu", "query:kaydet", "query:puantajlar"]},
    "component:kayitBilgileri": {"since": 1, "label": "Puantaj kaydı alanları", "requires": ["component:kayitPersoneli", "component:kayitGunu", "component:kayitCalisma", "component:kayitMesai", "component:kayitAciklama"]},
    "component:kayitPersoneli": {"since": 1, "label": "Kayıt alanı: Personel", "requires": ["query:kayitPersonelleri"]},
    "component:kayitGunu": {"since": 1, "label": "Kayıt alanı: İş günü"},
    "component:kayitCalisma": {"since": 1, "label": "Kayıt alanı: Çalışılan dakika"},
    "component:kayitMesai": {"since": 1, "label": "Kayıt alanı: Fazla mesai dakika"},
    "component:kayitAciklama": {"since": 1, "label": "Kayıt alanı: Not"},
    "component:kayitNotu": {"since": 1, "label": "Puantaj kaydı bilgi notu"},
    "component:duzeltPenceresi": {"since": 1, "label": "Düzeltme penceresi", "requires": ["component:duzeltUyarisi", "component:duzeltBilgileri", "query:duzelt", "query:kayit", "query:puantajlar"]},
    "component:duzeltUyarisi": {"since": 1, "label": "Düzeltme uyarısı (yeniden onaya düşer)"},
    "component:duzeltBilgileri": {"since": 1, "label": "Düzeltme alanları", "requires": ["component:duzeltGunu", "component:duzeltCalisma", "component:duzeltMesai", "component:duzeltAciklama"]},
    "component:duzeltGunu": {"since": 1, "label": "Düzeltme alanı: İş günü", "requires": ["query:kayit"]},
    "component:duzeltCalisma": {"since": 1, "label": "Düzeltme alanı: Çalışılan dakika", "requires": ["query:kayit"]},
    "component:duzeltMesai": {"since": 1, "label": "Düzeltme alanı: Fazla mesai dakika", "requires": ["query:kayit"]},
    "component:duzeltAciklama": {"since": 1, "label": "Düzeltme alanı: Not", "requires": ["query:kayit"]},
    "component:personelSayfaBoyutu": {"since": 1, "label": "Personel seçici sayfa boyutu (gizli)"},
    "query:puantajlar": {"since": 1, "label": "Puantaj kayıtlarını listele", "requires": ["component:suzgec", "component:baslangicSecimi", "component:bitisSecimi", "component:personelSecimi", "component:onaySecimi", "component:liste"]},
    "query:suzgecPersonelleri": {"since": 1, "label": "Personel süzgeci seçenekleri", "requires": ["component:personelSecimi", "component:personelSayfaBoyutu"]},
    "query:kayitPersonelleri": {"since": 1, "label": "Puantaj kaydı personel seçenekleri", "requires": ["component:kayitPersoneli", "component:personelSayfaBoyutu"]},
    "query:kayit": {"since": 1, "label": "Seçili puantaj kaydı (düzeltme kaynağı)", "requires": ["component:liste"]},
    "query:kaydet": {"since": 1, "label": "Puantaj kaydı oluştur", "requires": ["component:kayitPersoneli", "component:kayitGunu", "component:kayitCalisma", "component:kayitMesai", "component:kayitAciklama"]},
    "query:duzelt": {"since": 1, "label": "Puantaj kaydını düzelt", "requires": ["component:duzeltGunu", "component:duzeltCalisma", "component:duzeltMesai", "component:duzeltAciklama", "query:kayit"]},
    "query:onayla": {"since": 1, "label": "Puantaj kaydını onayla", "requires": ["component:liste"]}
  },
  "screenViews": [ { "key": "hr-attendance", "component": "liste",
                     "fields": { "employee": "employee", "workDate": "workDate", "workedMinutes": "workedMinutes",
                                 "overtimeMinutes": "overtimeMinutes", "note": "note" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{puantajlar.meta.totalCount}}",
                   "newButton": "kayitDugmesi", "openButton": "duzeltDugmesi", "moreButtons": ["onaylaDugmesi", "eskiEkranDugmesi"],
                   "hiddenCommands": ["save", "delete", "print"] } },
      { "id": "kayitDugmesi", "type": "button", "name": "kayitDugmesi",
        "props": { "text": "Puantaj kaydı", "icon": "plus", "actionType": "openDialog", "dialogId": "kayitPenceresi" } },
      { "id": "duzeltDugmesi", "type": "button", "name": "duzeltDugmesi",
        "props": { "text": "Düzelt", "icon": "open", "actionType": "openDialog", "dialogId": "duzeltPenceresi",
                   "visibleWhen": "liste.seciliSatir.id != null" } },
      { "id": "onaylaDugmesi", "type": "button", "name": "onaylaDugmesi",
        "props": { "text": "Onayla", "icon": "check", "actionType": "query", "queryId": "onayla",
                   "visibleWhen": "liste.seciliSatir.approvalStatus == 'PendingApproval'",
                   "disabledWhen": "liste.seciliSatir.canApprove != true", "disabledReason": "Puantajı kaydeden yönetici onaylayamaz; başka bir yönetici onaylamalı",
                   "successMessage": "{{liste.seciliSatir.employee}}: puantaj kaydı onaylandı.", "refreshQueries": ["puantajlar"] } },
      { "id": "eskiEkranDugmesi", "type": "button", "name": "eskiEkranDugmesi",
        "props": { "text": "Eski ekranda aç", "actionType": "erpPage", "pageKey": "hr-attendance", "legacyScreen": true } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 4, "search": true, "searchPlaceholder": "Personel veya not", "searchParam": "q" } },
      { "id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri",
        "props": { "title": "Süzgeçler", "layout": "inline", "width": 8,
                   "inputs": ["baslangicSecimi", "bitisSecimi", "personelSecimi", "onaySecimi"] } },
      { "id": "baslangicSecimi", "type": "input", "name": "baslangicSecimi",
        "props": { "inputType": "date", "label": "Başlangıç", "defaultValue": "{{tarih.ayBasi}}" } },
      { "id": "bitisSecimi", "type": "input", "name": "bitisSecimi",
        "props": { "inputType": "date", "label": "Bitiş", "defaultValue": "{{bugun}}" } },
      { "id": "personelSecimi", "type": "input", "name": "personelSecimi",
        "props": { "inputType": "lookup", "label": "Personel", "optionsQuery": "suzgecPersonelleri", "optionValueColumn": "id",
                   "optionLabelColumn": "fullName", "optionDescriptionColumn": "personnelCode", "minChars": 0, "allowClear": true,
                   "placeholder": "Tümü", "defaultValue": "{{sayfa.parametre.employeeId}}" } },
      { "id": "onaySecimi", "type": "input", "name": "onaySecimi",
        "props": { "inputType": "select", "label": "Onay durumu",
                   "staticOptions": ["=Tümü", "PendingApproval=Onay bekliyor", "Approved=Onaylandı"] } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": { "width": 12, "inputs": ["baslangicSecimi", "bitisSecimi", "personelSecimi", "onaySecimi"] } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Puantaj kayıtları", "query": "puantajlar", "paging": "server", "pageSize": 50, "width": 12,
                   "columns": ["employee", "workDate", "workedMinutes", "overtimeMinutes", "approvalStatus"],
                   "columnLabels": ["employee=Personel", "workDate=İş günü", "workedMinutes=Çalışılan (dk)", "overtimeMinutes=Fazla mesai (dk)",
                                    "note=Not", "approvalStatus=Onay", "approvedAt=Onay zamanı", "createdAt=Kayıt zamanı"],
                   "columnFormats": ["workDate=date", "workedMinutes=number", "overtimeMinutes=number", "approvalStatus=status",
                                     "approvedAt=datetime", "createdAt=datetime"],
                   "valueLabels": ["approvalStatus:PendingApproval=Onay bekliyor", "approvalStatus:Approved=Onaylandı"],
                   "toneMap": ["Onay bekliyor=warning", "Onaylandı=success"],
                   "rowOpenAction": "duzeltDugmesi",
                   "emptyText": "Bu aralıkta puantaj kaydı yok. Yönetici değilseniz yalnız kendi puantajınız görünür." } },

      { "id": "kayitPenceresi", "type": "dialog", "name": "kayitPenceresi",
        "props": { "presentation": "dialog", "size": "lg", "title": "Puantaj kaydı",
                   "contains": ["kayitBilgileri", "kayitNotu"],
                   "saveQuery": "kaydet", "saveLabel": "Kaydet", "closeOnSave": false, "resetOnOpen": true,
                   "refreshQueries": ["puantajlar"] } },
      { "id": "kayitBilgileri", "type": "formCard", "name": "kayitBilgileri",
        "props": { "title": "Puantaj", "columns": 2,
                   "inputs": ["kayitPersoneli", "kayitGunu", "kayitCalisma", "kayitMesai", "kayitAciklama"] } },
      { "id": "kayitPersoneli", "type": "input", "name": "kayitPersoneli",
        "props": { "inputType": "lookup", "label": "Personel", "required": true, "optionsQuery": "kayitPersonelleri", "optionValueColumn": "id",
                   "optionLabelColumn": "fullName", "optionDescriptionColumn": "personnelCode", "minChars": 0, "placeholder": "Personel seçin" } },
      { "id": "kayitGunu", "type": "input", "name": "kayitGunu",
        "props": { "inputType": "date", "label": "İş günü", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "kayitCalisma", "type": "input", "name": "kayitCalisma",
        "props": { "inputType": "number", "label": "Çalışılan dakika", "required": true, "min": 0, "max": 1440, "step": 1, "defaultValue": "480" } },
      { "id": "kayitMesai", "type": "input", "name": "kayitMesai",
        "props": { "inputType": "number", "label": "Fazla mesai dakika", "required": true, "min": 0, "max": 1440, "step": 1, "defaultValue": "0" } },
      { "id": "kayitAciklama", "type": "input", "name": "kayitAciklama",
        "props": { "inputType": "text", "label": "Not", "maxLength": 1000, "placeholder": "İsteğe bağlı" } },
      { "id": "kayitNotu", "type": "text", "name": "kayitNotu",
        "props": { "text": "Çalışılan + fazla mesai en çok 1440 dk. Aynı personele aynı gün ikinci kayıt girilemez. Pencere kayıttan sonra açık kalır; bir sonraki kaydı girin ya da Vazgeç ile kapatın." } },

      { "id": "duzeltPenceresi", "type": "dialog", "name": "duzeltPenceresi",
        "props": { "presentation": "dialog", "size": "lg", "title": "Puantajı düzelt · {{liste.seciliSatir.employee}}",
                   "contains": ["duzeltUyarisi", "duzeltBilgileri"],
                   "saveQuery": "duzelt", "saveLabel": "Düzeltmeyi kaydet", "closeOnSave": true, "resetOnOpen": true,
                   "refreshQueries": ["puantajlar", "kayit"] } },
      { "id": "duzeltUyarisi", "type": "alert", "name": "duzeltUyarisi",
        "props": { "title": "Kayıt yeniden onaya düşer.", "variant": "warning", "width": 12,
                   "text": "Düzeltilen puantaj kaydının onayı kaldırılır; başka bir yöneticinin yeniden onaylaması gerekir." } },
      { "id": "duzeltBilgileri", "type": "formCard", "name": "duzeltBilgileri",
        "props": { "title": "Puantaj", "columns": 2, "inputs": ["duzeltGunu", "duzeltCalisma", "duzeltMesai", "duzeltAciklama"] } },
      { "id": "duzeltGunu", "type": "input", "name": "duzeltGunu",
        "props": { "inputType": "date", "label": "İş günü", "required": true, "defaultValue": "{{kayit.rows[0].workDate}}" } },
      { "id": "duzeltCalisma", "type": "input", "name": "duzeltCalisma",
        "props": { "inputType": "number", "label": "Çalışılan dakika", "required": true, "min": 0, "max": 1440, "step": 1,
                   "defaultValue": "{{kayit.rows[0].workedMinutes}}" } },
      { "id": "duzeltMesai", "type": "input", "name": "duzeltMesai",
        "props": { "inputType": "number", "label": "Fazla mesai dakika", "required": true, "min": 0, "max": 1440, "step": 1,
                   "defaultValue": "{{kayit.rows[0].overtimeMinutes}}" } },
      { "id": "duzeltAciklama", "type": "input", "name": "duzeltAciklama",
        "props": { "inputType": "text", "label": "Not", "maxLength": 1000, "defaultValue": "{{kayit.rows[0].note}}" } },
      { "id": "personelSayfaBoyutu", "type": "input", "name": "personelSayfaBoyutu",
        "props": { "inputType": "number", "label": "Personel seçici sayfa boyutu", "hidden": true, "defaultValue": "50" } }
    ],
    "queries": [
      { "id": "puantajlar", "name": "puantajlar", "kind": "read", "operation": "ik.puantaj.listele", "runOn": "load",
        "parameters": [
          { "name": "from", "binding": "{{baslangicSecimi.value}}", "type": "date" },
          { "name": "to", "binding": "{{bitisSecimi.value}}", "type": "date" },
          { "name": "employeeId", "binding": "{{personelSecimi.value}}", "type": "guid" },
          { "name": "approvalStatus", "binding": "{{onaySecimi.value}}", "type": "text" },
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "suzgecPersonelleri", "name": "suzgecPersonelleri", "kind": "read", "operation": "ik.personel.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{personelSecimi.search}}", "type": "text" },
          { "name": "pageSize", "binding": "{{personelSayfaBoyutu.value}}", "type": "int" } ] },
      { "id": "kayitPersonelleri", "name": "kayitPersonelleri", "kind": "read", "operation": "ik.personel.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{kayitPersoneli.search}}", "type": "text" },
          { "name": "pageSize", "binding": "{{personelSayfaBoyutu.value}}", "type": "int" } ] },
      { "id": "kayit", "name": "kayit", "kind": "read", "operation": "ik.puantaj.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "kaydet", "name": "kaydet", "kind": "insert", "operation": "ik.puantaj.kaydet", "runOn": "manual",
        "parameters": [
          { "name": "employeeId", "binding": "{{kayitPersoneli.value}}", "type": "guid" },
          { "name": "workDate", "binding": "{{kayitGunu.value}}", "type": "date" },
          { "name": "workedMinutes", "binding": "{{kayitCalisma.value}}", "type": "int" },
          { "name": "overtimeMinutes", "binding": "{{kayitMesai.value}}", "type": "int" },
          { "name": "note", "binding": "{{kayitAciklama.value}}", "type": "text" } ] },
      { "id": "duzelt", "name": "duzelt", "kind": "update", "operation": "ik.puantaj.duzelt", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kayit.rows[0].id}}", "type": "guid" },
          { "name": "workDate", "binding": "{{duzeltGunu.value}}", "type": "date" },
          { "name": "workedMinutes", "binding": "{{duzeltCalisma.value}}", "type": "int" },
          { "name": "overtimeMinutes", "binding": "{{duzeltMesai.value}}", "type": "int" },
          { "name": "note", "binding": "{{duzeltAciklama.value}}", "type": "text" } ] },
      { "id": "onayla", "name": "onayla", "kind": "update", "operation": "ik.puantaj.onayla", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" },
          { "name": "rowVersion", "binding": "{{liste.seciliSatir.rowVersion}}", "type": "text" } ] }
    ]
  }
}
