{
  "screenKey": "sales-purchase-receipts", "title": "Mal kabulleri",
  "description": "Tedarikçi siparişlerinden depoya giren mal kabul belgelerini inceleyin.", "module": "Satın Alma",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:siparissizDugmesi", "component:acDugmesi", "component:faturalaDugmesi", "component:iptalMenuDugmesi", "component:faturaAcDugmesi", "component:eskiEkranDugmesi", "query:kabuller"]},
    "component:iptalGostergesi": {"since": 1, "label": "İptal göstergesi (bu sayfa)", "requires": ["query:kabuller"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (bu sayfada arama, durum)", "requires": ["component:liste"]},
    "component:gorunumKarti": {"since": 1, "label": "Detay paneli anahtarı kartı", "requires": ["component:detayPaneli"]},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:liste": {"since": 1, "label": "Mal kabul listesi", "requires": ["component:detayPaneli", "component:acDugmesi", "component:faturalaSatir", "component:iptalSatir", "query:kabuller"]},
    "component:acDugmesi": {"since": 1, "label": "Belgeyi aç komutu", "requires": ["component:belgePenceresi", "component:liste"]},
    "component:faturalaSatir": {"since": 1, "label": "Faturala satır düğmesi", "requires": ["component:liste"]},
    "component:iptalSatir": {"since": 1, "label": "İptal et satır düğmesi", "requires": ["component:liste", "query:kabulIptalSatir", "query:kabuller"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:ozetPaneli", "component:faturaBilgisi", "component:faturasizBilgisi", "component:panelSatirlari", "query:kabul"]},
    "component:ozetPaneli": {"since": 1, "label": "Detay: Özet", "requires": ["component:liste"]},
    "component:faturaBilgisi": {"since": 1, "label": "Detay: Alış faturası", "requires": ["query:kabul"]},
    "component:faturasizBilgisi": {"since": 1, "label": "Detay: Henüz faturalanmadı notu", "requires": ["query:kabul"]},
    "component:panelSatirlari": {"since": 1, "label": "Detay: Satırlar", "requires": ["query:kabulSatirlari"]},
    "component:belgePenceresi": {"since": 1, "label": "Mal kabul belgesi", "requires": ["component:belgeBasligi", "component:belgeAkisi", "component:belgeZinciri", "component:faturaBekliyor", "component:belgeSatirlari"]},
    "component:belgeBasligi": {"since": 1, "label": "Belge: Mal kabul bilgileri", "requires": ["query:kabul"]},
    "component:belgeAkisi": {"since": 1, "label": "Belge: Durum akışı", "requires": ["query:kabul"]},
    "component:belgeZinciri": {"since": 1, "label": "Belge: Belge zinciri", "requires": ["query:kabul"]},
    "component:faturaBekliyor": {"since": 1, "label": "Belge: Fatura bekliyor notu", "requires": ["query:kabul"]},
    "component:belgeSatirlari": {"since": 1, "label": "Belge: Satırlar", "requires": ["query:kabulSatirlari"]},
    "component:siparissizDugmesi": {"since": 1, "label": "Siparişsiz mal kabul komutu (eski ekran)"},
    "component:faturalaDugmesi": {"since": 1, "label": "Faturala komutu", "requires": ["component:liste", "query:kabul"]},
    "component:iptalMenuDugmesi": {"since": 1, "label": "İptal et komutu", "requires": ["component:liste", "query:kabul", "query:kabulIptal", "query:kabuller"]},
    "component:faturaAcDugmesi": {"since": 1, "label": "Alış faturasını aç komutu (eski ekran)", "requires": ["query:kabul"]},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Eski ekranda aç komutu", "requires": ["component:liste"]},
    "query:kabuller": {"since": 1, "label": "Mal kabullerini listele (sayfalı)", "requires": ["component:liste"]},
    "query:kabul": {"since": 1, "label": "Seçili mal kabul", "requires": ["component:liste"]},
    "query:kabulSatirlari": {"since": 1, "label": "Seçili mal kabulün satırları", "requires": ["component:liste"]},
    "query:kabulIptal": {"since": 1, "label": "Mal kabulü iptal et (menü)", "requires": ["component:liste"]},
    "query:kabulIptalSatir": {"since": 1, "label": "Mal kabulü iptal et (satır)", "requires": ["component:liste"]}
  },
  "screenViews": [ { "key": "purchase-receipts", "component": "liste",
                     "fields": { "code": "code", "purchaseOrderCode": "purchaseOrderCode", "receiptDate": "receiptDate",
                                 "warehouseName": "warehouseName", "lineCount": "lineCount", "status": "status" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "newButton": "siparissizDugmesi", "openButton": "acDugmesi", "focusInput": "suzgec", "exportTable": "liste",
                   "titleCount": "{{kabuller.meta.totalCount}}",
                   "moreButtons": ["faturalaDugmesi", "iptalMenuDugmesi", "faturaAcDugmesi", "eskiEkranDugmesi"],
                   "hiddenCommands": ["save", "delete", "print"] } },

      { "id": "iptalGostergesi", "type": "metric", "name": "iptalGostergesi",
        "props": { "title": "İptal", "query": "kabuller", "countWhen": "kabuller.satir.status == 'Voided'", "icon": "ban",
                   "description": "bu sayfa", "width": 3 } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 7, "search": true, "searchPlaceholder": "Bu sayfada ara: mal kabul, sipariş veya depo",
                   "searchColumns": ["code", "purchaseOrderCode", "warehouseName"], "filters": ["status|select|row||Durum"] } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": { "title": "Görünüm", "layout": "inline", "width": 2, "inputs": ["detayPaneli"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Mal kabulleri", "query": "kabuller", "paging": "server", "pageSize": 25, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.id != null",
                   "columns": ["code", "purchaseOrderCode", "receiptDate", "warehouseName", "lineCount", "status"],
                   "columnLabels": ["code=Mal kabul no", "purchaseOrderCode=Tedarikçi siparişi", "receiptDate=Kabul tarihi", "warehouseName=Depo",
                                    "lineCount=Satır", "status=Durum", "createdAt=Oluşturulma"],
                   "columnFormats": ["code=code", "purchaseOrderCode=code", "receiptDate=date", "lineCount=number", "status=status", "createdAt=date"],
                   "valueLabels": ["status:Posted=Kabul edildi", "status:Voided=İptal"],
                   "toneMap": ["Kabul edildi=success", "İptal=info"],
                   "rowActions": ["acDugmesi", "faturalaSatir", "iptalSatir"], "rowOpenAction": "acDugmesi",
                   "emptyText": "Henüz mal kabul yok. Kabul, satın alma siparişi ayrıntısından kaydedilir." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "openDialog", "dialogId": "belgePenceresi",
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "faturalaSatir", "type": "button", "name": "faturalaSatir",
        "props": { "text": "Faturala", "actionType": "page", "pageCode": "@sales-purchase-invoice-entry", "target": "newTab",
                   "params": ["receiptId={{liste.seciliSatir.id}}"], "visibleWhen": "liste.seciliSatir.status == 'Posted'" } },
      { "id": "iptalSatir", "type": "button", "name": "iptalSatir",
        "props": { "text": "İptal et", "actionType": "query", "queryId": "kabulIptalSatir", "confirmEnabled": true,
                   "confirmText": "{{liste.seciliSatir.code}} mal kabulü iptal edilsin mi? Stok girişleri ters hareketle geri alınır; iptal stok bakiyesini negatife düşürmemelidir.",
                   "successMessage": "Mal kabul iptal edildi; stok girişleri ters hareketle geri alındı.",
                   "errorMessage": "Mal kabul iptal edilemedi.", "refreshQueries": ["kabuller", "kabul"],
                   "visibleWhen": "liste.seciliSatir.status == 'Posted'" } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.code}}", "description": "{{kabul.rows[0].supplierName}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayKabul", "type": "badge", "name": "detayKabul",
            "props": { "text": "Kabul edildi", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Posted'" } },
          { "id": "detayIptal", "type": "badge", "name": "detayIptal",
            "props": { "text": "İptal", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Voided'" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetPaneli,faturaBilgisi,faturasizBilgisi", "Satırlar=panelSatirlari"] } },
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Belgeyi aç ›", "actionType": "openDialog", "dialogId": "belgePenceresi" } }
        ] },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["purchaseOrderCode=Sipariş", "warehouseName=Depo", "receiptDate=Kabul tarihi", "lineCount=Satır sayısı"] } },
      { "id": "faturaBilgisi", "type": "text", "name": "faturaBilgisi",
        "props": { "title": "Alış faturası",
                   "text": "{{kabul.rows[0].invoice.code}} · {{kabul.rows[0].invoice.grandTotal}} {{kabul.rows[0].invoice.currencyCode}} · Kalan {{kabul.rows[0].invoice.displayOutstanding}}",
                   "visibleWhen": "kabul.rows[0].invoice.id != null" } },
      { "id": "faturasizBilgisi", "type": "text", "name": "faturasizBilgisi",
        "props": { "title": "Alış faturası", "text": "Henüz faturalanmadı.",
                   "visibleWhen": "kabul.rows[0].id != null && kabul.rows[0].status == 'Posted' && kabul.rows[0].invoice.id == null" } },
      { "id": "panelSatirlari", "type": "dataTable", "name": "panelSatirlari",
        "props": { "title": "Satırlar", "query": "kabulSatirlari", "width": 12, "showGridSearch": false, "showColumnFilters": false,
                   "showColumnChooser": false, "showExport": false, "showPivot": false, "showCsv": false, "showSelectedExport": false,
                   "columns": ["stockName", "quantity"],
                   "columnLabels": ["stockName=Stok", "quantity=Miktar"],
                   "columnUnits": ["stockName=stockCode", "quantity=unitCode"],
                   "columnFormats": ["quantity=number"],
                   "emptyText": "Satır yok." } },

      { "id": "belgePenceresi", "type": "dialog", "name": "belgePenceresi",
        "props": { "presentation": "dialog", "size": "xl", "title": "Mal kabul · {{kabul.rows[0].code}}",
                   "contains": ["belgeBasligi", "belgeAkisi", "belgeZinciri", "faturaBekliyor", "belgeSatirlari"] } },
      { "id": "belgeBasligi", "type": "recordHeader", "name": "belgeBasligi",
        "props": { "icon": "package", "title": "{{kabul.rows[0].code}}", "subtitle": "{{kabul.rows[0].supplierName}}",
                   "fields": ["Sipariş={{kabul.rows[0].purchaseOrderCode}}", "Tedarikçi={{kabul.rows[0].supplierName}}",
                              "Depo={{kabul.rows[0].warehouseName}}", "Kabul tarihi={{kabul.rows[0].receiptDate}}",
                              "Alış faturası={{kabul.rows[0].invoice.code}}", "Fatura tutarı={{kabul.rows[0].invoice.grandTotal}}"],
                   "fieldFormats": ["Kabul tarihi=date", "Fatura tutarı=money"],
                   "fieldUnits": ["Fatura tutarı={{kabul.rows[0].invoice.currencyCode}}"] } },
      { "id": "belgeAkisi", "type": "steps", "name": "belgeAkisi",
        "props": { "steps": ["Kabul edildi", "İptal"],
                   "activeWhen": ["kabul.rows[0].status == 'Posted'", "kabul.rows[0].status == 'Voided'"] } },
      { "id": "belgeZinciri", "type": "text", "name": "belgeZinciri",
        "props": { "title": "Belge zinciri",
                   "text": "Sipariş {{kabul.rows[0].purchaseOrderCode}} → Mal kabul {{kabul.rows[0].code}} → Alış faturası {{kabul.rows[0].invoice.code}}",
                   "visibleWhen": "kabul.rows[0].invoice.id != null" } },
      { "id": "faturaBekliyor", "type": "text", "name": "faturaBekliyor",
        "props": { "title": "Belge zinciri",
                   "text": "Sipariş {{kabul.rows[0].purchaseOrderCode}} → Mal kabul {{kabul.rows[0].code}} → fatura bekliyor",
                   "visibleWhen": "kabul.rows[0].id != null && kabul.rows[0].invoice.id == null" } },
      { "id": "belgeSatirlari", "type": "dataTable", "name": "belgeSatirlari",
        "props": { "title": "Satırlar", "query": "kabulSatirlari", "width": 12, "showPivot": false,
                   "columns": ["orderLineNumber", "stockCode", "stockName", "quantity", "enteredQuantity"],
                   "columnLabels": ["orderLineNumber=Sipariş satırı", "stockCode=Stok kodu", "stockName=Stok adı", "quantity=Kabul miktarı",
                                    "enteredQuantity=Girilen miktar"],
                   "columnUnits": ["quantity=unitCode", "enteredQuantity=enteredUnitCode"],
                   "columnFormats": ["orderLineNumber=number", "stockCode=code", "quantity=number", "enteredQuantity=number"],
                   "emptyText": "Satır yok." } },

      { "id": "siparissizDugmesi", "type": "button", "name": "siparissizDugmesi",
        "props": { "text": "Siparişsiz mal kabul", "actionType": "erpPage", "pageKey": "sales-purchase-receipts", "legacyScreen": true } },
      { "id": "faturalaDugmesi", "type": "button", "name": "faturalaDugmesi",
        "props": { "text": "Faturala", "actionType": "page", "pageCode": "@sales-purchase-invoice-entry", "target": "newTab",
                   "params": ["receiptId={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.status != 'Posted' || kabul.rows[0].invoice.id != null",
                   "disabledReason": "Yalnız kabul edilmiş ve henüz faturalanmamış bir mal kabul faturalanabilir." } },
      { "id": "iptalMenuDugmesi", "type": "button", "name": "iptalMenuDugmesi",
        "props": { "text": "İptal et", "actionType": "query", "queryId": "kabulIptal", "confirmEnabled": true,
                   "confirmText": "{{liste.seciliSatir.code}} mal kabulü iptal edilsin mi? Stok girişleri ters hareketle geri alınır; iptal stok bakiyesini negatife düşürmemelidir.",
                   "successMessage": "Mal kabul iptal edildi; stok girişleri ters hareketle geri alındı.",
                   "errorMessage": "Mal kabul iptal edilemedi.", "refreshQueries": ["kabuller", "kabul"],
                   "visibleWhen": "liste.seciliSatir.status == 'Posted'",
                   "disabledWhen": "kabul.rows[0].invoice.id != null",
                   "disabledReason": "Mal kabul önce bağlı alış faturası iptal edilerek kapatılmalıdır." } },
      { "id": "faturaAcDugmesi", "type": "button", "name": "faturaAcDugmesi",
        "props": { "text": "Alış faturasını aç", "actionType": "erpPage", "pageKey": "sales-purchase-invoices", "legacyScreen": true, "target": "newTab",
                   "params": ["purchaseInvoiceId={{kabul.rows[0].invoice.id}}"], "visibleWhen": "kabul.rows[0].invoice.id != null" } },
      { "id": "eskiEkranDugmesi", "type": "button", "name": "eskiEkranDugmesi",
        "props": { "text": "Eski ekranda aç", "actionType": "erpPage", "pageKey": "sales-purchase-receipts", "legacyScreen": true,
                   "params": ["receiptId={{liste.seciliSatir.id}}"] } }
    ],
    "queries": [
      { "id": "kabuller", "name": "kabuller", "kind": "read", "operation": "satinalma.malKabul.sayfaliListe", "runOn": "load",
        "parameters": [
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "kabul", "name": "kabul", "kind": "read", "operation": "satinalma.malKabul.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "kabulSatirlari", "name": "kabulSatirlari", "kind": "read", "operation": "satinalma.malKabul.satirlari", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "kabulIptal", "name": "kabulIptal", "kind": "update", "operation": "satinalma.malKabul.iptal", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{kabul.rows[0].id}}", "type": "guid" } ] },
      { "id": "kabulIptalSatir", "name": "kabulIptalSatir", "kind": "update", "operation": "satinalma.malKabul.iptal", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] }
    ]
  }
}
