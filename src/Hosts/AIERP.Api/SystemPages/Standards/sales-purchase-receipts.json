{
  "screenKey": "sales-purchase-receipts",
  "title": "Mal kabulleri",
  "description": "Tedarikçi siparişlerinden ve siparişsiz girişlerden depoya alınan mal kabul belgelerini inceleyin.",
  "module": "Satın Alma",
  "version": 4,
  "stage": "preview",
  "items": {
    "component:suzgec": {
      "since": 1,
      "label": "Süzgeç alanı (arama, durum)"
    },
    "component:acDugmesi": {
      "since": 1,
      "label": "Belgeyi aç komutu",
      "requires": [
        "component:belgePenceresi",
        "component:liste"
      ]
    },
    "component:belgePenceresi": {
      "since": 1,
      "label": "Mal kabul penceresi",
      "requires": [
        "component:belgeBasligi",
        "component:belgeDurumu",
        "component:belgeSekmeleri",
        "query:kabul"
      ]
    },
    "component:iptalMenuDugmesi": {
      "since": 1,
      "label": "İptal et komutu",
      "requires": [
        "component:liste",
        "query:kabul",
        "query:kabulIptal",
        "query:kabuller"
      ]
    },
    "component:iptalSatir": {
      "since": 1,
      "label": "İptal et satır düğmesi",
      "requires": [
        "component:liste",
        "query:kabul",
        "query:kabulIptalSatir",
        "query:kabuller"
      ]
    },
    "component:belgeSekmeleri": {
      "since": 1,
      "label": "Pencere: Sekmeler",
      "requires": [
        "component:belgeSatirlari",
        "query:kabulSatirlari"
      ]
    },
    "component:komutlar": {
      "since": 1,
      "label": "İşlem çubuğu",
      "requires": [
        "component:acDugmesi",
        "component:faturaAcDugmesi",
        "component:faturalaDugmesi",
        "component:iptalMenuDugmesi",
        "component:liste",
        "component:suzgec",
        "query:kabuller"
      ]
    },
    "component:iptalGostergesi": {
      "since": 1,
      "label": "İptal göstergesi (bu sayfa)",
      "requires": [
        "query:kabuller"
      ]
    },
    "component:faturalaDugmesi": {
      "since": 1,
      "label": "Faturala komutu",
      "requires": [
        "component:liste",
        "query:kabul"
      ]
    },
    "component:faturaAcDugmesi": {
      "since": 1,
      "label": "Alış faturasını aç komutu (eski ekran)",
      "requires": [
        "query:kabul"
      ]
    },
    "component:belgeSatirlari": {
      "since": 1,
      "label": "Pencere: Satırlar",
      "requires": [
        "query:kabulSatirlari"
      ]
    },
    "component:detayKarti": {
      "since": 1,
      "label": "Detay paneli",
      "requires": [
        "component:liste",
        "query:kabul"
      ]
    },
    "component:faturalaSatir": {
      "since": 1,
      "label": "Faturala satır düğmesi",
      "requires": [
        "component:liste"
      ]
    },
    "component:belgeBasligi": {
      "since": 1,
      "label": "Pencere: Mal kabul bilgileri",
      "requires": [
        "query:kabul"
      ]
    },
    "component:belgeDurumu": {
      "since": 1,
      "label": "Pencere: Durum ve belge zinciri"
    },
    "component:liste": {
      "since": 1,
      "label": "Mal kabulleri listesi",
      "requires": [
        "component:acDugmesi",
        "query:kabuller"
      ]
    },
    "query:kabuller": {
      "since": 1,
      "label": "Mal kabulleri listele (sayfalı)",
      "requires": [
        "component:liste"
      ]
    },
    "query:kabul": {
      "since": 1,
      "label": "Seçili mal kabul",
      "requires": [
        "component:liste"
      ]
    },
    "query:kabulSatirlari": {
      "since": 1,
      "label": "Seçili mal kabulün satırları",
      "requires": [
        "component:liste"
      ]
    },
    "query:kabulIptal": {
      "since": 1,
      "label": "Mal kabulü iptal et (komut)",
      "requires": [
        "query:kabul"
      ]
    },
    "query:kabulIptalSatir": {
      "since": 1,
      "label": "Mal kabulü iptal et (satır)",
      "requires": [
        "component:liste"
      ]
    },
    "component:siparissizDugmesi": {
      "since": 4,
      "label": "Siparişsiz mal kabul komutu",
      "requires": [
        "component:siparissizPencere",
        "component:komutlar"
      ]
    },
    "component:siparissizPencere": {
      "since": 4,
      "label": "Siparişsiz mal kabul penceresi",
      "requires": [
        "component:siparissizBilgileri",
        "component:siparissizKalemleri",
        "component:siparissizIstekKimligi",
        "query:tedarikciSecenekleri",
        "query:depoSecenekleri",
        "query:stokSecenekleri",
        "query:siparissizTaslak",
        "query:siparissizKaydet"
      ]
    },
    "component:siparissizBilgileri": {
      "since": 4,
      "label": "Siparişsiz kabul bilgileri",
      "requires": [
        "component:siparissizTedarikci",
        "component:siparissizDepo",
        "component:siparissizTarih",
        "component:siparissizKod",
        "component:siparissizPencere"
      ]
    },
    "component:siparissizTedarikci": {
      "since": 4,
      "label": "Tedarikçi seçimi",
      "requires": [
        "query:tedarikciSecenekleri",
        "component:siparissizPencere",
        "component:siparissizBilgileri"
      ]
    },
    "component:siparissizDepo": {
      "since": 4,
      "label": "Depo seçimi",
      "requires": [
        "query:depoSecenekleri",
        "component:siparissizPencere",
        "component:siparissizBilgileri"
      ]
    },
    "component:siparissizTarih": {
      "since": 4,
      "label": "Kabul tarihi",
      "requires": [
        "component:siparissizPencere",
        "component:siparissizBilgileri"
      ]
    },
    "component:siparissizKod": {
      "since": 4,
      "label": "Mal kabul numarası",
      "requires": [
        "component:siparissizPencere",
        "component:siparissizBilgileri"
      ]
    },
    "component:siparissizSecenekSayfasi": {
      "since": 4,
      "label": "Siparişsiz kabul seçici sayfası (gizli)",
      "requires": [
        "component:siparissizPencere"
      ]
    },
    "component:siparissizSecenekBoyutu": {
      "since": 4,
      "label": "Siparişsiz kabul seçici sayfa boyutu (gizli)",
      "requires": [
        "component:siparissizPencere"
      ]
    },
    "component:siparissizIstekKimligi": {
      "since": 4,
      "label": " İstek kimliği",
      "requires": [
        "component:siparissizPencere"
      ]
    },
    "component:siparissizKalemleri": {
      "since": 4,
      "label": "Siparişsiz kabul satırları",
      "requires": [
        "query:stokSecenekleri",
        "query:siparissizTaslak",
        "query:siparissizKaydet",
        "component:siparissizPencere"
      ]
    },
    "query:tedarikciSecenekleri": {
      "since": 4,
      "label": "Tedarikçi seçenekleri",
      "requires": [
        "component:siparissizSecenekSayfasi",
        "component:siparissizSecenekBoyutu",
        "component:siparissizPencere"
      ]
    },
    "query:depoSecenekleri": {
      "since": 4,
      "label": "Depo seçenekleri",
      "requires": [
        "component:siparissizPencere"
      ]
    },
    "query:stokSecenekleri": {
      "since": 4,
      "label": "Stok seçenekleri",
      "requires": [
        "component:siparissizSecenekSayfasi",
        "component:siparissizSecenekBoyutu",
        "component:siparissizPencere"
      ]
    },
    "query:siparissizTaslak": {
      "since": 4,
      "label": "Siparişsiz kabul taslağı oluştur",
      "requires": [
        "component:siparissizPencere"
      ]
    },
    "query:siparissizKaydet": {
      "since": 4,
      "label": "Siparişsiz kabulü kaydet",
      "requires": [
        "component:siparissizPencere"
      ]
    }
  },
  "screenViews": [
    {
      "key": "purchase-receipts",
      "component": "liste",
      "fields": {
        "code": "code",
        "purchaseOrderCode": "purchaseOrderCode",
        "receiptDate": "receiptDate",
        "warehouseName": "warehouseName",
        "lineCount": "lineCount",
        "pricedGrandTotal": "pricedGrandTotal",
        "pricingState": "pricingState",
        "status": "status"
      }
    }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "openButton": "acDugmesi",
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{kabuller.meta.totalCount}}",
          "moreButtons": [
            "siparissizDugmesi",
            "faturalaDugmesi",
            "iptalMenuDugmesi",
            "faturaAcDugmesi"
          ],
          "hiddenCommands": [
            "new",
            "save",
            "delete",
            "print"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "acDugmesi",
        "type": "button",
        "name": "acDugmesi",
        "props": {
          "text": "Aç",
          "icon": "open",
          "actionType": "openDialog",
          "dialogId": "belgePenceresi",
          "disabledWhen": "liste.seciliSatir.id == null",
          "disabledReason": "Önce bir kayıt seçin",
          "slot": "rowActions"
        }
      },
      {
        "id": "faturalaSatir",
        "type": "button",
        "name": "faturalaSatir",
        "props": {
          "text": "Faturala",
          "actionType": "page",
          "pageCode": "@purchase-invoice-document",
          "target": "newTab",
          "params": [
            "receiptId={{liste.seciliSatir.id}}"
          ],
          "visibleWhen": "liste.seciliSatir.status == 'Posted'",
          "slot": "rowActions"
        }
      },
      {
        "id": "iptalSatir",
        "type": "button",
        "name": "iptalSatir",
        "props": {
          "text": "İptal et",
          "actionType": "query",
          "queryId": "kabulIptalSatir",
          "confirmEnabled": true,
          "confirmText": "{{liste.seciliSatir.code}} mal kabulü iptal edilsin mi? Stok girişleri ters hareketle geri alınır; iptal stok bakiyesini negatife düşürmemelidir.",
          "successMessage": "Mal kabul iptal edildi; stok girişleri ters hareketle geri alındı.",
          "errorMessage": "Mal kabul iptal edilemedi.",
          "refreshQueries": [
            "kabuller",
            "kabul"
          ],
          "visibleWhen": "liste.seciliSatir.status == 'Posted'",
          "slot": "rowActions"
        }
      },
      {
        "id": "faturalaDugmesi",
        "type": "button",
        "name": "faturalaDugmesi",
        "props": {
          "text": "Faturala",
          "actionType": "page",
          "pageCode": "@purchase-invoice-document",
          "target": "newTab",
          "params": [
            "receiptId={{liste.seciliSatir.id}}"
          ],
          "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.status != 'Posted' || kabul.rows[0].invoice.id != null",
          "disabledReason": "Yalnız kabul edilmiş ve henüz faturalanmamış bir mal kabul faturalanabilir.",
          "slot": "actions"
        }
      },
      {
        "id": "iptalMenuDugmesi",
        "type": "button",
        "name": "iptalMenuDugmesi",
        "props": {
          "text": "İptal et",
          "actionType": "query",
          "queryId": "kabulIptal",
          "confirmEnabled": true,
          "confirmText": "{{liste.seciliSatir.code}} mal kabulü iptal edilsin mi? Stok girişleri ters hareketle geri alınır; iptal stok bakiyesini negatife düşürmemelidir.",
          "successMessage": "Mal kabul iptal edildi; stok girişleri ters hareketle geri alındı.",
          "errorMessage": "Mal kabul iptal edilemedi.",
          "refreshQueries": [
            "kabuller",
            "kabul"
          ],
          "visibleWhen": "liste.seciliSatir.status == 'Posted'",
          "disabledWhen": "kabul.rows[0].invoice.id != null",
          "disabledReason": "Mal kabul önce bağlı alış faturası iptal edilerek kapatılmalıdır.",
          "slot": "actions"
        }
      },
      {
        "id": "faturaAcDugmesi",
        "type": "button",
        "name": "faturaAcDugmesi",
        "props": {
          "text": "Alış faturasını aç",
          "actionType": "erpPage",
          "pageKey": "sales-purchase-invoices",
          "legacyScreen": true,
          "target": "newTab",
          "params": [
            "purchaseInvoiceId={{kabul.rows[0].invoice.id}}"
          ],
          "visibleWhen": "kabul.rows[0].invoice.id != null",
          "slot": "actions"
        }
      },
      {
        "id": "iptalGostergesi",
        "type": "metric",
        "name": "iptalGostergesi",
        "props": {
          "title": "İptal",
          "query": "kabuller",
          "countWhen": "kabuller.satir.status == 'Voided'",
          "icon": "ban",
          "description": "bu sayfa",
          "slot": "indicators"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "search": true,
          "searchPlaceholder": "Bu sayfada ara: mal kabul, sipariş veya depo",
          "searchColumns": [
            "code",
            "purchaseOrderCode",
            "warehouseName"
          ],
          "filters": [
            "status|select|row||Durum"
          ],
          "slot": "filters"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Mal kabulleri",
          "query": "kabuller",
          "paging": "server",
          "pageSize": 25,
          "columns": [
            "code",
            "purchaseOrderCode",
            "receiptDate",
            "warehouseName",
            "lineCount",
            "pricedGrandTotal",
            "pricingState",
            "status"
          ],
          "columnLabels": [
            "code=Mal kabul no",
            "purchaseOrderCode=Tedarikçi siparişi",
            "receiptDate=Kabul tarihi",
            "warehouseName=Depo",
            "lineCount=Satır",
            "pricedGrandTotal=Tutar",
            "pricingState=Fiyat",
            "status=Durum",
            "createdAt=Oluşturulma"
          ],
          "columnFormats": [
            "code=code",
            "purchaseOrderCode=code",
            "receiptDate=date",
            "lineCount=number",
            "pricedGrandTotal=money",
            "pricingState=status",
            "status=status",
            "createdAt=date"
          ],
          "columnUnits": [
            "pricedGrandTotal=currencyCode"
          ],
          "valueLabels": [
            "status:Posted=Kabul edildi",
            "status:Voided=İptal",
            "pricingState:Priced=—",
            "pricingState:PartlyFree=Kısmen bedelsiz",
            "pricingState:Free=Bedelsiz",
            "pricingState:Unpriced=Fiyatsız",
            "pricingState:PartlyUnpriced=Kısmen fiyatsız"
          ],
          "toneMap": [
            "Kabul edildi=success",
            "İptal=info",
            "Bedelsiz=info",
            "Kısmen bedelsiz=info",
            "Fiyatsız=warning",
            "Kısmen fiyatsız=warning"
          ],
          "rowOpenAction": "acDugmesi",
          "emptyText": "Henüz mal kabul yok. Kabul, satın alma siparişi ayrıntısından kaydedilir.",
          "slot": "list"
        }
      },
      {
        "id": "detayKarti",
        "type": "card",
        "name": "detayKarti",
        "props": {
          "variant": "panel",
          "title": "{{liste.seciliSatir.code}}",
          "description": "{{kabul.rows[0].supplierName}}",
          "slot": "detail"
        },
        "children": [
          {
            "id": "detayKabul",
            "type": "badge",
            "name": "detayKabul",
            "props": {
              "text": "Kabul edildi",
              "variant": "success",
              "visibleWhen": "liste.seciliSatir.status == 'Posted'"
            }
          },
          {
            "id": "detayIptal",
            "type": "badge",
            "name": "detayIptal",
            "props": {
              "text": "İptal",
              "variant": "info",
              "visibleWhen": "liste.seciliSatir.status == 'Voided'"
            }
          },
          {
            "id": "ozetPaneli",
            "type": "contextPanel",
            "name": "ozetPaneli",
            "props": {
              "table": "liste",
              "fields": [
                "purchaseOrderCode=Sipariş",
                "warehouseName=Depo",
                "receiptDate=Kabul tarihi",
                "lineCount=Satır sayısı"
              ]
            }
          },
          {
            "id": "faturaBilgisi",
            "type": "text",
            "name": "faturaBilgisi",
            "props": {
              "title": "Alış faturası",
              "text": "{{kabul.rows[0].invoice.code}} · {{kabul.rows[0].invoice.grandTotal}} {{kabul.rows[0].invoice.currencyCode}} · Kalan {{kabul.rows[0].invoice.displayOutstanding}}",
              "visibleWhen": "kabul.rows[0].invoice.id != null"
            }
          },
          {
            "id": "faturasizBilgisi",
            "type": "text",
            "name": "faturasizBilgisi",
            "props": {
              "title": "Alış faturası",
              "text": "Henüz faturalanmadı.",
              "visibleWhen": "kabul.rows[0].id != null && kabul.rows[0].status == 'Posted' && kabul.rows[0].invoice.id == null"
            }
          },
          {
            "id": "detayAc",
            "type": "button",
            "name": "detayAc",
            "props": {
              "text": "Belgeyi aç ›",
              "actionType": "openDialog",
              "dialogId": "belgePenceresi"
            }
          }
        ]
      },
      {
        "id": "belgePenceresi",
        "type": "dialog",
        "name": "belgePenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Mal kabul · {{kabul.rows[0].code}}",
          "contains": [
            "belgeBasligi",
            "belgeDurumu",
            "belgeSekmeleri"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "belgeBasligi",
        "type": "recordHeader",
        "name": "belgeBasligi",
        "props": {
          "icon": "package",
          "title": "{{kabul.rows[0].code}}",
          "subtitle": "{{kabul.rows[0].supplierName}}",
          "fields": [
            "Sipariş={{kabul.rows[0].purchaseOrderCode}}",
            "Tedarikçi={{kabul.rows[0].supplierName}}",
            "Depo={{kabul.rows[0].warehouseName}}",
            "Kabul tarihi={{kabul.rows[0].receiptDate}}",
            "Alış faturası={{kabul.rows[0].invoice.code}}",
            "Fatura tutarı={{kabul.rows[0].invoice.grandTotal}}"
          ],
          "fieldFormats": [
            "Kabul tarihi=date",
            "Fatura tutarı=money"
          ],
          "fieldUnits": [
            "Fatura tutarı={{kabul.rows[0].invoice.currencyCode}}"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "belgeDurumu",
        "type": "section",
        "name": "belgeDurumu",
        "props": {
          "slot": "dialog"
        },
        "children": [
          {
            "id": "belgeKabulRozeti",
            "type": "badge",
            "name": "belgeKabulRozeti",
            "props": {
              "text": "Kabul edildi",
              "variant": "success",
              "visibleWhen": "kabul.rows[0].status == 'Posted'"
            }
          },
          {
            "id": "belgeIptalRozeti",
            "type": "badge",
            "name": "belgeIptalRozeti",
            "props": {
              "text": "İptal",
              "variant": "info",
              "visibleWhen": "kabul.rows[0].status == 'Voided'"
            }
          },
          {
            "id": "belgeZinciri",
            "type": "text",
            "name": "belgeZinciri",
            "props": {
              "title": "Belge zinciri",
              "text": "Sipariş {{kabul.rows[0].purchaseOrderCode}} → Mal kabul {{kabul.rows[0].code}} → Alış faturası {{kabul.rows[0].invoice.code}}",
              "visibleWhen": "kabul.rows[0].invoice.id != null"
            }
          },
          {
            "id": "faturaBekliyor",
            "type": "text",
            "name": "faturaBekliyor",
            "props": {
              "title": "Belge zinciri",
              "text": "Sipariş {{kabul.rows[0].purchaseOrderCode}} → Mal kabul {{kabul.rows[0].code}} → fatura bekliyor",
              "visibleWhen": "kabul.rows[0].id != null && kabul.rows[0].invoice.id == null"
            }
          }
        ]
      },
      {
        "id": "belgeSekmeleri",
        "type": "tabs",
        "name": "belgeSekmeleri",
        "props": {
          "tabs": [
            "Satırlar {{kabulSatirlari.satirSayisi}}=belgeSatirlari"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "belgeSatirlari",
        "type": "dataTable",
        "name": "belgeSatirlari",
        "props": {
          "title": "Satırlar",
          "query": "kabulSatirlari",
          "showPivot": false,
          "columns": [
            "orderLineNumber",
            "stockCode",
            "stockName",
            "quantity",
            "enteredQuantity",
            "isFreeOfCharge",
            "unitPrice",
            "discountPercent",
            "vatPercent",
            "lineNetAmount",
            "costPending"
          ],
          "columnLabels": [
            "orderLineNumber=Sipariş satırı",
            "stockCode=Stok kodu",
            "stockName=Stok adı",
            "quantity=Kabul miktarı",
            "enteredQuantity=Girilen miktar",
