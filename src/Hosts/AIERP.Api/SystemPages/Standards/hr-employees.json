{
  "screenKey": "hr-employees", "title": "Personel",
  "description": "Personel kayıtlarını kod, ad, departman ve duruma göre arayın; kartı ayrı sekmede açın.", "module": "İnsan Kaynakları",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:yeniDugmesi", "component:acDugmesi", "component:eskiEkranDugmesi", "query:personeller"]},
    "component:yeniDugmesi": {"since": 1, "label": "Yeni personel (yalnız yönetici)"},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Eski ekranda aç"},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeç seçimleri kartı", "requires": ["component:durumSecimi", "component:departmanSecimi"]},
    "component:durumSecimi": {"since": 1, "label": "Durum seçimi"},
    "component:departmanSecimi": {"since": 1, "label": "Departman süzgeci"},
    "component:gorunumKarti": {"since": 1, "label": "Detay paneli anahtarı kartı", "requires": ["component:detayPaneli"]},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:secimCipleri": {"since": 1, "label": "Etkin süzgeç çipleri", "requires": ["component:durumSecimi", "component:departmanSecimi"]},
    "component:liste": {"since": 1, "label": "Personel listesi", "requires": ["component:detayPaneli", "component:acDugmesi", "query:personeller"]},
    "component:acDugmesi": {"since": 1, "label": "Satırı aç (personel kartı)", "requires": ["component:liste"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:ozetPaneli", "component:izinBaglantisi", "component:puantajBaglantisi"]},
    "component:ozetPaneli": {"since": 1, "label": "Detay: Özet", "requires": ["component:liste"]},
    "component:izinBaglantisi": {"since": 1, "label": "Detay: İzin talepleri bağlantısı", "requires": ["component:liste"]},
    "component:puantajBaglantisi": {"since": 1, "label": "Detay: Puantaj bağlantısı", "requires": ["component:liste"]},
    "component:bosSecim": {"since": 1, "label": "Detay paneli: seçim yok notu", "requires": ["component:detayPaneli", "component:liste"]},
    "query:personeller": {"since": 1, "label": "Personeli listele", "requires": ["component:suzgec", "component:durumSecimi", "component:departmanSecimi", "component:liste"]}
  },
  "screenViews": [ { "key": "hr-employees", "component": "liste",
                     "fields": { "personnelCode": "personnelCode", "fullName": "fullName", "department": "department",
                                 "jobTitle": "jobTitle", "status": "status" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{personeller.meta.totalCount}}",
                   "newButton": "yeniDugmesi", "openButton": "acDugmesi", "moreButtons": ["eskiEkranDugmesi"],
                   "hiddenCommands": ["save", "delete", "print"] } },
      { "id": "yeniDugmesi", "type": "button", "name": "yeniDugmesi",
        "props": { "text": "Yeni personel", "icon": "plus", "actionType": "page", "pageCode": "@hr-employee-create", "target": "newTab",
                   "disabledWhen": "kullanici.rol != 'TenantAdmin'", "disabledReason": "Personel kaydını yalnız firma yöneticisi ekleyebilir." } },
      { "id": "eskiEkranDugmesi", "type": "button", "name": "eskiEkranDugmesi",
        "props": { "text": "Eski ekranda aç", "actionType": "erpPage", "pageKey": "hr-employees", "legacyScreen": true } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 6, "search": true, "searchPlaceholder": "Kod, ad, departman veya görev", "searchParam": "q" } },
      { "id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri",
        "props": { "title": "Süzgeçler", "layout": "inline", "width": 4, "inputs": ["durumSecimi", "departmanSecimi"] } },
      { "id": "durumSecimi", "type": "input", "name": "durumSecimi",
        "props": { "inputType": "select", "label": "Durum", "staticOptions": ["=Tümü", "Active=Aktif", "Terminated=Ayrıldı"] } },
      { "id": "departmanSecimi", "type": "input", "name": "departmanSecimi",
        "props": { "inputType": "text", "label": "Departman", "maxLength": 120, "placeholder": "Tümü" } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": { "title": "Görünüm", "layout": "inline", "width": 2, "inputs": ["detayPaneli"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": { "width": 12, "inputs": ["durumSecimi", "departmanSecimi"] } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Personel", "query": "personeller", "paging": "server", "pageSize": 50, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true",
                   "columns": ["personnelCode", "fullName", "department", "jobTitle", "employmentCategory", "status"],
                   "columnLabels": ["personnelCode=Personel kodu", "fullName=Ad soyad", "department=Departman", "jobTitle=Görev",
                                    "employmentCategory=Kategori", "status=Durum", "hireDate=İşe giriş", "terminationDate=İşten çıkış",
                                    "workEmail=İş e-postası"],
                   "columnFormats": ["personnelCode=code", "status=status", "hireDate=date", "terminationDate=date"],
                   "valueLabels": ["status:Active=Aktif", "status:Terminated=Ayrıldı"],
                   "toneMap": ["Aktif=success", "Ayrıldı=info"],
                   "rowOpenAction": "acDugmesi",
                   "emptyText": "Kullanıcınıza bağlı personel kaydı yok ya da bu aramayla eşleşen personel bulunamadı." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@hr-employee-create", "target": "newTab",
                   "params": ["employeeId={{liste.seciliSatir.id}}"], "visibleWhen": "liste.seciliSatir.id != null" } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.fullName}}", "description": "{{liste.seciliSatir.personnelCode}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@hr-employee-create", "target": "newTab",
                       "params": ["employeeId={{liste.seciliSatir.id}}"] } },
          { "id": "detayAktif", "type": "badge", "name": "detayAktif",
            "props": { "text": "Aktif", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Active'" } },
          { "id": "detayAyrildi", "type": "badge", "name": "detayAyrildi",
            "props": { "text": "Ayrıldı", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Terminated'" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetPaneli,izinBaglantisi,puantajBaglantisi"] } }
        ] },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["personnelCode=Personel kodu", "fullName=Ad soyad", "status=Durum", "department=Departman", "jobTitle=Görev",
                              "employmentCategory=Kategori", "hireDate=İşe giriş", "terminationDate=İşten çıkış", "workEmail=İş e-postası"] } },
      { "id": "izinBaglantisi", "type": "button", "name": "izinBaglantisi",
        "props": { "text": "İzin talepleri ›", "actionType": "erpPage", "pageKey": "hr-leave-requests", "target": "newTab",
                   "params": ["employeeId={{liste.seciliSatir.id}}"] } },
      { "id": "puantajBaglantisi", "type": "button", "name": "puantajBaglantisi",
        "props": { "text": "Puantaj ›", "actionType": "erpPage", "pageKey": "hr-attendance", "target": "newTab",
                   "params": ["employeeId={{liste.seciliSatir.id}}"] } },
      { "id": "bosSecim", "type": "text", "name": "bosSecim",
        "props": { "text": "Özetini görmek için listeden bir personel seçin.", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id == null" } }
    ],
    "queries": [
      { "id": "personeller", "name": "personeller", "kind": "read", "operation": "ik.personel.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "status", "binding": "{{durumSecimi.value}}", "type": "text" },
          { "name": "department", "binding": "{{departmanSecimi.value}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] }
    ]
  }
}
