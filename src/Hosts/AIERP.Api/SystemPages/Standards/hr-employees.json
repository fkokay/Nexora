{
  "screenKey": "hr-employees", "title": "Personel",
  "description": "Personel kayıtlarını kod, ad, departman ve duruma göre arayın; kartı ayrı sekmede açın.", "module": "İnsan Kaynakları",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:yeniDugmesi", "component:acDugmesi", "query:personeller"]},
    "component:yeniDugmesi": {"since": 1, "label": "Yeni personel (yalnız yönetici)"},
    "component:acDugmesi": {"since": 1, "label": "Satırı aç (personel kartı)", "requires": ["component:liste"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama, durum, departman)", "requires": ["component:liste"]},
    "component:liste": {"since": 1, "label": "Personel listesi", "requires": ["component:acDugmesi", "query:personeller"]},
    "component:detayKarti": {"since": 1, "label": "Detay: kimlik özeti ve bağlantılar", "requires": ["component:liste"]},
    "query:personeller": {"since": 1, "label": "Personeli listele", "requires": ["component:suzgec", "component:liste"]}
  },
  "screenViews": [ { "key": "hr-employees", "component": "liste",
                     "fields": { "personnelCode": "personnelCode", "fullName": "fullName", "department": "department",
                                 "jobTitle": "jobTitle", "status": "status" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{personeller.meta.totalCount}}",
                   "newButton": "yeniDugmesi", "openButton": "acDugmesi",
                   "hiddenCommands": ["save", "delete", "print"], "slot": "commands" } },
      { "id": "yeniDugmesi", "type": "button", "name": "yeniDugmesi",
        "props": { "text": "Yeni personel", "icon": "plus", "actionType": "page", "pageCode": "@hr-employee-create", "target": "newTab",
                   "disabledWhen": "kullanici.rol != 'TenantAdmin'", "disabledReason": "Personel kaydını yalnız firma yöneticisi ekleyebilir.",
                   "slot": "actions" } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@hr-employee-create", "target": "newTab",
                   "params": ["employeeId={{liste.seciliSatir.id}}"], "disabledWhen": "liste.seciliSatir.id == null",
                   "disabledReason": "Önce bir kayıt seçin", "slot": "rowActions" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "search": true, "searchPlaceholder": "Kod, ad, departman veya görev", "searchParam": "q",
                   "filters": ["status|select|row|status|Durum", "department|text|row|department|Departman"], "slot": "filters" } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Personel", "query": "personeller", "paging": "server", "pageSize": 50,
                   "columns": ["personnelCode", "fullName", "department", "jobTitle", "employmentCategory", "status"],
                   "columnLabels": ["personnelCode=Personel kodu", "fullName=Ad soyad", "department=Departman", "jobTitle=Görev",
                                    "employmentCategory=Kategori", "status=Durum", "hireDate=İşe giriş", "terminationDate=İşten çıkış",
                                    "workEmail=İş e-postası"],
                   "columnFormats": ["personnelCode=code", "status=status", "hireDate=date", "terminationDate=date"],
                   "valueLabels": ["status:Active=Aktif", "status:Terminated=Ayrıldı"],
                   "toneMap": ["Aktif=success", "Ayrıldı=info"],
                   "rowOpenAction": "acDugmesi",
                   "emptyText": "Kullanıcınıza bağlı personel kaydı yok ya da bu aramayla eşleşen personel bulunamadı.", "slot": "list" } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.fullName}}", "description": "{{liste.seciliSatir.personnelCode}}", "slot": "detail" },
        "children": [
          { "id": "detayAktif", "type": "badge", "name": "detayAktif",
            "props": { "text": "Aktif", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Active'" } },
          { "id": "detayAyrildi", "type": "badge", "name": "detayAyrildi",
            "props": { "text": "Ayrıldı", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Terminated'" } },
          { "id": "detayBos", "type": "text", "name": "detayBos",
            "props": { "text": "Bir personel seçin; özetini burada görün.", "visibleWhen": "liste.seciliSatir.id == null" } },
          { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
            "props": { "table": "liste", "visibleWhen": "liste.seciliSatir.id != null",
                       "fields": ["personnelCode=Personel kodu", "fullName=Ad soyad", "status=Durum", "department=Departman", "jobTitle=Görev",
                                  "employmentCategory=Kategori", "hireDate=İşe giriş", "terminationDate=İşten çıkış", "workEmail=İş e-postası"] } },
          { "id": "izinBaglantisi", "type": "button", "name": "izinBaglantisi",
            "props": { "text": "İzin talepleri ›", "actionType": "erpPage", "pageKey": "hr-leave-requests", "target": "newTab",
                       "params": ["employeeId={{liste.seciliSatir.id}}"], "visibleWhen": "liste.seciliSatir.id != null" } },
          { "id": "puantajBaglantisi", "type": "button", "name": "puantajBaglantisi",
            "props": { "text": "Puantaj ›", "actionType": "erpPage", "pageKey": "hr-attendance", "target": "newTab",
                       "params": ["employeeId={{liste.seciliSatir.id}}"], "visibleWhen": "liste.seciliSatir.id != null" } }
        ] }
    ],
    "queries": [
      { "id": "personeller", "name": "personeller", "kind": "read", "operation": "ik.personel.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "status", "binding": "{{suzgec.status}}", "type": "text" },
          { "name": "department", "binding": "{{suzgec.department}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] }
    ],
    "template": { "name": "list" }
  }
}
