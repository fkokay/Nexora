        "component:eSonOdemeTarihi",
        "component:eTasiyiciAdi",
        "component:eTasiyiciSoyadi",
        "component:eTasiyiciVkn",
        "component:eTurKodu",
        "component:faturaNotu",
        "component:faturaTarihi",
        "component:faturaTuru",
