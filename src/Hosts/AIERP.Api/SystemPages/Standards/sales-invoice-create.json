      "label": "Vergi mevzuatı profilleri"
    },
    "query:ozelTanimlar": {
      "since": 1,
      "label": "Fatura özel alan tanımları"
    },
    "query:onizleme": {
      "since": 1,
      "label": "Fatura önizlemesi (satır tutarları ve toplamlar)",
      "requires": [
        "component:faturaTarihi",
        "component:faturaTuru",
        "component:kalemler",
        "component:musteri",
        "component:vergiProfili"
      ]
    },
    "query:vergiler": {
