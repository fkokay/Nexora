        "component:eAraciIlce",
        "component:eAraciUlke",
        "component:eAraciUlkeKodu",
        "component:eOdemeAracisi",
        "component:eOdemeEtiketi",
        "component:eOdemeNotu",
        "component:eOdemeTarihi",
