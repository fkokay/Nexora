{
  "screenKey": "sales-purchase-delivery-notes",
  "title": "Satınalma İrsaliyeleri",
  "description": "Tedarikçi belge numarası ve sipariş miktarlarını kaydedin; mal kabul öncesi veya sonrasında bağlantı kurun.",
  "module": "Satın Alma",
  "version": 3,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "İşlem çubuğu",
      "requires": [
        "component:liste",
        "component:suzgec",
        "component:yeniIrsaliyeDugmesi",
        "query:irsaliyeler"
      ]
    },
    "component:baglantisizGostergesi": {
      "since": 1,
      "label": "Bağlantısı yok göstergesi",
      "requires": [
        "query:irsaliyeler"
      ]
    },
    "component:suzgec": {
      "since": 1,
      "label": "Süzgeç alanı (arama)"
    },
    "component:liste": {
      "since": 1,
      "label": "İrsaliye listesi",
      "requires": [
        "component:acDugmesi",
        "component:baglantiDugmesi",
        "component:baglantiKaldirDugmesi",
        "component:malKabuluAcDugmesi",
        "component:siparisiAcDugmesi",
        "query:irsaliyeler"
      ]
    },
    "component:acDugmesi": {
      "since": 1,
      "label": "İrsaliye belgesini aç",
      "requires": [
        "component:irsaliyeDetayPenceresi",
        "component:liste"
      ]
    },
    "component:yeniIrsaliyeDugmesi": {
      "since": 1,
      "label": "Yeni irsaliye komutu",
      "requires": [
        "component:yeniIrsaliyePenceresi"
      ]
    },
    "component:yeniIrsaliyePenceresi": {
      "since": 2,
      "label": "Siparişten irsaliye kaydetme penceresi",
      "requires": [
        "component:irsaliyeBilgileri",
        "component:irsaliyeNotu",
        "component:irsaliyeSatirlari",
        "query:irsaliyeKaynak",
        "query:irsaliyeOlustur",
        "query:irsaliyeler"
      ]
    },
    "component:irsaliyeBilgileri": {
      "since": 2,
      "label": "İrsaliye bilgileri",
      "requires": [
        "component:belgeNo",
        "component:belgeTarihi",
        "component:irsaliyeKabulu",
        "component:irsaliyeSiparisi"
      ]
    },
    "component:irsaliyeSiparisi": {
      "since": 2,
      "label": "İrsaliye alanı: Satın alma siparişi",
      "requires": [
        "query:siparisler"
      ]
    },
    "component:belgeNo": {
      "since": 2,
      "label": "İrsaliye alanı: Tedarikçi irsaliye no"
    },
    "component:belgeTarihi": {
      "since": 2,
      "label": "İrsaliye alanı: Belge tarihi"
    },
    "component:irsaliyeKabulu": {
      "since": 2,
      "label": "İrsaliye alanı: Mal kabul (isteğe bağlı)",
      "requires": [
        "component:irsaliyeSiparisi",
        "query:irsaliyeKabulleri"
      ]
    },
    "component:irsaliyeSatirlari": {
      "since": 2,
      "label": "İrsaliye satırları (siparişin kalan miktarları)",
      "requires": [
        "query:irsaliyeKaynak"
      ]
    },
    "component:irsaliyeNotu": {
      "since": 2,
      "label": "İrsaliye satırları notu",
      "requires": [
        "component:irsaliyeSatirlari"
      ]
    },
    "component:baglantiDugmesi": {
      "since": 1,
      "label": "Mal kabul bağla komutu",
      "requires": [
        "component:baglaPenceresi",
        "component:liste"
      ]
    },
    "component:baglaPenceresi": {
      "since": 2,
      "label": "Mal kabul bağlama penceresi",
      "requires": [
        "component:baglaKabulu",
        "component:baglaNotu",
        "component:liste",
        "query:bagla",
        "query:irsaliyeler"
      ]
    },
    "component:baglaKabulu": {
      "since": 2,
      "label": "Bağlama alanı: Mal kabul",
      "requires": [
        "query:baglaKabulleri"
      ]
    },
    "component:baglaNotu": {
      "since": 2,
      "label": "Bağlama notu",
      "requires": [
        "component:liste"
      ]
    },
    "component:baglantiKaldirDugmesi": {
      "since": 2,
      "label": "Mal kabul bağlantısını kaldır komutu",
      "requires": [
        "component:liste",
        "query:baglantiKaldir",
        "query:irsaliyeler"
      ]
    },
    "component:siparisiAcDugmesi": {
      "since": 1,
      "label": "Siparişi aç komutu",
      "requires": [
        "component:liste"
      ]
    },
    "component:malKabuluAcDugmesi": {
      "since": 1,
      "label": "Mal kabulü aç komutu (eski ekran)",
      "requires": [
        "component:liste"
      ]
    },
    "query:irsaliyeler": {
      "since": 1,
      "label": "Tedarikçi irsaliyelerini listele",
      "requires": [
        "component:liste",
        "component:suzgec"
      ]
    },
    "query:irsaliye": {
      "since": 1,
      "label": "Açık irsaliye belgesi",
      "requires": [
        "component:liste"
      ]
    },
    "query:satirlar": {
      "since": 1,
      "label": "İrsaliye satırları",
      "requires": [
        "component:liste"
      ]
    },
    "query:siparisler": {
      "since": 2,
      "label": "Satın alma siparişleri (irsaliye siparişi seçici)",
      "requires": [
        "component:irsaliyeSiparisi"
      ]
    },
    "query:irsaliyeKaynak": {
      "since": 2,
      "label": "Seçilen siparişin irsaliyelenecek kalan satırları",
      "requires": [
        "component:irsaliyeSiparisi"
      ]
    },
    "query:irsaliyeKabulleri": {
      "since": 2,
      "label": "Seçilen siparişin mal kabulleri",
      "requires": [
        "component:irsaliyeSiparisi"
      ]
    },
    "query:irsaliyeOlustur": {
      "since": 2,
      "label": "Siparişe tedarikçi irsaliyesi kaydet",
      "requires": [
        "component:belgeNo",
        "component:belgeTarihi",
        "component:irsaliyeKabulu",
        "component:irsaliyeSatirlari",
        "component:irsaliyeSiparisi"
      ]
    },
    "query:baglaKabulleri": {
      "since": 2,
      "label": "Seçili irsaliyenin siparişindeki mal kabuller",
      "requires": [
        "component:liste"
      ]
    },
    "query:bagla": {
      "since": 2,
      "label": "İrsaliyeyi mal kabule bağla (liste)",
      "requires": [
        "component:baglaKabulu",
        "component:liste"
      ]
    },
    "query:baglantiKaldir": {
      "since": 2,
      "label": "Mal kabul bağlantısını kaldır (liste)",
      "requires": [
        "component:liste"
      ]
    },
    "component:irsaliyeDetayPenceresi": {
      "since": 3,
      "label": "İrsaliye detay penceresi",
      "requires": [
        "component:irsaliyeDetayBasligi",
        "component:liste",
        "component:satirTablosu"
      ]
    },
    "component:irsaliyeDetayBasligi": {
      "since": 3,
      "label": "İrsaliye belge başlığı",
      "requires": [
        "query:irsaliye"
      ]
    },
    "component:satirTablosu": {
      "since": 1,
      "label": "İrsaliye satırları",
      "requires": [
        "query:satirlar"
      ]
    }
  },
  "screenViews": [
    {
      "key": "purchase-delivery-notes",
      "component": "liste",
      "fields": {
        "documentNumber": "documentNumber",
        "documentDate": "documentDate",
        "purchaseOrderCode": "purchaseOrderCode",
        "supplierName": "supplierName",
        "purchaseReceiptCode": "purchaseReceiptCode",
        "lineCount": "lineCount",
        "pricedGrandTotal": "pricedGrandTotal",
        "pricingState": "pricingState"
      }
    }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "newButton": "yeniIrsaliyeDugmesi",
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{irsaliyeler.meta.totalCount}}",
          "hiddenCommands": [
            "open",
            "save",
            "delete",
            "print"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "baglantisizGostergesi",
        "type": "metric",
        "name": "baglantisizGostergesi",
        "props": {
          "title": "Bağlantısı yok",
          "query": "irsaliyeler",
          "countWhen": "irsaliyeler.satir.purchaseReceiptId == null",
          "variant": "warning",
          "icon": "alert",
          "description": "bu sayfa · mal kabule bağlanmamış",
          "width": 3,
          "slot": "indicators"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "width": 12,
          "search": true,
          "searchPlaceholder": "İrsaliye no, sipariş, tedarikçi veya mal kabul ara",
          "searchParam": "q",
          "slot": "filters"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Gelen irsaliyeler",
          "query": "irsaliyeler",
          "paging": "server",
          "pageSize": 25,
          "columns": [
            "documentNumber",
            "documentDate",
            "purchaseOrderCode",
            "supplierName",
            "purchaseReceiptCode",
            "lineCount",
            "pricedGrandTotal",
            "pricingState"
          ],
          "columnLabels": [
            "documentNumber=Tedarikçi irsaliye no",
            "documentDate=Belge tarihi",
            "purchaseOrderCode=Satın alma siparişi",
            "supplierName=Tedarikçi",
            "lineCount=Satır",
            "pricedGrandTotal=Tutar",
            "pricingState=Fiyat",
            "purchaseReceiptCode=Mal kabul",
            "createdAt=Oluşturulma"
          ],
          "columnFormats": [
            "documentNumber=code",
            "documentDate=date",
            "purchaseOrderCode=code",
            "lineCount=number",
            "pricedGrandTotal=money",
            "pricingState=status",
            "purchaseReceiptCode=code",
            "createdAt=date"
          ],
          "columnUnits": [
            "pricedGrandTotal=currencyCode"
          ],
          "valueLabels": [
            "pricingState:Priced=—",
            "pricingState:PartlyFree=Kısmen bedelsiz",
            "pricingState:Free=Bedelsiz",
            "pricingState:Unpriced=Fiyatsız",
            "pricingState:PartlyUnpriced=Kısmen fiyatsız"
          ],
          "toneMap": [
            "Bedelsiz=info",
            "Kısmen bedelsiz=info",
            "Fiyatsız=warning",
            "Kısmen fiyatsız=warning"
          ],
          "rowOpenAction": "acDugmesi",
          "emptyText": "Aramanızla eşleşen irsaliye bulunamadı.",
          "slot": "list",
          "rowActions": [
            "acDugmesi",
            "siparisiAcDugmesi",
            "malKabuluAcDugmesi",
            "baglantiDugmesi",
            "baglantiKaldirDugmesi"
          ]
        }
      },
      {
        "id": "acDugmesi",
        "type": "button",
        "name": "acDugmesi",
        "props": {
          "text": "Aç",
          "icon": "open",
          "actionType": "openDialog",
          "disabledWhen": "liste.seciliSatir.id == null",
          "disabledReason": "Önce bir kayıt seçin",
          "dialogId": "irsaliyeDetayPenceresi",
          "slot": "rowActions"
        }
      },
      {
        "id": "yeniIrsaliyeDugmesi",
        "type": "button",
        "name": "yeniIrsaliyeDugmesi",
        "props": {
          "text": "Yeni irsaliye",
          "actionType": "openDialog",
          "dialogId": "yeniIrsaliyePenceresi",
          "slot": "actions"
        }
      },
      {
        "id": "baglantiDugmesi",
        "type": "button",
        "name": "baglantiDugmesi",
        "props": {
          "text": "Mal kabul bağla",
          "actionType": "openDialog",
          "dialogId": "baglaPenceresi",
          "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.purchaseReceiptId != null",
          "disabledReason": "Mal kabule bağlanmamış bir irsaliye seçin.",
          "slot": "rowActions"
        }
      },
      {
        "id": "baglantiKaldirDugmesi",
        "type": "button",
        "name": "baglantiKaldirDugmesi",
        "props": {
          "text": "Mal kabul bağlantısını kaldır",
          "actionType": "query",
          "queryId": "baglantiKaldir",
          "confirmEnabled": true,
          "confirmText": "{{liste.seciliSatir.documentNumber}} irsaliyesinin {{liste.seciliSatir.purchaseReceiptCode}} mal kabul bağlantısı kaldırılsın mı? Stok hareketleri değişmez.",
          "successMessage": "Mal kabul bağlantısı kaldırıldı.",
          "refreshQueries": [
            "irsaliyeler"
          ],
          "disabledWhen": "liste.seciliSatir.purchaseReceiptId == null",
          "disabledReason": "Bu irsaliye bir mal kabule bağlı değil.",
          "slot": "rowActions"
        }
      },
      {
        "id": "siparisiAcDugmesi",
        "type": "button",
        "name": "siparisiAcDugmesi",
        "props": {
          "text": "Siparişi aç",
          "actionType": "erpPage",
          "pageKey": "sales-purchasing",
          "params": [
            "purchaseOrderId={{liste.seciliSatir.purchaseOrderId}}"
          ],
          "disabledWhen": "liste.seciliSatir.purchaseOrderId == null",
          "disabledReason": "Önce bir kayıt seçin",
          "slot": "rowActions"
        }
      },
      {
        "id": "malKabuluAcDugmesi",
        "type": "button",
        "name": "malKabuluAcDugmesi",
        "props": {
          "text": "Mal kabulü aç",
          "actionType": "erpPage",
          "pageKey": "sales-purchase-receipts",
          "legacyScreen": true,
          "params": [
            "receiptId={{liste.seciliSatir.purchaseReceiptId}}"
          ],
          "disabledWhen": "liste.seciliSatir.purchaseReceiptId == null",
          "disabledReason": "Bu irsaliye bir mal kabule bağlı değil.",
          "slot": "rowActions"
        }
      },
      {
        "id": "irsaliyeDetayPenceresi",
        "type": "dialog",
        "name": "irsaliyeDetayPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "İrsaliye · {{liste.seciliSatir.documentNumber}}",
          "contains": [
            "irsaliyeDetayBasligi",
            "satirTablosu"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "irsaliyeDetayBasligi",
        "type": "recordHeader",
        "name": "irsaliyeDetayBasligi",
        "props": {
          "icon": "file-text",
          "title": "{{irsaliye.rows[0].documentNumber}}",
          "subtitle": "{{irsaliye.rows[0].supplierName}}",
          "fields": [
            "Sipariş={{irsaliye.rows[0].purchaseOrderCode}}",
            "Tarih={{irsaliye.rows[0].documentDate}}",
            "Mal kabul={{irsaliye.rows[0].purchaseReceiptCode}}",
            "Tutar={{irsaliye.rows[0].pricedGrandTotal}}",
            "Fiyat={{irsaliye.rows[0].pricingState}}"
          ],
          "fieldFormats": [
            "Tarih=date",
            "Tutar=money"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "satirTablosu",
        "type": "dataTable",
        "name": "satirTablosu",
        "props": {
          "title": "Satırlar",
          "query": "satirlar",
          "width": 12,
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showPivot": false,
          "columns": [
            "orderLineNumber",
            "quantity",
            "isFreeOfCharge",
            "unitPrice",
            "discountPercent",
            "vatPercent",
            "lineNetAmount"
          ],
          "columnLabels": [
            "orderLineNumber=Sipariş satırı",
            "quantity=Miktar",
            "isFreeOfCharge=Bedelsiz",
            "unitPrice=Birim fiyat",
            "discountPercent=İsk. %",
            "vatPercent=KDV %",
            "lineNetAmount=Tutar"
          ],
          "columnUnits": [
            "quantity=unitCode"
          ],
          "columnFormats": [
            "orderLineNumber=number",
            "quantity=number",
            "isFreeOfCharge=status",
            "unitPrice=money",
            "discountPercent=number",
            "vatPercent=number",
            "lineNetAmount=money"
          ],
          "valueLabels": [
            "isFreeOfCharge:true=Bedelsiz",
            "isFreeOfCharge:false=—"
          ],
          "toneMap": [
            "Bedelsiz=info"
          ],
          "emptyText": "Satır ayrıntısı bulunamadı.",
          "slot": "dialog"
        }
      },
      {
        "id": "irsaliyeSatirlari",
        "type": "editableGrid",
        "name": "irsaliyeSatirlari",
        "props": {
          "gridMode": "list",
          "title": "İrsaliye satırları",
          "maxRows": 200,
          "minRows": 1,
          "gridColumns": [
            "orderLineNumber|#|number|readOnly",
            "stockCode|Stok kodu|text|readOnly",
            "stockName|Stok adı|text|readOnly",
            "quantity|İrsaliye miktarı|number|min:0,step:0.0001",
            "unitCode|Birim|text|readOnly",
            "unitPrice|Birim fiyat|number|min:0,step:0.0001",
            "discountPercent|İskonto %|number|min:0,max:100,step:0.01",
            "vatPercent|KDV %|number|min:0,max:100,step:0.01"
          ],
          "fillQuery": "irsaliyeKaynak",
          "fillColumns": {
            "quantity": "remainingQuantity"
          },
          "skipWhenZero": "quantity",
          "slot": "dialog"
        }
      },
      {
        "id": "yeniIrsaliyePenceresi",
        "type": "dialog",
        "name": "yeniIrsaliyePenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Siparişten tedarikçi irsaliyesi",
          "contains": [
            "irsaliyeBilgileri",
            "irsaliyeSatirlari",
            "irsaliyeNotu"
          ],
          "saveQuery": "irsaliyeOlustur",
          "saveLabel": "İrsaliyeyi kaydet",
          "closeOnSave": true,
          "resetOnOpen": true,
          "refreshQueries": [
            "irsaliyeler",
            "irsaliyeKaynak"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "irsaliyeBilgileri",
        "type": "formCard",
        "name": "irsaliyeBilgileri",
        "props": {
          "title": "İrsaliye bilgileri",
          "columns": 2,
          "inputs": [
            "irsaliyeSiparisi",
            "belgeNo",
            "belgeTarihi",
            "irsaliyeKabulu"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "irsaliyeSiparisi",
        "type": "input",
        "name": "irsaliyeSiparisi",
        "props": {
          "inputType": "lookup",
          "label": "Satın alma siparişi",
          "required": true,
          "optionsQuery": "siparisler",
          "optionValueColumn": "id",
          "optionLabelColumn": "code",
          "optionDescriptionColumn": "supplierName",
          "minChars": 0,
          "optionsWhen": "satir.status in ['Open', 'PartiallyReceived', 'Received']",
          "clearsOnChange": [
            "irsaliyeKabulu"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "belgeNo",
        "type": "input",
        "name": "belgeNo",
        "props": {
          "inputType": "text",
          "label": "Tedarikçi irsaliye no",
          "required": true,
          "maxLength": 80,
          "placeholder": "IRS-2026-0042",
          "slot": "dialog"
        }
      },
      {
        "id": "belgeTarihi",
        "type": "input",
        "name": "belgeTarihi",
        "props": {
          "inputType": "date",
          "label": "Belge tarihi",
          "required": true,
          "defaultValue": "{{bugun}}",
          "slot": "dialog"
        }
      },
      {
        "id": "irsaliyeKabulu",
        "type": "input",
        "name": "irsaliyeKabulu",
        "props": {
          "inputType": "select",
          "label": "Mal kabul (isteğe bağlı)",
          "optionsQuery": "irsaliyeKabulleri",
          "optionValueColumn": "id",
          "optionLabelColumn": "code",
          "optionDescriptionColumn": "warehouseName",
          "optionsWhen": "satir.status == 'Posted'",
          "visibleWhen": "irsaliyeSiparisi.value != null",
          "slot": "dialog"
        }
      },
      {
        "id": "irsaliyeNotu",
        "type": "text",
        "name": "irsaliyeNotu",
        "props": {
          "text": "Satırlar siparişin irsaliyelenmemiş kalan miktarıyla dolar; belgede olmayan satırın miktarını 0 yapın. Miktar ve fiyat sipariş satırının temel biriminde girilir; tedarikçi irsaliyesinde fiyat yoksa boş bırakın, bedelsiz satırda fiyat girmeyin. Mal kabul seçilirse irsaliye satırları o mal kabulün satırlarıyla birebir eşleşmelidir. İrsaliye stok hareketi oluşturmaz. Gönderilecek satır: {{irsaliyeSatirlari.satirSayisi}}.",
          "slot": "dialog"
        }
      },
      {
        "id": "baglaPenceresi",
        "type": "dialog",
        "name": "baglaPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "md",
          "title": "Mal kabul bağla · {{liste.seciliSatir.documentNumber}}",
          "contains": [
            "baglaKabulu",
            "baglaNotu"
          ],
          "saveQuery": "bagla",
          "saveLabel": "Bağla",
          "closeOnSave": true,
          "resetOnOpen": true,
          "refreshQueries": [
            "irsaliyeler"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "baglaKabulu",
        "type": "input",
        "name": "baglaKabulu",
        "props": {
          "inputType": "select",
          "label": "Mal kabul",
          "required": true,
          "optionsQuery": "baglaKabulleri",
          "optionValueColumn": "id",
          "optionLabelColumn": "code",
          "optionDescriptionColumn": "warehouseName",
