            "planlananSevk",
            "planlananVaris"
          ],
          "recordKey": "{{kart.rows[0].id}}",
          "trackChanges": true
        }
      },
      {
        "id": "beyanDegeri",
        "type": "input",
        "name": "beyanDegeri",
        "props": {
          "inputType": "number",
          "label": "Beyan değeri",
          "min": 0,
          "step": 0.01,
          "placeholder": "Boşsa sipariş toplamı",
          "defaultValue": "{{kart.rows[0].declaredValue}}"
        }
      },
      {
        "id": "planlananSevk",
