  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "saveSequence": [
            "olustur",
            "guncelle"
          ],
          "stopOnError": true,
          "sequenceWhen": [
            "olustur=kart.rows[0].id == null && olustur.sonuc.id == null",
            "guncelle=kart.rows[0].id != null"
          ],
          "commandWhen": [
            "save=kart.rows[0].id == null || kart.rows[0].status in ['Draft', 'Booked']"
          ],
          "afterSaveAction": "page",
          "afterSavePageCode": "@foreign-trade",
          "afterSaveTarget": "sameTab",
          "afterSaveRefresh": true,
          "hiddenCommands": ["new", "open", "delete", "filter", "print", "export"]
        }
      },
      {
        "id": "yeniIthalatBasligi",
        "type": "recordHeader",
        "name": "yeniIthalatBasligi",
        "props": {
          "icon": "globe",
          "title": "İthalat dosyası oluştur",
          "subtitle": "Sipariş, firma veritabanında doğrulanır ve referans değişiklikleri denetlenir.",
          "visibleWhen": "kart.rows[0].id == null && yon.value == 'Import'"
        }
      },
      {
        "id": "yeniIhracatBasligi",
        "type": "recordHeader",
        "name": "yeniIhracatBasligi",
        "props": {
          "icon": "globe",
          "title": "İhracat dosyası oluştur",
          "subtitle": "Sipariş, firma veritabanında doğrulanır ve referans değişiklikleri denetlenir.",
          "visibleWhen": "kart.rows[0].id == null && yon.value != 'Import'"
        }
      },
      {
        "id": "ithalatBasligi",
        "type": "recordHeader",
        "name": "ithalatBasligi",
        "props": {
          "icon": "globe",
          "title": "İthalat dosyasını düzenle",
          "subtitle": "Sipariş, firma veritabanında doğrulanır ve referans değişiklikleri denetlenir.",
          "visibleWhen": "kart.rows[0].id != null && kart.rows[0].direction == 'Import'",
          "fields": [
            "Referans={{kart.rows[0].referenceCode}}",
            "Sipariş={{kart.rows[0].orderCode}}",
            "Cari={{kart.rows[0].counterpartyName}}"
          ]
        }
      },
      {
        "id": "ihracatBasligi",
        "type": "recordHeader",
        "name": "ihracatBasligi",
        "props": {
          "icon": "globe",
          "title": "İhracat dosyasını düzenle",
          "subtitle": "Sipariş, firma veritabanında doğrulanır ve referans değişiklikleri denetlenir.",
          "visibleWhen": "kart.rows[0].id != null && kart.rows[0].direction == 'Export'",
          "fields": [
            "Referans={{kart.rows[0].referenceCode}}",
            "Sipariş={{kart.rows[0].orderCode}}",
            "Cari={{kart.rows[0].counterpartyName}}"
          ]
        }
      },
      {
        "id": "durumDraft",
        "type": "badge",
        "name": "durumDraft",
        "props": {
          "text": "Taslak",
          "variant": "info",
          "visibleWhen": "kart.rows[0].status == 'Draft'"
        }
      },
      {
        "id": "durumBooked",
        "type": "badge",
        "name": "durumBooked",
        "props": {
          "text": "Planlandı",
          "variant": "warning",
          "visibleWhen": "kart.rows[0].status == 'Booked'"
        }
      },
      {
        "id": "durumShipped",
        "type": "badge",
        "name": "durumShipped",
        "props": {
          "text": "Sevkte",
          "variant": "warning",
          "visibleWhen": "kart.rows[0].status == 'Shipped'"
        }
      },
      {
        "id": "durumCustomsClearance",
        "type": "badge",
        "name": "durumCustomsClearance",
        "props": {
          "text": "Gümrükte",
          "variant": "warning",
          "visibleWhen": "kart.rows[0].status == 'CustomsClearance'"
        }
      },
      {
        "id": "durumArrived",
        "type": "badge",
        "name": "durumArrived",
        "props": {
          "text": "Ulaştı",
          "variant": "warning",
          "visibleWhen": "kart.rows[0].status == 'Arrived'"
        }
      },
      {
        "id": "durumClosed",
        "type": "badge",
        "name": "durumClosed",
        "props": {
          "text": "Kapandı",
          "variant": "success",
          "visibleWhen": "kart.rows[0].status == 'Closed'"
        }
      },
      {
        "id": "durumCancelled",
        "type": "badge",
        "name": "durumCancelled",
        "props": {
          "text": "İptal",
          "variant": "info",
          "visibleWhen": "kart.rows[0].status == 'Cancelled'"
        }
      },
      {
        "id": "kilitUyarisi",
        "type": "alert",
        "name": "kilitUyarisi",
        "props": {
          "title": "Düzenlenemez",
          "variant": "warning",
          "width": 12,
          "text": "Sevkiyat başladıktan sonra temel dosya bilgileri değiştirilemez.",
          "visibleWhen": "kart.rows[0].id != null && !(kart.rows[0].status in ['Draft', 'Booked'])"
        }
      },
      {
        "id": "ithalatSiparisYok",
        "type": "alert",
        "name": "ithalatSiparisYok",
        "props": {
          "title": "Sipariş bulunamadı",
          "variant": "info",
          "width": 12,
          "text": "İthalat dosyası için seçilebilir satın alma siparişi bulunamadı. Önce Satın Alma → Siparişler ekranından bir sipariş oluşturun.",
          "visibleWhen": "kart.rows[0].id == null && yon.value == 'Import' && ithalatSiparisleri.satirSayisi == 0"
        }
      },
      {
        "id": "ihracatSiparisYok",
        "type": "alert",
        "name": "ihracatSiparisYok",
        "props": {
          "title": "Sipariş bulunamadı",
          "variant": "info",
          "width": 12,
          "text": "İhracat dosyası için seçilebilir satış siparişi bulunamadı. Önce Satış → Siparişler ekranından bir sipariş oluşturun.",
          "visibleWhen": "kart.rows[0].id == null && yon.value != 'Import' && ihracatSiparisleri.satirSayisi == 0"
        }
      },
      {
        "id": "zorunluNotu",
        "type": "text",
        "name": "zorunluNotu",
        "props": {
          "text": "* işaretli alanlar zorunludur."
        }
      },
      {
        "id": "kimlikKarti",
        "type": "formCard",
        "name": "kimlikKarti",
        "props": {
          "title": "Dosya kimliği",
          "columns": 2,
          "inputs": [
            "yon",
            "ithalatSiparisi",
            "ihracatSiparisi",
            "referans"
          ],
          "recordKey": "{{kart.rows[0].id}}",
          "trackChanges": true
        }
      },
      {
        "id": "yon",
        "type": "input",
        "name": "yon",
        "props": {
          "inputType": "select",
          "label": "Yön",
          "required": true,
          "staticOptions": [
            "Export=İhracat",
            "Import=İthalat"
          ],
          "defaultValue": "{{kart.rows[0].direction}}{{sayfa.parametre.direction}}",
          "defaultFirst": true,
          "disabledWhen": "kart.rows[0].id != null",
          "clearsOnChange": [
            "ithalatSiparisi",
            "ihracatSiparisi"
          ]
        }
      },
      {
        "id": "ithalatSiparisi",
        "type": "input",
        "name": "ithalatSiparisi",
        "props": {
          "inputType": "select",
          "label": "Bağlı satın alma siparişi",
          "optionsQuery": "ithalatSiparisleri",
          "optionValueColumn": "id",
          "optionLabelColumn": "code",
          "optionDescriptionColumn": "counterpartyName",
          "searchable": true,
          "placeholder": "Sipariş seçin",
          "requiredWhen": "kart.rows[0].id == null && yon.value == 'Import'",
          "visibleWhen": "kart.rows[0].id == null && yon.value == 'Import'"
        }
      },
      {
        "id": "ihracatSiparisi",
        "type": "input",
        "name": "ihracatSiparisi",
        "props": {
          "inputType": "select",
          "label": "Bağlı satış siparişi",
          "optionsQuery": "ihracatSiparisleri",
          "optionValueColumn": "id",
          "optionLabelColumn": "code",
          "optionDescriptionColumn": "counterpartyName",
          "searchable": true,
          "placeholder": "Sipariş seçin",
          "requiredWhen": "kart.rows[0].id == null && yon.value != 'Import'",
          "visibleWhen": "kart.rows[0].id == null && yon.value != 'Import'"
        }
      },
      {
        "id": "referans",
        "type": "input",
        "name": "referans",
        "props": {
          "inputType": "text",
          "label": "Dış ticaret referansı",
          "required": true,
          "maxLength": 50,
          "upperCase": true,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "patternMessage": "Harf veya rakamla başlayın; harf, rakam, nokta, alt çizgi, eğik çizgi ya da tire kullanın.",
          "placeholder": "EXP-2026-001",
          "defaultValue": "{{kart.rows[0].referenceCode}}"
        }
      },
      {
        "id": "bagliSiparis",
        "type": "text",
        "name": "bagliSiparis",
        "props": {
          "text": "Bağlı sipariş: {{kart.rows[0].orderCode}} · {{kart.rows[0].counterpartyName}} (değiştirilemez)",
          "visibleWhen": "kart.rows[0].id != null"
        }
      },
      {
        "id": "guzergahKarti",
        "type": "formCard",
        "name": "guzergahKarti",
        "props": {
          "title": "Güzergâh ve teslim",
          "columns": 3,
          "inputs": [
            "cikisUlkesi",
            "varisUlkesi",
            "incoterms",
            "hsKodu",
            "tasima"
          ],
          "recordKey": "{{kart.rows[0].id}}",
          "trackChanges": true
        }
      },
      {
        "id": "cikisUlkesi",
        "type": "input",
        "name": "cikisUlkesi",
        "props": {
          "inputType": "text",
          "label": "Çıkış ülkesi",
          "required": true,
          "maxLength": 2,
          "upperCase": true,
          "pattern": "^[A-Za-z]{2}$",
          "patternMessage": "2 harf (ISO), ör. TR",
          "placeholder": "TR",
          "defaultValue": "{{kart.rows[0].originCountryCode}}"
        }
      },
      {
        "id": "varisUlkesi",
        "type": "input",
        "name": "varisUlkesi",
        "props": {
          "inputType": "text",
          "label": "Varış ülkesi",
          "required": true,
          "maxLength": 2,
          "upperCase": true,
          "pattern": "^[A-Za-z]{2}$",
          "patternMessage": "2 harf (ISO), ör. DE",
          "placeholder": "DE",
          "defaultValue": "{{kart.rows[0].destinationCountryCode}}"
        }
      },
      {
        "id": "incoterms",
        "type": "input",
        "name": "incoterms",
        "props": {
          "inputType": "select",
          "label": "Incoterms 2020",
          "staticOptions": [
            "=Seçin",
            "EXW=EXW",
            "FCA=FCA",
            "CPT=CPT",
            "CIP=CIP",
            "DAP=DAP",
            "DPU=DPU",
            "DDP=DDP",
            "FAS=FAS",
            "FOB=FOB",
            "CFR=CFR",
            "CIF=CIF"
          ],
          "defaultValue": "{{kart.rows[0].incotermsCode}}"
        }
      },
      {
        "id": "hsKodu",
        "type": "input",
        "name": "hsKodu",
        "props": {
          "inputType": "text",
          "label": "HS kodu",
          "maxLength": 20,
          "placeholder": "6–10 hane; nokta yazabilirsiniz",
          "pattern": "^[0-9. ]*$",
          "patternMessage": "6–10 hane; nokta yazabilirsiniz (ör. 8443.32)",
          "defaultValue": "{{kart.rows[0].harmonizedSystemCode}}"
        }
      },
      {
        "id": "tasima",
        "type": "input",
        "name": "tasima",
        "props": {
          "inputType": "select",
          "label": "Taşıma",
          "required": true,
          "staticOptions": [
            "Road=Kara",
            "Sea=Deniz",
            "Air=Hava",
            "Rail=Demir yolu",
            "Multimodal=Çok modlu"
          ],
          "defaultValue": "{{kart.rows[0].transportMode}}",
          "defaultFirst": true
        }
      },
      {
        "id": "ulkeNotu",
        "type": "text",
        "name": "ulkeNotu",
        "props": {
          "text": "Ülke kodları 2 harflidir (ISO 3166-1), ör. TR, DE; çıkış ve varış ülkesi farklı olmalıdır."
        }
      },
      {
        "id": "degerKarti",
        "type": "formCard",
        "name": "degerKarti",
        "props": {
