        "props": {
          "inputType": "date",
          "label": "Planlanan sevkiyat",
          "defaultValue": "{{kart.rows[0].plannedShipDate}}"
        }
      },
      {
        "id": "planlananVaris",
        "type": "input",
        "name": "planlananVaris",
        "props": {
          "inputType": "date",
          "label": "Planlanan varış",
          "defaultValue": "{{kart.rows[0].plannedArrivalDate}}"
        }
      },
      {
        "id": "degerNotu",
        "type": "text",
        "name": "degerNotu",
        "props": {
          "text": "Beyan değeri boş bırakılırsa bağlı siparişin genel toplamı yazılır; para birimi siparişten gelir."
        }
      },
