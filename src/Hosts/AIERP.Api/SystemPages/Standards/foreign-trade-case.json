{
  "screenKey": "foreign-trade-case",
  "title": "Dış ticaret dosyası",
  "description": "İthalat veya ihracat dosyası oluşturma ve düzenleme: bağlı sipariş, güzergâh, değer, planlama ve referanslar.",
  "module": "Dış Ticaret",
  "version": 1,
  "stage": "preview",
  "items": {
