{
  "screenKey": "foreign-trade-case", "title": "Dış ticaret dosyası",
  "description": "İthalat veya ihracat dosyası oluşturma ve düzenleme: bağlı sipariş, güzergâh, değer, planlama ve referanslar.", "module": "Dış Ticaret",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["query:kart", "query:olustur", "query:guncelle"]},
    "component:kartOzeti": {"since": 1, "label": "Kayıt özeti (referans, sipariş, karşı taraf)", "requires": ["query:kart"]},
    "component:durumDraft": {"since": 1, "label": "Aşama etiketi: Taslak", "requires": ["query:kart"]},
    "component:durumBooked": {"since": 1, "label": "Aşama etiketi: Planlandı", "requires": ["query:kart"]},
    "component:durumShipped": {"since": 1, "label": "Aşama etiketi: Sevkte", "requires": ["query:kart"]},
    "component:durumCustomsClearance": {"since": 1, "label": "Aşama etiketi: Gümrükte", "requires": ["query:kart"]},
    "component:durumArrived": {"since": 1, "label": "Aşama etiketi: Ulaştı", "requires": ["query:kart"]},
    "component:durumClosed": {"since": 1, "label": "Aşama etiketi: Kapandı", "requires": ["query:kart"]},
    "component:durumCancelled": {"since": 1, "label": "Aşama etiketi: İptal", "requires": ["query:kart"]},
    "component:kilitUyarisi": {"since": 1, "label": "Düzenlenemez uyarısı", "requires": ["query:kart"]},
    "component:siparisYok": {"since": 1, "label": "Sipariş bulunamadı uyarısı (yöne göre)", "requires": ["component:yon", "query:ithalatSiparisleri", "query:ihracatSiparisleri"]},
    "component:sekmeler": {"since": 1, "label": "Sekmeler (Dosya, Değer ve planlama, Referanslar ve not)", "requires": ["component:kimlikKarti", "component:guzergahKarti", "component:zorunluNotu", "component:bagliSiparis", "component:ulkeNotu", "component:degerKarti", "component:degerNotu", "component:referansKarti"]},
    "component:kimlikKarti": {"since": 1, "label": "Dosya kimliği bölümü", "requires": ["component:yon", "component:ithalatSiparisi", "component:ihracatSiparisi", "component:referans"]},
    "component:guzergahKarti": {"since": 1, "label": "Güzergâh ve teslim bölümü", "requires": ["component:cikisUlkesi", "component:varisUlkesi", "component:incoterms", "component:hsKodu", "component:tasima"]},
    "component:degerKarti": {"since": 1, "label": "Değer ve planlama bölümü", "requires": ["component:beyanDegeri", "component:planlananSevk", "component:planlananVaris"]},
    "component:referansKarti": {"since": 1, "label": "Referanslar ve not bölümü", "requires": ["component:tasiyiciReferansi", "component:gumrukReferansi", "component:not"]},
    "component:yon": {"since": 1, "label": "Alan: Yön"},
    "component:ithalatSiparisi": {"since": 1, "label": "Alan: Bağlı satın alma siparişi", "requires": ["query:ithalatSiparisleri"]},
    "component:ihracatSiparisi": {"since": 1, "label": "Alan: Bağlı satış siparişi", "requires": ["query:ihracatSiparisleri"]},
    "component:referans": {"since": 1, "label": "Alan: Dış ticaret referansı"},
    "component:cikisUlkesi": {"since": 1, "label": "Alan: Çıkış ülkesi"},
    "component:varisUlkesi": {"since": 1, "label": "Alan: Varış ülkesi"},
    "component:incoterms": {"since": 1, "label": "Alan: Incoterms 2020"},
    "component:hsKodu": {"since": 1, "label": "Alan: HS kodu"},
    "component:tasima": {"since": 1, "label": "Alan: Taşıma"},
    "component:beyanDegeri": {"since": 1, "label": "Alan: Beyan değeri"},
    "component:planlananSevk": {"since": 1, "label": "Alan: Planlanan sevkiyat"},
    "component:planlananVaris": {"since": 1, "label": "Alan: Planlanan varış"},
    "component:tasiyiciReferansi": {"since": 1, "label": "Alan: Taşıyıcı / takip referansı"},
    "component:gumrukReferansi": {"since": 1, "label": "Alan: Gümrük referansı"},
    "component:not": {"since": 1, "label": "Alan: Operasyon notu"},
    "component:zorunluNotu": {"since": 1, "label": "Zorunlu alan notu"},
    "component:bagliSiparis": {"since": 1, "label": "Bağlı sipariş notu"},
    "component:ulkeNotu": {"since": 1, "label": "Ülke kodu notu"},
    "component:degerNotu": {"since": 1, "label": "Beyan değeri notu"},
    "query:kart": {"since": 1, "label": "Dosya (düzenlemede)"},
    "query:ithalatSiparisleri": {"since": 1, "label": "İthalat sipariş seçenekleri"},
    "query:ihracatSiparisleri": {"since": 1, "label": "İhracat sipariş seçenekleri"},
    "query:olustur": {"since": 1, "label": "Dosya oluştur", "requires": ["component:yon", "component:ithalatSiparisi", "component:ihracatSiparisi", "component:referans", "component:cikisUlkesi", "component:varisUlkesi", "component:incoterms", "component:hsKodu", "component:tasima", "component:beyanDegeri", "component:planlananSevk", "component:planlananVaris", "component:tasiyiciReferansi", "component:gumrukReferansi", "component:not"]},
    "query:guncelle": {"since": 1, "label": "Dosyayı güncelle", "requires": ["query:kart", "component:referans", "component:cikisUlkesi", "component:varisUlkesi", "component:incoterms", "component:hsKodu", "component:tasima", "component:beyanDegeri", "component:planlananSevk", "component:planlananVaris", "component:tasiyiciReferansi", "component:gumrukReferansi", "component:not"]}
  },
  "screenViews": [],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"saveSequence": ["olustur", "guncelle"], "stopOnError": true, "sequenceWhen": ["olustur=kart.rows[0].id == null && olustur.sonuc.id == null", "guncelle=kart.rows[0].id != null"], "commandWhen": ["save=kart.rows[0].id == null || kart.rows[0].status in ['Draft', 'Booked']"], "afterSaveAction": "page", "afterSavePageCode": "@foreign-trade", "afterSaveTarget": "sameTab", "afterSaveRefresh": true, "hiddenCommands": ["new", "open", "delete", "filter", "print", "export"], "slot": "commands"}},
      {"id": "kartOzeti", "type": "recordHeader", "name": "kartOzeti", "props": {"icon": "globe", "title": "Dış ticaret dosyası", "subtitle": "{{kart.rows[0].orderCode}} · {{kart.rows[0].counterpartyName}}", "fields": ["Referans={{kart.rows[0].referenceCode}}"], "slot": "summary"}},
      {"id": "durumDraft", "type": "badge", "name": "durumDraft", "props": {"text": "Taslak", "variant": "info", "visibleWhen": "kart.rows[0].status == 'Draft'", "slot": "above"}},
      {"id": "durumBooked", "type": "badge", "name": "durumBooked", "props": {"text": "Planlandı", "variant": "warning", "visibleWhen": "kart.rows[0].status == 'Booked'", "slot": "above"}},
      {"id": "durumShipped", "type": "badge", "name": "durumShipped", "props": {"text": "Sevkte", "variant": "warning", "visibleWhen": "kart.rows[0].status == 'Shipped'", "slot": "above"}},
      {"id": "durumCustomsClearance", "type": "badge", "name": "durumCustomsClearance", "props": {"text": "Gümrükte", "variant": "warning", "visibleWhen": "kart.rows[0].status == 'CustomsClearance'", "slot": "above"}},
      {"id": "durumArrived", "type": "badge", "name": "durumArrived", "props": {"text": "Ulaştı", "variant": "warning", "visibleWhen": "kart.rows[0].status == 'Arrived'", "slot": "above"}},
      {"id": "durumClosed", "type": "badge", "name": "durumClosed", "props": {"text": "Kapandı", "variant": "success", "visibleWhen": "kart.rows[0].status == 'Closed'", "slot": "above"}},
      {"id": "durumCancelled", "type": "badge", "name": "durumCancelled", "props": {"text": "İptal", "variant": "info", "visibleWhen": "kart.rows[0].status == 'Cancelled'", "slot": "above"}},
      {"id": "kilitUyarisi", "type": "alert", "name": "kilitUyarisi", "props": {"title": "Düzenlenemez", "variant": "warning", "text": "Sevkiyat başladıktan sonra temel dosya bilgileri değiştirilemez.", "visibleWhen": "kart.rows[0].id != null && !(kart.rows[0].status in ['Draft', 'Booked'])", "slot": "above"}},
      {"id": "siparisYok", "type": "alert", "name": "siparisYok", "props": {"title": "Sipariş bulunamadı", "variant": "info", "text": "Seçilebilir sipariş bulunamadı. İthalat için Satın Alma, ihracat için Satış → Siparişler ekranından önce bir sipariş oluşturun.", "visibleWhen": "kart.rows[0].id == null && (yon.value == 'Import' && ithalatSiparisleri.satirSayisi == 0 || yon.value != 'Import' && ihracatSiparisleri.satirSayisi == 0)", "slot": "above"}},
      {"id": "sekmeler", "type": "tabs", "name": "sekmeler", "props": {"tabs": ["Dosya=kimlikKarti,guzergahKarti,zorunluNotu,bagliSiparis,ulkeNotu", "Değer ve planlama=degerKarti,degerNotu", "Referanslar ve not=referansKarti"], "slot": "tabs"}},
      {"id": "kimlikKarti", "type": "formCard", "name": "kimlikKarti", "props": {"title": "Dosya kimliği", "columns": 2, "inputs": ["yon", "ithalatSiparisi", "ihracatSiparisi", "referans"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "guzergahKarti", "type": "formCard", "name": "guzergahKarti", "props": {"title": "Güzergâh ve teslim", "columns": 3, "inputs": ["cikisUlkesi", "varisUlkesi", "incoterms", "hsKodu", "tasima"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "degerKarti", "type": "formCard", "name": "degerKarti", "props": {"title": "Değer ve planlama", "columns": 3, "inputs": ["beyanDegeri", "planlananSevk", "planlananVaris"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "referansKarti", "type": "formCard", "name": "referansKarti", "props": {"title": "Referanslar ve not", "columns": 2, "inputs": ["tasiyiciReferansi", "gumrukReferansi", "not"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "yon", "type": "input", "name": "yon", "props": {"inputType": "select", "label": "Yön", "required": true, "staticOptions": ["Export=İhracat", "Import=İthalat"], "defaultValue": "{{kart.rows[0].direction}}{{sayfa.parametre.direction}}", "defaultFirst": true, "disabledWhen": "kart.rows[0].id != null", "clearsOnChange": ["ithalatSiparisi", "ihracatSiparisi"], "slot": "field"}},
      {"id": "ithalatSiparisi", "type": "input", "name": "ithalatSiparisi", "props": {"inputType": "select", "label": "Bağlı satın alma siparişi", "optionsQuery": "ithalatSiparisleri", "optionValueColumn": "id", "optionLabelColumn": "code", "optionDescriptionColumn": "counterpartyName", "searchable": true, "placeholder": "Sipariş seçin", "requiredWhen": "kart.rows[0].id == null && yon.value == 'Import'", "visibleWhen": "kart.rows[0].id == null && yon.value == 'Import'", "slot": "field"}},
      {"id": "ihracatSiparisi", "type": "input", "name": "ihracatSiparisi", "props": {"inputType": "select", "label": "Bağlı satış siparişi", "optionsQuery": "ihracatSiparisleri", "optionValueColumn": "id", "optionLabelColumn": "code", "optionDescriptionColumn": "counterpartyName", "searchable": true, "placeholder": "Sipariş seçin", "requiredWhen": "kart.rows[0].id == null && yon.value != 'Import'", "visibleWhen": "kart.rows[0].id == null && yon.value != 'Import'", "slot": "field"}},
      {"id": "referans", "type": "input", "name": "referans", "props": {"inputType": "text", "label": "Dış ticaret referansı", "required": true, "maxLength": 50, "upperCase": true, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "patternMessage": "Harf veya rakamla başlayın; harf, rakam, nokta, alt çizgi, eğik çizgi ya da tire kullanın.", "placeholder": "EXP-2026-001", "defaultValue": "{{kart.rows[0].referenceCode}}", "slot": "field"}},
      {"id": "cikisUlkesi", "type": "input", "name": "cikisUlkesi", "props": {"inputType": "text", "label": "Çıkış ülkesi", "required": true, "maxLength": 2, "upperCase": true, "pattern": "^[A-Za-z]{2}$", "patternMessage": "2 harf (ISO), ör. TR", "placeholder": "TR", "defaultValue": "{{kart.rows[0].originCountryCode}}", "slot": "field"}},
      {"id": "varisUlkesi", "type": "input", "name": "varisUlkesi", "props": {"inputType": "text", "label": "Varış ülkesi", "required": true, "maxLength": 2, "upperCase": true, "pattern": "^[A-Za-z]{2}$", "patternMessage": "2 harf (ISO), ör. DE", "placeholder": "DE", "defaultValue": "{{kart.rows[0].destinationCountryCode}}", "slot": "field"}},
      {"id": "incoterms", "type": "input", "name": "incoterms", "props": {"inputType": "select", "label": "Incoterms 2020", "staticOptions": ["=Seçin", "EXW=EXW", "FCA=FCA", "CPT=CPT", "CIP=CIP", "DAP=DAP", "DPU=DPU", "DDP=DDP", "FAS=FAS", "FOB=FOB", "CFR=CFR", "CIF=CIF"], "defaultValue": "{{kart.rows[0].incotermsCode}}", "slot": "field"}},
      {"id": "hsKodu", "type": "input", "name": "hsKodu", "props": {"inputType": "text", "label": "HS kodu", "maxLength": 20, "placeholder": "6–10 hane; nokta yazabilirsiniz", "pattern": "^[0-9. ]*$", "patternMessage": "6–10 hane; nokta yazabilirsiniz (ör. 8443.32)", "defaultValue": "{{kart.rows[0].harmonizedSystemCode}}", "slot": "field"}},
      {"id": "tasima", "type": "input", "name": "tasima", "props": {"inputType": "select", "label": "Taşıma", "required": true, "staticOptions": ["Road=Kara", "Sea=Deniz", "Air=Hava", "Rail=Demir yolu", "Multimodal=Çok modlu"], "defaultValue": "{{kart.rows[0].transportMode}}", "defaultFirst": true, "slot": "field"}},
      {"id": "beyanDegeri", "type": "input", "name": "beyanDegeri", "props": {"inputType": "number", "label": "Beyan değeri", "min": 0, "step": 0.01, "placeholder": "Boşsa sipariş toplamı", "defaultValue": "{{kart.rows[0].declaredValue}}", "slot": "field"}},
      {"id": "planlananSevk", "type": "input", "name": "planlananSevk", "props": {"inputType": "date", "label": "Planlanan sevkiyat", "defaultValue": "{{kart.rows[0].plannedShipDate}}", "slot": "field"}},
      {"id": "planlananVaris", "type": "input", "name": "planlananVaris", "props": {"inputType": "date", "label": "Planlanan varış", "defaultValue": "{{kart.rows[0].plannedArrivalDate}}", "slot": "field"}},
      {"id": "tasiyiciReferansi", "type": "input", "name": "tasiyiciReferansi", "props": {"inputType": "text", "label": "Taşıyıcı / takip referansı", "maxLength": 100, "defaultValue": "{{kart.rows[0].carrierReference}}", "slot": "field"}},
      {"id": "gumrukReferansi", "type": "input", "name": "gumrukReferansi", "props": {"inputType": "text", "label": "Gümrük referansı", "maxLength": 100, "defaultValue": "{{kart.rows[0].customsReference}}", "slot": "field"}},
      {"id": "not", "type": "input", "name": "not", "props": {"inputType": "text", "label": "Operasyon notu", "maxLength": 1000, "placeholder": "En çok 1000 karakter", "defaultValue": "{{kart.rows[0].notes}}", "slot": "field"}},
      {"id": "zorunluNotu", "type": "text", "name": "zorunluNotu", "props": {"text": "* işaretli alanlar zorunludur.", "slot": "note"}},
      {"id": "bagliSiparis", "type": "text", "name": "bagliSiparis", "props": {"text": "Bağlı sipariş: {{kart.rows[0].orderCode}} · {{kart.rows[0].counterpartyName}} (değiştirilemez)", "visibleWhen": "kart.rows[0].id != null", "slot": "note"}},
      {"id": "ulkeNotu", "type": "text", "name": "ulkeNotu", "props": {"text": "Ülke kodları 2 harflidir (ISO 3166-1), ör. TR, DE; çıkış ve varış ülkesi farklı olmalıdır.", "slot": "note"}},
      {"id": "degerNotu", "type": "text", "name": "degerNotu", "props": {"text": "Beyan değeri boş bırakılırsa bağlı siparişin genel toplamı yazılır; para birimi siparişten gelir.", "slot": "note"}}
    ],
    "queries": [
      {"id": "kart", "name": "kart", "kind": "read", "operation": "disTicaret.dosya.getir", "runOn": "load", "parameters": [{"name": "id", "binding": "{{sayfa.parametre.id}}", "type": "guid"}]},
      {"id": "ithalatSiparisleri", "name": "ithalatSiparisleri", "kind": "read", "operation": "disTicaret.siparis.ithalatSecenekleri", "runOn": "load", "parameters": []},
      {"id": "ihracatSiparisleri", "name": "ihracatSiparisleri", "kind": "read", "operation": "disTicaret.siparis.ihracatSecenekleri", "runOn": "load", "parameters": []},
      {"id": "olustur", "name": "olustur", "kind": "insert", "operation": "disTicaret.dosya.olustur", "runOn": "manual", "parameters": [{"name": "direction", "binding": "{{yon.value}}", "type": "text"}, {"name": "purchaseOrderId", "binding": "{{ithalatSiparisi.value}}", "type": "guid"}, {"name": "salesOrderId", "binding": "{{ihracatSiparisi.value}}", "type": "guid"}, {"name": "referenceCode", "binding": "{{referans.value}}", "type": "text"}, {"name": "originCountryCode", "binding": "{{cikisUlkesi.value}}", "type": "text"}, {"name": "destinationCountryCode", "binding": "{{varisUlkesi.value}}", "type": "text"}, {"name": "incotermsCode", "binding": "{{incoterms.value}}", "type": "text"}, {"name": "harmonizedSystemCode", "binding": "{{hsKodu.value}}", "type": "text"}, {"name": "transportMode", "binding": "{{tasima.value}}", "type": "text"}, {"name": "carrierReference", "binding": "{{tasiyiciReferansi.value}}", "type": "text"}, {"name": "customsReference", "binding": "{{gumrukReferansi.value}}", "type": "text"}, {"name": "declaredValue", "binding": "{{beyanDegeri.value}}", "type": "decimal"}, {"name": "plannedShipDate", "binding": "{{planlananSevk.value}}", "type": "date"}, {"name": "plannedArrivalDate", "binding": "{{planlananVaris.value}}", "type": "date"}, {"name": "notes", "binding": "{{not.value}}", "type": "text"}]},
      {"id": "guncelle", "name": "guncelle", "kind": "update", "operation": "disTicaret.dosya.guncelle", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid"}, {"name": "direction", "binding": "{{kart.rows[0].direction}}", "type": "text"}, {"name": "purchaseOrderId", "binding": "{{kart.rows[0].purchaseOrderId}}", "type": "guid"}, {"name": "salesOrderId", "binding": "{{kart.rows[0].salesOrderId}}", "type": "guid"}, {"name": "referenceCode", "binding": "{{referans.value}}", "type": "text"}, {"name": "originCountryCode", "binding": "{{cikisUlkesi.value}}", "type": "text"}, {"name": "destinationCountryCode", "binding": "{{varisUlkesi.value}}", "type": "text"}, {"name": "incotermsCode", "binding": "{{incoterms.value}}", "type": "text"}, {"name": "harmonizedSystemCode", "binding": "{{hsKodu.value}}", "type": "text"}, {"name": "transportMode", "binding": "{{tasima.value}}", "type": "text"}, {"name": "carrierReference", "binding": "{{tasiyiciReferansi.value}}", "type": "text"}, {"name": "customsReference", "binding": "{{gumrukReferansi.value}}", "type": "text"}, {"name": "declaredValue", "binding": "{{beyanDegeri.value}}", "type": "decimal"}, {"name": "plannedShipDate", "binding": "{{planlananSevk.value}}", "type": "date"}, {"name": "plannedArrivalDate", "binding": "{{planlananVaris.value}}", "type": "date"}, {"name": "notes", "binding": "{{not.value}}", "type": "text"}]}
    ],
    "template": {"name": "record"}
  }
}
