  "screenViews": [
    {
      "key": "manufacturing-orders",
      "component": "liste",
      "fields": {
        "code": "code",
        "plannedDate": "plannedDate",
        "billOfMaterialName": "billOfMaterialName",
        "warehouseName": "warehouseName",
        "plannedQuantity": "plannedQuantity",
        "status": "status"
      }
    }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "yeniDugmesi",
        "type": "button",
        "name": "yeniDugmesi",
        "props": {
          "text": "Yeni emir",
          "actionType": "page",
          "pageCode": "@manufacturing-order-create",
          "target": "newTab",
          "slot": "actions"
        }
      },
      {
        "id": "rotaDugmesi",
        "type": "button",
        "name": "rotaDugmesi",
        "props": {
          "text": "Rota",
          "actionType": "openDialog",
          "dialogId": "rotaPenceresi",
          "visibleWhen": "liste.seciliSatir.id != null",
          "slot": "actions"
        }
      },
      {
        "id": "bilesenDugmesi",
        "type": "button",
        "name": "bilesenDugmesi",
        "props": {
          "text": "Bileşenler",
          "actionType": "openDialog",
          "dialogId": "bilesenPenceresi",
          "visibleWhen": "liste.seciliSatir.id != null",
          "slot": "actions"
        }
      },
      {
        "id": "rotaPenceresi",
        "type": "dialog",
        "name": "rotaPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Rota · {{liste.seciliSatir.code}}",
          "contains": [
            "operasyonTablosu",
            "rotaNotu"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "bilesenPenceresi",
        "type": "dialog",
        "name": "bilesenPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "lg",
          "title": "Bileşenler · {{liste.seciliSatir.code}}",
          "contains": [
            "bilesenTablosu"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "slot": "commands",
          "newButton": "yeniDugmesi",
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{emirler.meta.totalCount}}",
          "moreButtons": [
            "cizelgeleDugmesi",
            "serbestBirakDugmesi",
            "tamamlaDugmesi",
            "iptalDugmesi",
            "rotaDugmesi",
            "bilesenDugmesi"
          ],
          "hiddenCommands": [
            "save",
            "delete",
            "print"
          ]
        }
      },
      {
        "id": "acikGostergesi",
        "type": "metric",
        "name": "acikGostergesi",
        "props": {
          "title": "Açık emir",
          "value": "{{emirler.meta.openOrderCount}}",
          "format": "number",
          "icon": "clock",
          "description": "tüm kayıtlar · Planlandı + Serbest bırakıldı",
          "slot": "indicators"
        }
      },
      {
        "id": "maliyetGostergesi",
        "type": "metric",
        "name": "maliyetGostergesi",
        "props": {
          "title": "Planlanan maliyet",
          "value": "{{emirler.meta.openPlannedCostBase}}",
          "format": "money",
          "icon": "wallet",
          "description": "tüm kayıtlar · açık emirler · baz para",
          "slot": "indicators"
        }
      },
      {
        "id": "cizelgesizGostergesi",
        "type": "metric",
        "name": "cizelgesizGostergesi",
        "props": {
          "title": "Çizelgelenmemiş",
          "value": "{{emirler.meta.unscheduledOrderCount}}",
          "format": "number",
          "icon": "alert",
          "variant": "warning",
          "description": "tüm kayıtlar · rotası takvimsiz",
          "slot": "indicators"
        }
      },
      {
        "id": "tamamlananGostergesi",
        "type": "metric",
        "name": "tamamlananGostergesi",
        "props": {
          "title": "Tamamlanan",
          "value": "{{emirler.meta.completedOrderCount}}",
          "format": "number",
          "icon": "check",
          "variant": "success",
          "description": "tüm kayıtlar",
          "filterInput": "durumSecimi",
          "filterValue": "Completed",
          "slot": "indicators"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "search": true,
          "searchPlaceholder": "Emir, reçete, depo veya sipariş ara",
          "slot": "filters",
          "searchParam": "q"
        }
      },
      {
        "id": "durumSecimi",
        "type": "input",
        "name": "durumSecimi",
        "props": {
          "inputType": "select",
          "label": "Durum",
          "staticOptions": [
            "=Tümü",
            "Planned=Planlandı",
            "Released=Serbest bırakıldı",
            "Completed=Tamamlandı",
            "Cancelled=İptal edildi"
          ],
          "slot": "above"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Üretim emirleri",
          "query": "emirler",
          "paging": "server",
          "pageSize": 25,
          "columns": [
            "code",
            "plannedDate",
            "productName",
            "billOfMaterialName",
            "warehouseName",
            "plannedQuantity",
            "status"
          ],
          "columnLabels": [
            "code=Üretim emri",
            "plannedDate=Plan tarihi",
            "billOfMaterialName=Reçete",
            "productName=Mamul",
            "warehouseName=Depo",
            "plannedQuantity=Miktar",
            "status=Durum"
          ],
          "columnFormats": [
            "code=code",
            "plannedDate=date",
            "plannedQuantity=number",
            "status=status"
          ],
          "valueLabels": [
            "status:Planned=Planlandı",
            "status:Released=Serbest bırakıldı",
            "status:Completed=Tamamlandı",
            "status:Cancelled=İptal edildi"
          ],
          "toneMap": [
            "Planlandı=info",
            "Serbest bırakıldı=warning",
            "Tamamlandı=success"
          ],
          "emptyText": "Henüz üretim emri yok ya da süzgeçle eşleşen emir yok. Bir reçete oluşturduktan sonra ilk emri planlayabilirsiniz.",
          "slot": "list"
        }
      },
      {
        "id": "cizelgeleDugmesi",
        "type": "button",
        "name": "cizelgeleDugmesi",
        "props": {
          "text": "Kapasiteye çizelgele",
          "actionType": "query",
          "queryId": "cizelgele",
          "successMessage": "{{liste.seciliSatir.code}} için iş merkezi kapasitesi ayrıldı.",
          "refreshQueries": [
            "emirler",
            "emir",
            "operasyonlar"
          ],
          "visibleWhen": "liste.seciliSatir.canSchedule == true",
          "slot": "actions"
        }
      },
      {
        "id": "serbestBirakDugmesi",
        "type": "button",
        "name": "serbestBirakDugmesi",
        "props": {
          "text": "Serbest bırak",
          "actionType": "query",
          "queryId": "serbestBirak",
          "successMessage": "Üretim emri serbest bırakıldı.",
          "refreshQueries": [
            "emirler",
            "emir",
            "operasyonlar"
          ],
          "visibleWhen": "liste.seciliSatir.canRelease == true",
          "slot": "actions"
        }
      },
      {
        "id": "tamamlaDugmesi",
        "type": "button",
        "name": "tamamlaDugmesi",
        "props": {
          "text": "Üretimi tamamla",
          "actionType": "openDialog",
          "dialogId": "tamamlaPenceresi",
          "visibleWhen": "liste.seciliSatir.canComplete == true",
          "slot": "actions"
        }
      },
      {
        "id": "iptalDugmesi",
        "type": "button",
        "name": "iptalDugmesi",
        "props": {
          "text": "İptal et",
          "actionType": "query",
          "queryId": "iptal",
          "confirmEnabled": true,
          "confirmText": "{{liste.seciliSatir.code}} üretim emri iptal edilsin mi? Başlamış operasyon varsa fiili kayıtları da etkiler; kapasite ayırmaları silinir ve işlem geri alınamaz.",
          "successMessage": "Üretim emri iptal edildi.",
          "refreshQueries": [
            "emirler",
            "emir",
            "operasyonlar"
          ],
          "slot": "actions",
          "visibleWhen": "liste.seciliSatir.canCancel == true"
        }
      },
      {
        "id": "detayKarti",
        "type": "card",
        "name": "detayKarti",
        "props": {
          "variant": "panel",
          "title": "{{emir.rows[0].code}}",
          "description": "{{emir.rows[0].productName}} · {{emir.rows[0].plannedQuantity}} · {{emir.rows[0].warehouseName}}",
          "slot": "detail"
        },
        "children": [
          {
            "id": "ozetPaneli",
            "type": "contextPanel",
            "name": "ozetPaneli",
            "props": {
              "table": "liste",
              "visibleWhen": "liste.seciliSatir.id != null",
              "fields": [
                "status=Durum",
                "billOfMaterialName=Reçete",
                "sourceText=Kaynak",
                "componentCodes=Bileşen kodları",
                "routeSummary=Rota",
                "plannedCostBase=Planlanan maliyet"
              ]
            }
          },
          {
            "id": "tutarNotu",
            "type": "text",
            "name": "tutarNotu",
            "props": {
              "text": "Rota ve bileşen ayrıntıları ilgili pencerelerde açılır."
            }
          }
        ]
      },
      {
        "id": "opTamamlaPenceresi",
        "type": "dialog",
        "name": "opTamamlaPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "md",
          "title": "Operasyonu tamamla · {{operasyonTablosu.seciliSatir.sequence}} · {{operasyonTablosu.seciliSatir.workCenterName}}",
          "contains": [
            "opTamamlaFormu"
          ],
          "saveQuery": "opTamamla",
          "saveLabel": "Fiili kayıtları kaydet",
          "closeOnSave": true,
          "resetOnOpen": true,
          "refreshQueries": [
            "emirler",
            "emir",
            "operasyonlar"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "tamamlaPenceresi",
        "type": "dialog",
        "name": "tamamlaPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "lg",
          "title": "Üretimi bildir · {{emir.rows[0].code}}",
          "contains": [
            "tamamlaBilgisi",
            "tamamlaFormu",
            "tamamlaDurumu",
            "takip",
            "tamamlaUyarisi"
          ],
          "saveQuery": "tamamla",
          "saveLabel": "Bildir ve Tamamla",
          "closeOnSave": true,
          "resetOnOpen": true,
          "refreshQueries": [
            "emirler",
            "emir",
            "operasyonlar",
            "bilesenler"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "opTamamlaFormu",
        "type": "formCard",
        "name": "opTamamlaFormu",
        "props": {
          "title": "Fiili kayıt",
          "columns": 2,
          "inputs": [
            "kurulumDk",
            "calismaDk",
            "enerjiKwh",
            "enerjiBedeli",
            "operator"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "kurulumDk",
        "type": "input",
        "name": "kurulumDk",
        "props": {
          "inputType": "number",
          "label": "Kurulum dk",
          "required": true,
          "min": 0,
          "step": 0.01,
          "defaultValue": "{{operasyonTablosu.seciliSatir.setupMinutes}}",
          "slot": "dialog"
        }
      },
      {
        "id": "calismaDk",
        "type": "input",
        "name": "calismaDk",
        "props": {
          "inputType": "number",
          "label": "Çalışma dk",
          "required": true,
          "min": 0,
          "step": 0.01,
          "defaultValue": "{{operasyonTablosu.seciliSatir.runMinutes}}",
          "slot": "dialog"
        }
      },
      {
        "id": "enerjiKwh",
        "type": "input",
        "name": "enerjiKwh",
        "props": {
          "inputType": "number",
          "label": "Enerji kWh",
          "min": 0,
          "step": 0.001,
          "defaultValue": "{{operasyonTablosu.seciliSatir.plannedEnergyQuantityKwh}}",
          "slot": "dialog"
        }
      },
      {
        "id": "enerjiBedeli",
        "type": "input",
        "name": "enerjiBedeli",
        "props": {
          "inputType": "number",
          "label": "Baz para/kWh",
          "min": 0,
          "step": 1e-06,
          "defaultValue": "{{operasyonTablosu.seciliSatir.plannedEnergyCostPerKwhBase}}",
          "slot": "dialog"
        }
      },
      {
        "id": "operator",
        "type": "input",
        "name": "operator",
        "props": {
          "inputType": "lookup",
          "label": "Operatör",
          "required": true,
          "optionsQuery": "operatorler",
          "optionValueColumn": "id",
          "optionLabelColumn": "fullName",
          "optionDescriptionColumn": "code",
          "minChars": 0,
          "placeholder": "Operatör / personel seçin",
          "slot": "dialog"
        }
      },
      {
        "id": "tamamlaBilgisi",
        "type": "text",
        "name": "tamamlaBilgisi",
        "props": {
          "text": "{{emir.rows[0].productName}} · {{emir.rows[0].warehouseName}}",
          "slot": "dialog"
        }
      },
      {
        "id": "tamamlaFormu",
        "type": "formCard",
        "name": "tamamlaFormu",
        "props": {
          "title": "Bildirilen miktarlar",
          "columns": 3,
          "inputs": [
            "iyiMiktar",
            "fireMiktar",
            "fireNedeni"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "iyiMiktar",
        "type": "input",
        "name": "iyiMiktar",
        "props": {
          "inputType": "number",
          "label": "İyi ürün miktarı",
          "required": true,
          "min": 0,
          "step": 0.0001,
          "defaultValue": "{{emir.rows[0].plannedQuantity}}",
          "slot": "dialog"
        }
      },
      {
        "id": "fireMiktar",
        "type": "input",
        "name": "fireMiktar",
        "props": {
          "inputType": "number",
          "label": "Fire miktarı",
          "required": true,
          "min": 0,
          "step": 0.0001,
          "defaultValue": "0",
          "slot": "dialog"
        }
      },
      {
        "id": "fireNedeni",
        "type": "input",
        "name": "fireNedeni",
        "props": {
          "inputType": "text",
          "label": "Fire nedeni",
          "maxLength": 500,
          "requiredWhen": "fireMiktar.value > 0",
          "placeholder": "Fire varsa zorunlu",
          "slot": "dialog"
        }
      },
      {
        "id": "tamamlaDurumu",
        "type": "text",
        "name": "tamamlaDurumu",
        "props": {
          "text": "Planlanan {{emir.rows[0].plannedQuantity}} · Bildirilen {{iyiMiktar.value}} + {{fireMiktar.value}} (iyi + fire planlanan miktara eşit olmalıdır)",
          "slot": "dialog"
        }
      },
      {
        "id": "takip",
        "type": "editableGrid",
        "name": "takip",
        "props": {
          "gridMode": "list",
          "title": "Lot / seri satırları",
          "addLabel": "Satır ekle",
          "maxRows": 200,
          "gridColumns": [
            "trackingCode|Lot / seri numarası|text|required,unique,maxLength:100",
            "quantity|Miktar|number|required,min:0.0001,step:0.0001",
            "expiryDate|Son kullanma tarihi|date"
          ],
          "slot": "dialog",
          "visibleWhen": "emir.rows[0].productTrackingMode == 'Lot' || emir.rows[0].productTrackingMode == 'Serial'"
        }
      },
      {
        "id": "tamamlaUyarisi",
        "type": "alert",
        "name": "tamamlaUyarisi",
        "props": {
          "title": "Stok hareketi",
          "variant": "info",
          "text": "Bileşenler {{emir.rows[0].warehouseName}} deposundan, son kullanma tarihi en yakın lottan başlanarak (FEFO) otomatik düşülür. Hareket tarihi bugündür; muhasebe fişi yazılmaz. Tamamlanan üretim geri alınamaz. Lotlu mamulde tek satır (SKT zorunlu), serili mamulde her seri için bir satır (miktar 1) girin.",
          "slot": "dialog"
        }
      },
      {
        "id": "operasyonTablosu",
        "type": "dataTable",
        "name": "operasyonTablosu",
        "props": {
          "title": "Rota",
          "query": "operasyonlar",
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showExport": false,
          "showPivot": false,
          "showCsv": false,
          "showSelectedExport": false,
          "columns": [
            "sequence",
            "workCenterCode",
            "status",
            "setupMinutes",
            "runMinutes",
            "actualSetupMinutes",
            "actualRunMinutes",
            "scheduledStartDate",
            "performedByEmployeeName"
          ],
          "columnLabels": [
            "sequence=Sıra",
            "workCenterCode=İş merkezi",
            "status=Durum",
            "setupMinutes=Kurulum dk",
            "runMinutes=Çalışma dk",
            "scheduledStartDate=Başlangıç",
            "actualSetupMinutes=Fiili kurulum",
            "actualRunMinutes=Fiili çalışma",
            "performedByEmployeeName=Operatör"
          ],
          "columnFormats": [
            "workCenterCode=code",
            "status=status",
            "setupMinutes=number",
            "runMinutes=number",
            "scheduledStartDate=date",
            "actualSetupMinutes=number",
            "actualRunMinutes=number"
          ],
          "columnUnits": [
            "workCenterCode=workCenterName"
          ],
          "valueLabels": [
            "status:Planned=Bekliyor",
            "status:InProgress=Devam ediyor",
            "status:Completed=Tamamlandı"
          ],
          "toneMap": [
            "Devam ediyor=warning",
            "Tamamlandı=success"
          ],
          "rowActions": [
            "opBaslatDugmesi",
            "opTamamlaDugmesi"
          ],
          "emptyText": "Operasyon rotası tanımlı değil.",
          "slot": "dialog"
        }
      },
      {
        "id": "rotaNotu",
        "type": "text",
        "name": "rotaNotu",
        "props": {
          "text": "Operasyonlar sırayla, serbest bırakılmış emirde ve planlanan başlangıç gününden itibaren başlatılır.",
          "slot": "dialog"
        }
      },
      {
        "id": "bilesenTablosu",
        "type": "dataTable",
        "name": "bilesenTablosu",
        "props": {
          "title": "Bileşenler",
          "query": "bilesenler",
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showExport": false,
          "showPivot": false,
          "showCsv": false,
          "showSelectedExport": false,
          "columns": [
            "componentCode",
            "componentName",
            "requiredQuantity",
            "standardUnitCostBaseSnapshot",
            "plannedCostBase"
          ],
          "columnLabels": [
            "componentCode=Kod",
            "componentName=Bileşen",
            "requiredQuantity=Gereken",
            "standardUnitCostBaseSnapshot=Birim maliyet",
            "plannedCostBase=Planlanan malzeme"
          ],
          "columnFormats": [
            "componentCode=code",
            "requiredQuantity=number",
            "standardUnitCostBaseSnapshot=money",
            "plannedCostBase=money"
          ],
          "totals": [
            "plannedCostBase"
          ],
          "emptyText": "Bu emirde bileşen satırı yok.",
          "slot": "dialog"
        }
      },
      {
        "id": "opBaslatDugmesi",
        "type": "button",
        "name": "opBaslatDugmesi",
        "props": {
          "text": "Başlat",
          "actionType": "query",
          "queryId": "opBaslat",
          "successMessage": "Operasyon başlatıldı.",
          "refreshQueries": [
            "emirler",
            "emir",
            "operasyonlar"
          ],
          "visibleWhen": "operasyonTablosu.seciliSatir.status == 'Planned'",
          "disabledWhen": "emir.rows[0].status != 'Released'",
          "disabledReason": "Operasyon yalnız serbest bırakılmış emirde başlatılabilir.",
          "slot": "rowActions"
        }
      },
      {
        "id": "opTamamlaDugmesi",
        "type": "button",
        "name": "opTamamlaDugmesi",
        "props": {
          "text": "Tamamla",
          "actionType": "openDialog",
          "dialogId": "opTamamlaPenceresi",
          "visibleWhen": "operasyonTablosu.seciliSatir.status == 'InProgress'",
          "disabledWhen": "emir.rows[0].status != 'Released'",
          "disabledReason": "Operasyon yalnız serbest bırakılmış emirde tamamlanabilir.",
          "slot": "rowActions"
        }
      }
    ],
    "queries": [
      {
        "id": "emirler",
        "name": "emirler",
        "kind": "read",
        "operation": "uretim.emir.listele",
        "runOn": "load",
        "parameters": [
          {
            "name": "q",
            "binding": "{{suzgec.q}}",
            "type": "text"
          },
          {
            "name": "status",
            "binding": "{{durumSecimi.value}}",
            "type": "text"
          },
          {
            "name": "page",
            "binding": "{{liste.sayfa}}",
            "type": "int"
          },
          {
            "name": "pageSize",
            "binding": "{{liste.sayfaBoyutu}}",
            "type": "int"
          }
        ]
      },
      {
        "id": "emir",
        "name": "emir",
        "kind": "read",
        "operation": "uretim.emir.getir",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "operasyonlar",
        "name": "operasyonlar",
        "kind": "read",
        "operation": "uretim.emir.operasyonlari",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "bilesenler",
        "name": "bilesenler",
        "kind": "read",
        "operation": "uretim.emir.bilesenleri",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "operatorler",
        "name": "operatorler",
        "kind": "read",
        "operation": "uretim.operatorler",
        "runOn": "load",
        "parameters": []
      },
      {
        "id": "cizelgele",
        "name": "cizelgele",
        "kind": "update",
        "operation": "uretim.emir.cizelgele",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "serbestBirak",
        "name": "serbestBirak",
        "kind": "update",
        "operation": "uretim.emir.serbestBirak",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "opBaslat",
        "name": "opBaslat",
        "kind": "update",
        "operation": "uretim.emir.operasyonBaslat",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "operationId",
            "binding": "{{operasyonTablosu.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "opTamamla",
        "name": "opTamamla",
        "kind": "update",
        "operation": "uretim.emir.operasyonTamamla",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "operationId",
            "binding": "{{operasyonTablosu.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "actualSetupMinutes",
            "binding": "{{kurulumDk.value}}",
            "type": "decimal"
          },
          {
            "name": "actualRunMinutes",
            "binding": "{{calismaDk.value}}",
            "type": "decimal"
          },
          {
            "name": "actualEnergyQuantityKwh",
            "binding": "{{enerjiKwh.value}}",
            "type": "decimal"
          },
          {
            "name": "actualEnergyCostPerKwhBase",
            "binding": "{{enerjiBedeli.value}}",
            "type": "decimal"
          },
          {
            "name": "performedByEmployeeId",
            "binding": "{{operator.value}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "tamamla",
        "name": "tamamla",
        "kind": "update",
        "operation": "uretim.emir.tamamla",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "actualGoodQuantity",
            "binding": "{{iyiMiktar.value}}",
            "type": "decimal"
          },
          {
            "name": "scrapQuantity",
            "binding": "{{fireMiktar.value}}",
            "type": "decimal"
          },
          {
            "name": "scrapReason",
            "binding": "{{fireNedeni.value}}",
            "type": "text"
          },
          {
            "name": "finishedGoodsTracking",
            "binding": "{{takip.satirlar}}",
            "type": "list"
          }
        ]
      },
      {
        "id": "iptal",
        "name": "iptal",
        "kind": "update",
        "operation": "uretim.emir.iptal",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      }
    ],
    "template": {
      "name": "list"
    }
  }
}
