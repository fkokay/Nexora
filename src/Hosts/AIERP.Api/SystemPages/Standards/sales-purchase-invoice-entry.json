{
  "screenKey": "sales-purchase-invoice-entry", "title": "Mal kabul faturası girişi",
  "description": "İşlenmiş mal kabullerini seçin; fatura kaydı sipariş ve stok kabulüyle bağlantısını korusun.", "module": "Satın Alma",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu (Faturayı kaydet)", "requires": ["component:kabulSecimi", "component:liste", "component:secDugmesi", "component:eskiEkranDugmesi", "query:kabuller", "query:faturala"]},
    "component:adimlar": {"since": 1, "label": "Adımlar (Mal kabul seç, Fatura bilgileri)", "requires": ["component:kabulSecimi"]},
    "component:kabulSecimi": {"since": 1, "label": "Seçili mal kabul (gizli)"},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:kabulSecimi", "component:liste"]},
    "component:listeNotu": {"since": 1, "label": "Faturalanabilir mal kabul notu", "requires": ["component:kabulSecimi"]},
    "component:liste": {"since": 1, "label": "Faturalanabilir mal kabuller (1. adım)", "requires": ["component:kabulSecimi", "component:secDugmesi", "query:kabuller"]},
    "component:secDugmesi": {"since": 1, "label": "Fatura gir düğmesi", "requires": ["component:kabulSecimi", "component:liste"]},
    "component:kabulBasligi": {"since": 1, "label": "Fatura önizlemesi özeti (2. adım)", "requires": ["component:kabulSecimi", "component:degistirDugmesi", "query:onizleme"]},
    "component:degistirDugmesi": {"since": 1, "label": "Mal kabul değiştir düğmesi", "requires": ["component:kabulSecimi"]},
    "component:onizlemeHatasi": {"since": 1, "label": "Önizleme hatası", "requires": ["component:kabulSecimi", "query:onizleme"]},
    "component:faturaBilgileri": {"since": 1, "label": "Fatura bilgileri", "requires": ["component:kabulSecimi", "component:faturaNo", "component:faturaTarihi", "component:profil"]},
    "component:faturaNo": {"since": 1, "label": "Fatura alanı: Tedarikçi fatura no"},
    "component:faturaTarihi": {"since": 1, "label": "Fatura alanı: Fatura tarihi"},
    "component:profil": {"since": 1, "label": "Fatura alanı: Vergi mevzuatı profili", "requires": ["query:profiller"]},
    "component:profilNotu": {"since": 1, "label": "Seçilen mevzuat profili notu", "requires": ["component:kabulSecimi", "component:profil", "query:onizleme"]},
    "component:eBelgeBilgileri": {"since": 1, "label": "Gelen e-belge bilgileri", "requires": ["component:kabulSecimi", "component:belgeUuid", "component:senaryo", "component:turKodu", "component:gonderen"]},
    "component:belgeUuid": {"since": 1, "label": "E-belge alanı: Belge UUID"},
    "component:senaryo": {"since": 1, "label": "E-belge alanı: Belge senaryosu"},
    "component:turKodu": {"since": 1, "label": "E-belge alanı: Belge tür kodu"},
    "component:gonderen": {"since": 1, "label": "E-belge alanı: Gönderen e-Fatura etiketi"},
    "component:satirlar": {"since": 1, "label": "Fatura satırları (önizleme)", "requires": ["component:kabulSecimi", "query:onizlemeSatirlari"]},
    "component:onizlemeNotu": {"since": 1, "label": "Sunucu önizlemesi notu", "requires": ["component:kabulSecimi"]},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Eski ekranda aç komutu", "requires": ["component:kabulSecimi"]},
    "query:kabuller": {"since": 1, "label": "Faturalanabilir mal kabulleri listele", "requires": ["component:suzgec", "component:liste"]},
    "query:onizleme": {"since": 1, "label": "Fatura önizlemesi (tutarlar, vade)", "requires": ["component:kabulSecimi", "component:faturaTarihi", "component:profil"]},
    "query:onizlemeSatirlari": {"since": 1, "label": "Fatura önizlemesi satırları", "requires": ["component:kabulSecimi", "component:faturaTarihi", "component:profil"]},
    "query:profiller": {"since": 1, "label": "Vergi mevzuatı profilleri"},
    "query:faturala": {"since": 1, "label": "Mal kabulü faturala",
      "requires": ["component:kabulSecimi", "component:faturaNo", "component:faturaTarihi", "component:profil", "component:belgeUuid",
                   "component:senaryo", "component:turKodu", "component:gonderen"]}
  },
  "screenViews": [ { "key": "purchase-invoice-receipt-selection", "component": "liste",
                     "fields": { "receipt": "receiptCode", "supplier": "supplierName", "receiptDate": "receiptDate", "warehouse": "warehouseName",
                                 "lineCount": "lineCount", "purchaseOrderTotal": "purchaseOrderTotal" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "saveQuery": "faturala", "exportTable": "liste", "focusInput": "suzgec",
                   "titleCount": "{{kabuller.meta.totalCount}} mal kabul fatura bekliyor",
                   "afterSaveAction": "page", "afterSavePageCode": "@sales-purchase-invoices", "afterSaveTarget": "sameTab",
                   "moreButtons": ["eskiEkranDugmesi"],
                   "commandWhen": ["save=kabulSecimi.value != null"],
                   "hiddenCommands": ["new", "open", "delete", "print"] } },

      { "id": "adimlar", "type": "steps", "name": "adimlar",
        "props": { "steps": ["Mal kabul seç", "Fatura bilgileri"],
                   "activeWhen": ["kabulSecimi.value == null", "kabulSecimi.value != null"] } },
      { "id": "kabulSecimi", "type": "input", "name": "kabulSecimi",
        "props": { "inputType": "text", "label": "Seçili mal kabul", "hidden": true, "defaultValue": "{{sayfa.parametre.receiptId}}" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 12, "search": true, "searchPlaceholder": "Mal kabul, sipariş, tedarikçi veya depo ara",
                   "searchParam": "q", "visibleWhen": "kabulSecimi.value == null" } },
      { "id": "listeNotu", "type": "text", "name": "listeNotu",
        "props": { "text": "Yalnızca siparişe bağlı, işlenmiş ve henüz faturalanmamış mal kabuller listelenir. Hizmet ve masraf faturaları bu ekrandan girilmez.",
                   "visibleWhen": "kabulSecimi.value == null" } },
      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Faturalanabilir mal kabuller", "query": "kabuller", "paging": "server", "pageSize": 25, "width": 12,
                   "visibleWhen": "kabulSecimi.value == null",
                   "columns": ["receiptCode", "supplierName", "receiptDate", "warehouseName", "lineCount", "purchaseOrderTotal"],
                   "columnLabels": ["receiptCode=Mal kabul / sipariş", "supplierName=Tedarikçi", "receiptDate=Kabul tarihi", "warehouseName=Depo",
                                    "lineCount=Satır", "purchaseOrderTotal=Sipariş toplamı", "currencyCode=Döviz", "purchaseOrderCode=Sipariş no"],
                   "columnUnits": ["receiptCode=purchaseOrderCode", "purchaseOrderTotal=currencyCode"],
                   "columnFormats": ["receiptCode=code", "receiptDate=date", "lineCount=number", "purchaseOrderTotal=money", "purchaseOrderCode=code"],
                   "rowActions": ["secDugmesi"], "rowOpenAction": "secDugmesi",
                   "emptyText": "Faturalanabilir mal kabul yok. Önce satın alma siparişi üzerinden mal kabul kaydedin." } },
      { "id": "secDugmesi", "type": "button", "name": "secDugmesi",
        "props": { "text": "Fatura gir ›", "actionType": "setInput", "assignments": ["kabulSecimi={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir mal kabul seçin" } },

      { "id": "kabulBasligi", "type": "recordHeader", "name": "kabulBasligi",
        "props": { "visibleWhen": "kabulSecimi.value != null", "icon": "receipt",
                   "title": "Alış faturası · {{onizleme.rows[0].receiptCode}}",
                   "subtitle": "{{onizleme.rows[0].supplierName}} · Sipariş {{onizleme.rows[0].purchaseOrderCode}}",
                   "fields": ["Ara toplam={{onizleme.rows[0].subtotal}}", "İskonto={{onizleme.rows[0].discountTotal}}",
                              "Vergi={{onizleme.rows[0].taxTotal}}", "Genel toplam={{onizleme.rows[0].grandTotal}}",
                              "Vade={{onizleme.rows[0].dueDate}}", "Vade süresi={{onizleme.rows[0].paymentTermDays}}"],
                   "fieldFormats": ["Ara toplam=money", "İskonto=money", "Vergi=money", "Genel toplam=money", "Vade=date", "Vade süresi=number"],
                   "fieldUnits": ["Ara toplam={{onizleme.rows[0].currencyCode}}", "İskonto={{onizleme.rows[0].currencyCode}}",
                                  "Vergi={{onizleme.rows[0].currencyCode}}", "Genel toplam={{onizleme.rows[0].currencyCode}}", "Vade süresi=gün"],
                   "buttons": ["degistirDugmesi"] } },
      { "id": "degistirDugmesi", "type": "button", "name": "degistirDugmesi",
        "props": { "text": "‹ Mal kabul değiştir", "actionType": "setInput", "assignments": ["kabulSecimi="] } },
      { "id": "onizlemeHatasi", "type": "alert", "name": "onizlemeHatasi",
        "props": { "title": "Fatura önizlemesi alınamadı", "variant": "danger", "width": 12, "text": "{{onizleme.error}}",
                   "visibleWhen": "kabulSecimi.value != null && onizleme.error != null" } },

      { "id": "faturaBilgileri", "type": "formCard", "name": "faturaBilgileri",
        "props": { "title": "Fatura bilgileri", "columns": 3, "width": 12, "inputs": ["faturaNo", "faturaTarihi", "profil"],
                   "visibleWhen": "kabulSecimi.value != null" } },
      { "id": "faturaNo", "type": "input", "name": "faturaNo",
        "props": { "inputType": "text", "label": "Tedarikçi fatura no", "required": true, "maxLength": 64, "placeholder": "AF-2026-0042" } },
      { "id": "faturaTarihi", "type": "input", "name": "faturaTarihi",
        "props": { "inputType": "date", "label": "Fatura tarihi", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "profil", "type": "input", "name": "profil",
        "props": { "inputType": "select", "label": "Vergi mevzuatı profili", "optionsQuery": "profiller", "optionValueColumn": "profileCode",
                   "optionLabelColumn": "name", "optionDescriptionColumn": "profileCode",
                   "optionsWhen": "satir.isActive == true && satir.hasTaxRules == true" } },
      { "id": "profilNotu", "type": "text", "name": "profilNotu",
        "props": { "text": "Profil seçilmezse firmanın belge varsayılanı kullanılır: {{onizleme.rows[0].accountingProfileCode}}.",
                   "visibleWhen": "kabulSecimi.value != null && profil.value == null && onizleme.rows[0].accountingProfileCode != null" } },

      { "id": "eBelgeBilgileri", "type": "formCard", "name": "eBelgeBilgileri",
        "props": { "title": "Gelen e-belge bilgileri", "columns": 2, "width": 12, "inputs": ["belgeUuid", "senaryo", "turKodu", "gonderen"],
                   "visibleWhen": "kabulSecimi.value != null" } },
      { "id": "belgeUuid", "type": "input", "name": "belgeUuid",
        "props": { "inputType": "text", "label": "Belge UUID (ETTN)", "maxLength": 36,
                   "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                   "patternMessage": "UUID 8-4-4-4-12 biçiminde olmalıdır." } },
      { "id": "senaryo", "type": "input", "name": "senaryo",
        "props": { "inputType": "select", "label": "Belge senaryosu",
                   "staticOptions": ["=Belirtilmedi", "TEMELFATURA=Temel fatura", "TICARIFATURA=Ticari fatura", "EARSIVFATURA=e-Arşiv fatura"] } },
      { "id": "turKodu", "type": "input", "name": "turKodu",
        "props": { "inputType": "select", "label": "Belge tür kodu",
                   "staticOptions": ["=Belirtilmedi", "SATIS=Satış", "IADE=İade", "TEVKIFAT=Tevkifat"] } },
      { "id": "gonderen", "type": "input", "name": "gonderen",
        "props": { "inputType": "text", "label": "Gönderen e-Fatura etiketi", "maxLength": 255 } },

      { "id": "satirlar", "type": "dataTable", "name": "satirlar",
        "props": { "title": "Fatura satırları", "query": "onizlemeSatirlari", "width": 12, "visibleWhen": "kabulSecimi.value != null",
                   "showPivot": false,
                   "columns": ["orderLineNumber", "stockCode", "stockName", "quantity", "unitPrice", "discountAmount", "lineSubtotal", "vatPercent", "taxAmount", "lineTotal"],
                   "columnLabels": ["orderLineNumber=#", "stockCode=Stok kodu", "stockName=Stok adı", "quantity=Miktar", "unitPrice=Birim fiyat",
                                    "discountAmount=İskonto", "lineSubtotal=Ara toplam", "vatPercent=KDV %", "taxAmount=Vergi", "lineTotal=Toplam",
                                    "discountPercent=İskonto %"],
                   "columnUnits": ["quantity=unitCode"],
                   "columnFormats": ["orderLineNumber=number", "stockCode=code", "quantity=number", "unitPrice=number", "discountAmount=money",
                                     "lineSubtotal=money", "vatPercent=number", "taxAmount=money", "lineTotal=money", "discountPercent=number"],
                   "emptyText": "Önizleme satırı yok." } },
      { "id": "onizlemeNotu", "type": "text", "name": "onizlemeNotu",
        "props": { "text": "Tutarlar ve vade sunucu önizlemesidir: kaydedilecek faturayla aynı hesap (artımlı satır tutarı, mevzuat profili vergileri ve tevkifat) kullanılır.",
                   "visibleWhen": "kabulSecimi.value != null" } },

      { "id": "eskiEkranDugmesi", "type": "button", "name": "eskiEkranDugmesi",
        "props": { "text": "Eski ekranda aç", "actionType": "erpPage", "pageKey": "sales-purchase-invoice-entry", "legacy": true,
                   "params": ["receiptId={{kabulSecimi.value}}"] } }
    ],
    "queries": [
      { "id": "kabuller", "name": "kabuller", "kind": "read", "operation": "satinalma.faturaGirisi.malKabulleri", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "onizleme", "name": "onizleme", "kind": "read", "operation": "satinalma.faturaGirisi.onizleme", "runOn": "load",
        "parameters": [
          { "name": "id", "binding": "{{kabulSecimi.value}}", "type": "guid" },
          { "name": "invoiceDate", "binding": "{{faturaTarihi.value}}", "type": "date" },
          { "name": "accountingProfileCode", "binding": "{{profil.value}}", "type": "text" } ] },
      { "id": "onizlemeSatirlari", "name": "onizlemeSatirlari", "kind": "read", "operation": "satinalma.faturaGirisi.onizlemeSatirlari", "runOn": "load",
        "parameters": [
          { "name": "id", "binding": "{{kabulSecimi.value}}", "type": "guid" },
          { "name": "invoiceDate", "binding": "{{faturaTarihi.value}}", "type": "date" },
          { "name": "accountingProfileCode", "binding": "{{profil.value}}", "type": "text" } ] },
      { "id": "profiller", "name": "profiller", "kind": "read", "operation": "satinalma.faturaGirisi.mevzuatProfilleri", "runOn": "load", "parameters": [] },
      { "id": "faturala", "name": "faturala", "kind": "insert", "operation": "satinalma.malKabul.faturala", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kabulSecimi.value}}", "type": "guid" },
          { "name": "code", "binding": "{{faturaNo.value}}", "type": "text" },
          { "name": "invoiceDate", "binding": "{{faturaTarihi.value}}", "type": "date" },
          { "name": "accountingProfileCode", "binding": "{{profil.value}}", "type": "text" },
          { "name": "providerInvoiceUuid", "binding": "{{belgeUuid.value}}", "type": "guid" },
          { "name": "providerScenario", "binding": "{{senaryo.value}}", "type": "text" },
          { "name": "providerInvoiceTypeCode", "binding": "{{turKodu.value}}", "type": "text" },
          { "name": "providerSenderAlias", "binding": "{{gonderen.value}}", "type": "text" } ] }
    ]
  }
}
