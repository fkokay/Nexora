{
  "screenKey": "inventory-stock",
  "title": "Stok Kartları",
  "description": "Stok kartları, depo bakiyeleri ve stok hareketleri.",
  "module": "Stok & Depo",
  "version": 3,
  "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1,"label": "İşlem çubuğu","requires": ["component:devreDisiBirak","component:etkinlestir","component:hareketGirDugmesi","component:hareketlerDugmesi","query:kartSil","component:suzgec","component:liste"]},
    "component:suzgec": {"since": 1,"label": "Süzgeç alanı (arama, depo, pasifler, minimum altı)","requires": ["component:liste","query:bakiye","query:depolar"]},
    "component:stokDegeriGostergesi": {"since": 1,"label": "Stok değeri göstergesi","requires": ["query:bakiye"]},
    "component:kullanilabilirGostergesi": {"since": 1,"label": "Kullanılabilir miktar göstergesi","requires": ["query:bakiye"]},
    "component:minimumAltiGostergesi": {"since": 1,"label": "Minimum altı göstergesi","requires": ["query:bakiye"]},
    "component:maliyetsizGostergesi": {"since": 1,"label": "Maliyetsiz göstergesi","requires": ["query:bakiye"]},
    "component:liste": {"since": 1,"label": "Stok kartları listesi","requires": ["query:bakiye","component:suzgec"]},
    "component:detayKarti": {"since": 1,"label": "Stok kartı özeti (sağ bölme)","requires": ["component:liste","component:hareketPenceresi","query:pasifeAl","query:aktifEt"]},
    "component:negatifStokKorumaAcik": {"since": 1,"label": "Negatif stok koruması bilgisi (açık)","requires": ["query:negatifStok"]},
    "component:devreDisiBirak": {"since": 1,"label": "Devre dışı bırak düğmesi","requires": ["query:pasifeAl","component:liste"]},
    "component:etkinlestir": {"since": 1,"label": "Etkinleştir düğmesi","requires": ["query:aktifEt","component:liste"]},
    "component:hareketGirDugmesi": {"since": 1,"label": "Hareket gir düğmesi","requires": ["component:hareketPenceresi","component:suzgec"]},
    "component:hareketlerDugmesi": {"since": 1,"label": "Hareketler düğmesi (hareket geçmişi ekranı)","requires": ["component:liste"]},
    "component:hareketPenceresi": {"since": 1,"label": "Hareket gir penceresi","requires": ["component:hareketFormu","query:hareketEkle","query:bakiye"]},
    "component:hareketFormu": {"since": 1,"label": "Yeni hareket formu","requires": ["component:hareketYonu","component:hareketTarihi","component:hareketBirimi","component:hareketMiktari","component:hareketAciklamasi","component:hareketKonumu","component:birimMaliyet"]},
    "component:hareketYonu": {"since": 1,"label": "Alan: Yön"},
