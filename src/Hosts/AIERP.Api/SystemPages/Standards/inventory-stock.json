      "requires": ["query:kart"] },
    "component:damgaVergisi": { "since": 1, "label": "Alan: Damga vergisi %",
      "requires": ["query:kart"] },
    "component:netAgirlik": { "since": 1, "label": "Alan: Net ağırlık",
      "requires": ["query:kart"] },
    "component:brutAgirlik": { "since": 1, "label": "Alan: Brüt ağırlık",
      "requires": ["query:kart"] },
