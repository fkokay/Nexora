      "requires": ["query:kart"] },
    "component:tedarikSuresi": { "since": 1, "label": "Alan: Tedarik süresi (gün)",
      "requires": ["query:kart"] },
    "component:uretimSuresi": { "since": 1, "label": "Alan: Üretim süresi (gün)",
      "requires": ["query:kart"] },
    "component:alisFiyati": { "since": 1, "label": "Alan: Alış liste fiyatı",
      "requires": ["query:kart"] },
    "component:satisFiyati": { "since": 1, "label": "Alan: Satış liste fiyatı",
      "requires": ["query:kart"] },
    "component:fiyatParaBirimi": { "since": 1, "label": "Alan: Fiyat para birimi",
      "requires": ["query:kart"] },
    "component:alisIndirimi": { "since": 1, "label": "Alan: Alış iskonto %",
