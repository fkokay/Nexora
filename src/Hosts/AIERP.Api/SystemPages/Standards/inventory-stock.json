      "requires": ["query:kart"] },
    "component:yukseklik": { "since": 1, "label": "Alan: Yükseklik",
      "requires": ["query:kart"] },
    "component:alisHesabi": { "since": 1, "label": "Alan: Alış hesap kodu",
      "requires": ["query:kart"] },
    "component:satisHesabi": { "since": 1, "label": "Alan: Satış hesap kodu",
      "requires": ["query:kart"] },
    "component:maliyetHesabi": { "since": 1, "label": "Alan: Maliyet hesap kodu",
      "requires": ["query:kart"] },
    "component:gorsel": { "since": 1, "label": "Alan: Ürün görseli bağlantısı",
      "requires": ["query:kart"] },
    "component:pazaryeriKimligi": { "since": 1, "label": "Alan: Pazaryeri ürün kimliği",
      "requires": ["query:kart"] },
    "component:negatifStokYasak": { "since": 1, "label": "Negatif stok notu (izin verilmez)",
      "requires": ["query:negatifStok"] },
    "component:negatifStokIzinli": { "since": 1, "label": "Negatif stok notu (izin verilir)",
      "requires": ["query:negatifStok"] },
    "component:negatifStokBilinmiyor": { "since": 1, "label": "Negatif stok notu (ayar okunamadı)",
      "requires": ["query:negatifStok"] },
    "component:gorselOnizleme": { "since": 1, "label": "Ürün görseli önizlemesi",
      "requires": ["component:gorsel"] },
    "component:birimIzgarasi": { "since": 1, "label": "Birim dönüşümleri",
      "requires": ["query:birimler", "component:anaBirim"] },
    "component:ozelAlanlar": { "since": 1, "label": "Özel alanlar",
      "requires": ["query:ozelTanimlar", "query:ozelDegerler"] },
    "component:varyantMatrisi": { "since": 1, "label": "Varyant boyutları",
      "requires": ["component:kod", "component:ad", "query:kart"] },
    "component:varyantListesi": { "since": 1, "label": "Kartın varyantları",
      "requires": ["query:varyantlar", "query:kart"] },
    "component:receteListesi": { "since": 1, "label": "Kartı üreten reçeteler",
      "requires": ["query:receteler", "query:kart"] },
    "query:kategoriler": { "since": 1, "label": "Stok kategorileri" },
    "query:negatifStok": { "since": 1, "label": "Negatif stok kuralı" },
    "query:birimler": { "since": 1, "label": "Seçili kartın birimleri",
      "requires": ["query:kart"] },
    "query:ozelTanimlar": { "since": 1, "label": "Özel alan tanımları" },
    "query:ozelDegerler": { "since": 1, "label": "Seçili kartın özel alan değerleri",
      "requires": ["query:kart"] },
    "query:varyantlar": { "since": 1, "label": "Seçili kartın varyantları",
      "requires": ["query:kart"] },
    "query:receteler": { "since": 1, "label": "Seçili kartı üreten reçeteler",
      "requires": ["query:kart"] },
    "query:olustur": { "since": 1, "label": "Stok kartı oluştur",
      "requires": ["component:ozelAlanlar", "component:varyantMatrisi", "component:kod", "component:ad", "component:barkod", "component:kategori", "component:takipTuru", "component:anaBirim", "component:minimumStok", "component:maksimumStok", "component:yenidenSiparisNoktasi", "component:emniyetStoku", "component:tedarikSuresi", "component:uretimSuresi", "component:alisFiyati", "component:satisFiyati", "component:fiyatParaBirimi", "component:alisIndirimi", "component:satisIndirimi", "component:alisKdv", "component:satisKdv", "component:otv", "component:oiv", "component:tevkifat", "component:damgaVergisi", "component:netAgirlik", "component:brutAgirlik", "component:uzunluk", "component:genislik", "component:yukseklik", "component:alisHesabi", "component:satisHesabi", "component:maliyetHesabi", "component:gorsel", "component:pazaryeriKimligi"] },
    "query:guncelle": { "since": 1, "label": "Stok kartını güncelle",
      "requires": ["query:kart", "component:kod", "component:ad", "component:barkod", "component:kategori", "component:takipTuru", "component:anaBirim", "component:minimumStok", "component:maksimumStok", "component:yenidenSiparisNoktasi", "component:emniyetStoku", "component:tedarikSuresi", "component:uretimSuresi", "component:alisFiyati", "component:satisFiyati", "component:fiyatParaBirimi", "component:alisIndirimi", "component:satisIndirimi", "component:alisKdv", "component:satisKdv", "component:otv", "component:oiv", "component:tevkifat", "component:damgaVergisi", "component:netAgirlik", "component:brutAgirlik", "component:uzunluk", "component:genislik", "component:yukseklik", "component:alisHesabi", "component:satisHesabi", "component:maliyetHesabi", "component:gorsel", "component:pazaryeriKimligi"] },
    "query:birimEkle": { "since": 1, "label": "Kayıtlı karta birim ekle",
      "requires": ["query:kart", "component:birimIzgarasi"] },
    "query:birimEkleYeni": { "since": 1, "label": "Yeni karta birim ekle",
      "requires": ["query:olustur", "component:birimIzgarasi"] },
    "query:birimSil": { "since": 1, "label": "Karttan birim sil",
      "requires": ["query:kart", "component:birimIzgarasi"] },
    "query:ozelKaydet": { "since": 1, "label": "Özel alanları kaydet",
      "requires": ["query:kart", "query:ozelDegerler", "component:ozelAlanlar"] }
  },
  "screenViews": [ { "key": "inventory-stock", "component": "liste",
    "fields": { "code": "balance.code", "name": "balance.name", "category": "stockItem.category",
                "quantityOnHand": "balance.quantityOnHand", "reservedQuantity": "balance.reservedQuantity",
                "availableQuantity": "balance.availableQuantity", "minimumStock": "balance.minimumStock",
                "valuationAmountBase": "balance.valuationAmountBase", "unvaluedQuantity": "balance.unvaluedQuantity",
                "status": "status" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "deleteQuery": "kartSil", "focusInput": "aramaKutusu", "exportTable": "liste",
                   "moreButtons": ["devreDisiBirak", "etkinlestir"],
                   "formDialog": "kartPenceresi", "newInputs": ["kod"] } },

      { "id": "suzgecKarti", "type": "formCard", "name": "suzgecKarti",
        "props": { "title": "Süzgeçler", "columns": 3, "inputs": ["depoSecimi", "minimumAlti", "pasifler"] } },
      { "id": "depoSecimi", "type": "input", "name": "depoSecimi",
        "props": { "inputType": "lookup", "label": "Depo", "optionsQuery": "depolar", "optionValueColumn": "id",
                   "optionLabelColumn": "name", "optionDescriptionColumn": "code", "staticOptions": ["=Tüm depolar"],
                   "minChars": 0, "allowClear": true } },
      { "id": "minimumAlti", "type": "input", "name": "minimumAlti",
        "props": { "inputType": "checkbox", "label": "Minimum altı ({{bakiye.meta.belowMinimumCount}})" } },
      { "id": "pasifler", "type": "input", "name": "pasifler",
        "props": { "inputType": "checkbox", "label": "Pasif kartları da göster" } },

      { "id": "stokDegeriGostergesi", "type": "metric", "name": "stokDegeriGostergesi",
        "props": { "title": "Stok değeri", "value": "{{bakiye.meta.pageValuationAmountBase}}", "format": "money",
                   "description": "Bu sayfa · {{bakiye.meta.baseCurrencyCode}}", "icon": "wallet" } },
      { "id": "kullanilabilirGostergesi", "type": "metric", "name": "kullanilabilirGostergesi",
        "props": { "title": "Kullanılabilir", "value": "{{bakiye.meta.pageAvailableQuantity}}", "format": "number",
                   "description": "Bu sayfa · {{bakiye.meta.pageUnitCode}}", "variant": "success", "icon": "box",
                   "visibleWhen": "bakiye.meta.pageUnitCode != null" } },
      { "id": "kullanilabilirKartGostergesi", "type": "metric", "name": "kullanilabilirKartGostergesi",
        "props": { "title": "Kullanılabilir stoklu kart", "value": "{{bakiye.meta.pageAvailableCount}}", "format": "number",
                   "description": "Bu sayfa", "variant": "success", "icon": "box",
                   "visibleWhen": "bakiye.meta.pageUnitCode == null" } },
      { "id": "minimumAltiGostergesi", "type": "metric", "name": "minimumAltiGostergesi",
        "props": { "title": "Minimum altı", "value": "{{bakiye.meta.belowMinimumCount}}", "format": "number",
                   "description": "Seçili kapsam (arama hariç)", "variant": "danger", "icon": "alert",
                   "filterInput": "minimumAlti", "filterValue": "true" } },
      { "id": "maliyetsizGostergesi", "type": "metric", "name": "maliyetsizGostergesi",
        "props": { "title": "Maliyetsiz", "value": "{{bakiye.meta.pageUnvaluedCount}}", "format": "number",
                   "description": "Bu sayfa", "variant": "warning", "icon": "alert" } },

      { "id": "aramaKutusu", "type": "input", "name": "aramaKutusu",
        "props": { "inputType": "text", "label": "Ara", "placeholder": "Kod, ad, barkod veya kategori" } },
      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Stok kartları", "query": "bakiye", "paging": "server", "pageSize": 25, "searchInput": "aramaKutusu",
                   "columns": ["balance.code", "balance.name", "stockItem.category", "balance.quantityOnHand",
                               "balance.reservedQuantity", "balance.availableQuantity", "balance.minimumStock",
                               "balance.valuationAmountBase", "balance.unvaluedQuantity", "status"],
                   "columnFormats": ["balance.code=code", "balance.quantityOnHand=number", "balance.reservedQuantity=number",
                                     "balance.availableQuantity=number", "balance.minimumStock=number",
                                     "balance.unvaluedQuantity=number", "balance.valuationAmountBase=money", "status=status"],
                   "toneMap": ["Minimum altı=danger", "Maliyetsiz=warning", "Yeterli=success", "Pasif=info"],
                   "footerMeta": ["belowMinimumCount=Minimum altı"] } },

      { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
        "props": { "tabs": ["Özet=ozetPaneli", "Depolar=kartDepoTablosu", "Hareketler=sonHareketTablosu"],
                   "visibleWhen": "liste.seciliSatir.stockItem.id != null" } },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "title": "{{liste.seciliSatir.balance.code}} · {{liste.seciliSatir.balance.name}}",
                   "fields": ["balance.quantityOnHand=Bakiye", "balance.availableQuantity=Kullanılabilir",
                              "balance.reservedQuantity=Rezerve", "balance.minimumStock=Minimum",
                              "balance.valuationAmountBase=Stok değeri", "balance.unvaluedQuantity=Maliyetsiz",
                              "stockItem.category=Kategori", "balance.unitCode=Birim",
                              "stockItem.trackingMode=Lot / seri", "status=Durum"] } },
      { "id": "kartDepoTablosu", "type": "dataTable", "name": "kartDepoTablosu",
        "props": { "query": "kartDepolari",
                   "columns": ["warehouseCode", "warehouseName", "quantityOnHand", "reservedQuantity", "availableQuantity",
                               "valuationAmountBase", "unvaluedQuantity"],
                   "emptyText": "Bu kartın depo bakiyesi yok." } },
      { "id": "sonHareketTablosu", "type": "dataTable", "name": "sonHareketTablosu",
        "props": { "query": "sonHareketler", "limit": 5,
                   "columns": ["entryDate", "warehouseCode", "direction", "quantity", "description"],
                   "emptyText": "Hareket yok." } },

      { "id": "devreDisiBirak", "type": "button", "name": "devreDisiBirak",
        "props": { "text": "Devre dışı bırak", "actionType": "query", "queryId": "pasifeAl", "confirmEnabled": true,
                   "confirmText": "“{{liste.seciliSatir.balance.name}}” devre dışı bırakılsın mı? Bakiyesi sıfır olmayan veya açık siparişte kullanılan kart devre dışı bırakılamaz.",
                   "successMessage": "Stok kartı devre dışı bırakıldı.", "refreshQueries": ["bakiye"],
                   "visibleWhen": "liste.seciliSatir.stockItem.isActive == true" } },
      { "id": "etkinlestir", "type": "button", "name": "etkinlestir",
        "props": { "text": "Etkinleştir", "actionType": "query", "queryId": "aktifEt", "confirmEnabled": true,
                   "confirmText": "“{{liste.seciliSatir.balance.name}}” yeniden etkinleştirilsin mi?",
                   "successMessage": "Stok kartı etkinleştirildi.", "refreshQueries": ["bakiye"],
                   "visibleWhen": "liste.seciliSatir.stockItem.isActive == false" } },

      { "id": "kartPenceresi", "type": "dialog", "name": "kartPenceresi",
        "props": { "presentation": "drawer", "title": "Stok kartı {{kart.rows[0].code}}", "contains": ["kartSekmeleri"],
                   "saveSequence": ["olustur", "guncelle", "birimEkleYeni", "birimEkle", "birimSil", "ozelKaydet"], "stopOnError": true,
                   "sequenceWhen": ["olustur=kart.rows[0].id == null && olustur.sonuc.id == null", "guncelle=kart.rows[0].id != null",
                                    "birimEkleYeni=kart.rows[0].id == null", "birimEkle=kart.rows[0].id != null",
                                    "ozelKaydet=kart.rows[0].id != null"],
                   "saveLabel": "Kaydet", "closeOnSave": true, "resetOnOpen": true, "refreshQueries": ["bakiye"] } },
      { "id": "kartSekmeleri", "type": "tabs", "name": "kartSekmeleri",
        "props": { "tabs": ["Genel=kimlikKarti,stokKarti,negatifStokYasak,negatifStokIzinli,negatifStokBilinmiyor",
                            "Fiyat ve vergi=fiyatKarti,vergiKarti", "Lojistik ve muhasebe=lojistikKarti,muhasebeKarti",
                            "Görsel=gorselKarti,gorselOnizleme", "Birimler=birimIzgarasi", "Özel alanlar=ozelAlanlar",
