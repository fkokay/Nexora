    "component:hareketMiktari": {"since": 1,"label": "Alan: Miktar"},
    "component:hareketAciklamasi": {"since": 1,"label": "Alan: Açıklama"},
    "component:hareketKonumu": {"since": 1,"label": "Alan: Depo konumu","requires": ["query:konumlar"]},
    "component:birimMaliyet": {"since": 1,"label": "Alan: Birim maliyet","requires": ["component:hareketYonu"]},
    "query:bakiye": {"since": 1,"label": "Stok bakiyeleri (sayfalı)","requires": ["component:suzgec","component:liste"]},
    "query:depolar": {"since": 1,"label": "Depoları listele"},
    "query:kartSil": {"since": 1,"label": "Stok kartını sil","requires": ["component:liste"]},
