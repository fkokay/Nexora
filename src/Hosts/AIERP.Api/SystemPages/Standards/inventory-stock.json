{
  "screenKey": "inventory-stock", "title": "Stok Kartları",
  "description": "Stok kartları, depo bakiyeleri ve stok hareketleri.", "module": "Stok & Depo",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": { "since": 1, "label": "İşlem çubuğu",
      "requires": ["component:devreDisiBirak", "component:etkinlestir", "query:kartSil", "component:suzgec", "component:liste",
                 "component:hareketlerDugmesi"] },
    "component:suzgec": { "since": 1, "label": "Süzgeç alanı (arama, depo, pasifler)",
      "requires": ["component:liste", "query:bakiye", "query:depolar"] },
    "component:gorunumKarti": { "since": 1, "label": "Minimum altı anahtarı",
      "requires": ["component:minimumAlti"] },
    "component:detayPaneli": { "since": 1, "label": "Detay paneli anahtarı" },
    "component:minimumAlti": { "since": 1, "label": "Yalnız minimum altı", "requires": ["query:bakiye"] },
    "component:stokDegeriGostergesi": { "since": 1, "label": "Stok değeri göstergesi", "requires": ["query:bakiye"] },
    "component:kullanilabilirGostergesi": { "since": 1, "label": "Kullanılabilir miktar göstergesi", "requires": ["query:bakiye"] },
    "component:kullanilabilirKartGostergesi": { "since": 1, "label": "Kullanılabilir stoklu kart göstergesi", "requires": ["query:bakiye"] },
    "component:minimumAltiGostergesi": { "since": 1, "label": "Minimum altı göstergesi", "requires": ["query:bakiye", "component:minimumAlti"] },
    "component:maliyetsizGostergesi": { "since": 1, "label": "Maliyetsiz göstergesi", "requires": ["query:bakiye"] },
    "component:liste": { "since": 1, "label": "Stok kartları listesi", "requires": ["query:bakiye", "component:suzgec", "component:detayPaneli"] },
    "component:negatifStokKorumaAcik": { "since": 1, "label": "Negatif stok koruması bilgisi (açık)",
      "requires": ["query:negatifStok"] },
    "component:negatifStokKorumaKapali": { "since": 1, "label": "Negatif stok koruması bilgisi (kapalı)",
      "requires": ["query:negatifStok"] },
    "component:ozetBakiye": { "since": 1, "label": "Kart özeti: bakiye", "requires": ["component:liste"] },
    "component:ozetKullanilabilir": { "since": 1, "label": "Kart özeti: kullanılabilir", "requires": ["component:liste"] },
    "component:ozetRezerve": { "since": 1, "label": "Kart özeti: rezerve", "requires": ["component:liste"] },
    "component:ozetMinimum": { "since": 1, "label": "Kart özeti: minimum", "requires": ["component:liste"] },
    "component:ozetHareketler": { "since": 1, "label": "Kart özeti: Hareketler / ekle düğmesi",
      "requires": ["component:hareketPenceresi", "component:suzgec", "component:liste"] },
    "component:detayKarti": { "since": 1, "label": "Detay paneli (eski sağ panel)",
      "requires": ["component:detayPaneli", "component:liste", "query:pasifeAl", "query:bakiye",
                   "component:ozetBakiye", "component:ozetKullanilabilir", "component:ozetRezerve", "component:ozetMinimum",
                   "component:ozetPaneli", "component:ozetHareketler", "component:kartDepoTablosu", "component:sonHareketTablosu"] },
    "component:ozetPaneli": { "since": 1, "label": "Kart özeti", "requires": ["component:liste"] },
    "component:kartDepoTablosu": { "since": 1, "label": "Kartın depo bakiyeleri", "requires": ["query:kartDepolari"] },
    "component:sonHareketTablosu": { "since": 1, "label": "Kartın son hareketleri", "requires": ["query:sonHareketler"] },
    "component:devreDisiBirak": { "since": 1, "label": "Devre dışı bırak düğmesi", "requires": ["query:pasifeAl", "query:bakiye"] },
    "component:etkinlestir": { "since": 1, "label": "Etkinleştir düğmesi", "requires": ["query:aktifEt", "query:bakiye"] },
    "query:bakiye": { "since": 1, "label": "Stok bakiyeleri (sayfalı)" },
    "query:depolar": { "since": 1, "label": "Depoları listele" },
    "query:kart": { "since": 1, "label": "Seçili stok kartı" },
    "query:kartDepolari": { "since": 1, "label": "Seçili kartın depo bakiyeleri" },
    "query:sonHareketler": { "since": 1, "label": "Seçili kartın hareketleri" },
    "query:kartSil": { "since": 1, "label": "Stok kartını sil" },
    "query:pasifeAl": { "since": 1, "label": "Stok kartını devre dışı bırak", "requires": ["query:kart"] },
    "query:aktifEt": { "since": 1, "label": "Stok kartını etkinleştir", "requires": ["query:kart"] },
    "query:negatifStok": { "since": 1, "label": "Negatif stok kuralı" },
    "query:birimler": { "since": 1, "label": "Seçili kartın birimleri",
      "requires": ["query:kart"] },
    "component:hareketlerDugmesi": { "since": 1, "label": "Hareketler / ekle düğmesi",
      "requires": ["component:hareketPenceresi", "component:suzgec", "component:liste"] },
    "component:hareketPenceresi": { "since": 1, "label": "Stok hareketleri penceresi",
      "requires": ["component:hareketFormu", "component:izlemeSatirlari", "component:hareketTablosu", "query:hareketEkle",
                   "query:hareketler", "query:kartDepolari", "query:sonHareketler", "query:bakiye"] },
    "component:hareketFormu": { "since": 1, "label": "Yeni hareket formu",
      "requires": ["component:hareketYonu", "component:hareketTarihi", "component:hareketBirimi", "component:hareketMiktari",
                   "component:hareketAciklamasi", "component:hareketKonumu", "component:birimMaliyet"] },
    "component:hareketYonu": { "since": 1, "label": "Hareket alanı: Yön" },
    "component:hareketTarihi": { "since": 1, "label": "Hareket alanı: Tarih" },
    "component:hareketBirimi": { "since": 1, "label": "Hareket alanı: Hareket birimi", "requires": ["query:birimler"] },
    "component:hareketMiktari": { "since": 1, "label": "Hareket alanı: Miktar" },
    "component:hareketAciklamasi": { "since": 1, "label": "Hareket alanı: Açıklama" },
    "component:hareketKonumu": { "since": 1, "label": "Hareket alanı: Depo konumu", "requires": ["query:konumlar"] },
    "component:birimMaliyet": { "since": 1, "label": "Hareket alanı: Birim maliyet", "requires": ["component:hareketYonu"] },
    "component:izlemeSatirlari": { "since": 1, "label": "Lot / seri satırları", "requires": ["component:liste"] },
    "component:hareketTablosu": { "since": 1, "label": "Depodaki stok hareketleri",
      "requires": ["query:hareketler", "component:tersKayitDugmesi"] },
    "component:tersKayitDugmesi": { "since": 1, "label": "Ters kayıt düğmesi",
      "requires": ["query:tersKayit", "query:hareketler", "query:kartDepolari", "query:sonHareketler"] },
    "query:konumlar": { "since": 1, "label": "Seçili deponun konumları" },
    "query:hareketler": { "since": 1, "label": "Seçili kartın depo hareketleri (sayfalı)" },
    "query:hareketEkle": { "since": 1, "label": "Stok hareketi ekle",
      "requires": ["component:hareketYonu", "component:hareketTarihi", "component:hareketBirimi", "component:hareketMiktari",
                   "component:hareketAciklamasi", "component:hareketKonumu", "component:birimMaliyet", "component:izlemeSatirlari"] },
    "query:tersKayit": { "since": 1, "label": "Stok hareketini ters kayıtla düzelt",
      "requires": ["component:hareketTablosu", "component:tersKayitDugmesi"] }
  },
  "screenViews": [ { "key": "inventory-stock", "component": "liste",
    "fields": { "code": "balance.code", "name": "balance.name", "category": "stockItem.category",
                "quantityOnHand": "balance.quantityOnHand", "reservedQuantity": "balance.reservedQuantity",
                "availableQuantity": "balance.availableQuantity", "minimumStock": "balance.minimumStock",
                "valuationAmountBase": "balance.valuationAmountBase", "unvaluedQuantity": "balance.unvaluedQuantity",
                "status": "status" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "deleteQuery": "kartSil", "deleteConfirmText": "{{liste.seciliSatir.balance.code}} · {{liste.seciliSatir.balance.name}} stok kartı silinsin mi?", "focusInput": "suzgec", "exportTable": "liste",
                   "moreButtons": ["devreDisiBirak", "etkinlestir", "hareketlerDugmesi"],
                   "newAction": "page", "newPageCode": "@inventory-stock-create", "newTarget": "newTab",
                   "openAction": "page", "openPageCode": "@inventory-stock-create", "openTarget": "newTab", "openTable": "liste",
                   "openParams": ["id={{liste.seciliSatir.stockItem.id}}"],
                   "titleCount": "{{bakiye.meta.totalCount}}" } },

      { "id": "stokDegeriGostergesi", "type": "metric", "name": "stokDegeriGostergesi",
        "props": { "title": "Stok değeri", "value": "{{bakiye.meta.pageValuationAmountBase}}", "format": "money",
                   "description": "bu sayfa · {{bakiye.meta.baseCurrencyCode}}", "icon": "wallet" } },
      { "id": "kullanilabilirGostergesi", "type": "metric", "name": "kullanilabilirGostergesi",
        "props": { "title": "Kullanılabilir", "value": "{{bakiye.meta.pageAvailableQuantity}}", "format": "number",
                   "description": "bu sayfa · {{bakiye.meta.pageUnitCode}}", "variant": "success", "icon": "box",
                   "visibleWhen": "bakiye.meta.pageUnitCode != null" } },
      { "id": "kullanilabilirKartGostergesi", "type": "metric", "name": "kullanilabilirKartGostergesi",
        "props": { "title": "Kullanılabilir stoklu kart", "value": "{{bakiye.meta.pageAvailableCount}}", "format": "number",
                   "description": "bu sayfa", "variant": "success", "icon": "box",
                   "visibleWhen": "bakiye.meta.pageUnitCode == null" } },
      { "id": "minimumAltiGostergesi", "type": "metric", "name": "minimumAltiGostergesi",
        "props": { "title": "Minimum altı", "value": "{{bakiye.meta.belowMinimumCount}}", "format": "number",
                   "description": "seçili depolarda (arama hariç)", "variant": "danger", "icon": "alert",
                   "filterInput": "minimumAlti", "filterValue": "true" } },
      { "id": "maliyetsizGostergesi", "type": "metric", "name": "maliyetsizGostergesi",
        "props": { "title": "Maliyetsiz", "value": "{{bakiye.meta.pageUnvaluedCount}}", "format": "number",
                   "description": "bu sayfa", "variant": "warning", "icon": "alert" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 9, "search": true, "searchPlaceholder": "Kod veya stok adıyla ara", "searchParam": "q",
                   "filters": ["warehouseId|select|row|warehouseId|Depo|depolar:id:name",
                               "includeInactive|toggle|row|includeInactive|Pasif kartları da göster"] } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": { "title": "Görünüm", "layout": "inline", "width": 3, "inputs": ["minimumAlti"] } },
      { "id": "minimumAlti", "type": "input", "name": "minimumAlti",
        "props": { "inputType": "checkbox", "label": "Minimum altı", "description": "{{bakiye.meta.belowMinimumCount}}" } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },
      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Stok kartları", "query": "bakiye", "paging": "server", "pageSize": 25, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.stockItem.id != null",
                   "detailToggleInput": "detayPaneli",
                   "columns": ["balance.code", "balance.name", "stockItem.category", "balance.quantityOnHand",
                               "balance.reservedQuantity", "balance.availableQuantity", "balance.minimumStock",
                               "balance.valuationAmountBase", "balance.unvaluedQuantity", "status"],
                   "columnLabels": ["balance.code=Stok kodu", "balance.name=Stok adı", "stockItem.category=Kategori",
                                    "balance.quantityOnHand=Depo bakiyesi", "balance.reservedQuantity=Rezerve",
                                    "balance.availableQuantity=Kullanılabilir", "balance.minimumStock=Minimum",
                                    "balance.valuationAmountBase=Stok değeri", "balance.unvaluedQuantity=Maliyetsiz miktar", "status=Durum"],
                   "columnUnits": ["balance.quantityOnHand=balance.unitCode", "balance.reservedQuantity=balance.unitCode",
                                   "balance.availableQuantity=balance.unitCode", "balance.unvaluedQuantity=balance.unitCode",
                                   "balance.valuationAmountBase=balance.baseCurrencyCode"],
                   "columnFormats": ["balance.code=code", "balance.quantityOnHand=number", "balance.reservedQuantity=number",
                                     "balance.availableQuantity=number", "balance.minimumStock=number",
                                     "balance.unvaluedQuantity=number", "balance.valuationAmountBase=money", "status=status"],
                   "toneMap": ["Minimum altı=danger", "Maliyetsiz=warning", "Yeterli=success", "Pasif=info"],
                   "valueLabels": ["stockItem.trackingMode:None=Yok", "stockItem.trackingMode:Lot=Lot", "stockItem.trackingMode:Serial=Seri"],
                   "footerMeta": ["belowMinimumCount=Minimum altı"] } },
      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.balance.name}}", "description": "{{liste.seciliSatir.balance.code}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.stockItem.id != null" },
        "children": [
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@inventory-stock-create", "target": "newTab",
                       "params": ["id={{liste.seciliSatir.stockItem.id}}"] } },
          { "id": "detayDurum", "type": "badge", "name": "detayDurum",
            "props": { "text": "{{liste.seciliSatir.status}}",
                       "toneMap": ["Minimum altı=danger", "Maliyetsiz=warning", "Yeterli=success", "Pasif=info"] } },
          { "id": "detayLot", "type": "badge", "name": "detayLot",
            "props": { "text": "Lot takipli", "visibleWhen": "liste.seciliSatir.stockItem.trackingMode == 'Lot'" } },
          { "id": "detaySeri", "type": "badge", "name": "detaySeri",
            "props": { "text": "Seri no takipli", "visibleWhen": "liste.seciliSatir.stockItem.trackingMode == 'Serial'" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetBakiye,ozetKullanilabilir,ozetRezerve,ozetMinimum,ozetPaneli,ozetHareketler",
                                "Depolar=kartDepoTablosu", "Hareketler=sonHareketTablosu"] } },
          { "id": "detayDevreDisi", "type": "button", "name": "detayDevreDisi",
            "props": { "text": "Devre dışı bırak", "actionType": "query", "queryId": "pasifeAl", "confirmEnabled": true,
                       "confirmText": "“{{liste.seciliSatir.balance.name}}” devre dışı bırakılsın mı? Bakiyesi sıfır olmayan veya açık siparişte kullanılan kart devre dışı bırakılamaz.",
                       "successMessage": "Stok kartı devre dışı bırakıldı.", "refreshQueries": ["bakiye"],
                       "visibleWhen": "liste.seciliSatir.stockItem.isActive == true" } }
        ] },
      { "id": "negatifStokKorumaAcik", "type": "alert", "name": "negatifStokKorumaAcik",
        "props": { "title": "Negatif stok koruması açık", "variant": "success", "width": 12, "icon": "shield", "value": "Etkin",
                   "text": "Hareketler sıralı kaydedilir · Değer ağırlıklı ortalama · Maliyetsiz miktar ayrı izlenir",
                   "visibleWhen": "negatifStok.rows[0].allowNegativeStock == false" } },
      { "id": "negatifStokKorumaKapali", "type": "alert", "name": "negatifStokKorumaKapali",
        "props": { "title": "Negatif stoka izin veriliyor", "variant": "warning", "width": 12, "icon": "shieldAlert", "value": "İzinli",
                   "text": "Takipsiz ve konumsuz çıkışlar bakiyeyi eksiye düşürebilir · Değer ağırlıklı ortalama · Maliyetsiz miktar ayrı izlenir",
                   "visibleWhen": "negatifStok.rows[0].allowNegativeStock == true" } },

      { "id": "ozetBakiye", "type": "metric", "name": "ozetBakiye",
        "props": { "title": "Depo bakiyesi", "value": "{{liste.seciliSatir.balance.quantityOnHand}}", "format": "number", "width": 6,
                   "description": "{{liste.seciliSatir.balance.unitCode}}", "icon": "box" } },
      { "id": "ozetKullanilabilir", "type": "metric", "name": "ozetKullanilabilir",
        "props": { "title": "Kullanılabilir", "value": "{{liste.seciliSatir.balance.availableQuantity}}", "format": "number", "width": 6,
                   "description": "{{liste.seciliSatir.balance.unitCode}}", "variant": "success", "icon": "check" } },
      { "id": "ozetRezerve", "type": "metric", "name": "ozetRezerve",
        "props": { "title": "Rezerve", "value": "{{liste.seciliSatir.balance.reservedQuantity}}", "format": "number", "width": 6,
                   "description": "{{liste.seciliSatir.balance.unitCode}}", "variant": "warning", "icon": "clock" } },
      { "id": "ozetMinimum", "type": "metric", "name": "ozetMinimum",
        "props": { "title": "Minimum", "value": "{{liste.seciliSatir.balance.minimumStock}}", "format": "number", "width": 6,
                   "description": "{{liste.seciliSatir.balance.unitCode}}" } },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["balance.valuationAmountBase=Stok değeri", "balance.unvaluedQuantity=Maliyetsiz miktar",
                              "stockItem.category=Kategori", "balance.unitCode=Birim"] } },
      { "id": "ozetHareketler", "type": "button", "name": "ozetHareketler",
        "props": { "text": "Hareketler / ekle", "actionType": "openDialog", "dialogId": "hareketPenceresi", "width": 12,
                   "disabledWhen": "suzgec.warehouseId == null", "disabledReason": "Hareket için önce bir depo seçin." } },
      { "id": "kartDepoTablosu", "type": "dataTable", "name": "kartDepoTablosu",
        "props": { "query": "kartDepolari", "width": 12, "variant": "bars", "title": "Depo dağılımı",
                   "columns": ["warehouseName", "quantityOnHand"], "columnFormats": ["quantityOnHand=number"],
                   "emptyText": "Bu kartın depo bakiyesi yok." } },
      { "id": "sonHareketTablosu", "type": "dataTable", "name": "sonHareketTablosu",
        "props": { "query": "sonHareketler", "limit": 5, "width": 12, "variant": "list", "title": "Son hareketler",
                   "columns": ["description", "entryDate", "warehouseCode", "direction", "quantity"],
                   "columnFormats": ["entryDate=date", "quantity=number"],
                   "valueLabels": ["direction:Receipt=Giriş", "direction:Issue=Çıkış"], "toneMap": ["Giriş=success", "Çıkış=danger"],
                   "emptyText": "Henüz hareket yok." } },

      { "id": "devreDisiBirak", "type": "button", "name": "devreDisiBirak",
        "props": { "text": "Devre dışı bırak", "actionType": "query", "queryId": "pasifeAl", "confirmEnabled": true,
                   "confirmText": "“{{liste.seciliSatir.balance.name}}” devre dışı bırakılsın mı? Bakiyesi sıfır olmayan veya açık siparişte kullanılan kart devre dışı bırakılamaz.",
                   "successMessage": "Stok kartı devre dışı bırakıldı.", "refreshQueries": ["bakiye"],
                   "visibleWhen": "liste.seciliSatir.stockItem.isActive == true" } },
      { "id": "etkinlestir", "type": "button", "name": "etkinlestir",
        "props": { "text": "Etkinleştir", "actionType": "query", "queryId": "aktifEt", "confirmEnabled": true,
                   "confirmText": "“{{liste.seciliSatir.balance.name}}” yeniden etkinleştirilsin mi?",
                   "successMessage": "Stok kartı etkinleştirildi.", "refreshQueries": ["bakiye"],
                   "visibleWhen": "liste.seciliSatir.stockItem.isActive == false" } },

      { "id": "hareketlerDugmesi", "type": "button", "name": "hareketlerDugmesi",
        "props": { "text": "Hareketler / ekle", "actionType": "openDialog", "dialogId": "hareketPenceresi",
                   "visibleWhen": "liste.seciliSatir.stockItem.id != null", "disabledWhen": "suzgec.warehouseId == null",
                   "disabledReason": "Hareket için önce bir depo seçin." } },
      { "id": "hareketPenceresi", "type": "dialog", "name": "hareketPenceresi",
        "props": { "presentation": "dialog", "title": "Stok hareketleri · {{liste.seciliSatir.balance.code}} · {{suzgec.seciliSatir.warehouseId.name}}",
                   "contains": ["hareketFormu", "izlemeSatirlari", "hareketTablosu"], "saveQuery": "hareketEkle",
                   "saveLabel": "Hareketi kaydet", "closeOnSave": true, "resetOnOpen": true,
                   "refreshQueries": ["hareketler", "kartDepolari", "sonHareketler", "bakiye"] } },
      { "id": "hareketFormu", "type": "formCard", "name": "hareketFormu",
        "props": { "title": "Yeni hareket", "columns": 2,
                   "inputs": ["hareketYonu", "hareketTarihi", "hareketBirimi", "hareketMiktari", "hareketAciklamasi", "hareketKonumu", "birimMaliyet"] } },
      { "id": "hareketYonu", "type": "input", "name": "hareketYonu",
        "props": { "inputType": "lookup", "label": "Yön", "staticOptions": ["Receipt=Giriş", "Issue=Çıkış"], "minChars": 0, "required": true,
                   "defaultValue": "Receipt" } },
      { "id": "hareketTarihi", "type": "input", "name": "hareketTarihi",
        "props": { "inputType": "date", "label": "Tarih", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "hareketBirimi", "type": "input", "name": "hareketBirimi",
        "props": { "inputType": "lookup", "label": "Hareket birimi", "optionsQuery": "birimler", "optionValueColumn": "unitCode",
                   "optionLabelColumn": "unitCode", "minChars": 0, "allowClear": true,
                   "placeholder": "Ana birim ({{liste.seciliSatir.balance.unitCode}})" } },
      { "id": "hareketMiktari", "type": "input", "name": "hareketMiktari",
        "props": { "inputType": "number", "label": "Miktar", "required": true, "min": 0.0001, "step": 0.0001 } },
      { "id": "hareketAciklamasi", "type": "input", "name": "hareketAciklamasi",
        "props": { "inputType": "text", "label": "Açıklama", "required": true, "maxLength": 240 } },
      { "id": "hareketKonumu", "type": "input", "name": "hareketKonumu",
        "props": { "inputType": "lookup", "label": "Depo konumu", "optionsQuery": "konumlar", "optionValueColumn": "id",
                   "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "allowClear": true,
                   "visibleWhen": "konumlar.rows[0].id != null" } },
      { "id": "birimMaliyet", "type": "input", "name": "birimMaliyet",
        "props": { "inputType": "number", "label": "Birim maliyet", "min": 0, "visibleWhen": "hareketYonu.value == 'Receipt'" } },
      { "id": "izlemeSatirlari", "type": "editableGrid", "name": "izlemeSatirlari",
        "props": { "gridMode": "list", "title": "Lot / seri satırları",
                   "description": "Seri numaralarında miktar 1 olmalı ve son kullanma tarihi boş kalmalıdır; lotlarda son kullanma tarihi zorunludur.",
                   "gridColumns": ["trackingCode|Lot / seri kodu|text|required,unique,maxLength:80", "quantity|Miktar|number|required,min:0.0001",
                                   "expiryDate|Son kullanma tarihi|date"],
                   "maxRows": 200, "visibleWhen": "liste.seciliSatir.stockItem.trackingMode != 'None'" } },
      { "id": "hareketTablosu", "type": "dataTable", "name": "hareketTablosu",
        "props": { "query": "hareketler", "paging": "server", "pageSize": 50, "width": 12,
                   "columns": ["entryDate", "direction", "quantity", "enteredQuantity", "enteredUnitCode", "unitCostBase",
                               "storageLocationCode", "description", "isReversal", "hasReversal"],
                   "rowActions": ["tersKayitDugmesi"], "emptyText": "Bu depoda hareket yok." } },
      { "id": "tersKayitDugmesi", "type": "button", "name": "tersKayitDugmesi",
        "props": { "text": "Ters kayıt", "actionType": "query", "queryId": "tersKayit",
                   "promptLabel": "Ters kayıt gerekçesi", "promptRequired": true,
                   "disabledWhen": "hareketTablosu.seciliSatir.hasReversal || hareketTablosu.seciliSatir.isReversal",
                   "disabledReason": "Bu hareket zaten ters kayıtla düzeltilmiş ya da kendisi bir ters kayıt.",
                   "successMessage": "Ters kayıt oluşturuldu.", "refreshQueries": ["hareketler", "kartDepolari", "sonHareketler"] } }
    ],
    "queries": [
      { "id": "bakiye", "name": "bakiye", "kind": "read", "operation": "stok.bakiye.sayfa", "runOn": "load",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "belowMinimumOnly", "binding": "{{minimumAlti.value}}", "type": "bool" },
          { "name": "includeInactive", "binding": "{{suzgec.includeInactive}}", "type": "bool" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "runOn": "load", "parameters": [] },
      { "id": "kart", "name": "kart", "kind": "read", "operation": "stok.kart.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.stockItem.id}}", "type": "guid" } ] },
      { "id": "kartDepolari", "name": "kartDepolari", "kind": "read", "operation": "stok.kart.depoBakiyeleri", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.stockItem.id}}", "type": "guid" } ] },
      { "id": "sonHareketler", "name": "sonHareketler", "kind": "read", "operation": "stok.kart.hareketleri", "runOn": "load",
        "parameters": [ { "name": "stockItemId", "binding": "{{liste.seciliSatir.stockItem.id}}", "type": "guid" } ] },
      { "id": "kartSil", "name": "kartSil", "kind": "delete", "operation": "stok.kart.sil", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.stockItem.id}}", "type": "guid" } ] },
      { "id": "pasifeAl", "name": "pasifeAl", "kind": "update", "operation": "stok.kart.pasifeAl", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid" } ] },
      { "id": "aktifEt", "name": "aktifEt", "kind": "update", "operation": "stok.kart.aktifEt", "runOn": "manual",
        "parameters": [ { "name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid" } ] },
      { "id": "negatifStok", "name": "negatifStok", "kind": "read", "operation": "ayar.negatifStok", "runOn": "load", "parameters": [] },
      { "id": "birimler", "name": "birimler", "kind": "read", "operation": "stok.kart.birimleri", "runOn": "load",
        "parameters": [
          { "name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid" } ] },
      { "id": "konumlar", "name": "konumlar", "kind": "read", "operation": "depo.konumlari", "runOn": "load",
        "parameters": [ { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" } ] },
      { "id": "hareketler", "name": "hareketler", "kind": "read", "operation": "stok.hareket.listele", "runOn": "load",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "stockItemId", "binding": "{{liste.seciliSatir.stockItem.id}}", "type": "guid" },
          { "name": "page", "binding": "{{hareketTablosu.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{hareketTablosu.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "hareketEkle", "name": "hareketEkle", "kind": "insert", "operation": "stok.hareket.ekle", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "stockItemId", "binding": "{{liste.seciliSatir.stockItem.id}}", "type": "guid" },
          { "name": "entryDate", "binding": "{{hareketTarihi.value}}", "type": "date" },
          { "name": "direction", "binding": "{{hareketYonu.value}}", "type": "text" },
          { "name": "quantity", "binding": "{{hareketMiktari.value}}", "type": "decimal" },
          { "name": "description", "binding": "{{hareketAciklamasi.value}}", "type": "text" },
          { "name": "unitCostBase", "binding": "{{birimMaliyet.value}}", "type": "decimal" },
          { "name": "unitCode", "binding": "{{hareketBirimi.value}}", "type": "text" },
          { "name": "storageLocationId", "binding": "{{hareketKonumu.value}}", "type": "guid" },
          { "name": "tracking", "binding": "{{izlemeSatirlari.satirlar}}", "type": "list" } ] },
      { "id": "tersKayit", "name": "tersKayit", "kind": "insert", "operation": "stok.hareket.tersKayit", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "stockItemId", "binding": "{{liste.seciliSatir.stockItem.id}}", "type": "guid" },
          { "name": "entryId", "binding": "{{hareketTablosu.seciliSatir.id}}", "type": "guid" },
          { "name": "reason", "binding": "{{tersKayitDugmesi.yanit}}", "type": "text" } ] }
    ]
  }
}
