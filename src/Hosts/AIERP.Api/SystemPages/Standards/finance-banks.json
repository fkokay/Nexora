        "props": {
          "inputType": "date",
          "label": "Tarih",
          "required": true,
          "defaultValue": "{{bugun}}",
          "slot": "dialog"
        }
      },
      {
        "id": "transferReferansi",
        "type": "input",
        "name": "transferReferansi",
        "props": {
          "inputType": "text",
          "label": "Referans",
          "maxLength": 100,
          "placeholder": "İsteğe bağlı",
          "slot": "dialog"
        }
      },
      {
        "id": "transferTutari",
        "type": "input",
        "name": "transferTutari",
        "props": {
          "inputType": "number",
          "label": "Kaynak tutarı ({{ekstre.meta.currencyCode}})",
          "required": true,
          "min": 0.01,
          "step": 0.01,
          "slot": "dialog"
        }
      },
      {
        "id": "transferKuru",
        "type": "input",
        "name": "transferKuru",
        "props": {
          "inputType": "number",
          "label": "Kur",
          "required": true,
          "min": 1e-08,
          "step": 1e-08,
          "defaultValue": "1",
          "slot": "dialog"
        }
      },
      {
        "id": "transferIstekKimligi",
        "type": "input",
        "name": "transferIstekKimligi",
        "props": {
          "inputType": "text",
          "label": "Tekrar deneme kimliği",
          "hidden": true,
          "autoId": true,
          "slot": "dialog"
        }
      },
      {
        "id": "transferNotu",
        "type": "text",
        "name": "transferNotu",
        "props": {
          "text": "Aynı dövizli hesaplar arasında kur 1 kalmalıdır. Hedef tutarı sunucu hesaplar (tutar × kur, 2 hane). Hedef listesinde kasa ve banka hesapları birlikte çıkar.",
          "slot": "dialog"
        }
      },
      {
        "id": "nakitAkisiPenceresi",
        "type": "dialog",
        "name": "nakitAkisiPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "sm",
          "title": "Nakit akışı sınıfı · {{hareketler.seciliSatir.description}}",
