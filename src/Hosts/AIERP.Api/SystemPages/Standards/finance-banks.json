              "visibleWhen": "liste.seciliSatir.id != null && ekstre.meta.isActive == true"
            }
          },
          {
            "id": "pasifEtiketi",
            "type": "badge",
            "name": "pasifEtiketi",
            "props": {
              "text": "Pasif",
              "variant": "info",
              "visibleWhen": "liste.seciliSatir.id != null && ekstre.meta.isActive == false"
            }
