            "nakitAkisiKarti",
            "nakitAkisiNotu"
          ],
          "saveQuery": "nakitAkisiDegistir",
          "saveLabel": "Kaydet",
          "closeOnSave": true,
          "refreshQueries": [
            "ekstre"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "nakitAkisiKarti",
        "type": "formCard",
        "name": "nakitAkisiKarti",
        "props": {
          "title": "Sınıf",
          "columns": 1,
          "inputs": [
            "nakitAkisiSecimi"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "nakitAkisiSecimi",
        "type": "input",
        "name": "nakitAkisiSecimi",
        "props": {
          "inputType": "select",
          "label": "Nakit akışı sınıfı",
          "required": true,
          "staticOptions": [
            "Unclassified=Sınıflandırılmamış",
            "Operating=İşletme",
            "Investing=Yatırım",
            "Financing=Finansman"
          ],
          "defaultValue": "{{hareketler.seciliSatir.cashFlowCategory}}",
          "slot": "dialog"
