{
  "screenKey": "finance-banks",
  "title": "Bankalar",
  "description": "Banka hesaplarını, bakiyelerini ve hesap ekstresini yönetin: manuel hareket, transfer / döviz ve ters kayıtla iptal.",
  "module": "Finans",
  "version": 2,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "İşlem çubuğu",
      "requires": [
        "component:suzgec",
        "component:liste",
