              "successMessage": "Hesap pasife alındı.",
              "refreshQueries": [
                "hesaplar",
                "ozet"
              ],
              "visibleWhen": "liste.seciliSatir.isActive == true"
            }
          },
          {
            "id": "etkinlestirDugmesi",
            "type": "button",
            "name": "etkinlestirDugmesi",
            "props": {
              "text": "Etkinleştir",
              "actionType": "query",
              "queryId": "aktifEt",
              "confirmEnabled": true,
              "confirmText": "“{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}}” yeniden etkinleştirilsin mi?",
              "successMessage": "Hesap etkinleştirildi.",
              "refreshQueries": [
                "hesaplar",
                "ozet"
              ],
              "visibleWhen": "liste.seciliSatir.isActive == false"
            }
          },
          {
            "id": "duzenleDugmesi",
            "type": "button",
            "name": "duzenleDugmesi",
            "props": {
              "text": "Düzenle",
              "actionType": "page",
              "pageCode": "@finance-account-create",
              "target": "newTab",
              "params": [
                "accountId={{liste.seciliSatir.id}}"
              ]
            }
          }
        ]
      },
      {
        "id": "ekstrePenceresi",
        "type": "dialog",
        "name": "ekstrePenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Ekstre · {{liste.seciliSatir.code}} · {{liste.seciliSatir.name}}",
          "contains": [
