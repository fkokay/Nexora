            "name": "toAccountId",
            "binding": "{{hedefHesap.value}}",
            "type": "guid"
          },
          {
            "name": "transferDate",
            "binding": "{{transferTarihi.value}}",
            "type": "date"
          },
          {
            "name": "amount",
            "binding": "{{transferTutari.value}}",
            "type": "decimal"
          },
          {
            "name": "reference",
            "binding": "{{transferReferansi.value}}",
            "type": "text"
          },
          {
            "name": "exchangeRate",
            "binding": "{{transferKuru.value}}",
            "type": "decimal"
          }
