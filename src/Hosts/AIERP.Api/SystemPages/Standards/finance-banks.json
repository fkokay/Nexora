            "props": {
              "text": "Ekstre",
              "icon": "open",
              "actionType": "openDialog",
              "dialogId": "ekstrePenceresi"
            }
          },
          {
            "id": "manuelHareketDugmesi",
            "type": "button",
            "name": "manuelHareketDugmesi",
            "props": {
              "text": "Manuel hareket",
              "actionType": "openDialog",
              "dialogId": "manuelHareketPenceresi",
              "visibleWhen": "liste.seciliSatir.id != null",
              "disabledWhen": "ekstre.meta.isActive == false",
              "disabledReason": "Pasif hesaba hareket girilemez"
            }
          },
          {
            "id": "transferDugmesi",
            "type": "button",
            "name": "transferDugmesi",
            "props": {
              "text": "Transfer / döviz",
              "actionType": "openDialog",
              "dialogId": "transferPenceresi",
              "visibleWhen": "liste.seciliSatir.id != null",
              "disabledWhen": "ekstre.meta.isActive == false",
