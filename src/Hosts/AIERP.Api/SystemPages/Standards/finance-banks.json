        "operation": "finans.hesap.sil",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "hareketEkle",
        "name": "hareketEkle",
        "kind": "insert",
        "operation": "finans.hareket.ekle",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "requestId",
            "binding": "{{hareketIstekKimligi.value}}",
            "type": "guid"
          },
          {
            "name": "transactionDate",
            "binding": "{{hareketTarihi.value}}",
            "type": "date"
          },
          {
            "name": "direction",
            "binding": "{{hareketYonu.value}}",
            "type": "text"
          },
          {
            "name": "amount",
            "binding": "{{hareketTutari.value}}",
            "type": "decimal"
          },
          {
            "name": "description",
            "binding": "{{hareketAciklamasi.value}}",
            "type": "text"
          },
          {
            "name": "reference",
            "binding": "{{hareketReferansi.value}}",
            "type": "text"
          },
          {
            "name": "cashFlowCategory",
            "binding": "{{hareketNakitAkisi.value}}",
            "type": "text"
          }
        ]
      },
      {
        "id": "hareketIptal",
        "name": "hareketIptal",
        "kind": "update",
        "operation": "finans.hareket.iptal",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "transactionId",
            "binding": "{{hareketler.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "transferIptal",
        "name": "transferIptal",
        "kind": "update",
        "operation": "finans.transfer.iptal",
        "runOn": "manual",
        "parameters": [
          {
            "name": "transferId",
            "binding": "{{hareketler.seciliSatir.transferId}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "nakitAkisiDegistir",
        "name": "nakitAkisiDegistir",
        "kind": "update",
        "operation": "finans.hareket.nakitAkisi",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "transactionId",
            "binding": "{{hareketler.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "cashFlowCategory",
            "binding": "{{nakitAkisiSecimi.value}}",
            "type": "text"
          }
        ]
      },
      {
        "id": "transferOlustur",
        "name": "transferOlustur",
        "kind": "insert",
        "operation": "finans.transfer.olustur",
