        "kind": "read",
        "operation": "finans.hesap.ozet",
        "runOn": "load",
        "parameters": [
          {
            "name": "type",
            "binding": "{{hesapTuru.value}}",
            "type": "text"
          }
        ]
      },
      {
        "id": "tumHesaplar",
        "name": "tumHesaplar",
        "kind": "read",
        "operation": "finans.hesap.listele",
        "runOn": "load",
