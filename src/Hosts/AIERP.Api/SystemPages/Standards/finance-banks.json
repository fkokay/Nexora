  "screenViews": [
    {
      "key": "finance-accounts",
      "component": "liste",
      "fields": {
        "code": "code",
        "name": "name",
        "type": "type",
        "currencyCode": "currencyCode",
        "balance": "balance",
        "transactionCount": "transactionCount",
        "status": "isActive"
      }
    },
    {
      "key": "finance-account-transactions",
      "component": "hareketler",
      "fields": {
        "transactionDate": "transactionDate",
        "source": "sourceType",
        "description": "description",
        "cashFlowCategory": "cashFlowCategory",
        "reference": "reference",
        "inflow": "inflow",
        "outflow": "outflow"
      }
    }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "newButton": "yeniDugmesi",
          "moreButtons": [
            "silDugmesi"
          ],
          "focusInput": "suzgec",
          "exportTable": "liste",
          "hiddenCommands": [
            "open",
            "save",
            "delete",
            "print"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "hesapTuru",
        "type": "input",
        "name": "hesapTuru",
        "props": {
          "inputType": "text",
          "label": "Hesap türü",
          "hidden": true,
          "defaultValue": "Bank",
          "slot": "above"
        }
      },
      {
        "id": "toplamBakiyeGostergesi",
        "type": "metric",
        "name": "toplamBakiyeGostergesi",
        "props": {
          "title": "Toplam bakiye",
          "value": "{{ozet.rows[0].totalBalance}}",
          "format": "money",
          "icon": "wallet",
          "description": "{{ozet.rows[0].currencyCode}} · tüm banka hesapları",
          "visibleWhen": "liste.seciliSatir.id == null && ozet.rows[0].currencyCount <= 1",
          "slot": "indicators"
        }
      },
      {
        "id": "cokDovizGostergesi",
        "type": "metric",
        "name": "cokDovizGostergesi",
        "props": {
          "title": "Toplam bakiye",
          "value": "—",
          "format": "text",
          "icon": "coins",
          "description": "birden çok para birimi ({{ozet.rows[0].currencyCount}})",
          "visibleWhen": "liste.seciliSatir.id == null && ozet.rows[0].currencyCount > 1",
          "slot": "indicators"
        }
      },
      {
        "id": "eksiBakiyeGostergesi",
        "type": "metric",
        "name": "eksiBakiyeGostergesi",
        "props": {
          "title": "Eksi bakiyeli hesap",
          "value": "{{ozet.rows[0].negativeBalanceCount}}",
          "format": "number",
          "icon": "alert",
          "variant": "danger",
          "description": "bakiyesi eksiye düşen banka hesabı",
          "visibleWhen": "liste.seciliSatir.id == null",
          "slot": "indicators"
        }
      },
      {
        "id": "aktifHesapGostergesi",
        "type": "metric",
        "name": "aktifHesapGostergesi",
        "props": {
          "title": "Aktif hesap",
          "value": "{{ozet.rows[0].activeCount}}",
          "format": "number",
          "icon": "check",
          "variant": "success",
          "description": "{{ozet.rows[0].accountCount}} hesaptan · {{ozet.rows[0].inactiveCount}} pasif",
          "visibleWhen": "liste.seciliSatir.id == null",
          "slot": "indicators"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "search": true,
          "searchPlaceholder": "Kod, hesap veya döviz ara",
          "searchColumns": [
            "code",
            "name",
            "currencyCode"
          ],
          "filters": [
            "isActive|select|row||Durum"
          ],
          "slot": "filters"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Banka hesapları",
          "query": "hesaplar",
          "columns": [
            "code",
            "name",
            "type",
            "currencyCode",
            "balance",
            "transactionCount",
            "isActive"
          ],
          "columnLabels": [
            "code=Kod",
            "name=Hesap",
            "type=Tür",
            "currencyCode=Döviz",
            "balance=Bakiye",
            "transactionCount=Hareket",
            "isActive=Durum",
            "createdAt=Açılış"
          ],
          "columnUnits": [
            "balance=currencyCode"
          ],
          "columnFormats": [
            "code=code",
            "type=status",
            "balance=money",
            "transactionCount=number",
            "isActive=status",
            "createdAt=date"
          ],
          "valueLabels": [
            "type:Cash=Kasa",
            "type:Bank=Banka",
            "isActive:true=Aktif",
            "isActive:false=Pasif"
          ],
          "toneMap": [
            "Aktif=success",
            "Pasif=info"
          ],
          "emptyText": "Filtreye uygun kasa veya banka hesabı yok.",
          "slot": "list"
        }
      },
      {
        "id": "yeniDugmesi",
        "type": "button",
        "name": "yeniDugmesi",
        "props": {
          "text": "Yeni",
          "actionType": "page",
          "pageCode": "@finance-account-create",
          "target": "newTab",
          "params": [
            "accountType=Bank"
          ],
          "slot": "actions"
        }
      },
      {
        "id": "silDugmesi",
        "type": "button",
        "name": "silDugmesi",
        "props": {
          "text": "Sil",
          "actionType": "query",
          "queryId": "hesapSil",
          "confirmEnabled": true,
          "confirmText": "“{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}}” kalıcı olarak silinsin mi? Bu işlem geri alınamaz.",
          "successMessage": "Hesap silindi.",
          "refreshQueries": [
            "hesaplar",
            "ozet"
          ],
          "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.transactionCount > 0",
          "disabledReason": "Hareketi olan hesap silinemez; pasifleştirin.",
          "slot": "actions",
          "visibleWhen": "liste.seciliSatir.transactionCount == 0"
        }
      },
      {
        "id": "hesapBasligi",
        "type": "recordHeader",
        "name": "hesapBasligi",
        "props": {
          "visibleWhen": "liste.seciliSatir.id != null",
          "icon": "landmark",
          "title": "{{ekstre.meta.code}} · {{ekstre.meta.name}}",
          "subtitle": "Banka · {{ekstre.meta.currencyCode}}",
          "fields": [
            "Tür={{liste.seciliSatir.type}}",
            "Döviz={{liste.seciliSatir.currencyCode}}",
            "Bakiye={{liste.seciliSatir.balance}}",
            "Hareket={{liste.seciliSatir.transactionCount}}"
          ],
          "fieldFormats": [
            "Bakiye=money",
            "Hareket=number"
          ],
          "fieldUnits": [
            "Bakiye={{ekstre.meta.currencyCode}}"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "hareketler",
        "type": "dataTable",
        "name": "hareketler",
        "props": {
          "title": "Hesap hareketleri",
          "query": "ekstre",
          "paging": "server",
          "pageSize": 50,
          "visibleWhen": "liste.seciliSatir.id != null",
          "columns": [
            "transactionDate",
            "sourceType",
            "description",
            "cashFlowCategory",
            "reference",
            "inflow",
            "outflow",
            "isReversed",
            "isReversal"
          ],
          "columnLabels": [
            "transactionDate=Tarih",
            "sourceType=Kaynak",
            "description=Açıklama",
            "cashFlowCategory=Nakit akışı",
            "reference=Referans",
            "inflow=Giriş",
            "outflow=Çıkış",
            "isReversed=Durum",
            "isReversal=Ters kayıt"
          ],
          "columnUnits": [
            "sourceType=sourceCode"
          ],
          "columnFormats": [
            "transactionDate=date",
            "cashFlowCategory=status",
            "inflow=money",
            "outflow=money",
            "isReversed=status",
            "isReversal=status"
          ],
          "valueLabels": [
            "cashFlowCategory:Unclassified=Sınıflandırılmamış",
            "cashFlowCategory:Operating=İşletme",
            "cashFlowCategory:Investing=Yatırım",
            "cashFlowCategory:Financing=Finansman",
            "cashFlowCategory:InternalTransfer=İç transfer",
            "cashFlowCategory:OpeningBalance=Açılış",
            "isReversed:true=İptal edildi",
            "isReversed:false=—",
            "isReversal:true=Ters kayıt",
            "isReversal:false=—"
          ],
          "toneMap": [
            "İptal edildi=warning",
            "Ters kayıt=info"
          ],
          "rowActions": [
            "hareketIptalDugmesi",
            "transferIptalDugmesi",
            "nakitAkisiDugmesi"
          ],
          "emptyText": "Bu hesapta henüz hareket yok.",
          "slot": "dialog"
        }
      },
      {
        "id": "hareketIptalDugmesi",
        "type": "button",
        "name": "hareketIptalDugmesi",
        "props": {
          "text": "Hareketi iptal et",
          "actionType": "query",
          "queryId": "hareketIptal",
          "confirmEnabled": true,
          "confirmText": "{{hareketler.seciliSatir.description}} · Hareket ters yönlü yeni bir kayıtla iptal edilecek (Ters kayıtla iptal et). Ters kaydın tarihi bugündür; kapalı döneme ters kayıt girilemez.",
          "successMessage": "Hareket ters kayıtla iptal edildi.",
          "refreshQueries": [
            "ekstre",
            "hesaplar",
            "ozet"
          ],
          "visibleWhen": "hareketler.seciliSatir.canVoid == true",
          "slot": "rowActions"
        }
      },
      {
        "id": "transferIptalDugmesi",
        "type": "button",
        "name": "transferIptalDugmesi",
        "props": {
          "text": "Transferi iptal et",
          "actionType": "query",
          "queryId": "transferIptal",
          "confirmEnabled": true,
          "confirmText": "{{hareketler.seciliSatir.sourceCode}} · Transfer iki hesapta ters kayıtla iptal edilecek (Ters kayıtla iptal et). Ters kaydın tarihi bugündür; hedef kasanın bakiyesi yetmezse işlem reddedilir.",
          "successMessage": "Transfer ters kayıtlarla iptal edildi.",
