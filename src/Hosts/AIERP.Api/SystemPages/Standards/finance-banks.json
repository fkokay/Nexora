            "transferTarihi",
            "transferReferansi",
            "transferTutari",
            "transferKuru"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "hedefHesap",
        "type": "input",
        "name": "hedefHesap",
        "props": {
          "inputType": "lookup",
          "label": "Hedef hesap",
          "required": true,
