{
  "screenKey": "inventory-locations", "title": "Raf ve Konumlar",
  "description": "Ambar içindeki raf ve bölmeleri tanımlayın; konuma atanmış stok bakiyelerini izleyin.", "module": "Stok & Depo",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": { "since": 1, "label": "İşlem çubuğu",
      "requires": ["component:suzgec", "component:konumListesi", "component:yeniKonumDugmesi", "component:duzenleDugmesi",
                   "component:bakiyelerDugmesi", "component:denetimDugmesi"] },
    "component:konumSayisi": { "since": 1, "label": "Konum sayısı göstergesi", "requires": ["query:konumlar", "component:suzgec"] },
    "component:aktifKonumSayisi": { "since": 1, "label": "Aktif konum göstergesi", "requires": ["query:konumlar", "component:suzgec"] },
    "component:konumsuzKart": { "since": 1, "label": "Konumsuz kalan kart göstergesi", "requires": ["query:denetim", "component:suzgec"] },
    "component:suzgec": { "since": 1, "label": "Süzgeç alanı (arama, depo, durum)", "requires": ["component:konumListesi", "query:depolar"] },
    "component:depoSecinNotu": { "since": 1, "label": "Depo seçin notu", "requires": ["component:suzgec"] },
    "component:konumListesi": { "since": 1, "label": "Konum listesi", "requires": ["query:konumlar", "component:suzgec", "component:pasifeAlDugmesi"] },
    "component:pasifeAlDugmesi": { "since": 1, "label": "Pasife al satır eylemi", "requires": ["query:pasifeAl", "component:konumListesi"] },
    "component:konumKarti": { "since": 1, "label": "Konum özeti (sağ bölme)", "requires": ["component:konumListesi"] },
    "component:yeniKonumDugmesi": { "since": 1, "label": "Yeni konum komutu", "requires": ["component:yeniKonumPenceresi", "component:suzgec"] },
    "component:duzenleDugmesi": { "since": 1, "label": "Düzenle komutu", "requires": ["component:duzenleKonumPenceresi", "component:konumListesi"] },
    "component:bakiyelerDugmesi": { "since": 1, "label": "Bakiyeler komutu", "requires": ["component:bakiyePenceresi", "component:konumListesi"] },
    "component:denetimDugmesi": { "since": 1, "label": "Konumlandırma denetimi komutu", "requires": ["component:denetimPenceresi", "component:suzgec"] },
    "component:yeniKonumPenceresi": { "since": 1, "label": "Yeni konum penceresi",
      "requires": ["component:yeniKonumFormu", "query:olustur", "query:konumlar"] },
    "component:yeniKonumFormu": { "since": 1, "label": "Yeni konum formu",
      "requires": ["component:yeniKonumKodu", "component:yeniKonumAdi", "component:yeniUstKonum"] },
    "component:yeniKonumKodu": { "since": 1, "label": "Alan: Konum kodu (yeni)" },
    "component:yeniKonumAdi": { "since": 1, "label": "Alan: Konum adı (yeni)" },
    "component:yeniUstKonum": { "since": 1, "label": "Alan: Üst konum (yeni)", "requires": ["query:konumlar"] },
    "component:duzenleKonumPenceresi": { "since": 1, "label": "Konum penceresi (düzenle)",
      "requires": ["component:duzenleKonumFormu", "query:guncelle", "query:konumlar", "component:konumListesi"] },
    "component:duzenleKonumFormu": { "since": 1, "label": "Konum formu (düzenle)",
      "requires": ["component:konumKodu", "component:konumAdi", "component:ustKonum", "component:konumAktif"] },
    "component:konumKodu": { "since": 1, "label": "Alan: Konum kodu", "requires": ["component:konumListesi"] },
    "component:konumAdi": { "since": 1, "label": "Alan: Konum adı", "requires": ["component:konumListesi"] },
    "component:ustKonum": { "since": 1, "label": "Alan: Üst konum", "requires": ["component:konumListesi", "query:konumlar"] },
    "component:konumAktif": { "since": 1, "label": "Alan: Konum aktif", "requires": ["component:konumListesi"] },
    "component:bakiyePenceresi": { "since": 1, "label": "Konum bakiyesi penceresi", "requires": ["component:bakiyeTablosu", "component:konumListesi"] },
    "component:bakiyeTablosu": { "since": 1, "label": "Konum bakiyesi", "requires": ["query:bakiyeler", "component:konumListesi"] },
    "component:denetimPenceresi": { "since": 1, "label": "Konumlandırma denetimi penceresi",
      "requires": ["component:denetimTablosu", "component:denetimNotu"] },
    "component:denetimTablosu": { "since": 1, "label": "Konumlandırma denetimi", "requires": ["query:denetim"] },
    "component:denetimNotu": { "since": 1, "label": "Konumlandırma denetimi notu" },
    "query:depolar": { "since": 1, "label": "Depoları listele" },
    "query:konumlar": { "since": 1, "label": "Seçili deponun konumları", "requires": ["component:suzgec"] },
    "query:bakiyeler": { "since": 1, "label": "Seçili konumun stok bakiyeleri", "requires": ["component:konumListesi"] },
    "query:denetim": { "since": 1, "label": "Seçili deponun konumlandırma denetimi", "requires": ["component:suzgec"] },
    "query:olustur": { "since": 1, "label": "Depo konumu oluştur",
      "requires": ["component:suzgec", "component:yeniKonumKodu", "component:yeniKonumAdi", "component:yeniUstKonum"] },
    "query:guncelle": { "since": 1, "label": "Depo konumu güncelle",
      "requires": ["component:konumListesi", "component:konumKodu", "component:konumAdi", "component:ustKonum", "component:konumAktif"] },
    "query:pasifeAl": { "since": 1, "label": "Depo konumunu pasife al", "requires": ["component:konumListesi"] }
  },
  "screenViews": [
    { "key": "inventory-warehouse-locations", "component": "konumListesi",
      "fields": { "code": "code", "name": "name", "status": "isActive" } },
    { "key": "warehouse-location-balances", "component": "bakiyeTablosu",
      "fields": { "stockItemCode": "stockItemCode", "stockItemName": "stockItemName", "quantity": "quantity", "unitCode": "unitCode" } },
    { "key": "inventory-warehouse-reconciliation", "component": "denetimTablosu",
      "fields": { "stockItemCode": "stockItemCode", "stockItemName": "stockItemName", "warehouseQuantity": "warehouseQuantity",
                  "locatedQuantity": "locatedQuantity", "unlocatedQuantity": "unlocatedQuantity", "unitCode": "unitCode" } }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "newButton": "yeniKonumDugmesi", "openButton": "duzenleDugmesi", "moreButtons": ["bakiyelerDugmesi", "denetimDugmesi"],
                   "focusInput": "suzgec", "exportTable": "konumListesi", "titleCount": "{{konumlar.rowCount}}",
                   "hiddenCommands": ["save", "delete", "print"], "slot": "commands" } },
      { "id": "yeniKonumDugmesi", "type": "button", "name": "yeniKonumDugmesi",
        "props": { "text": "Yeni konum", "actionType": "openDialog", "dialogId": "yeniKonumPenceresi",
                   "disabledWhen": "kullanici.rol != 'TenantAdmin' || suzgec.warehouseId == null",
                   "disabledReason": "Konum eklemek için firma yöneticisi olmalı ve bir depo seçmelisiniz", "slot": "actions" } },
      { "id": "duzenleDugmesi", "type": "button", "name": "duzenleDugmesi",
        "props": { "text": "Düzenle", "actionType": "openDialog", "dialogId": "duzenleKonumPenceresi",
                   "disabledWhen": "kullanici.rol != 'TenantAdmin' || konumListesi.seciliSatir.id == null",
                   "disabledReason": "Konum düzenlemek için firma yöneticisi olmalı ve bir konum seçmelisiniz", "slot": "actions" } },
      { "id": "bakiyelerDugmesi", "type": "button", "name": "bakiyelerDugmesi",
        "props": { "text": "Bakiyeler", "actionType": "openDialog", "dialogId": "bakiyePenceresi",
                   "disabledWhen": "konumListesi.seciliSatir.id == null", "disabledReason": "Önce bir konum seçin", "slot": "actions" } },
      { "id": "denetimDugmesi", "type": "button", "name": "denetimDugmesi",
        "props": { "text": "Konumlandırma denetimi", "actionType": "openDialog", "dialogId": "denetimPenceresi",
                   "disabledWhen": "suzgec.warehouseId == null", "disabledReason": "Önce bir depo seçin", "slot": "actions" } },

      { "id": "konumSayisi", "type": "metric", "name": "konumSayisi",
        "props": { "title": "Konum", "value": "{{konumlar.rowCount}}", "format": "number", "icon": "box",
                   "visibleWhen": "suzgec.warehouseId != null", "slot": "indicators" } },
      { "id": "aktifKonumSayisi", "type": "metric", "name": "aktifKonumSayisi",
        "props": { "title": "Aktif", "query": "konumlar", "countWhen": "konumlar.satir.isActive == true", "variant": "success", "icon": "check",
                   "visibleWhen": "suzgec.warehouseId != null", "slot": "indicators" } },
      { "id": "konumsuzKart", "type": "metric", "name": "konumsuzKart",
        "props": { "title": "Konumsuz kalan kart", "value": "{{denetim.rowCount}}", "format": "number", "variant": "warning", "icon": "alert",
                   "visibleWhen": "suzgec.warehouseId != null", "slot": "indicators" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "konumListesi", "search": true, "searchPlaceholder": "Kod veya ad ara", "searchColumns": ["code", "name"],
                   "filters": ["warehouseId|select|row|warehouseId|Depo|depolar:id:code:name|searchable,defaultFirst", "isActive|select|row||Durum"],
                   "slot": "filters" } },
      { "id": "depoSecinNotu", "type": "text", "name": "depoSecinNotu",
        "props": { "text": "Konumları görmek için önce bir depo seçin.", "visibleWhen": "suzgec.warehouseId == null", "slot": "above" } },
      { "id": "konumListesi", "type": "dataTable", "name": "konumListesi",
        "props": { "title": "Raf ve bölmeler", "query": "konumlar", "columns": ["code", "name", "isActive"],
                   "columnLabels": ["code=Konum kodu", "name=Konum adı", "isActive=Durum"],
                   "columnFormats": ["code=code", "isActive=status"],
                   "valueLabels": ["isActive:true=Aktif", "isActive:false=Pasif"], "toneMap": ["Aktif=success", "Pasif=info"],
                   "rowActions": ["pasifeAlDugmesi"],
                   "emptyText": "Bu depoda henüz konum yok. Kod ve ad vererek raf ya da bölme ekleyin.",
                   "visibleWhen": "suzgec.warehouseId != null", "slot": "list" } },
      { "id": "pasifeAlDugmesi", "type": "button", "name": "pasifeAlDugmesi",
        "props": { "text": "Pasife al", "actionType": "query", "queryId": "pasifeAl", "confirmEnabled": true,
                   "confirmText": "{{konumListesi.seciliSatir.code}} · {{konumListesi.seciliSatir.name}} pasife alınsın mı? Konumlar silinmez; geçmiş hareketler korunur. Etkin alt konumu ya da stok bakiyesi olan konum pasife alınamaz.",
                   "successMessage": "Depo konumu güncellendi.", "refreshQueries": ["konumlar"],
                   "visibleWhen": "kullanici.rol == 'TenantAdmin' && konumListesi.seciliSatir.isActive == true", "slot": "rowActions" } },

      { "id": "konumKarti", "type": "card", "name": "konumKarti",
        "props": { "variant": "panel", "title": "{{konumListesi.seciliSatir.name}}", "description": "{{konumListesi.seciliSatir.code}}", "slot": "detail" },
        "children": [
          { "id": "konumAktifEtiketi", "type": "badge", "name": "konumAktifEtiketi",
            "props": { "text": "Aktif", "variant": "success", "visibleWhen": "konumListesi.seciliSatir.isActive == true" } },
          { "id": "konumPasifEtiketi", "type": "badge", "name": "konumPasifEtiketi",
            "props": { "text": "Pasif", "variant": "info", "visibleWhen": "konumListesi.seciliSatir.isActive == false" } },
          { "id": "konumSecin", "type": "text", "name": "konumSecin",
            "props": { "text": "Bir konum seçin; ayrıntıları burada görün.", "visibleWhen": "konumListesi.seciliSatir.id == null" } },
          { "id": "konumOzeti", "type": "contextPanel", "name": "konumOzeti",
            "props": { "table": "konumListesi", "visibleWhen": "konumListesi.seciliSatir.id != null",
                       "fields": ["code=Konum kodu", "name=Konum adı", "isActive=Durum"] } }
        ] },

      { "id": "yeniKonumPenceresi", "type": "dialog", "name": "yeniKonumPenceresi",
        "props": { "presentation": "dialog", "size": "sm", "title": "Yeni konum", "contains": ["yeniKonumFormu"], "saveQuery": "olustur",
                   "saveLabel": "Kaydet", "closeOnSave": true, "resetOnOpen": true, "refreshQueries": ["konumlar", "denetim"], "slot": "dialogs" } },
      { "id": "yeniKonumFormu", "type": "formCard", "name": "yeniKonumFormu",
        "props": { "columns": 2, "inputs": ["yeniKonumKodu", "yeniKonumAdi", "yeniUstKonum"], "slot": "dialog" } },
      { "id": "yeniKonumKodu", "type": "input", "name": "yeniKonumKodu",
        "props": { "inputType": "text", "label": "Konum kodu", "required": true, "maxLength": 40, "upperCase": true, "placeholder": "A-01-03", "slot": "dialog" } },
      { "id": "yeniKonumAdi", "type": "input", "name": "yeniKonumAdi",
        "props": { "inputType": "text", "label": "Konum adı", "required": true, "maxLength": 120, "placeholder": "Raf 3 · Göz 1", "slot": "dialog" } },
      { "id": "yeniUstKonum", "type": "input", "name": "yeniUstKonum",
        "props": { "inputType": "select", "label": "Üst konum", "optionsQuery": "konumlar", "optionValueColumn": "id", "optionLabelColumn": "code", "slot": "dialog" } },

      { "id": "duzenleKonumPenceresi", "type": "dialog", "name": "duzenleKonumPenceresi",
        "props": { "presentation": "dialog", "size": "sm", "title": "Konum · {{konumListesi.seciliSatir.code}}", "contains": ["duzenleKonumFormu"],
                   "saveQuery": "guncelle", "saveLabel": "Kaydet", "closeOnSave": true, "resetOnOpen": true,
                   "refreshQueries": ["konumlar", "denetim"], "slot": "dialogs" } },
      { "id": "duzenleKonumFormu", "type": "formCard", "name": "duzenleKonumFormu",
        "props": { "columns": 2, "inputs": ["konumKodu", "konumAdi", "ustKonum", "konumAktif"], "slot": "dialog" } },
      { "id": "konumKodu", "type": "input", "name": "konumKodu",
        "props": { "inputType": "text", "label": "Konum kodu", "required": true, "maxLength": 40, "upperCase": true, "placeholder": "A-01-03",
                   "defaultValue": "{{konumListesi.seciliSatir.code}}", "slot": "dialog" } },
      { "id": "konumAdi", "type": "input", "name": "konumAdi",
        "props": { "inputType": "text", "label": "Konum adı", "required": true, "maxLength": 120, "placeholder": "Raf 3 · Göz 1",
                   "defaultValue": "{{konumListesi.seciliSatir.name}}", "slot": "dialog" } },
      { "id": "ustKonum", "type": "input", "name": "ustKonum",
        "props": { "inputType": "select", "label": "Üst konum", "optionsQuery": "konumlar", "optionValueColumn": "id", "optionLabelColumn": "code",
                   "defaultValue": "{{konumListesi.seciliSatir.parentLocationId}}", "slot": "dialog" } },
      { "id": "konumAktif", "type": "input", "name": "konumAktif",
        "props": { "inputType": "checkbox", "label": "Konum aktif", "defaultValue": "{{konumListesi.seciliSatir.isActive}}", "slot": "dialog" } },

      { "id": "bakiyePenceresi", "type": "dialog", "name": "bakiyePenceresi",
        "props": { "presentation": "dialog", "size": "lg", "title": "Konum bakiyesi · {{konumListesi.seciliSatir.code}}",
                   "contains": ["bakiyeTablosu"], "slot": "dialogs" } },
      { "id": "bakiyeTablosu", "type": "dataTable", "name": "bakiyeTablosu",
        "props": { "title": "Konum bakiyesi", "query": "bakiyeler", "columns": ["stockItemCode", "stockItemName", "quantity", "unitCode"],
                   "columnLabels": ["stockItemCode=Stok kodu", "stockItemName=Stok adı", "quantity=Konum miktarı", "unitCode=Birim"],
                   "columnFormats": ["stockItemCode=code", "quantity=number"],
                   "emptyText": "Bu konumda stok bakiyesi bulunmuyor.", "slot": "dialog" } },

      { "id": "denetimPenceresi", "type": "dialog", "name": "denetimPenceresi",
        "props": { "presentation": "dialog", "size": "xl", "title": "Konumlandırma denetimi", "contains": ["denetimNotu", "denetimTablosu"], "slot": "dialogs" } },
      { "id": "denetimNotu", "type": "text", "name": "denetimNotu",
        "props": { "text": "Konumu boş eski hareketler burada görünür; bu ekran geçmiş kayıtlara otomatik konum atamaz. Miktarlar kendi stok birimleri içinde karşılaştırılır.",
                   "slot": "dialog" } },
      { "id": "denetimTablosu", "type": "dataTable", "name": "denetimTablosu",
        "props": { "title": "Konumlandırma denetimi",
                   "description": "Raf/konum ataması olmayan hareketler nedeniyle depo bakiyesiyle konum bakiyeleri arasındaki fark",
                   "query": "denetim",
                   "columns": ["stockItemCode", "stockItemName", "warehouseQuantity", "locatedQuantity", "unlocatedQuantity", "unitCode"],
                   "columnLabels": ["stockItemCode=Stok kodu", "stockItemName=Stok adı", "warehouseQuantity=Depo bakiyesi",
                                    "locatedQuantity=Konumlandırılmış", "unlocatedQuantity=Konumu boş", "unitCode=Birim"],
                   "columnFormats": ["stockItemCode=code", "warehouseQuantity=number", "locatedQuantity=number", "unlocatedQuantity=number"],
                   "emptyText": "Konumu boş hareket kaynaklı fark bulunmuyor.", "slot": "dialog" } }
    ],
    "queries": [
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "runOn": "load", "parameters": [] },
      { "id": "konumlar", "name": "konumlar", "kind": "read", "operation": "depo.konumlari", "runOn": "load",
        "parameters": [ { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" } ] },
      { "id": "bakiyeler", "name": "bakiyeler", "kind": "read", "operation": "depo.konum.bakiyeleri", "runOn": "load",
        "parameters": [
          { "name": "warehouseId", "binding": "{{konumListesi.seciliSatir.warehouseId}}", "type": "guid" },
          { "name": "locationId", "binding": "{{konumListesi.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "denetim", "name": "denetim", "kind": "read", "operation": "depo.konumlandirmaDenetimi", "runOn": "load",
        "parameters": [ { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" } ] },
      { "id": "olustur", "name": "olustur", "kind": "insert", "operation": "depo.konum.olustur", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "code", "binding": "{{yeniKonumKodu.value}}", "type": "text" },
          { "name": "name", "binding": "{{yeniKonumAdi.value}}", "type": "text" },
          { "name": "parentLocationId", "binding": "{{yeniUstKonum.value}}", "type": "guid" } ] },
      { "id": "guncelle", "name": "guncelle", "kind": "update", "operation": "depo.konum.guncelle", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{konumListesi.seciliSatir.warehouseId}}", "type": "guid" },
          { "name": "locationId", "binding": "{{konumListesi.seciliSatir.id}}", "type": "guid" },
          { "name": "code", "binding": "{{konumKodu.value}}", "type": "text" },
          { "name": "name", "binding": "{{konumAdi.value}}", "type": "text" },
          { "name": "parentLocationId", "binding": "{{ustKonum.value}}", "type": "guid" },
          { "name": "isActive", "binding": "{{konumAktif.value}}", "type": "bool" },
          { "name": "rowVersion", "binding": "{{konumListesi.seciliSatir.rowVersion}}", "type": "text" } ] },
      { "id": "pasifeAl", "name": "pasifeAl", "kind": "update", "operation": "depo.konum.pasifeAl", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{konumListesi.seciliSatir.warehouseId}}", "type": "guid" },
          { "name": "locationId", "binding": "{{konumListesi.seciliSatir.id}}", "type": "guid" },
          { "name": "code", "binding": "{{konumListesi.seciliSatir.code}}", "type": "text" },
          { "name": "name", "binding": "{{konumListesi.seciliSatir.name}}", "type": "text" },
          { "name": "parentLocationId", "binding": "{{konumListesi.seciliSatir.parentLocationId}}", "type": "guid" },
          { "name": "rowVersion", "binding": "{{konumListesi.seciliSatir.rowVersion}}", "type": "text" } ] }
    ],
    "template": { "name": "list" }
  }
}
