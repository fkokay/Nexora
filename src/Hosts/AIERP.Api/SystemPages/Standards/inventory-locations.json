{
  "screenKey": "inventory-locations", "title": "Raf ve Konumlar",
  "description": "Ambar içindeki raf ve bölmeleri tanımlayın; konuma atanmış stok bakiyelerini izleyin.", "module": "Stok & Depo",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": { "since": 1, "label": "İşlem çubuğu",
      "requires": ["query:olustur", "query:guncelle", "component:konumKodu", "component:konumAdi", "component:ustKonum", "component:konumAktif",
                   "component:suzgec", "component:konumListesi", "component:pasifeAlDugmesi", "component:listeyiYenile"] },
    "component:suzgec": { "since": 1, "label": "Süzgeç alanı (arama, depo, durum)", "requires": ["component:konumListesi", "query:depolar"] },
    "component:depoSecinNotu": { "since": 1, "label": "Depo seçin notu", "requires": ["component:suzgec"] },
    "component:konumListesi": { "since": 1, "label": "Konum listesi", "requires": ["query:konumlar", "component:suzgec"] },
    "component:konumKarti": { "since": 1, "label": "Konum kaydı (sağ bölme)",
      "requires": ["component:konumListesi", "component:suzgec", "component:konumKimligi", "component:yerlesimVeDurum",
                   "component:konumOzeti", "component:bakiyeTablosu"] },
    "component:konumKimligi": { "since": 1, "label": "Form bölümü: Konum Kimliği", "requires": ["component:konumKodu", "component:konumAdi"] },
    "component:yerlesimVeDurum": { "since": 1, "label": "Form bölümü: Yerleşim ve Durum", "requires": ["component:ustKonum", "component:konumAktif"] },
    "component:konumKodu": { "since": 1, "label": "Alan: Konum kodu", "requires": ["component:konumListesi"] },
    "component:konumAdi": { "since": 1, "label": "Alan: Konum adı", "requires": ["component:konumListesi"] },
    "component:ustKonum": { "since": 1, "label": "Alan: Üst konum", "requires": ["component:konumListesi", "query:konumlar"] },
    "component:konumAktif": { "since": 1, "label": "Alan: Konum aktif", "requires": ["component:konumListesi"] },
    "component:konumOzeti": { "since": 1, "label": "Konum özeti (salt okunur)", "requires": ["component:konumListesi"] },
    "component:bakiyeTablosu": { "since": 1, "label": "Konum bakiyesi", "requires": ["query:bakiyeler", "component:konumListesi"] },
    "component:denetimTablosu": { "since": 1, "label": "Konumlandırma denetimi", "requires": ["query:denetim"] },
    "component:denetimNotu": { "since": 1, "label": "Konumlandırma denetimi notu" },
    "component:pasifeAlDugmesi": { "since": 1, "label": "Pasife al düğmesi",
      "requires": ["query:pasifeAl", "component:konumListesi", "component:konumKodu", "component:konumAdi"] },
    "component:listeyiYenile": { "since": 1, "label": "Kayıttan sonra listeyi yenile", "requires": ["query:konumlar"] },
    "query:depolar": { "since": 1, "label": "Depoları listele" },
    "query:konumlar": { "since": 1, "label": "Seçili deponun konumları", "requires": ["component:suzgec"] },
    "query:bakiyeler": { "since": 1, "label": "Seçili konumun stok bakiyeleri", "requires": ["component:konumListesi"] },
    "query:denetim": { "since": 1, "label": "Seçili deponun konumlandırma denetimi", "requires": ["component:suzgec"] },
    "query:olustur": { "since": 1, "label": "Depo konumu oluştur",
      "requires": ["component:suzgec", "component:konumKodu", "component:konumAdi", "component:ustKonum"] },
    "query:guncelle": { "since": 1, "label": "Depo konumu güncelle",
      "requires": ["component:konumListesi", "component:konumKodu", "component:konumAdi", "component:ustKonum", "component:konumAktif"] },
    "query:pasifeAl": { "since": 1, "label": "Depo konumunu pasife al", "requires": ["component:konumListesi"] }
  },
  "screenViews": [
    { "key": "inventory-warehouse-locations", "component": "konumListesi",
      "fields": { "code": "code", "name": "name", "status": "isActive" } },
    { "key": "warehouse-location-balances", "component": "bakiyeTablosu",
      "fields": { "stockItemCode": "stockItemCode", "stockItemName": "stockItemName", "quantity": "quantity", "unitCode": "unitCode" } },
    { "key": "inventory-warehouse-reconciliation", "component": "denetimTablosu",
      "fields": { "stockItemCode": "stockItemCode", "stockItemName": "stockItemName", "warehouseQuantity": "warehouseQuantity",
                  "locatedQuantity": "locatedQuantity", "unlocatedQuantity": "unlocatedQuantity", "unitCode": "unitCode" } }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "newInputs": ["konumKodu", "konumAdi", "ustKonum"], "newAction": "clear",
                   "saveSequence": ["olustur", "guncelle"], "stopOnError": true,
                   "sequenceWhen": ["olustur=konumListesi.seciliSatir.id == null && suzgec.warehouseId != null",
                                    "guncelle=konumListesi.seciliSatir.id != null"],
                   "afterSaveButton": "listeyiYenile",
                   "moreButtons": ["pasifeAlDugmesi"], "focusInput": "suzgec", "exportTable": "konumListesi",
                   "titleCount": "{{konumlar.rowCount}}" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "konumListesi", "search": true, "searchPlaceholder": "Kod veya ad ara", "searchColumns": ["code", "name"],
                   "filters": ["warehouseId|select|row|warehouseId|Depo|depolar:id:code:name|searchable,defaultFirst", "isActive|select|row||Durum"] } },
      { "id": "depoSecinNotu", "type": "text", "name": "depoSecinNotu",
        "props": { "text": "Konumları görmek için önce bir depo seçin.", "width": 6, "visibleWhen": "suzgec.warehouseId == null" } },
      { "id": "konumListesi", "type": "dataTable", "name": "konumListesi",
        "props": { "title": "Raf ve bölmeler", "query": "konumlar", "width": 6, "columns": ["code", "name", "isActive"],
                   "columnLabels": ["code=Konum kodu", "name=Konum adı", "isActive=Durum"],
                   "columnFormats": ["code=code", "isActive=status"],
                   "valueLabels": ["isActive:true=Aktif", "isActive:false=Pasif"], "toneMap": ["Aktif=success", "Pasif=info"],
                   "emptyText": "Bu depoda henüz konum yok. Kod ve ad vererek raf ya da bölme ekleyin.",
                   "visibleWhen": "suzgec.warehouseId != null" } },

      { "id": "konumKarti", "type": "card", "name": "konumKarti",
        "props": { "variant": "panel", "width": 6, "title": "{{konumListesi.seciliSatir.name}}", "description": "{{konumListesi.seciliSatir.code}}" },
        "children": [
          { "id": "konumAktifEtiketi", "type": "badge", "name": "konumAktifEtiketi",
            "props": { "text": "Aktif", "variant": "success", "visibleWhen": "konumListesi.seciliSatir.isActive == true" } },
          { "id": "konumPasifEtiketi", "type": "badge", "name": "konumPasifEtiketi",
            "props": { "text": "Pasif", "variant": "info", "visibleWhen": "konumListesi.seciliSatir.isActive == false" } },
          { "id": "yeniKonumBasligi", "type": "heading", "name": "yeniKonumBasligi",
            "props": { "text": "Konum oluştur", "visibleWhen": "konumListesi.seciliSatir.id == null && kullanici.rol == 'TenantAdmin'" } },
          { "id": "konumIcinDepoSecin", "type": "text", "name": "konumIcinDepoSecin",
            "props": { "text": "Konum eklemek için önce depo seçin.",
                       "visibleWhen": "konumListesi.seciliSatir.id == null && suzgec.warehouseId == null && kullanici.rol == 'TenantAdmin'" } },
          { "id": "konumSecin", "type": "text", "name": "konumSecin",
            "props": { "text": "Bir konum seçin.", "visibleWhen": "konumListesi.seciliSatir.id == null && kullanici.rol != 'TenantAdmin'" } },
          { "id": "konumSekmeleri", "type": "tabs", "name": "konumSekmeleri",
            "props": { "tabs": ["Konum=konumKimligi,yerlesimVeDurum,konumOzeti,bakiyeTablosu"] } }
        ] },
      { "id": "konumKimligi", "type": "formCard", "name": "konumKimligi",
        "props": { "title": "Konum Kimliği", "columns": 2, "inputs": ["konumKodu", "konumAdi"],
                   "recordKey": "{{konumListesi.seciliSatir.id}}:{{konumListesi.seciliSatir.rowVersion}}", "trackChanges": true,
                   "visibleWhen": "kullanici.rol == 'TenantAdmin'" } },
      { "id": "yerlesimVeDurum", "type": "formCard", "name": "yerlesimVeDurum",
        "props": { "title": "Yerleşim ve Durum", "columns": 2, "inputs": ["ustKonum", "konumAktif"],
                   "recordKey": "{{konumListesi.seciliSatir.id}}:{{konumListesi.seciliSatir.rowVersion}}", "trackChanges": true,
                   "visibleWhen": "kullanici.rol == 'TenantAdmin'" } },
      { "id": "konumKodu", "type": "input", "name": "konumKodu",
        "props": { "inputType": "text", "label": "Konum kodu", "required": true, "maxLength": 40, "upperCase": true, "placeholder": "A-01-03",
                   "defaultValue": "{{konumListesi.seciliSatir.code}}" } },
      { "id": "konumAdi", "type": "input", "name": "konumAdi",
        "props": { "inputType": "text", "label": "Konum adı", "required": true, "maxLength": 120, "placeholder": "Raf 3 · Göz 1",
                   "defaultValue": "{{konumListesi.seciliSatir.name}}" } },
      { "id": "ustKonum", "type": "input", "name": "ustKonum",
        "props": { "inputType": "select", "label": "Üst konum", "optionsQuery": "konumlar", "optionValueColumn": "id", "optionLabelColumn": "code",
                   "defaultValue": "{{konumListesi.seciliSatir.parentLocationId}}" } },
      { "id": "konumAktif", "type": "input", "name": "konumAktif",
        "props": { "inputType": "checkbox", "label": "Konum aktif", "defaultValue": "{{konumListesi.seciliSatir.isActive}}",
                   "visibleWhen": "konumListesi.seciliSatir.id != null" } },
      { "id": "konumOzeti", "type": "contextPanel", "name": "konumOzeti",
        "props": { "title": "Depo konumu", "table": "konumListesi", "fields": ["code=Konum kodu", "name=Konum adı", "isActive=Durum"],
                   "visibleWhen": "kullanici.rol != 'TenantAdmin' && konumListesi.seciliSatir.id != null" } },
      { "id": "bakiyeTablosu", "type": "dataTable", "name": "bakiyeTablosu",
        "props": { "title": "Konum bakiyesi", "query": "bakiyeler", "columns": ["stockItemCode", "stockItemName", "quantity", "unitCode"],
                   "columnLabels": ["stockItemCode=Stok kodu", "stockItemName=Stok adı", "quantity=Konum miktarı", "unitCode=Birim"],
                   "columnFormats": ["stockItemCode=code", "quantity=number"],
                   "emptyText": "Bu konumda stok bakiyesi bulunmuyor.", "visibleWhen": "konumListesi.seciliSatir.id != null" } },

      { "id": "denetimTablosu", "type": "dataTable", "name": "denetimTablosu",
        "props": { "title": "Konumlandırma denetimi",
                   "description": "Raf/konum ataması olmayan hareketler nedeniyle depo bakiyesiyle konum bakiyeleri arasındaki fark",
                   "query": "denetim", "width": 12,
                   "columns": ["stockItemCode", "stockItemName", "warehouseQuantity", "locatedQuantity", "unlocatedQuantity", "unitCode"],
                   "columnLabels": ["stockItemCode=Stok kodu", "stockItemName=Stok adı", "warehouseQuantity=Depo bakiyesi",
                                    "locatedQuantity=Konumlandırılmış", "unlocatedQuantity=Konumu boş", "unitCode=Birim"],
                   "columnFormats": ["stockItemCode=code", "warehouseQuantity=number", "locatedQuantity=number", "unlocatedQuantity=number"],
                   "emptyText": "Konumu boş hareket kaynaklı fark bulunmuyor." } },
      { "id": "denetimNotu", "type": "text", "name": "denetimNotu",
        "props": { "width": 12,
                   "text": "Konumu boş eski hareketler burada görünür; bu ekran geçmiş kayıtlara otomatik konum atamaz. Miktarlar kendi stok birimleri içinde karşılaştırılır." } },

      { "id": "pasifeAlDugmesi", "type": "button", "name": "pasifeAlDugmesi",
        "props": { "text": "Pasife al", "actionType": "query", "queryId": "pasifeAl", "confirmEnabled": true,
                   "confirmText": "{{konumListesi.seciliSatir.code}} · {{konumListesi.seciliSatir.name}} pasife alınsın mı? Konumlar silinmez; geçmiş hareketler korunur. Etkin alt konumu ya da stok bakiyesi olan konum pasife alınamaz.",
                   "successMessage": "Depo konumu güncellendi.", "refreshQueries": ["konumlar"],
                   "visibleWhen": "kullanici.rol == 'TenantAdmin' && konumListesi.seciliSatir.isActive == true",
                   "disabledWhen": "konumKodu.value != konumListesi.seciliSatir.code || konumAdi.value != konumListesi.seciliSatir.name",
                   "disabledReason": "Önce değişiklikleri kaydedin veya vazgeçin" } },
      { "id": "listeyiYenile", "type": "button", "name": "listeyiYenile",
        "props": { "text": "Listeyi yenile", "actionType": "query", "queryId": "konumlar" } }
    ],
    "queries": [
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "runOn": "load", "parameters": [] },
      { "id": "konumlar", "name": "konumlar", "kind": "read", "operation": "depo.konumlari", "runOn": "load",
        "parameters": [ { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" } ] },
      { "id": "bakiyeler", "name": "bakiyeler", "kind": "read", "operation": "depo.konum.bakiyeleri", "runOn": "load",
        "parameters": [
          { "name": "warehouseId", "binding": "{{konumListesi.seciliSatir.warehouseId}}", "type": "guid" },
          { "name": "locationId", "binding": "{{konumListesi.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "denetim", "name": "denetim", "kind": "read", "operation": "depo.konumlandirmaDenetimi", "runOn": "load",
        "parameters": [ { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" } ] },
      { "id": "olustur", "name": "olustur", "kind": "insert", "operation": "depo.konum.olustur", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "code", "binding": "{{konumKodu.value}}", "type": "text" },
          { "name": "name", "binding": "{{konumAdi.value}}", "type": "text" },
          { "name": "parentLocationId", "binding": "{{ustKonum.value}}", "type": "guid" } ] },
      { "id": "guncelle", "name": "guncelle", "kind": "update", "operation": "depo.konum.guncelle", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{konumListesi.seciliSatir.warehouseId}}", "type": "guid" },
          { "name": "locationId", "binding": "{{konumListesi.seciliSatir.id}}", "type": "guid" },
          { "name": "code", "binding": "{{konumKodu.value}}", "type": "text" },
          { "name": "name", "binding": "{{konumAdi.value}}", "type": "text" },
          { "name": "parentLocationId", "binding": "{{ustKonum.value}}", "type": "guid" },
          { "name": "isActive", "binding": "{{konumAktif.value}}", "type": "bool" },
          { "name": "rowVersion", "binding": "{{konumListesi.seciliSatir.rowVersion}}", "type": "text" } ] },
      { "id": "pasifeAl", "name": "pasifeAl", "kind": "update", "operation": "depo.konum.pasifeAl", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{konumListesi.seciliSatir.warehouseId}}", "type": "guid" },
          { "name": "locationId", "binding": "{{konumListesi.seciliSatir.id}}", "type": "guid" },
          { "name": "code", "binding": "{{konumListesi.seciliSatir.code}}", "type": "text" },
          { "name": "name", "binding": "{{konumListesi.seciliSatir.name}}", "type": "text" },
          { "name": "parentLocationId", "binding": "{{konumListesi.seciliSatir.parentLocationId}}", "type": "guid" },
          { "name": "rowVersion", "binding": "{{konumListesi.seciliSatir.rowVersion}}", "type": "text" } ] }
    ]
  }
}
