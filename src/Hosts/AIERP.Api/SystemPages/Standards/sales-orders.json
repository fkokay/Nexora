{
  "screenKey": "sales-orders", "title": "Satış Siparişleri",
  "description": "Bağımsız veya kabul edilen tekliflerden oluşan siparişleri ve sevkiyat süreçlerini yönetin.", "module": "Satış & cari",
  "version": 3, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:acDugmesi", "component:duzenleDugmesi", "component:irsaliyeOlusturDugmesi", "component:liste", "component:suzgec", "component:yeniDugmesi", "query:siparisSil", "query:siparisler"]},
    "component:yeniDugmesi": {"since": 1, "label": "Yeni sipariş komutu (tarih bugün)"},
    "component:acDugmesi": {"since": 1, "label": "Siparişi aç komutu", "requires": ["component:liste", "component:siparisPenceresi"]},
    "component:duzenleDugmesi": {"since": 1, "label": "Düzenle komutu (sipariş kartı: kimlik, müşteri, tarih)", "requires": ["component:liste"]},
    "component:irsaliyeOlusturDugmesi": {"since": 1, "label": "İrsaliye oluştur komutu (eski ekran)", "requires": ["component:liste"]},
    "component:onaylaDugmesi": {"since": 3, "label": "Onayla komutu (taslak sipariş)", "requires": ["component:liste", "query:onayla"]},
    "component:onayiGeriAlDugmesi": {"since": 3, "label": "Onayı geri al komutu (sevksiz onaylı sipariş)", "requires": ["component:liste", "query:onayiGeriAl"]},
    "component:iptalDugmesi": {"since": 3, "label": "İptal et komutu (gerekçeyle)", "requires": ["component:liste", "query:iptal"]},
    "component:tutarGostergesi": {"since": 1, "label": "Sipariş tutarı göstergesi (bu sayfa)", "requires": ["query:siparisler"]},
    "component:tutarKarisik": {"since": 1, "label": "Sipariş tutarı (birden çok para birimi)", "requires": ["query:siparisler"]},
    "component:sevkGostergesi": {"since": 1, "label": "Sevk bekleyen göstergesi", "requires": ["query:siparisler"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:liste": {"since": 1, "label": "Satış siparişleri listesi", "requires": ["component:acDugmesi", "query:siparisler"]},
    "component:siparisPenceresi": {"since": 1, "label": "Sipariş detayı penceresi", "requires": ["component:siparisBasligi", "component:siparisDurumu", "component:siparisIslemleri", "component:siparisSekmeleri", "query:siparis"]},
    "component:siparisBasligi": {"since": 1, "label": "Sipariş detayı başlığı", "requires": ["query:siparis"]},
    "component:siparisDurumu": {"since": 1, "label": "Sipariş durumu ve belge zinciri", "requires": ["query:sevkler", "query:siparis"]},
    "component:siparisIslemleri": {"since": 1, "label": "Sipariş detayı işlemleri", "requires": ["query:kalemler", "query:rezervasyonBirak", "query:sevkler", "query:siparis", "query:siparisSil", "query:siparisYenile", "query:siparisler"]},
    "component:siparisSekmeleri": {"since": 1, "label": "Sipariş detayı sekmeleri", "requires": ["component:irsaliyeTablosu", "component:kalemTablosu", "component:rezervasyonBolumu", "component:teslimBolumu", "query:sevkler"]},
    "component:kalemTablosu": {"since": 1, "label": "Sipariş satırları", "requires": ["query:kalemler"]},
    "component:teslimBolumu": {"since": 1, "label": "Teslim tarihi formu", "requires": ["component:teslimTarihi", "query:siparis", "query:siparisler", "query:teslimTarihiKaydet"]},
    "component:teslimTarihi": {"since": 1, "label": "İstenen teslim tarihi", "requires": ["query:siparis"]},
    "component:rezervasyonBolumu": {"since": 1, "label": "Stok ayırma formu", "requires": ["component:rezervasyonDeposu", "component:rezervasyonKimligi", "query:kalemler", "query:siparis", "query:stokAyir"]},
    "component:rezervasyonDeposu": {"since": 1, "label": "Rezervasyon deposu", "requires": ["query:depolar"]},
    "component:rezervasyonKimligi": {"since": 1, "label": "Rezervasyon tekrar deneme kimliği (gizli)"},
    "component:irsaliyeTablosu": {"since": 1, "label": "İrsaliye geçmişi", "requires": ["component:irsaliyeFaturaAc", "query:sevkler"]},
    "component:sevkSayfaBoyutu": {"since": 1, "label": "İrsaliye geçmişi sayfa boyutu (gizli, 100)"},
    "component:irsaliyeFaturaAc": {"since": 1, "label": "İrsaliyenin faturasını aç", "requires": ["component:irsaliyeTablosu"]},
    "query:siparisler": {"since": 1, "label": "Satış siparişlerini listele", "requires": ["component:liste", "component:suzgec"]},
    "query:siparis": {"since": 1, "label": "Seçili sipariş", "requires": ["component:liste"]},
    "query:kalemler": {"since": 1, "label": "Seçili siparişin kalemleri", "requires": ["component:liste"]},
    "query:sevkler": {"since": 1, "label": "Seçili siparişin irsaliyeleri", "requires": ["component:liste", "component:sevkSayfaBoyutu"]},
    "query:siparisYenile": {"since": 1, "label": "Sipariş detayını yenile", "requires": ["query:siparis"]},
    "query:depolar": {"since": 1, "label": "Depoları listele"},
    "query:siparisSil": {"since": 1, "label": "Siparişi sil", "requires": ["component:liste"]},
    "query:stokAyir": {"since": 1, "label": "Sipariş için stok ayır", "requires": ["component:liste", "component:rezervasyonDeposu", "component:rezervasyonKimligi"]},
    "query:rezervasyonBirak": {"since": 1, "label": "Stok rezervasyonunu bırak", "requires": ["component:liste", "component:siparisIslemleri"]},
    "query:teslimTarihiKaydet": {"since": 1, "label": "Teslim tarihini kaydet", "requires": ["component:liste", "component:teslimTarihi"]},
    "query:onayla": {"since": 3, "label": "Siparişi onayla", "requires": ["component:liste"]},
    "query:onayiGeriAl": {"since": 3, "label": "Siparişin onayını geri al", "requires": ["component:liste"]},
    "query:iptal": {"since": 3, "label": "Siparişi iptal et", "requires": ["component:liste", "component:iptalDugmesi"]}
  },
  "screenViews": [
    {"key": "sales-orders", "component": "liste", "fields": {"code": "code", "quoteCode": "quoteCode", "customerName": "customerName", "orderDate": "orderDate", "lineCount": "lineCount", "grandTotal": "grandTotal", "status": "status"}},
    {"key": "sales-order-lines", "component": "kalemTablosu", "fields": {"stockCode": "stockCode", "stockName": "stockName", "quantity": "quantity", "deliveredQuantity": "deliveredQuantity", "remainingQuantity": "remainingQuantity", "reservedQuantity": "reservedQuantity", "unitPrice": "unitPrice", "lineTotal": "lineTotal"}}
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": {
          "newButton": "yeniDugmesi",
          "openButton": "acDugmesi",
          "deleteQuery": "siparisSil", "deleteConfirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.customerName}} siparişi silinsin mi?",
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{siparisler.meta.totalCount}}",
          "moreButtons": ["duzenleDugmesi", "irsaliyeOlusturDugmesi", "onaylaDugmesi", "onayiGeriAlDugmesi", "iptalDugmesi"],
          "commandWhen": ["delete=kullanici.rol == 'TenantAdmin' && liste.seciliSatir.id != null"],
          "hiddenCommands": ["save", "print"] } },
      { "id": "yeniDugmesi", "type": "button", "name": "yeniDugmesi",
        "props": {
          "text": "Yeni sipariş",
          "actionType": "erpPage",
          "pageKey": "sales-order-create",
          "target": "newTab",
          "params": ["customerId={{sayfa.parametre.customerId}}", "orderDate={{bugun}}"] } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": {
          "text": "Aç",
          "icon": "open",
          "actionType": "openDialog",
          "dialogId": "siparisPenceresi",
          "disabledWhen": "liste.seciliSatir.id == null",
          "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "duzenleDugmesi", "type": "button", "name": "duzenleDugmesi",
        "props": {
          "text": "Düzenle",
          "actionType": "erpPage",
          "pageKey": "sales-order-create",
          "target": "newTab",
          "params": ["orderId={{liste.seciliSatir.id}}", "customerId={{liste.seciliSatir.customerId}}", "orderDate={{liste.seciliSatir.orderDate}}"],
          "visibleWhen": "liste.seciliSatir.status == 'Draft'" } },
      { "id": "onaylaDugmesi", "type": "button", "name": "onaylaDugmesi",
        "props": {
          "text": "Onayla",
          "actionType": "query",
          "queryId": "onayla",
          "visibleWhen": "liste.seciliSatir.status == 'Draft'",
          "successMessage": "Sipariş onaylandı.",
          "refreshQueries": ["siparisler", "siparis"] } },
      { "id": "onayiGeriAlDugmesi", "type": "button", "name": "onayiGeriAlDugmesi",
        "props": {
          "text": "Onayı geri al",
          "actionType": "query",
          "queryId": "onayiGeriAl",
          "visibleWhen": "liste.seciliSatir.status == 'Open'",
          "successMessage": "Siparişin onayı geri alındı; sipariş taslakta.",
          "refreshQueries": ["siparisler", "siparis"] } },
      { "id": "iptalDugmesi", "type": "button", "name": "iptalDugmesi",
        "props": {
          "text": "İptal et",
          "actionType": "query",
          "queryId": "iptal",
          "promptLabel": "Gerekçe",
          "promptRequired": true,
          "promptMaxLength": 500,
          "promptText": "{{liste.seciliSatir.code}} siparişi iptal edilsin mi? Aktif stok rezervasyonları bırakılır; gerekçe işlem günlüğüne yazılır.",
          "visibleWhen": "liste.seciliSatir.status == 'Draft' || liste.seciliSatir.status == 'Open'",
          "successMessage": "Sipariş iptal edildi.",
          "refreshQueries": ["siparisler", "siparis"] } },
      { "id": "irsaliyeOlusturDugmesi", "type": "button", "name": "irsaliyeOlusturDugmesi",
        "props": {
          "text": "İrsaliye oluştur",
          "actionType": "erpPage",
          "pageKey": "sales-orders",
          "target": "sameTab",
          "legacyScreen": true,
          "params": ["orderId={{liste.seciliSatir.id}}"],
          "visibleWhen": "liste.seciliSatir.status == 'Open'" } },
      { "id": "tutarGostergesi", "type": "metric", "name": "tutarGostergesi",
        "props": {
          "title": "Sipariş tutarı",
          "value": "{{siparisler.meta.pageGrandTotal}}",
          "format": "money",
          "width": 3,
          "icon": "wallet",
          "description": "bu sayfa · iptaller hariç · {{siparisler.meta.pageCurrencyCode}}",
          "visibleWhen": "siparisler.meta.pageMixedCurrencies != true" } },
      { "id": "tutarKarisik", "type": "metric", "name": "tutarKarisik",
        "props": {
          "title": "Sipariş tutarı",
          "value": "—",
          "width": 3,
          "icon": "wallet",
          "description": "bu sayfa · iptaller hariç · birden çok para birimi",
          "visibleWhen": "siparisler.meta.pageMixedCurrencies == true" } },
      { "id": "sevkGostergesi", "type": "metric", "name": "sevkGostergesi",
        "props": {
          "title": "Sevk bekleyen",
          "query": "siparisler",
          "countWhen": "siparisler.satir.status == 'Open'",
          "format": "number",
          "width": 3,
          "icon": "truck",
          "variant": "warning",
          "description": "bu sayfa" } },
      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": {
          "table": "liste",
          "width": 10,
          "search": true,
          "searchPlaceholder": "Sipariş no veya müşteriyle ara",
          "searchParam": "q" } },
      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": {
          "title": "Satış siparişleri",
          "query": "siparisler",
          "paging": "server",
          "pageSize": 25,
          "width": 12,
          "columns": ["code", "quoteCode", "customerName", "orderDate", "requestedDeliveryDate", "lineCount", "grandTotal", "status"],
          "columnLabels": ["code=Sipariş no", "quoteCode=Kaynak teklif", "customerName=Müşteri", "orderDate=Sipariş tarihi", "requestedDeliveryDate=Teslim tarihi", "lineCount=Satır", "grandTotal=Genel toplam", "status=Durum", "currencyCode=Döviz", "createdAt=Oluşturulma"],
          "columnFormats": ["code=code", "orderDate=date", "requestedDeliveryDate=date", "lineCount=number", "grandTotal=money", "status=status", "createdAt=date"],
          "columnUnits": ["grandTotal=currencyCode"],
          "valueLabels": ["status:Open=Açık", "status:Fulfilled=Tamamlandı", "status:Cancelled=İptal"],
          "toneMap": ["Açık=warning", "Tamamlandı=success", "İptal=info"],
          "rowOpenAction": "acDugmesi",
          "openParam": "orderId",
          "emptyText": "Aramanızla eşleşen sipariş yok." } },
      { "id": "siparisPenceresi", "type": "dialog", "name": "siparisPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Satış siparişi · {{siparis.rows[0].code}}",
          "contains": ["siparisBasligi", "siparisDurumu", "siparisIslemleri", "siparisSekmeleri"] } },
      { "id": "siparisBasligi", "type": "recordHeader", "name": "siparisBasligi",
        "props": {
          "icon": "shopping-cart",
          "title": "{{siparis.rows[0].code}} · {{siparis.rows[0].customerName}}",
          "subtitle": "{{siparis.rows[0].orderDate}} · teslim {{siparis.rows[0].requestedDeliveryDate}} · {{siparis.rows[0].currencyCode}}",
          "fields": ["Genel toplam={{siparis.rows[0].grandTotal}}", "Ara toplam={{siparis.rows[0].subtotal}}", "İskonto={{siparis.rows[0].discountTotal}}", "KDV={{siparis.rows[0].taxTotal}}", "Kaynak teklif={{siparis.rows[0].quoteCode}}"],
          "fieldFormats": ["Genel toplam=money", "Ara toplam=money", "İskonto=money", "KDV=money"],
          "fieldUnits": ["Genel toplam={{siparis.rows[0].currencyCode}}", "Ara toplam={{siparis.rows[0].currencyCode}}", "İskonto={{siparis.rows[0].currencyCode}}", "KDV={{siparis.rows[0].currencyCode}}"] } },
      { "id": "siparisDurumu", "type": "section", "name": "siparisDurumu",
        "props": {
          "width": 12 },
        "children": [
          { "id": "rozetTaslak", "type": "badge", "name": "rozetTaslak",
            "props": {
              "text": "Taslak",
              "variant": "info",
              "visibleWhen": "siparis.rows[0].status == 'Draft'" } },
          { "id": "rozetAcik", "type": "badge", "name": "rozetAcik",
            "props": {
              "text": "Onaylı",
              "variant": "warning",
              "visibleWhen": "siparis.rows[0].status == 'Open'" } },
          { "id": "rozetTamam", "type": "badge", "name": "rozetTamam",
            "props": {
              "text": "Sevk edildi",
              "variant": "success",
              "visibleWhen": "siparis.rows[0].status == 'Fulfilled'" } },
          { "id": "rozetFaturalandi", "type": "badge", "name": "rozetFaturalandi",
            "props": {
              "text": "Faturalandı",
              "variant": "success",
              "visibleWhen": "siparis.rows[0].status == 'Invoiced'" } },
          { "id": "rozetIptal", "type": "badge", "name": "rozetIptal",
            "props": {
              "text": "İptal",
              "variant": "info",
              "visibleWhen": "siparis.rows[0].status == 'Cancelled'" } },
          { "id": "rozetKismi", "type": "badge", "name": "rozetKismi",
            "props": {
              "text": "Kısmi sevk",
              "variant": "info",
              "visibleWhen": "siparis.rows[0].status == 'Open' && sevkler.satirSayisi > 0" } },
          { "id": "belgeZinciri", "type": "text", "name": "belgeZinciri",
            "props": {
              "text": "Teklif {{siparis.rows[0].quoteCode}} › Sipariş {{siparis.rows[0].code}} › İrsaliye {{sevkler.rows[0].code}} ({{sevkler.satirSayisi}}) › Fatura: İrsaliye Geçmişi sekmesinde" } }
        ] },
      { "id": "siparisIslemleri", "type": "section", "name": "siparisIslemleri",
        "props": {
          "width": 12 },
        "children": [
          { "id": "detayYenile", "type": "button", "name": "detayYenile",
            "props": {
              "text": "Yenile",
              "icon": "refresh-cw",
              "actionType": "query",
              "queryId": "siparisYenile",
              "refreshQueries": ["siparis", "kalemler", "sevkler"] } },
          { "id": "detayIrsaliye", "type": "button", "name": "detayIrsaliye",
            "props": {
              "text": "İrsaliye oluştur ›",
              "actionType": "erpPage",
              "pageKey": "sales-orders",
              "target": "sameTab",
              "legacyScreen": true,
              "params": ["orderId={{siparis.rows[0].id}}"],
              "visibleWhen": "siparis.rows[0].status == 'Open'" } },
          { "id": "detayTeklif", "type": "button", "name": "detayTeklif",
            "props": {
              "text": "Teklifi aç ›",
              "actionType": "erpPage",
              "pageKey": "sales-quotes",
              "target": "newTab",
              "params": ["quoteId={{siparis.rows[0].quoteId}}"],
              "visibleWhen": "siparis.rows[0].quoteId != null" } },
          { "id": "detayRezervasyonBirak", "type": "button", "name": "detayRezervasyonBirak",
            "props": {
              "text": "Rezervasyonu bırak",
              "actionType": "query",
              "queryId": "rezervasyonBirak",
              "promptLabel": "Gerekçe",
              "promptRequired": true,
              "promptMaxLength": 500,
              "promptText": "Stok rezervasyonu bırakılsın mı? {{siparis.rows[0].code}} siparişinin aktif rezervasyonları serbest kalır; gerekçe denetim kaydına yazılır.",
              "visibleWhen": "kullanici.rol == 'TenantAdmin' && siparis.rows[0].status == 'Open' && kalemler.rows[0].reservationId != null",
              "successMessage": "Stok rezervasyonu bırakıldı.",
              "refreshQueries": ["siparis", "kalemler"] } },
          { "id": "detaySil", "type": "button", "name": "detaySil",
            "props": {
              "text": "Sil",
              "actionType": "query",
              "queryId": "siparisSil",
              "confirmEnabled": true,
              "confirmText": "Sipariş silinsin mi? “{{siparis.rows[0].code}}” siparişi ve özel alan geçmişi silinecek.",
              "visibleWhen": "kullanici.rol == 'TenantAdmin'",
              "successMessage": "Sipariş silindi.",
              "refreshQueries": ["siparisler"] } }
        ] },
      { "id": "siparisSekmeleri", "type": "tabs", "name": "siparisSekmeleri",
        "props": {
          "tabs": ["Sipariş Bilgileri=kalemTablosu,teslimBolumu,rezervasyonBolumu", "İrsaliye Geçmişi {{sevkler.satirSayisi}}=irsaliyeTablosu"] } },
      { "id": "kalemTablosu", "type": "dataTable", "name": "kalemTablosu",
        "props": {
          "title": "Sipariş satırları",
          "query": "kalemler",
          "width": 12,
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showExport": false,
          "showPivot": false,
          "showCsv": false,
          "showSelectedExport": false,
          "columns": ["stockCode", "stockName", "quantity", "deliveredQuantity", "remainingQuantity", "reservedQuantity", "unitPrice", "lineTotal"],
          "columnLabels": ["stockCode=Stok kodu", "stockName=Stok adı", "quantity=Sipariş", "deliveredQuantity=Teslim edilen", "remainingQuantity=Kalan", "reservedQuantity=Rezerve", "unitPrice=Birim fiyat", "lineTotal=Satır toplamı", "discountPercent=İsk. %", "vatPercent=KDV %", "taxAmount=KDV tutarı", "enteredUnitPrice=Girilen fiyat"],
          "columnFormats": ["stockCode=code", "quantity=number", "deliveredQuantity=number", "remainingQuantity=number", "reservedQuantity=number", "unitPrice=money", "lineTotal=money", "discountPercent=number", "vatPercent=number", "taxAmount=money", "enteredUnitPrice=money"],
          "columnUnits": ["quantity=unitCode", "reservedQuantity=reservationWarehouseName", "enteredUnitPrice=enteredCurrencyCode"],
          "totals": ["lineTotal"],
          "emptyText": "Sipariş satırı yok. Miktarlar temel birimdedir." } },
      { "id": "teslimBolumu", "type": "section", "name": "teslimBolumu",
        "props": {
          "width": 12,
          "title": "Teslim tarihi",
          "description": "MRP, onaylı sipariş talebini bu tarihte karşılamaya çalışır.",
          "visibleWhen": "siparis.rows[0].status == 'Draft' || siparis.rows[0].status == 'Open'" },
        "children": [
          { "id": "teslimFormu", "type": "formCard", "name": "teslimFormu",
            "props": {
              "layout": "inline",
              "inputs": ["teslimTarihi"] } },
          { "id": "teslimKaydet", "type": "button", "name": "teslimKaydet",
            "props": {
              "text": "Teslim tarihini kaydet",
              "actionType": "query",
              "queryId": "teslimTarihiKaydet",
              "successMessage": "Teslim tarihi kaydedildi; MRP bu tarihi ihtiyaç tarihi olarak kullanacak.",
              "refreshQueries": ["siparis", "siparisler"] } }
        ] },
      { "id": "teslimTarihi", "type": "input", "name": "teslimTarihi",
        "props": {
          "inputType": "date",
          "label": "İstenen teslim tarihi",
          "defaultValue": "{{siparis.rows[0].requestedDeliveryDate}}" } },
      { "id": "rezervasyonBolumu", "type": "section", "name": "rezervasyonBolumu",
        "props": {
          "width": 12,
          "title": "Stok ayır",
          "description": "Siparişin teslim edilmemiş ürün miktarları seçilen depoda rezerve edilir. Bu işlem stok hareketi oluşturmaz.",
          "visibleWhen": "siparis.rows[0].status == 'Open' && kalemler.rows[0].reservationId == null" },
        "children": [
          { "id": "rezervasyonFormu", "type": "formCard", "name": "rezervasyonFormu",
            "props": {
              "layout": "inline",
              "inputs": ["rezervasyonDeposu", "rezervasyonKimligi"] } },
          { "id": "stokAyirKaydet", "type": "button", "name": "stokAyirKaydet",
            "props": {
              "text": "Stok ayır",
