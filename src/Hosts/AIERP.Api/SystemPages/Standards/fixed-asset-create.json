        "component:vukTabloYili",
        "component:vukTebligNo",
        "component:vukOmur",
        "component:vukOran",
        "component:vukBaslangic",
        "component:vukOnay",
        "component:vukAcik"
      ]
    },
    "component:vukKodu": {
      "since": 1,
      "label": "Alan: VUK tablo kodu",
