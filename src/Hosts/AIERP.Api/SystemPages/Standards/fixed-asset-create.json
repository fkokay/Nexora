{
  "screenKey": "fixed-asset-create",
  "title": "Yeni edinim",
  "description": "Duran varlık edinim kaydı: kıymet bilgileri, tarihler ve faydalı ömür, maliyet, bağlı alış faturası ve isteğe bağlı VUK profili.",
  "module": "Duran Varlık",
  "version": 2,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "İşlem çubuğu (Kaydet, Yeni)",
