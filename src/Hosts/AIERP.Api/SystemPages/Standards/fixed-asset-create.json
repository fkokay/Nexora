    "component:kalinti": {
      "since": 1,
      "label": "Alan: Kalıntı değer"
    },
    "component:referans": {
      "since": 1,
      "label": "Alan: Kaynak referansı"
    },
    "component:muhasebeKarti": {
      "since": 1,
      "label": "Kart bölümü: Muhasebe kaynağı",
      "requires": [
        "component:fatura"
      ]
    },
    "component:fatura": {
      "since": 1,
      "label": "Alan: Bağlı alış faturası",
      "requires": [
        "query:faturalar"
      ]
    },
    "component:faturaNotu": {
      "since": 1,
      "label": "Bağlı fatura notu"
    },
    "component:durumNotu": {
      "since": 1,
      "label": "Baz para birimi ve fiş notu"
    },
    "component:vukSecimKarti": {
      "since": 1,
      "label": "Kart bölümü: VUK profili seçimi",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukAcik": {
      "since": 1,
      "label": "Alan: VUK profili ekle"
    },
    "component:vukBilgi": {
      "since": 1,
      "label": "VUK profili bilgisi",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukKarti": {
      "since": 1,
      "label": "Kart bölümü: VUK vergi profili",
      "requires": [
        "component:vukKodu",
