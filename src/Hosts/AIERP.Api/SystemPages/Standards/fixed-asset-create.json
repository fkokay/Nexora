      ]
    },
    "component:vukAciklama": {
      "since": 1,
      "label": "Alan: Kıymet sınıfı açıklaması",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukTabloYili": {
      "since": 1,
      "label": "Alan: Tablo yılı",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukTebligNo": {
      "since": 1,
      "label": "Alan: Tebliğ no",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukOmur": {
      "since": 1,
      "label": "Alan: Vergi faydalı ömrü (ay)",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukOran": {
      "since": 1,
      "label": "Alan: Normal amortisman oranı (%)",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukBaslangic": {
      "since": 1,
      "label": "Alan: Vergi amortisman başlangıcı",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukOnay": {
      "since": 1,
      "label": "Alan: Mali müşavir doğrulaması",
      "requires": [
        "component:vukAcik"
      ]
    },
    "component:vukOnayUyarisi": {
      "since": 1,
      "label": "VUK doğrulama onayı uyarısı",
      "requires": [
        "component:vukAcik",
        "component:vukOnay"
      ]
    },
    "component:vukTablosu": {
      "since": 1,
      "label": "GİB amortisman oranları tablosu bağlantısı",
      "requires": [
        "component:vukAcik"
      ]
    },
    "query:faturalar": {
      "since": 1,
      "label": "Bağlanabilir alış faturaları"
    },
    "query:vukKatalog": {
      "since": 1,
      "label": "VUK faydalı ömür kataloğu",
      "requires": [
        "component:vukKodu"
      ]
    },
    "query:olustur": {
      "since": 1,
      "label": "Duran varlık edinimini kaydet",
      "requires": [
        "component:kod",
        "component:ad",
        "component:kategori",
        "component:edinimTarihi",
        "component:kullanimaGiris",
        "component:maliyet",
        "component:kalinti",
        "component:omur",
        "component:referans",
        "component:fatura",
        "component:vukKodu",
        "component:vukAciklama",
        "component:vukTabloYili",
        "component:vukTebligNo",
        "component:vukOmur",
        "component:vukOran",
        "component:vukBaslangic"
      ]
    }
  },
  "definition": {
    "schemaVersion": 2,
    "template": {
      "name": "record"
    },
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "saveQuery": "olustur",
          "newAction": "page",
          "newPageCode": "@fixed-asset-create",
          "newTarget": "sameTab",
          "afterSaveAction": "page",
          "afterSavePageCode": "@fixed-assets",
          "afterSaveTarget": "sameTab",
          "afterSaveRefresh": true,
          "hiddenCommands": [
            "open",
            "delete",
            "filter",
            "print",
            "export"
          ],
          "commandWhen": [
            "save=vukAcik.value != true || vukOnay.value == true"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "ozet",
        "type": "recordHeader",
        "name": "ozet",
        "props": {
          "icon": "building",
          "title": "Yeni edinim",
          "subtitle": "{{kod.value}} {{ad.value}}",
          "fields": [
            "Edinim maliyeti={{maliyet.value}}",
            "Faydalı ömür (ay)={{omur.value}}"
          ],
          "fieldFormats": [
            "Edinim maliyeti=money",
            "Faydalı ömür (ay)=number"
          ],
          "slot": "summary"
        }
      },
      {
        "id": "sekmeler",
        "type": "tabs",
        "name": "sekmeler",
        "props": {
          "tabs": [
            "Kıymet=kimlikKarti,tarihKarti,altSinirNotu",
            "Maliyet ve muhasebe=maliyetKarti,muhasebeKarti,faturaNotu,durumNotu",
            "VUK vergi profili=vukSecimKarti,vukBilgi,vukKarti,vukOnayUyarisi"
          ],
          "slot": "tabs"
        }
      },
      {
        "id": "kimlikKarti",
        "type": "formCard",
        "name": "kimlikKarti",
        "props": {
          "title": "Kıymet bilgileri",
          "columns": 3,
          "inputs": [
            "kod",
            "ad",
            "kategori"
          ],
          "recordKey": "yeni",
          "slot": "section"
        }
      },
      {
        "id": "kod",
        "type": "input",
        "name": "kod",
        "props": {
          "inputType": "text",
          "label": "Kıymet kodu",
          "required": true,
          "maxLength": 40,
          "upperCase": true,
          "placeholder": "DV-CNC-03",
          "pattern": "^[A-Za-z0-9._-]+$",
          "patternMessage": "Kod yalnız harf, rakam, nokta, tire ve alt çizgi içerebilir.",
          "slot": "field"
        }
      },
      {
        "id": "ad",
        "type": "input",
        "name": "ad",
        "props": {
          "inputType": "text",
          "label": "Ad",
          "required": true,
          "maxLength": 160,
          "slot": "field"
        }
      },
      {
        "id": "kategori",
        "type": "input",
        "name": "kategori",
        "props": {
          "inputType": "text",
          "label": "Kategori",
          "maxLength": 80,
          "placeholder": "Makine, taşıt, demirbaş…",
          "slot": "field"
        }
      },
      {
        "id": "tarihKarti",
        "type": "formCard",
        "name": "tarihKarti",
        "props": {
          "title": "Tarihler ve faydalı ömür",
          "columns": 3,
          "inputs": [
            "edinimTarihi",
            "kullanimaGiris",
            "omur"
          ],
          "recordKey": "yeni",
          "slot": "section"
        }
      },
      {
        "id": "edinimTarihi",
        "type": "input",
        "name": "edinimTarihi",
        "props": {
          "inputType": "date",
          "label": "Edinim tarihi",
          "required": true,
          "defaultValue": "{{bugun}}",
          "slot": "field"
        }
      },
      {
        "id": "kullanimaGiris",
        "type": "input",
        "name": "kullanimaGiris",
        "props": {
          "inputType": "date",
          "label": "Kullanıma giriş",
          "required": true,
          "defaultValue": "{{bugun}}",
          "slot": "field"
        }
      },
      {
        "id": "omur",
        "type": "input",
        "name": "omur",
        "props": {
          "inputType": "number",
          "label": "Faydalı ömür (ay)",
          "required": true,
          "min": 1,
          "max": 1200,
          "step": 1,
          "defaultValue": "60",
          "slot": "field"
        }
      },
      {
        "id": "altSinirNotu",
        "type": "text",
        "name": "altSinirNotu",
        "props": {
          "text": "Edinim yılının GİB VUK amortisman alt sınırı kayıtla birlikte saklanır ve kıymet kartının Genel sekmesinde görünür. Bilgilendirme amaçlıdır; otomatik gider yazma kararı değildir.",
          "slot": "note"
        }
      },
      {
        "id": "maliyetKarti",
        "type": "formCard",
        "name": "maliyetKarti",
        "props": {
          "title": "Maliyet ve referans",
          "columns": 3,
          "inputs": [
            "maliyet",
            "kalinti",
            "referans"
          ],
          "recordKey": "yeni",
          "slot": "section"
        }
      },
      {
        "id": "maliyet",
        "type": "input",
        "name": "maliyet",
        "props": {
          "inputType": "number",
          "label": "Edinim maliyeti",
          "required": true,
          "min": 0.01,
          "step": 0.01,
          "slot": "field"
        }
      },
      {
        "id": "kalinti",
        "type": "input",
        "name": "kalinti",
        "props": {
          "inputType": "number",
          "label": "Kalıntı değer",
          "required": true,
          "min": 0,
          "step": 0.01,
          "defaultValue": "0",
          "slot": "field"
        }
      },
      {
        "id": "referans",
        "type": "input",
        "name": "referans",
        "props": {
          "inputType": "text",
          "label": "Kaynak referansı",
          "maxLength": 120,
          "placeholder": "Sözleşme / irsaliye no",
          "slot": "field"
        }
      },
      {
        "id": "muhasebeKarti",
        "type": "formCard",
        "name": "muhasebeKarti",
        "props": {
          "title": "Muhasebe kaynağı",
          "columns": 1,
          "inputs": [
            "fatura"
          ],
          "recordKey": "yeni",
          "slot": "section"
        }
      },
      {
        "id": "fatura",
        "type": "input",
        "name": "fatura",
        "props": {
          "inputType": "lookup",
          "label": "Bağlı alış faturası (isteğe bağlı)",
          "optionsQuery": "faturalar",
          "optionValueColumn": "id",
          "optionLabelColumn": "label",
          "minChars": 0,
          "allowClear": true,
          "placeholder": "Fatura bağlantısı yok",
          "slot": "field"
        }
      },
      {
        "id": "faturaNotu",
        "type": "text",
        "name": "faturaNotu",
        "props": {
          "text": "Fatura bağlandığında muhasebe kaynağı alış faturası olur; çift kayıt olmaması için ayrı edinim fişi engellenir.",
          "slot": "note"
        }
      },
      {
        "id": "durumNotu",
        "type": "text",
        "name": "durumNotu",
        "props": {
          "text": "Tutarlar firma baz para birimindedir. Edinim kaydı yevmiye yazmaz; fiş kıymet kartının Edinim muhasebesi sekmesinden oluşturulur.",
          "slot": "note"
        }
      },
      {
        "id": "vukSecimKarti",
        "type": "formCard",
        "name": "vukSecimKarti",
        "props": {
          "title": "İsteğe bağlı VUK vergi profili",
          "columns": 1,
          "inputs": [
            "vukAcik"
          ],
          "recordKey": "yeni",
          "slot": "section"
        }
      },
      {
        "id": "vukAcik",
        "type": "input",
        "name": "vukAcik",
        "props": {
          "inputType": "checkbox",
          "label": "Mali müşavir tarafından doğrulanmış VUK amortisman profili ekle",
          "clearsOnChange": [
            "vukKodu",
            "vukAciklama",
            "vukTabloYili",
            "vukTebligNo",
            "vukOmur",
            "vukOran",
            "vukBaslangic",
            "vukOnay"
          ],
          "slot": "field"
        }
      },
      {
        "id": "vukBilgi",
        "type": "text",
        "name": "vukBilgi",
        "props": {
          "text": "Tablo kodunu GİB amortisman oranları tablosundan seçin; açıklama, tablo yılı, tebliğ no, vergi ömrü ve oranı tablodan aynen yazın. Profil yalnızca vergi amortismanı tahmini içindir.",
          "visibleWhen": "vukAcik.value == true",
          "slot": "note"
        }
      },
      {
        "id": "vukKarti",
        "type": "formCard",
        "name": "vukKarti",
        "props": {
          "title": "VUK vergi profili",
          "columns": 3,
          "inputs": [
            "vukKodu",
            "vukAciklama",
            "vukTabloYili",
            "vukTebligNo",
            "vukOmur",
            "vukOran",
            "vukBaslangic",
            "vukOnay"
          ],
          "visibleWhen": "vukAcik.value == true",
          "recordKey": "yeni",
          "slot": "section"
        }
      },
      {
        "id": "vukKodu",
        "type": "input",
        "name": "vukKodu",
        "props": {
          "inputType": "lookup",
          "label": "Tablo kodu",
          "requiredWhen": "vukAcik.value == true",
          "optionsQuery": "vukKatalog",
          "optionValueColumn": "code",
          "optionLabelColumn": "code",
          "optionDescriptionColumn": "description",
          "minChars": 0,
          "allowClear": true,
          "placeholder": "Katalogdan seçin",
          "slot": "field"
        }
      },
      {
        "id": "vukAciklama",
        "type": "input",
        "name": "vukAciklama",
        "props": {
          "inputType": "text",
          "label": "Kıymet sınıfı açıklaması",
          "requiredWhen": "vukAcik.value == true",
          "maxLength": 500,
          "slot": "field"
        }
      },
      {
        "id": "vukTabloYili",
        "type": "input",
        "name": "vukTabloYili",
        "props": {
          "inputType": "number",
          "label": "Tablo yılı",
          "requiredWhen": "vukAcik.value == true",
          "min": 2004,
          "max": 2100,
          "step": 1,
          "placeholder": "ör. 2026",
          "slot": "field"
        }
      },
      {
        "id": "vukTebligNo",
        "type": "input",
        "name": "vukTebligNo",
        "props": {
          "inputType": "number",
          "label": "Tebliğ no",
          "requiredWhen": "vukAcik.value == true",
          "min": 1,
          "max": 999,
          "step": 1,
          "placeholder": "1–999",
          "slot": "field"
        }
      },
      {
        "id": "vukOmur",
        "type": "input",
        "name": "vukOmur",
        "props": {
          "inputType": "number",
          "label": "Vergi faydalı ömrü (ay)",
          "requiredWhen": "vukAcik.value == true",
          "min": 1,
          "max": 1200,
          "step": 1,
          "slot": "field"
        }
      },
      {
        "id": "vukOran",
        "type": "input",
        "name": "vukOran",
        "props": {
          "inputType": "number",
          "label": "Normal amortisman oranı (%)",
          "requiredWhen": "vukAcik.value == true",
          "min": 0.01,
          "max": 100,
          "step": 0.01,
          "slot": "field"
        }
      },
      {
        "id": "vukBaslangic",
        "type": "input",
        "name": "vukBaslangic",
        "props": {
          "inputType": "date",
          "label": "Vergi amortisman başlangıcı",
          "requiredWhen": "vukAcik.value == true",
          "placeholder": "≥ edinim tarihi",
          "slot": "field"
        }
      },
      {
        "id": "vukOnay",
        "type": "input",
        "name": "vukOnay",
        "props": {
          "inputType": "checkbox",
          "label": "Bu profili ve vergi başlangıç tarihini firma mali müşaviriyle doğruladım.",
          "requiredWhen": "vukAcik.value == true",
          "slot": "field"
        }
      },
      {
        "id": "vukOnayUyarisi",
        "type": "text",
        "name": "vukOnayUyarisi",
        "props": {
          "text": "VUK profilini mali müşavirinizle doğruladığınızı onaylayın.",
          "visibleWhen": "vukAcik.value == true && vukOnay.value != true",
          "slot": "note"
        }
      },
      {
        "id": "vukTablosu",
        "type": "button",
        "name": "vukTablosu",
        "props": {
          "text": "GİB amortisman oranları tablosu ›",
          "actionType": "link",
          "target": "newTab",
          "href": "https://cdn.gib.gov.tr/api/gibportal-file/file/getFileResources?objectKey=arsiv%2Fyardim-kaynaklar%2Fyararli-bilgiler%2FAmortismanOranlariTablosu.pdf",
          "visibleWhen": "vukAcik.value == true",
          "slot": "actions"
        }
      }
    ],
    "queries": [
      {
        "id": "faturalar",
        "name": "faturalar",
        "kind": "read",
        "operation": "duranVarlik.alisFaturalari",
        "runOn": "load",
        "parameters": []
      },
      {
        "id": "vukKatalog",
        "name": "vukKatalog",
        "kind": "read",
        "operation": "duranVarlik.vukOmurKatalogu",
        "runOn": "load",
        "parameters": [
          {
            "name": "q",
            "binding": "{{vukKodu.search}}",
            "type": "text"
          }
        ]
      },
      {
        "id": "olustur",
        "name": "olustur",
        "kind": "insert",
        "operation": "duranVarlik.kiymet.olustur",
        "runOn": "manual",
        "parameters": [
          {
            "name": "assetCode",
            "binding": "{{kod.value}}",
            "type": "text"
          },
          {
            "name": "name",
            "binding": "{{ad.value}}",
            "type": "text"
          },
          {
            "name": "category",
            "binding": "{{kategori.value}}",
            "type": "text"
          },
          {
            "name": "acquisitionDate",
            "binding": "{{edinimTarihi.value}}",
