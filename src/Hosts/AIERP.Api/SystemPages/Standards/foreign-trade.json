{
  "screenKey": "foreign-trade",
  "title": "Dış Ticaret Dosyaları",
  "description": "Satın alma ve satış siparişlerine bağlı lojistik, gümrük referansı ve sevkiyat adımlarını izleyin.",
  "module": "Dış Ticaret",
  "version": 1,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "İşlem çubuğu",
      "requires": [
        "component:yeniDugmesi",
        "component:acDugmesi",
        "component:suzgec",
        "component:liste",
        "query:dosyalar",
        "component:ithalatDugmesi",
        "component:ihracatDugmesi",
        "component:planlaDugmesi",
        "component:sevkDugmesi",
        "component:gumrukDugmesi",
        "component:varisDugmesi",
        "component:kapatDugmesi",
        "component:belgeBaglaDugmesi",
        "component:iptalDugmesi"
      ]
    },
    "component:yeniDugmesi": {
      "since": 1,
      "label": "Yeni dosya komutu",
      "requires": [
        "component:yonSecimi"
      ]
    },
    "component:acDugmesi": {
      "since": 1,
      "label": "Satırı aç (dosya kartı)",
