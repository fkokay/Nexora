        "component:detayPaneli",
        "component:liste",
        "query:dosya"
      ]
    },
    "component:bosSecim": {
      "since": 1,
      "label": "Detay paneli: seçim yok notu",
      "requires": [
        "component:detayPaneli",
        "component:liste"
      ]
    },
    "component:ithalatDugmesi": {
      "since": 1,
      "label": "Yeni ithalat dosyası komutu"
    },
    "component:ihracatDugmesi": {
      "since": 1,
      "label": "Yeni ihracat dosyası komutu"
