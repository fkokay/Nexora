{
  "screenKey": "foreign-trade", "title": "Dış Ticaret Dosyaları",
  "description": "Satın alma ve satış siparişlerine bağlı lojistik, gümrük referansı ve sevkiyat adımlarını izleyin.", "module": "Dış Ticaret",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:ithalatDugmesi", "component:acDugmesi", "query:dosyalar"]},
    "component:toplamGostergesi": {"since": 1, "label": "Toplam dosya göstergesi", "requires": ["query:ozet"]},
    "component:sevktekiGostergesi": {"since": 1, "label": "Sevkte göstergesi", "requires": ["query:ozet"]},
    "component:ulastiGostergesi": {"since": 1, "label": "Ulaştı (kapatılacak) göstergesi", "requires": ["query:ozet"]},
    "component:kapandiGostergesi": {"since": 1, "label": "Kapandı göstergesi", "requires": ["query:ozet"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama, yön, aşama)", "requires": ["component:liste"]},
    "component:liste": {"since": 1, "label": "Dış ticaret dosyaları listesi", "requires": ["query:dosyalar"]},
    "component:detayKarti": {"since": 1, "label": "Detay: seçili dosyanın özeti ve ön koşullar", "requires": ["component:liste", "query:dosya"]},
    "component:ithalatDugmesi": {"since": 1, "label": "İthalat dosyası komutu"},
    "component:ihracatDugmesi": {"since": 1, "label": "İhracat dosyası komutu"},
    "component:acDugmesi": {"since": 1, "label": "Aç komutu (Taslak, Planlandı)"},
    "component:planlaDugmesi": {"since": 1, "label": "Planlandı'ya geçir", "requires": ["query:planla", "query:dosya"]},
    "component:sevkDugmesi": {"since": 1, "label": "Sevkte'ye geçir…", "requires": ["component:sevkPenceresi", "query:dosya"]},
    "component:gumrukDugmesi": {"since": 1, "label": "Gümrükte'ye geçir…", "requires": ["component:gumrukPenceresi", "query:dosya"]},
    "component:varisDugmesi": {"since": 1, "label": "Varışı kaydet…", "requires": ["component:varisPenceresi", "query:dosya"]},
    "component:kapatDugmesi": {"since": 1, "label": "Kapat", "requires": ["query:kapat", "query:dosya"]},
    "component:belgeBaglaDugmesi": {"since": 1, "label": "Stok belgesi bağla…", "requires": ["component:belgePenceresi", "query:dosya"]},
    "component:iptalDugmesi": {"since": 1, "label": "İptal et", "requires": ["query:iptalEt", "query:dosya"]},
    "component:sevkPenceresi": {"since": 1, "label": "Sevk penceresi", "requires": ["component:sevkBilgileri", "component:sevkNotu", "query:sevkEt"]},
    "component:gumrukPenceresi": {"since": 1, "label": "Gümrük penceresi", "requires": ["component:gumrukBilgileri", "query:gumrugeGecir"]},
    "component:varisPenceresi": {"since": 1, "label": "Varış penceresi", "requires": ["component:varisBilgileri", "component:varisNotu", "query:varisKaydet"]},
    "component:belgePenceresi": {"since": 1, "label": "Stok belgesi penceresi", "requires": ["component:belgeTuruMalKabul", "component:belgeTuruIrsaliye", "component:belgeNotu", "component:belgeListesi", "query:bagla"]},
    "component:sevkBilgileri": {"since": 1, "label": "Sevk alanları", "requires": ["component:sevkTarihi", "component:sevkTasiyici"]},
    "component:sevkTarihi": {"since": 1, "label": "Sevk alanı: Gerçek tarih"},
    "component:sevkTasiyici": {"since": 1, "label": "Sevk alanı: Taşıyıcı / takip"},
    "component:sevkNotu": {"since": 1, "label": "Sevk bilgi notu"},
    "component:gumrukBilgileri": {"since": 1, "label": "Gümrük alanları", "requires": ["component:gumrukReferansi"]},
    "component:gumrukReferansi": {"since": 1, "label": "Gümrük alanı: Referans"},
    "component:varisBilgileri": {"since": 1, "label": "Varış alanları", "requires": ["component:varisTarihi"]},
    "component:varisTarihi": {"since": 1, "label": "Varış alanı: Gerçek tarih"},
    "component:varisNotu": {"since": 1, "label": "Varış bilgi notu"},
    "component:belgeTuruMalKabul": {"since": 1, "label": "Belge türü notu: mal kabul"},
    "component:belgeTuruIrsaliye": {"since": 1, "label": "Belge türü notu: irsaliye"},
    "component:belgeNotu": {"since": 1, "label": "Stok belgesi bilgi notu"},
    "component:belgeListesi": {"since": 1, "label": "Stok belgeleri tablosu", "requires": ["query:belgeler"]},
    "query:dosyalar": {"since": 1, "label": "Dosyaları listele", "requires": ["component:suzgec", "component:liste"]},
    "query:ozet": {"since": 1, "label": "Dosya özet sayıları", "requires": ["component:suzgec"]},
    "query:dosya": {"since": 1, "label": "Seçili dosya", "requires": ["component:liste"]},
    "query:belgeler": {"since": 1, "label": "Bağlanabilir stok belgeleri", "requires": ["component:liste"]},
    "query:planla": {"since": 1, "label": "Planlandı aşamasına geçir"},
    "query:sevkEt": {"since": 1, "label": "Sevkte aşamasına geçir"},
    "query:gumrugeGecir": {"since": 1, "label": "Gümrükte aşamasına geçir"},
    "query:varisKaydet": {"since": 1, "label": "Varışı kaydet"},
    "query:kapat": {"since": 1, "label": "Dosyayı kapat"},
    "query:iptalEt": {"since": 1, "label": "Dosyayı iptal et"},
    "query:bagla": {"since": 1, "label": "Stok belgesi bağla"}
  },
  "screenViews": [{"key": "foreign-trade-files", "component": "liste", "fields": {"reference": "referenceCode", "direction": "direction", "linkedOrder": "orderCode", "countries": "route", "status": "status", "transportMode": "transportMode"}}],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"newButton": "ithalatDugmesi", "openButton": "acDugmesi", "moreButtons": ["ihracatDugmesi", "planlaDugmesi", "sevkDugmesi", "gumrukDugmesi", "varisDugmesi", "kapatDugmesi", "belgeBaglaDugmesi", "iptalDugmesi"], "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{dosyalar.meta.totalCount}}", "hiddenCommands": ["save", "print", "delete"], "slot": "commands"}},
      {"id": "toplamGostergesi", "type": "metric", "name": "toplamGostergesi", "props": {"title": "Toplam dosya", "value": "{{ozet.rows[0].totalCount}}", "format": "number", "icon": "globe", "variant": "info", "description": "tüm dosyalar", "slot": "indicators"}},
      {"id": "sevktekiGostergesi", "type": "metric", "name": "sevktekiGostergesi", "props": {"title": "Sevkte", "value": "{{ozet.rows[0].shippedCount}}", "format": "number", "icon": "truck", "variant": "warning", "description": "yolda", "slot": "indicators"}},
      {"id": "ulastiGostergesi", "type": "metric", "name": "ulastiGostergesi", "props": {"title": "Ulaştı (kapatılacak)", "value": "{{ozet.rows[0].arrivedCount}}", "format": "number", "icon": "package", "variant": "warning", "description": "kapatma bekliyor", "slot": "indicators"}},
      {"id": "kapandiGostergesi", "type": "metric", "name": "kapandiGostergesi", "props": {"title": "Kapandı", "value": "{{ozet.rows[0].closedCount}}", "format": "number", "icon": "check", "variant": "success", "description": "tamamlanan", "slot": "indicators"}},
      {"id": "suzgec", "type": "filterBar", "name": "suzgec", "props": {"table": "liste", "search": true, "searchPlaceholder": "Referans, gümrük veya taşıyıcı referansı ara", "searchParam": "q", "filters": ["direction|select|row|direction|Yön", "status|select|row|status|Aşama"], "slot": "filters"}},
      {"id": "liste", "type": "dataTable", "name": "liste", "props": {"title": "Dış ticaret dosyaları", "query": "dosyalar", "paging": "server", "pageSize": 50, "columns": ["referenceCode", "direction", "orderCode", "counterpartyName", "route", "incotermsCode", "shipDate", "arrivalDate", "status"], "columnLabels": ["referenceCode=Dosya", "direction=Yön", "orderCode=Sipariş", "counterpartyName=Cari", "route=Rota", "incotermsCode=Incoterms", "shipDate=Sevk", "arrivalDate=Varış", "status=Durum", "transportMode=Taşıma", "plannedShipDate=Planlanan sevk", "actualShipDate=Gerçek sevk", "plannedArrivalDate=Planlanan varış", "actualArrivalDate=Gerçek varış", "harmonizedSystemCode=HS kodu", "customsReference=Gümrük ref.", "carrierReference=Taşıyıcı ref.", "declaredValue=Beyan değeri"], "columnFormats": ["referenceCode=code", "orderCode=code", "shipDate=date", "arrivalDate=date", "status=status", "plannedShipDate=date", "actualShipDate=date", "plannedArrivalDate=date", "actualArrivalDate=date", "declaredValue=money"], "columnUnits": ["declaredValue=currencyCode"], "valueLabels": ["direction:Import=İthalat", "direction:Export=İhracat", "status:Draft=Taslak", "status:Booked=Planlandı", "status:Shipped=Sevkte", "status:CustomsClearance=Gümrükte", "status:Arrived=Ulaştı", "status:Closed=Kapandı", "status:Cancelled=İptal", "transportMode:Road=Kara", "transportMode:Sea=Deniz", "transportMode:Air=Hava", "transportMode:Rail=Demir yolu", "transportMode:Multimodal=Çok modlu"], "toneMap": ["Taslak=info", "Planlandı=warning", "Sevkte=warning", "Gümrükte=warning", "Ulaştı=warning", "Kapandı=success"], "rowOpenAction": "acDugmesi", "openParam": "id", "emptyText": "Henüz dış ticaret dosyası yok ya da arama ve süzgeçlerle eşleşen dosya bulunamadı.", "slot": "list"}},
      {"id": "detayKarti", "type": "card", "name": "detayKarti", "props": {"variant": "panel", "title": "{{liste.seciliSatir.referenceCode}}", "description": "{{liste.seciliSatir.orderCode}} · {{liste.seciliSatir.counterpartyName}}", "slot": "detail"}, "children": [{"id": "detayBos", "type": "text", "name": "detayBos", "props": {"text": "Bir dosya seçin; özetini burada görün.", "visibleWhen": "liste.seciliSatir.id == null"}}, {"id": "durumTaslak", "type": "badge", "name": "durumTaslak", "props": {"text": "Taslak · sıradaki: Planlandı", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Draft'"}}, {"id": "durumPlanlandi", "type": "badge", "name": "durumPlanlandi", "props": {"text": "Planlandı · sıradaki: Sevkte", "variant": "warning", "visibleWhen": "liste.seciliSatir.status == 'Booked'"}}, {"id": "durumSevkte", "type": "badge", "name": "durumSevkte", "props": {"text": "Sevkte · sıradaki: Gümrükte", "variant": "warning", "visibleWhen": "liste.seciliSatir.status == 'Shipped'"}}, {"id": "durumGumrukte", "type": "badge", "name": "durumGumrukte", "props": {"text": "Gümrükte · sıradaki: Ulaştı", "variant": "warning", "visibleWhen": "liste.seciliSatir.status == 'CustomsClearance'"}}, {"id": "durumUlasti", "type": "badge", "name": "durumUlasti", "props": {"text": "Ulaştı · sıradaki: Kapandı", "variant": "warning", "visibleWhen": "liste.seciliSatir.status == 'Arrived'"}}, {"id": "durumKapandi", "type": "badge", "name": "durumKapandi", "props": {"text": "Kapandı", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Closed'"}}, {"id": "durumIptal", "type": "badge", "name": "durumIptal", "props": {"text": "İptal", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Cancelled'"}}, {"id": "detayBilgi", "type": "contextPanel", "name": "detayBilgi", "props": {"table": "liste", "visibleWhen": "liste.seciliSatir.id != null", "fields": ["orderCode=Sipariş", "counterpartyName=Cari", "route=Rota", "incotermsCode=Incoterms", "transportMode=Taşıma", "harmonizedSystemCode=HS kodu", "declaredValue=Beyan değeri", "plannedShipDate=Planlanan sevk", "plannedArrivalDate=Planlanan varış", "carrierReference=Taşıyıcı ref.", "customsReference=Gümrük ref."]}}, {"id": "belgeBagli", "type": "text", "name": "belgeBagli", "props": {"text": "Stok belgesi: Bağlı (mevcut belge; stok ikinci kez işlenmedi)", "visibleWhen": "liste.seciliSatir.purchaseReceiptId != null || liste.seciliSatir.salesDeliveryId != null"}}, {"id": "belgeYok", "type": "text", "name": "belgeYok", "props": {"text": "Stok belgesi: Bağlanmadı", "visibleWhen": "liste.seciliSatir.purchaseReceiptId == null && liste.seciliSatir.salesDeliveryId == null"}}, {"id": "sevkOnKosulu", "type": "alert", "name": "sevkOnKosulu", "props": {"title": "Sevke geçmek için gerekli", "variant": "warning", "text": "Planlanan sevk tarihi, sıfırdan büyük beyan değeri ve Incoterms. Dosyayı Aç ile açıp girin.", "visibleWhen": "liste.seciliSatir.status == 'Booked' && (liste.seciliSatir.plannedShipDate == null || liste.seciliSatir.declaredValue <= 0 || liste.seciliSatir.incotermsCode == null)"}}, {"id": "gumrukOnKosulu", "type": "alert", "name": "gumrukOnKosulu", "props": {"title": "Gümrüğe geçmek için gerekli", "variant": "warning", "text": "Kayıtlı teslimat belgesini bu dosyaya bağlayın (İşlemler › Stok belgesi bağla…). Gümrük referansı geçişte istenir.", "visibleWhen": "liste.seciliSatir.status == 'Shipped' && liste.seciliSatir.direction == 'Export' && liste.seciliSatir.salesDeliveryId == null"}}, {"id": "kapatOnKosulu", "type": "alert", "name": "kapatOnKosulu", "props": {"title": "Kapatmak için gerekli", "variant": "warning", "text": "Gerçek varış tarihi kayıtlı olmalı; ithalatta kayıtlı mal kabul belgesi bu dosyaya bağlanmalı (İşlemler › Stok belgesi bağla…).", "visibleWhen": "liste.seciliSatir.status == 'Arrived' && (liste.seciliSatir.actualArrivalDate == null || liste.seciliSatir.direction == 'Import' && liste.seciliSatir.purchaseReceiptId == null)"}}, {"id": "iptalNotu", "type": "alert", "name": "iptalNotu", "props": {"title": "İptal edildi", "variant": "info", "text": "İptal edildi · sevk başlamadan kapatıldı", "visibleWhen": "liste.seciliSatir.status == 'Cancelled'"}}, {"id": "yasalNot", "type": "text", "name": "yasalNot", "props": {"text": "İç operasyon kaydıdır; resmî gümrük beyannamesi değildir. Gümrük beyannamesi, akreditif ve masraf dağıtımı bu dosyada tutulmaz."}}]},
      {"id": "ithalatDugmesi", "type": "button", "name": "ithalatDugmesi", "props": {"text": "İthalat dosyası", "actionType": "page", "pageCode": "@foreign-trade-case", "target": "newTab", "params": ["direction=Import"], "slot": "actions"}},
      {"id": "ihracatDugmesi", "type": "button", "name": "ihracatDugmesi", "props": {"text": "İhracat dosyası", "actionType": "page", "pageCode": "@foreign-trade-case", "target": "newTab", "params": ["direction=Export"], "slot": "actions"}},
      {"id": "acDugmesi", "type": "button", "name": "acDugmesi", "props": {"text": "Aç", "icon": "open", "actionType": "page", "pageCode": "@foreign-trade-case", "target": "newTab", "params": ["id={{liste.seciliSatir.id}}"], "visibleWhen": "liste.seciliSatir.id != null", "disabledWhen": "!(liste.seciliSatir.status in ['Draft', 'Booked'])", "disabledReason": "Yalnız Taslak ve Planlandı dosyalar düzenlenebilir", "slot": "actions"}},
      {"id": "planlaDugmesi", "type": "button", "name": "planlaDugmesi", "props": {"text": "Planlandı aşamasına geçir", "actionType": "query", "queryId": "planla", "visibleWhen": "liste.seciliSatir.status == 'Draft'", "successMessage": "{{liste.seciliSatir.referenceCode}}: Planlandı aşamasına geçirildi.", "refreshQueries": ["dosyalar", "ozet", "dosya", "belgeler"], "slot": "actions"}},
      {"id": "sevkDugmesi", "type": "button", "name": "sevkDugmesi", "props": {"text": "Sevkte aşamasına geçir…", "actionType": "openDialog", "dialogId": "sevkPenceresi", "visibleWhen": "liste.seciliSatir.status == 'Booked'", "disabledWhen": "liste.seciliSatir.plannedShipDate == null || liste.seciliSatir.declaredValue <= 0 || liste.seciliSatir.incotermsCode == null", "disabledReason": "Önce dosyayı açıp planlanan sevk tarihi, beyan değeri ve Incoterms girin", "slot": "actions"}},
      {"id": "gumrukDugmesi", "type": "button", "name": "gumrukDugmesi", "props": {"text": "Gümrükte aşamasına geçir…", "actionType": "openDialog", "dialogId": "gumrukPenceresi", "visibleWhen": "liste.seciliSatir.status == 'Shipped'", "disabledWhen": "liste.seciliSatir.direction == 'Export' && liste.seciliSatir.salesDeliveryId == null", "disabledReason": "Önce kayıtlı teslimat belgesini bu dosyaya bağlayın", "slot": "actions"}},
      {"id": "varisDugmesi", "type": "button", "name": "varisDugmesi", "props": {"text": "Varışı kaydet…", "actionType": "openDialog", "dialogId": "varisPenceresi", "visibleWhen": "liste.seciliSatir.status == 'CustomsClearance'", "slot": "actions"}},
      {"id": "kapatDugmesi", "type": "button", "name": "kapatDugmesi", "props": {"text": "Kapat", "actionType": "query", "queryId": "kapat", "visibleWhen": "liste.seciliSatir.status == 'Arrived'", "disabledWhen": "liste.seciliSatir.actualArrivalDate == null || liste.seciliSatir.direction == 'Import' && liste.seciliSatir.purchaseReceiptId == null", "disabledReason": "Kapatmak için gerçek varış tarihi ve ithalatta bağlı mal kabul belgesi gerekir", "successMessage": "{{liste.seciliSatir.referenceCode}}: dosya kapatıldı.", "refreshQueries": ["dosyalar", "ozet", "dosya", "belgeler"], "slot": "actions"}},
      {"id": "belgeBaglaDugmesi", "type": "button", "name": "belgeBaglaDugmesi", "props": {"text": "Stok belgesi bağla…", "actionType": "openDialog", "dialogId": "belgePenceresi", "visibleWhen": "liste.seciliSatir.purchaseReceiptId == null && liste.seciliSatir.salesDeliveryId == null && (liste.seciliSatir.status in ['Arrived', 'Closed'] || liste.seciliSatir.direction == 'Export' && liste.seciliSatir.status in ['Shipped', 'CustomsClearance'])", "slot": "actions"}},
      {"id": "iptalDugmesi", "type": "button", "name": "iptalDugmesi", "props": {"text": "İptal et", "actionType": "query", "queryId": "iptalEt", "confirmEnabled": true, "confirmText": "Dosyayı iptal et: {{liste.seciliSatir.referenceCode}} iptal edilsin mi? Bu işlem geri alınamaz.", "visibleWhen": "liste.seciliSatir.status in ['Draft', 'Booked']", "successMessage": "{{liste.seciliSatir.referenceCode}}: dosya iptal edildi.", "refreshQueries": ["dosyalar", "ozet", "dosya", "belgeler"], "slot": "actions"}},
      {"id": "sevkPenceresi", "type": "dialog", "name": "sevkPenceresi", "props": {"presentation": "dialog", "size": "sm", "title": "Sevkte aşamasına geçir · {{liste.seciliSatir.referenceCode}}", "contains": ["sevkBilgileri", "sevkNotu"], "saveQuery": "sevkEt", "saveLabel": "Geçir", "closeOnSave": true, "resetOnOpen": true, "refreshQueries": ["dosyalar", "ozet", "dosya", "belgeler"], "slot": "dialogs"}},
      {"id": "gumrukPenceresi", "type": "dialog", "name": "gumrukPenceresi", "props": {"presentation": "dialog", "size": "sm", "title": "Gümrükte aşamasına geçir · {{liste.seciliSatir.referenceCode}}", "contains": ["gumrukBilgileri"], "saveQuery": "gumrugeGecir", "saveLabel": "Geçir", "closeOnSave": true, "resetOnOpen": true, "refreshQueries": ["dosyalar", "ozet", "dosya", "belgeler"], "slot": "dialogs"}},
      {"id": "varisPenceresi", "type": "dialog", "name": "varisPenceresi", "props": {"presentation": "dialog", "size": "sm", "title": "Varışı kaydet · {{liste.seciliSatir.referenceCode}}", "contains": ["varisBilgileri", "varisNotu"], "saveQuery": "varisKaydet", "saveLabel": "Kaydet", "closeOnSave": true, "resetOnOpen": true, "refreshQueries": ["dosyalar", "ozet", "dosya", "belgeler"], "slot": "dialogs"}},
      {"id": "belgePenceresi", "type": "dialog", "name": "belgePenceresi", "props": {"presentation": "dialog", "size": "lg", "title": "Stok belgesi seç · {{liste.seciliSatir.referenceCode}}", "contains": ["belgeTuruMalKabul", "belgeTuruIrsaliye", "belgeNotu", "belgeListesi"], "saveQuery": "bagla", "saveLabel": "Bağla", "closeOnSave": true, "resetOnOpen": true, "refreshQueries": ["dosyalar", "ozet", "dosya", "belgeler"], "slot": "dialogs"}},
      {"id": "sevkBilgileri", "type": "formCard", "name": "sevkBilgileri", "props": {"title": "Sevkiyat", "columns": 1, "inputs": ["sevkTarihi", "sevkTasiyici"], "slot": "dialog"}},
      {"id": "sevkTarihi", "type": "input", "name": "sevkTarihi", "props": {"inputType": "date", "label": "Gerçek tarih", "placeholder": "Boş bırakılırsa bugün", "slot": "dialog"}},
      {"id": "sevkTasiyici", "type": "input", "name": "sevkTasiyici", "props": {"inputType": "text", "label": "Taşıyıcı / takip referansı", "maxLength": 100, "defaultValue": "{{liste.seciliSatir.carrierReference}}", "slot": "dialog"}},
      {"id": "sevkNotu", "type": "text", "name": "sevkNotu", "props": {"text": "Gerçek tarih boş bırakılırsa bugün yazılır. Geçmiş tarih girilebilir; gelecek tarih reddedilir.", "slot": "dialog"}},
      {"id": "gumrukBilgileri", "type": "formCard", "name": "gumrukBilgileri", "props": {"title": "Gümrük", "columns": 1, "inputs": ["gumrukReferansi"], "slot": "dialog"}},
      {"id": "gumrukReferansi", "type": "input", "name": "gumrukReferansi", "props": {"inputType": "text", "label": "Gümrük referansı", "required": true, "maxLength": 100, "placeholder": "ör. 26TR3400…", "defaultValue": "{{liste.seciliSatir.customsReference}}", "slot": "dialog"}},
      {"id": "varisBilgileri", "type": "formCard", "name": "varisBilgileri", "props": {"title": "Varış", "columns": 1, "inputs": ["varisTarihi"], "slot": "dialog"}},
      {"id": "varisTarihi", "type": "input", "name": "varisTarihi", "props": {"inputType": "date", "label": "Gerçek tarih", "placeholder": "Boş bırakılırsa bugün", "slot": "dialog"}},
      {"id": "varisNotu", "type": "text", "name": "varisNotu", "props": {"text": "Gerçek tarih boş bırakılırsa bugün yazılır. Geçmiş tarih girilebilir; gelecek tarih reddedilir.", "slot": "dialog"}},
