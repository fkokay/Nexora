  },
  "screenViews": [
    {
      "key": "foreign-trade-files",
      "component": "liste",
      "fields": {
        "reference": "referenceCode",
        "direction": "direction",
        "linkedOrder": "orderCode",
        "countries": "route",
        "status": "status",
        "transportMode": "transportMode"
      }
    }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "newButton": "yeniDugmesi",
          "openButton": "acDugmesi",
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{dosyalar.meta.totalCount}}",
          "moreButtons": [
            "ithalatDugmesi",
            "ihracatDugmesi",
            "planlaDugmesi",
            "sevkDugmesi",
            "gumrukDugmesi",
            "varisDugmesi",
            "kapatDugmesi",
            "belgeBaglaDugmesi",
            "iptalDugmesi"
          ],
          "hiddenCommands": [
            "save",
            "print",
            "delete"
          ]
        }
      },
      {
        "id": "yeniDugmesi",
        "type": "button",
        "name": "yeniDugmesi",
        "props": {
          "text": "Yeni",
          "actionType": "page",
          "pageCode": "@foreign-trade-case",
          "target": "newTab",
          "params": [
            "direction={{yonSecimi.value}}"
          ]
        }
      },
      {
        "id": "acDugmesi",
        "type": "button",
        "name": "acDugmesi",
        "props": {
          "text": "Aç",
          "icon": "open",
          "actionType": "page",
          "pageCode": "@foreign-trade-case",
          "target": "newTab",
          "params": [
            "id={{liste.seciliSatir.id}}"
          ],
          "visibleWhen": "liste.seciliSatir.id != null",
          "disabledWhen": "!(liste.seciliSatir.status in ['Draft', 'Booked'])",
          "disabledReason": "Yalnız Taslak ve Planlandı dosyalar düzenlenebilir"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "width": 5,
          "search": true,
          "searchPlaceholder": "Referans, gümrük veya taşıyıcı referansı ara",
          "searchParam": "q"
        }
      },
      {
        "id": "suzgecSecimleri",
        "type": "formCard",
        "name": "suzgecSecimleri",
        "props": {
          "title": "Süzgeçler",
          "layout": "inline",
          "width": 5,
          "inputs": [
            "yonSecimi",
            "durumSecimi"
          ]
        }
      },
      {
        "id": "yonSecimi",
        "type": "input",
        "name": "yonSecimi",
        "props": {
          "inputType": "select",
          "label": "Yön",
          "staticOptions": [
            "=Tümü",
            "Import=İthalat",
            "Export=İhracat"
          ]
        }
      },
      {
        "id": "durumSecimi",
        "type": "input",
        "name": "durumSecimi",
        "props": {
          "inputType": "select",
          "label": "Aşama",
          "staticOptions": [
            "=Tümü",
            "Draft=Taslak",
            "Booked=Planlandı",
            "Shipped=Sevkte",
            "CustomsClearance=Gümrükte",
            "Arrived=Ulaştı",
            "Closed=Kapandı",
            "Cancelled=İptal"
          ]
        }
      },
      {
        "id": "gorunumKarti",
        "type": "formCard",
        "name": "gorunumKarti",
        "props": {
          "title": "Görünüm",
          "layout": "inline",
          "width": 2,
          "inputs": [
            "detayPaneli"
          ]
        }
      },
      {
        "id": "detayPaneli",
        "type": "input",
        "name": "detayPaneli",
        "props": {
          "inputType": "checkbox",
          "label": "Detay paneli",
          "icon": "panel",
          "defaultWhen": "sayfa.genis == true"
        }
      },
      {
        "id": "secimCipleri",
        "type": "filterChips",
        "name": "secimCipleri",
        "props": {
          "width": 12,
          "inputs": [
            "yonSecimi",
            "durumSecimi"
          ]
        }
      },
      {
        "id": "ozetSayilari",
        "type": "text",
        "name": "ozetSayilari",
        "props": {
          "width": 12,
          "text": "Tümü {{ozet.rows[0].totalCount}} · İthalat {{ozet.rows[0].importCount}} · İhracat {{ozet.rows[0].exportCount}} · Taslak {{ozet.rows[0].draftCount}} · Planlandı {{ozet.rows[0].bookedCount}} · Sevkte {{ozet.rows[0].shippedCount}} · Gümrükte {{ozet.rows[0].customsClearanceCount}} · Ulaştı {{ozet.rows[0].arrivedCount}} · Kapandı {{ozet.rows[0].closedCount}} · İptal {{ozet.rows[0].cancelledCount}}"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Dış ticaret dosyaları",
          "query": "dosyalar",
          "paging": "server",
          "pageSize": 50,
          "width": 12,
          "widthWhen": "8=detayPaneli.value == true",
          "columns": [
            "referenceCode",
            "direction",
            "orderCode",
            "counterpartyName",
            "route",
            "incotermsCode",
            "shipDate",
            "arrivalDate",
            "status"
          ],
          "columnLabels": [
            "referenceCode=Dosya",
            "direction=Yön",
            "orderCode=Sipariş",
            "counterpartyName=Cari",
            "route=Rota",
            "incotermsCode=Incoterms",
            "shipDate=Sevk",
            "arrivalDate=Varış",
            "status=Durum",
            "transportMode=Taşıma",
            "plannedShipDate=Planlanan sevk",
            "actualShipDate=Gerçek sevk",
            "plannedArrivalDate=Planlanan varış",
            "actualArrivalDate=Gerçek varış",
            "harmonizedSystemCode=HS kodu",
            "customsReference=Gümrük ref.",
            "carrierReference=Taşıyıcı ref.",
            "declaredValue=Beyan değeri"
          ],
          "columnFormats": [
            "referenceCode=code",
            "orderCode=code",
            "shipDate=date",
            "arrivalDate=date",
            "status=status",
            "plannedShipDate=date",
            "actualShipDate=date",
            "plannedArrivalDate=date",
            "actualArrivalDate=date",
            "declaredValue=money"
          ],
          "columnUnits": [
            "declaredValue=currencyCode"
          ],
          "valueLabels": [
            "direction:Import=İthalat",
            "direction:Export=İhracat",
            "status:Draft=Taslak",
            "status:Booked=Planlandı",
            "status:Shipped=Sevkte",
            "status:CustomsClearance=Gümrükte",
            "status:Arrived=Ulaştı",
            "status:Closed=Kapandı",
            "status:Cancelled=İptal",
            "transportMode:Road=Kara",
            "transportMode:Sea=Deniz",
            "transportMode:Air=Hava",
            "transportMode:Rail=Demir yolu",
            "transportMode:Multimodal=Çok modlu"
          ],
          "toneMap": [
            "Taslak=info",
            "Planlandı=warning",
            "Sevkte=warning",
            "Gümrükte=warning",
            "Ulaştı=warning",
            "Kapandı=success"
          ],
          "rowOpenAction": "acDugmesi",
          "openParam": "id",
          "emptyText": "Henüz dış ticaret dosyası yok ya da arama ve süzgeçlerle eşleşen dosya bulunamadı."
        }
      },
      {
        "id": "detayKarti",
        "type": "card",
        "name": "detayKarti",
        "props": {
          "variant": "panel",
          "title": "{{dosya.rows[0].referenceCode}}",
          "closeInput": "detayPaneli",
          "width": 4,
          "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null"
        },
        "children": [
          {
            "id": "detayAc",
            "type": "button",
            "name": "detayAc",
            "props": {
              "text": "Aç",
              "icon": "open",
              "actionType": "page",
              "pageCode": "@foreign-trade-case",
              "target": "newTab",
              "params": [
                "id={{liste.seciliSatir.id}}"
              ],
              "disabledWhen": "!(liste.seciliSatir.status in ['Draft', 'Booked'])",
              "disabledReason": "Yalnız Taslak ve Planlandı dosyalar düzenlenebilir"
            }
          },
          {
            "id": "seciliIthalat",
            "type": "text",
            "name": "seciliIthalat",
            "props": {
              "text": "Seçili dosya · İthalat",
              "visibleWhen": "dosya.rows[0].direction == 'Import'"
            }
          },
          {
            "id": "seciliIhracat",
            "type": "text",
            "name": "seciliIhracat",
            "props": {
              "text": "Seçili dosya · İhracat",
              "visibleWhen": "dosya.rows[0].direction == 'Export'"
            }
          },
          {
            "id": "asamaAkisi",
            "type": "steps",
            "name": "asamaAkisi",
            "props": {
              "steps": [
                "Taslak",
                "Planlandı",
                "Sevkte",
                "Gümrükte",
                "Ulaştı",
                "Kapandı"
              ],
              "activeWhen": [
                "dosya.rows[0].status == 'Draft'",
                "dosya.rows[0].status == 'Booked'",
                "dosya.rows[0].status == 'Shipped'",
                "dosya.rows[0].status == 'CustomsClearance'",
                "dosya.rows[0].status == 'Arrived'",
                "dosya.rows[0].status == 'Closed'"
              ],
              "visibleWhen": "dosya.rows[0].status != 'Cancelled'"
            }
          },
          {
            "id": "iptalNotu",
            "type": "alert",
            "name": "iptalNotu",
            "props": {
              "title": "İptal edildi",
              "variant": "info",
              "width": 12,
              "text": "İptal edildi · sevk başlamadan kapatıldı",
              "visibleWhen": "dosya.rows[0].status == 'Cancelled'"
            }
          },
          {
            "id": "durumTaslak",
            "type": "badge",
            "name": "durumTaslak",
            "props": {
              "text": "Taslak · sıradaki: Planlandı",
              "variant": "info",
              "visibleWhen": "dosya.rows[0].status == 'Draft'"
            }
          },
          {
            "id": "durumPlanlandi",
            "type": "badge",
            "name": "durumPlanlandi",
            "props": {
              "text": "Planlandı · sıradaki: Sevkte",
              "variant": "warning",
              "visibleWhen": "dosya.rows[0].status == 'Booked'"
            }
          },
          {
            "id": "durumSevkte",
            "type": "badge",
            "name": "durumSevkte",
            "props": {
              "text": "Sevkte · sıradaki: Gümrükte",
              "variant": "warning",
              "visibleWhen": "dosya.rows[0].status == 'Shipped'"
            }
          },
          {
            "id": "durumGumrukte",
            "type": "badge",
            "name": "durumGumrukte",
            "props": {
              "text": "Gümrükte · sıradaki: Ulaştı",
              "variant": "warning",
              "visibleWhen": "dosya.rows[0].status == 'CustomsClearance'"
            }
          },
          {
            "id": "durumUlasti",
            "type": "badge",
            "name": "durumUlasti",
            "props": {
              "text": "Ulaştı · sıradaki: Kapandı",
              "variant": "warning",
              "visibleWhen": "dosya.rows[0].status == 'Arrived'"
            }
          },
          {
            "id": "durumKapandi",
            "type": "badge",
            "name": "durumKapandi",
            "props": {
              "text": "Kapandı",
              "variant": "success",
              "visibleWhen": "dosya.rows[0].status == 'Closed'"
            }
          },
          {
            "id": "durumIptal",
            "type": "badge",
            "name": "durumIptal",
            "props": {
              "text": "İptal",
              "variant": "info",
