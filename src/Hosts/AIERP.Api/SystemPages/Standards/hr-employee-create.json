{
  "screenKey": "hr-employee-create", "title": "Personel kartı", "description": "Personel kaydı oluşturma ve düzenleme: kimlik, görev ve çalışma bilgileri. Kişisel veri alanı yoktur.", "module": "İnsan Kaynakları", "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["query:kart", "query:olustur", "query:guncelle", "component:ozet"]},
    "component:yeniBaslik": {"since": 1, "label": "Başlık (yeni personel)", "requires": ["query:kart"]},
    "component:kartBasligi": {"since": 1, "label": "Başlık (kayıtlı personel)", "requires": ["query:kart"]},
    "component:durumAktif": {"since": 1, "label": "Durum etiketi: Aktif", "requires": ["query:kart"]},
    "component:durumAyrildi": {"since": 1, "label": "Durum etiketi: Ayrıldı", "requires": ["query:kart"]},
    "component:zorunluNotu": {"since": 1, "label": "Zorunlu alanlar notu"},
    "component:kimlikKarti": {"since": 1, "label": "Kart bölümü: Kimlik", "requires": ["component:kod", "component:ad", "query:kart"]},
    "component:kod": {"since": 1, "label": "Alan: Personel kodu", "requires": ["query:kart"]},
    "component:ad": {"since": 1, "label": "Alan: Ad soyad", "requires": ["query:kart"]},
    "component:gorevKarti": {"since": 1, "label": "Kart bölümü: Görev", "requires": ["component:departman", "component:gorev", "component:kategori", "query:kart"]},
    "component:departman": {"since": 1, "label": "Alan: Departman", "requires": ["query:kart"]},
    "component:gorev": {"since": 1, "label": "Alan: Görev", "requires": ["query:kart"]},
    "component:kategori": {"since": 1, "label": "Alan: Çalışan kategorisi", "requires": ["query:kart"]},
    "component:calismaKarti": {"since": 1, "label": "Kart bölümü: Çalışma", "requires": ["component:iseGiris", "component:istenCikis", "component:isEpostasi", "component:bagliKullanici", "query:kart"]},
    "component:iseGiris": {"since": 1, "label": "Alan: İşe giriş", "requires": ["query:kart"]},
    "component:istenCikis": {"since": 1, "label": "Alan: İşten çıkış (kayıtlı personel)", "requires": ["query:kart"]},
    "component:isEpostasi": {"since": 1, "label": "Alan: İş e-postası", "requires": ["query:kart"]},
    "component:bagliKullanici": {"since": 1, "label": "Alan: Bağlı kullanıcı (yeni personel)", "requires": ["query:kart"]},
    "component:bagliKullaniciBilgisi": {"since": 1, "label": "Bağlı kullanıcı (kayıtlı personel, salt okunur)", "requires": ["query:kart"]},
    "component:kvkkNotu": {"since": 1, "label": "Kişisel veri notu"},
    "query:kart": {"since": 1, "label": "Açılan personel kaydı"},
    "query:olustur": {"since": 1, "label": "Personel kaydı oluştur", "requires": ["component:kod", "component:ad", "component:departman", "component:gorev", "component:kategori", "component:isEpostasi", "component:bagliKullanici"]},
    "query:guncelle": {"since": 1, "label": "Personel kaydı güncelle", "requires": ["component:kod", "component:ad", "component:departman", "component:gorev", "component:kategori", "component:iseGiris", "component:istenCikis", "component:isEpostasi", "query:kart"]},
    "component:ozet": {"since": 1, "label": "Kayıt özeti (ad, kod, departman, görev, işe giriş)", "requires": ["query:kart"]},
    "component:sekmeler": {"since": 1, "label": "Sekmeler: Kimlik ve görev, Çalışma", "requires": ["component:kimlikKarti", "component:gorevKarti", "component:calismaKarti", "component:zorunluNotu", "component:bagliKullaniciBilgisi", "component:kvkkNotu"]}
  },
  "definition": {
    "schemaVersion": 2, "template": {"name": "record"},
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"saveSequence": ["olustur", "guncelle"], "stopOnError": true, "sequenceWhen": ["olustur=kart.rows[0].id == null && olustur.sonuc.id == null", "guncelle=kart.rows[0].id != null"], "newAction": "page", "newPageCode": "@hr-employee-create", "newTarget": "sameTab", "saveAndNew": true, "commandWhen": ["saveNew=kart.rows[0].id == null"], "afterSaveAction": "page", "afterSavePageCode": "@hr-employees", "afterSaveTarget": "sameTab", "afterSaveRefresh": true, "hiddenCommands": ["open", "delete", "filter", "print", "export"], "slot": "commands"}},
      {"id": "ozet", "type": "recordHeader", "name": "ozet", "props": {"icon": "users", "title": "{{kart.rows[0].fullName}}", "subtitle": "{{kart.rows[0].personnelCode}} · {{kart.rows[0].department}}", "fields": ["Görev={{kart.rows[0].jobTitle}}", "İşe giriş={{kart.rows[0].hireDate}}"], "fieldFormats": ["İşe giriş=date"], "slot": "summary"}},
      {"id": "sekmeler", "type": "tabs", "name": "sekmeler", "props": {"tabs": ["Kimlik ve görev=kimlikKarti,gorevKarti,zorunluNotu", "Çalışma=calismaKarti,bagliKullaniciBilgisi,kvkkNotu"], "slot": "tabs"}},
      {"id": "yeniBaslik", "type": "heading", "name": "yeniBaslik", "props": {"text": "Yeni personel", "pageTitle": true, "visibleWhen": "kart.rows[0].id == null", "slot": "above"}},
      {"id": "kartBasligi", "type": "heading", "name": "kartBasligi", "props": {"text": "{{kart.rows[0].fullName}}", "pageTitle": true, "visibleWhen": "kart.rows[0].id != null", "slot": "above"}},
      {"id": "durumAktif", "type": "badge", "name": "durumAktif", "props": {"text": "Aktif", "variant": "success", "visibleWhen": "kart.rows[0].status == 'Active'", "slot": "above"}},
      {"id": "durumAyrildi", "type": "badge", "name": "durumAyrildi", "props": {"text": "Ayrıldı", "variant": "info", "visibleWhen": "kart.rows[0].status == 'Terminated'", "slot": "above"}},
      {"id": "zorunluNotu", "type": "text", "name": "zorunluNotu", "props": {"text": "* işaretli alanlar zorunludur: personel kodu, ad soyad ve işe giriş tarihi.", "slot": "note"}},
      {"id": "kimlikKarti", "type": "formCard", "name": "kimlikKarti", "props": {"title": "Kimlik", "columns": 2, "inputs": ["kod", "ad"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "kod", "type": "input", "name": "kod", "props": {"inputType": "text", "label": "Personel kodu", "required": true, "maxLength": 40, "upperCase": true, "placeholder": "P-0001", "pattern": "^[A-Za-z0-9._-]+$", "patternMessage": "Kod harf, rakam, nokta, tire veya alt çizgi içermelidir.", "defaultValue": "{{kart.rows[0].personnelCode}}", "slot": "field"}},
      {"id": "ad", "type": "input", "name": "ad", "props": {"inputType": "text", "label": "Ad soyad", "required": true, "maxLength": 160, "defaultValue": "{{kart.rows[0].fullName}}", "slot": "field"}},
      {"id": "gorevKarti", "type": "formCard", "name": "gorevKarti", "props": {"title": "Görev", "columns": 3, "inputs": ["departman", "gorev", "kategori"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "departman", "type": "input", "name": "departman", "props": {"inputType": "text", "label": "Departman", "maxLength": 120, "defaultValue": "{{kart.rows[0].department}}", "slot": "field"}},
      {"id": "gorev", "type": "input", "name": "gorev", "props": {"inputType": "text", "label": "Görev", "maxLength": 120, "defaultValue": "{{kart.rows[0].jobTitle}}", "slot": "field"}},
      {"id": "kategori", "type": "input", "name": "kategori", "props": {"inputType": "text", "label": "Çalışan kategorisi", "maxLength": 80, "placeholder": "Beyaz yaka, mavi yaka…", "defaultValue": "{{kart.rows[0].employmentCategory}}", "slot": "field"}},
      {"id": "calismaKarti", "type": "formCard", "name": "calismaKarti", "props": {"title": "Çalışma", "columns": 3, "inputs": ["iseGiris", "istenCikis", "isEpostasi", "bagliKullanici"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "iseGiris", "type": "input", "name": "iseGiris", "props": {"inputType": "date", "label": "İşe giriş", "defaultValue": "{{kart.rows[0].hireDate}}", "slot": "field", "required": true, "emptyDefault": "{{bugun}}"}},
      {"id": "istenCikis", "type": "input", "name": "istenCikis", "props": {"inputType": "date", "label": "İşten çıkış", "placeholder": "Doluysa kayıt 'Ayrıldı' olur", "defaultValue": "{{kart.rows[0].terminationDate}}", "visibleWhen": "kart.rows[0].id != null", "slot": "field"}},
      {"id": "isEpostasi", "type": "input", "name": "isEpostasi", "props": {"inputType": "text", "label": "İş e-postası", "maxLength": 254, "placeholder": "ad.soyad@firma.com.tr", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", "patternMessage": "Geçerli bir e-posta adresi girin.", "defaultValue": "{{kart.rows[0].workEmail}}", "slot": "field"}},
      {"id": "bagliKullanici", "type": "input", "name": "bagliKullanici", "props": {"inputType": "text", "label": "Bağlı kullanıcı kimliği", "maxLength": 36, "placeholder": "Kullanıcı kimliği (GUID), isteğe bağlı", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", "patternMessage": "Kullanıcı kimliği GUID biçiminde olmalıdır.", "visibleWhen": "kart.rows[0].id == null", "slot": "field"}},
      {"id": "bagliKullaniciBilgisi", "type": "text", "name": "bagliKullaniciBilgisi", "props": {"text": "Bağlı kullanıcı: {{kart.rows[0].userId}} · yalnız yeni kayıtta girilir", "visibleWhen": "kart.rows[0].id != null && kart.rows[0].userId != null", "slot": "note"}},
      {"id": "kvkkNotu", "type": "text", "name": "kvkkNotu", "props": {"text": "Personel kaydı yalnız iş bilgisi tutar; T.C. kimlik no, IBAN, adres, telefon ve sağlık bilgisi girilmez.", "slot": "note"}}
    ],
    "queries": [
      {"id": "kart", "name": "kart", "kind": "read", "operation": "ik.personel.getir", "runOn": "load", "parameters": [{"name": "id", "binding": "{{sayfa.parametre.employeeId}}", "type": "guid"}]},
      {"id": "olustur", "name": "olustur", "kind": "insert", "operation": "ik.personel.olustur", "runOn": "manual", "parameters": [{"name": "personnelCode", "binding": "{{kod.value}}", "type": "text"}, {"name": "fullName", "binding": "{{ad.value}}", "type": "text"}, {"name": "department", "binding": "{{departman.value}}", "type": "text"}, {"name": "jobTitle", "binding": "{{gorev.value}}", "type": "text"}, {"name": "employmentCategory", "binding": "{{kategori.value}}", "type": "text"}, {"name": "workEmail", "binding": "{{isEpostasi.value}}", "type": "text"}, {"name": "hireDate", "binding": "{{iseGiris.value}}", "type": "date"}, {"name": "userId", "binding": "{{bagliKullanici.value}}", "type": "guid"}]},
      {"id": "guncelle", "name": "guncelle", "kind": "update", "operation": "ik.personel.guncelle", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid"}, {"name": "personnelCode", "binding": "{{kod.value}}", "type": "text"}, {"name": "fullName", "binding": "{{ad.value}}", "type": "text"}, {"name": "department", "binding": "{{departman.value}}", "type": "text"}, {"name": "jobTitle", "binding": "{{gorev.value}}", "type": "text"}, {"name": "employmentCategory", "binding": "{{kategori.value}}", "type": "text"}, {"name": "workEmail", "binding": "{{isEpostasi.value}}", "type": "text"}, {"name": "hireDate", "binding": "{{iseGiris.value}}", "type": "date"}, {"name": "terminationDate", "binding": "{{istenCikis.value}}", "type": "date"}]}
    ]
  }
}
