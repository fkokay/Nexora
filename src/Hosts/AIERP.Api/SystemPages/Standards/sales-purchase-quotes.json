{
  "screenKey": "sales-purchase-quotes", "title": "Satınalma teklifleri",
  "description": "Taleplere gelen tedarikçi tekliflerini, geçerlilik tarihlerini ve seçilen teklifleri izleyin.", "module": "Satın Alma",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:acDugmesi", "component:liste", "component:siparisiAcDugmesi", "component:suzgec", "query:teklifler"]},
    "component:acDugmesi": {"since": 1, "label": "Teklifi aç komutu (pencere)", "requires": ["component:liste", "component:teklifPenceresi"]},
    "component:talebiAcDugmesi": {"since": 1, "label": "Teklifin talebini aç (eski ekran)", "requires": ["component:liste"]},
    "component:siparisiAcDugmesi": {"since": 1, "label": "Siparişi aç komutu", "requires": ["query:teklif"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama, durum)", "requires": ["component:liste"]},
    "component:liste": {"since": 1, "label": "Teklif listesi", "requires": ["component:acDugmesi", "query:teklifler"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:liste", "query:teklif"]},
    "component:teklifPenceresi": {"since": 1, "label": "Teklif penceresi", "requires": ["component:teklifBasligi", "component:teklifDurumu", "component:teklifSekmeleri", "query:teklif"]},
    "component:teklifBasligi": {"since": 1, "label": "Pencere: Teklif başlığı ve tutarlar", "requires": ["query:teklif"]},
    "component:teklifDurumu": {"since": 1, "label": "Pencere: Durum ve not", "requires": ["query:teklif"]},
    "component:teklifSekmeleri": {"since": 1, "label": "Pencere: Sekmeler", "requires": ["component:kalemTablosu", "query:kalemler"]},
    "component:kalemTablosu": {"since": 1, "label": "Pencere: Satırlar", "requires": ["query:kalemler"]},
    "query:teklifler": {"since": 1, "label": "Tedarikçi tekliflerini listele", "requires": ["component:liste", "component:suzgec", "query:teklif"]},
    "query:teklif": {"since": 1, "label": "Seçili teklif", "requires": ["component:liste"]},
    "query:kalemler": {"since": 1, "label": "Seçili teklifin satırları", "requires": ["component:liste", "query:teklif"]}
  },
  "screenViews": [
    {"key": "purchase-supplier-quotes", "component": "liste", "fields": {"code": "code", "requestCode": "requestCode", "supplierName": "supplierName", "quoteDate": "quoteDate", "validUntil": "validUntil", "status": "status", "grandTotal": "grandTotal", "lineCount": "lineCount", "createdAt": "createdAt"}}
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"openButton": "acDugmesi", "focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{teklifler.meta.totalCount}}", "moreButtons": ["siparisiAcDugmesi"], "hiddenCommands": ["new", "save", "delete", "print"], "slot": "commands"}},
      {"id": "acDugmesi", "type": "button", "name": "acDugmesi", "props": {"text": "Aç", "icon": "open", "actionType": "openDialog", "dialogId": "teklifPenceresi", "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin", "slot": "rowActions"}},
      {"id": "talebiAcDugmesi", "type": "button", "name": "talebiAcDugmesi", "props": {"text": "Talebi aç", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true, "params": ["requestId={{liste.seciliSatir.purchaseRequestId}}"], "visibleWhen": "liste.seciliSatir.purchaseRequestId != null", "slot": "rowActions"}},
      {"id": "siparisiAcDugmesi", "type": "button", "name": "siparisiAcDugmesi", "props": {"text": "Siparişi aç", "actionType": "erpPage", "pageKey": "sales-purchasing", "params": ["purchaseOrderId={{teklif.rows[0].purchaseOrderId}}"], "disabledWhen": "teklif.rows[0].purchaseOrderId == null", "disabledReason": "Bu tekliften oluşmuş sipariş yok.", "slot": "rowActions"}},
      {"id": "suzgec", "type": "filterBar", "name": "suzgec", "props": {"table": "liste", "search": true, "searchPlaceholder": "Teklif no, talep veya tedarikçi ile ara", "searchParam": "search", "filters": ["status|select|row|status|Durum"], "slot": "filters"}},
      {"id": "liste", "type": "dataTable", "name": "liste", "props": {"title": "Tedarikçi teklifleri", "query": "teklifler", "paging": "server", "pageSize": 50, "columns": ["code", "requestCode", "supplierName", "quoteDate", "validUntil", "status", "grandTotal"], "columnLabels": ["code=Teklif no", "requestCode=Talep", "supplierName=Tedarikçi", "quoteDate=Tarih", "validUntil=Geçerlilik", "status=Durum", "grandTotal=Toplam", "lineCount=Satır", "createdAt=Oluşturulma"], "columnUnits": ["grandTotal=currencyCode"], "columnFormats": ["code=code", "requestCode=code", "quoteDate=date", "validUntil=date", "status=status", "grandTotal=money", "lineCount=number", "createdAt=date"], "valueLabels": ["status:Submitted=Değerlendiriliyor", "status:Selected=Seçildi", "status:NotSelected=Seçilmedi"], "toneMap": ["Seçildi=success", "Değerlendiriliyor=info", "Seçilmedi=warning"], "rowOpenAction": "acDugmesi", "emptyText": "Filtrelerle eşleşen tedarikçi teklifi yok.", "slot": "list"}},
      {"id": "detayKarti", "type": "card", "name": "detayKarti", "props": {"variant": "panel", "title": "{{liste.seciliSatir.code}}", "description": "{{liste.seciliSatir.supplierName}}", "slot": "detail"}, "children": [{"id": "durumSecildiRozeti", "type": "badge", "name": "durumSecildiRozeti", "props": {"text": "Seçildi", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Selected'"}}, {"id": "durumDegerlendiriliyorRozeti", "type": "badge", "name": "durumDegerlendiriliyorRozeti", "props": {"text": "Değerlendiriliyor", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Submitted'"}}, {"id": "durumSecilmediRozeti", "type": "badge", "name": "durumSecilmediRozeti", "props": {"text": "Seçilmedi", "variant": "warning", "visibleWhen": "liste.seciliSatir.status == 'NotSelected'"}}, {"id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli", "props": {"table": "liste", "fields": ["requestCode=Talep", "supplierName=Tedarikçi", "quoteDate=Teklif tarihi", "validUntil=Geçerlilik sonu", "lineCount=Satır", "currencyCode=Döviz"]}}, {"id": "araToplamGostergesi", "type": "metric", "name": "araToplamGostergesi", "props": {"title": "Ara toplam", "value": "{{teklif.rows[0].subtotal}}", "format": "money", "icon": "calculator", "description": "{{teklif.rows[0].currencyCode}}", "visibleWhen": "teklif.rows[0].id != null"}}, {"id": "kdvGostergesi", "type": "metric", "name": "kdvGostergesi", "props": {"title": "KDV", "value": "{{teklif.rows[0].taxTotal}}", "format": "money", "icon": "landmark", "description": "{{teklif.rows[0].currencyCode}}", "visibleWhen": "teklif.rows[0].id != null"}}, {"id": "genelToplamGostergesi", "type": "metric", "name": "genelToplamGostergesi", "props": {"title": "Genel toplam", "value": "{{teklif.rows[0].grandTotal}}", "format": "money", "icon": "receipt", "description": "{{teklif.rows[0].currencyCode}}", "visibleWhen": "teklif.rows[0].id != null"}}, {"id": "teklifNotu", "type": "text", "name": "teklifNotu", "props": {"title": "Teklif notu", "text": "{{teklif.rows[0].notes}}", "visibleWhen": "teklif.rows[0].notes != null"}}, {"id": "detayAc", "type": "button", "name": "detayAc", "props": {"text": "Talebi aç ›", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true, "params": ["requestId={{liste.seciliSatir.purchaseRequestId}}"], "visibleWhen": "liste.seciliSatir.purchaseRequestId != null"}}, {"id": "detaySiparis", "type": "button", "name": "detaySiparis", "props": {"text": "Siparişi aç ›", "actionType": "erpPage", "pageKey": "sales-purchasing", "params": ["purchaseOrderId={{teklif.rows[0].purchaseOrderId}}"], "visibleWhen": "teklif.rows[0].purchaseOrderId != null"}}]},
      {"id": "teklifPenceresi", "type": "dialog", "name": "teklifPenceresi", "props": {"presentation": "dialog", "size": "xl", "title": "Teklif · {{teklif.rows[0].code}}", "contains": ["teklifBasligi", "teklifDurumu", "teklifSekmeleri"], "slot": "dialogs"}},
      {"id": "teklifBasligi", "type": "recordHeader", "name": "teklifBasligi", "props": {"icon": "receipt", "title": "{{teklif.rows[0].code}} · {{teklif.rows[0].supplierName}}", "subtitle": "{{teklif.rows[0].currencyCode}} · talep {{teklif.rows[0].requestCode}}", "fields": ["Teklif tarihi={{teklif.rows[0].quoteDate}}", "Geçerlilik sonu={{teklif.rows[0].validUntil}}", "Ara toplam={{teklif.rows[0].subtotal}}", "KDV={{teklif.rows[0].taxTotal}}", "Genel toplam={{teklif.rows[0].grandTotal}}", "Kıyas={{teklif.rows[0].comparableGrandTotal}}"], "fieldFormats": ["Teklif tarihi=date", "Geçerlilik sonu=date", "Ara toplam=money", "KDV=money", "Genel toplam=money", "Kıyas=money"], "fieldUnits": ["Ara toplam={{teklif.rows[0].currencyCode}}", "KDV={{teklif.rows[0].currencyCode}}", "Genel toplam={{teklif.rows[0].currencyCode}}", "Kıyas={{teklif.rows[0].baseCurrencyCode}}"], "slot": "dialog"}},
      {"id": "teklifDurumu", "type": "section", "name": "teklifDurumu", "props": {"slot": "dialog"}, "children": [{"id": "pencereSecildi", "type": "badge", "name": "pencereSecildi", "props": {"text": "Seçildi", "variant": "success", "visibleWhen": "teklif.rows[0].status == 'Selected'"}}, {"id": "pencereDegerlendiriliyor", "type": "badge", "name": "pencereDegerlendiriliyor", "props": {"text": "Değerlendiriliyor", "variant": "info", "visibleWhen": "teklif.rows[0].status == 'Submitted'"}}, {"id": "pencereSecilmedi", "type": "badge", "name": "pencereSecilmedi", "props": {"text": "Seçilmedi", "variant": "warning", "visibleWhen": "teklif.rows[0].status == 'NotSelected'"}}, {"id": "pencereNotu", "type": "text", "name": "pencereNotu", "props": {"text": "Not: {{teklif.rows[0].notes}}", "visibleWhen": "teklif.rows[0].notes != null"}}]},
      {"id": "teklifSekmeleri", "type": "tabs", "name": "teklifSekmeleri", "props": {"tabs": ["Satırlar {{kalemler.satirSayisi}}=kalemTablosu"], "slot": "dialog"}},
      {"id": "kalemTablosu", "type": "dataTable", "name": "kalemTablosu", "props": {"title": "Teklif satırları", "query": "kalemler", "showGridSearch": false, "showColumnFilters": false, "showColumnChooser": false, "showExport": false, "showPivot": false, "showCsv": false, "showSelectedExport": false, "columns": ["stockCode", "stockName", "quantity", "unitPrice", "discountPercent", "vatPercent", "lineTotal"], "columnLabels": ["stockCode=Stok kodu", "stockName=Stok adı", "quantity=Miktar", "unitPrice=Birim fiyat", "discountPercent=İskonto %", "vatPercent=KDV %", "lineTotal=Toplam"], "columnUnits": ["quantity=unitCode"], "columnFormats": ["stockCode=code", "quantity=number", "unitPrice=money", "discountPercent=number", "vatPercent=number", "lineTotal=money"], "totals": ["lineTotal"], "emptyText": "Teklif satırı yok.", "slot": "dialog"}}
    ],
    "queries": [
      {"id": "teklifler", "name": "teklifler", "kind": "read", "operation": "satinalma.teklif.listele", "runOn": "load", "parameters": [{"name": "search", "binding": "{{suzgec.search}}", "type": "text"}, {"name": "status", "binding": "{{suzgec.status}}", "type": "text"}, {"name": "page", "binding": "{{liste.sayfa}}", "type": "int"}, {"name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int"}]},
      {"id": "teklif", "name": "teklif", "kind": "read", "operation": "satinalma.teklif.getir", "runOn": "load", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]},
      {"id": "kalemler", "name": "kalemler", "kind": "read", "operation": "satinalma.teklif.kalemleri", "runOn": "load", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}]}
    ],
    "template": { "name": "list" }
  }
}
