{
  "screenKey": "sales-purchase-quotes", "title": "Satınalma teklifleri",
  "description": "Taleplere gelen tedarikçi tekliflerini, geçerlilik tarihlerini ve seçilen teklifleri izleyin.", "module": "Satın Alma",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:talepsizTeklifDugmesi", "component:acDugmesi", "component:siparisiAcDugmesi", "query:teklifler"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:secimCipleri": {"since": 1, "label": "Durum seçimi çipleri", "requires": ["component:durumSecimi"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeç seçimleri kartı", "requires": ["component:durumSecimi"]},
    "component:durumSecimi": {"since": 1, "label": "Durum seçimi"},
    "component:gorunumKarti": {"since": 1, "label": "Detay paneli anahtarı kartı", "requires": ["component:detayPaneli"]},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:liste": {"since": 1, "label": "Teklif listesi", "requires": ["component:detayPaneli", "component:acDugmesi", "query:teklifler"]},
    "component:acDugmesi": {"since": 1, "label": "Teklifin talebini aç (eski ekran)", "requires": ["component:liste"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:ozetPaneli", "component:tutarPaneli", "component:teklifNotu", "component:kalemTablosu", "query:teklif"]},
    "component:ozetPaneli": {"since": 1, "label": "Detay: Özet", "requires": ["component:liste"]},
    "component:tutarPaneli": {"since": 1, "label": "Detay: Tutarlar", "requires": ["query:teklif"]},
    "component:teklifNotu": {"since": 1, "label": "Detay: Teklif notu", "requires": ["query:teklif"]},
    "component:kalemTablosu": {"since": 1, "label": "Detay: Satırlar", "requires": ["query:kalemler"]},
    "component:talepsizTeklifDugmesi": {"since": 1, "label": "Talepsiz teklif komutu (eski ekran)"},
    "component:siparisiAcDugmesi": {"since": 1, "label": "Siparişi aç komutu", "requires": ["query:teklif"]},
    "query:teklifler": {"since": 1, "label": "Tedarikçi tekliflerini listele", "requires": ["component:suzgec", "component:durumSecimi", "component:liste"]},
    "query:teklif": {"since": 1, "label": "Seçili teklif", "requires": ["component:liste"]},
    "query:kalemler": {"since": 1, "label": "Seçili teklifin satırları", "requires": ["component:liste"]}
  },
  "screenViews": [ { "key": "purchase-supplier-quotes", "component": "liste",
                     "fields": { "code": "code", "requestCode": "requestCode", "supplierName": "supplierName", "quoteDate": "quoteDate",
                                 "validUntil": "validUntil", "status": "status", "grandTotal": "grandTotal", "lineCount": "lineCount",
                                 "createdAt": "createdAt" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "newButton": "talepsizTeklifDugmesi", "openButton": "acDugmesi", "focusInput": "suzgec", "exportTable": "liste",
                   "titleCount": "{{teklifler.meta.totalCount}}", "moreButtons": ["siparisiAcDugmesi"],
                   "hiddenCommands": ["save", "delete", "print"] } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 6, "search": true, "searchPlaceholder": "Teklif no, talep veya tedarikçi ile ara", "searchParam": "search" } },
      { "id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri",
        "props": { "title": "Süzgeçler", "layout": "inline", "width": 4, "inputs": ["durumSecimi"] } },
      { "id": "durumSecimi", "type": "input", "name": "durumSecimi",
        "props": { "inputType": "select", "label": "Durum",
                   "staticOptions": ["=Tümü", "Submitted=Değerlendiriliyor", "Selected=Seçildi", "NotSelected=Seçilmedi"] } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": { "title": "Görünüm", "layout": "inline", "width": 2, "inputs": ["detayPaneli"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": { "width": 12, "inputs": ["durumSecimi"] } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Tedarikçi teklifleri", "query": "teklifler", "paging": "server", "pageSize": 50, "width": 12,
                   "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.id != null",
                   "columns": ["code", "requestCode", "supplierName", "quoteDate", "validUntil", "status", "grandTotal"],
                   "columnLabels": ["code=Teklif no", "requestCode=Talep", "supplierName=Tedarikçi", "quoteDate=Tarih", "validUntil=Geçerlilik",
                                    "status=Durum", "grandTotal=Toplam", "lineCount=Satır", "createdAt=Oluşturulma"],
                   "columnUnits": ["grandTotal=currencyCode"],
                   "columnFormats": ["code=code", "requestCode=code", "quoteDate=date", "validUntil=date", "status=status", "grandTotal=money",
                                     "lineCount=number", "createdAt=date"],
                   "valueLabels": ["status:Submitted=Değerlendiriliyor", "status:Selected=Seçildi", "status:NotSelected=Seçilmedi"],
                   "toneMap": ["Seçildi=success", "Değerlendiriliyor=info", "Seçilmedi=warning"],
                   "rowOpenAction": "acDugmesi",
                   "emptyText": "Filtrelerle eşleşen tedarikçi teklifi yok." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true,
                   "params": ["requestId={{liste.seciliSatir.purchaseRequestId}}"],
                   "disabledWhen": "liste.seciliSatir.purchaseRequestId == null", "disabledReason": "Önce talebe bağlı bir teklif seçin" } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.code}}", "description": "{{liste.seciliSatir.supplierName}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Talebi aç ›", "actionType": "erpPage", "pageKey": "sales-requests", "legacyScreen": true,
                       "params": ["requestId={{liste.seciliSatir.purchaseRequestId}}"],
                       "visibleWhen": "liste.seciliSatir.purchaseRequestId != null" } },
          { "id": "durumSecildiRozeti", "type": "badge", "name": "durumSecildiRozeti",
            "props": { "text": "Seçildi", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Selected'" } },
          { "id": "durumDegerlendiriliyorRozeti", "type": "badge", "name": "durumDegerlendiriliyorRozeti",
            "props": { "text": "Değerlendiriliyor", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Submitted'" } },
          { "id": "durumSecilmediRozeti", "type": "badge", "name": "durumSecilmediRozeti",
            "props": { "text": "Seçilmedi", "variant": "warning", "visibleWhen": "liste.seciliSatir.status == 'NotSelected'" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetPaneli,tutarPaneli,teklifNotu", "Satırlar {{kalemler.satirSayisi}}=kalemTablosu"] } },
          { "id": "detaySiparis", "type": "button", "name": "detaySiparis",
            "props": { "text": "Siparişi aç ›", "actionType": "erpPage", "pageKey": "sales-purchasing",
                       "params": ["purchaseOrderId={{teklif.rows[0].purchaseOrderId}}"],
                       "visibleWhen": "teklif.rows[0].purchaseOrderId != null" } }
        ] },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["requestCode=Talep", "supplierName=Tedarikçi", "quoteDate=Teklif tarihi", "validUntil=Geçerlilik sonu",
                              "lineCount=Satır", "currencyCode=Döviz"] } },
      { "id": "tutarPaneli", "type": "recordHeader", "name": "tutarPaneli",
        "props": { "title": "Tutarlar", "subtitle": "{{teklif.rows[0].currencyCode}} · talep {{teklif.rows[0].requestStatus}}",
                   "fields": ["Ara toplam={{teklif.rows[0].subtotal}}", "İskonto={{teklif.rows[0].discountTotal}}", "KDV={{teklif.rows[0].taxTotal}}",
                              "Genel toplam={{teklif.rows[0].grandTotal}}", "Kıyas={{teklif.rows[0].comparableGrandTotal}}",
                              "Kur tarihi={{teklif.rows[0].appliedRateDate}}"],
                   "fieldFormats": ["Ara toplam=money", "İskonto=money", "KDV=money", "Genel toplam=money", "Kıyas=money", "Kur tarihi=date"],
                   "fieldUnits": ["Ara toplam={{teklif.rows[0].currencyCode}}", "İskonto={{teklif.rows[0].currencyCode}}",
                                  "KDV={{teklif.rows[0].currencyCode}}", "Genel toplam={{teklif.rows[0].currencyCode}}",
                                  "Kıyas={{teklif.rows[0].baseCurrencyCode}}"] } },
      { "id": "teklifNotu", "type": "text", "name": "teklifNotu",
        "props": { "title": "Teklif notu", "text": "{{teklif.rows[0].notes}}", "visibleWhen": "teklif.rows[0].notes != null" } },
      { "id": "kalemTablosu", "type": "dataTable", "name": "kalemTablosu",
        "props": { "title": "Teklif satırları", "query": "kalemler", "width": 12, "variant": "list",
                   "columns": ["stockCode", "stockName", "quantity", "unitPrice", "discountPercent", "vatPercent", "lineTotal"],
                   "columnLabels": ["stockCode=Stok kodu", "stockName=Stok adı", "quantity=Miktar", "unitPrice=Birim fiyat",
                                    "discountPercent=İskonto %", "vatPercent=KDV %", "lineTotal=Toplam"],
                   "columnUnits": ["quantity=unitCode"],
                   "columnFormats": ["stockCode=code", "quantity=number", "unitPrice=money", "discountPercent=number", "vatPercent=number",
                                     "lineTotal=money"],
                   "totals": ["lineTotal"],
                   "emptyText": "Teklif satırı yok." } },

      { "id": "talepsizTeklifDugmesi", "type": "button", "name": "talepsizTeklifDugmesi",
        "props": { "text": "Talepsiz teklif", "actionType": "erpPage", "pageKey": "sales-purchase-quotes", "legacyScreen": true } },
      { "id": "siparisiAcDugmesi", "type": "button", "name": "siparisiAcDugmesi",
        "props": { "text": "Siparişi aç", "actionType": "erpPage", "pageKey": "sales-purchasing",
                   "params": ["purchaseOrderId={{teklif.rows[0].purchaseOrderId}}"],
                   "disabledWhen": "teklif.rows[0].purchaseOrderId == null", "disabledReason": "Bu tekliften oluşmuş sipariş yok." } }
    ],
    "queries": [
      { "id": "teklifler", "name": "teklifler", "kind": "read", "operation": "satinalma.teklif.listele", "runOn": "load",
        "parameters": [
          { "name": "search", "binding": "{{suzgec.search}}", "type": "text" },
          { "name": "status", "binding": "{{durumSecimi.value}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "teklif", "name": "teklif", "kind": "read", "operation": "satinalma.teklif.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "kalemler", "name": "kalemler", "kind": "read", "operation": "satinalma.teklif.kalemleri", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid" } ] }
    ]
  }
}
