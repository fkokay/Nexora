  "updates": [
    {
      "id": "belge",
      "label": "Yeni ve Aç komutları satınalma siparişi Belge sayfasına gider",
      "below": 4,
      "set": [
        {"component": "komutlar", "prop": "hiddenCommands", "from": [["open", "save", "delete", "print"]]},
        {"component": "komutlar", "prop": "newAction", "from": [null]},
        {"component": "komutlar", "prop": "newButton", "from": ["yeniSiparisDugmesi"]},
        {"component": "komutlar", "prop": "newPageCode", "from": [null]},
        {"component": "komutlar", "prop": "newTarget", "from": [null]},
        {"component": "komutlar", "prop": "openAction", "from": [null]},
        {"component": "komutlar", "prop": "openPageCode", "from": [null]},
        {"component": "komutlar", "prop": "openParams", "from": [null]},
        {"component": "komutlar", "prop": "openTable", "from": [null]},
        {"component": "komutlar", "prop": "openTarget", "from": [null]}
      ]
    },
    {
      "id": "izleme",
      "label": "Mal kabul penceresinde lot/seri dağılımı penceresi",
      "below": 5,
      "add": ["component:kabulIzlemeDugmesi", "component:kabulIzlemePenceresi", "component:kabulIzlemeIzgarasi"],
      "append": [{"component": "malKabulPenceresi", "prop": "contains", "values": ["kabulIzlemeDugmesi"]}],
      "set": [
        {"component": "kabulNotu", "prop": "text", "from": ["Satırlar siparişin kalan miktarı ve fiyatıyla gelir. Kabul edilmeyecek satırın miktarını 0 yapın ya da satırı silin; miktarı 0 olan satır gönderilmez. Fiyat sipariş satırının temel biriminde girilir; bedelsiz satırda fiyat, iskonto ve KDV girilmez. Lot/seri izlemeli stok bu pencereden kabul edilemez (sunucu reddeder): o satırları 0 yapıp eski ekranda kabul edin."]}
      ]
    }
  ]
