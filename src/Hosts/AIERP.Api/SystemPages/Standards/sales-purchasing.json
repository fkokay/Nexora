      ]
    }
  },
  "screenViews": [
    {
      "key": "purchase-orders",
      "component": "liste",
      "fields": {
        "code": "code",
        "supplierName": "supplierName",
        "orderDate": "orderDate",
        "expectedReceiptDate": "expectedReceiptDate",
        "lineCount": "lineCount",
        "grandTotal": "grandTotal",
        "currencyCode": "currencyCode",
        "status": "status"
      }
    }
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "newAction": "page",
          "newPageCode": "@purchase-order-document",
          "newTarget": "newTab",
          "openAction": "page",
          "openPageCode": "@purchase-order-document",
          "openTarget": "newTab",
          "openTable": "liste",
          "openParams": [
            "id={{liste.seciliSatir.id}}"
          ],
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{siparisler.meta.totalCount}}",
          "hiddenCommands": [
            "save",
            "delete",
            "print"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "acikGostergesi",
        "type": "metric",
        "name": "acikGostergesi",
        "props": {
          "title": "Açık",
          "value": "{{sayAcik.meta.totalCount}}",
          "format": "number",
          "icon": "inbox",
          "description": "mal bekliyor · tıkla: süz",
          "filterInput": "durumSecimi",
          "filterValue": "Open",
          "slot": "indicators"
        }
      },
      {
        "id": "kismenGostergesi",
        "type": "metric",
        "name": "kismenGostergesi",
        "props": {
          "title": "Kısmen alındı",
          "value": "{{sayKismen.meta.totalCount}}",
          "format": "number",
          "icon": "hourglass",
          "variant": "warning",
          "description": "mal bekliyor · tıkla: süz",
          "filterInput": "durumSecimi",
          "filterValue": "PartiallyReceived",
          "slot": "indicators"
        }
      },
      {
        "id": "gecikmisGostergesi",
        "type": "metric",
        "name": "gecikmisGostergesi",
        "props": {
          "title": "Gecikmiş",
          "value": "{{sayGecikmis.meta.totalCount}}",
          "format": "number",
          "icon": "alert",
          "variant": "danger",
          "description": "beklenen teslim geçti · tıkla: süz",
          "filterInput": "gecikmisSecimi",
          "filterValue": "true",
          "slot": "indicators"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "search": true,
          "searchPlaceholder": "Sipariş no veya tedarikçi ile ara",
          "searchParam": "q",
          "slot": "filters"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Satınalma siparişleri",
          "query": "siparisler",
          "paging": "server",
          "pageSize": 25,
          "columns": [
            "code",
            "supplierName",
            "orderDate",
            "expectedReceiptDate",
            "lineCount",
            "receivedPercent",
            "grandTotal",
            "status",
            "delayDays"
          ],
          "columnLabels": [
            "code=Sipariş no",
            "supplierName=Tedarikçi",
            "orderDate=Sipariş tarihi",
            "expectedReceiptDate=Beklenen teslim",
            "lineCount=Satır",
            "receivedPercent=Teslim alınan %",
            "grandTotal=Genel toplam",
            "currencyCode=Döviz",
            "status=Durum",
            "delayDays=Gecikme (gün)",
            "receivedQuantity=Alınan miktar",
            "orderedQuantity=Sipariş miktarı"
          ],
          "columnUnits": [
            "grandTotal=currencyCode"
          ],
          "columnFormats": [
            "code=code",
            "orderDate=date",
            "expectedReceiptDate=date",
            "lineCount=number",
            "receivedPercent=number",
            "grandTotal=money",
            "status=status",
            "delayDays=number",
            "receivedQuantity=number",
            "orderedQuantity=number"
          ],
          "valueLabels": [
            "status:PendingApproval=Onay bekliyor",
            "status:Open=Açık",
            "status:PartiallyReceived=Kısmen alındı",
            "status:Received=Tam alındı",
            "status:Cancelled=İptal",
            "status:Rejected=Reddedildi"
          ],
          "toneMap": [
            "Onay bekliyor=warning",
            "Açık=info",
            "Kısmen alındı=warning",
            "Tam alındı=success",
            "Reddedildi=danger"
          ],
          "rowOpenAction": "acDugmesi",
          "emptyText": "Filtrelerle eşleşen satın alma siparişi yok.",
          "slot": "list",
          "rowActions": [
            "acDugmesi",
            "malKabulDugmesi"
          ]
        }
      },
      {
        "id": "acDugmesi",
        "type": "button",
        "name": "acDugmesi",
        "props": {
          "text": "Aç",
          "icon": "open",
          "actionType": "openDialog",
          "disabledWhen": "liste.seciliSatir.id == null",
          "disabledReason": "Önce bir kayıt seçin",
          "slot": "rowActions",
          "dialogId": "siparisDetayPenceresi"
        }
      },
      {
        "id": "malKabulDugmesi",
        "type": "button",
        "name": "malKabulDugmesi",
        "props": {
          "text": "Mal kabul oluştur ›",
          "actionType": "openDialog",
          "disabledWhen": "liste.seciliSatir.status != 'Open' && liste.seciliSatir.status != 'PartiallyReceived'",
          "disabledReason": "Mal kabul yalnız açık ya da kısmen alınmış siparişe yapılır.",
          "slot": "rowActions",
          "dialogId": "malKabulPenceresi"
        }
      },
      {
        "id": "detayKarti",
        "type": "card",
        "name": "detayKarti",
        "props": {
          "variant": "panel",
          "title": "{{liste.seciliSatir.code}}",
          "description": "{{liste.seciliSatir.supplierName}}",
          "slot": "detail"
        },
        "children": [
          {
            "id": "ozetPaneli",
            "type": "contextPanel",
            "name": "ozetPaneli",
            "props": {
              "table": "liste",
              "fields": [
                "orderDate=Sipariş tarihi",
                "expectedReceiptDate=Beklenen teslim",
                "delayDays=Gecikme (gün)",
                "lineCount=Satır",
                "orderedQuantity=Sipariş miktarı",
                "receivedQuantity=Alınan miktar",
                "currencyCode=Döviz"
              ]
            }
          }
        ]
      },
      {
        "id": "izlemeliKabulDugmesi",
        "type": "button",
        "name": "izlemeliKabulDugmesi",
        "props": {
          "text": "Lot/seri izlemeli kabul (eski ekran)",
          "actionType": "erpPage",
          "pageKey": "sales-purchasing",
          "legacyScreen": true,
          "params": [
            "purchaseOrderId={{liste.seciliSatir.id}}"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "malKabulPenceresi",
        "type": "dialog",
        "name": "malKabulPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Mal kabul · {{siparis.rows[0].code}} · {{siparis.rows[0].supplierName}}",
          "contains": [
            "kabulKalemleri",
            "izlemeliKabulDugmesi",
            "kabulBilgileri",
            "kabulIstekKimligi",
            "kabulNotu",
            "kabulDurumu",
            "kabulIzlemeDugmesi"
          ],
          "saveQuery": "malKabulOlustur",
          "saveLabel": "Mal kabulü kaydet",
          "closeOnSave": true,
          "resetOnOpen": true,
          "refreshQueries": [
            "siparis",
            "satirlar",
            "malKabuller",
            "kabulKaynak",
            "siparisler",
            "sayAcik",
            "sayKismen",
            "sayGecikmis"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "kabulBilgileri",
        "type": "formCard",
        "name": "kabulBilgileri",
        "props": {
          "title": "Mal kabul bilgileri",
          "columns": 2,
          "inputs": [
            "kabulDepo",
            "kabulTarihi"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "kabulIstekKimligi",
        "type": "input",
        "name": "kabulIstekKimligi",
        "props": {
          "inputType": "text",
          "label": "Tekrar deneme kimliği",
          "hidden": true,
          "autoId": true,
          "slot": "dialog"
        }
      },
      {
        "id": "kabulNotu",
        "type": "text",
        "name": "kabulNotu",
        "props": {
          "text": "Satırlar siparişin kalan miktarı ve fiyatıyla gelir. Kabul edilmeyecek satırın miktarını 0 yapın ya da satırı silin; miktarı 0 olan satır gönderilmez. Fiyat sipariş satırının temel biriminde girilir; bedelsiz satırda fiyat, iskonto ve KDV girilmez. Lot/seri izlemeli kalemlerde kabul miktarını karşılayacak dağılımları ayrı pencereden girin.",
          "slot": "dialog"
        }
      },
      {
        "id": "kabulKalemleri",
        "type": "editableGrid",
        "name": "kabulKalemleri",
        "props": {
          "gridMode": "list",
          "title": "Kabul satırları",
          "addLabel": "Satır ekle",
          "maxRows": 200,
          "minRows": 1,
          "gridColumns": [
            "orderLineNumber|#|number|readOnly",
            "stockCode|Stok kodu|text|readOnly",
            "stockName|Stok adı|text|readOnly",
            "quantity|Kabul miktarı|number|required,min:0",
            "remainingQuantity|Kalan|number|readOnly",
            "unitCode|Birim|text|readOnly",
            "storageLocationId|Konum|lookup:kabulKonumlari:id:code:name",
            "trackingMode|İzleme|text|readOnly"
          ],
          "columnOptionsWhen": [
            "storageLocationId=satir.isActive == true"
          ],
          "fillQuery": "kabulKaynak",
          "fillColumns": {
            "quantity": "remainingQuantity"
          },
          "skipWhenZero": "quantity",
          "slot": "dialog"
        }
      },
      {
        "id": "kabulDurumu",
        "type": "text",
        "name": "kabulDurumu",
        "props": {
          "text": "Gönderilecek satır: {{kabulKalemleri.satirSayisi}} · Fazla teslim, birim ve izleme türü sunucuda denetlenir.",
          "slot": "dialog"
        }
      },
      {
        "id": "siparisDetayPenceresi",
        "type": "dialog",
        "name": "siparisDetayPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Sipariş · {{siparis.rows[0].code}}",
          "contains": [
            "siparisDetaySekmeleri",
            "faturalaDugmesi",
            "kabulAcDugmesi",
            "siparisDetayBasligi"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "siparisDetayBasligi",
        "type": "recordHeader",
        "name": "siparisDetayBasligi",
        "props": {
          "icon": "shopping-cart",
          "title": "{{siparis.rows[0].code}}",
          "subtitle": "{{siparis.rows[0].supplierName}}",
          "fields": [
            "Sipariş tarihi={{siparis.rows[0].orderDate}}",
            "Beklenen teslim={{siparis.rows[0].expectedReceiptDate}}",
            "Durum={{siparis.rows[0].status}}"
          ],
          "fieldFormats": [
            "Sipariş tarihi=date",
            "Beklenen teslim=date"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "siparisDetaySekmeleri",
        "type": "tabs",
        "name": "siparisDetaySekmeleri",
        "props": {
          "tabs": [
            "Satırlar=satirTablosu",
            "Mal kabuller=kabulTablosu",
            "Özel alanlar=alanTablosu"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "satirTablosu",
        "type": "dataTable",
        "name": "satirTablosu",
        "props": {
          "title": "Sipariş satırları",
          "query": "satirlar",
          "columns": [
            "orderLineNumber",
            "stockCode",
            "stockName",
            "quantity",
            "receivedQuantity",
            "remainingQuantity",
            "unitCode"
          ],
          "columnLabels": [
            "orderLineNumber=#",
            "stockCode=Stok kodu",
            "stockName=Stok",
            "quantity=Sipariş",
            "receivedQuantity=Alınan",
            "remainingQuantity=Kalan",
            "unitCode=Birim"
          ],
          "columnFormats": [
            "orderLineNumber=number",
            "quantity=number",
            "receivedQuantity=number",
            "remainingQuantity=number"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "kabulTablosu",
        "type": "dataTable",
        "name": "kabulTablosu",
        "props": {
          "title": "Mal kabuller",
          "query": "malKabuller",
          "columns": [
            "code",
            "receiptDate",
            "status",
            "invoice.code"
          ],
          "columnLabels": [
            "code=Mal kabul",
            "receiptDate=Tarih",
            "status=Durum",
            "invoice.code=Fatura"
          ],
          "columnFormats": [
            "code=code",
            "receiptDate=date"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "faturalaDugmesi",
        "type": "button",
        "name": "faturalaDugmesi",
        "props": {
          "text": "Faturala",
          "actionType": "erpPage",
          "pageKey": "purchase-invoice-document",
          "target": "newTab",
          "params": [
            "receiptId={{kabulTablosu.seciliSatir.id}}"
          ],
          "visibleWhen": "kabulTablosu.seciliSatir.status == 'Posted'",
          "slot": "dialog"
        }
      },
      {
        "id": "kabulAcDugmesi",
        "type": "button",
        "name": "kabulAcDugmesi",
        "props": {
          "text": "Mal kabulü aç",
          "actionType": "erpPage",
          "pageKey": "sales-purchase-receipts",
          "legacyScreen": true,
          "target": "newTab",
          "params": [
            "receiptId={{kabulTablosu.seciliSatir.id}}"
          ],
          "disabledWhen": "kabulTablosu.seciliSatir.id == null",
          "disabledReason": "Önce bir kayıt seçin",
          "slot": "dialog"
        }
      },
      {
        "id": "kabulTarihi",
        "type": "input",
        "name": "kabulTarihi",
        "props": {
          "inputType": "date",
          "label": "Kabul tarihi",
          "required": true,
          "defaultValue": "{{bugun}}",
          "slot": "dialog"
        }
      },
      {
        "id": "kabulDepo",
        "type": "input",
        "name": "kabulDepo",
        "props": {
          "inputType": "lookup",
          "label": "Depo",
          "required": true,
          "optionsQuery": "depolar",
          "optionValueColumn": "id",
          "optionLabelColumn": "name",
          "optionDescriptionColumn": "code",
          "minChars": 0,
          "optionsWhen": "satir.isActive == true",
          "defaultValue": "{{siparis.rows[0].targetWarehouseId}}",
          "clearsOnChange": [
            "kabulKalemleri.storageLocationId"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "durumSecimi",
        "type": "input",
        "name": "durumSecimi",
        "props": {
          "inputType": "select",
          "label": "Durum",
          "staticOptions": [
            "=Tümü",
            "PendingApproval=Onay bekliyor",
            "Open=Açık",
            "PartiallyReceived=Kısmen alındı",
            "Received=Tam alındı",
            "Cancelled=İptal",
            "Rejected=Reddedildi"
          ],
          "slot": "above"
        }
      },
      {
        "id": "gecikmisSecimi",
        "type": "input",
        "name": "gecikmisSecimi",
        "props": {
          "inputType": "checkbox",
          "label": "Gecikmiş",
          "slot": "above"
        }
      },
      {
        "id": "durumAcik",
        "type": "input",
        "name": "durumAcik",
        "props": {
          "inputType": "text",
          "label": "Sayaç durumu",
          "hidden": true,
          "defaultValue": "Open",
          "slot": "above"
        }
      },
      {
        "id": "durumKismen",
        "type": "input",
        "name": "durumKismen",
        "props": {
          "inputType": "text",
          "label": "Sayaç durumu",
          "hidden": true,
          "defaultValue": "PartiallyReceived",
          "slot": "above"
        }
      },
      {
        "id": "gecikmisSabit",
        "type": "input",
        "name": "gecikmisSabit",
        "props": {
          "inputType": "text",
          "label": "Sayaç süzgeci",
          "hidden": true,
          "defaultValue": "true",
          "slot": "above"
        }
      },
      {
        "id": "sayacSayfaBoyutu",
        "type": "input",
        "name": "sayacSayfaBoyutu",
        "props": {
          "inputType": "text",
          "label": "Sayaç sayfa boyutu",
          "hidden": true,
          "defaultValue": "1",
          "slot": "above"
        }
      },
      {
        "id": "alanTablosu",
        "type": "dataTable",
        "name": "alanTablosu",
        "props": {
          "title": "Sipariş özel alanları",
          "query": "ozelDegerler",
          "variant": "list",
          "columns": [
            "label",
            "value"
          ],
          "columnLabels": [
            "label=Alan",
            "value=Değer"
          ],
          "emptyText": "Özel alan değeri yok.",
          "slot": "dialog"
        }
      },
      {
        "id": "kabulIzlemeDugmesi",
        "type": "button",
        "name": "kabulIzlemeDugmesi",
        "props": {
          "text": "Lot/seri dağılımı",
          "actionType": "openDialog",
          "dialogId": "kabulIzlemePenceresi",
          "slot": "dialog"
        }
      },
      {
        "id": "kabulIzlemePenceresi",
        "type": "dialog",
        "name": "kabulIzlemePenceresi",
        "props": {
          "presentation": "dialog",
          "size": "lg",
          "title": "Lot/seri dağılımı",
          "contains": [
            "kabulIzlemeIzgarasi"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "kabulIzlemeIzgarasi",
        "type": "editableGrid",
        "name": "kabulIzlemeIzgarasi",
        "props": {
          "title": "Lot/seri dağılımı",
          "gridMode": "list",
          "addLabel": "Satır ekle",
          "maxRows": 200,
          "minRows": 0,
          "gridColumns": [
            "orderLineNumber|Sipariş satırı|lookup:kabulKaynak:orderLineNumber:stockCode:stockName|required",
            "trackingCode|Lot/seri kodu|text|required",
            "quantity|Miktar|number|required,min:0",
            "expiryDate|Son kullanma|date"
          ],
          "slot": "dialog"
        }
      }
    ],
