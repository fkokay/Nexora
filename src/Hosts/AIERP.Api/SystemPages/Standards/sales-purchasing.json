{
  "screenKey": "sales-purchasing",
  "title": "Satınalma siparişleri",
  "description": "Tedarikçi siparişlerini, teslim alınan miktarları ve mal kabul ile fatura zincirini izleyin.",
  "module": "Satın Alma",
  "version": 5,
  "stage": "preview",
  "items": {
