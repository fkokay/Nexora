{
  "screenKey": "sales-purchasing", "title": "Satınalma siparişleri",
  "description": "Tedarikçi siparişlerini, teslim alınan miktarları ve mal kabul ile fatura zincirini izleyin.", "module": "Satın Alma",
  "version": 3, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:yeniSiparisDugmesi", "component:acDugmesi", "component:malKabulDugmesi", "component:eskiEkranDugmesi", "query:siparisler"]},
    "component:siparisSecimi": {"since": 1, "label": "Açık sipariş belgesi (gizli)"},
    "component:acikGostergesi": {"since": 1, "label": "Açık siparişler göstergesi", "requires": ["component:siparisSecimi", "component:durumSecimi", "query:sayAcik"]},
    "component:kismenGostergesi": {"since": 1, "label": "Kısmen alındı göstergesi", "requires": ["component:siparisSecimi", "component:durumSecimi", "query:sayKismen"]},
    "component:gecikmisGostergesi": {"since": 1, "label": "Gecikmiş göstergesi", "requires": ["component:siparisSecimi", "component:gecikmisSecimi", "query:sayGecikmis"]},
    "component:durumAcik": {"since": 1, "label": "Sayaç durumu: Açık (gizli)"},
    "component:durumKismen": {"since": 1, "label": "Sayaç durumu: Kısmen alındı (gizli)"},
    "component:gecikmisSabit": {"since": 1, "label": "Sayaç süzgeci: Gecikmiş (gizli)"},
    "component:sayacSayfaBoyutu": {"since": 1, "label": "Sayaç sayfa boyutu (gizli)"},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:siparisSecimi", "component:liste"]},
    "component:secimCipleri": {"since": 1, "label": "Durum seçimi çipleri", "requires": ["component:siparisSecimi", "component:durumSecimi"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeç seçimleri kartı", "requires": ["component:siparisSecimi", "component:durumSecimi", "component:gecikmisSecimi"]},
    "component:durumSecimi": {"since": 1, "label": "Durum seçimi"},
    "component:gecikmisSecimi": {"since": 1, "label": "Yalnız gecikmiş siparişler"},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:liste": {"since": 1, "label": "Sipariş listesi", "requires": ["component:siparisSecimi", "component:detayPaneli", "component:acDugmesi", "query:siparisler"]},
    "component:acDugmesi": {"since": 1, "label": "Sipariş belgesini aç", "requires": ["component:siparisSecimi", "component:liste"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:siparisSecimi", "component:detayPaneli", "component:liste", "component:ozetPaneli", "component:acDugmesi"]},
    "component:ozetPaneli": {"since": 1, "label": "Detay: Özet", "requires": ["component:liste"]},
    "component:belgeBasligi": {"since": 1, "label": "Sipariş belgesi başlığı", "requires": ["component:siparisSecimi", "component:listeyeDonDugmesi", "component:belgeMalKabulDugmesi", "query:siparis"]},
    "component:belgeMalKabulDugmesi": {"since": 1, "label": "Belge: Mal kabul oluştur", "requires": ["component:siparisSecimi", "component:malKabulPenceresi", "query:siparis"]},
    "component:listeyeDonDugmesi": {"since": 1, "label": "Listeye dön düğmesi", "requires": ["component:siparisSecimi"]},
    "component:durumAdimlari": {"since": 1, "label": "Sipariş durum akışı", "requires": ["component:siparisSecimi", "query:siparis"]},
    "component:kapaliUyarisi": {"since": 1, "label": "İptal / ret uyarısı", "requires": ["component:siparisSecimi", "query:siparis"]},
    "component:toplamGostergesi": {"since": 1, "label": "Belge: Genel toplam", "requires": ["component:siparisSecimi", "query:siparis"]},
    "component:teslimGostergesi": {"since": 1, "label": "Belge: Teslim alınan", "requires": ["component:siparisSecimi", "query:siparis"]},
    "component:faturaGostergesi": {"since": 1, "label": "Belge: Faturalanan mal kabul", "requires": ["component:siparisSecimi", "query:siparis"]},
    "component:gecikmeGostergesi": {"since": 1, "label": "Belge: Beklenen teslim", "requires": ["component:siparisSecimi", "query:siparis"]},
    "component:belgeSekmeleri": {"since": 1, "label": "Belge sekmeleri", "requires": ["component:siparisSecimi", "component:satirTablosu", "component:kabulTablosu", "component:belgeZinciri", "component:siparisNotu", "component:alanTablosu", "query:malKabuller"]},
    "component:satirTablosu": {"since": 1, "label": "Belge: Satırlar", "requires": ["query:satirlar"]},
    "component:kabulTablosu": {"since": 1, "label": "Belge: Mal kabulleri", "requires": ["component:kabulAcDugmesi", "component:faturalaDugmesi", "query:malKabuller"]},
    "component:kabulAcDugmesi": {"since": 1, "label": "Mal kabulü aç satır düğmesi (eski ekran)", "requires": ["component:kabulTablosu"]},
    "component:faturalaDugmesi": {"since": 1, "label": "Faturala satır düğmesi", "requires": ["component:kabulTablosu"]},
    "component:belgeZinciri": {"since": 1, "label": "Belge zinciri", "requires": ["query:siparis", "query:malKabuller"]},
    "component:siparisNotu": {"since": 1, "label": "Sipariş notu", "requires": ["query:siparis"]},
    "component:alanTablosu": {"since": 1, "label": "Belge: Özel alanlar", "requires": ["query:ozelDegerler"]},
    "component:yeniSiparisDugmesi": {"since": 1, "label": "Yeni sipariş komutu"},
    "component:malKabulDugmesi": {"since": 1, "label": "Mal kabul oluştur komutu (siparişi açar)", "requires": ["component:siparisSecimi", "component:liste"]},
    "component:malKabulPenceresi": {"since": 2, "label": "Mal kabul penceresi",
      "requires": ["component:siparisSecimi", "component:kabulBilgileri", "component:kabulIstekKimligi", "component:kabulNotu", "component:kabulKalemleri",
                   "component:kabulDurumu", "component:izlemeliKabulDugmesi", "query:malKabulOlustur", "query:kabulKaynak", "query:siparis",
                   "query:satirlar", "query:malKabuller", "query:siparisler", "query:sayAcik", "query:sayKismen", "query:sayGecikmis"]},
    "component:kabulBilgileri": {"since": 2, "label": "Mal kabul bilgileri (depo, tarih)", "requires": ["component:kabulDepo", "component:kabulTarihi"]},
    "component:kabulDepo": {"since": 2, "label": "Mal kabul alanı: Depo", "requires": ["query:depolar", "query:siparis", "component:kabulKalemleri"]},
    "component:kabulTarihi": {"since": 2, "label": "Mal kabul alanı: Kabul tarihi"},
    "component:kabulIstekKimligi": {"since": 2, "label": "Mal kabul tekrar deneme kimliği (gizli)"},
    "component:kabulNotu": {"since": 2, "label": "Mal kabul bilgi notu"},
    "component:kabulKalemleri": {"since": 2, "label": "Mal kabul satırları (siparişin kalanı)", "requires": ["query:kabulKaynak", "query:kabulKonumlari"]},
    "component:kabulDurumu": {"since": 2, "label": "Mal kabul satır sayacı", "requires": ["component:kabulKalemleri"]},
    "component:izlemeliKabulDugmesi": {"since": 2, "label": "Lot/seri izlemeli kabul (eski ekran)", "requires": ["component:siparisSecimi"]},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Siparişi eski ekranda aç", "requires": ["component:siparisSecimi", "component:liste"]},
    "query:siparisler": {"since": 1, "label": "Satınalma siparişlerini listele", "requires": ["component:suzgec", "component:durumSecimi", "component:gecikmisSecimi", "component:liste"]},
    "query:sayAcik": {"since": 1, "label": "Açık sipariş sayısı", "requires": ["component:suzgec", "component:durumAcik", "component:sayacSayfaBoyutu"]},
    "query:sayKismen": {"since": 1, "label": "Kısmen alınan sipariş sayısı", "requires": ["component:suzgec", "component:durumKismen", "component:sayacSayfaBoyutu"]},
    "query:sayGecikmis": {"since": 1, "label": "Gecikmiş sipariş sayısı", "requires": ["component:suzgec", "component:gecikmisSabit", "component:sayacSayfaBoyutu"]},
    "query:siparis": {"since": 1, "label": "Açık sipariş belgesi", "requires": ["component:siparisSecimi"]},
    "query:satirlar": {"since": 1, "label": "Sipariş satırları", "requires": ["component:siparisSecimi"]},
    "query:malKabuller": {"since": 1, "label": "Siparişin mal kabulleri", "requires": ["component:siparisSecimi"]},
    "query:ozelDegerler": {"since": 1, "label": "Siparişin özel alanları", "requires": ["component:siparisSecimi"]},
    "query:kabulKaynak": {"since": 2, "label": "Mal kabul kaynağı: siparişin kalan satırları", "requires": ["component:siparisSecimi"]},
    "query:depolar": {"since": 2, "label": "Depoları listele"},
    "query:kabulKonumlari": {"since": 2, "label": "Kabul deposunun konumları", "requires": ["component:kabulDepo"]},
    "query:malKabulOlustur": {"since": 2, "label": "Siparişe mal kabul oluştur",
      "requires": ["component:siparisSecimi", "component:kabulIstekKimligi", "component:kabulDepo", "component:kabulTarihi", "component:kabulKalemleri"]}
  },
  "screenViews": [ { "key": "purchase-orders", "component": "liste",
                     "fields": { "code": "code", "supplierName": "supplierName", "orderDate": "orderDate", "expectedReceiptDate": "expectedReceiptDate",
                                 "lineCount": "lineCount", "grandTotal": "grandTotal", "currencyCode": "currencyCode", "status": "status" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "focusInput": "suzgec", "exportTable": "liste",
                   "titleCount": "{{siparisler.meta.totalCount}}", "moreButtons": ["malKabulDugmesi", "eskiEkranDugmesi"],
                   "hiddenCommands": ["save", "delete", "print"], "newAction": "page", "newPageCode": "@purchase-order-document", "newTarget": "newTab", "openAction": "page", "openPageCode": "@purchase-order-document", "openTarget": "newTab", "openTable": "liste", "openParams": ["id={{liste.seciliSatir.id}}"] } },

      { "id": "siparisSecimi", "type": "input", "name": "siparisSecimi",
        "props": { "inputType": "text", "label": "Açık sipariş", "hidden": true, "defaultValue": "{{sayfa.parametre.purchaseOrderId}}" } },

      { "id": "acikGostergesi", "type": "metric", "name": "acikGostergesi",
        "props": { "title": "Açık", "value": "{{sayAcik.meta.totalCount}}", "format": "number", "width": 4, "icon": "inbox",
                   "description": "mal bekliyor · tıkla: süz", "filterInput": "durumSecimi", "filterValue": "Open",
                   "visibleWhen": "siparisSecimi.value == null" } },
      { "id": "kismenGostergesi", "type": "metric", "name": "kismenGostergesi",
        "props": { "title": "Kısmen alındı", "value": "{{sayKismen.meta.totalCount}}", "format": "number", "width": 4, "icon": "hourglass",
                   "variant": "warning", "description": "mal bekliyor · tıkla: süz", "filterInput": "durumSecimi", "filterValue": "PartiallyReceived",
                   "visibleWhen": "siparisSecimi.value == null" } },
      { "id": "gecikmisGostergesi", "type": "metric", "name": "gecikmisGostergesi",
        "props": { "title": "Gecikmiş", "value": "{{sayGecikmis.meta.totalCount}}", "format": "number", "width": 4, "icon": "alert",
                   "variant": "danger", "description": "beklenen teslim geçti · tıkla: süz", "filterInput": "gecikmisSecimi", "filterValue": "true",
                   "visibleWhen": "siparisSecimi.value == null" } },
      { "id": "durumAcik", "type": "input", "name": "durumAcik",
        "props": { "inputType": "text", "label": "Sayaç durumu", "hidden": true, "defaultValue": "Open" } },
      { "id": "durumKismen", "type": "input", "name": "durumKismen",
        "props": { "inputType": "text", "label": "Sayaç durumu", "hidden": true, "defaultValue": "PartiallyReceived" } },
      { "id": "gecikmisSabit", "type": "input", "name": "gecikmisSabit",
        "props": { "inputType": "text", "label": "Sayaç süzgeci", "hidden": true, "defaultValue": "true" } },
      { "id": "sayacSayfaBoyutu", "type": "input", "name": "sayacSayfaBoyutu",
        "props": { "inputType": "text", "label": "Sayaç sayfa boyutu", "hidden": true, "defaultValue": "1" } },

      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 6, "search": true, "searchPlaceholder": "Sipariş no veya tedarikçi ile ara", "searchParam": "q",
                   "visibleWhen": "siparisSecimi.value == null" } },
      { "id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri",
        "props": { "title": "Süzgeçler", "layout": "inline", "width": 6, "inputs": ["durumSecimi", "gecikmisSecimi"], "visibleWhen": "siparisSecimi.value == null" } },
      { "id": "durumSecimi", "type": "input", "name": "durumSecimi",
        "props": { "inputType": "select", "label": "Durum",
                   "staticOptions": ["=Tümü", "PendingApproval=Onay bekliyor", "Open=Açık", "PartiallyReceived=Kısmen alındı", "Received=Tam alındı",
                                     "Cancelled=İptal", "Rejected=Reddedildi"] } },
      { "id": "gecikmisSecimi", "type": "input", "name": "gecikmisSecimi",
        "props": { "inputType": "checkbox", "label": "Gecikmiş" } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": { "inputType": "checkbox", "label": "Detay paneli", "icon": "panel", "defaultWhen": "sayfa.genis == true" } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": { "width": 12, "inputs": ["durumSecimi"], "visibleWhen": "siparisSecimi.value == null" } },

      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Satınalma siparişleri", "query": "siparisler", "paging": "server", "pageSize": 25, "width": 12,
                   "visibleWhen": "siparisSecimi.value == null",
                   "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.id != null",
                   "detailToggleInput": "detayPaneli",
                   "columns": ["code", "supplierName", "orderDate", "expectedReceiptDate", "lineCount", "receivedPercent", "grandTotal", "status",
                               "delayDays"],
                   "columnLabels": ["code=Sipariş no", "supplierName=Tedarikçi", "orderDate=Sipariş tarihi", "expectedReceiptDate=Beklenen teslim",
                                    "lineCount=Satır", "receivedPercent=Teslim alınan %", "grandTotal=Genel toplam", "currencyCode=Döviz",
                                    "status=Durum", "delayDays=Gecikme (gün)", "receivedQuantity=Alınan miktar", "orderedQuantity=Sipariş miktarı"],
                   "columnUnits": ["grandTotal=currencyCode"],
                   "columnFormats": ["code=code", "orderDate=date", "expectedReceiptDate=date", "lineCount=number", "receivedPercent=number",
                                     "grandTotal=money", "status=status", "delayDays=number", "receivedQuantity=number", "orderedQuantity=number"],
                   "valueLabels": ["status:PendingApproval=Onay bekliyor", "status:Open=Açık", "status:PartiallyReceived=Kısmen alındı",
                                   "status:Received=Tam alındı", "status:Cancelled=İptal", "status:Rejected=Reddedildi"],
                   "toneMap": ["Onay bekliyor=warning", "Açık=info", "Kısmen alındı=warning", "Tam alındı=success", "Reddedildi=danger"],
                   "rowOpenAction": "acDugmesi", "openParam": "id",
                   "emptyText": "Filtrelerle eşleşen satın alma siparişi yok." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "icon": "open", "actionType": "erpPage", "pageKey": "purchase-order-document", "target": "sameTab", "params": ["id={{liste.seciliSatir.id}}"],
                   "disabledWhen": "liste.seciliSatir.id == null", "disabledReason": "Önce bir kayıt seçin" } },

      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": { "variant": "panel", "title": "{{liste.seciliSatir.code}}", "description": "{{liste.seciliSatir.supplierName}}",
                   "closeInput": "detayPaneli", "width": 4,
                   "visibleWhen": "siparisSecimi.value == null && detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "detayGecikmis", "type": "badge", "name": "detayGecikmis",
            "props": { "text": "Gecikmiş · {{liste.seciliSatir.delayDays}} gün", "variant": "danger", "visibleWhen": "liste.seciliSatir.isOverdue == true" } },
          { "id": "detayTeslim", "type": "metric", "name": "detayTeslim",
            "props": { "title": "Teslim alınan", "value": "{{liste.seciliSatir.receivedPercent}}", "format": "number", "width": 6, "icon": "truck",
                       "description": "% · {{liste.seciliSatir.receivedQuantity}} / {{liste.seciliSatir.orderedQuantity}}" } },
          { "id": "detayToplam", "type": "metric", "name": "detayToplam",
            "props": { "title": "Genel toplam", "value": "{{liste.seciliSatir.grandTotal}}", "format": "money", "width": 6, "icon": "wallet",
                       "description": "{{liste.seciliSatir.currencyCode}}" } },
          { "id": "detaySekmeleri", "type": "tabs", "name": "detaySekmeleri",
            "props": { "tabs": ["Özet=ozetPaneli"] } },
          { "id": "detayAc", "type": "button", "name": "detayAc",
            "props": { "text": "Sipariş belgesini aç ›", "actionType": "setInput", "assignments": ["siparisSecimi={{liste.seciliSatir.id}}"] } },
          { "id": "detayMalKabul", "type": "button", "name": "detayMalKabul",
            "props": { "text": "Mal kabul oluştur ›", "actionType": "setInput", "assignments": ["siparisSecimi={{liste.seciliSatir.id}}"],
                       "visibleWhen": "liste.seciliSatir.status == 'Open' || liste.seciliSatir.status == 'PartiallyReceived'" } }
        ] },
      { "id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli",
        "props": { "table": "liste", "width": 12,
                   "fields": ["orderDate=Sipariş tarihi", "expectedReceiptDate=Beklenen teslim", "delayDays=Gecikme (gün)", "lineCount=Satır",
                              "orderedQuantity=Sipariş miktarı", "receivedQuantity=Alınan miktar", "currencyCode=Döviz"] } },

      { "id": "listeyeDonDugmesi", "type": "button", "name": "listeyeDonDugmesi",
        "props": { "text": "‹ Siparişler", "actionType": "setInput", "assignments": ["siparisSecimi="] } },
      { "id": "belgeBasligi", "type": "recordHeader", "name": "belgeBasligi",
        "props": { "visibleWhen": "siparisSecimi.value != null", "icon": "shopping-cart",
                   "title": "{{siparis.rows[0].code}} · {{siparis.rows[0].supplierName}}",
                   "subtitle": "Satınalma siparişi · {{siparis.rows[0].currencyCode}}",
                   "fields": ["Sipariş tarihi={{siparis.rows[0].orderDate}}", "Beklenen teslim={{siparis.rows[0].expectedReceiptDate}}",
                              "Ara toplam={{siparis.rows[0].subtotal}}", "İskonto={{siparis.rows[0].discountTotal}}", "KDV={{siparis.rows[0].taxTotal}}"],
                   "fieldFormats": ["Sipariş tarihi=date", "Beklenen teslim=date", "Ara toplam=money", "İskonto=money", "KDV=money"],
                   "fieldUnits": ["Ara toplam={{siparis.rows[0].currencyCode}}", "İskonto={{siparis.rows[0].currencyCode}}",
                                  "KDV={{siparis.rows[0].currencyCode}}"],
                   "buttons": ["listeyeDonDugmesi", "belgeMalKabulDugmesi"] } },
      { "id": "durumAdimlari", "type": "steps", "name": "durumAdimlari",
        "props": { "steps": ["Onay", "Açık", "Kısmen alındı", "Tam alındı"],
                   "activeWhen": ["siparis.rows[0].id != null",
                                  "siparis.rows[0].status == 'Open' || siparis.rows[0].status == 'PartiallyReceived' || siparis.rows[0].status == 'Received'",
                                  "siparis.rows[0].status == 'PartiallyReceived' || siparis.rows[0].status == 'Received'",
                                  "siparis.rows[0].status == 'Received'"],
                   "visibleWhen": "siparisSecimi.value != null && siparis.rows[0].status != 'Cancelled' && siparis.rows[0].status != 'Rejected'" } },
      { "id": "kapaliUyarisi", "type": "alert", "name": "kapaliUyarisi",
        "props": { "title": "Sipariş kapalı", "variant": "warning", "width": 12,
                   "text": "Bu sipariş iptal edildi ya da onayda reddedildi; mal kabul yapılamaz.",
                   "visibleWhen": "siparisSecimi.value != null && (siparis.rows[0].status == 'Cancelled' || siparis.rows[0].status == 'Rejected')" } },
      { "id": "toplamGostergesi", "type": "metric", "name": "toplamGostergesi",
        "props": { "title": "Genel toplam", "value": "{{siparis.rows[0].grandTotal}}", "format": "money", "width": 3, "icon": "wallet",
                   "description": "{{siparis.rows[0].currencyCode}}", "visibleWhen": "siparisSecimi.value != null" } },
      { "id": "teslimGostergesi", "type": "metric", "name": "teslimGostergesi",
        "props": { "title": "Teslim alınan %", "value": "{{siparis.rows[0].receivedPercent}}", "format": "number", "width": 3, "icon": "truck",
                   "description": "{{siparis.rows[0].receivedQuantity}} / {{siparis.rows[0].orderedQuantity}} · {{siparis.rows[0].postedReceiptCount}} kabul",
                   "visibleWhen": "siparisSecimi.value != null" } },
      { "id": "faturaGostergesi", "type": "metric", "name": "faturaGostergesi",
        "props": { "title": "Faturalanan mal kabul", "value": "{{siparis.rows[0].invoicedReceiptCount}}", "format": "number", "width": 3,
                   "icon": "receipt", "description": "/ {{siparis.rows[0].postedReceiptCount}} kabul", "visibleWhen": "siparisSecimi.value != null" } },
      { "id": "gecikmeGostergesi", "type": "metric", "name": "gecikmeGostergesi",
        "props": { "title": "Gecikme", "value": "{{siparis.rows[0].delayDays}}", "format": "number", "width": 3, "icon": "calendar-clock",
                   "variant": "danger", "description": "gün · beklenen teslim geçti",
                   "visibleWhen": "siparisSecimi.value != null && siparis.rows[0].isOverdue == true" } },
      { "id": "belgeSekmeleri", "type": "tabs", "name": "belgeSekmeleri",
        "props": { "visibleWhen": "siparisSecimi.value != null",
                   "tabs": ["Satırlar=satirTablosu,siparisNotu", "Kabuller {{malKabuller.satirSayisi}}=kabulTablosu,belgeZinciri",
