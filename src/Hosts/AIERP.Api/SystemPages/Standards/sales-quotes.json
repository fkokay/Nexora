{
  "screenKey": "sales-quotes", "title": "Satış Teklifleri",
  "description": "Müşteri taleplerini iskonto ve KDV hesaplarıyla teklif taslağına dönüştürün.", "module": "Satış & cari",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:acDugmesi", "component:duzenleDugmesi", "component:iletDugmesi", "component:kabulDugmesi", "component:liste", "component:reddetDugmesi", "component:revizyonlarDugmesi", "component:siparisAcDugmesi", "component:siparisDugmesi", "component:suzgec", "component:yazdirDugmesi", "component:yeniDugmesi", "query:teklif", "query:teklifSil", "query:teklifler"]},
    "component:yeniDugmesi": {"since": 1, "label": "Yeni teklif komutu"},
    "component:acDugmesi": {"since": 1, "label": "Teklifi aç komutu", "requires": ["component:liste", "component:teklifPenceresi"]},
    "component:tutarGostergesi": {"since": 1, "label": "Teklif tutarı göstergesi (bu sayfa)", "requires": ["query:teklifler"]},
    "component:tutarKarisik": {"since": 1, "label": "Teklif tutarı (birden çok para birimi)", "requires": ["query:teklifler"]},
    "component:yanitGostergesi": {"since": 1, "label": "Yanıt bekleyen göstergesi", "requires": ["component:durumSecimi", "query:teklifler"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:secimCipleri": {"since": 1, "label": "Durum seçimi çipleri", "requires": ["component:durumSecimi"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeç seçimleri kartı", "requires": ["component:baslangicTarihi", "component:bitisTarihi", "component:durumSecimi"]},
    "component:durumSecimi": {"since": 1, "label": "Durum seçimi"},
    "component:gorunumKarti": {"since": 1, "label": "Detay paneli anahtarı kartı", "requires": ["component:detayPaneli"]},
    "component:detayPaneli": {"since": 1, "label": "Detay paneli anahtarı"},
    "component:baslangicTarihi": {"since": 1, "label": "Başlangıç tarihi"},
    "component:bitisTarihi": {"since": 1, "label": "Bitiş tarihi"},
    "component:liste": {"since": 1, "label": "Satış teklifleri listesi", "requires": ["component:acDugmesi", "component:detayPaneli", "query:teklifler"]},
    "component:detayKarti": {"since": 1, "label": "Detay paneli", "requires": ["component:detayPaneli", "component:liste", "component:teklifPenceresi", "query:kabulEt", "query:reddet", "query:teklif", "query:teklifler"]},
    "component:duzenleDugmesi": {"since": 1, "label": "Düzenle komutu (eski kart)", "requires": ["query:teklif"]},
    "component:iletDugmesi": {"since": 1, "label": "İletildi yap komutu", "requires": ["component:liste", "query:ilet", "query:teklif", "query:teklifler"]},
    "component:kabulDugmesi": {"since": 1, "label": "Kabul et komutu", "requires": ["component:liste", "query:kabulEt", "query:teklif", "query:teklifler"]},
    "component:reddetDugmesi": {"since": 1, "label": "Reddet komutu", "requires": ["component:liste", "query:reddet", "query:teklif", "query:teklifler"]},
    "component:siparisDugmesi": {"since": 1, "label": "Sipariş oluştur komutu", "requires": ["component:liste", "query:siparisOlustur", "query:teklif", "query:teklifler"]},
    "component:siparisAcDugmesi": {"since": 1, "label": "Siparişi aç komutu", "requires": ["query:teklif"]},
    "component:revizyonlarDugmesi": {"since": 1, "label": "Revizyonlar komutu", "requires": ["component:liste", "component:teklifPenceresi"]},
    "component:yazdirDugmesi": {"since": 1, "label": "Yazdır / PDF komutu (eski ekran)", "requires": ["component:liste", "query:teklif"]},
    "component:teklifPenceresi": {"since": 1, "label": "Teklif detayı penceresi", "requires": ["component:teklifBasligi", "component:teklifIslemleri", "component:teklifRozetleri", "component:teklifSekmeleri", "query:teklif"]},
    "component:teklifBasligi": {"since": 1, "label": "Teklif detayı başlığı", "requires": ["query:teklif"]},
    "component:teklifRozetleri": {"since": 1, "label": "Teklif durumu ve belge zinciri", "requires": ["query:teklif"]},
    "component:teklifIslemleri": {"since": 1, "label": "Teklif detayı işlemleri", "requires": ["query:ilet", "query:kabulEt", "query:reddet", "query:revizyonlar", "query:siparisOlustur", "query:teklif", "query:teklifler"]},
    "component:teklifSekmeleri": {"since": 1, "label": "Teklif detayı sekmeleri", "requires": ["component:revizyonTablosu", "component:satirTablosu", "component:teklifNotlari", "query:revizyonlar"]},
    "component:satirTablosu": {"since": 1, "label": "Teklif satırları", "requires": ["query:satirlar"]},
    "component:teklifNotlari": {"since": 1, "label": "Satır döviz bilgisi", "requires": ["component:satirTablosu"]},
    "component:revizyonTablosu": {"since": 1, "label": "Revizyon geçmişi", "requires": ["query:revizyonlar"]},
    "query:teklifler": {"since": 1, "label": "Satış tekliflerini listele", "requires": ["component:baslangicTarihi", "component:bitisTarihi", "component:durumSecimi", "component:liste", "component:suzgec"]},
    "query:teklif": {"since": 1, "label": "Seçili teklif", "requires": ["component:liste"]},
    "query:satirlar": {"since": 1, "label": "Seçili teklifin satırları", "requires": ["component:liste"]},
    "query:revizyonlar": {"since": 1, "label": "Seçili teklifin revizyonları", "requires": ["component:liste"]},
    "query:ilet": {"since": 1, "label": "Teklifi iletildi yap", "requires": ["component:liste"]},
    "query:kabulEt": {"since": 1, "label": "Teklifi kabul et", "requires": ["component:liste"]},
    "query:reddet": {"since": 1, "label": "Teklifi reddet", "requires": ["component:liste"]},
    "query:siparisOlustur": {"since": 1, "label": "Tekliften sipariş oluştur", "requires": ["component:liste"]},
    "query:teklifSil": {"since": 1, "label": "Teklifi sil", "requires": ["component:liste"]}
  },
  "screenViews": [
    {"key": "sales-quotes", "component": "liste", "fields": {"code": "code", "customerName": "customerName", "salesperson": "salespersonName", "salesOrderCode": "salesOrderCode", "quoteDate": "quoteDate", "validUntil": "validUntil", "lineCount": "lineCount", "grandTotal": "grandTotal", "status": "status"}}
  ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": {
          "newButton": "yeniDugmesi",
          "openButton": "acDugmesi",
          "deleteQuery": "teklifSil", "deleteConfirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.customerName}} teklifi silinsin mi?",
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{teklifler.meta.totalCount}}",
          "moreButtons": ["duzenleDugmesi", "iletDugmesi", "kabulDugmesi", "reddetDugmesi", "siparisDugmesi", "siparisAcDugmesi", "revizyonlarDugmesi", "yazdirDugmesi"],
          "commandWhen": ["delete=kullanici.rol == 'TenantAdmin' && teklif.rows[0].id == liste.seciliSatir.id && teklif.rows[0].status == 'Draft' && teklif.rows[0].hasSalesOrder != true"],
          "hiddenCommands": ["save", "print"] } },
      { "id": "yeniDugmesi", "type": "button", "name": "yeniDugmesi",
        "props": {
          "text": "Yeni teklif",
          "actionType": "erpPage",
          "pageKey": "sales-quote-create",
          "target": "newTab",
          "params": ["customerId={{sayfa.parametre.customerId}}"] } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": {
          "text": "Aç",
          "icon": "open",
          "actionType": "openDialog",
          "dialogId": "teklifPenceresi",
          "disabledWhen": "liste.seciliSatir.id == null",
          "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "tutarGostergesi", "type": "metric", "name": "tutarGostergesi",
        "props": {
          "title": "Teklif tutarı",
          "value": "{{teklifler.meta.pageGrandTotal}}",
          "format": "money",
          "width": 3,
          "icon": "wallet",
          "description": "bu sayfa · tüm durumlar · {{teklifler.meta.pageCurrencyCode}}",
          "visibleWhen": "teklifler.meta.pageMixedCurrencies != true" } },
      { "id": "tutarKarisik", "type": "metric", "name": "tutarKarisik",
        "props": {
          "title": "Teklif tutarı",
          "value": "—",
          "width": 3,
          "icon": "wallet",
          "description": "bu sayfa · tüm durumlar · birden çok para birimi",
          "visibleWhen": "teklifler.meta.pageMixedCurrencies == true" } },
      { "id": "yanitGostergesi", "type": "metric", "name": "yanitGostergesi",
        "props": {
          "title": "Yanıt bekleyen",
          "query": "teklifler",
          "countWhen": "teklifler.satir.status == 'Sent'",
          "format": "number",
          "width": 3,
          "icon": "hourglass",
          "variant": "warning",
          "description": "bu sayfa · tıklayınca İletildi süzülür",
          "filterInput": "durumSecimi",
          "filterValue": "Sent" } },
      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": {
          "table": "liste",
          "width": 3,
          "search": true,
          "searchPlaceholder": "Teklif no veya müşteriyle ara",
          "searchParam": "q" } },
      { "id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri",
        "props": { "title": "Süzgeçler", "layout": "inline", "width": 7, "inputs": ["durumSecimi", "baslangicTarihi", "bitisTarihi"] } },
      { "id": "durumSecimi", "type": "input", "name": "durumSecimi",
        "props": {
          "inputType": "select",
          "label": "Durum",
          "staticOptions": ["=Tümü", "Draft=Taslak", "Sent=İletildi", "Accepted=Kabul edildi", "Rejected=Reddedildi", "Expired=Süresi doldu"] } },
      { "id": "gorunumKarti", "type": "formCard", "name": "gorunumKarti",
        "props": {
          "title": "Görünüm",
          "layout": "inline",
          "width": 2,
          "inputs": ["detayPaneli"] } },
      { "id": "detayPaneli", "type": "input", "name": "detayPaneli",
        "props": {
          "inputType": "checkbox",
          "label": "Detay paneli",
          "icon": "panel",
          "defaultWhen": "sayfa.genis == true" } },
      { "id": "baslangicTarihi", "type": "input", "name": "baslangicTarihi",
        "props": {
          "inputType": "date",
          "label": "Başlangıç" } },
      { "id": "bitisTarihi", "type": "input", "name": "bitisTarihi",
        "props": {
          "inputType": "date",
          "label": "Bitiş" } },
      { "id": "secimCipleri", "type": "filterChips", "name": "secimCipleri",
        "props": {
          "width": 12,
          "inputs": ["durumSecimi"] } },
      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": {
          "title": "Satış teklifleri",
          "query": "teklifler",
          "paging": "server",
          "pageSize": 25,
          "width": 12,
          "widthWhen": "8=detayPaneli.value == true && liste.seciliSatir.id != null",
          "columns": ["code", "revisionNumber", "customerName", "salespersonName", "salesOrderCode", "quoteDate", "validUntil", "lineCount", "grandTotal", "status"],
          "columnLabels": ["code=Teklif no", "revisionNumber=Rev.", "customerName=Müşteri", "salespersonName=Plasiyer", "salesOrderCode=Sipariş no", "quoteDate=Teklif tarihi", "validUntil=Geçerlilik", "lineCount=Satır", "grandTotal=Genel toplam", "status=Durum", "customerCode=Cari kodu", "currencyCode=Döviz", "createdAt=Oluşturulma"],
          "columnFormats": ["code=code", "revisionNumber=number", "quoteDate=date", "validUntil=date", "lineCount=number", "grandTotal=money", "status=status", "createdAt=date"],
          "columnUnits": ["grandTotal=currencyCode", "customerName=customerCode"],
          "valueLabels": ["status:Draft=Taslak", "status:Sent=İletildi", "status:Accepted=Kabul edildi", "status:Rejected=Reddedildi", "status:Expired=Süresi doldu", "customerName:Teklif alıcısı=Kayıtsız alıcı"],
          "toneMap": ["Taslak=info", "İletildi=warning", "Kabul edildi=success", "Reddedildi=danger", "Süresi doldu=info"],
          "rowOpenAction": "acDugmesi",
          "openParam": "quoteId",
          "emptyText": "Aramanızla eşleşen teklif yok." } },
      { "id": "detayKarti", "type": "card", "name": "detayKarti",
        "props": {
          "variant": "panel",
          "title": "{{liste.seciliSatir.code}} · rev. {{liste.seciliSatir.revisionNumber}}",
          "description": "{{liste.seciliSatir.customerName}}",
          "closeInput": "detayPaneli",
          "width": 4,
          "visibleWhen": "detayPaneli.value == true && liste.seciliSatir.id != null" },
        "children": [
          { "id": "panelAc", "type": "button", "name": "panelAc",
            "props": {
              "text": "Aç",
              "icon": "open",
              "actionType": "openDialog",
              "dialogId": "teklifPenceresi" } },
          { "id": "panelToplam", "type": "metric", "name": "panelToplam",
            "props": {
              "title": "Genel toplam",
              "value": "{{liste.seciliSatir.grandTotal}}",
              "format": "money",
              "width": 6,
              "icon": "wallet",
              "description": "{{liste.seciliSatir.currencyCode}}" } },
          { "id": "panelGecerlilik", "type": "metric", "name": "panelGecerlilik",
            "props": {
              "title": "Geçerlilik",
              "value": "{{liste.seciliSatir.validUntil}}",
              "width": 6,
              "icon": "calendar",
              "description": "teklif {{liste.seciliSatir.quoteDate}}" } },
          { "id": "panelSatir", "type": "metric", "name": "panelSatir",
            "props": {
              "title": "Satır",
              "value": "{{liste.seciliSatir.lineCount}}",
              "format": "number",
              "width": 6,
              "icon": "files" } },
          { "id": "panelPlasiyer", "type": "metric", "name": "panelPlasiyer",
            "props": {
              "title": "Plasiyer",
              "value": "{{liste.seciliSatir.salespersonName}}",
              "width": 6,
              "icon": "user" } },
          { "id": "panelDurum", "type": "contextPanel", "name": "panelDurum",
            "props": {
              "table": "liste",
              "width": 12,
              "fields": ["status=Durum", "salesOrderCode=Sipariş no", "customerCode=Cari kodu", "currencyCode=Döviz"] } },
          { "id": "panelKabul", "type": "button", "name": "panelKabul",
            "props": {
              "text": "Kabul et",
              "actionType": "query",
              "queryId": "kabulEt",
              "confirmEnabled": true,
              "confirmText": "“{{teklif.rows[0].code}}” kabul edilsin mi? Kayıtsız alıcılı teklifte alıcı için cari kartı açılır.",
              "visibleWhen": "teklif.rows[0].status == 'Sent' || teklif.rows[0].status == 'Rejected'",
              "successMessage": "Teklif kabul edildi.",
              "refreshQueries": ["teklif", "teklifler"] } },
          { "id": "panelReddet", "type": "button", "name": "panelReddet",
            "props": {
              "text": "Reddet",
              "actionType": "query",
              "queryId": "reddet",
              "confirmEnabled": true,
              "confirmText": "“{{teklif.rows[0].code}}” reddedilsin mi?",
              "visibleWhen": "teklif.rows[0].status == 'Sent'",
              "successMessage": "Teklif reddedildi.",
              "refreshQueries": ["teklif", "teklifler"] } },
          { "id": "panelRevizyonlar", "type": "button", "name": "panelRevizyonlar",
            "props": {
              "text": "Revizyonlar ›",
              "actionType": "openDialog",
              "dialogId": "teklifPenceresi" } },
          { "id": "panelYazdir", "type": "button", "name": "panelYazdir",
            "props": {
              "text": "Yazdır / PDF ›",
              "actionType": "erpPage",
              "pageKey": "sales-quotes",
              "target": "sameTab",
              "legacyScreen": true,
              "params": ["quoteId={{liste.seciliSatir.id}}"] } }
        ] },
      { "id": "duzenleDugmesi", "type": "button", "name": "duzenleDugmesi",
        "props": {
          "text": "Düzenle",
          "actionType": "erpPage",
          "pageKey": "sales-quote-create",
          "target": "newTab",
          "params": ["quoteId={{teklif.rows[0].id}}"],
          "visibleWhen": "teklif.rows[0].status == 'Draft' && teklif.rows[0].hasSalesOrder != true" } },
      { "id": "iletDugmesi", "type": "button", "name": "iletDugmesi",
        "props": {
          "text": "İletildi yap",
          "actionType": "query",
          "queryId": "ilet",
          "confirmEnabled": true,
          "confirmText": "“{{teklif.rows[0].code}}” müşteriye iletildi olarak işaretlensin mi?",
          "visibleWhen": "teklif.rows[0].status == 'Draft'",
          "disabledWhen": "teklif.rows[0].id != liste.seciliSatir.id",
          "disabledReason": "Teklif yükleniyor…",
          "successMessage": "Teklif iletildi olarak işaretlendi.",
          "refreshQueries": ["teklif", "teklifler"] } },
      { "id": "kabulDugmesi", "type": "button", "name": "kabulDugmesi",
        "props": {
          "text": "Kabul et",
          "actionType": "query",
          "queryId": "kabulEt",
          "confirmEnabled": true,
          "confirmText": "“{{teklif.rows[0].code}}” kabul edilsin mi? Kayıtsız alıcılı teklifte alıcı için cari kartı açılır.",
          "visibleWhen": "teklif.rows[0].status == 'Sent' || teklif.rows[0].status == 'Rejected'",
          "disabledWhen": "teklif.rows[0].id != liste.seciliSatir.id",
          "disabledReason": "Teklif yükleniyor…",
          "successMessage": "Teklif kabul edildi.",
          "refreshQueries": ["teklif", "teklifler"] } },
      { "id": "reddetDugmesi", "type": "button", "name": "reddetDugmesi",
        "props": {
          "text": "Reddet",
          "actionType": "query",
          "queryId": "reddet",
          "confirmEnabled": true,
          "confirmText": "“{{teklif.rows[0].code}}” reddedilsin mi?",
          "visibleWhen": "teklif.rows[0].status == 'Sent'",
          "disabledWhen": "teklif.rows[0].id != liste.seciliSatir.id",
          "disabledReason": "Teklif yükleniyor…",
          "successMessage": "Teklif reddedildi.",
          "refreshQueries": ["teklif", "teklifler"] } },
      { "id": "siparisDugmesi", "type": "button", "name": "siparisDugmesi",
        "props": {
          "text": "Sipariş oluştur",
          "actionType": "query",
          "queryId": "siparisOlustur",
          "confirmEnabled": true,
          "confirmText": "“{{teklif.rows[0].code}}” tekliften satış siparişi oluşturulsun mu? İşlem geri alınamaz.",
          "visibleWhen": "teklif.rows[0].status == 'Accepted' && teklif.rows[0].hasSalesOrder != true",
          "disabledWhen": "teklif.rows[0].id != liste.seciliSatir.id",
          "disabledReason": "Teklif yükleniyor…",
          "successMessage": "Satış siparişi oluşturuldu; İşlemler › Siparişi aç ile açabilirsiniz.",
          "refreshQueries": ["teklif", "teklifler"] } },
      { "id": "siparisAcDugmesi", "type": "button", "name": "siparisAcDugmesi",
        "props": {
          "text": "Siparişi aç",
          "actionType": "erpPage",
          "pageKey": "sales-orders",
          "target": "newTab",
          "params": ["orderId={{teklif.rows[0].salesOrderId}}"],
          "visibleWhen": "teklif.rows[0].salesOrderId != null" } },
      { "id": "revizyonlarDugmesi", "type": "button", "name": "revizyonlarDugmesi",
        "props": {
          "text": "Revizyonlar",
          "actionType": "openDialog",
          "dialogId": "teklifPenceresi",
          "disabledWhen": "liste.seciliSatir.id == null",
          "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "yazdirDugmesi", "type": "button", "name": "yazdirDugmesi",
        "props": {
          "text": "Yazdır / PDF",
          "actionType": "erpPage",
          "pageKey": "sales-quotes",
          "target": "sameTab",
          "legacyScreen": true,
          "params": ["quoteId={{teklif.rows[0].id}}"],
          "disabledWhen": "teklif.rows[0].id != liste.seciliSatir.id",
          "disabledReason": "Önce bir kayıt seçin" } },
      { "id": "teklifPenceresi", "type": "dialog", "name": "teklifPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "Satış teklifi · {{teklif.rows[0].code}}",
          "contains": ["teklifBasligi", "teklifRozetleri", "teklifIslemleri", "teklifSekmeleri"] } },
      { "id": "teklifBasligi", "type": "recordHeader", "name": "teklifBasligi",
        "props": {
          "icon": "file-text",
          "title": "{{teklif.rows[0].code}} · Revizyon {{teklif.rows[0].revisionNumber}}",
          "subtitle": "{{teklif.rows[0].customerName}} · {{teklif.rows[0].quoteDate}} · geçerlilik {{teklif.rows[0].validUntil}}",
          "fields": ["Genel toplam={{teklif.rows[0].grandTotal}}", "Ara toplam={{teklif.rows[0].subtotal}}", "İskonto={{teklif.rows[0].discountTotal}}", "KDV={{teklif.rows[0].taxTotal}}", "Plasiyer={{teklif.rows[0].salespersonName}}", "Sipariş={{teklif.rows[0].salesOrderCode}}"],
          "fieldFormats": ["Genel toplam=money", "Ara toplam=money", "İskonto=money", "KDV=money"],
          "fieldUnits": ["Genel toplam={{teklif.rows[0].currencyCode}}", "Ara toplam={{teklif.rows[0].currencyCode}}", "İskonto={{teklif.rows[0].currencyCode}}", "KDV={{teklif.rows[0].currencyCode}}"] } },
      { "id": "teklifRozetleri", "type": "section", "name": "teklifRozetleri",
        "props": {
          "width": 12 },
        "children": [
          { "id": "rozetTaslak", "type": "badge", "name": "rozetTaslak",
            "props": {
              "text": "Taslak",
              "variant": "info",
              "visibleWhen": "teklif.rows[0].status == 'Draft'" } },
          { "id": "rozetIletildi", "type": "badge", "name": "rozetIletildi",
            "props": {
              "text": "İletildi",
              "variant": "warning",
              "visibleWhen": "teklif.rows[0].status == 'Sent'" } },
