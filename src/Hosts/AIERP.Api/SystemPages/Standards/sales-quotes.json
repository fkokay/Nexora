{
 "screenKey": "sales-quotes",
 "title": "Satış Teklifleri",
 "description": "Müşteri taleplerini iskonto ve KDV hesaplarıyla teklif taslağına dönüştürün.",
 "module": "Satış & cari",
 "version": 2,
 "stage": "preview",
 "items": {
  "component:komutlar": {
   "since": 1,
   "label": "İşlem çubuğu (Yeni ve Aç teklif belgesini açar)",
   "requires": [
    "component:suzgec",
    "component:liste",
    "component:acDugmesi",
    "query:teklifler",
    "query:teklifSil"
   ]
  },
  "component:tutarGostergesi": {
   "since": 1,
   "label": "Teklif tutarı göstergesi (bu sayfa)",
   "requires": [
    "query:teklifler"
   ]
  },
  "component:tutarKarisik": {
   "since": 1,
   "label": "Teklif tutarı (birden çok para birimi)",
   "requires": [
    "query:teklifler"
   ]
  },
  "component:yanitGostergesi": {
   "since": 1,
   "label": "Yanıt bekleyen göstergesi",
   "requires": [
    "component:suzgec",
    "query:teklifler"
   ]
  },
  "component:suzgec": {
   "since": 1,
   "label": "Süzgeç alanı (arama, durum)",
   "requires": [
    "component:liste"
   ]
  },
  "component:baslangicTarihi": {
   "since": 1,
   "label": "Başlangıç tarihi"
  },
  "component:bitisTarihi": {
   "since": 1,
   "label": "Bitiş tarihi"
  },
  "component:tarihKarti": {
   "since": 1,
   "label": "Tarih süzgeci",
   "requires": [
    "component:baslangicTarihi",
    "component:bitisTarihi"
   ]
  },
  "component:liste": {
   "since": 1,
   "label": "Satış teklifleri listesi",
   "requires": [
    "component:acDugmesi",
    "query:teklifler"
   ]
  },
  "component:acDugmesi": {
   "since": 1,
   "label": "Teklifi belgede aç",
   "requires": [
    "component:liste"
   ]
  },
  "component:kabulDugmesi": {
   "since": 1,
   "label": "Kabul et (satır eylemi)",
   "requires": [
    "component:liste",
    "query:kabulEt"
   ]
  },
  "component:reddetDugmesi": {
   "since": 1,
   "label": "Reddet (satır eylemi)",
   "requires": [
    "component:liste",
    "query:reddet"
   ]
  },
  "component:siparisDugmesi": {
   "since": 1,
   "label": "Siparişe çevir (satır eylemi)",
   "requires": [
    "component:liste",
    "query:siparisOlustur"
   ]
  },
  "component:siparisAcDugmesi": {
   "since": 1,
   "label": "Siparişi aç (satır eylemi)",
   "requires": [
    "component:liste"
   ]
  },
  "query:teklifler": {
   "since": 1,
   "label": "Satış tekliflerini listele",
   "requires": [
    "component:liste",
    "component:suzgec"
   ]
  },
  "query:kabulEt": {
   "since": 1,
   "label": "Teklifi kabul et",
   "requires": [
    "component:liste"
   ]
  },
  "query:reddet": {
   "since": 1,
   "label": "Teklifi reddet",
   "requires": [
    "component:liste"
   ]
  },
  "query:siparisOlustur": {
   "since": 1,
   "label": "Tekliften sipariş oluştur",
   "requires": [
    "component:liste"
   ]
  },
  "query:teklifSil": {
   "since": 1,
   "label": "Teklifi sil",
   "requires": [
    "component:liste"
   ]
  }
 },
 "screenViews": [
  {
   "key": "sales-quotes",
   "component": "liste",
   "fields": {
    "code": "code",
    "customerName": "customerName",
    "salesperson": "salespersonName",
    "salesOrderCode": "salesOrderCode",
    "quoteDate": "quoteDate",
    "validUntil": "validUntil",
    "lineCount": "lineCount",
    "grandTotal": "grandTotal",
    "status": "status"
   }
  }
 ],
 "definition": {
  "schemaVersion": 2,
  "template": {
   "name": "list"
  },
  "components": [
   {
    "id": "komutlar",
    "type": "actionBar",
    "name": "komutlar",
    "props": {
     "focusInput": "suzgec",
     "exportTable": "liste",
     "titleCount": "{{teklifler.meta.totalCount}}",
     "deleteQuery": "teklifSil",
     "deleteConfirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.customerName}} teklifi silinsin mi?",
     "newAction": "page",
     "newPageCode": "@sales-quote-document",
     "newTarget": "newTab",
     "openAction": "page",
     "openPageCode": "@sales-quote-document",
     "openTarget": "newTab",
     "openTable": "liste",
     "openParams": [
      "id={{liste.seciliSatir.id}}"
     ],
     "commandWhen": [
      "delete=kullanici.rol == 'TenantAdmin' && liste.seciliSatir.status == 'Draft' && liste.seciliSatir.hasSalesOrder != true"
     ],
     "hiddenCommands": [
      "save",
      "print"
     ],
     "slot": "commands"
    }
   },
   {
    "id": "tutarGostergesi",
    "type": "metric",
    "name": "tutarGostergesi",
    "props": {
     "title": "Teklif tutarı",
     "value": "{{teklifler.meta.pageGrandTotal}}",
     "format": "money",
     "icon": "wallet",
     "description": "bu sayfa · tüm durumlar · {{teklifler.meta.pageCurrencyCode}}",
     "visibleWhen": "teklifler.meta.pageMixedCurrencies != true",
     "slot": "indicators"
    }
   },
   {
    "id": "tutarKarisik",
    "type": "metric",
    "name": "tutarKarisik",
    "props": {
     "title": "Teklif tutarı",
     "value": "—",
     "icon": "wallet",
     "description": "bu sayfa · tüm durumlar · birden çok para birimi",
     "visibleWhen": "teklifler.meta.pageMixedCurrencies == true",
     "slot": "indicators"
    }
   },
   {
    "id": "yanitGostergesi",
    "type": "metric",
    "name": "yanitGostergesi",
    "props": {
     "title": "Yanıt bekleyen",
     "query": "teklifler",
     "countWhen": "teklifler.satir.status == 'Sent'",
     "format": "number",
     "icon": "hourglass",
     "variant": "warning",
     "description": "bu sayfa · tıklayınca İletildi süzülür",
     "filterInput": "suzgec.status",
     "filterValue": "Sent",
     "slot": "indicators"
    }
   },
   {
    "id": "suzgec",
    "type": "filterBar",
    "name": "suzgec",
    "props": {
     "table": "liste",
     "search": true,
     "searchPlaceholder": "Teklif no veya müşteriyle ara",
     "searchParam": "q",
     "filters": [
      "status|select|row|status|Durum"
     ],
     "slot": "filters"
    }
   },
   {
    "id": "baslangicTarihi",
    "type": "input",
    "name": "baslangicTarihi",
    "props": {
     "inputType": "date",
     "label": "Başlangıç",
     "slot": "above"
    }
   },
   {
    "id": "bitisTarihi",
    "type": "input",
    "name": "bitisTarihi",
    "props": {
     "inputType": "date",
     "label": "Bitiş",
     "slot": "above"
    }
   },
   {
    "id": "tarihKarti",
    "type": "formCard",
    "name": "tarihKarti",
    "props": {
     "title": "Tarih",
     "layout": "inline",
     "inputs": [
      "baslangicTarihi",
      "bitisTarihi"
     ],
     "slot": "above"
    }
   },
   {
    "id": "liste",
    "type": "dataTable",
    "name": "liste",
    "props": {
     "title": "Satış teklifleri",
     "query": "teklifler",
     "paging": "server",
     "pageSize": 25,
     "columns": [
      "code",
      "revisionNumber",
      "customerName",
      "salespersonName",
      "salesOrderCode",
      "quoteDate",
      "validUntil",
      "lineCount",
      "grandTotal",
      "status"
     ],
     "columnLabels": [
      "code=Teklif no",
      "revisionNumber=Rev.",
      "customerName=Müşteri",
      "salespersonName=Plasiyer",
      "salesOrderCode=Sipariş no",
      "quoteDate=Teklif tarihi",
      "validUntil=Geçerlilik",
      "lineCount=Satır",
      "grandTotal=Genel toplam",
      "status=Durum",
      "customerCode=Cari kodu",
      "currencyCode=Döviz",
      "createdAt=Oluşturulma"
     ],
     "columnFormats": [
      "code=code",
      "revisionNumber=number",
      "quoteDate=date",
      "validUntil=date",
      "lineCount=number",
      "grandTotal=money",
      "status=status",
      "createdAt=date"
     ],
     "columnUnits": [
      "grandTotal=currencyCode",
      "customerName=customerCode"
     ],
     "valueLabels": [
      "status:Draft=Taslak",
      "status:Sent=İletildi",
      "status:Accepted=Kabul edildi",
      "status:Rejected=Reddedildi",
      "status:Expired=Süresi doldu",
      "customerName:Teklif alıcısı=Kayıtsız alıcı"
     ],
     "toneMap": [
      "Taslak=info",
      "İletildi=warning",
      "Kabul edildi=success",
      "Reddedildi=danger",
      "Süresi doldu=info"
     ],
     "openParam": "quoteId",
     "emptyText": "Aramanızla eşleşen teklif yok.",
     "rowOpenAction": "acDugmesi",
     "rowActions": [
      "kabulDugmesi",
      "reddetDugmesi",
      "siparisDugmesi",
      "siparisAcDugmesi"
     ],
     "slot": "list"
    }
   },
   {
    "id": "acDugmesi",
    "type": "button",
    "name": "acDugmesi",
    "props": {
     "text": "Aç",
     "icon": "open",
     "actionType": "page",
     "pageCode": "@sales-quote-document",
     "target": "newTab",
     "params": [
      "id={{liste.seciliSatir.id}}"
     ],
     "visibleWhen": "liste.seciliSatir.id != null",
     "slot": "rowActions"
    }
   },
   {
    "id": "kabulDugmesi",
    "type": "button",
    "name": "kabulDugmesi",
    "props": {
     "text": "Kabul et",
     "actionType": "query",
     "queryId": "kabulEt",
     "confirmEnabled": true,
     "confirmText": "“{{liste.seciliSatir.code}}” kabul edilsin mi? Kayıtsız alıcılı teklifte alıcı için cari kartı açılır.",
     "visibleWhen": "liste.seciliSatir.status == 'Sent' || liste.seciliSatir.status == 'Rejected'",
     "successMessage": "Teklif kabul edildi.",
     "refreshQueries": [
      "teklifler"
     ],
     "slot": "rowActions"
    }
   },
   {
    "id": "reddetDugmesi",
    "type": "button",
    "name": "reddetDugmesi",
    "props": {
     "text": "Reddet",
     "actionType": "query",
     "queryId": "reddet",
     "confirmEnabled": true,
     "confirmText": "“{{liste.seciliSatir.code}}” reddedilsin mi?",
     "visibleWhen": "liste.seciliSatir.status == 'Sent'",
     "successMessage": "Teklif reddedildi.",
     "refreshQueries": [
      "teklifler"
     ],
     "slot": "rowActions"
    }
   },
   {
    "id": "siparisDugmesi",
    "type": "button",
    "name": "siparisDugmesi",
    "props": {
     "text": "Siparişe çevir",
     "actionType": "query",
     "queryId": "siparisOlustur",
     "confirmEnabled": true,
     "confirmText": "“{{liste.seciliSatir.code}}” tekliften satış siparişi oluşturulsun mu? İşlem geri alınamaz.",
     "visibleWhen": "liste.seciliSatir.status == 'Accepted' && liste.seciliSatir.hasSalesOrder != true",
     "successMessage": "Satış siparişi oluşturuldu; satırdaki Siparişi aç ile açabilirsiniz.",
     "refreshQueries": [
      "teklifler"
     ],
     "slot": "rowActions"
    }
   },
   {
    "id": "siparisAcDugmesi",
    "type": "button",
    "name": "siparisAcDugmesi",
    "props": {
     "text": "Siparişi aç",
     "actionType": "erpPage",
     "pageKey": "sales-orders",
     "target": "newTab",
     "params": [
      "orderId={{liste.seciliSatir.salesOrderId}}"
     ],
     "visibleWhen": "liste.seciliSatir.salesOrderId != null",
     "slot": "rowActions"
    }
   }
  ],
  "queries": [
   {
    "id": "teklifler",
    "name": "teklifler",
    "kind": "read",
    "operation": "satis.teklif.listele",
    "runOn": "load",
    "parameters": [
     {
      "name": "q",
      "binding": "{{suzgec.q}}",
      "type": "text"
     },
     {
      "name": "status",
      "binding": "{{suzgec.status}}",
      "type": "text"
     },
     {
      "name": "dateFrom",
      "binding": "{{baslangicTarihi.value}}",
      "type": "date"
     },
     {
      "name": "dateTo",
      "binding": "{{bitisTarihi.value}}",
      "type": "date"
     },
     {
      "name": "page",
      "binding": "{{liste.sayfa}}",
      "type": "int"
     },
     {
      "name": "pageSize",
      "binding": "{{liste.sayfaBoyutu}}",
      "type": "int"
     }
    ]
   },
   {
    "id": "kabulEt",
    "name": "kabulEt",
    "kind": "update",
    "operation": "satis.teklif.kabulEt",
    "runOn": "manual",
    "parameters": [
     {
      "name": "id",
      "binding": "{{liste.seciliSatir.id}}",
      "type": "guid"
     }
    ]
   },
   {
    "id": "reddet",
    "name": "reddet",
    "kind": "update",
    "operation": "satis.teklif.reddet",
    "runOn": "manual",
    "parameters": [
     {
      "name": "id",
      "binding": "{{liste.seciliSatir.id}}",
      "type": "guid"
     }
    ]
   },
   {
    "id": "siparisOlustur",
    "name": "siparisOlustur",
    "kind": "insert",
    "operation": "satis.teklif.siparisOlustur",
    "runOn": "manual",
    "parameters": [
     {
      "name": "id",
      "binding": "{{liste.seciliSatir.id}}",
      "type": "guid"
     }
    ]
   },
   {
    "id": "teklifSil",
    "name": "teklifSil",
    "kind": "delete",
    "operation": "satis.teklif.sil",
    "runOn": "manual",
    "parameters": [
     {
      "name": "id",
      "binding": "{{liste.seciliSatir.id}}",
      "type": "guid"
     }
    ]
   }
  ]
 }
}
