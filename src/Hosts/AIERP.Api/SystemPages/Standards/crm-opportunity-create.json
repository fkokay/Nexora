{
  "screenKey": "crm-opportunity-create", "title": "Fırsat kartı",
  "description": "CRM fırsatı oluşturma ve düzenleme: fırsat, müşteri, tahmini tutar, kapanış ve sonraki takip.", "module": "Satış & cari",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["query:kart", "query:olustur", "query:guncelle"]},
    "component:yeniBaslik": {"since": 1, "label": "Başlık (yeni fırsat)", "requires": ["query:kart"]},
    "component:kartBasligi": {"since": 1, "label": "Başlık (kayıtlı fırsat)", "requires": ["query:kart"]},
    "component:kartOzeti": {"since": 1, "label": "Kayıtlı fırsatın özeti", "requires": ["query:kart"]},
    "component:kartKodu": {"since": 1, "label": "Kayıtlı fırsatın kodu (müşterisiz)", "requires": ["query:kart"]},
    "component:asamaIlkTemas": {"since": 1, "label": "Aşama etiketi: İlk temas", "requires": ["query:kart"]},
    "component:asamaNitelikli": {"since": 1, "label": "Aşama etiketi: Nitelikli", "requires": ["query:kart"]},
    "component:asamaTeklif": {"since": 1, "label": "Aşama etiketi: Teklif", "requires": ["query:kart"]},
    "component:asamaMuzakere": {"since": 1, "label": "Aşama etiketi: Müzakere", "requires": ["query:kart"]},
    "component:asamaKazanildi": {"since": 1, "label": "Aşama etiketi: Kazanıldı", "requires": ["query:kart"]},
    "component:asamaKaybedildi": {"since": 1, "label": "Aşama etiketi: Kaybedildi", "requires": ["query:kart"]},
    "component:kapaliUyarisi": {"since": 1, "label": "Kapanmış fırsat uyarısı", "requires": ["query:kart"]},
    "component:zorunluNotu": {"since": 1, "label": "Zorunlu alanlar notu"},
    "component:firsatKarti": {"since": 1, "label": "Kart bölümü: Fırsat", "requires": ["component:ad", "component:kod", "component:musteri", "query:kart"]},
    "component:ad": {"since": 1, "label": "Alan: Fırsat adı", "requires": ["query:kart"]},
    "component:kod": {"since": 1, "label": "Alan: Fırsat kodu", "requires": ["query:kart"]},
    "component:musteri": {"since": 1, "label": "Alan: Müşteri", "requires": ["query:kart", "query:musteriler"]},
    "component:musteriTuru": {"since": 1, "label": "Müşteri seçici: cari türü (gizli)"},
    "component:musteriDurumu": {"since": 1, "label": "Müşteri seçici: durum (gizli)"},
    "component:tahminKarti": {"since": 1, "label": "Kart bölümü: Tahmin ve takip", "requires": ["component:tutar", "component:dovizYeni", "component:doviz", "component:kapanis", "component:takip", "component:olasilikYeni", "component:olasilik", "query:kart"]},
    "component:tutar": {"since": 1, "label": "Alan: Tahmini tutar", "requires": ["query:kart"]},
    "component:dovizYeni": {"since": 1, "label": "Alan: Para birimi (yeni fırsat)", "requires": ["query:kart"]},
    "component:doviz": {"since": 1, "label": "Alan: Para birimi (kayıtlı fırsat)", "requires": ["query:kart"]},
    "component:kapanis": {"since": 1, "label": "Alan: Beklenen kapanış", "requires": ["query:kart"]},
    "component:takip": {"since": 1, "label": "Alan: Sonraki takip", "requires": ["query:kart"]},
    "component:olasilikYeni": {"since": 1, "label": "Alan: Kazanma olasılığı (yeni fırsat)", "requires": ["query:kart"]},
    "component:olasilik": {"since": 1, "label": "Alan: Kazanma olasılığı (kayıtlı fırsat)", "requires": ["query:kart"]},
    "component:olasilik10": {"since": 1, "label": "Olasılık hazır değeri %10", "requires": ["component:olasilikYeni", "component:olasilik"]},
    "component:olasilik25": {"since": 1, "label": "Olasılık hazır değeri %25", "requires": ["component:olasilikYeni", "component:olasilik"]},
    "component:olasilik50": {"since": 1, "label": "Olasılık hazır değeri %50", "requires": ["component:olasilikYeni", "component:olasilik"]},
    "component:olasilik75": {"since": 1, "label": "Olasılık hazır değeri %75", "requires": ["component:olasilikYeni", "component:olasilik"]},
    "component:olasilik90": {"since": 1, "label": "Olasılık hazır değeri %90", "requires": ["component:olasilikYeni", "component:olasilik"]},
    "component:olasilikNotu": {"since": 1, "label": "Olasılık notu"},
    "component:notKarti": {"since": 1, "label": "Kart bölümü: Not", "requires": ["component:not", "query:kart"]},
    "component:not": {"since": 1, "label": "Alan: Not", "requires": ["query:kart"]},
    "component:ipucu": {"since": 1, "label": "Planlama ipucu"},
    "query:kart": {"since": 1, "label": "Açılan fırsat"},
    "query:musteriler": {"since": 1, "label": "Müşteri seçenekleri", "requires": ["component:musteri", "component:musteriTuru", "component:musteriDurumu"]},
    "query:olustur": {"since": 1, "label": "CRM fırsatı oluştur", "requires": ["component:ad", "component:kod", "component:musteri", "component:tutar", "component:dovizYeni", "component:kapanis", "component:takip", "component:olasilikYeni", "component:not"]},
    "query:guncelle": {"since": 1, "label": "CRM fırsatı güncelle", "requires": ["component:ad", "component:kod", "component:musteri", "component:tutar", "component:doviz", "component:kapanis", "component:takip", "component:olasilik", "component:not", "query:kart"]}
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "saveSequence": ["olustur", "guncelle"], "stopOnError": true,
                   "sequenceWhen": ["olustur=kart.rows[0].id == null && olustur.sonuc.id == null", "guncelle=kart.rows[0].id != null"],
                   "newAction": "page", "newPageCode": "@crm-opportunity-create", "newTarget": "sameTab",
                   "saveAndNew": true,
                   "commandWhen": ["saveNew=kart.rows[0].id == null", "save=kart.rows[0].stage != 'Won' && kart.rows[0].stage != 'Lost'"],
                   "afterSaveAction": "page", "afterSavePageCode": "@crm-opportunities", "afterSaveTarget": "sameTab", "afterSaveRefresh": true,
                   "hiddenCommands": ["open", "delete", "filter", "print", "export"] } },
      { "id": "yeniBaslik", "type": "heading", "name": "yeniBaslik",
        "props": { "text": "Yeni fırsat", "pageTitle": true, "visibleWhen": "kart.rows[0].id == null" } },
      { "id": "kartBasligi", "type": "heading", "name": "kartBasligi",
        "props": { "text": "{{kart.rows[0].name}}", "pageTitle": true, "visibleWhen": "kart.rows[0].id != null" } },
      { "id": "kartOzeti", "type": "text", "name": "kartOzeti",
        "props": { "text": "{{kart.rows[0].code}} · {{kart.rows[0].customerName}}",
                   "visibleWhen": "kart.rows[0].id != null && kart.rows[0].customerId != null" } },
      { "id": "kartKodu", "type": "text", "name": "kartKodu",
        "props": { "text": "{{kart.rows[0].code}} · Müşteri bağlanmadı",
                   "visibleWhen": "kart.rows[0].id != null && kart.rows[0].customerId == null" } },
      { "id": "asamaIlkTemas", "type": "badge", "name": "asamaIlkTemas",
        "props": { "text": "İlk temas", "variant": "info", "visibleWhen": "kart.rows[0].stage == 'Prospecting'" } },
      { "id": "asamaNitelikli", "type": "badge", "name": "asamaNitelikli",
        "props": { "text": "Nitelikli", "variant": "info", "visibleWhen": "kart.rows[0].stage == 'Qualified'" } },
      { "id": "asamaTeklif", "type": "badge", "name": "asamaTeklif",
        "props": { "text": "Teklif", "variant": "warning", "visibleWhen": "kart.rows[0].stage == 'Proposal'" } },
      { "id": "asamaMuzakere", "type": "badge", "name": "asamaMuzakere",
        "props": { "text": "Müzakere", "variant": "warning", "visibleWhen": "kart.rows[0].stage == 'Negotiation'" } },
      { "id": "asamaKazanildi", "type": "badge", "name": "asamaKazanildi",
        "props": { "text": "Kazanıldı", "variant": "success", "visibleWhen": "kart.rows[0].stage == 'Won'" } },
      { "id": "asamaKaybedildi", "type": "badge", "name": "asamaKaybedildi",
        "props": { "text": "Kaybedildi", "variant": "info", "visibleWhen": "kart.rows[0].stage == 'Lost'" } },
      { "id": "kapaliUyarisi", "type": "alert", "name": "kapaliUyarisi",
        "props": { "title": "Kapanmış fırsat düzenlenemez", "variant": "warning", "width": 12,
                   "text": "Kazanılan veya kaybedilen fırsat güncellenemez; kaydetme kapalıdır.",
                   "visibleWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'" } },
      { "id": "zorunluNotu", "type": "text", "name": "zorunluNotu",
        "props": { "text": "* işaretli alanlar zorunludur: fırsat adı, fırsat kodu ve para birimi." } },

      { "id": "firsatKarti", "type": "formCard", "name": "firsatKarti",
        "props": { "title": "Fırsat", "columns": 2, "inputs": ["ad", "kod", "musteri"],
                   "recordKey": "{{kart.rows[0].id}}", "trackChanges": true } },
      { "id": "ad", "type": "input", "name": "ad",
        "props": { "inputType": "text", "label": "Fırsat adı", "required": true, "maxLength": 160, "defaultValue": "{{kart.rows[0].name}}" } },
      { "id": "kod", "type": "input", "name": "kod",
        "props": { "inputType": "text", "label": "Fırsat kodu", "required": true, "maxLength": 40, "upperCase": true, "placeholder": "FRS-2026-001",
                   "pattern": "^[A-Z][A-Z0-9_-]*$", "patternMessage": "Kod büyük harfle başlamalı; harf, rakam, tire veya alt çizgi içermelidir.",
                   "defaultValue": "{{kart.rows[0].code}}" } },
      { "id": "musteri", "type": "input", "name": "musteri",
        "props": { "inputType": "lookup", "label": "Müşteri", "optionsQuery": "musteriler", "optionValueColumn": "id", "optionLabelColumn": "name",
                   "optionDescriptionColumn": "code", "minChars": 0, "allowClear": true, "placeholder": "Müşteri bağlanmadı",
                   "defaultValue": "{{kart.rows[0].customerId}}" } },
      { "id": "musteriTuru", "type": "input", "name": "musteriTuru",
        "props": { "inputType": "text", "label": "Müşteri seçici cari türü", "hidden": true, "defaultValue": "Customer,Both" } },
      { "id": "musteriDurumu", "type": "input", "name": "musteriDurumu",
        "props": { "inputType": "text", "label": "Müşteri seçici durumu", "hidden": true, "defaultValue": "Active" } },

      { "id": "tahminKarti", "type": "formCard", "name": "tahminKarti",
        "props": { "title": "Tahmin ve takip", "columns": 3, "inputs": ["tutar", "dovizYeni", "doviz", "kapanis", "takip", "olasilikYeni", "olasilik"],
                   "recordKey": "{{kart.rows[0].id}}", "trackChanges": true } },
      { "id": "tutar", "type": "input", "name": "tutar",
        "props": { "inputType": "number", "label": "Tahmini tutar", "min": 0, "step": 0.01, "placeholder": "Belirtilmedi",
                   "defaultValue": "{{kart.rows[0].estimatedValue}}" } },
      { "id": "dovizYeni", "type": "input", "name": "dovizYeni",
        "props": { "inputType": "text", "label": "Para birimi", "requiredWhen": "kart.rows[0].id == null", "maxLength": 3, "upperCase": true,
                   "pattern": "^[A-Z]{3}$", "patternMessage": "Üç harfli para birimi kodu girin (ör. TRY).", "placeholder": "TRY",
                   "defaultValue": "TRY", "visibleWhen": "kart.rows[0].id == null" } },
      { "id": "doviz", "type": "input", "name": "doviz",
        "props": { "inputType": "text", "label": "Para birimi", "requiredWhen": "kart.rows[0].id != null", "maxLength": 3, "upperCase": true,
                   "pattern": "^[A-Z]{3}$", "patternMessage": "Üç harfli para birimi kodu girin (ör. TRY).", "placeholder": "TRY",
                   "defaultValue": "{{kart.rows[0].currencyCode}}", "visibleWhen": "kart.rows[0].id != null" } },
      { "id": "kapanis", "type": "input", "name": "kapanis",
        "props": { "inputType": "date", "label": "Beklenen kapanış", "defaultValue": "{{kart.rows[0].expectedCloseDate}}" } },
      { "id": "takip", "type": "input", "name": "takip",
        "props": { "inputType": "datetime", "label": "Sonraki takip", "defaultValue": "{{kart.rows[0].nextActivityAt}}" } },
      { "id": "olasilikYeni", "type": "input", "name": "olasilikYeni",
        "props": { "inputType": "number", "label": "Kazanma olasılığı (%)", "requiredWhen": "kart.rows[0].id == null", "min": 0, "max": 99, "step": 1,
                   "defaultValue": "10", "visibleWhen": "kart.rows[0].id == null" } },
      { "id": "olasilik", "type": "input", "name": "olasilik",
        "props": { "inputType": "number", "label": "Kazanma olasılığı (%)", "requiredWhen": "kart.rows[0].id != null", "min": 0, "max": 99, "step": 1,
                   "defaultValue": "{{kart.rows[0].probabilityPercent}}", "visibleWhen": "kart.rows[0].id != null" } },
      { "id": "olasilik10", "type": "button", "name": "olasilik10",
        "props": { "text": "%10", "actionType": "setInput", "width": 1, "assignments": ["olasilikYeni=10", "olasilik=10"] } },
      { "id": "olasilik25", "type": "button", "name": "olasilik25",
        "props": { "text": "%25", "actionType": "setInput", "width": 1, "assignments": ["olasilikYeni=25", "olasilik=25"] } },
      { "id": "olasilik50", "type": "button", "name": "olasilik50",
        "props": { "text": "%50", "actionType": "setInput", "width": 1, "assignments": ["olasilikYeni=50", "olasilik=50"] } },
      { "id": "olasilik75", "type": "button", "name": "olasilik75",
        "props": { "text": "%75", "actionType": "setInput", "width": 1, "assignments": ["olasilikYeni=75", "olasilik=75"] } },
      { "id": "olasilik90", "type": "button", "name": "olasilik90",
        "props": { "text": "%90", "actionType": "setInput", "width": 1, "assignments": ["olasilikYeni=90", "olasilik=90"] } },
      { "id": "olasilikNotu", "type": "text", "name": "olasilikNotu",
        "props": { "text": "Ya da 0–99 arası değer yazın.", "width": 7 } },

      { "id": "notKarti", "type": "formCard", "name": "notKarti",
        "props": { "title": "Not", "columns": 1, "inputs": ["not"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true } },
      { "id": "not", "type": "input", "name": "not",
        "props": { "inputType": "text", "label": "Not", "maxLength": 2000, "placeholder": "Görüşme özeti veya sonraki adım",
                   "defaultValue": "{{kart.rows[0].notes}}" } },
      { "id": "ipucu", "type": "text", "name": "ipucu",
        "props": { "text": "Fırsatı müşteri carisine bağlayın; kapanış ve sonraki takip tarihini planlayın." } }
    ],
    "queries": [
      { "id": "kart", "name": "kart", "kind": "read", "operation": "crm.firsat.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{sayfa.parametre.opportunityId}}", "type": "guid" } ] },
      { "id": "musteriler", "name": "musteriler", "kind": "read", "operation": "cari.listele", "runOn": "load",
        "parameters": [
          { "name": "q", "binding": "{{musteri.search}}", "type": "text" },
          { "name": "type", "binding": "{{musteriTuru.value}}", "type": "text" },
          { "name": "status", "binding": "{{musteriDurumu.value}}", "type": "text" } ] },
      { "id": "olustur", "name": "olustur", "kind": "insert", "operation": "crm.firsat.olustur", "runOn": "manual",
        "parameters": [
          { "name": "code", "binding": "{{kod.value}}", "type": "text" },
          { "name": "name", "binding": "{{ad.value}}", "type": "text" },
          { "name": "customerId", "binding": "{{musteri.value}}", "type": "guid" },
          { "name": "estimatedValue", "binding": "{{tutar.value}}", "type": "decimal" },
          { "name": "currencyCode", "binding": "{{dovizYeni.value}}", "type": "text" },
          { "name": "probabilityPercent", "binding": "{{olasilikYeni.value}}", "type": "int" },
          { "name": "expectedCloseDate", "binding": "{{kapanis.value}}", "type": "date" },
          { "name": "nextActivityAt", "binding": "{{takip.value}}", "type": "datetime" },
          { "name": "notes", "binding": "{{not.value}}", "type": "text" } ] },
      { "id": "guncelle", "name": "guncelle", "kind": "update", "operation": "crm.firsat.guncelle", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid" },
          { "name": "code", "binding": "{{kod.value}}", "type": "text" },
          { "name": "name", "binding": "{{ad.value}}", "type": "text" },
          { "name": "customerId", "binding": "{{musteri.value}}", "type": "guid" },
          { "name": "estimatedValue", "binding": "{{tutar.value}}", "type": "decimal" },
          { "name": "currencyCode", "binding": "{{doviz.value}}", "type": "text" },
          { "name": "probabilityPercent", "binding": "{{olasilik.value}}", "type": "int" },
          { "name": "expectedCloseDate", "binding": "{{kapanis.value}}", "type": "date" },
          { "name": "nextActivityAt", "binding": "{{takip.value}}", "type": "datetime" },
          { "name": "notes", "binding": "{{not.value}}", "type": "text" } ] }
    ]
  }
}
