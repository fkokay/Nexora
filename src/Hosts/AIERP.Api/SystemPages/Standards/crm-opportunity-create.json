{
  "screenKey": "crm-opportunity-create", "title": "Fırsat kartı", "description": "CRM fırsatı oluşturma ve düzenleme: fırsat, müşteri, tahmini tutar, kapanış ve sonraki takip.", "module": "Satış & cari", "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["query:kart", "query:olustur", "query:guncelle"]},
    "component:kartOzeti": {"since": 1, "label": "Kayıt özeti (ad, kod, müşteri, tutar, olasılık)", "requires": ["query:kart"]},
    "component:yeniBaslik": {"since": 1, "label": "Başlık (yeni fırsat)", "requires": ["query:kart"]},
    "component:kartBasligi": {"since": 1, "label": "Başlık (kayıtlı fırsat)", "requires": ["query:kart"]},
    "component:asamaIlkTemas": {"since": 1, "label": "Aşama etiketi: İlk temas", "requires": ["query:kart"]},
    "component:asamaNitelikli": {"since": 1, "label": "Aşama etiketi: Nitelikli", "requires": ["query:kart"]},
    "component:asamaTeklif": {"since": 1, "label": "Aşama etiketi: Teklif", "requires": ["query:kart"]},
    "component:asamaMuzakere": {"since": 1, "label": "Aşama etiketi: Müzakere", "requires": ["query:kart"]},
    "component:asamaKazanildi": {"since": 1, "label": "Aşama etiketi: Kazanıldı", "requires": ["query:kart"]},
    "component:asamaKaybedildi": {"since": 1, "label": "Aşama etiketi: Kaybedildi", "requires": ["query:kart"]},
    "component:kapaliUyarisi": {"since": 1, "label": "Kapanmış fırsat uyarısı", "requires": ["query:kart"]},
    "component:musteriTuru": {"since": 1, "label": "Müşteri seçici: cari türü (gizli)"},
    "component:musteriDurumu": {"since": 1, "label": "Müşteri seçici: durum (gizli)"},
    "component:sekmeler": {"since": 1, "label": "Sekmeler (Fırsat, Tahmin ve takip, Not)", "requires": ["component:firsatKarti", "component:tahminKarti", "component:notKarti", "component:zorunluNotu", "component:ipucu"]},
    "component:firsatKarti": {"since": 1, "label": "Kart bölümü: Fırsat", "requires": ["component:ad", "component:kod", "component:musteri", "query:kart"]},
    "component:tahminKarti": {"since": 1, "label": "Kart bölümü: Tahmin ve takip", "requires": ["component:tutar", "component:doviz", "component:kapanis", "component:takip", "component:olasilik", "query:kart"]},
    "component:notKarti": {"since": 1, "label": "Kart bölümü: Not", "requires": ["component:not", "query:kart"]},
    "component:ad": {"since": 1, "label": "Alan: Fırsat adı", "requires": ["query:kart"]},
    "component:kod": {"since": 1, "label": "Alan: Fırsat kodu", "requires": ["query:kart"]},
    "component:musteri": {"since": 1, "label": "Alan: Müşteri", "requires": ["query:kart", "query:musteriler"]},
    "component:tutar": {"since": 1, "label": "Alan: Tahmini tutar", "requires": ["query:kart"]},
    "component:doviz": {"since": 1, "label": "Alan: Para birimi", "requires": ["query:kart"]},
    "component:kapanis": {"since": 1, "label": "Alan: Beklenen kapanış", "requires": ["query:kart"]},
    "component:takip": {"since": 1, "label": "Alan: Sonraki takip", "requires": ["query:kart"]},
    "component:olasilik": {"since": 1, "label": "Alan: Kazanma olasılığı", "requires": ["query:kart"]},
    "component:not": {"since": 1, "label": "Alan: Not", "requires": ["query:kart"]},
    "component:zorunluNotu": {"since": 1, "label": "Zorunlu alanlar notu"},
    "component:ipucu": {"since": 1, "label": "Planlama ipucu"},
    "query:kart": {"since": 1, "label": "Açılan fırsat"},
    "query:musteriler": {"since": 1, "label": "Müşteri seçenekleri", "requires": ["component:musteri", "component:musteriTuru", "component:musteriDurumu"]},
    "query:olustur": {"since": 1, "label": "CRM fırsatı oluştur", "requires": ["component:ad", "component:kod", "component:musteri", "component:tutar", "component:doviz", "component:kapanis", "component:takip", "component:olasilik", "component:not"]},
    "query:guncelle": {"since": 1, "label": "CRM fırsatı güncelle", "requires": ["component:ad", "component:kod", "component:musteri", "component:tutar", "component:doviz", "component:kapanis", "component:takip", "component:olasilik", "component:not", "query:kart"]}
  },
  "definition": {
    "schemaVersion": 2,
    "template": {"name": "record"},
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"saveSequence": ["olustur", "guncelle"], "stopOnError": true, "sequenceWhen": ["olustur=kart.rows[0].id == null && olustur.sonuc.id == null", "guncelle=kart.rows[0].id != null"], "newAction": "page", "newPageCode": "@crm-opportunity-create", "newTarget": "sameTab", "saveAndNew": true, "commandWhen": ["saveNew=kart.rows[0].id == null", "save=kart.rows[0].stage != 'Won' && kart.rows[0].stage != 'Lost'"], "afterSaveAction": "page", "afterSavePageCode": "@crm-opportunities", "afterSaveTarget": "sameTab", "afterSaveRefresh": true, "hiddenCommands": ["open", "delete", "filter", "print", "export"], "slot": "commands"}},
      {"id": "kartOzeti", "type": "recordHeader", "name": "kartOzeti", "props": {"icon": "target", "title": "{{kart.rows[0].name}}", "subtitle": "{{kart.rows[0].customerName}}", "fields": ["Kod={{kart.rows[0].code}}", "Tahmini tutar={{kart.rows[0].estimatedValue}}", "Olasılık={{kart.rows[0].probabilityPercent}}"], "fieldFormats": ["Tahmini tutar=money", "Olasılık=number"], "fieldUnits": ["Tahmini tutar={{kart.rows[0].currencyCode}}", "Olasılık=%"], "slot": "summary"}},
      {"id": "yeniBaslik", "type": "heading", "name": "yeniBaslik", "props": {"text": "Yeni fırsat", "pageTitle": true, "visibleWhen": "kart.rows[0].id == null", "slot": "above"}},
      {"id": "kartBasligi", "type": "heading", "name": "kartBasligi", "props": {"text": "{{kart.rows[0].name}}", "pageTitle": true, "visibleWhen": "kart.rows[0].id != null", "slot": "above"}},
      {"id": "asamaIlkTemas", "type": "badge", "name": "asamaIlkTemas", "props": {"text": "İlk temas", "variant": "info", "visibleWhen": "kart.rows[0].stage == 'Prospecting'", "slot": "above"}},
      {"id": "asamaNitelikli", "type": "badge", "name": "asamaNitelikli", "props": {"text": "Nitelikli", "variant": "info", "visibleWhen": "kart.rows[0].stage == 'Qualified'", "slot": "above"}},
      {"id": "asamaTeklif", "type": "badge", "name": "asamaTeklif", "props": {"text": "Teklif", "variant": "warning", "visibleWhen": "kart.rows[0].stage == 'Proposal'", "slot": "above"}},
      {"id": "asamaMuzakere", "type": "badge", "name": "asamaMuzakere", "props": {"text": "Müzakere", "variant": "warning", "visibleWhen": "kart.rows[0].stage == 'Negotiation'", "slot": "above"}},
      {"id": "asamaKazanildi", "type": "badge", "name": "asamaKazanildi", "props": {"text": "Kazanıldı", "variant": "success", "visibleWhen": "kart.rows[0].stage == 'Won'", "slot": "above"}},
      {"id": "asamaKaybedildi", "type": "badge", "name": "asamaKaybedildi", "props": {"text": "Kaybedildi", "variant": "info", "visibleWhen": "kart.rows[0].stage == 'Lost'", "slot": "above"}},
      {"id": "kapaliUyarisi", "type": "alert", "name": "kapaliUyarisi", "props": {"title": "Kapanmış fırsat düzenlenemez", "variant": "warning", "text": "Kazanılan veya kaybedilen fırsat güncellenemez; kaydetme kapalıdır.", "visibleWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'", "slot": "above"}},
      {"id": "musteriTuru", "type": "input", "name": "musteriTuru", "props": {"inputType": "text", "label": "Müşteri seçici cari türü", "hidden": true, "defaultValue": "Customer,Both", "slot": "above"}},
      {"id": "musteriDurumu", "type": "input", "name": "musteriDurumu", "props": {"inputType": "text", "label": "Müşteri seçici durumu", "hidden": true, "defaultValue": "Active", "slot": "above"}},
      {"id": "sekmeler", "type": "tabs", "name": "sekmeler", "props": {"tabs": ["Fırsat=firsatKarti,zorunluNotu", "Tahmin ve takip=tahminKarti,ipucu", "Not=notKarti"], "slot": "tabs"}},
      {"id": "firsatKarti", "type": "formCard", "name": "firsatKarti", "props": {"title": "Fırsat", "columns": 2, "inputs": ["ad", "kod", "musteri"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "tahminKarti", "type": "formCard", "name": "tahminKarti", "props": {"title": "Tahmin ve takip", "columns": 3, "inputs": ["tutar", "doviz", "kapanis", "takip", "olasilik"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "notKarti", "type": "formCard", "name": "notKarti", "props": {"title": "Not", "columns": 1, "inputs": ["not"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "ad", "type": "input", "name": "ad", "props": {"inputType": "text", "label": "Fırsat adı", "required": true, "maxLength": 160, "defaultValue": "{{kart.rows[0].name}}", "slot": "field", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "kod", "type": "input", "name": "kod", "props": {"inputType": "text", "label": "Fırsat kodu", "requiredWhen": "kart.rows[0].id != null", "maxLength": 40, "upperCase": true, "placeholder": "Boşsa kayıtta otomatik verilir", "pattern": "^[A-Z][A-Z0-9_-]*$", "patternMessage": "Kod büyük harfle başlamalı; harf, rakam, tire veya alt çizgi içermelidir.", "defaultValue": "{{kart.rows[0].code}}", "slot": "field", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "musteri", "type": "input", "name": "musteri", "props": {"inputType": "lookup", "label": "Müşteri", "optionsQuery": "musteriler", "optionValueColumn": "id", "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "allowClear": true, "placeholder": "Müşteri bağlanmadı", "defaultValue": "{{kart.rows[0].customerId}}", "slot": "field", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "tutar", "type": "input", "name": "tutar", "props": {"inputType": "number", "label": "Tahmini tutar", "min": 0, "step": 0.01, "placeholder": "Belirtilmedi", "defaultValue": "{{kart.rows[0].estimatedValue}}", "slot": "field", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "doviz", "type": "input", "name": "doviz", "props": {"inputType": "text", "label": "Para birimi", "maxLength": 3, "upperCase": true, "pattern": "^[A-Z]{3}$", "patternMessage": "Üç harfli para birimi kodu girin (ör. TRY).", "placeholder": "TRY", "defaultValue": "{{kart.rows[0].currencyCode}}", "slot": "field", "required": true, "emptyDefault": "TRY", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "kapanis", "type": "input", "name": "kapanis", "props": {"inputType": "date", "label": "Beklenen kapanış", "defaultValue": "{{kart.rows[0].expectedCloseDate}}", "slot": "field", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "takip", "type": "input", "name": "takip", "props": {"inputType": "datetime", "label": "Sonraki takip", "defaultValue": "{{kart.rows[0].nextActivityAt}}", "slot": "field", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "olasilik", "type": "input", "name": "olasilik", "props": {"inputType": "number", "label": "Kazanma olasılığı (%)", "min": 0, "max": 99, "step": 1, "presets": ["10=%10", "25=%25", "50=%50", "75=%75", "90=%90"], "defaultValue": "{{kart.rows[0].probabilityPercent}}", "slot": "field", "required": true, "emptyDefault": "10", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "not", "type": "input", "name": "not", "props": {"inputType": "text", "multiline": true, "label": "Not", "maxLength": 2000, "placeholder": "Görüşme özeti veya sonraki adım", "defaultValue": "{{kart.rows[0].notes}}", "slot": "field", "disabledWhen": "kart.rows[0].stage == 'Won' || kart.rows[0].stage == 'Lost'"}},
      {"id": "zorunluNotu", "type": "text", "name": "zorunluNotu", "props": {"text": "* işaretli alanlar zorunludur: fırsat adı, para birimi ve olasılık. Fırsat kodu boş bırakılırsa kayıtta otomatik verilir.", "slot": "note"}},
      {"id": "ipucu", "type": "text", "name": "ipucu", "props": {"text": "Fırsatı müşteri carisine bağlayın; kapanış ve sonraki takip tarihini planlayın.", "slot": "note"}}
    ],
    "queries": [
      {"id": "kart", "name": "kart", "kind": "read", "operation": "crm.firsat.getir", "runOn": "load", "parameters": [{"name": "id", "binding": "{{sayfa.parametre.opportunityId}}", "type": "guid"}]},
      {"id": "musteriler", "name": "musteriler", "kind": "read", "operation": "cari.listele", "runOn": "load", "parameters": [{"name": "q", "binding": "{{musteri.search}}", "type": "text"}, {"name": "type", "binding": "{{musteriTuru.value}}", "type": "text"}, {"name": "status", "binding": "{{musteriDurumu.value}}", "type": "text"}]},
      {"id": "olustur", "name": "olustur", "kind": "insert", "operation": "crm.firsat.olustur", "runOn": "manual", "parameters": [{"name": "code", "binding": "{{kod.value}}", "type": "text"}, {"name": "name", "binding": "{{ad.value}}", "type": "text"}, {"name": "customerId", "binding": "{{musteri.value}}", "type": "guid"}, {"name": "estimatedValue", "binding": "{{tutar.value}}", "type": "decimal"}, {"name": "currencyCode", "binding": "{{doviz.value}}", "type": "text"}, {"name": "probabilityPercent", "binding": "{{olasilik.value}}", "type": "int"}, {"name": "expectedCloseDate", "binding": "{{kapanis.value}}", "type": "date"}, {"name": "nextActivityAt", "binding": "{{takip.value}}", "type": "datetime"}, {"name": "notes", "binding": "{{not.value}}", "type": "text"}]},
      {"id": "guncelle", "name": "guncelle", "kind": "update", "operation": "crm.firsat.guncelle", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid"}, {"name": "code", "binding": "{{kod.value}}", "type": "text"}, {"name": "name", "binding": "{{ad.value}}", "type": "text"}, {"name": "customerId", "binding": "{{musteri.value}}", "type": "guid"}, {"name": "estimatedValue", "binding": "{{tutar.value}}", "type": "decimal"}, {"name": "currencyCode", "binding": "{{doviz.value}}", "type": "text"}, {"name": "probabilityPercent", "binding": "{{olasilik.value}}", "type": "int"}, {"name": "expectedCloseDate", "binding": "{{kapanis.value}}", "type": "date"}, {"name": "nextActivityAt", "binding": "{{takip.value}}", "type": "datetime"}, {"name": "notes", "binding": "{{not.value}}", "type": "text"}]}
    ]
  }
}
