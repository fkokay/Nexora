{
  "screenKey": "finance-journal-vouchers",
  "title": "Yevmiye Fi\u015fi",
  "description": "Manuel yevmiye fi\u015fi giri\u015fi: belge bilgileri, hesap se\u00e7icili sat\u0131rlar, bor\u00e7/alacak toplam\u0131 ve denge g\u00f6stergesi.",
  "module": "Genel Muhasebe",
  "version": 2,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "\u0130\u015flem \u00e7ubu\u011fu",
      "requires": [
        "component:sonFislerDugmesi",
        "query:fisKaydet"
      ]
    },
    "component:sonFislerDugmesi": {
      "since": 1,
      "label": "Son fi\u015fler komutu"
    },
    "component:baslik": {
      "since": 1,
      "label": "Ba\u015fl\u0131k"
    },
    "component:kilitUyarisi": {
      "since": 1,
      "label": "Y\u00f6netici olmayan kullan\u0131c\u0131 kilidi"
    },
    "component:durumNotu": {
      "since": 1,
      "label": "Durum sat\u0131r\u0131",
      "requires": [
        "component:fisSatirlari"
      ]
    },
    "component:belgeKarti": {
      "since": 1,
      "label": "Belge bilgileri",
      "requires": [
        "component:fisTarihi",
        "component:standart",
        "component:aciklama"
      ]
    },
    "component:fisTarihi": {
      "since": 1,
      "label": "Alan: Fi\u015f tarihi"
    },
    "component:standart": {
      "since": 1,
      "label": "Alan: Muhasebe standard\u0131"
    },
    "component:aciklama": {
      "since": 1,
      "label": "Alan: A\u00e7\u0131klama"
    },
    "component:fisSatirlari": {
      "since": 1,
      "label": "Fi\u015f sat\u0131rlar\u0131",
      "requires": [
        "query:hesaplar"
      ]
    },
    "component:dengeliEtiketi": {
      "since": 1,
      "label": "Denge: Dengeli",
      "requires": [
        "component:fisSatirlari"
      ]
    },
    "component:dengesizEtiketi": {
      "since": 1,
      "label": "Denge: Dengede de\u011fil",
      "requires": [
        "component:fisSatirlari"
      ]
    },
    "component:satirNotu": {
      "since": 1,
      "label": "Sat\u0131r notu",
      "requires": [
        "query:hesaplar"
      ]
    },
    "query:hesaplar": {
      "since": 1,
      "label": "Muhasebe hesaplar\u0131 (hesap se\u00e7ici)"
    },
    "query:fisKaydet": {
      "since": 1,
      "label": "Yevmiye fi\u015fini kaydet",
      "requires": [
        "component:fisTarihi",
        "component:standart",
        "component:aciklama",
        "component:fisSatirlari"
      ]
    }
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "saveQuery": "fisKaydet",
          "afterSaveAction": "page",
          "afterSavePageCode": "@finance-journal-ledger",
          "afterSaveTarget": "sameTab",
          "newAction": "page",
          "newPageCode": "@finance-journal-voucher-document",
          "newTarget": "sameTab",
          "moreButtons": [
            "sonFislerDugmesi"
          ],
          "commandWhen": [
            "save=kullanici.rol == 'TenantAdmin'"
          ],
          "hiddenCommands": [
            "open",
            "delete",
            "filter",
            "print",
            "export"
          ]
        }
      },
      {
        "id": "sonFislerDugmesi",
        "type": "button",
        "name": "sonFislerDugmesi",
        "props": {
          "text": "Son fi\u015fler",
          "actionType": "page",
          "pageCode": "@finance-journal-ledger",
          "target": "sameTab"
        }
      },
      {
        "id": "baslik",
        "type": "heading",
        "name": "baslik",
        "props": {
          "text": "Yeni yevmiye fi\u015fi",
          "pageTitle": true
        }
      },
      {
        "id": "kilitUyarisi",
        "type": "alert",
        "name": "kilitUyarisi",
        "props": {
          "title": "Yetki gerekli",
          "variant": "warning",
          "width": 12,
          "text": "Yevmiye fi\u015fi kaydetmek i\u00e7in firma y\u00f6neticisi yetkisi gerekir.",
          "visibleWhen": "kullanici.rol != 'TenantAdmin'"
        }
      },
      {
        "id": "durumNotu",
        "type": "text",
        "name": "durumNotu",
        "props": {
          "text": "Kaydedilen fi\u015f de\u011fi\u015ftirilemez; d\u00fczeltme ters kay\u0131tla yap\u0131l\u0131r. Sat\u0131r: {{fisSatirlari.satirSayisi}} / 100"
        }
      },
      {
        "id": "belgeKarti",
        "type": "formCard",
        "name": "belgeKarti",
        "props": {
          "title": "Belge bilgileri",
          "columns": 3,
          "inputs": [
            "fisTarihi",
            "standart",
            "aciklama"
          ]
        }
      },
      {
        "id": "fisTarihi",
        "type": "input",
        "name": "fisTarihi",
        "props": {
          "inputType": "date",
          "label": "Fi\u015f tarihi",
          "required": true,
          "defaultValue": "{{bugun}}"
        }
      },
      {
        "id": "standart",
        "type": "input",
        "name": "standart",
        "props": {
          "inputType": "select",
          "label": "Muhasebe standard\u0131",
          "required": true,
          "defaultValue": "TDHP",
          "staticOptions": [
            "TDHP=T\u00fcrkiye \u00b7 TDHP",
            "IFRS=IFRS d\u00fczeltme fi\u015fi"
          ]
        }
      },
      {
        "id": "aciklama",
        "type": "input",
        "name": "aciklama",
        "props": {
          "inputType": "text",
          "label": "A\u00e7\u0131klama",
          "required": true,
          "maxLength": 240
        }
      },
      {
        "id": "fisSatirlari",
        "type": "editableGrid",
        "name": "fisSatirlari",
        "props": {
          "gridMode": "list",
          "title": "Sat\u0131rlar",
          "addLabel": "Sat\u0131r ekle",
          "maxRows": 100,
          "minRows": 2,
          "gridColumns": [
            "accountId|Hesap|lookup:hesaplar:id:code:name|required",
            "description|Sat\u0131r a\u00e7\u0131klamas\u0131|text|maxLength:240",
            "debit|Bor\u00e7|number|min:0,step:0.01",
            "credit|Alacak|number|min:0,step:0.01"
          ],
          "columnOptionsWhen": [
            "accountId=satir.isActive == true"
          ],
          "totals": [
            "debit",
            "credit"
          ],
          "disabledWhen": "kullanici.rol != 'TenantAdmin'",
          "disabledReason": "Yevmiye fi\u015fini firma y\u00f6neticisi kaydeder."
        }
      },
      {
        "id": "dengeliEtiketi",
        "type": "badge",
        "name": "dengeliEtiketi",
        "props": {
          "text": "Bor\u00e7 = Alacak \u2713 Dengeli",
          "variant": "success",
          "visibleWhen": "fisSatirlari.toplam.debit == fisSatirlari.toplam.credit && fisSatirlari.toplam.debit > 0"
        }
      },
      {
        "id": "dengesizEtiketi",
        "type": "badge",
        "name": "dengesizEtiketi",
        "props": {
          "text": "Fi\u015f dengede de\u011fil",
          "variant": "warning",
          "visibleWhen": "fisSatirlari.toplam.debit != fisSatirlari.toplam.credit"
        }
      },
      {
        "id": "satirNotu",
        "type": "text",
        "name": "satirNotu",
        "props": {
          "text": "Hesap se\u00e7icide yaln\u0131z aktif hesaplar listelenir. Bir sat\u0131ra yaln\u0131z bor\u00e7 ya da alacak girin. Bo\u015f b\u0131rak\u0131lan sat\u0131r a\u00e7\u0131klamas\u0131 fi\u015f a\u00e7\u0131klamas\u0131yla doldurulur. Kapal\u0131 d\u00f6neme fi\u015f girilmez."
        }
      }
    ],
    "queries": [
      {
        "id": "hesaplar",
        "name": "hesaplar",
        "kind": "read",
        "operation": "finans.muhasebe.hesap.listele",
        "runOn": "load",
        "parameters": []
      },
      {
        "id": "fisKaydet",
        "name": "fisKaydet",
        "kind": "insert",
        "operation": "finans.fis.olustur",
        "runOn": "manual",
        "parameters": [
          {
            "name": "entryDate",
            "binding": "{{fisTarihi.value}}",
            "type": "date"
          },
          {
            "name": "accountingBasis",
            "binding": "{{standart.value}}",
            "type": "text"
          },
          {
            "name": "description",
            "binding": "{{aciklama.value}}",
            "type": "text"
          },
          {
            "name": "lines",
            "binding": "{{fisSatirlari.satirlar}}",
            "type": "list"
          }
        ]
      }
    ]
  },
  "updates": [
    {
      "id": "fis-belgesi",
      "label": "Yeni fi?i Belge ekran?nda olu?tur",
      "below": 2,
      "set": [
        {
          "component": "komutlar",
          "prop": "newPageCode",
          "from": [
            "@finance-journal-vouchers"
          ]
        },
        {
          "component": "komutlar",
          "prop": "newAction",
          "from": [
            null
          ]
        },
        {
          "component": "komutlar",
          "prop": "newTarget",
          "from": [
            null
          ]
        }
      ]
    }
  ]
}
