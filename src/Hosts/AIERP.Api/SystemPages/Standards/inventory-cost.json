{
  "screenKey": "inventory-cost", "title": "Stok Değerleme",
  "description": "Ek maliyetleri, stok değerlemelerini ve alternatif birimleri yönetin.", "module": "Stok & Depo",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": { "since": 1, "label": "İşlem çubuğu",
      "requires": ["component:suzgec", "component:liste", "component:acDugmesi", "query:bakiye"] },
    "component:yetkiNotu": { "since": 1, "label": "Yalnız firma yöneticileri notu" },
    "component:maliyetsizGostergesi": { "since": 1, "label": "Maliyetsiz göstergesi", "requires": ["query:bakiye"] },
    "component:suzgec": { "since": 1, "label": "Süzgeç alanı (depo, arama)",
      "requires": ["component:liste", "query:bakiye", "query:depolar"] },
    "component:liste": { "since": 1, "label": "Stok maliyetleri listesi",
      "requires": ["query:bakiye", "component:suzgec", "component:yonet"] },
    "component:yonet": { "since": 1, "label": "Yönet satır düğmesi", "requires": ["component:maliyetPenceresi", "component:suzgec"] },
    "component:acDugmesi": { "since": 1, "label": "Aç komutu (maliyet yöneticisi)",
      "requires": ["component:maliyetPenceresi", "component:suzgec", "component:liste"] },
    "component:maliyetPenceresi": { "since": 1, "label": "Stok maliyeti penceresi",
      "requires": ["component:liste", "component:pencereAciklamasi", "component:birimBolumu", "component:degerlemeBolumu",
                   "component:ekMaliyetBolumu", "component:kayitBolumu"] },
    "component:pencereAciklamasi": { "since": 1, "label": "Pencere açıklaması" },
    "component:birimBolumu": { "since": 1, "label": "Birim dönüşümleri bölümü",
      "requires": ["component:liste", "component:birimKodu", "component:birimKatsayisi", "component:birimKaldir",
                   "query:birimler", "query:birimEkle"] },
    "component:birimKodu": { "since": 1, "label": "Birim alanı: Alternatif birim kodu" },
    "component:birimKatsayisi": { "since": 1, "label": "Birim alanı: Temel birim katsayısı" },
    "component:birimKaldir": { "since": 1, "label": "Birim dönüşümü devre dışı bırakma düğmesi", "requires": ["query:birimSil", "query:birimler"] },
    "component:degerlemeBolumu": { "since": 1, "label": "Maliyet yeniden değerleme bölümü",
      "requires": ["component:liste", "component:degerlemeTarihi", "component:degerFarki", "component:degerlemeAciklamasi",
                   "query:yenidenDegerle", "query:kayitlar", "query:bakiye"] },
    "component:degerlemeTarihi": { "since": 1, "label": "Değerleme alanı: Değerleme tarihi" },
    "component:degerFarki": { "since": 1, "label": "Değerleme alanı: Değer farkı" },
    "component:degerlemeAciklamasi": { "since": 1, "label": "Değerleme alanı: Açıklama" },
    "component:ekMaliyetBolumu": { "since": 1, "label": "Mal kabul ek maliyeti bölümü",
      "requires": ["component:ekMaliyetKabul", "component:ekMaliyetTutari", "component:ekMaliyetYontemi", "component:ekMaliyetTarihi",
                   "component:ekMaliyetAciklamasi", "component:ekMaliyetTersKayitDugmesi", "query:ekMaliyetDagit", "query:ekMaliyetler",
                   "query:kayitlar", "query:bakiye"] },
    "component:ekMaliyetKabul": { "since": 1, "label": "Ek maliyet alanı: Mal kabul", "requires": ["query:malKabuller"] },
    "component:ekMaliyetTutari": { "since": 1, "label": "Ek maliyet alanı: Tutar", "requires": ["component:liste"] },
    "component:ekMaliyetYontemi": { "since": 1, "label": "Ek maliyet alanı: Dağıtım yöntemi" },
    "component:ekMaliyetTarihi": { "since": 1, "label": "Ek maliyet alanı: Kayıt tarihi" },
    "component:ekMaliyetAciklamasi": { "since": 1, "label": "Ek maliyet alanı: Açıklama" },
    "component:ekMaliyetTersKayitDugmesi": { "since": 1, "label": "Ek maliyet ters kayıt düğmesi",
      "requires": ["query:ekMaliyetTersKayit", "query:ekMaliyetler", "query:kayitlar", "query:bakiye"] },
    "component:kayitBolumu": { "since": 1, "label": "Seçili depodaki maliyet kayıtları",
      "requires": ["query:kayitlar", "component:degerlemeTersKayitDugmesi"] },
    "component:degerlemeTersKayitDugmesi": { "since": 1, "label": "Değerleme ters kayıt düğmesi",
      "requires": ["query:degerlemeTersKayit", "query:kayitlar", "query:bakiye"] },
    "query:bakiye": { "since": 1, "label": "Stok bakiyeleri (sayfalı)", "requires": ["component:suzgec", "component:liste"] },
    "query:depolar": { "since": 1, "label": "Depoları listele" },
    "query:birimler": { "since": 1, "label": "Seçili kartın birimleri", "requires": ["component:liste"] },
    "query:birimEkle": { "since": 1, "label": "Stok kartına birim ekle",
      "requires": ["component:liste", "component:birimKodu", "component:birimKatsayisi"] },
    "query:birimSil": { "since": 1, "label": "Stok kartından birim sil", "requires": ["component:liste", "component:birimBolumu"] },
    "query:kayitlar": { "since": 1, "label": "Seçili depodaki maliyet kayıtları", "requires": ["component:suzgec", "component:liste"] },
    "query:yenidenDegerle": { "since": 1, "label": "Stok maliyetini yeniden değerle",
      "requires": ["component:suzgec", "component:liste", "component:degerlemeTarihi", "component:degerFarki", "component:degerlemeAciklamasi"] },
    "query:degerlemeTersKayit": { "since": 1, "label": "Stok değerlemesini ters kayıtla düzelt",
      "requires": ["component:kayitBolumu", "component:degerlemeTersKayitDugmesi"] },
    "query:malKabuller": { "since": 1, "label": "Mal kabulleri listele" },
    "query:ekMaliyetler": { "since": 1, "label": "Seçili mal kabulün ek maliyetleri", "requires": ["component:ekMaliyetKabul"] },
    "query:ekMaliyetDagit": { "since": 1, "label": "Mal kabul ek maliyetini dağıt",
      "requires": ["component:ekMaliyetKabul", "component:ekMaliyetTutari", "component:ekMaliyetYontemi", "component:ekMaliyetTarihi",
                   "component:ekMaliyetAciklamasi"] },
    "query:ekMaliyetTersKayit": { "since": 1, "label": "Mal kabul ek maliyetini ters kayıtla düzelt",
      "requires": ["component:ekMaliyetBolumu", "component:ekMaliyetTersKayitDugmesi"] }
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "focusInput": "suzgec", "exportTable": "liste", "openButton": "acDugmesi", "titleCount": "{{bakiye.meta.totalCount}}" } },
      { "id": "yetkiNotu", "type": "alert", "name": "yetkiNotu",
        "props": { "variant": "info", "icon": "shield", "width": 12,
                   "text": "Stok maliyetleri ve alternatif birimler yalnızca firma yöneticileri tarafından yönetilebilir.",
                   "visibleWhen": "kullanici.rol != 'TenantAdmin'" } },
      { "id": "maliyetsizGostergesi", "type": "metric", "name": "maliyetsizGostergesi",
        "props": { "title": "Maliyetsiz", "value": "{{bakiye.meta.pageUnvaluedCount}}", "format": "number",
                   "description": "bu sayfa", "variant": "warning", "icon": "alert", "visibleWhen": "kullanici.rol == 'TenantAdmin'" } },
      { "id": "suzgec", "type": "filterBar", "name": "suzgec",
        "props": { "table": "liste", "width": 12, "search": true, "searchPlaceholder": "Kod veya stok adıyla ara", "searchParam": "q",
                   "filters": ["warehouseId|select|row|warehouseId|Depo|depolar:id:name"],
                   "visibleWhen": "kullanici.rol == 'TenantAdmin'" } },
      { "id": "liste", "type": "dataTable", "name": "liste",
        "props": { "title": "Stok maliyetleri", "query": "bakiye", "paging": "server", "pageSize": 25, "width": 12,
                   "columns": ["balance.code", "balance.name", "balance.quantityOnHand", "balance.valuationAmountBase", "balance.unvaluedQuantity"],
                   "columnLabels": ["balance.code=Stok kodu", "balance.name=Stok adı", "balance.quantityOnHand=Depo miktarı",
                                    "balance.valuationAmountBase=Stok değeri", "balance.unvaluedQuantity=Maliyetsiz miktar"],
                   "columnUnits": ["balance.quantityOnHand=balance.unitCode", "balance.unvaluedQuantity=balance.unitCode",
                                   "balance.valuationAmountBase=balance.baseCurrencyCode"],
                   "columnFormats": ["balance.code=code", "balance.quantityOnHand=number", "balance.valuationAmountBase=money",
                                     "balance.unvaluedQuantity=number"],
                   "rowActions": ["yonet"], "emptyText": "Yönetilecek stok bakiyesi yok",
                   "visibleWhen": "kullanici.rol == 'TenantAdmin'" } },
      { "id": "yonet", "type": "button", "name": "yonet",
        "props": { "text": "Yönet", "actionType": "openDialog", "dialogId": "maliyetPenceresi",
                   "disabledWhen": "suzgec.warehouseId == null", "disabledReason": "Maliyet yönetimi için önce bir depo seçin." } },
      { "id": "acDugmesi", "type": "button", "name": "acDugmesi",
        "props": { "text": "Aç", "actionType": "openDialog", "dialogId": "maliyetPenceresi",
                   "disabledWhen": "liste.seciliSatir.balance.stockItemId == null || suzgec.warehouseId == null",
                   "disabledReason": "Önce bir depo ve kayıt seçin" } },

      { "id": "maliyetPenceresi", "type": "dialog", "name": "maliyetPenceresi",
        "props": { "presentation": "dialog", "title": "Stok maliyeti · {{liste.seciliSatir.balance.code}} · {{liste.seciliSatir.balance.name}}",
                   "contains": ["pencereAciklamasi", "birimBolumu", "degerlemeBolumu", "ekMaliyetBolumu", "kayitBolumu"], "resetOnOpen": true } },
      { "id": "pencereAciklamasi", "type": "text", "name": "pencereAciklamasi",
        "props": { "text": "Fiziksel miktarı değiştirmeden ek maliyet dağıtabilir, stok değerini yeniden değerleyebilir ve alternatif birim tanımlayabilirsiniz." } },

      { "id": "birimBolumu", "type": "section", "name": "birimBolumu",
        "props": { "title": "Birim dönüşümleri",
                   "description": "Temel birim: {{liste.seciliSatir.balance.unitCode}} · çarpan giriş biriminden temel birime uygulanır.",
                   "text": "1 alternatif birim = katsayı × {{liste.seciliSatir.balance.unitCode}}" },
        "children": [
          { "id": "birimFormu", "type": "formCard", "name": "birimFormu", "props": { "columns": 2, "inputs": ["birimKodu", "birimKatsayisi"] } },
          { "id": "birimEkleDugmesi", "type": "button", "name": "birimEkleDugmesi",
            "props": { "text": "Birim ekle", "variant": "secondary", "actionType": "query", "queryId": "birimEkle",
                       "successMessage": "Birim dönüşümü tanımlandı.", "refreshQueries": ["birimler"] } },
          { "id": "birimTablosu", "type": "dataTable", "name": "birimTablosu",
            "props": { "query": "birimler", "columns": ["unitCode", "factorToBase"],
                       "columnLabels": ["unitCode=Alternatif birim", "factorToBase=Temel birim katsayısı"], "columnFormats": ["unitCode=code"],
                       "rowActions": ["birimKaldir"], "emptyText": "Alternatif birim tanımı yok." } }
        ] },
      { "id": "birimKodu", "type": "input", "name": "birimKodu",
        "props": { "inputType": "text", "label": "Alternatif birim kodu", "required": true, "maxLength": 8, "upperCase": true, "placeholder": "KOLI" } },
      { "id": "birimKatsayisi", "type": "input", "name": "birimKatsayisi",
        "props": { "inputType": "number", "label": "Temel birim katsayısı", "required": true, "min": 0.00000001, "step": 0.00000001, "defaultValue": "1" } },
      { "id": "birimKaldir", "type": "button", "name": "birimKaldir",
        "props": { "text": "Devre dışı bırak", "actionType": "query", "queryId": "birimSil", "confirmEnabled": true,
                   "confirmText": "{{birimTablosu.seciliSatir.unitCode}} birim dönüşümü yeni hareket girişinden kaldırılacak.",
                   "successMessage": "Birim dönüşümü kaldırıldı.", "refreshQueries": ["birimler"] } },

      { "id": "degerlemeBolumu", "type": "section", "name": "degerlemeBolumu",
        "props": { "title": "Maliyet yeniden değerleme", "description": "İşlem seçili depodaki mevcut miktara uygulanır.",
                   "text": "Negatif stok değeri veya maliyetsiz miktar kabul edilmez." },
        "children": [
          { "id": "degerlemeFormu", "type": "formCard", "name": "degerlemeFormu",
            "props": { "columns": 2, "inputs": ["degerlemeTarihi", "degerFarki", "degerlemeAciklamasi"] } },
          { "id": "degerlemeDugmesi", "type": "button", "name": "degerlemeDugmesi",
            "props": { "text": "Yeniden değerle", "actionType": "query", "queryId": "yenidenDegerle",
                       "successMessage": "Maliyet yeniden değerlemesi kaydedildi.", "refreshQueries": ["kayitlar", "bakiye"] } }
        ] },
      { "id": "degerlemeTarihi", "type": "input", "name": "degerlemeTarihi",
        "props": { "inputType": "date", "label": "Değerleme tarihi", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "degerFarki", "type": "input", "name": "degerFarki",
        "props": { "inputType": "number", "label": "Değer farkı · {{liste.seciliSatir.balance.baseCurrencyCode}}", "required": true, "step": 0.01,
                   "placeholder": "Artış için +, azalış için -" } },
      { "id": "degerlemeAciklamasi", "type": "input", "name": "degerlemeAciklamasi",
        "props": { "inputType": "text", "label": "Açıklama", "required": true, "maxLength": 240 } },

      { "id": "ekMaliyetBolumu", "type": "section", "name": "ekMaliyetBolumu",
        "props": { "title": "Mal kabul ek maliyeti",
                   "description": "Navlun, sigorta ve benzeri maliyetleri bir mal kabulün stok satırlarına dağıtın.",
                   "text": "Dağıtım satır yuvarlaması son satıra eklenir." },
        "children": [
          { "id": "ekMaliyetFormu", "type": "formCard", "name": "ekMaliyetFormu",
            "props": { "columns": 2, "inputs": ["ekMaliyetKabul", "ekMaliyetTutari", "ekMaliyetYontemi", "ekMaliyetTarihi", "ekMaliyetAciklamasi"] } },
          { "id": "ekMaliyetDugmesi", "type": "button", "name": "ekMaliyetDugmesi",
            "props": { "text": "Ek maliyeti dağıt", "actionType": "query", "queryId": "ekMaliyetDagit",
                       "disabledWhen": "ekMaliyetKabul.seciliSatir.status != 'Posted'",
                       "disabledReason": "Ek maliyet yalnız işlenmiş bir mal kabule dağıtılabilir.",
                       "successMessage": "Ek maliyet mal kabul satırlarına dağıtıldı.", "refreshQueries": ["ekMaliyetler", "kayitlar", "bakiye"] } },
          { "id": "ekMaliyetTablosu", "type": "dataTable", "name": "ekMaliyetTablosu",
            "props": { "query": "ekMaliyetler", "columns": ["code", "totalAmountBase", "entryDate", "description", "kind"],
                       "columnLabels": ["code=Kayıt", "totalAmountBase=Tutar", "entryDate=Tarih", "description=Açıklama", "kind=Tür"],
                       "columnFormats": ["code=code", "totalAmountBase=money", "entryDate=date"],
                       "valueLabels": ["kind:LandedCost=Dağıtım kaydı", "kind:Reversal=Ters kayıt", "kind:Revaluation=Yeniden değerleme"],
                       "rowActions": ["ekMaliyetTersKayitDugmesi"], "emptyText": "Bu mal kabulde ek maliyet kaydı yok." } }
        ] },
      { "id": "ekMaliyetKabul", "type": "input", "name": "ekMaliyetKabul",
        "props": { "inputType": "lookup", "label": "Mal kabul", "required": true, "optionsQuery": "malKabuller", "optionValueColumn": "id",
                   "optionLabelColumn": "code", "optionDescriptionColumn": "warehouseName", "minChars": 0,
                   "placeholder": "Mal kabul seçin", "defaultValue": "{{malKabuller.rows[0].id}}" } },
      { "id": "ekMaliyetTutari", "type": "input", "name": "ekMaliyetTutari",
        "props": { "inputType": "number", "label": "Tutar · {{liste.seciliSatir.balance.baseCurrencyCode}}", "required": true, "min": 0.01, "step": 0.01 } },
      { "id": "ekMaliyetYontemi", "type": "input", "name": "ekMaliyetYontemi",
        "props": { "inputType": "select", "label": "Dağıtım yöntemi", "required": true, "defaultValue": "Value",
                   "staticOptions": ["Value=Satır maliyetine göre", "Quantity=Miktara göre", "Equal=Eşit"] } },
      { "id": "ekMaliyetTarihi", "type": "input", "name": "ekMaliyetTarihi",
        "props": { "inputType": "date", "label": "Kayıt tarihi", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "ekMaliyetAciklamasi", "type": "input", "name": "ekMaliyetAciklamasi",
        "props": { "inputType": "text", "label": "Açıklama", "required": true, "maxLength": 240 } },
      { "id": "ekMaliyetTersKayitDugmesi", "type": "button", "name": "ekMaliyetTersKayitDugmesi",
        "props": { "text": "Ters kayıt", "actionType": "query", "queryId": "ekMaliyetTersKayit",
                   "promptLabel": "Ters kayıt nedeni", "promptRequired": true,
                   "visibleWhen": "ekMaliyetTablosu.seciliSatir.kind == 'LandedCost' && ekMaliyetTablosu.seciliSatir.hasReversal != true",
                   "successMessage": "Maliyet ters kaydı oluşturuldu; önceki belge korundu.", "refreshQueries": ["ekMaliyetler", "kayitlar", "bakiye"] } },

      { "id": "kayitBolumu", "type": "section", "name": "kayitBolumu",
        "props": { "title": "Seçili depodaki maliyet kayıtları", "description": "Son 100 kayıt; ters kayıtlar önceki belgeyi korur." },
        "children": [
          { "id": "kayitTablosu", "type": "dataTable", "name": "kayitTablosu",
            "props": { "query": "kayitlar", "columns": ["code", "totalAmountBase", "entryDate", "description", "kind"],
                       "columnLabels": ["code=Kayıt", "totalAmountBase=Tutar", "entryDate=Tarih", "description=Açıklama", "kind=Tür"],
                       "columnFormats": ["code=code", "totalAmountBase=money", "entryDate=date"],
                       "valueLabels": ["kind:Revaluation=Yeniden değerleme", "kind:LandedCost=Ek maliyet", "kind:Reversal=Ters kayıt"],
                       "rowActions": ["degerlemeTersKayitDugmesi"], "emptyText": "Bu depoda maliyet kaydı yok." } }
        ] },
      { "id": "degerlemeTersKayitDugmesi", "type": "button", "name": "degerlemeTersKayitDugmesi",
        "props": { "text": "Ters kayıt", "actionType": "query", "queryId": "degerlemeTersKayit",
                   "promptLabel": "Ters kayıt nedeni", "promptRequired": true,
                   "visibleWhen": "kayitTablosu.seciliSatir.kind == 'Revaluation' && kayitTablosu.seciliSatir.hasReversal != true",
                   "successMessage": "Maliyet ters kaydı oluşturuldu; önceki belge korundu.", "refreshQueries": ["kayitlar", "bakiye"] } }
    ],
    "queries": [
      { "id": "bakiye", "name": "bakiye", "kind": "read", "operation": "stok.bakiye.sayfa", "runOn": "load",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "q", "binding": "{{suzgec.q}}", "type": "text" },
          { "name": "page", "binding": "{{liste.sayfa}}", "type": "int" },
          { "name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int" } ] },
      { "id": "depolar", "name": "depolar", "kind": "read", "operation": "depo.listele", "runOn": "load", "parameters": [] },
      { "id": "birimler", "name": "birimler", "kind": "read", "operation": "stok.kart.birimleri", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{liste.seciliSatir.balance.stockItemId}}", "type": "guid" } ] },
      { "id": "birimEkle", "name": "birimEkle", "kind": "insert", "operation": "stok.kart.birimEkle", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{liste.seciliSatir.balance.stockItemId}}", "type": "guid" },
          { "name": "unitCode", "binding": "{{birimKodu.value}}", "type": "text" },
          { "name": "factorToBase", "binding": "{{birimKatsayisi.value}}", "type": "decimal" } ] },
      { "id": "birimSil", "name": "birimSil", "kind": "delete", "operation": "stok.kart.birimSil", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{liste.seciliSatir.balance.stockItemId}}", "type": "guid" },
          { "name": "conversionId", "binding": "{{birimTablosu.seciliSatir.id}}", "type": "guid" } ] },
      { "id": "kayitlar", "name": "kayitlar", "kind": "read", "operation": "stok.maliyet.kayitlari", "runOn": "load",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "stockItemId", "binding": "{{liste.seciliSatir.balance.stockItemId}}", "type": "guid" } ] },
      { "id": "yenidenDegerle", "name": "yenidenDegerle", "kind": "insert", "operation": "stok.maliyet.yenidenDegerle", "runOn": "manual",
        "parameters": [
          { "name": "warehouseId", "binding": "{{suzgec.warehouseId}}", "type": "guid" },
          { "name": "stockItemId", "binding": "{{liste.seciliSatir.balance.stockItemId}}", "type": "guid" },
          { "name": "entryDate", "binding": "{{degerlemeTarihi.value}}", "type": "date" },
          { "name": "amountBase", "binding": "{{degerFarki.value}}", "type": "decimal" },
          { "name": "reason", "binding": "{{degerlemeAciklamasi.value}}", "type": "text" } ] },
      { "id": "degerlemeTersKayit", "name": "degerlemeTersKayit", "kind": "insert", "operation": "stok.maliyet.tersKayit", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kayitTablosu.seciliSatir.id}}", "type": "guid" },
          { "name": "reason", "binding": "{{degerlemeTersKayitDugmesi.yanit}}", "type": "text" } ] },
      { "id": "malKabuller", "name": "malKabuller", "kind": "read", "operation": "satinalma.malKabul.listele", "runOn": "load", "parameters": [] },
