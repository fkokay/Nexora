{
  "screenKey": "hr-period-summary", "title": "Dönem özeti",
  "description": "Tarih aralığı için personel, puantaj ve izin özetini istekle çalıştırın. Yalnız firma yöneticisi.", "module": "İnsan Kaynakları",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:durumTablosu"]},
    "component:calistirDugmesi": {"since": 1, "label": "Çalıştır", "requires": ["query:ozet"]},
    "component:parametreler": {"since": 1, "label": "Dönem parametreleri", "requires": ["component:baslangic", "component:bitis"]},
    "component:baslangic": {"since": 1, "label": "Başlangıç (ayın 1'i)"},
    "component:bitis": {"since": 1, "label": "Bitiş (bugün)"},
    "component:denetimNotu": {"since": 1, "label": "Denetim kaydı notu"},
    "component:calismadiNotu": {"since": 1, "label": "Henüz çalıştırılmadı notu", "requires": ["query:ozet"]},
    "component:personelGostergesi": {"since": 1, "label": "Dönem sonu personel", "requires": ["query:ozet"]},
    "component:puantajliPersonelGostergesi": {"since": 1, "label": "Puantajı olan personel", "requires": ["query:ozet"]},
    "component:calismaGostergesi": {"since": 1, "label": "Çalışılan (dk)", "requires": ["query:ozet"]},
    "component:mesaiGostergesi": {"since": 1, "label": "Fazla mesai (dk)", "requires": ["query:ozet"]},
    "component:izinGostergesi": {"since": 1, "label": "İzin talebi", "requires": ["query:ozet"]},
    "component:izinGunuGostergesi": {"since": 1, "label": "Talep edilen gün", "requires": ["query:ozet"]},
    "component:durumTablosu": {"since": 1, "label": "İzin durumu kırılımı", "requires": ["query:ozet"]},
    "query:ozet": {"since": 1, "label": "İK dönem özeti", "requires": ["component:baslangic", "component:bitis"]}
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "exportTable": "durumTablosu", "hiddenCommands": ["new", "open", "save", "delete", "refresh", "filter", "print"], "slot": "commands" } },
      { "id": "calistirDugmesi", "type": "button", "name": "calistirDugmesi",
        "props": { "text": "Çalıştır", "icon": "refresh-cw", "actionType": "query", "queryId": "ozet", "slot": "actions" } },

      { "id": "parametreler", "type": "formCard", "name": "parametreler",
        "props": { "title": "Dönem", "layout": "inline", "inputs": ["baslangic", "bitis"], "slot": "above" } },
      { "id": "baslangic", "type": "input", "name": "baslangic",
        "props": { "inputType": "date", "label": "Başlangıç", "required": true, "defaultValue": "{{tarih.ayBasi}}", "slot": "above" } },
      { "id": "bitis", "type": "input", "name": "bitis",
        "props": { "inputType": "date", "label": "Bitiş", "required": true, "defaultValue": "{{bugun}}", "slot": "above" } },
      { "id": "denetimNotu", "type": "text", "name": "denetimNotu",
        "props": { "text": "Her çalıştırma denetim kaydına yazılır. Dönem en çok 366 takvim günü olabilir.", "slot": "above" } },
      { "id": "calismadiNotu", "type": "text", "name": "calismadiNotu",
        "props": { "text": "Tarih aralığını seçip Çalıştır'a basın; özet sayfa açılınca kendiliğinden çalışmaz.",
                   "visibleWhen": "ozet.ran != true", "slot": "above" } },

      { "id": "personelGostergesi", "type": "metric", "name": "personelGostergesi",
        "props": { "title": "Dönem sonu personel", "value": "{{ozet.meta.employeesAtPeriodEnd}}", "format": "number", "icon": "users",
                   "visibleWhen": "ozet.ran == true", "slot": "indicators" } },
      { "id": "puantajliPersonelGostergesi", "type": "metric", "name": "puantajliPersonelGostergesi",
        "props": { "title": "Puantajı olan personel", "value": "{{ozet.meta.employeesWithAttendance}}", "format": "number", "icon": "user-check",
                   "visibleWhen": "ozet.ran == true", "slot": "indicators" } },
      { "id": "calismaGostergesi", "type": "metric", "name": "calismaGostergesi",
        "props": { "title": "Çalışılan (dk)", "value": "{{ozet.meta.workedMinutes}}", "format": "number", "icon": "clock",
                   "visibleWhen": "ozet.ran == true", "slot": "indicators" } },
      { "id": "mesaiGostergesi", "type": "metric", "name": "mesaiGostergesi",
        "props": { "title": "Fazla mesai (dk)", "value": "{{ozet.meta.overtimeMinutes}}", "format": "number", "icon": "timer",
                   "visibleWhen": "ozet.ran == true", "slot": "indicators" } },
      { "id": "izinGostergesi", "type": "metric", "name": "izinGostergesi",
        "props": { "title": "İzin talebi", "value": "{{ozet.meta.leaveRequestCount}}", "format": "number", "icon": "calendar",
                   "description": "dönemle çakışan", "visibleWhen": "ozet.ran == true", "slot": "indicators" } },
      { "id": "izinGunuGostergesi", "type": "metric", "name": "izinGunuGostergesi",
        "props": { "title": "Talep edilen gün", "value": "{{ozet.meta.requestedLeaveDays}}", "format": "number", "icon": "calendar-clock",
                   "visibleWhen": "ozet.ran == true", "slot": "indicators" } },

      { "id": "durumTablosu", "type": "dataTable", "name": "durumTablosu",
        "props": { "title": "İzin durumu kırılımı", "query": "ozet", "visibleWhen": "ozet.ran == true",
                   "showPivot": false,
                   "columns": ["status", "requestCount", "requestedDays"],
                   "columnLabels": ["status=Durum", "requestCount=Talep sayısı", "requestedDays=Talep edilen gün"],
                   "columnFormats": ["status=status", "requestCount=number", "requestedDays=number"],
                   "valueLabels": ["status:Requested=Bekliyor", "status:Approved=Onaylandı", "status:Rejected=Reddedildi", "status:Cancelled=İptal"],
                   "toneMap": ["Bekliyor=warning", "Onaylandı=success", "Reddedildi=danger", "İptal=info"],
                   "totals": ["requestCount", "requestedDays"],
                   "emptyText": "Bu dönemle çakışan izin talebi yok.", "slot": "list" } }
    ],
    "queries": [
      { "id": "ozet", "name": "ozet", "kind": "read", "operation": "ik.donemOzeti", "runOn": "manual",
        "parameters": [
          { "name": "from", "binding": "{{baslangic.value}}", "type": "date" },
          { "name": "to", "binding": "{{bitis.value}}", "type": "date" } ] }
    ],
    "template": { "name": "list" }
  }
}
