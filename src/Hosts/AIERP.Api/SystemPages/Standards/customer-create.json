  "definition": {
    "schemaVersion": 2,
    "template": {"name": "record"},
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"saveSequence": ["olustur", "guncelle", "ozelKaydet", "ozelKaydetYeni"], "stopOnError": true, "sequenceWhen": ["olustur=kart.rows[0].id == null && olustur.sonuc.id == null", "guncelle=kart.rows[0].id != null", "ozelKaydet=kart.rows[0].id != null", "ozelKaydetYeni=kart.rows[0].id == null"], "newAction": "page", "newPageCode": "@customer-create", "newTarget": "sameTab", "saveAndNew": true, "commandWhen": ["saveNew=kart.rows[0].id == null"], "afterSaveAction": "page", "afterSavePageCode": "@customers", "afterSaveTarget": "sameTab", "afterSaveRefresh": true, "hiddenCommands": ["open", "delete", "filter", "print", "export"], "slot": "commands"}},
      {"id": "kartOzeti", "type": "recordHeader", "name": "kartOzeti", "props": {"icon": "users", "title": "{{kart.rows[0].name}}", "subtitle": "{{kart.rows[0].code}}", "fields": ["Bakiye={{bakiye.rows[0].balanceAmount}}", "Vade (gün)={{kart.rows[0].paymentTermDays}}", "Vergi no={{kart.rows[0].taxNumber}}"], "fieldFormats": ["Bakiye=money", "Vade (gün)=number"], "fieldUnits": ["Bakiye={{bakiye.rows[0].currencyCode}} {{bakiye.rows[0].balanceSideCode}}"], "slot": "summary"}},
      {"id": "yeniBaslik", "type": "heading", "name": "yeniBaslik", "props": {"text": "Yeni cari kart", "pageTitle": true, "visibleWhen": "kart.rows[0].id == null", "slot": "above"}},
      {"id": "kartBasligi", "type": "heading", "name": "kartBasligi", "props": {"text": "{{kart.rows[0].name}}", "pageTitle": true, "visibleWhen": "kart.rows[0].id != null", "slot": "above"}},
      {"id": "durumAktif", "type": "badge", "name": "durumAktif", "props": {"text": "Aktif", "variant": "success", "visibleWhen": "kart.rows[0].isActive == true", "slot": "above"}},
      {"id": "durumPasif", "type": "badge", "name": "durumPasif", "props": {"text": "Pasif", "variant": "info", "visibleWhen": "kart.rows[0].isActive == false", "slot": "above"}},
      {"id": "kartSekmeleri", "type": "tabs", "name": "kartSekmeleri", "props": {"tabs": ["Genel=kimlikKarti,vergiKarti,eFaturaUyarisi,zorunluNotu", "İletişim ve adres=iletisimKarti,adresKarti", "Finans ve vergi=finansKarti,muhasebeKarti", "Özel alanlar=ozelAlanlar", "Adresler=adresTablosu"], "tabParam": "tab", "slot": "tabs"}},
      {"id": "kimlikKarti", "type": "formCard", "name": "kimlikKarti", "props": {"title": "Cari kimliği", "columns": 3, "inputs": ["kod", "unvan", "cariTuru", "cariGrubu", "anaFirma"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "vergiKarti", "type": "formCard", "name": "vergiKarti", "props": {"title": "Vergi ve e-Fatura", "columns": 3, "inputs": ["vergiDairesi", "vergiNo", "tcKimlikNo", "eFaturaMukellefi", "eFaturaEtiketi"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "iletisimKarti", "type": "formCard", "name": "iletisimKarti", "props": {"title": "İletişim · Yetkili kişi", "columns": 3, "inputs": ["telefon", "eposta", "webSitesi", "yetkiliKisi", "yetkiliTelefon", "yetkiliEposta"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "adresKarti", "type": "formCard", "name": "adresKarti", "props": {"title": "Birincil adres", "columns": 3, "inputs": ["ulke", "il", "ilce", "postaKodu", "adresSatiri", "adresEtiketi"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "finansKarti", "type": "formCard", "name": "finansKarti", "props": {"title": "Finans", "columns": 3, "inputs": ["doviz", "vadeGunu", "riskLimiti", "fiyatListesi"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "muhasebeKarti", "type": "formCard", "name": "muhasebeKarti", "props": {"title": "Muhasebe ve banka", "columns": 3, "inputs": ["aliciHesabi", "saticiHesabi", "bankaAdi", "subeKodu", "iban"], "recordKey": "{{kart.rows[0].id}}", "trackChanges": true, "slot": "section"}},
      {"id": "kod", "type": "input", "name": "kod", "props": {"inputType": "text", "label": "Cari kodu", "required": true, "maxLength": 64, "upperCase": true, "defaultValue": "{{kart.rows[0].code}}", "slot": "field"}},
      {"id": "unvan", "type": "input", "name": "unvan", "props": {"inputType": "text", "label": "Ünvan", "required": true, "maxLength": 200, "defaultValue": "{{kart.rows[0].name}}", "slot": "field"}},
      {"id": "cariTuru", "type": "input", "name": "cariTuru", "props": {"inputType": "select", "label": "Cari türü", "required": true, "defaultFirst": true, "staticOptions": ["Customer=Müşteri", "Supplier=Tedarikçi", "Both=Müşteri & Tedarikçi", "Dealer=Bayi", "Employee=Personel"], "defaultValue": "{{kart.rows[0].type}}", "slot": "field"}},
      {"id": "cariGrubu", "type": "input", "name": "cariGrubu", "props": {"inputType": "lookup", "label": "Cari grubu", "optionsQuery": "gruplar", "optionValueColumn": "id", "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "allowClear": true, "placeholder": "Grup atanmamış", "optionsWhen": "satir.isActive == true", "defaultValue": "{{kart.rows[0].groupId}}", "slot": "field"}},
      {"id": "anaFirma", "type": "input", "name": "anaFirma", "props": {"inputType": "lookup", "label": "Grup şirketi / ana firma", "optionsQuery": "anaFirmalar", "optionValueColumn": "id", "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "allowClear": true, "placeholder": "Bağımsız firma", "defaultValue": "{{kart.rows[0].parentCompanyId}}", "slot": "field"}},
      {"id": "vergiDairesi", "type": "input", "name": "vergiDairesi", "props": {"inputType": "text", "label": "Vergi dairesi", "maxLength": 120, "defaultValue": "{{kart.rows[0].taxOffice}}", "slot": "field"}},
      {"id": "vergiNo", "type": "input", "name": "vergiNo", "props": {"inputType": "text", "label": "Vergi numarası", "maxLength": 32, "placeholder": "Türkiye: 10 haneli VKN", "defaultValue": "{{kart.rows[0].taxNumber}}", "slot": "field"}},
      {"id": "tcKimlikNo", "type": "input", "name": "tcKimlikNo", "props": {"inputType": "text", "label": "T.C. kimlik no", "maxLength": 11, "pattern": "^[0-9]{11}$", "patternMessage": "T.C. kimlik numarası 11 rakam olmalıdır.", "defaultValue": "{{kart.rows[0].identityNumber}}", "slot": "field"}},
      {"id": "eFaturaMukellefi", "type": "input", "name": "eFaturaMukellefi", "props": {"inputType": "checkbox", "label": "E-Fatura mükellefi", "defaultValue": "{{kart.rows[0].isEInvoiceRegistered}}", "slot": "field"}},
      {"id": "eFaturaEtiketi", "type": "input", "name": "eFaturaEtiketi", "props": {"inputType": "text", "label": "E-Fatura alıcı etiketi (PK)", "maxLength": 255, "visibleWhen": "eFaturaMukellefi.value == true", "defaultValue": "{{kart.rows[0].eInvoiceRecipientAlias}}", "slot": "field"}},
      {"id": "telefon", "type": "input", "name": "telefon", "props": {"inputType": "text", "label": "Telefon", "maxLength": 40, "defaultValue": "{{kart.rows[0].phone}}", "slot": "field"}},
      {"id": "eposta", "type": "input", "name": "eposta", "props": {"inputType": "text", "label": "Kurumsal e-posta", "maxLength": 254, "defaultValue": "{{kart.rows[0].email}}", "slot": "field"}},
      {"id": "webSitesi", "type": "input", "name": "webSitesi", "props": {"inputType": "text", "label": "Web sitesi", "maxLength": 255, "placeholder": "https://…", "defaultValue": "{{kart.rows[0].website}}", "slot": "field"}},
      {"id": "yetkiliKisi", "type": "input", "name": "yetkiliKisi", "props": {"inputType": "text", "label": "Yetkili kişi", "maxLength": 160, "placeholder": "Ad soyad", "defaultValue": "{{kart.rows[0].contactName}}", "slot": "field"}},
      {"id": "yetkiliTelefon", "type": "input", "name": "yetkiliTelefon", "props": {"inputType": "text", "label": "Yetkili telefonu", "maxLength": 40, "defaultValue": "{{kart.rows[0].contactPhone}}", "slot": "field"}},
      {"id": "yetkiliEposta", "type": "input", "name": "yetkiliEposta", "props": {"inputType": "text", "label": "Yetkili e-postası", "maxLength": 254, "defaultValue": "{{kart.rows[0].contactEmail}}", "slot": "field"}},
      {"id": "ulke", "type": "input", "name": "ulke", "props": {"inputType": "select", "label": "Ülke", "defaultValue": "{{kart.rows[0].defaultAddressCountryCode}}", "staticOptions": ["=Türkiye (varsayılan)", "TR=Türkiye", "DE=Almanya", "NL=Hollanda", "FR=Fransa", "GB=Birleşik Krallık", "IT=İtalya", "ES=İspanya", "BE=Belçika", "AT=Avusturya", "CH=İsviçre", "US=ABD", "AZ=Azerbaycan", "GE=Gürcistan", "RU=Rusya", "IQ=Irak", "SA=Suudi Arabistan", "AE=Birleşik Arap Emirlikleri", "CN=Çin", "BG=Bulgaristan"], "clearsOnChange": ["il", "ilce"], "slot": "field"}},
