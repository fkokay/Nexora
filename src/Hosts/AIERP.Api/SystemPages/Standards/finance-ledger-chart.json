            "muavinOzeti",
            "muavinTablosu"
          ]
        }
      },
      {
        "id": "muavinParametreleri",
        "type": "formCard",
        "name": "muavinParametreleri",
        "props": {
          "title": "Dönem",
          "layout": "inline",
          "inputs": [
            "muavinBaslangic",
            "muavinBitis"
          ]
        }
      },
      {
        "id": "muavinBaslangic",
        "type": "input",
        "name": "muavinBaslangic",
        "props": {
          "inputType": "date",
          "label": "Başlangıç",
          "required": true,
          "defaultValue": "{{tarih.yilBasi}}"
        }
      },
      {
        "id": "muavinBitis",
        "type": "input",
        "name": "muavinBitis",
        "props": {
          "inputType": "date",
          "label": "Bitiş",
          "required": true,
          "defaultValue": "{{bugun}}"
        }
      },
      {
        "id": "muavinOzeti",
        "type": "recordHeader",
        "name": "muavinOzeti",
        "props": {
          "title": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}}",
          "fields": [
            "Açılış borç={{muavin.meta.openingBalanceDebit}}",
            "Açılış alacak={{muavin.meta.openingBalanceCredit}}",
            "Dönem borç={{muavin.meta.totalDebit}}",
            "Dönem alacak={{muavin.meta.totalCredit}}",
            "Kapanış borç={{muavin.meta.closingBalanceDebit}}",
            "Kapanış alacak={{muavin.meta.closingBalanceCredit}}"
          ],
          "fieldFormats": [
            "Açılış borç=money",
            "Açılış alacak=money",
            "Dönem borç=money",
            "Dönem alacak=money",
            "Kapanış borç=money",
            "Kapanış alacak=money"
          ]
        }
      },
      {
        "id": "muavinTablosu",
        "type": "dataTable",
        "name": "muavinTablosu",
        "props": {
          "title": "Hesap hareketleri",
          "query": "muavin",
          "paging": "server",
          "pageSize": 50,
          "width": 12,
          "columns": [
            "entryDate",
            "journalEntryCode",
            "lineDescription",
            "debit",
            "credit"
          ],
          "columnLabels": [
            "entryDate=Tarih",
            "journalEntryCode=Fiş",
            "lineDescription=Açıklama",
            "debit=Borç",
            "credit=Alacak",
            "journalDescription=Fiş açıklaması",
            "sourceType=Kaynak"
          ],
          "columnFormats": [
            "entryDate=date",
            "journalEntryCode=code",
            "debit=money",
            "credit=money"
          ],
          "emptyText": "Bu dönemde hesap hareketi yok.",
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showExport": false,
          "showPivot": false,
          "showCsv": false,
          "showSelectedExport": false
        }
      }
