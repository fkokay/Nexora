{
  "screenKey": "finance-ledger-chart",
  "title": "Hesap Planı",
  "description": "Tek Düzen Hesap Planı'na göre muhasebe hesapları: düz liste, sınıf süzgeci, hesap kartı, pasife alma ve muavin.",
  "module": "Genel Muhasebe",
  "version": 2,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "İşlem çubuğu (Yeni hesap, Tek Düzen, Excel)",
      "requires": [
        "component:yeniHesapDugmesi",
        "component:suzgec",
        "component:liste",
        "query:hesaplar",
        "component:tekDuzenDugmesi"
      ]
    },
    "component:yeniHesapDugmesi": {
      "since": 1,
      "label": "Yeni hesap komutu",
      "requires": [
        "component:yeniHesapPenceresi"
      ]
    },
    "component:tekDuzenDugmesi": {
      "since": 1,
      "label": "Tek Düzen Hesap Planı komutu",
      "requires": [
        "query:tekDuzenUygula",
        "query:tekDuzen",
        "query:hesap",
        "query:hesaplar"
      ]
    },
    "component:suzgec": {
      "since": 1,
      "label": "Süzgeç alanı (arama, sınıf, durum, hareket)",
      "requires": [
        "component:liste"
      ]
    },
    "component:liste": {
      "since": 1,
      "label": "Hesap planı listesi",
      "requires": [
        "query:hesaplar"
      ]
    },
    "component:detayKarti": {
      "since": 1,
      "label": "Kart grubu (seçili hesap)",
      "requires": [
        "component:liste",
        "component:duzenlePenceresi",
        "component:muavinPenceresi",
        "query:pasifeAl",
        "query:hesaplar",
        "query:hesap",
        "query:aktifEt",
        "query:hesapSil"
      ]
    },
    "component:yeniHesapPenceresi": {
      "since": 1,
      "label": "Yeni hesap penceresi",
      "requires": [
        "component:yeniHesapFormu",
        "component:yeniIfrsFormu",
        "component:yeniHesapNotu",
        "query:olustur",
        "query:hesaplar",
        "query:hesap"
      ]
    },
    "component:yeniHesapFormu": {
      "since": 1,
      "label": "Yeni hesap: Hesap bölümü",
      "requires": [
        "component:yeniKod",
        "component:yeniAd",
        "component:yeniTabloSinifi",
        "component:yeniHesapTipi",
        "component:yeniCalismaSekli",
        "component:yeniDoviz"
      ]
    },
    "component:yeniIfrsFormu": {
      "since": 1,
      "label": "Yeni hesap: IFRS bölümü",
      "requires": [
        "component:yeniIfrsKodu",
        "component:yeniIfrsAdi",
        "component:yeniIfrsSinifi"
      ]
    },
    "component:yeniKod": {
      "since": 1,
      "label": "Yeni hesap alanı: Kod"
    },
    "component:yeniAd": {
      "since": 1,
      "label": "Yeni hesap alanı: Ad"
    },
    "component:yeniTabloSinifi": {
      "since": 1,
      "label": "Yeni hesap alanı: Finansal tablo sınıfı"
    },
    "component:yeniHesapTipi": {
      "since": 1,
      "label": "Yeni hesap alanı: Hesap tipi"
    },
    "component:yeniCalismaSekli": {
      "since": 1,
      "label": "Yeni hesap alanı: Çalışma şekli"
    },
    "component:yeniDoviz": {
      "since": 1,
      "label": "Yeni hesap alanı: Döviz"
    },
    "component:yeniIfrsKodu": {
      "since": 1,
      "label": "Yeni hesap alanı: IFRS hesap kodu"
    },
    "component:yeniIfrsAdi": {
      "since": 1,
      "label": "Yeni hesap alanı: IFRS hesap adı"
    },
    "component:yeniIfrsSinifi": {
      "since": 1,
      "label": "Yeni hesap alanı: IFRS tablo sınıfı"
    },
    "component:yeniHesapNotu": {
      "since": 1,
      "label": "Yeni hesap notu"
    },
    "component:duzenlePenceresi": {
      "since": 1,
      "label": "Hesabı düzenle penceresi",
      "requires": [
        "component:liste",
        "component:hesapFormu",
        "component:ifrsFormu",
        "component:kartNotu",
        "query:guncelle",
        "query:hesaplar",
        "query:hesap"
      ]
    },
    "component:hesapFormu": {
      "since": 1,
      "label": "Düzenle: Hesap bölümü",
      "requires": [
        "component:kod",
        "component:ad",
        "component:tabloSinifi",
        "component:hesapTipi",
        "component:calismaSekli",
        "component:doviz"
      ]
    },
    "component:ifrsFormu": {
      "since": 1,
      "label": "Düzenle: IFRS bölümü",
