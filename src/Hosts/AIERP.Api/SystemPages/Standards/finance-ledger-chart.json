        "component:ifrsSinifi"
      ]
    },
    "component:kod": {
      "since": 1,
      "label": "Alan: Kod",
      "requires": [
        "component:liste"
      ]
    },
    "component:ad": {
      "since": 1,
      "label": "Alan: Ad",
      "requires": [
        "component:liste"
      ]
    },
    "component:tabloSinifi": {
      "since": 1,
      "label": "Alan: Finansal tablo sınıfı",
      "requires": [
        "component:liste"
      ]
    },
    "component:hesapTipi": {
      "since": 1,
      "label": "Alan: Hesap tipi",
      "requires": [
        "component:liste"
      ]
    },
    "component:calismaSekli": {
      "since": 1,
      "label": "Alan: Çalışma şekli",
      "requires": [
        "component:liste"
      ]
    },
    "component:doviz": {
      "since": 1,
      "label": "Alan: Döviz",
      "requires": [
        "component:liste"
      ]
    },
    "component:ifrsKodu": {
      "since": 1,
      "label": "Alan: IFRS hesap kodu",
      "requires": [
        "component:liste"
      ]
    },
    "component:ifrsAdi": {
      "since": 1,
      "label": "Alan: IFRS hesap adı",
      "requires": [
        "component:liste"
      ]
    },
    "component:ifrsSinifi": {
      "since": 1,
      "label": "Alan: IFRS tablo sınıfı",
      "requires": [
        "component:liste"
      ]
    },
    "component:kartNotu": {
      "since": 1,
      "label": "Düzenle: kilit notu"
    },
    "component:muavinPenceresi": {
      "since": 1,
      "label": "Muavin penceresi",
      "requires": [
        "component:liste",
        "component:muavinParametreleri",
        "component:muavinOzeti",
        "component:muavinTablosu"
      ]
    },
    "component:muavinParametreleri": {
      "since": 1,
      "label": "Muavin dönemi",
      "requires": [
        "component:muavinBaslangic",
        "component:muavinBitis"
      ]
    },
    "component:muavinBaslangic": {
      "since": 1,
      "label": "Muavin: Başlangıç tarihi"
    },
    "component:muavinBitis": {
      "since": 1,
      "label": "Muavin: Bitiş tarihi"
    },
    "component:muavinOzeti": {
      "since": 1,
      "label": "Muavin özeti",
      "requires": [
        "component:liste",
        "query:muavin"
      ]
    },
    "component:muavinTablosu": {
      "since": 1,
      "label": "Muavin tablosu",
      "requires": [
        "query:muavin"
      ]
    },
    "query:hesaplar": {
      "since": 1,
      "label": "Hesap planını listele"
    },
    "query:hesap": {
      "since": 1,
      "label": "Seçili muhasebe hesabı",
      "requires": [
        "component:liste"
      ]
    },
    "query:tekDuzen": {
      "since": 1,
      "label": "Tek Düzen Hesap Planı önizlemesi"
    },
    "query:muavin": {
      "since": 1,
      "label": "Seçili hesabın muavini",
      "requires": [
        "component:liste",
        "component:muavinBaslangic",
        "component:muavinBitis",
        "component:muavinTablosu"
      ]
    },
    "query:olustur": {
      "since": 1,
      "label": "Muhasebe hesabı oluştur",
      "requires": [
        "component:yeniKod",
        "component:yeniAd",
        "component:yeniTabloSinifi",
        "component:yeniHesapTipi",
        "component:yeniCalismaSekli",
        "component:yeniDoviz",
        "component:yeniIfrsKodu",
        "component:yeniIfrsAdi",
        "component:yeniIfrsSinifi"
      ]
    },
    "query:guncelle": {
      "since": 1,
      "label": "Muhasebe hesabını güncelle",
      "requires": [
        "query:hesap",
        "component:kod",
        "component:ad",
        "component:tabloSinifi",
        "component:hesapTipi",
        "component:calismaSekli",
        "component:doviz",
        "component:ifrsKodu",
        "component:ifrsAdi",
        "component:ifrsSinifi"
      ]
    },
    "query:pasifeAl": {
      "since": 1,
      "label": "Muhasebe hesabını pasife al",
      "requires": [
        "query:hesap"
      ]
    },
    "query:aktifEt": {
      "since": 1,
      "label": "Muhasebe hesabını etkinleştir",
      "requires": [
        "query:hesap"
      ]
    },
    "query:hesapSil": {
      "since": 1,
      "label": "Muhasebe hesabını sil",
      "requires": [
        "component:liste"
      ]
    },
    "query:tekDuzenUygula": {
      "since": 1,
      "label": "Tek Düzen eksik hesaplarını ekle"
    }
  },
  "definition": {
    "schemaVersion": 2,
    "template": {
      "name": "list"
    },
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "newButton": "yeniHesapDugmesi",
          "focusInput": "suzgec",
          "exportTable": "liste",
          "titleCount": "{{hesaplar.satirSayisi}}",
          "moreButtons": [
            "tekDuzenDugmesi"
          ],
          "commandWhen": [
            "new=kullanici.rol == 'TenantAdmin'"
          ],
          "hiddenCommands": [
            "open",
            "save",
            "delete",
            "print"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "yeniHesapDugmesi",
        "type": "button",
        "name": "yeniHesapDugmesi",
        "props": {
          "text": "Yeni hesap",
          "actionType": "openDialog",
          "dialogId": "yeniHesapPenceresi",
          "slot": "actions"
        }
      },
      {
        "id": "tekDuzenDugmesi",
        "type": "button",
        "name": "tekDuzenDugmesi",
        "props": {
          "text": "Tek Düzen Hesap Planı",
          "actionType": "query",
          "queryId": "tekDuzenUygula",
          "confirmEnabled": true,
          "confirmText": "Tek Düzen Hesap Planı'ndaki eksik {{tekDuzen.rows[0].accountsToAdd}} hesap eklensin mi? Var olan {{tekDuzen.rows[0].existingAccounts}} hesap değişmez; eşleştirme kurulmaz.",
          "successMessage": "Eksik Tek Düzen hesapları eklendi.",
          "refreshQueries": [
            "hesaplar",
            "tekDuzen"
          ],
          "visibleWhen": "kullanici.rol == 'TenantAdmin'",
          "disabledWhen": "tekDuzen.rows[0].accountsToAdd == 0",
          "disabledReason": "Tek Düzen Hesap Planı'nın bütün hesapları tanımlı.",
          "slot": "actions"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "search": true,
          "searchPlaceholder": "Kod veya hesap adı ara",
          "searchColumns": [
            "code",
            "name"
          ],
          "filters": [
            "accountClass|select|row||Sınıf",
            "isActive|select|row||Durum",
            "hasMovements|select|row||Hareket"
          ],
          "slot": "filters"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Hesap planı",
          "query": "hesaplar",
          "columns": [
            "code",
            "name",
            "accountClass",
            "accountType",
            "normalBalance",
            "isActive",
            "hasMovements"
          ],
          "columnLabels": [
            "code=Kod",
            "name=Hesap",
            "accountClass=Sınıf",
            "accountType=Tip",
            "normalBalance=Çalışma şekli",
            "isActive=Durum",
            "hasMovements=Hareket",
            "statementSection=Finansal tablo sınıfı",
            "currencyCode=Döviz",
            "ifrsAccountCode=IFRS kodu"
          ],
          "columnFormats": [
            "code=code",
            "accountType=status",
            "normalBalance=status",
            "isActive=status",
            "hasMovements=status"
          ],
          "valueLabels": [
            "accountType:Unclassified=Sınıflandırılmamış",
            "accountType:Asset=Varlık",
            "accountType:Liability=Yükümlülük",
            "accountType:Equity=Özkaynak",
            "accountType:Revenue=Gelir",
            "accountType:Expense=Gider",
            "accountType:OffBalanceSheet=Nazım",
            "normalBalance:Debit=Borç",
            "normalBalance:Credit=Alacak",
            "normalBalance:Both=Borç/Alacak",
            "isActive:true=Aktif",
            "isActive:false=Pasif",
            "hasMovements:true=Hareketli",
            "hasMovements:false=—",
            "statementSection:Unclassified=Sınıflandırılmamış",
            "statementSection:Asset=Varlık",
            "statementSection:Liability=Yükümlülük",
            "statementSection:Equity=Özkaynak",
            "statementSection:Revenue=Gelir",
            "statementSection:Expense=Gider"
          ],
          "toneMap": [
            "Aktif=success",
            "Pasif=info",
            "Hareketli=info"
          ],
          "emptyText": "Süzgece uyan hesap yok. Tek Düzen Hesap Planı ile eksik hesapları ekleyebilirsiniz.",
          "slot": "list"
        }
      },
      {
        "id": "detayKarti",
        "type": "card",
        "name": "detayKarti",
        "props": {
          "variant": "panel",
          "title": "{{liste.seciliSatir.name}}",
          "description": "{{liste.seciliSatir.code}}",
          "slot": "detail"
        },
        "children": [
          {
            "id": "detayBos",
            "type": "text",
            "name": "detayBos",
            "props": {
              "text": "Bir hesap seçin; ayrıntıları burada görün.",
              "visibleWhen": "liste.seciliSatir.id == null"
            }
          },
          {
            "id": "aktifEtiketi",
            "type": "badge",
            "name": "aktifEtiketi",
            "props": {
              "text": "Aktif",
              "variant": "success",
              "visibleWhen": "liste.seciliSatir.isActive == true"
            }
          },
          {
            "id": "pasifEtiketi",
            "type": "badge",
            "name": "pasifEtiketi",
            "props": {
              "text": "Pasif",
              "variant": "info",
              "visibleWhen": "liste.seciliSatir.isActive == false"
            }
          },
          {
            "id": "hareketliEtiketi",
            "type": "badge",
            "name": "hareketliEtiketi",
            "props": {
              "text": "Hareketli",
              "variant": "info",
              "visibleWhen": "liste.seciliSatir.hasMovements == true"
            }
          },
          {
            "id": "detayBilgi",
            "type": "contextPanel",
            "name": "detayBilgi",
            "props": {
              "table": "liste",
              "visibleWhen": "liste.seciliSatir.id != null",
              "fields": [
                "statementSection=Finansal tablo sınıfı",
                "accountType=Hesap tipi",
                "normalBalance=Çalışma şekli",
                "currencyCode=Döviz",
                "ifrsAccountCode=IFRS kodu"
              ]
            }
          },
          {
            "id": "duzenleDugmesi",
            "type": "button",
            "name": "duzenleDugmesi",
            "props": {
              "text": "Düzenle",
              "actionType": "openDialog",
              "dialogId": "duzenlePenceresi",
              "visibleWhen": "kullanici.rol == 'TenantAdmin' && liste.seciliSatir.id != null"
            }
          },
          {
            "id": "muavinDugmesi",
            "type": "button",
            "name": "muavinDugmesi",
            "props": {
              "text": "Hareketleri gör",
              "actionType": "openDialog",
              "dialogId": "muavinPenceresi",
              "disabledWhen": "liste.seciliSatir.id == null",
              "disabledReason": "Önce bir hesap seçin"
            }
          },
          {
            "id": "pasifeAlDugmesi",
            "type": "button",
            "name": "pasifeAlDugmesi",
            "props": {
              "text": "Pasife al",
              "actionType": "query",
              "queryId": "pasifeAl",
              "confirmEnabled": true,
              "confirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}} pasife alınsın mı? Pasif hesaba yevmiye satırı girilemez.",
              "successMessage": "Hesap pasife alındı.",
              "refreshQueries": [
                "hesaplar",
                "hesap"
              ],
              "visibleWhen": "kullanici.rol == 'TenantAdmin' && liste.seciliSatir.isActive == true"
            }
          },
          {
            "id": "etkinlestirDugmesi",
            "type": "button",
            "name": "etkinlestirDugmesi",
            "props": {
              "text": "Etkinleştir",
              "actionType": "query",
              "queryId": "aktifEt",
              "confirmEnabled": true,
              "confirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}} yeniden etkinleştirilsin mi?",
              "successMessage": "Hesap etkinleştirildi.",
              "refreshQueries": [
                "hesaplar",
                "hesap"
              ],
              "visibleWhen": "kullanici.rol == 'TenantAdmin' && liste.seciliSatir.isActive == false"
            }
          },
          {
            "id": "silDugmesi",
            "type": "button",
            "name": "silDugmesi",
            "props": {
              "text": "Sil",
              "actionType": "query",
              "queryId": "hesapSil",
              "confirmEnabled": true,
              "confirmText": "{{liste.seciliSatir.code}} · {{liste.seciliSatir.name}} kalıcı olarak silinsin mi? Hesabın eşleştirmeleri de kaldırılır.",
              "successMessage": "Hesap silindi.",
              "refreshQueries": [
                "hesaplar"
              ],
              "visibleWhen": "kullanici.rol == 'TenantAdmin'",
              "disabledWhen": "liste.seciliSatir.id == null || liste.seciliSatir.hasMovements == true",
              "disabledReason": "Hareketli hesap silinemez; pasife alın. Alt hesabı olan hesap da silinemez."
            }
          }
        ]
      },
      {
        "id": "yeniHesapPenceresi",
        "type": "dialog",
        "name": "yeniHesapPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "lg",
          "title": "Yeni hesap",
          "contains": [
            "yeniHesapFormu",
            "yeniIfrsFormu",
            "yeniHesapNotu"
          ],
          "saveQuery": "olustur",
          "saveLabel": "Kaydet",
          "closeOnSave": true,
          "resetOnOpen": true,
          "refreshQueries": [
            "hesaplar",
            "hesap"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "yeniHesapFormu",
        "type": "formCard",
        "name": "yeniHesapFormu",
        "props": {
          "title": "Hesap",
          "columns": 2,
          "inputs": [
            "yeniKod",
            "yeniAd",
            "yeniTabloSinifi",
            "yeniHesapTipi",
            "yeniCalismaSekli",
            "yeniDoviz"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "yeniIfrsFormu",
        "type": "formCard",
        "name": "yeniIfrsFormu",
        "props": {
          "title": "IFRS",
          "columns": 2,
          "inputs": [
            "yeniIfrsKodu",
            "yeniIfrsAdi",
            "yeniIfrsSinifi"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "yeniKod",
        "type": "input",
        "name": "yeniKod",
        "props": {
          "inputType": "text",
          "label": "Kod",
          "required": true,
          "maxLength": 32,
          "placeholder": "120.001",
          "slot": "dialog"
        }
      },
      {
        "id": "yeniAd",
        "type": "input",
        "name": "yeniAd",
        "props": {
          "inputType": "text",
          "label": "Ad",
          "required": true,
          "maxLength": 160,
          "slot": "dialog"
        }
      },
      {
        "id": "yeniTabloSinifi",
        "type": "input",
        "name": "yeniTabloSinifi",
        "props": {
          "inputType": "select",
          "label": "Finansal tablo sınıfı",
          "defaultFirst": true,
          "staticOptions": [
            "Unclassified=Sınıflandırılmamış",
            "Asset=Varlık",
            "Liability=Yükümlülük",
            "Equity=Özkaynak",
            "Revenue=Gelir",
            "Expense=Gider"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "yeniHesapTipi",
        "type": "input",
        "name": "yeniHesapTipi",
        "props": {
          "inputType": "select",
          "label": "Hesap tipi",
          "defaultFirst": true,
          "staticOptions": [
            "Unclassified=Sınıflandırılmamış",
            "Asset=Varlık",
            "Liability=Yükümlülük",
            "Equity=Özkaynak",
            "Revenue=Gelir",
            "Expense=Gider",
            "OffBalanceSheet=Nazım"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "yeniCalismaSekli",
        "type": "input",
        "name": "yeniCalismaSekli",
        "props": {
          "inputType": "select",
          "label": "Çalışma şekli",
          "defaultFirst": true,
          "staticOptions": [
            "Both=Borç/Alacak",
            "Debit=Borç",
