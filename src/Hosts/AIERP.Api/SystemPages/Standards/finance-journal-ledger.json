{
  "screenKey": "finance-journal-ledger",
  "title": "Yevmiye Defterleri",
  "description": "Yevmiye fi\u015fleri: tarih ve standart s\u00fczgeci, fi\u015f belgesi ve zinciri, sunucunun izin verdi\u011fi fi\u015flerde ters kay\u0131t.",
  "module": "Genel Muhasebe",
  "version": 3,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "\u0130\u015flem \u00e7ubu\u011fu",
      "requires": [
        "component:yeniFisDugmesi",
        "component:acDugmesi",
        "component:liste",
        "component:tersKayitDugmesi",
        "component:tersKayitSourced",
        "query:fisler"
      ]
    },
    "component:yeniFisDugmesi": {
      "since": 1,
      "label": "Yeni fi\u015f komutu"
    },
    "component:acDugmesi": {
      "since": 1,
      "label": "Fi\u015fi a\u00e7",
      "requires": [
        "component:liste",
        "component:fisPenceresi"
      ]
    },
    "component:fisSayisiGostergesi": {
      "since": 1,
      "label": "Fi\u015f say\u0131s\u0131 g\u00f6stergesi",
      "requires": [
        "query:fisler"
      ]
    },
    "component:suzgec": {
      "since": 1,
      "label": "S\u00fczge\u00e7 alan\u0131 (bu sayfa)",
      "requires": [
        "component:liste"
      ]
    },
    "component:liste": {
      "since": 1,
      "label": "Yevmiye fi\u015fleri listesi",
      "requires": [
        "component:acDugmesi",
        "query:fisler"
      ]
    },
    "component:altBilgi": {
      "since": 1,
      "label": "Liste alt bilgisi"
    },
    "component:tersKayitDugmesi": {
      "since": 1,
      "label": "Ters kay\u0131t olu\u015ftur (manuel fi\u015f)",
      "requires": [
        "component:liste",
        "query:fisler",
        "query:fis",
        "query:tersKayit"
      ]
    },
    "component:tersKayitSourced": {
      "since": 1,
      "label": "Ters kay\u0131t olu\u015ftur (kaynakl\u0131 fi\u015f)",
      "requires": [
        "component:liste",
        "query:fisler",
        "query:fis",
        "query:tersKayitKaynakli"
      ]
    },
    "component:fisPenceresi": {
      "since": 1,
      "label": "Fi\u015f penceresi",
      "requires": [
        "component:fisBasligi",
        "component:fisSatirTablosu",
        "component:zincirNotu",
        "component:tersNotu",
        "component:kaynakNotu",
        "query:fis"
      ]
    },
    "component:fisBasligi": {
      "since": 1,
      "label": "Fi\u015f ba\u015fl\u0131\u011f\u0131",
      "requires": [
        "query:fis",
        "component:fisPenceresi"
      ]
    },
    "component:fisSatirTablosu": {
      "since": 1,
      "label": "Fi\u015f sat\u0131rlar\u0131",
      "requires": [
        "query:satirlar",
        "component:fisPenceresi"
      ]
    },
    "component:zincirNotu": {
      "since": 1,
      "label": "Fi\u015f zinciri: ters \u00e7evrildi",
      "requires": [
        "query:fis",
        "component:fisPenceresi"
      ]
    },
    "component:tersNotu": {
      "since": 1,
      "label": "Fi\u015f zinciri: ters kay\u0131t fi\u015fi",
      "requires": [
        "query:fis",
        "component:fisPenceresi"
      ]
    },
    "component:kaynakNotu": {
      "since": 1,
      "label": "Kaynak belge notu",
      "requires": [
        "query:fis",
        "component:fisPenceresi"
      ]
    },
    "query:fisler": {
      "since": 1,
      "label": "Yevmiye fi\u015flerini listele",
      "requires": [
        "component:baslangic",
        "component:bitis",
        "component:standart",
        "component:liste",
        "query:fis"
      ]
    },
    "query:fis": {
      "since": 1,
      "label": "Se\u00e7ili fi\u015f",
      "requires": [
        "component:liste"
      ]
    },
    "query:satirlar": {
      "since": 1,
      "label": "Se\u00e7ili fi\u015fin sat\u0131rlar\u0131",
      "requires": [
        "component:liste",
        "query:fis"
      ]
    },
    "query:tersKayit": {
      "since": 1,
      "label": "Fi\u015fi ters \u00e7evir (manuel)",
      "requires": [
        "component:liste",
        "component:tersKayitDugmesi",
        "query:fis"
      ]
    },
    "query:tersKayitKaynakli": {
      "since": 1,
      "label": "Fi\u015fi ters \u00e7evir (kaynakl\u0131)",
      "requires": [
        "component:liste",
        "component:tersKayitSourced",
        "query:fis",
        "query:tersKayit"
      ]
    },
    "component:baslangic": {
      "since": 2,
      "label": "baslangic"
    },
    "component:bitis": {
      "since": 2,
      "label": "bitis"
    },
    "component:standart": {
      "since": 2,
      "label": "standart"
    }
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "newButton": "yeniFisDugmesi",
          "openButton": "acDugmesi",
          "exportTable": "liste",
          "hiddenCommands": [
            "save",
            "delete",
            "filter",
            "print"
          ],
          "slot": "commands"
        }
      },
      {
        "id": "yeniFisDugmesi",
        "type": "button",
        "name": "yeniFisDugmesi",
        "props": {
          "text": "Yeni",
          "actionType": "page",
          "pageCode": "@finance-journal-voucher-document",
          "target": "newTab",
          "slot": "actions"
        }
      },
      {
        "id": "acDugmesi",
        "type": "button",
        "name": "acDugmesi",
        "props": {
          "text": "A\u00e7",
          "icon": "open",
          "actionType": "page",
          "disabledWhen": "liste.seciliSatir.id == null",
          "disabledReason": "\u00d6nce bir fi\u015f se\u00e7in",
          "slot": "rowActions",
          "pageCode": "@finance-journal-voucher-document",
          "target": "sameTab",
          "params": [
            "id={{liste.seciliSatir.id}}"
          ]
        }
      },
      {
        "id": "fisSayisiGostergesi",
        "type": "metric",
        "name": "fisSayisiGostergesi",
        "props": {
          "title": "Fi\u015f say\u0131s\u0131",
          "value": "{{fisler.meta.totalCount}}",
          "format": "number",
          "icon": "files",
          "description": "s\u00fczgece g\u00f6re",
          "slot": "indicators"
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "search": true,
          "searchPlaceholder": "Fi\u015f no veya a\u00e7\u0131klama ara",
          "searchColumns": [
            "code",
            "description"
          ],
          "filters": [
            "sourceLabel|select|row||Kaynak"
          ],
          "slot": "filters"
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Yevmiye fi\u015fleri",
          "query": "fisler",
          "paging": "server",
          "pageSize": 50,
          "columns": [
            "code",
            "entryDate",
            "sourceLabel",
            "description",
            "accountingBasis",
            "totalDebit",
            "totalCredit"
          ],
          "columnLabels": [
            "code=Fi\u015f",
            "entryDate=Tarih",
            "sourceLabel=Kaynak",
            "description=A\u00e7\u0131klama",
            "accountingBasis=Standart",
            "totalDebit=Bor\u00e7",
            "totalCredit=Alacak",
            "createdAt=Kay\u0131t zaman\u0131"
          ],
          "columnFormats": [
            "code=code",
            "entryDate=date",
            "sourceLabel=status",
            "totalDebit=money",
            "totalCredit=money",
            "createdAt=date"
          ],
          "totals": [
            "totalDebit",
            "totalCredit"
          ],
          "emptyText": "Se\u00e7ilen d\u00f6nemde yevmiye fi\u015fi yok.",
          "slot": "list",
          "rowActions": [
            "acDugmesi",
            "tersKayitDugmesi",
            "tersKayitSourced"
          ]
        }
      },
      {
        "id": "altBilgi",
        "type": "text",
        "name": "altBilgi",
        "props": {
          "text": "Kaydedilmi\u015f fi\u015f silinemez ve de\u011fi\u015ftirilemez; d\u00fczeltme \u0130\u015flemler \u203a Ters kay\u0131t olu\u015ftur ile yap\u0131l\u0131r. Kaynak s\u00fczgeci ve toplamlar yaln\u0131z g\u00f6r\u00fcnen sayfay\u0131 kapsar.",
          "slot": "below"
        }
      },
      {
        "id": "tersKayitDugmesi",
        "type": "button",
        "name": "tersKayitDugmesi",
        "props": {
          "text": "Ters kay\u0131t olu\u015ftur",
          "actionType": "query",
          "queryId": "tersKayit",
          "promptLabel": "Gerek\u00e7e",
          "promptRequired": true,
          "promptMaxLength": 240,
          "promptText": "{{liste.seciliSatir.code}} \u00b7 Fi\u015f ters \u00e7evrilsin mi? Ters kay\u0131t bug\u00fcn\u00fcn tarihiyle yaz\u0131l\u0131r; bor\u00e7 ve alacak yer de\u011fi\u015ftirir. Bir fi\u015f yaln\u0131z bir kez ters \u00e7evrilir.",
          "successMessage": "Ters kay\u0131t olu\u015fturuldu.",
          "refreshQueries": [
            "fisler",
            "fis"
          ],
          "visibleWhen": "liste.seciliSatir.isSourced != true && liste.seciliSatir.canReverse == true && kullanici.rol == 'TenantAdmin'",
          "slot": "rowActions"
        }
      },
      {
        "id": "tersKayitSourced",
        "type": "button",
        "name": "tersKayitSourced",
        "props": {
          "text": "Ters kay\u0131t olu\u015ftur",
          "actionType": "query",
          "queryId": "tersKayitKaynakli",
          "promptLabel": "Gerek\u00e7e",
          "promptRequired": true,
          "promptMaxLength": 240,
          "promptText": "{{liste.seciliSatir.code}} \u00b7 Bu fi\u015f {{liste.seciliSatir.sourceLabel}} belgesinden geldi. Ters kay\u0131ttan sonra belgeyi kendi ekran\u0131ndan iptal edin. Ters kay\u0131t bug\u00fcn\u00fcn tarihiyle yaz\u0131l\u0131r.",
          "successMessage": "Ters kay\u0131t olu\u015fturuldu. Kaynak belgeyi kendi ekran\u0131ndan iptal etmeyi unutmay\u0131n.",
          "refreshQueries": [
            "fisler",
            "fis"
          ],
          "visibleWhen": "liste.seciliSatir.isSourced == true && liste.seciliSatir.canReverse == true && kullanici.rol == 'TenantAdmin'",
          "slot": "rowActions"
        }
      },
      {
        "id": "fisPenceresi",
        "type": "dialog",
        "name": "fisPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "{{fis.rows[0].code}} \u00b7 {{fis.rows[0].sourceLabel}}",
          "contains": [
            "fisBasligi",
            "fisSatirTablosu",
            "zincirNotu",
            "tersNotu",
            "kaynakNotu"
          ],
          "slot": "dialogs"
        }
      },
      {
        "id": "fisBasligi",
        "type": "recordHeader",
        "name": "fisBasligi",
        "props": {
          "title": "{{fis.rows[0].code}}",
          "subtitle": "{{fis.rows[0].description}}",
          "fields": [
            "Fi\u015f tarihi={{fis.rows[0].entryDate}}",
            "Kaynak belge={{fis.rows[0].sourceLabel}}",
            "Standart={{fis.rows[0].accountingBasis}}",
            "Bor\u00e7={{fis.rows[0].totalDebit}}",
            "Alacak={{fis.rows[0].totalCredit}}",
            "Kay\u0131t zaman\u0131={{fis.rows[0].createdAt}}"
          ],
          "fieldFormats": [
            "Fi\u015f tarihi=date",
            "Bor\u00e7=money",
            "Alacak=money",
            "Kay\u0131t zaman\u0131=date"
          ],
          "slot": "dialog"
        }
      },
      {
        "id": "fisSatirTablosu",
        "type": "dataTable",
        "name": "fisSatirTablosu",
        "props": {
          "title": "Sat\u0131rlar",
          "query": "satirlar",
          "columns": [
            "lineNumber",
            "accountCode",
            "accountName",
            "description",
            "debit",
            "credit"
          ],
          "columnLabels": [
            "lineNumber=#",
            "accountCode=Hesap",
            "accountName=Hesap ad\u0131",
            "description=A\u00e7\u0131klama",
            "debit=Bor\u00e7",
            "credit=Alacak"
          ],
          "columnFormats": [
            "lineNumber=number",
            "accountCode=code",
            "debit=money",
            "credit=money"
          ],
          "totals": [
            "debit",
            "credit"
          ],
          "emptyText": "Fi\u015f sat\u0131r\u0131 yok.",
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showExport": false,
          "showPivot": false,
          "showCsv": false,
          "showSelectedExport": false,
          "slot": "dialog"
        }
      },
      {
        "id": "zincirNotu",
        "type": "text",
        "name": "zincirNotu",
        "props": {
          "text": "Fi\u015f zinciri: bu fi\u015f {{fis.rows[0].reversedByEntryCode}} ile ters \u00e7evrildi.",
          "visibleWhen": "fis.rows[0].reversedByEntryCode != null",
          "slot": "dialog"
        }
      },
      {
        "id": "tersNotu",
        "type": "text",
        "name": "tersNotu",
        "props": {
          "text": "Fi\u015f zinciri: bu fi\u015f {{fis.rows[0].reversalOfEntryCode}} fi\u015finin ters kayd\u0131d\u0131r; yeniden \u00e7evrilemez.",
          "visibleWhen": "fis.rows[0].isReversal == true",
          "slot": "dialog"
        }
      },
      {
        "id": "kaynakNotu",
        "type": "text",
        "name": "kaynakNotu",
        "props": {
          "text": "Kaynak belge: {{fis.rows[0].sourceLabel}} (ba\u011flant\u0131 yok). Kaynakl\u0131 fi\u015fin ters kayd\u0131ndan sonra belgeyi kendi ekran\u0131ndan iptal edin.",
          "visibleWhen": "fis.rows[0].isSourced == true && fis.rows[0].isReversal == false",
          "slot": "dialog"
        }
      },
      {
        "id": "baslangic",
        "type": "input",
        "name": "baslangic",
        "props": {
          "inputType": "date",
          "label": "Ba\u015flang\u0131\u00e7",
          "defaultValue": "{{tarih.ayBasi}}",
          "slot": "above"
        }
      },
      {
        "id": "bitis",
        "type": "input",
        "name": "bitis",
        "props": {
          "inputType": "date",
          "label": "Biti\u015f",
          "defaultValue": "{{bugun}}",
          "slot": "above"
        }
      },
      {
        "id": "standart",
        "type": "input",
        "name": "standart",
        "props": {
          "inputType": "select",
          "label": "Standart",
          "staticOptions": [
            "=T\u00fcm\u00fc",
            "TDHP=TDHP",
            "IFRS=IFRS"
          ],
          "slot": "above"
        }
      }
    ],
    "queries": [
      {
        "id": "fisler",
        "name": "fisler",
        "kind": "read",
        "operation": "finans.fis.listele",
        "runOn": "load",
        "parameters": [
          {
            "name": "from",
            "binding": "{{baslangic.value}}",
            "type": "date"
          },
          {
            "name": "to",
            "binding": "{{bitis.value}}",
            "type": "date"
          },
          {
            "name": "accountingBasis",
            "binding": "{{standart.value}}",
            "type": "text"
          },
          {
            "name": "page",
            "binding": "{{liste.sayfa}}",
            "type": "int"
          },
          {
            "name": "pageSize",
            "binding": "{{liste.sayfaBoyutu}}",
            "type": "int"
          }
        ]
      },
      {
        "id": "fis",
        "name": "fis",
        "kind": "read",
        "operation": "finans.fis.getir",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "satirlar",
        "name": "satirlar",
        "kind": "read",
        "operation": "finans.fis.satirlari",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "tersKayit",
        "name": "tersKayit",
        "kind": "insert",
        "operation": "finans.fis.tersKayit",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "entryDate",
            "binding": "{{bugun}}",
            "type": "date"
          },
          {
            "name": "reason",
            "binding": "{{tersKayitDugmesi.yanit}}",
            "type": "text"
          }
        ]
      },
      {
        "id": "tersKayitKaynakli",
        "name": "tersKayitKaynakli",
        "kind": "insert",
        "operation": "finans.fis.tersKayit",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "entryDate",
            "binding": "{{bugun}}",
            "type": "date"
          },
          {
            "name": "reason",
            "binding": "{{tersKayitSourced.yanit}}",
            "type": "text"
          }
        ]
      }
    ],
    "template": {
      "name": "list"
    }
  },
  "updates": [
    {
      "id": "fis-belgesi",
      "label": "Fi? sat?r?n? belge ekran?nda a?; Yeni fi?i Belge ekran?nda olu?tur",
      "below": 2,
      "set": [
        {
          "component": "acDugmesi",
          "prop": "actionType",
          "from": [
            "openDialog"
          ]
        },
        {
          "component": "acDugmesi",
          "prop": "pageCode",
          "from": [
            null
          ]
        },
        {
          "component": "acDugmesi",
          "prop": "target",
          "from": [
            null
          ]
        },
        {
          "component": "acDugmesi",
          "prop": "params",
          "from": [
            null
          ]
        }
      ]
    }
  ]
}
