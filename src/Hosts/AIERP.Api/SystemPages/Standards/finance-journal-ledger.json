{
  "screenKey": "finance-journal-ledger",
  "title": "Yevmiye Defterleri",
  "description": "Yevmiye fişleri: tarih ve standart süzgeci, fiş belgesi ve zinciri, sunucunun izin verdiği fişlerde ters kayıt.",
  "module": "Genel Muhasebe",
  "version": 1,
  "stage": "preview",
  "items": {
    "component:komutlar": {
      "since": 1,
      "label": "İşlem çubuğu",
      "requires": [
        "component:yeniFisDugmesi",
        "component:acDugmesi",
        "component:liste",
        "component:tersKayitDugmesi",
        "component:tersKayitSourced",
        "query:fisler"
      ]
    },
    "component:yeniFisDugmesi": {
      "since": 1,
      "label": "Yeni fiş komutu"
    },
    "component:acDugmesi": {
      "since": 1,
      "label": "Fişi aç",
      "requires": [
        "component:liste",
        "component:fisPenceresi"
      ]
    },
    "component:fisSayisiGostergesi": {
      "since": 1,
      "label": "Fiş sayısı göstergesi",
      "requires": [
        "query:fisler"
      ]
    },
    "component:tersKayitGostergesi": {
      "since": 1,
      "label": "Ters kayıt göstergesi (bu sayfa)",
      "requires": [
        "query:fisler"
      ]
    },
    "component:tarihKarti": {
      "since": 1,
      "label": "Tarih aralığı ve standart",
      "requires": [
        "component:baslangic",
        "component:bitis",
        "component:standart"
      ]
    },
    "component:baslangic": {
      "since": 1,
      "label": "Süzgeç: Başlangıç tarihi"
    },
    "component:bitis": {
      "since": 1,
      "label": "Süzgeç: Bitiş tarihi"
    },
    "component:standart": {
      "since": 1,
      "label": "Süzgeç: Muhasebe standardı"
    },
    "component:suzgec": {
      "since": 1,
      "label": "Süzgeç alanı (bu sayfa)",
      "requires": [
        "component:liste"
      ]
    },
    "component:liste": {
      "since": 1,
      "label": "Yevmiye fişleri listesi",
      "requires": [
        "component:acDugmesi",
        "query:fisler"
      ]
    },
    "component:altBilgi": {
      "since": 1,
      "label": "Liste alt bilgisi"
    },
    "component:tersKayitDugmesi": {
      "since": 1,
      "label": "Ters kayıt oluştur (manuel fiş)",
      "requires": [
        "component:liste",
        "query:fisler",
        "query:fis",
        "query:tersKayit"
      ]
    },
    "component:tersKayitSourced": {
      "since": 1,
      "label": "Ters kayıt oluştur (kaynaklı fiş)",
      "requires": [
        "component:liste",
        "query:fisler",
        "query:fis",
        "query:tersKayitKaynakli"
      ]
    },
    "component:fisPenceresi": {
      "since": 1,
      "label": "Fiş penceresi",
      "requires": [
        "component:fisBasligi",
        "component:fisSatirTablosu",
        "component:zincirNotu",
        "component:tersNotu",
        "component:kaynakNotu",
        "query:fis"
      ]
    },
    "component:fisBasligi": {
      "since": 1,
      "label": "Fiş başlığı",
      "requires": [
        "query:fis"
      ]
    },
    "component:fisSatirTablosu": {
      "since": 1,
      "label": "Fiş satırları",
      "requires": [
        "query:satirlar"
      ]
    },
    "component:zincirNotu": {
      "since": 1,
      "label": "Fiş zinciri: ters çevrildi",
      "requires": [
        "query:fis"
      ]
    },
    "component:tersNotu": {
      "since": 1,
      "label": "Fiş zinciri: ters kayıt fişi",
      "requires": [
        "query:fis"
      ]
    },
    "component:kaynakNotu": {
      "since": 1,
      "label": "Kaynak belge notu",
      "requires": [
        "query:fis"
      ]
    },
    "query:fisler": {
      "since": 1,
      "label": "Yevmiye fişlerini listele",
      "requires": [
        "component:baslangic",
        "component:bitis",
        "component:standart",
        "component:liste",
        "query:fis"
      ]
    },
    "query:fis": {
      "since": 1,
      "label": "Seçili fiş",
      "requires": [
        "component:liste"
      ]
    },
    "query:satirlar": {
      "since": 1,
      "label": "Seçili fişin satırları",
      "requires": [
        "component:liste",
        "query:fis"
      ]
    },
    "query:tersKayit": {
      "since": 1,
      "label": "Fişi ters çevir (manuel)",
      "requires": [
        "component:liste",
        "component:tersKayitDugmesi",
        "query:fis"
      ]
    },
    "query:tersKayitKaynakli": {
      "since": 1,
      "label": "Fişi ters çevir (kaynaklı)",
      "requires": [
        "component:liste",
        "component:tersKayitSourced",
        "query:fis",
        "query:tersKayit"
      ]
    }
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      {
        "id": "komutlar",
        "type": "actionBar",
        "name": "komutlar",
        "props": {
          "newButton": "yeniFisDugmesi",
          "openButton": "acDugmesi",
          "moreButtons": [
            "tersKayitDugmesi",
            "tersKayitSourced"
          ],
          "exportTable": "liste",
          "titleCount": "{{fisler.meta.totalCount}}",
          "hiddenCommands": ["save", "delete", "filter", "print"]
        }
      },
      {
        "id": "yeniFisDugmesi",
        "type": "button",
        "name": "yeniFisDugmesi",
        "props": {
          "text": "Yeni",
          "actionType": "page",
          "pageCode": "@finance-journal-vouchers",
          "target": "newTab"
        }
      },
      {
        "id": "acDugmesi",
        "type": "button",
        "name": "acDugmesi",
        "props": {
          "text": "Aç",
          "icon": "open",
          "actionType": "openDialog",
          "dialogId": "fisPenceresi",
          "disabledWhen": "liste.seciliSatir.id == null",
          "disabledReason": "Önce bir fiş seçin"
        }
      },
      {
        "id": "fisSayisiGostergesi",
        "type": "metric",
        "name": "fisSayisiGostergesi",
        "props": {
          "title": "Fiş sayısı",
          "value": "{{fisler.meta.totalCount}}",
          "format": "number",
          "width": 4,
          "icon": "files",
          "description": "süzgece göre"
        }
      },
      {
        "id": "tersKayitGostergesi",
        "type": "metric",
        "name": "tersKayitGostergesi",
        "props": {
          "title": "Ters kayıt",
          "query": "fisler",
          "width": 4,
          "icon": "refresh-cw",
          "description": "bu sayfa",
          "countWhen": "fisler.satir.isReversal == true"
        }
      },
      {
        "id": "tarihKarti",
        "type": "formCard",
        "name": "tarihKarti",
        "props": {
          "title": "Süzgeç",
          "layout": "inline",
          "width": 12,
          "inputs": [
            "baslangic",
            "bitis",
            "standart"
          ]
        }
      },
      {
        "id": "baslangic",
        "type": "input",
        "name": "baslangic",
        "props": {
          "inputType": "date",
          "label": "Başlangıç",
          "defaultValue": "{{tarih.ayBasi}}"
        }
      },
      {
        "id": "bitis",
        "type": "input",
        "name": "bitis",
        "props": {
          "inputType": "date",
          "label": "Bitiş",
          "defaultValue": "{{bugun}}"
        }
      },
      {
        "id": "standart",
        "type": "input",
        "name": "standart",
        "props": {
          "inputType": "select",
          "label": "Standart",
          "staticOptions": [
            "=Tümü",
            "TDHP=TDHP",
            "IFRS=IFRS"
          ]
        }
      },
      {
        "id": "suzgec",
        "type": "filterBar",
        "name": "suzgec",
        "props": {
          "table": "liste",
          "width": 12,
          "search": true,
          "searchPlaceholder": "Fiş no veya açıklama ara (bu sayfa)",
          "searchColumns": [
            "code",
            "description"
          ],
          "filters": [
            "sourceLabel|select|row||Kaynak (bu sayfa)"
          ]
        }
      },
      {
        "id": "liste",
        "type": "dataTable",
        "name": "liste",
        "props": {
          "title": "Yevmiye fişleri",
          "query": "fisler",
          "paging": "server",
          "pageSize": 50,
          "width": 12,
          "columns": [
            "code",
            "entryDate",
            "sourceLabel",
            "description",
            "accountingBasis",
            "totalDebit",
            "totalCredit",
            "isReversed"
          ],
          "columnLabels": [
            "code=Fiş",
            "entryDate=Tarih",
            "sourceLabel=Kaynak",
            "description=Açıklama",
            "accountingBasis=Standart",
            "totalDebit=Borç",
            "totalCredit=Alacak",
            "isReversed=Ters kayıt",
            "createdAt=Kayıt zamanı"
          ],
          "columnFormats": [
            "code=code",
            "entryDate=date",
            "sourceLabel=status",
            "totalDebit=money",
            "totalCredit=money",
            "isReversed=status",
            "createdAt=date"
          ],
          "valueLabels": [
            "isReversed:true=Ters kaydı var",
            "isReversed:false=—"
          ],
          "toneMap": [
            "Ters kaydı var=warning",
            "Ters kayıt=info"
          ],
          "totals": [
            "totalDebit",
            "totalCredit"
          ],
          "rowOpenAction": "acDugmesi",
          "emptyText": "Seçilen dönemde yevmiye fişi yok."
        }
      },
      {
        "id": "altBilgi",
        "type": "text",
        "name": "altBilgi",
        "props": {
          "text": "Kaydedilmiş fiş silinemez ve değiştirilemez; düzeltme İşlemler › Ters kayıt oluştur ile yapılır. Kaynak süzgeci ve toplamlar yalnız görünen sayfayı kapsar."
        }
      },
      {
        "id": "tersKayitDugmesi",
        "type": "button",
        "name": "tersKayitDugmesi",
        "props": {
          "text": "Ters kayıt oluştur",
          "actionType": "query",
          "queryId": "tersKayit",
          "promptLabel": "Gerekçe",
          "promptRequired": true,
          "promptMaxLength": 240,
          "promptText": "{{liste.seciliSatir.code}} · Fiş ters çevrilsin mi? Ters kayıt bugünün tarihiyle yazılır; borç ve alacak yer değiştirir. Bir fiş yalnız bir kez ters çevrilir.",
          "successMessage": "Ters kayıt oluşturuldu.",
          "refreshQueries": [
            "fisler",
            "fis"
          ],
          "visibleWhen": "liste.seciliSatir.isSourced != true",
          "disabledWhen": "liste.seciliSatir.canReverse != true || kullanici.rol != 'TenantAdmin'",
          "disabledReason": "Bu fiş ters çevrilemez (ters kayıt fişi, zaten ters çevrilmiş ya da yetki yok)."
        }
      },
      {
        "id": "tersKayitSourced",
        "type": "button",
        "name": "tersKayitSourced",
        "props": {
          "text": "Ters kayıt oluştur",
          "actionType": "query",
          "queryId": "tersKayitKaynakli",
          "promptLabel": "Gerekçe",
          "promptRequired": true,
          "promptMaxLength": 240,
          "promptText": "{{liste.seciliSatir.code}} · Bu fiş {{liste.seciliSatir.sourceLabel}} belgesinden geldi. Ters kayıttan sonra belgeyi kendi ekranından iptal edin. Ters kayıt bugünün tarihiyle yazılır.",
          "successMessage": "Ters kayıt oluşturuldu. Kaynak belgeyi kendi ekranından iptal etmeyi unutmayın.",
          "refreshQueries": [
            "fisler",
            "fis"
          ],
          "visibleWhen": "liste.seciliSatir.isSourced == true",
          "disabledWhen": "liste.seciliSatir.canReverse != true || kullanici.rol != 'TenantAdmin'",
          "disabledReason": "Bu kaynak türü ters kayıtla kapatılamaz ya da fiş zaten ters çevrilmiş (dönem kapanışı, bordro, sabit kıymet, kredi ve çek/senet fişleri kendi ekranından)."
        }
      },
      {
        "id": "fisPenceresi",
        "type": "dialog",
        "name": "fisPenceresi",
        "props": {
          "presentation": "dialog",
          "size": "xl",
          "title": "{{fis.rows[0].code}} · {{fis.rows[0].sourceLabel}}",
          "contains": [
            "fisBasligi",
            "fisSatirTablosu",
            "zincirNotu",
            "tersNotu",
            "kaynakNotu"
          ]
        }
      },
      {
        "id": "fisBasligi",
        "type": "recordHeader",
        "name": "fisBasligi",
        "props": {
          "title": "{{fis.rows[0].code}}",
          "subtitle": "{{fis.rows[0].description}}",
          "fields": [
            "Fiş tarihi={{fis.rows[0].entryDate}}",
            "Kaynak belge={{fis.rows[0].sourceLabel}}",
            "Standart={{fis.rows[0].accountingBasis}}",
            "Borç={{fis.rows[0].totalDebit}}",
            "Alacak={{fis.rows[0].totalCredit}}",
            "Kayıt zamanı={{fis.rows[0].createdAt}}"
          ],
          "fieldFormats": [
            "Fiş tarihi=date",
            "Borç=money",
            "Alacak=money",
            "Kayıt zamanı=date"
          ]
        }
      },
      {
        "id": "fisSatirTablosu",
        "type": "dataTable",
        "name": "fisSatirTablosu",
        "props": {
          "title": "Satırlar",
          "query": "satirlar",
          "width": 12,
          "columns": [
            "lineNumber",
            "accountCode",
            "accountName",
            "description",
            "debit",
            "credit"
          ],
          "columnLabels": [
            "lineNumber=#",
            "accountCode=Hesap",
            "accountName=Hesap adı",
            "description=Açıklama",
            "debit=Borç",
            "credit=Alacak"
          ],
          "columnFormats": [
            "lineNumber=number",
            "accountCode=code",
            "debit=money",
            "credit=money"
          ],
          "totals": [
            "debit",
            "credit"
          ],
          "emptyText": "Fiş satırı yok.",
          "showGridSearch": false,
          "showColumnFilters": false,
          "showColumnChooser": false,
          "showExport": false,
          "showPivot": false,
          "showCsv": false,
          "showSelectedExport": false
        }
      },
      {
        "id": "zincirNotu",
        "type": "text",
        "name": "zincirNotu",
        "props": {
          "text": "Fiş zinciri: bu fiş {{fis.rows[0].reversedByEntryCode}} ile ters çevrildi.",
          "visibleWhen": "fis.rows[0].reversedByEntryCode != null"
        }
      },
      {
        "id": "tersNotu",
        "type": "text",
        "name": "tersNotu",
        "props": {
          "text": "Fiş zinciri: bu fiş {{fis.rows[0].reversalOfEntryCode}} fişinin ters kaydıdır; yeniden çevrilemez.",
          "visibleWhen": "fis.rows[0].isReversal == true"
        }
      },
      {
        "id": "kaynakNotu",
        "type": "text",
        "name": "kaynakNotu",
        "props": {
          "text": "Kaynak belge: {{fis.rows[0].sourceLabel}} (bağlantı yok). Kaynaklı fişin ters kaydından sonra belgeyi kendi ekranından iptal edin.",
          "visibleWhen": "fis.rows[0].isSourced == true && fis.rows[0].isReversal == false"
        }
      }
    ],
    "queries": [
      {
        "id": "fisler",
        "name": "fisler",
        "kind": "read",
        "operation": "finans.fis.listele",
        "runOn": "load",
        "parameters": [
          {
            "name": "from",
            "binding": "{{baslangic.value}}",
            "type": "date"
          },
          {
            "name": "to",
            "binding": "{{bitis.value}}",
            "type": "date"
          },
          {
            "name": "accountingBasis",
            "binding": "{{standart.value}}",
            "type": "text"
          },
          {
            "name": "page",
            "binding": "{{liste.sayfa}}",
            "type": "int"
          },
          {
            "name": "pageSize",
            "binding": "{{liste.sayfaBoyutu}}",
            "type": "int"
          }
        ]
      },
      {
        "id": "fis",
        "name": "fis",
        "kind": "read",
        "operation": "finans.fis.getir",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "satirlar",
        "name": "satirlar",
        "kind": "read",
        "operation": "finans.fis.satirlari",
        "runOn": "load",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          }
        ]
      },
      {
        "id": "tersKayit",
        "name": "tersKayit",
        "kind": "insert",
        "operation": "finans.fis.tersKayit",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "entryDate",
            "binding": "{{bugun}}",
            "type": "date"
          },
          {
            "name": "reason",
            "binding": "{{tersKayitDugmesi.yanit}}",
            "type": "text"
          }
        ]
      },
      {
        "id": "tersKayitKaynakli",
        "name": "tersKayitKaynakli",
        "kind": "insert",
        "operation": "finans.fis.tersKayit",
        "runOn": "manual",
        "parameters": [
          {
            "name": "id",
            "binding": "{{liste.seciliSatir.id}}",
            "type": "guid"
          },
          {
            "name": "entryDate",
            "binding": "{{bugun}}",
            "type": "date"
          },
          {
            "name": "reason",
            "binding": "{{tersKayitSourced.yanit}}",
            "type": "text"
          }
        ]
      }
    ]
  }
}
