{
  "screenKey": "hr-leave-requests", "title": "İzin talepleri",
  "description": "İzin taleplerini oluşturun, bekleyenleri onaylayın ya da reddedin. Liste 'Bekliyor' süzgeciyle açılır.", "module": "İnsan Kaynakları",
  "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:suzgec", "component:liste", "component:talepDugmesi", "query:izinler"]},
    "component:talepDugmesi": {"since": 1, "label": "İzin talebi komutu", "requires": ["component:talepPenceresi"]},
    "component:suzgec": {"since": 1, "label": "Süzgeç alanı (arama)", "requires": ["component:liste"]},
    "component:suzgecSecimleri": {"since": 1, "label": "Süzgeçler (durum, tür, personel, tarih aralığı)", "requires": ["component:durumSecimi", "component:turSecimi", "component:personelSecimi", "component:baslangicSecimi", "component:bitisSecimi"]},
    "component:durumSecimi": {"since": 1, "label": "Durum seçimi (varsayılan Bekliyor)"},
    "component:turSecimi": {"since": 1, "label": "İzin türü seçimi"},
    "component:personelSecimi": {"since": 1, "label": "Personel süzgeci", "requires": ["query:suzgecPersonelleri"]},
    "component:baslangicSecimi": {"since": 1, "label": "Tarih aralığı: başlangıç"},
    "component:bitisSecimi": {"since": 1, "label": "Tarih aralığı: bitiş"},
    "component:personelDurumu": {"since": 1, "label": "Personel seçici durumu (gizli)"},
    "component:personelSayfaBoyutu": {"since": 1, "label": "Personel seçici sayfa boyutu (gizli)"},
    "component:liste": {"since": 1, "label": "İzin talepleri listesi", "requires": ["query:izinler"]},
    "component:detayKarti": {"since": 1, "label": "Detay: talep özeti, not, Onayla / Reddet / İptal et", "requires": ["component:liste", "query:onayla", "query:reddet", "query:iptal"]},
    "component:talepPenceresi": {"since": 1, "label": "İzin talebi penceresi", "requires": ["component:talepBilgileri", "component:talepNotu", "component:personelDurumu", "component:personelSayfaBoyutu", "query:talepEt", "query:izinler"]},
    "component:talepBilgileri": {"since": 1, "label": "İzin talebi alanları", "requires": ["component:talepPersoneli", "component:talepTuru", "component:talepBaslangic", "component:talepBitis", "component:talepGun", "component:talepAciklama"]},
    "component:talepPersoneli": {"since": 1, "label": "Talep alanı: Personel", "requires": ["query:talepPersonelleri"]},
    "component:talepTuru": {"since": 1, "label": "Talep alanı: İzin türü"},
    "component:talepBaslangic": {"since": 1, "label": "Talep alanı: Başlangıç"},
    "component:talepBitis": {"since": 1, "label": "Talep alanı: Bitiş"},
    "component:talepGun": {"since": 1, "label": "Talep alanı: Talep edilen gün"},
    "component:talepAciklama": {"since": 1, "label": "Talep alanı: Not"},
    "component:talepNotu": {"since": 1, "label": "İzin talebi bilgi notu"},
    "query:izinler": {"since": 1, "label": "İzin taleplerini listele", "requires": ["component:suzgec", "component:durumSecimi", "component:turSecimi", "component:personelSecimi", "component:baslangicSecimi", "component:bitisSecimi", "component:liste"]},
    "query:suzgecPersonelleri": {"since": 1, "label": "Personel süzgeci seçenekleri", "requires": ["component:personelSecimi", "component:personelSayfaBoyutu"]},
    "query:talepPersonelleri": {"since": 1, "label": "İzin talebi personel seçenekleri (aktif)", "requires": ["component:talepPersoneli", "component:personelDurumu", "component:personelSayfaBoyutu"]},
    "query:talepEt": {"since": 1, "label": "İzin talebi oluştur", "requires": ["component:talepPersoneli", "component:talepTuru", "component:talepBaslangic", "component:talepBitis", "component:talepGun", "component:talepAciklama"]},
    "query:onayla": {"since": 1, "label": "İzin talebini onayla", "requires": ["component:liste"]},
    "query:reddet": {"since": 1, "label": "İzin talebini reddet", "requires": ["component:liste", "component:detayKarti"]},
    "query:iptal": {"since": 1, "label": "İzin talebini iptal et", "requires": ["component:liste"]}
  },
  "screenViews": [{"key": "hr-leave-requests", "component": "liste", "fields": {"employee": "employee", "leaveType": "leaveType", "startDate": "startDate", "endDate": "endDate", "requestedDays": "requestedDays", "status": "status"}}],
  "definition": {
    "schemaVersion": 2,
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"focusInput": "suzgec", "exportTable": "liste", "titleCount": "{{izinler.meta.totalCount}}", "newButton": "talepDugmesi", "hiddenCommands": ["open", "save", "delete", "print"], "slot": "commands"}},
      {"id": "talepDugmesi", "type": "button", "name": "talepDugmesi", "props": {"text": "İzin talebi", "icon": "plus", "actionType": "openDialog", "dialogId": "talepPenceresi", "slot": "actions"}},
      {"id": "suzgec", "type": "filterBar", "name": "suzgec", "props": {"table": "liste", "search": true, "searchPlaceholder": "Personel veya not", "searchParam": "q", "slot": "filters"}},
      {"id": "suzgecSecimleri", "type": "formCard", "name": "suzgecSecimleri", "props": {"title": "Süzgeçler", "layout": "inline", "inputs": ["durumSecimi", "turSecimi", "personelSecimi", "baslangicSecimi", "bitisSecimi"], "slot": "above"}},
      {"id": "durumSecimi", "type": "input", "name": "durumSecimi", "props": {"inputType": "select", "label": "Durum", "defaultValue": "Requested", "staticOptions": ["=Tümü", "Requested=Bekliyor", "Approved=Onaylandı", "Rejected=Reddedildi", "Cancelled=İptal"], "slot": "above"}},
      {"id": "turSecimi", "type": "input", "name": "turSecimi", "props": {"inputType": "select", "label": "Tür", "staticOptions": ["=Tümü", "Annual=Yıllık", "Health=Sağlık", "Unpaid=Ücretsiz", "Excuse=Mazeret", "Other=Diğer"], "slot": "above"}},
      {"id": "personelSecimi", "type": "input", "name": "personelSecimi", "props": {"inputType": "lookup", "label": "Personel", "optionsQuery": "suzgecPersonelleri", "optionValueColumn": "id", "optionLabelColumn": "fullName", "optionDescriptionColumn": "personnelCode", "minChars": 0, "allowClear": true, "placeholder": "Tümü", "defaultValue": "{{sayfa.parametre.employeeId}}", "slot": "above"}},
      {"id": "baslangicSecimi", "type": "input", "name": "baslangicSecimi", "props": {"inputType": "date", "label": "Başlangıç", "slot": "above"}},
      {"id": "bitisSecimi", "type": "input", "name": "bitisSecimi", "props": {"inputType": "date", "label": "Bitiş", "slot": "above"}},
      {"id": "personelDurumu", "type": "input", "name": "personelDurumu", "props": {"inputType": "text", "label": "Personel seçici durumu", "hidden": true, "defaultValue": "Active", "slot": "above"}},
      {"id": "personelSayfaBoyutu", "type": "input", "name": "personelSayfaBoyutu", "props": {"inputType": "number", "label": "Personel seçici sayfa boyutu", "hidden": true, "defaultValue": "50", "slot": "above"}},
      {"id": "liste", "type": "dataTable", "name": "liste", "props": {"title": "İzin talepleri", "query": "izinler", "paging": "server", "pageSize": 50, "columns": ["employee", "department", "leaveType", "startDate", "endDate", "requestedDays", "status"], "columnLabels": ["employee=Personel", "department=Departman", "leaveType=Tür", "startDate=Başlangıç", "endDate=Bitiş", "requestedDays=Gün", "status=Durum", "note=Not", "reviewNote=Değerlendirme notu", "createdAt=Talep zamanı"], "columnFormats": ["leaveType=status", "startDate=date", "endDate=date", "requestedDays=number", "status=status", "createdAt=datetime"], "valueLabels": ["leaveType:Annual=Yıllık", "leaveType:Health=Sağlık", "leaveType:Unpaid=Ücretsiz", "leaveType:Excuse=Mazeret", "leaveType:Other=Diğer", "status:Requested=Bekliyor", "status:Approved=Onaylandı", "status:Rejected=Reddedildi", "status:Cancelled=İptal"], "toneMap": ["Bekliyor=warning", "Onaylandı=success", "Reddedildi=danger", "İptal=info"], "emptyText": "Bu süzgeçle eşleşen izin talebi yok. Yönetici değilseniz yalnız kendi talepleriniz görünür.", "slot": "list"}},
      {"id": "detayKarti", "type": "card", "name": "detayKarti", "props": {"variant": "panel", "title": "{{liste.seciliSatir.employee}}", "description": "{{liste.seciliSatir.department}}", "slot": "detail"}, "children": [{"id": "detayBekliyor", "type": "badge", "name": "detayBekliyor", "props": {"text": "Bekliyor", "variant": "warning", "visibleWhen": "liste.seciliSatir.status == 'Requested'"}}, {"id": "detayOnaylandi", "type": "badge", "name": "detayOnaylandi", "props": {"text": "Onaylandı", "variant": "success", "visibleWhen": "liste.seciliSatir.status == 'Approved'"}}, {"id": "detayReddedildi", "type": "badge", "name": "detayReddedildi", "props": {"text": "Reddedildi", "variant": "danger", "visibleWhen": "liste.seciliSatir.status == 'Rejected'"}}, {"id": "detayIptal", "type": "badge", "name": "detayIptal", "props": {"text": "İptal", "variant": "info", "visibleWhen": "liste.seciliSatir.status == 'Cancelled'"}}, {"id": "detayBos", "type": "text", "name": "detayBos", "props": {"text": "Bir talep seçin; özetini burada görün.", "visibleWhen": "liste.seciliSatir.id == null"}}, {"id": "ozetPaneli", "type": "contextPanel", "name": "ozetPaneli", "props": {"table": "liste", "visibleWhen": "liste.seciliSatir.id != null", "fields": ["leaveType=Tür", "startDate=Başlangıç", "endDate=Bitiş", "requestedDays=Talep edilen gün", "status=Durum", "reviewNote=Değerlendirme notu"]}}, {"id": "notMetni", "type": "text", "name": "notMetni", "props": {"title": "Not", "text": "{{liste.seciliSatir.note}}", "visibleWhen": "liste.seciliSatir.id != null && liste.seciliSatir.note != null"}}, {"id": "notYok", "type": "text", "name": "notYok", "props": {"text": "Bu talep için not girilmemiş.", "visibleWhen": "liste.seciliSatir.id != null && liste.seciliSatir.note == null"}}, {"id": "onaylaDugmesi", "type": "button", "name": "onaylaDugmesi", "props": {"text": "Onayla", "icon": "check", "actionType": "query", "queryId": "onayla", "visibleWhen": "liste.seciliSatir.status == 'Requested'", "disabledWhen": "liste.seciliSatir.canReview != true", "disabledReason": "Başka bir yönetici onaylamalı", "successMessage": "{{liste.seciliSatir.employee}}: izin talebi onaylandı.", "refreshQueries": ["izinler"]}}, {"id": "reddetDugmesi", "type": "button", "name": "reddetDugmesi", "props": {"text": "Reddet…", "icon": "ban", "actionType": "query", "queryId": "reddet", "promptLabel": "Ret notu (isteğe bağlı)", "promptRequired": false, "promptMaxLength": 1000, "promptText": "{{liste.seciliSatir.employee}} · izin talebi reddedilecek. İsterseniz bir not yazın.", "visibleWhen": "liste.seciliSatir.status == 'Requested'", "disabledWhen": "liste.seciliSatir.canReview != true", "disabledReason": "Başka bir yönetici onaylamalı", "successMessage": "{{liste.seciliSatir.employee}}: izin talebi reddedildi.", "refreshQueries": ["izinler"]}}, {"id": "iptalDugmesi", "type": "button", "name": "iptalDugmesi", "props": {"text": "İptal et", "actionType": "query", "queryId": "iptal", "visibleWhen": "liste.seciliSatir.canCancel == true", "successMessage": "İzin talebi iptal edildi.", "refreshQueries": ["izinler"]}}]},
      {"id": "talepPenceresi", "type": "dialog", "name": "talepPenceresi", "props": {"presentation": "dialog", "size": "lg", "title": "İzin talebi", "contains": ["talepBilgileri", "talepNotu"], "saveQuery": "talepEt", "saveLabel": "Talep et", "closeOnSave": true, "resetOnOpen": true, "refreshQueries": ["izinler"], "slot": "dialogs"}},
      {"id": "talepBilgileri", "type": "formCard", "name": "talepBilgileri", "props": {"title": "Talep", "columns": 2, "inputs": ["talepPersoneli", "talepTuru", "talepBaslangic", "talepBitis", "talepGun", "talepAciklama"], "slot": "dialog"}},
      {"id": "talepPersoneli", "type": "input", "name": "talepPersoneli", "props": {"inputType": "lookup", "label": "Personel", "required": true, "optionsQuery": "talepPersonelleri", "optionValueColumn": "id", "optionLabelColumn": "fullName", "optionDescriptionColumn": "personnelCode", "minChars": 0, "placeholder": "Personel seçin (yalnız aktif personel)", "slot": "dialog"}},
      {"id": "talepTuru", "type": "input", "name": "talepTuru", "props": {"inputType": "select", "label": "İzin türü", "required": true, "defaultValue": "Annual", "staticOptions": ["Annual=Yıllık", "Health=Sağlık", "Unpaid=Ücretsiz", "Excuse=Mazeret", "Other=Diğer"], "slot": "dialog"}},
      {"id": "talepBaslangic", "type": "input", "name": "talepBaslangic", "props": {"inputType": "date", "label": "Başlangıç", "required": true, "defaultValue": "{{bugun}}", "slot": "dialog"}},
      {"id": "talepBitis", "type": "input", "name": "talepBitis", "props": {"inputType": "date", "label": "Bitiş", "required": true, "defaultValue": "{{bugun}}", "slot": "dialog"}},
      {"id": "talepGun", "type": "input", "name": "talepGun", "props": {"inputType": "number", "label": "Talep edilen gün", "min": 0.01, "max": 366, "step": 0.01, "placeholder": "Boşsa takvim günü", "slot": "dialog"}},
      {"id": "talepAciklama", "type": "input", "name": "talepAciklama", "props": {"inputType": "text", "label": "Not", "maxLength": 1000, "placeholder": "En çok 1000 karakter", "slot": "dialog"}},
      {"id": "talepNotu", "type": "text", "name": "talepNotu", "props": {"text": "Talep edilen gün boş bırakılırsa tarih aralığının takvim günü yazılır; yarım gün gibi durumlar elle girilir. Çakışan bekleyen ya da onaylı izin varsa talep reddedilir.", "slot": "dialog"}}
    ],
    "queries": [
      {"id": "izinler", "name": "izinler", "kind": "read", "operation": "ik.izin.listele", "runOn": "load", "parameters": [{"name": "q", "binding": "{{suzgec.q}}", "type": "text"}, {"name": "status", "binding": "{{durumSecimi.value}}", "type": "text"}, {"name": "leaveType", "binding": "{{turSecimi.value}}", "type": "text"}, {"name": "employeeId", "binding": "{{personelSecimi.value}}", "type": "guid"}, {"name": "from", "binding": "{{baslangicSecimi.value}}", "type": "date"}, {"name": "to", "binding": "{{bitisSecimi.value}}", "type": "date"}, {"name": "page", "binding": "{{liste.sayfa}}", "type": "int"}, {"name": "pageSize", "binding": "{{liste.sayfaBoyutu}}", "type": "int"}]},
      {"id": "suzgecPersonelleri", "name": "suzgecPersonelleri", "kind": "read", "operation": "ik.personel.listele", "runOn": "load", "parameters": [{"name": "q", "binding": "{{personelSecimi.search}}", "type": "text"}, {"name": "pageSize", "binding": "{{personelSayfaBoyutu.value}}", "type": "int"}]},
      {"id": "talepPersonelleri", "name": "talepPersonelleri", "kind": "read", "operation": "ik.personel.listele", "runOn": "load", "parameters": [{"name": "q", "binding": "{{talepPersoneli.search}}", "type": "text"}, {"name": "status", "binding": "{{personelDurumu.value}}", "type": "text"}, {"name": "pageSize", "binding": "{{personelSayfaBoyutu.value}}", "type": "int"}]},
      {"id": "talepEt", "name": "talepEt", "kind": "insert", "operation": "ik.izin.talepEt", "runOn": "manual", "parameters": [{"name": "employeeId", "binding": "{{talepPersoneli.value}}", "type": "guid"}, {"name": "leaveType", "binding": "{{talepTuru.value}}", "type": "text"}, {"name": "startDate", "binding": "{{talepBaslangic.value}}", "type": "date"}, {"name": "endDate", "binding": "{{talepBitis.value}}", "type": "date"}, {"name": "requestedDays", "binding": "{{talepGun.value}}", "type": "decimal"}, {"name": "note", "binding": "{{talepAciklama.value}}", "type": "text"}]},
      {"id": "onayla", "name": "onayla", "kind": "update", "operation": "ik.izin.onayla", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}, {"name": "rowVersion", "binding": "{{liste.seciliSatir.rowVersion}}", "type": "text"}]},
      {"id": "reddet", "name": "reddet", "kind": "update", "operation": "ik.izin.reddet", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}, {"name": "note", "binding": "{{reddetDugmesi.yanit}}", "type": "text"}, {"name": "rowVersion", "binding": "{{liste.seciliSatir.rowVersion}}", "type": "text"}]},
      {"id": "iptal", "name": "iptal", "kind": "update", "operation": "ik.izin.iptal", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{liste.seciliSatir.id}}", "type": "guid"}, {"name": "rowVersion", "binding": "{{liste.seciliSatir.rowVersion}}", "type": "text"}]}
    ],
    "template": {"name": "list"}
  }
}
