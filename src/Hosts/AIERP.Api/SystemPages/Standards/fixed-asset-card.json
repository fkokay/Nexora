{
  "screenKey": "fixed-asset-card", "title": "Kıymet kartı",
  "description": "Duran varlık kartı (salt okunur): genel bilgiler, amortisman tablosu, edinim muhasebesi, zimmet geçmişi ve elden çıkarma.", "module": "Duran Varlık",
  "version": 1, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:amortismanDugmesi", "component:eldenCikarDugmesi", "component:zimmetleDugmesi", "component:eskiEkranDugmesi"]},
    "component:baslik": {"since": 1, "label": "Başlık (kıymet adı)", "requires": ["query:kiymet"]},
    "component:etkinEtiketi": {"since": 1, "label": "Durum etiketi: Etkin", "requires": ["query:kiymet"]},
    "component:cikarildiEtiketi": {"since": 1, "label": "Durum etiketi: Elden çıkarıldı", "requires": ["query:kiymet"]},
    "component:kartOzeti": {"since": 1, "label": "Kart özeti", "requires": ["component:kapatDugmesi", "query:kiymet"]},
    "component:kapatDugmesi": {"since": 1, "label": "Kapat (listeye dön)"},
    "component:saltOkunurNotu": {"since": 1, "label": "Salt okunur notu"},
    "component:kayitYok": {"since": 1, "label": "Kıymet bulunamadı notu", "requires": ["query:kiymet"]},
    "component:sekmeler": {"since": 1, "label": "Kart sekmeleri", "requires": ["component:genelKimlik", "component:genelMaliyet", "component:genelDefter", "component:genelAltSinir", "component:genelVuk", "component:defterSecimi", "component:planBirikmis", "component:planNetDefter", "component:planSiradaki", "component:planTablosu", "component:planNotu", "component:vukUyarisi", "component:vukSiradaki", "component:vukSiradakiTutar", "component:vukTablosu", "component:vergiKaydiDugmesi", "component:edinimFisi", "component:edinimSatirlari", "component:edinimFaturaNotu", "component:edinimKarti", "component:edinimNotu", "component:edinimDugmesi", "component:zimmetTablosu", "component:iadeDugmesi", "component:zimmetleSekme", "component:zimmetNotu", "component:cikarmaOzeti", "component:cikarilmadiNotu", "query:plan", "query:vergiPlan", "query:muhasebe", "query:zimmetler"]},
    "component:genelKimlik": {"since": 1, "label": "Genel: Kimlik", "requires": ["query:kiymet"]},
    "component:genelMaliyet": {"since": 1, "label": "Genel: Maliyet ve amortisman", "requires": ["query:kiymet"]},
    "component:genelDefter": {"since": 1, "label": "Genel: Defter değeri", "requires": ["query:kiymet"]},
    "component:genelAltSinir": {"since": 1, "label": "Genel: VUK alt sınırı", "requires": ["query:kiymet"]},
    "component:genelVuk": {"since": 1, "label": "Genel: VUK profili", "requires": ["query:kiymet"]},
    "component:defterSecimi": {"since": 1, "label": "Amortisman: defter seçimi kartı", "requires": ["component:defterTuru", "query:kiymet"]},
    "component:defterTuru": {"since": 1, "label": "Amortisman: Muhasebe / VUK"},
    "component:planBirikmis": {"since": 1, "label": "Amortisman: birikmiş", "requires": ["component:defterTuru", "query:kiymet"]},
    "component:planNetDefter": {"since": 1, "label": "Amortisman: net defter", "requires": ["component:defterTuru", "query:kiymet"]},
    "component:planSiradaki": {"since": 1, "label": "Amortisman: sıradaki dönem", "requires": ["component:defterTuru", "query:plan"]},
    "component:planTablosu": {"since": 1, "label": "Amortisman tablosu", "requires": ["component:defterTuru", "query:plan"]},
    "component:planNotu": {"since": 1, "label": "Amortisman: kural notu", "requires": ["component:defterTuru"]},
    "component:vukUyarisi": {"since": 1, "label": "VUK: tahmin uyarısı", "requires": ["component:defterTuru"]},
    "component:vukSiradaki": {"since": 1, "label": "VUK: sıradaki dönem", "requires": ["component:defterTuru", "query:vergiPlan"]},
    "component:vukSiradakiTutar": {"since": 1, "label": "VUK: sıradaki dönem tutarı", "requires": ["component:defterTuru", "query:vergiPlan"]},
    "component:vukTablosu": {"since": 1, "label": "VUK vergi amortismanı tablosu", "requires": ["component:defterTuru", "query:vergiPlan"]},
    "component:vergiKaydiDugmesi": {"since": 1, "label": "VUK: vergi kaydı oluştur", "requires": ["component:defterTuru", "query:kiymet", "query:vergiPlan", "query:vergiKaydet"]},
    "component:edinimFisi": {"since": 1, "label": "Edinim: fiş bilgisi", "requires": ["query:muhasebe"]},
    "component:edinimSatirlari": {"since": 1, "label": "Edinim: fiş satırları", "requires": ["query:muhasebe"]},
    "component:edinimFaturaNotu": {"since": 1, "label": "Edinim: alış faturası notu", "requires": ["query:kiymet", "query:muhasebe"]},
    "component:edinimKarti": {"since": 1, "label": "Edinim: karşı hesap kartı", "requires": ["component:karsiHesap", "query:kiymet", "query:muhasebe"]},
    "component:karsiHesap": {"since": 1, "label": "Alan: Edinim karşı hesabı", "requires": ["query:hesaplar"]},
    "component:edinimNotu": {"since": 1, "label": "Edinim: kural notu", "requires": ["query:kiymet", "query:muhasebe"]},
    "component:edinimDugmesi": {"since": 1, "label": "Edinimi yevmiyeleştir", "requires": ["query:kiymet", "query:muhasebe", "query:yevmiyele"]},
    "component:zimmetTablosu": {"since": 1, "label": "Zimmet geçmişi", "requires": ["query:zimmetler"]},
    "component:iadeDugmesi": {"since": 1, "label": "Zimmet: iade al", "requires": ["component:zimmetTablosu", "query:iadeAl", "query:zimmetler", "query:kiymet"]},
    "component:zimmetleSekme": {"since": 1, "label": "Zimmet: zimmetle (eski ekran)", "requires": ["query:kiymet"]},
    "component:zimmetNotu": {"since": 1, "label": "Zimmet: not"},
    "component:cikarmaOzeti": {"since": 1, "label": "Elden çıkarma özeti", "requires": ["query:kiymet"]},
    "component:cikarilmadiNotu": {"since": 1, "label": "Elden çıkarılmadı notu", "requires": ["query:kiymet"]},
    "component:amortismanDugmesi": {"since": 1, "label": "Amortismanı kaydet komutu", "requires": ["component:amortismanPenceresi", "query:kiymet"]},
    "component:eldenCikarDugmesi": {"since": 1, "label": "Elden çıkar komutu", "requires": ["component:eldenCikarmaPenceresi", "query:kiymet"]},
    "component:zimmetleDugmesi": {"since": 1, "label": "Zimmetle komutu (eski ekran)", "requires": ["query:kiymet"]},
    "component:eskiEkranDugmesi": {"since": 1, "label": "Eski ekranda aç komutu"},
    "component:amortismanPenceresi": {"since": 1, "label": "Amortismanı kaydet penceresi", "requires": ["component:amortismanDonemi", "component:amortismanTutari", "component:amortismanNotu", "component:amortismanUyarisi", "component:amortismanKaydetDugmesi", "query:plan", "query:kiymet"]},
    "component:amortismanDonemi": {"since": 1, "label": "Amortisman: kaydedilecek dönem", "requires": ["query:plan"]},
    "component:amortismanTutari": {"since": 1, "label": "Amortisman: tutar", "requires": ["query:plan"]},
    "component:amortismanNotu": {"since": 1, "label": "Amortisman: pencere notu"},
    "component:amortismanUyarisi": {"since": 1, "label": "Amortisman: geri alınamaz uyarısı"},
    "component:amortismanKaydetDugmesi": {"since": 1, "label": "Amortisman: kaydet düğmesi", "requires": ["query:kiymet", "query:plan", "query:amortismanKaydet"]},
    "component:eldenCikarmaPenceresi": {"since": 1, "label": "Elden çıkarma penceresi", "requires": ["component:cikarmaKarti", "component:cikarmaAnahtari", "component:cikarmaNotu", "component:cikarmaUyarisi", "component:cikarmaKaydet", "query:kiymet", "query:plan", "query:zimmetler"]},
    "component:cikarmaKarti": {"since": 1, "label": "Elden çıkarma: alanlar", "requires": ["component:cikarmaTarihi", "component:cikarmaTahsilati", "component:cikarmaAciklamasi"]},
    "component:cikarmaTarihi": {"since": 1, "label": "Alan: Elden çıkarma tarihi"},
    "component:cikarmaTahsilati": {"since": 1, "label": "Alan: Tahsilat"},
    "component:cikarmaAciklamasi": {"since": 1, "label": "Alan: Açıklama"},
    "component:cikarmaAnahtari": {"since": 1, "label": "Elden çıkarma işlem anahtarı (gizli)"},
    "component:cikarmaNotu": {"since": 1, "label": "Elden çıkarma: kural notu"},
    "component:cikarmaUyarisi": {"since": 1, "label": "Elden çıkarma: geri alınamaz uyarısı"},
    "component:cikarmaKaydet": {"since": 1, "label": "Elden çıkarma: kaydet düğmesi", "requires": ["query:kiymet", "query:eldenCikar", "query:plan", "query:zimmetler"]},
    "query:kiymet": {"since": 1, "label": "Açılan kıymet"},
    "query:plan": {"since": 1, "label": "Amortisman planı"},
    "query:vergiPlan": {"since": 1, "label": "VUK vergi amortismanı planı", "requires": ["query:kiymet"]},
    "query:muhasebe": {"since": 1, "label": "Edinim muhasebesi"},
    "query:zimmetler": {"since": 1, "label": "Zimmet geçmişi"},
    "query:hesaplar": {"since": 1, "label": "Hesap planı (edinim karşı hesabı)"},
    "query:amortismanKaydet": {"since": 1, "label": "Amortismanı kaydet", "requires": ["query:kiymet", "query:plan"]},
    "query:vergiKaydet": {"since": 1, "label": "VUK vergi amortismanını kaydet", "requires": ["query:kiymet", "query:vergiPlan"]},
    "query:yevmiyele": {"since": 1, "label": "Edinimi yevmiyeleştir", "requires": ["query:kiymet", "component:karsiHesap"]},
    "query:eldenCikar": {"since": 1, "label": "Elden çıkar", "requires": ["query:kiymet", "component:cikarmaTarihi", "component:cikarmaTahsilati", "component:cikarmaAciklamasi", "component:cikarmaAnahtari"]},
    "query:iadeAl": {"since": 1, "label": "Zimmeti iade al", "requires": ["query:kiymet", "component:zimmetTablosu"]}
  },
  "screenViews": [
    { "key": "fixed-asset-depreciation", "component": "planTablosu",
      "fields": { "periodStart": "periodStart", "amountBase": "amountBase", "isPosted": "isPosted", "journalEntryId": "journalEntryId" } },
    { "key": "fixed-asset-assignments", "component": "zimmetTablosu",
      "fields": { "employee": "employee", "assignedDate": "assignedDate", "returnedDate": "returnedDate", "location": "location" } } ],
  "definition": {
    "schemaVersion": 2,
    "components": [
      { "id": "komutlar", "type": "actionBar", "name": "komutlar",
        "props": { "moreButtons": ["amortismanDugmesi", "zimmetleDugmesi", "eldenCikarDugmesi", "eskiEkranDugmesi"],
                   "hiddenCommands": ["new", "open", "save", "delete", "print", "export"] } },
      { "id": "baslik", "type": "heading", "name": "baslik",
        "props": { "text": "{{kiymet.rows[0].name}}", "pageTitle": true, "visibleWhen": "kiymet.rows[0].id != null" } },
      { "id": "etkinEtiketi", "type": "badge", "name": "etkinEtiketi",
        "props": { "text": "Etkin", "variant": "success", "visibleWhen": "kiymet.rows[0].status == 'Active'" } },
      { "id": "cikarildiEtiketi", "type": "badge", "name": "cikarildiEtiketi",
        "props": { "text": "Elden çıkarıldı", "variant": "info", "visibleWhen": "kiymet.rows[0].status == 'Disposed'" } },
      { "id": "kartOzeti", "type": "recordHeader", "name": "kartOzeti",
        "props": { "icon": "building", "title": "{{kiymet.rows[0].assetCode}} · {{kiymet.rows[0].category}}",
                   "subtitle": "{{kiymet.rows[0].depreciatedMonths}} / {{kiymet.rows[0].usefulLifeMonths}} ay",
                   "fields": ["Maliyet={{kiymet.rows[0].acquisitionCostBase}}", "Birikmiş={{kiymet.rows[0].accumulatedDepreciationBase}}",
                              "Net defter={{kiymet.rows[0].remainingBookValueBase}}", "Zimmet={{kiymet.rows[0].currentAssignee}}",
                              "Bağlı fatura={{kiymet.rows[0].purchaseInvoiceCode}}"],
                   "fieldFormats": ["Maliyet=money", "Birikmiş=money", "Net defter=money"],
                   "buttons": ["kapatDugmesi"], "visibleWhen": "kiymet.rows[0].id != null" } },
      { "id": "kapatDugmesi", "type": "button", "name": "kapatDugmesi",
        "props": { "text": "Kapat", "actionType": "page", "pageCode": "@fixed-assets", "target": "sameTab" } },
      { "id": "saltOkunurNotu", "type": "text", "name": "saltOkunurNotu",
        "props": { "text": "Kıymet edinimden sonra düzenlenmez; işlemler İşlemler menüsünde (Alt+İ)." } },
      { "id": "kayitYok", "type": "alert", "name": "kayitYok",
        "props": { "variant": "info", "width": 12, "text": "Kıymet seçilmedi ya da bulunamadı. Duran Varlıklar listesinden bir kıymet açın.",
                   "visibleWhen": "kiymet.rows[0].id == null" } },

      { "id": "sekmeler", "type": "tabs", "name": "sekmeler",
        "props": { "tabs": ["Genel=genelKimlik,genelMaliyet,genelDefter,genelAltSinir,genelVuk",
                            "Amortisman tablosu {{plan.satirSayisi}}=defterSecimi,planBirikmis,planNetDefter,planSiradaki,planTablosu,planNotu,vukUyarisi,vukSiradaki,vukSiradakiTutar,vukTablosu,vergiKaydiDugmesi",
                            "Edinim muhasebesi=edinimFisi,edinimSatirlari,edinimFaturaNotu,edinimKarti,edinimNotu,edinimDugmesi",
                            "Zimmet geçmişi {{zimmetler.satirSayisi}}=zimmetTablosu,iadeDugmesi,zimmetleSekme,zimmetNotu",
                            "Elden çıkarma=cikarmaOzeti,cikarilmadiNotu"],
                   "visibleWhen": "kiymet.rows[0].id != null" } },

      { "id": "genelKimlik", "type": "recordHeader", "name": "genelKimlik",
        "props": { "icon": "tag", "title": "Kimlik",
                   "fields": ["Kıymet kodu={{kiymet.rows[0].assetCode}}", "Ad={{kiymet.rows[0].name}}", "Kategori={{kiymet.rows[0].category}}",
                              "Kaynak referansı={{kiymet.rows[0].sourceReference}}"] } },
      { "id": "genelMaliyet", "type": "recordHeader", "name": "genelMaliyet",
        "props": { "icon": "banknote", "title": "Maliyet ve amortisman",
                   "fields": ["Edinim tarihi={{kiymet.rows[0].acquisitionDate}}", "Kullanıma giriş={{kiymet.rows[0].inServiceDate}}",
                              "Faydalı ömür (ay)={{kiymet.rows[0].usefulLifeMonths}}", "Edinim maliyeti={{kiymet.rows[0].acquisitionCostBase}}",
                              "Kalıntı değer={{kiymet.rows[0].residualValueBase}}", "Aylık amortisman={{kiymet.rows[0].monthlyDepreciationBase}}"],
                   "fieldFormats": ["Edinim tarihi=date", "Kullanıma giriş=date", "Faydalı ömür (ay)=number", "Edinim maliyeti=money",
                                    "Kalıntı değer=money", "Aylık amortisman=money"] } },
      { "id": "genelDefter", "type": "recordHeader", "name": "genelDefter",
        "props": { "icon": "layers", "title": "Defter",
                   "fields": ["Birikmiş amortisman={{kiymet.rows[0].accumulatedDepreciationBase}}", "Net defter değeri={{kiymet.rows[0].remainingBookValueBase}}"],
                   "fieldFormats": ["Birikmiş amortisman=money", "Net defter değeri=money"] } },
      { "id": "genelAltSinir", "type": "recordHeader", "name": "genelAltSinir",
        "props": { "icon": "info", "title": "GİB VUK amortisman alt sınırı (edinim yılı)",
                   "subtitle": "Bilgilendirme amaçlıdır; otomatik gider yazma kararı değildir.",
                   "fields": ["Yıl={{kiymet.rows[0].vukTaxYear}}", "Alt sınır (TL)={{kiymet.rows[0].vukDepreciationLowerLimitTry}}",
                              "Tebliğ={{kiymet.rows[0].vukCommuniqueNumber}}"],
                   "fieldFormats": ["Alt sınır (TL)=money"], "visibleWhen": "kiymet.rows[0].vukTaxYear != null" } },
      { "id": "genelVuk", "type": "recordHeader", "name": "genelVuk",
        "props": { "icon": "file-text", "title": "VUK profili", "subtitle": "{{kiymet.rows[0].vukUsefulLifeDescription}}",
                   "fields": ["Tablo kodu={{kiymet.rows[0].vukUsefulLifeCode}}", "Tablo yılı={{kiymet.rows[0].vukUsefulLifeTableYear}}",
                              "Tebliğ no={{kiymet.rows[0].vukUsefulLifeCommuniqueNumber}}", "Vergi ömrü (ay)={{kiymet.rows[0].vukUsefulLifeMonths}}",
                              "Oran %={{kiymet.rows[0].vukNormalDepreciationRatePercent}}", "Vergi başlangıcı={{kiymet.rows[0].vukTaxDepreciationStartDate}}"],
                   "fieldFormats": ["Oran %=number", "Vergi başlangıcı=date"], "visibleWhen": "kiymet.rows[0].hasVukProfile == true" } },

      { "id": "defterSecimi", "type": "formCard", "name": "defterSecimi",
        "props": { "title": "Defter", "layout": "inline", "width": 4, "inputs": ["defterTuru"], "visibleWhen": "kiymet.rows[0].hasVukProfile == true" } },
      { "id": "defterTuru", "type": "input", "name": "defterTuru",
        "props": { "inputType": "select", "label": "Görünüm", "staticOptions": ["Muhasebe=Muhasebe", "VUK=VUK (vergi tahmini)"], "defaultValue": "Muhasebe" } },
      { "id": "planBirikmis", "type": "metric", "name": "planBirikmis",
        "props": { "title": "Birikmiş amortisman", "value": "{{kiymet.rows[0].accumulatedDepreciationBase}}", "format": "money", "width": 4, "icon": "layers",
                   "visibleWhen": "defterTuru.value != 'VUK'" } },
      { "id": "planNetDefter", "type": "metric", "name": "planNetDefter",
        "props": { "title": "Net defter değeri", "value": "{{kiymet.rows[0].remainingBookValueBase}}", "format": "money", "width": 4, "icon": "wallet",
                   "variant": "success", "visibleWhen": "defterTuru.value != 'VUK'" } },
      { "id": "planSiradaki", "type": "metric", "name": "planSiradaki",
        "props": { "title": "Sıradaki dönem", "value": "{{plan.meta.nextPeriodStart}}", "format": "date", "width": 4, "icon": "calendar",
                   "description": "tek yazılabilir dönem", "visibleWhen": "defterTuru.value != 'VUK'" } },
      { "id": "planTablosu", "type": "dataTable", "name": "planTablosu",
        "props": { "title": "Amortisman tablosu", "query": "plan", "width": 12,
                   "columns": ["periodStart", "amountBase", "isPosted", "journalEntryId"],
                   "columnLabels": ["periodStart=Dönem", "amountBase=Tutar", "isPosted=Durum", "journalEntryId=Yevmiye fişi"],
                   "columnFormats": ["periodStart=date", "amountBase=money", "isPosted=status"],
                   "valueLabels": ["isPosted:true=Kaydedildi", "isPosted:false=Planlandı"],
                   "toneMap": ["Kaydedildi=success", "Planlandı=info"],
                   "emptyText": "Bu aralıkta kalan dönem yok.", "visibleWhen": "defterTuru.value != 'VUK'" } },
      { "id": "planNotu", "type": "text", "name": "planNotu",
        "props": { "text": "Aylık doğrusal; kullanıma giriş ayını izleyen aydan başlar. Bugüne kadarki dönemler. Kaydedilen dönem geri alınamaz. Amortismanı kaydet: İşlemler (Alt+İ).",
                   "visibleWhen": "defterTuru.value != 'VUK'" } },
      { "id": "vukUyarisi", "type": "alert", "name": "vukUyarisi",
        "props": { "variant": "info", "width": 12,
                   "text": "Yalnızca tahmindir; yasal beyan veya vergi danışmanlığı değildir. Mali müşavirin doğruladığı profile göre hesaplanır; vergi kaydı kıymetin birikmiş amortismanını değiştirmez.",
                   "visibleWhen": "defterTuru.value == 'VUK'" } },
      { "id": "vukSiradaki", "type": "metric", "name": "vukSiradaki",
        "props": { "title": "Sıradaki vergi dönemi", "value": "{{vergiPlan.meta.nextPeriodStart}}", "format": "date", "width": 6, "icon": "calendar",
                   "visibleWhen": "defterTuru.value == 'VUK'" } },
      { "id": "vukSiradakiTutar", "type": "metric", "name": "vukSiradakiTutar",
        "props": { "title": "Tahmini tutar", "value": "{{vergiPlan.meta.nextAmountBase}}", "format": "money", "width": 6, "icon": "banknote",
                   "visibleWhen": "defterTuru.value == 'VUK'" } },
      { "id": "vukTablosu", "type": "dataTable", "name": "vukTablosu",
        "props": { "title": "VUK vergi amortismanı", "query": "vergiPlan", "width": 12,
                   "columns": ["periodStart", "amountBase", "isPosted", "journalEntryId"],
                   "columnLabels": ["periodStart=Dönem", "amountBase=Tahmini tutar", "isPosted=Durum", "journalEntryId=Yevmiye fişi"],
                   "columnFormats": ["periodStart=date", "amountBase=money", "isPosted=status"],
                   "valueLabels": ["isPosted:true=Kaydedildi", "isPosted:false=Planlandı"],
                   "toneMap": ["Kaydedildi=success", "Planlandı=info"],
                   "emptyText": "Bu aralıkta kalan vergi dönemi yok.", "visibleWhen": "defterTuru.value == 'VUK'" } },
      { "id": "vergiKaydiDugmesi", "type": "button", "name": "vergiKaydiDugmesi",
        "props": { "text": "Vergi kaydı oluştur", "actionType": "query", "queryId": "vergiKaydet", "confirmEnabled": true,
                   "confirmText": "Bu kayıt yevmiyeye yazılır ve arayüzden geri alınamaz.",
                   "successMessage": "Vergi amortismanı kaydedildi; yevmiye fişi oluşturuldu.", "refreshQueries": ["vergiPlan"],
                   "visibleWhen": "defterTuru.value == 'VUK'",
                   "disabledWhen": "kiymet.rows[0].status != 'Active' || vergiPlan.meta.nextPeriodStart == null",
                   "disabledReason": "Kaydedilecek vergi dönemi yok ya da kıymet etkin değil." } },

      { "id": "edinimFisi", "type": "recordHeader", "name": "edinimFisi",
        "props": { "icon": "file-text", "title": "Edinim fişi",
                   "fields": ["Fiş tarihi={{muhasebe.meta.entryDate}}", "Yevmiye fişi={{muhasebe.meta.journalEntryId}}"],
                   "fieldFormats": ["Fiş tarihi=date"], "visibleWhen": "muhasebe.meta.journalEntryId != null" } },
      { "id": "edinimSatirlari", "type": "dataTable", "name": "edinimSatirlari",
        "props": { "title": "Fiş satırları", "query": "muhasebe", "width": 12,
                   "columns": ["accountCode", "accountName", "debit", "credit"],
                   "columnLabels": ["accountCode=Hesap kodu", "accountName=Hesap", "debit=Borç", "credit=Alacak"],
                   "columnFormats": ["accountCode=code", "debit=money", "credit=money"], "totals": ["debit", "credit"],
                   "visibleWhen": "muhasebe.meta.journalEntryId != null" } },
      { "id": "edinimFaturaNotu", "type": "alert", "name": "edinimFaturaNotu",
        "props": { "variant": "info", "width": 12,
                   "text": "Muhasebe kaynağı alış faturası {{muhasebe.meta.purchaseInvoiceCode}}; çift kayıt olmaması için ayrıca edinim fişi oluşturulmaz.",
                   "visibleWhen": "muhasebe.meta.journalEntryId == null && kiymet.rows[0].purchaseInvoiceId != null" } },
      { "id": "edinimKarti", "type": "formCard", "name": "edinimKarti",
        "props": { "title": "Edinimi yevmiyeleştir", "columns": 2, "inputs": ["karsiHesap"],
                   "visibleWhen": "muhasebe.meta.journalEntryId == null && kiymet.rows[0].purchaseInvoiceId == null" } },
      { "id": "karsiHesap", "type": "input", "name": "karsiHesap",
        "props": { "inputType": "lookup", "label": "Edinim karşı hesabı", "required": true, "optionsQuery": "hesaplar", "optionValueColumn": "id",
                   "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "optionsWhen": "satir.isActive == true",
                   "placeholder": "Hesap kodu veya adıyla ara" } },
      { "id": "edinimNotu", "type": "text", "name": "edinimNotu",
        "props": { "text": "Firma sabit kıymet maliyet hesabına borç, seçtiğiniz etkin karşı hesaba alacak kaydeder. Edinim tarihi kapalı mali dönemdeyse fiş yazılmaz.",
                   "visibleWhen": "muhasebe.meta.journalEntryId == null && kiymet.rows[0].purchaseInvoiceId == null" } },
      { "id": "edinimDugmesi", "type": "button", "name": "edinimDugmesi",
        "props": { "text": "Edinimi yevmiyeleştir", "actionType": "query", "queryId": "yevmiyele", "confirmEnabled": true,
                   "confirmText": "Bu kayıt yevmiyeye yazılır ve arayüzden geri alınamaz.",
                   "successMessage": "Edinim fişi oluşturuldu.", "refreshQueries": ["muhasebe"],
                   "visibleWhen": "muhasebe.meta.journalEntryId == null && kiymet.rows[0].purchaseInvoiceId == null" } },

      { "id": "zimmetTablosu", "type": "dataTable", "name": "zimmetTablosu",
        "props": { "title": "Zimmet geçmişi", "query": "zimmetler", "width": 12,
                   "columns": ["employee", "assignedDate", "returnedDate", "location"],
                   "columnLabels": ["employee=Personel", "assignedDate=Teslim", "returnedDate=İade", "location=Konum"],
                   "columnFormats": ["assignedDate=date", "returnedDate=date"],
                   "emptyText": "Henüz zimmet geçmişi yok." } },
      { "id": "iadeDugmesi", "type": "button", "name": "iadeDugmesi",
        "props": { "text": "İade al", "actionType": "query", "queryId": "iadeAl",
                   "successMessage": "Zimmet iade alındı.", "refreshQueries": ["zimmetler", "kiymet"],
                   "disabledWhen": "zimmetTablosu.seciliSatir.id == null || zimmetTablosu.seciliSatir.returnedDate != null",
                   "disabledReason": "İade al yalnız açık zimmette: önce iade tarihi boş satırı seçin. İade tarihi bugündür." } },
      { "id": "zimmetleSekme", "type": "button", "name": "zimmetleSekme",
        "props": { "text": "Zimmetle (eski ekranda)", "actionType": "erpPage", "pageKey": "fixed-assets", "target": "sameTab", "legacyScreen": true,
                   "visibleWhen": "kiymet.rows[0].status == 'Active'" } },
      { "id": "zimmetNotu", "type": "text", "name": "zimmetNotu",
        "props": { "text": "Yeni zimmet şimdilik eski ekrandan verilir; personel seçici İK modülüyle gelecek. Kıymetin açık zimmeti varsa önce iade alınır." } },

      { "id": "cikarmaOzeti", "type": "recordHeader", "name": "cikarmaOzeti",
        "props": { "icon": "archive", "title": "Elden çıkarıldı", "subtitle": "{{kiymet.rows[0].disposalReason}}",
                   "fields": ["Tarih={{kiymet.rows[0].disposalDate}}", "Tahsilat={{kiymet.rows[0].disposalProceedsBase}}",
                              "Defter değeri={{kiymet.rows[0].disposalBookValueBase}}", "Kâr / zarar={{kiymet.rows[0].disposalGainLossBase}}",
                              "Yevmiye fişi={{kiymet.rows[0].disposalJournalEntryId}}"],
                   "fieldFormats": ["Tarih=date", "Tahsilat=money", "Defter değeri=money", "Kâr / zarar=money"],
                   "visibleWhen": "kiymet.rows[0].isDisposed == true" } },
      { "id": "cikarilmadiNotu", "type": "text", "name": "cikarilmadiNotu",
        "props": { "text": "Elden çıkarılmadı. Elden çıkar: İşlemler (Alt+İ).", "visibleWhen": "kiymet.rows[0].isDisposed != true" } },

      { "id": "amortismanDugmesi", "type": "button", "name": "amortismanDugmesi",
        "props": { "text": "Amortismanı kaydet", "actionType": "openDialog", "dialogId": "amortismanPenceresi",
                   "visibleWhen": "kiymet.rows[0].status == 'Active'" } },
      { "id": "eldenCikarDugmesi", "type": "button", "name": "eldenCikarDugmesi",
        "props": { "text": "Elden çıkar", "actionType": "openDialog", "dialogId": "eldenCikarmaPenceresi",
                   "visibleWhen": "kiymet.rows[0].status == 'Active'" } },
      { "id": "zimmetleDugmesi", "type": "button", "name": "zimmetleDugmesi",
        "props": { "text": "Zimmetle (eski ekranda)", "actionType": "erpPage", "pageKey": "fixed-assets", "target": "sameTab", "legacyScreen": true,
                   "visibleWhen": "kiymet.rows[0].status == 'Active'" } },
      { "id": "eskiEkranDugmesi", "type": "button", "name": "eskiEkranDugmesi",
        "props": { "text": "Eski ekranda aç", "actionType": "erpPage", "pageKey": "fixed-assets", "target": "sameTab", "legacyScreen": true } },

      { "id": "amortismanPenceresi", "type": "dialog", "name": "amortismanPenceresi",
        "props": { "presentation": "dialog", "size": "md", "title": "Amortismanı kaydet · {{kiymet.rows[0].assetCode}}",
                   "contains": ["amortismanDonemi", "amortismanTutari", "amortismanNotu", "amortismanUyarisi", "amortismanKaydetDugmesi"],
                   "refreshQueries": ["kiymet", "plan"] } },
      { "id": "amortismanDonemi", "type": "metric", "name": "amortismanDonemi",
        "props": { "title": "Kaydedilecek dönem", "value": "{{plan.meta.nextPeriodStart}}", "format": "date", "width": 6, "icon": "calendar",
                   "description": "yalnız sıradaki dönem yazılabilir" } },
      { "id": "amortismanTutari", "type": "metric", "name": "amortismanTutari",
        "props": { "title": "Tutar", "value": "{{plan.meta.nextAmountBase}}", "format": "money", "width": 6, "icon": "banknote" } },
      { "id": "amortismanNotu", "type": "text", "name": "amortismanNotu",
        "props": { "text": "Dönemler sırayla kaydedilir; yalnız sıradaki dönem yazılabilir. Kayıt için hesap eşleştirmeleri gerekir. Kapalı döneme fiş yazılmaz." } },
      { "id": "amortismanUyarisi", "type": "alert", "name": "amortismanUyarisi",
        "props": { "variant": "warning", "width": 12, "text": "Bu kayıt yevmiyeye yazılır ve arayüzden geri alınamaz." } },
      { "id": "amortismanKaydetDugmesi", "type": "button", "name": "amortismanKaydetDugmesi",
        "props": { "text": "Amortismanı kaydet", "actionType": "query", "queryId": "amortismanKaydet", "confirmEnabled": true,
                   "confirmText": "Bu kayıt yevmiyeye yazılır ve arayüzden geri alınamaz.",
                   "successMessage": "Amortisman kaydedildi; yevmiye fişi oluşturuldu.", "refreshQueries": ["kiymet", "plan"],
                   "disabledWhen": "kiymet.rows[0].status != 'Active' || plan.meta.nextPeriodStart == null",
                   "disabledReason": "Kaydedilecek dönem yok: kıymet etkin değil, bu aya kadar bütün dönemler kaydedildi ya da amortisman tamamlandı." } },

      { "id": "eldenCikarmaPenceresi", "type": "dialog", "name": "eldenCikarmaPenceresi",
        "props": { "presentation": "dialog", "size": "md", "title": "Elden çıkarma kaydı · {{kiymet.rows[0].assetCode}}",
                   "contains": ["cikarmaKarti", "cikarmaAnahtari", "cikarmaNotu", "cikarmaUyarisi", "cikarmaKaydet"],
                   "resetOnOpen": true, "refreshQueries": ["kiymet", "plan", "zimmetler"] } },
      { "id": "cikarmaKarti", "type": "formCard", "name": "cikarmaKarti",
        "props": { "title": "Elden çıkarma", "columns": 2, "inputs": ["cikarmaTarihi", "cikarmaTahsilati", "cikarmaAciklamasi"] } },
      { "id": "cikarmaTarihi", "type": "input", "name": "cikarmaTarihi",
        "props": { "inputType": "date", "label": "Elden çıkarma tarihi", "required": true, "defaultValue": "{{bugun}}" } },
      { "id": "cikarmaTahsilati", "type": "input", "name": "cikarmaTahsilati",
        "props": { "inputType": "number", "label": "Tahsilat (baz para birimi)", "required": true, "min": 0, "step": 0.01, "defaultValue": "0" } },
      { "id": "cikarmaAciklamasi", "type": "input", "name": "cikarmaAciklamasi",
        "props": { "inputType": "text", "label": "Açıklama", "required": true, "maxLength": 500, "placeholder": "Satış, hurdaya ayırma… (en fazla 500)" } },
      { "id": "cikarmaAnahtari", "type": "input", "name": "cikarmaAnahtari",
        "props": { "inputType": "text", "label": "İşlem anahtarı", "hidden": true, "autoId": true } },
      { "id": "cikarmaNotu", "type": "text", "name": "cikarmaNotu",
        "props": { "text": "Defter değeri önceki son tam aya kadar hesaplanır; eksik amortisman aynı fişe yazılır. Açık zimmet kendiliğinden kapanır. Tekrar gönderim ikinci fiş yazmaz." } },
      { "id": "cikarmaUyarisi", "type": "alert", "name": "cikarmaUyarisi",
        "props": { "variant": "warning", "width": 12, "text": "Kıymet kalıcı olarak elden çıkarılır. Yevmiye fişi yazılır; arayüzden geri alınamaz." } },
      { "id": "cikarmaKaydet", "type": "button", "name": "cikarmaKaydet",
        "props": { "text": "Elden çıkarmayı kaydet", "actionType": "query", "queryId": "eldenCikar", "confirmEnabled": true,
                   "confirmText": "Kıymet kalıcı olarak elden çıkarılır. Yevmiye fişi yazılır; arayüzden geri alınamaz.",
                   "successMessage": "Kıymet elden çıkarıldı; elden çıkarma yevmiye fişi oluşturuldu.", "refreshQueries": ["kiymet", "plan", "zimmetler"],
                   "disabledWhen": "kiymet.rows[0].status != 'Active'", "disabledReason": "Yalnız etkin kıymet elden çıkarılabilir." } }
    ],
    "queries": [
      { "id": "kiymet", "name": "kiymet", "kind": "read", "operation": "duranVarlik.kiymet.getir", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{sayfa.parametre.assetId}}", "type": "guid" } ] },
      { "id": "plan", "name": "plan", "kind": "read", "operation": "duranVarlik.amortisman.plani", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{sayfa.parametre.assetId}}", "type": "guid" } ] },
      { "id": "vergiPlan", "name": "vergiPlan", "kind": "read", "operation": "duranVarlik.vergiAmortismani.plani", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{kiymet.rows[0].vukScheduleAssetId}}", "type": "guid" } ] },
      { "id": "muhasebe", "name": "muhasebe", "kind": "read", "operation": "duranVarlik.edinim.muhasebe", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{sayfa.parametre.assetId}}", "type": "guid" } ] },
      { "id": "zimmetler", "name": "zimmetler", "kind": "read", "operation": "duranVarlik.zimmet.listele", "runOn": "load",
        "parameters": [ { "name": "id", "binding": "{{sayfa.parametre.assetId}}", "type": "guid" } ] },
      { "id": "hesaplar", "name": "hesaplar", "kind": "read", "operation": "finans.muhasebe.hesap.listele", "runOn": "load", "parameters": [] },
      { "id": "amortismanKaydet", "name": "amortismanKaydet", "kind": "insert", "operation": "duranVarlik.amortisman.kaydet", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kiymet.rows[0].id}}", "type": "guid" },
          { "name": "periodStart", "binding": "{{plan.meta.nextPeriodStart}}", "type": "date" } ] },
      { "id": "vergiKaydet", "name": "vergiKaydet", "kind": "insert", "operation": "duranVarlik.vergiAmortismani.kaydet", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kiymet.rows[0].vukScheduleAssetId}}", "type": "guid" },
          { "name": "periodStart", "binding": "{{vergiPlan.meta.nextPeriodStart}}", "type": "date" } ] },
      { "id": "yevmiyele", "name": "yevmiyele", "kind": "insert", "operation": "duranVarlik.edinim.yevmiyele", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kiymet.rows[0].id}}", "type": "guid" },
          { "name": "offsetAccountId", "binding": "{{karsiHesap.value}}", "type": "guid" } ] },
      { "id": "eldenCikar", "name": "eldenCikar", "kind": "insert", "operation": "duranVarlik.eldenCikarma.kaydet", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kiymet.rows[0].id}}", "type": "guid" },
          { "name": "disposalDate", "binding": "{{cikarmaTarihi.value}}", "type": "date" },
          { "name": "proceedsBase", "binding": "{{cikarmaTahsilati.value}}", "type": "decimal" },
          { "name": "reason", "binding": "{{cikarmaAciklamasi.value}}", "type": "text" },
          { "name": "idempotencyKey", "binding": "{{cikarmaAnahtari.value}}", "type": "guid" } ] },
      { "id": "iadeAl", "name": "iadeAl", "kind": "update", "operation": "duranVarlik.zimmet.iadeAl", "runOn": "manual",
        "parameters": [
          { "name": "id", "binding": "{{kiymet.rows[0].id}}", "type": "guid" },
          { "name": "assignmentId", "binding": "{{zimmetTablosu.seciliSatir.id}}", "type": "guid" },
          { "name": "returnedDate", "binding": "{{bugun}}", "type": "date" },
          { "name": "rowVersion", "binding": "{{zimmetTablosu.seciliSatir.rowVersion}}", "type": "text" } ] }
    ]
  }
}
