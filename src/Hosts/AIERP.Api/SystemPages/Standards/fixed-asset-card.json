      {"id": "kartOzeti", "type": "recordHeader", "name": "kartOzeti", "props": {"icon": "building", "title": "{{kiymet.rows[0].assetCode}} · {{kiymet.rows[0].category}}", "subtitle": "{{kiymet.rows[0].depreciatedMonths}} / {{kiymet.rows[0].usefulLifeMonths}} ay", "fields": ["Maliyet={{kiymet.rows[0].acquisitionCostBase}}", "Birikmiş={{kiymet.rows[0].accumulatedDepreciationBase}}", "Net defter={{kiymet.rows[0].remainingBookValueBase}}", "Zimmet={{kiymet.rows[0].currentAssignee}}", "Bağlı fatura={{kiymet.rows[0].purchaseInvoiceCode}}"], "fieldFormats": ["Maliyet=money", "Birikmiş=money", "Net defter=money"], "slot": "summary"}},
      {"id": "sekmeler", "type": "tabs", "name": "sekmeler", "props": {"tabs": ["Genel=genelKimlik,genelMaliyet,genelAltSinir,genelVuk,genelCikarma,cikarilmadiNotu", "Amortisman {{plan.satirSayisi}}=planKarti,planTablosu,planNotu", "VUK vergi amortismanı=vukUyarisi,vukKarti,vukTablosu,vukYokNotu", "Edinim muhasebesi=edinimFisi,edinimSatirlari,edinimFaturaNotu,edinimBilgiNotu", "Zimmet geçmişi {{zimmetler.satirSayisi}}=zimmetTablosu,zimmetNotu"], "slot": "tabs"}},
