      {"id": "genelCikarma", "type": "formCard", "name": "genelCikarma", "props": {"title": "Elden çıkarma", "columns": 3, "inputs": ["cikarmaTarih", "cikarmaNedeni", "cikarmaTahsilat", "cikarmaDefter", "cikarmaKarZarar", "cikarmaFis"], "slot": "section", "visibleWhen": "kiymet.rows[0].isDisposed == true", "recordKey": "{{kiymet.rows[0].id}}"}},
      {"id": "cikarmaTarih", "type": "input", "name": "cikarmaTarih", "props": {"inputType": "date", "label": "Tarih", "readOnly": true, "defaultValue": "{{kiymet.rows[0].disposalDate}}", "slot": "field"}},
      {"id": "cikarmaNedeni", "type": "input", "name": "cikarmaNedeni", "props": {"inputType": "text", "label": "Neden", "readOnly": true, "defaultValue": "{{kiymet.rows[0].disposalReason}}", "slot": "field"}},
      {"id": "cikarmaTahsilat", "type": "input", "name": "cikarmaTahsilat", "props": {"inputType": "number", "label": "Tahsilat", "readOnly": true, "defaultValue": "{{kiymet.rows[0].disposalProceedsBase}}", "slot": "field", "step": 0.01}},
      {"id": "cikarmaDefter", "type": "input", "name": "cikarmaDefter", "props": {"inputType": "number", "label": "Defter değeri", "readOnly": true, "defaultValue": "{{kiymet.rows[0].disposalBookValueBase}}", "slot": "field", "step": 0.01}},
      {"id": "cikarmaKarZarar", "type": "input", "name": "cikarmaKarZarar", "props": {"inputType": "number", "label": "Kâr / zarar", "readOnly": true, "defaultValue": "{{kiymet.rows[0].disposalGainLossBase}}", "slot": "field", "step": 0.01}},
      {"id": "cikarmaFis", "type": "input", "name": "cikarmaFis", "props": {"inputType": "text", "label": "Yevmiye fişi", "readOnly": true, "defaultValue": "{{kiymet.rows[0].disposalJournalEntryId}}", "slot": "field"}},
      {"id": "cikarilmadiNotu", "type": "text", "name": "cikarilmadiNotu", "props": {"text": "Elden çıkarılmadı. Elden çıkar: komut çubuğundaki ⋯ menüsü.", "slot": "note", "visibleWhen": "kiymet.rows[0].isDisposed != true"}},
      {"id": "planKarti", "type": "formCard", "name": "planKarti", "props": {"title": "Amortisman", "columns": 3, "inputs": ["planBirikmis", "planNetDefter", "planSiradaki"], "slot": "section", "recordKey": "{{kiymet.rows[0].id}}"}},
      {"id": "planBirikmis", "type": "input", "name": "planBirikmis", "props": {"inputType": "number", "label": "Birikmiş amortisman", "readOnly": true, "defaultValue": "{{kiymet.rows[0].accumulatedDepreciationBase}}", "slot": "field", "step": 0.01}},
      {"id": "planNetDefter", "type": "input", "name": "planNetDefter", "props": {"inputType": "number", "label": "Net defter değeri", "readOnly": true, "defaultValue": "{{kiymet.rows[0].remainingBookValueBase}}", "slot": "field", "step": 0.01}},
      {"id": "planSiradaki", "type": "input", "name": "planSiradaki", "props": {"inputType": "date", "label": "Sıradaki dönem", "readOnly": true, "defaultValue": "{{plan.meta.nextPeriodStart}}", "slot": "field"}},
      {"id": "planTablosu", "type": "dataTable", "name": "planTablosu", "props": {"title": "Amortisman tablosu", "query": "plan", "columns": ["periodStart", "amountBase", "isPosted", "journalEntryId"], "columnLabels": ["periodStart=Dönem", "amountBase=Tutar", "isPosted=Durum", "journalEntryId=Yevmiye fişi"], "columnFormats": ["periodStart=date", "amountBase=money", "isPosted=status"], "valueLabels": ["isPosted:true=Kaydedildi", "isPosted:false=Planlandı"], "toneMap": ["Kaydedildi=success", "Planlandı=info"], "emptyText": "Bu aralıkta kalan dönem yok.", "slot": "lines"}},
      {"id": "planNotu", "type": "text", "name": "planNotu", "props": {"text": "Aylık doğrusal; kullanıma giriş ayını izleyen aydan başlar. Bugüne kadarki dönemler. Kaydedilen dönem geri alınamaz. Amortismanı kaydet: komut çubuğundaki ⋯ menüsü.", "slot": "note"}},
      {"id": "vukUyarisi", "type": "text", "name": "vukUyarisi", "props": {"text": "Yalnızca tahmindir; yasal beyan veya vergi danışmanlığı değildir. Mali müşavirin doğruladığı profile göre hesaplanır; vergi kaydı kıymetin birikmiş amortismanını değiştirmez.", "slot": "note", "visibleWhen": "kiymet.rows[0].hasVukProfile == true"}},
      {"id": "vukKarti", "type": "formCard", "name": "vukKarti", "props": {"title": "Sıradaki vergi dönemi", "columns": 2, "inputs": ["vukSiradaki", "vukSiradakiTutar"], "slot": "section", "visibleWhen": "kiymet.rows[0].hasVukProfile == true", "recordKey": "{{kiymet.rows[0].id}}"}},
      {"id": "vukSiradaki", "type": "input", "name": "vukSiradaki", "props": {"inputType": "date", "label": "Sıradaki vergi dönemi", "readOnly": true, "defaultValue": "{{vergiPlan.meta.nextPeriodStart}}", "slot": "field"}},
      {"id": "vukSiradakiTutar", "type": "input", "name": "vukSiradakiTutar", "props": {"inputType": "number", "step": 0.01, "label": "Tahmini tutar", "readOnly": true, "defaultValue": "{{vergiPlan.meta.nextAmountBase}}", "slot": "field"}},
      {"id": "vukTablosu", "type": "dataTable", "name": "vukTablosu", "props": {"title": "VUK vergi amortismanı", "query": "vergiPlan", "columns": ["periodStart", "amountBase", "isPosted", "journalEntryId"], "columnLabels": ["periodStart=Dönem", "amountBase=Tahmini tutar", "isPosted=Durum", "journalEntryId=Yevmiye fişi"], "columnFormats": ["periodStart=date", "amountBase=money", "isPosted=status"], "valueLabels": ["isPosted:true=Kaydedildi", "isPosted:false=Planlandı"], "toneMap": ["Kaydedildi=success", "Planlandı=info"], "emptyText": "Bu aralıkta kalan vergi dönemi yok.", "visibleWhen": "kiymet.rows[0].hasVukProfile == true", "slot": "lines"}},
      {"id": "vukYokNotu", "type": "text", "name": "vukYokNotu", "props": {"text": "Bu kıymette VUK vergi profili yok.", "slot": "note", "visibleWhen": "kiymet.rows[0].hasVukProfile != true"}},
      {"id": "edinimFisi", "type": "formCard", "name": "edinimFisi", "props": {"title": "Edinim fişi", "columns": 2, "inputs": ["edinimTarihi2", "edinimYevmiye"], "slot": "section", "visibleWhen": "muhasebe.meta.journalEntryId != null", "recordKey": "{{kiymet.rows[0].id}}"}},
      {"id": "edinimTarihi2", "type": "input", "name": "edinimTarihi2", "props": {"inputType": "date", "label": "Fiş tarihi", "readOnly": true, "defaultValue": "{{muhasebe.meta.entryDate}}", "slot": "field"}},
      {"id": "edinimYevmiye", "type": "input", "name": "edinimYevmiye", "props": {"inputType": "text", "label": "Yevmiye fişi", "readOnly": true, "defaultValue": "{{muhasebe.meta.journalEntryId}}", "slot": "field"}},
      {"id": "edinimSatirlari", "type": "dataTable", "name": "edinimSatirlari", "props": {"title": "Fiş satırları", "query": "muhasebe", "columns": ["accountCode", "accountName", "debit", "credit"], "columnLabels": ["accountCode=Hesap kodu", "accountName=Hesap", "debit=Borç", "credit=Alacak"], "columnFormats": ["accountCode=code", "debit=money", "credit=money"], "totals": ["debit", "credit"], "visibleWhen": "muhasebe.meta.journalEntryId != null", "slot": "lines"}},
      {"id": "edinimFaturaNotu", "type": "text", "name": "edinimFaturaNotu", "props": {"text": "Muhasebe kaynağı alış faturası {{muhasebe.meta.purchaseInvoiceCode}}; çift kayıt olmaması için ayrıca edinim fişi oluşturulmaz.", "slot": "note", "visibleWhen": "muhasebe.meta.journalEntryId == null && kiymet.rows[0].purchaseInvoiceId != null"}},
      {"id": "edinimBilgiNotu", "type": "text", "name": "edinimBilgiNotu", "props": {"text": "Edinim fişi yok. Edinimi yevmiyeleştir: komut çubuğundaki ⋯ menüsü; karşı hesap pencerede seçilir.", "slot": "note", "visibleWhen": "muhasebe.meta.journalEntryId == null && kiymet.rows[0].purchaseInvoiceId == null"}},
      {"id": "zimmetTablosu", "type": "dataTable", "name": "zimmetTablosu", "props": {"title": "Zimmet geçmişi", "query": "zimmetler", "columns": ["employee", "assignedDate", "returnedDate", "location"], "columnLabels": ["employee=Personel", "assignedDate=Teslim", "returnedDate=İade", "location=Konum"], "columnFormats": ["assignedDate=date", "returnedDate=date"], "emptyText": "Henüz zimmet geçmişi yok.", "slot": "lines"}},
      {"id": "zimmetNotu", "type": "text", "name": "zimmetNotu", "props": {"text": "Yeni zimmet şimdilik eski ekrandan verilir; personel seçici İK modülüyle gelecek. Kıymetin açık zimmeti varsa önce iade alınır. İade al: açık zimmet satırını seçip ⋯ menüsünden.", "slot": "note"}},
      {"id": "amortismanDugmesi", "type": "button", "name": "amortismanDugmesi", "props": {"text": "Amortismanı kaydet", "actionType": "openDialog", "dialogId": "amortismanPenceresi", "visibleWhen": "kiymet.rows[0].status == 'Active'", "slot": "actions"}},
      {"id": "eldenCikarDugmesi", "type": "button", "name": "eldenCikarDugmesi", "props": {"text": "Elden çıkar", "actionType": "openDialog", "dialogId": "eldenCikarmaPenceresi", "visibleWhen": "kiymet.rows[0].status == 'Active'", "slot": "actions"}},
      {"id": "edinimDugmesi", "type": "button", "name": "edinimDugmesi", "props": {"text": "Edinimi yevmiyeleştir", "actionType": "openDialog", "dialogId": "edinimPenceresi", "visibleWhen": "muhasebe.meta.journalEntryId == null && kiymet.rows[0].purchaseInvoiceId == null", "slot": "actions"}},
      {"id": "zimmetleDugmesi", "type": "button", "name": "zimmetleDugmesi", "props": {"text": "Zimmetle (eski ekranda)", "actionType": "erpPage", "pageKey": "fixed-assets", "target": "sameTab", "legacyScreen": true, "visibleWhen": "kiymet.rows[0].status == 'Active'", "slot": "actions"}},
      {"id": "vergiKaydiDugmesi", "type": "button", "name": "vergiKaydiDugmesi", "props": {"text": "Vergi kaydı oluştur", "actionType": "query", "queryId": "vergiKaydet", "confirmEnabled": true, "confirmText": "Bu kayıt yevmiyeye yazılır ve arayüzden geri alınamaz.", "successMessage": "Vergi amortismanı kaydedildi; yevmiye fişi oluşturuldu.", "refreshQueries": ["vergiPlan"], "visibleWhen": "kiymet.rows[0].hasVukProfile == true", "disabledWhen": "kiymet.rows[0].status != 'Active' || vergiPlan.meta.nextPeriodStart == null", "disabledReason": "Kaydedilecek vergi dönemi yok ya da kıymet etkin değil.", "slot": "actions"}},
      {"id": "iadeDugmesi", "type": "button", "name": "iadeDugmesi", "props": {"text": "İade al", "actionType": "query", "queryId": "iadeAl", "successMessage": "Zimmet iade alındı.", "refreshQueries": ["zimmetler", "kiymet"], "disabledWhen": "zimmetTablosu.seciliSatir.id == null || zimmetTablosu.seciliSatir.returnedDate != null", "disabledReason": "İade al yalnız açık zimmette: önce iade tarihi boş satırı seçin. İade tarihi bugündür.", "slot": "actions"}},
      {"id": "amortismanPenceresi", "type": "dialog", "name": "amortismanPenceresi", "props": {"presentation": "dialog", "size": "md", "title": "Amortismanı kaydet · {{kiymet.rows[0].assetCode}}", "contains": ["amortismanDonemi", "amortismanTutari", "amortismanNotu", "amortismanUyarisi", "amortismanKaydetDugmesi"], "slot": "dialogs", "refreshQueries": ["kiymet", "plan"]}},
      {"id": "amortismanDonemi", "type": "metric", "name": "amortismanDonemi", "props": {"title": "Kaydedilecek dönem", "value": "{{plan.meta.nextPeriodStart}}", "format": "date", "icon": "calendar", "description": "yalnız sıradaki dönem yazılabilir", "slot": "dialog"}},
      {"id": "amortismanTutari", "type": "metric", "name": "amortismanTutari", "props": {"title": "Tutar", "value": "{{plan.meta.nextAmountBase}}", "format": "money", "icon": "banknote", "slot": "dialog"}},
      {"id": "amortismanNotu", "type": "text", "name": "amortismanNotu", "props": {"text": "Dönemler sırayla kaydedilir; yalnız sıradaki dönem yazılabilir. Kayıt için hesap eşleştirmeleri gerekir. Kapalı döneme fiş yazılmaz.", "slot": "dialog"}},
      {"id": "amortismanUyarisi", "type": "alert", "name": "amortismanUyarisi", "props": {"variant": "warning", "text": "Bu kayıt yevmiyeye yazılır ve arayüzden geri alınamaz.", "slot": "dialog"}},
      {"id": "amortismanKaydetDugmesi", "type": "button", "name": "amortismanKaydetDugmesi", "props": {"text": "Amortismanı kaydet", "actionType": "query", "queryId": "amortismanKaydet", "confirmEnabled": true, "confirmText": "Bu kayıt yevmiyeye yazılır ve arayüzden geri alınamaz.", "successMessage": "Amortisman kaydedildi; yevmiye fişi oluşturuldu.", "refreshQueries": ["kiymet", "plan"], "disabledWhen": "kiymet.rows[0].status != 'Active' || plan.meta.nextPeriodStart == null", "disabledReason": "Kaydedilecek dönem yok: kıymet etkin değil, bu aya kadar bütün dönemler kaydedildi ya da amortisman tamamlandı.", "slot": "dialog"}},
      {"id": "eldenCikarmaPenceresi", "type": "dialog", "name": "eldenCikarmaPenceresi", "props": {"presentation": "dialog", "size": "md", "title": "Elden çıkarma kaydı · {{kiymet.rows[0].assetCode}}", "contains": ["cikarmaKarti", "cikarmaAnahtari", "cikarmaNotu", "cikarmaUyarisi", "cikarmaKaydet"], "slot": "dialogs", "resetOnOpen": true, "refreshQueries": ["kiymet", "plan", "zimmetler"]}},
      {"id": "cikarmaKarti", "type": "formCard", "name": "cikarmaKarti", "props": {"title": "Elden çıkarma", "columns": 2, "inputs": ["cikarmaTarihi", "cikarmaTahsilati", "cikarmaAciklamasi"], "slot": "dialog"}},
      {"id": "cikarmaTarihi", "type": "input", "name": "cikarmaTarihi", "props": {"inputType": "date", "label": "Elden çıkarma tarihi", "required": true, "defaultValue": "{{bugun}}", "slot": "dialog"}},
      {"id": "cikarmaTahsilati", "type": "input", "name": "cikarmaTahsilati", "props": {"inputType": "number", "label": "Tahsilat (baz para birimi)", "required": true, "min": 0, "step": 0.01, "defaultValue": "0", "slot": "dialog"}},
      {"id": "cikarmaAciklamasi", "type": "input", "name": "cikarmaAciklamasi", "props": {"inputType": "text", "label": "Açıklama", "required": true, "maxLength": 500, "placeholder": "Satış, hurdaya ayırma… (en fazla 500)", "slot": "dialog"}},
      {"id": "cikarmaAnahtari", "type": "input", "name": "cikarmaAnahtari", "props": {"inputType": "text", "label": "İşlem anahtarı", "hidden": true, "autoId": true, "slot": "dialog"}},
      {"id": "cikarmaNotu", "type": "text", "name": "cikarmaNotu", "props": {"text": "Defter değeri önceki son tam aya kadar hesaplanır; eksik amortisman aynı fişe yazılır. Açık zimmet kendiliğinden kapanır. Tekrar gönderim ikinci fiş yazmaz.", "slot": "dialog"}},
      {"id": "cikarmaUyarisi", "type": "alert", "name": "cikarmaUyarisi", "props": {"variant": "warning", "text": "Kıymet kalıcı olarak elden çıkarılır. Yevmiye fişi yazılır; arayüzden geri alınamaz.", "slot": "dialog"}},
      {"id": "cikarmaKaydet", "type": "button", "name": "cikarmaKaydet", "props": {"text": "Elden çıkarmayı kaydet", "actionType": "query", "queryId": "eldenCikar", "confirmEnabled": true, "confirmText": "Kıymet kalıcı olarak elden çıkarılır. Yevmiye fişi yazılır; arayüzden geri alınamaz.", "successMessage": "Kıymet elden çıkarıldı; elden çıkarma yevmiye fişi oluşturuldu.", "refreshQueries": ["kiymet", "plan", "zimmetler"], "disabledWhen": "kiymet.rows[0].status != 'Active'", "disabledReason": "Yalnız etkin kıymet elden çıkarılabilir.", "slot": "dialog"}},
      {"id": "edinimPenceresi", "type": "dialog", "name": "edinimPenceresi", "props": {"presentation": "dialog", "size": "md", "title": "Edinimi yevmiyeleştir · {{kiymet.rows[0].assetCode}}", "contains": ["edinimKarti", "edinimNotu", "edinimKaydet"], "slot": "dialogs", "resetOnOpen": true, "refreshQueries": ["muhasebe"]}},
      {"id": "edinimKarti", "type": "formCard", "name": "edinimKarti", "props": {"title": "Edinimi yevmiyeleştir", "columns": 2, "inputs": ["karsiHesap"], "slot": "dialog"}},
      {"id": "karsiHesap", "type": "input", "name": "karsiHesap", "props": {"inputType": "lookup", "label": "Edinim karşı hesabı", "required": true, "optionsQuery": "hesaplar", "optionValueColumn": "id", "optionLabelColumn": "name", "optionDescriptionColumn": "code", "minChars": 0, "optionsWhen": "satir.isActive == true", "placeholder": "Hesap kodu veya adıyla ara", "slot": "dialog"}},
      {"id": "edinimNotu", "type": "text", "name": "edinimNotu", "props": {"text": "Firma sabit kıymet maliyet hesabına borç, seçtiğiniz etkin karşı hesaba alacak kaydeder. Edinim tarihi kapalı mali dönemdeyse fiş yazılmaz.", "slot": "dialog"}},
      {"id": "edinimKaydet", "type": "button", "name": "edinimKaydet", "props": {"text": "Yevmiyeleştir", "actionType": "query", "queryId": "yevmiyele", "confirmEnabled": true, "confirmText": "Bu kayıt yevmiyeye yazılır ve arayüzden geri alınamaz.", "successMessage": "Edinim fişi oluşturuldu.", "refreshQueries": ["muhasebe", "kiymet"], "slot": "dialog"}}
    ],
    "queries": [
      {"id": "kiymet", "name": "kiymet", "kind": "read", "operation": "duranVarlik.kiymet.getir", "runOn": "load", "parameters": [{"name": "id", "binding": "{{sayfa.parametre.assetId}}", "type": "guid"}]},
      {"id": "plan", "name": "plan", "kind": "read", "operation": "duranVarlik.amortisman.plani", "runOn": "load", "parameters": [{"name": "id", "binding": "{{sayfa.parametre.assetId}}", "type": "guid"}]},
      {"id": "vergiPlan", "name": "vergiPlan", "kind": "read", "operation": "duranVarlik.vergiAmortismani.plani", "runOn": "load", "parameters": [{"name": "id", "binding": "{{kiymet.rows[0].vukScheduleAssetId}}", "type": "guid"}]},
      {"id": "muhasebe", "name": "muhasebe", "kind": "read", "operation": "duranVarlik.edinim.muhasebe", "runOn": "load", "parameters": [{"name": "id", "binding": "{{sayfa.parametre.assetId}}", "type": "guid"}]},
      {"id": "zimmetler", "name": "zimmetler", "kind": "read", "operation": "duranVarlik.zimmet.listele", "runOn": "load", "parameters": [{"name": "id", "binding": "{{sayfa.parametre.assetId}}", "type": "guid"}]},
      {"id": "hesaplar", "name": "hesaplar", "kind": "read", "operation": "finans.muhasebe.hesap.listele", "runOn": "load", "parameters": []},
      {"id": "amortismanKaydet", "name": "amortismanKaydet", "kind": "insert", "operation": "duranVarlik.amortisman.kaydet", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kiymet.rows[0].id}}", "type": "guid"}, {"name": "periodStart", "binding": "{{plan.meta.nextPeriodStart}}", "type": "date"}]},
      {"id": "vergiKaydet", "name": "vergiKaydet", "kind": "insert", "operation": "duranVarlik.vergiAmortismani.kaydet", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kiymet.rows[0].vukScheduleAssetId}}", "type": "guid"}, {"name": "periodStart", "binding": "{{vergiPlan.meta.nextPeriodStart}}", "type": "date"}]},
      {"id": "yevmiyele", "name": "yevmiyele", "kind": "insert", "operation": "duranVarlik.edinim.yevmiyele", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kiymet.rows[0].id}}", "type": "guid"}, {"name": "offsetAccountId", "binding": "{{karsiHesap.value}}", "type": "guid"}]},
      {"id": "eldenCikar", "name": "eldenCikar", "kind": "insert", "operation": "duranVarlik.eldenCikarma.kaydet", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kiymet.rows[0].id}}", "type": "guid"}, {"name": "disposalDate", "binding": "{{cikarmaTarihi.value}}", "type": "date"}, {"name": "proceedsBase", "binding": "{{cikarmaTahsilati.value}}", "type": "decimal"}, {"name": "reason", "binding": "{{cikarmaAciklamasi.value}}", "type": "text"}, {"name": "idempotencyKey", "binding": "{{cikarmaAnahtari.value}}", "type": "guid"}]},
      {"id": "iadeAl", "name": "iadeAl", "kind": "update", "operation": "duranVarlik.zimmet.iadeAl", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kiymet.rows[0].id}}", "type": "guid"}, {"name": "assignmentId", "binding": "{{zimmetTablosu.seciliSatir.id}}", "type": "guid"}, {"name": "returnedDate", "binding": "{{bugun}}", "type": "date"}, {"name": "rowVersion", "binding": "{{zimmetTablosu.seciliSatir.rowVersion}}", "type": "text"}]}
    ]
  }
}
