    "component:stokKarti": {"since": 1,"label": "Kart bölümü: Stok yönetimi","requires": ["component:minimumStok","component:maksimumStok","component:yenidenSiparisNoktasi","component:emniyetStoku","component:tedarikSuresi","component:uretimSuresi"]},
    "component:fiyatKarti": {"since": 1,"label": "Kart bölümü: Fiyat ve indirim","requires": ["component:alisFiyati","component:satisFiyati","component:fiyatParaBirimi","component:alisIndirimi","component:satisIndirimi"]},
