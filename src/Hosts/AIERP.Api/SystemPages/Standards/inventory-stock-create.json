{
  "screenKey": "inventory-stock-create",
  "title": "Stok kartı",
  "description": "Stok kartı oluşturma ve düzenleme: kimlik, stok, fiyat, vergi, lojistik, muhasebe, görsel, birimler, özel alanlar, varyantlar ve reçeteler.",
  "module": "Stok & Depo",
  "version": 2,
  "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1,"label": "İşlem çubuğu","requires": ["component:kartSekmeleri","query:olustur","query:guncelle","query:birimEkle","query:birimSil","query:ozelKaydet"]},
