    "query:receteler": {"since": 1,"label": "Açılan kartı üreten reçeteler","requires": ["query:kart"]},
    "query:olustur": {"since": 1,"label": "Stok kartı oluştur","requires": ["component:ozelAlanlar","component:kod","component:ad","component:barkod","component:kategori","component:takipTuru","component:anaBirim","component:minimumStok","component:maksimumStok","component:yenidenSiparisNoktasi","component:emniyetStoku","component:tedarikSuresi","component:uretimSuresi","component:alisFiyati","component:satisFiyati","component:fiyatParaBirimi","component:alisIndirimi","component:satisIndirimi","component:alisKdv","component:satisKdv","component:otv","component:oiv","component:tevkifat","component:damgaVergisi","component:netAgirlik","component:brutAgirlik","component:uzunluk","component:genislik","component:yukseklik","component:alisHesabi","component:satisHesabi","component:maliyetHesabi","component:gorsel","component:pazaryeriKimligi"]},
    "query:guncelle": {"since": 1,"label": "Stok kartını güncelle","requires": ["query:kart","component:kod","component:ad","component:barkod","component:kategori","component:takipTuru","component:anaBirim","component:minimumStok","component:maksimumStok","component:yenidenSiparisNoktasi","component:emniyetStoku","component:tedarikSuresi","component:uretimSuresi","component:alisFiyati","component:satisFiyati","component:fiyatParaBirimi","component:alisIndirimi","component:satisIndirimi","component:alisKdv","component:satisKdv","component:otv","component:oiv","component:tevkifat","component:damgaVergisi","component:netAgirlik","component:brutAgirlik","component:uzunluk","component:genislik","component:yukseklik","component:alisHesabi","component:satisHesabi","component:maliyetHesabi","component:gorsel","component:pazaryeriKimligi"]},
    "query:birimEkle": {"since": 1,"label": "Kayıtlı karta birim ekle","requires": ["query:kart","component:birimIzgarasi"]},
    "query:birimSil": {"since": 1,"label": "Karttan birim sil","requires": ["query:kart","component:birimIzgarasi"]},
    "query:ozelKaydet": {"since": 1,"label": "Özel alanları kaydet","requires": ["query:kart","query:ozelDegerler","component:ozelAlanlar"]},
    "component:birimEkleDugmesi": {"since": 2,"label": "birimEkleDugmesi"},
    "component:birimSilDugmesi": {"since": 2,"label": "birimSilDugmesi"},
    "component:birimEklePenceresi": {"since": 2,"label": "birimEklePenceresi"},
    "component:birimEkleFormu": {"since": 2,"label": "birimEkleFormu"},
    "component:yeniBirimKodu": {"since": 2,"label": "yeniBirimKodu"},
    "component:yeniBirimKatsayisi": {"since": 2,"label": "yeniBirimKatsayisi"},
    "component:kartOzeti": {"since": 2,"label": "Stock card summary"},
    "component:negatifStokNotu": {"since": 2,"label": "Negative stock policy note","requires": ["query:negatifStok"]}
  },
  "definition": {
    "schemaVersion": 2,
    "components": [
      {"id": "komutlar","type": "actionBar","name": "komutlar","props": {"saveSequence": ["olustur","guncelle","ozelKaydet"],"stopOnError": true,"sequenceWhen": ["olustur=kart.rows[0].id == null && olustur.sonuc.id == null","guncelle=kart.rows[0].id != null","ozelKaydet=kart.rows[0].id != null"],"afterSaveAction": "page","afterSavePageCode": "@inventory-stock","afterSaveTarget": "sameTab","afterSaveRefresh": true,"newAction": "page","newPageCode": "@inventory-stock-create","newTarget": "sameTab","saveAndNew": true,"commandWhen": ["saveNew=kart.rows[0].id == null"],"hiddenCommands": ["open","delete","filter","print","export"],"slot": "commands"}},
      {"id": "kartOzeti","type": "recordHeader","name": "kartOzeti","props": {"icon": "box","title": "{{kart.rows[0].name}}","subtitle": "{{kart.rows[0].code}}","fields": ["Kategori={{kart.rows[0].category}}","Ana birim={{kart.rows[0].unitCode}}","Durum={{kart.rows[0].isActive}}"],"slot": "summary"}},
      {"id": "kartSekmeleri","type": "tabs","name": "kartSekmeleri","props": {"tabs": ["Genel=kimlikKarti,stokKarti","Fiyat ve vergi=fiyatKarti,vergiKarti","Lojistik ve muhasebe=lojistikKarti,muhasebeKarti,gorselKarti","Birimler=birimIzgarasi,birimEkleDugmesi","Varyantlar ve reçeteler=varyantListesi,receteListesi","Özel alanlar=ozelAlanlar"],"tabParam": "tab","slot": "tabs"}},
      {"id": "kimlikKarti","type": "formCard","name": "kimlikKarti","props": {"title": "Kimlik","columns": 3,"inputs": ["kod","ad","barkod","kategori","takipTuru","anaBirim"],"slot": "section"}},
      {"id": "kod","type": "input","name": "kod","props": {"inputType": "text","label": "Stok kodu","required": true,"maxLength": 64,"upperCase": true,"defaultValue": "{{kart.rows[0].code}}","slot": "field"}},
      {"id": "ad","type": "input","name": "ad","props": {"inputType": "text","label": "Stok adı","required": true,"maxLength": 200,"defaultValue": "{{kart.rows[0].name}}","slot": "field"}},
      {"id": "barkod","type": "input","name": "barkod","props": {"inputType": "text","label": "Barkod","maxLength": 64,"defaultValue": "{{kart.rows[0].barcode}}","slot": "field"}},
      {"id": "kategori","type": "input","name": "kategori","props": {"inputType": "select","label": "Kategori","optionsQuery": "kategoriler","optionValueColumn": "name","optionLabelColumn": "name","defaultValue": "{{kart.rows[0].category}}","slot": "field"}},
      {"id": "takipTuru","type": "input","name": "takipTuru","props": {"inputType": "select","label": "Lot / seri takibi","staticOptions": ["None=Yok","Lot=Lot","Serial=Seri"],"defaultValue": "{{kart.rows[0].trackingMode}}","slot": "field"}},
      {"id": "anaBirim","type": "input","name": "anaBirim","props": {"inputType": "text","label": "Ana birim","required": true,"maxLength": 8,"upperCase": true,"defaultValue": "{{kart.rows[0].unitCode}}","slot": "field"}},
      {"id": "stokKarti","type": "formCard","name": "stokKarti","props": {"title": "Stok yönetimi","columns": 3,"inputs": ["minimumStok","maksimumStok","yenidenSiparisNoktasi","emniyetStoku","tedarikSuresi","uretimSuresi"],"slot": "section"}},
      {"id": "minimumStok","type": "input","name": "minimumStok","props": {"inputType": "number","label": "Minimum stok","requiredWhen": "kart.rows[0].id != null","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].minimumStock}}","slot": "field"}},
      {"id": "maksimumStok","type": "input","name": "maksimumStok","props": {"inputType": "number","label": "Maksimum stok","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].maximumStock}}","slot": "field"}},
      {"id": "yenidenSiparisNoktasi","type": "input","name": "yenidenSiparisNoktasi","props": {"inputType": "number","label": "Yeniden sipariş noktası","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].reorderPoint}}","slot": "field"}},
      {"id": "emniyetStoku","type": "input","name": "emniyetStoku","props": {"inputType": "number","label": "Emniyet stoku","requiredWhen": "kart.rows[0].id != null","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].safetyStock}}","slot": "field"}},
      {"id": "tedarikSuresi","type": "input","name": "tedarikSuresi","props": {"inputType": "number","label": "Tedarik süresi (gün)","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 3650,"step": 1,"defaultValue": "{{kart.rows[0].procurementLeadTimeDays}}","slot": "field"}},
      {"id": "uretimSuresi","type": "input","name": "uretimSuresi","props": {"inputType": "number","label": "Üretim süresi (gün)","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 3650,"step": 1,"defaultValue": "{{kart.rows[0].manufacturingLeadTimeDays}}","slot": "field"}},
      {"id": "fiyatKarti","type": "formCard","name": "fiyatKarti","props": {"title": "Fiyat ve indirim","columns": 3,"inputs": ["alisFiyati","satisFiyati","fiyatParaBirimi","alisIndirimi","satisIndirimi"],"slot": "section"}},
      {"id": "alisFiyati","type": "input","name": "alisFiyati","props": {"inputType": "number","label": "Alış liste fiyatı","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].purchaseListPrice}}","slot": "field"}},
      {"id": "satisFiyati","type": "input","name": "satisFiyati","props": {"inputType": "number","label": "Satış liste fiyatı","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].salesListPrice}}","slot": "field"}},
      {"id": "fiyatParaBirimi","type": "input","name": "fiyatParaBirimi","props": {"inputType": "text","label": "Fiyat para birimi","maxLength": 3,"upperCase": true,"pattern": "^[A-Z]{3}$","patternMessage": "Üç harfli para birimi kodu girin (ör. TRY).","placeholder": "TRY","defaultValue": "{{kart.rows[0].priceCurrencyCode}}","slot": "field"}},
      {"id": "alisIndirimi","type": "input","name": "alisIndirimi","props": {"inputType": "number","label": "Alış iskonto %","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 100,"step": 0.0001,"defaultValue": "{{kart.rows[0].purchaseDiscountPercent}}","slot": "field"}},
      {"id": "satisIndirimi","type": "input","name": "satisIndirimi","props": {"inputType": "number","label": "Satış iskonto %","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 100,"step": 0.0001,"defaultValue": "{{kart.rows[0].salesDiscountPercent}}","slot": "field"}},
      {"id": "vergiKarti","type": "formCard","name": "vergiKarti","props": {"title": "Vergi","columns": 3,"inputs": ["alisKdv","satisKdv","otv","oiv","tevkifat","damgaVergisi"],"slot": "section"}},
      {"id": "alisKdv","type": "input","name": "alisKdv","props": {"inputType": "number","label": "Alış KDV %","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 100,"step": 0.0001,"placeholder": "20","defaultValue": "{{kart.rows[0].purchaseVatPercent}}","slot": "field"}},
      {"id": "satisKdv","type": "input","name": "satisKdv","props": {"inputType": "number","label": "Satış KDV %","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 100,"step": 0.0001,"placeholder": "20","defaultValue": "{{kart.rows[0].salesVatPercent}}","slot": "field"}},
      {"id": "otv","type": "input","name": "otv","props": {"inputType": "number","label": "ÖTV %","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 100,"step": 0.0001,"defaultValue": "{{kart.rows[0].exciseTaxPercent}}","slot": "field"}},
      {"id": "oiv","type": "input","name": "oiv","props": {"inputType": "number","label": "ÖİV %","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 100,"step": 0.0001,"defaultValue": "{{kart.rows[0].communicationTaxPercent}}","slot": "field"}},
      {"id": "tevkifat","type": "input","name": "tevkifat","props": {"inputType": "number","label": "Tevkifat %","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 100,"step": 0.0001,"defaultValue": "{{kart.rows[0].withholdingTaxPercent}}","slot": "field"}},
      {"id": "damgaVergisi","type": "input","name": "damgaVergisi","props": {"inputType": "number","label": "Damga vergisi %","requiredWhen": "kart.rows[0].id != null","min": 0,"max": 100,"step": 0.0001,"defaultValue": "{{kart.rows[0].stampTaxPercent}}","slot": "field"}},
      {"id": "lojistikKarti","type": "formCard","name": "lojistikKarti","props": {"title": "Lojistik","columns": 3,"inputs": ["netAgirlik","brutAgirlik","uzunluk","genislik","yukseklik"],"slot": "section"}},
      {"id": "netAgirlik","type": "input","name": "netAgirlik","props": {"inputType": "number","label": "Net ağırlık","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].netWeight}}","slot": "field"}},
      {"id": "brutAgirlik","type": "input","name": "brutAgirlik","props": {"inputType": "number","label": "Brüt ağırlık","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].grossWeight}}","slot": "field"}},
      {"id": "uzunluk","type": "input","name": "uzunluk","props": {"inputType": "number","label": "Uzunluk","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].length}}","slot": "field"}},
      {"id": "genislik","type": "input","name": "genislik","props": {"inputType": "number","label": "Genişlik","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].width}}","slot": "field"}},
      {"id": "yukseklik","type": "input","name": "yukseklik","props": {"inputType": "number","label": "Yükseklik","min": 0,"step": 0.0001,"defaultValue": "{{kart.rows[0].height}}","slot": "field"}},
      {"id": "muhasebeKarti","type": "formCard","name": "muhasebeKarti","props": {"title": "Muhasebe","columns": 3,"inputs": ["alisHesabi","satisHesabi","maliyetHesabi"],"slot": "section"}},
      {"id": "alisHesabi","type": "input","name": "alisHesabi","props": {"inputType": "text","label": "Alış hesap kodu","maxLength": 40,"defaultValue": "{{kart.rows[0].purchaseAccountCode}}","slot": "field"}},
      {"id": "satisHesabi","type": "input","name": "satisHesabi","props": {"inputType": "text","label": "Satış hesap kodu","maxLength": 40,"defaultValue": "{{kart.rows[0].salesAccountCode}}","slot": "field"}},
      {"id": "maliyetHesabi","type": "input","name": "maliyetHesabi","props": {"inputType": "text","label": "Maliyet hesap kodu","maxLength": 40,"defaultValue": "{{kart.rows[0].costAccountCode}}","slot": "field"}},
      {"id": "gorselKarti","type": "formCard","name": "gorselKarti","props": {"title": "Görsel ve pazaryeri","columns": 2,"inputs": ["gorsel","pazaryeriKimligi"],"slot": "section"}},
      {"id": "gorsel","type": "input","name": "gorsel","props": {"inputType": "text","label": "Ürün görseli bağlantısı","maxLength": 1000,"placeholder": "https://…","defaultValue": "{{kart.rows[0].productImageUrl}}","slot": "field"}},
      {"id": "pazaryeriKimligi","type": "input","name": "pazaryeriKimligi","props": {"inputType": "text","label": "Pazaryeri ürün kimliği","maxLength": 120,"defaultValue": "{{kart.rows[0].marketplaceProductId}}","slot": "field"}},
      {"id": "birimIzgarasi","type": "dataTable","name": "birimIzgarasi","props": {"title": "Birim dönüşümleri","query": "birimler","columns": ["unitCode","factorToBase"],"columnLabels": ["unitCode=Birim","factorToBase=Ana birim katsayışı"],"rowActions": ["birimSilDugmesi"],"emptyText": "Ana birim dı?ında ek birim yok.","slot": "lines"}},
      {"id": "ozelAlanlar","type": "customFieldsBlock","name": "ozelAlanlar","props": {"title": "Özel alanlar","definitionsQuery": "ozelTanimlar","valuesQuery": "ozelDegerler","columns": 2,"slot": "customFields"}},
      {"id": "varyantListesi","type": "dataTable","name": "varyantListesi","props": {"query": "varyantlar","columns": ["code","name","barcode","isActive"],"emptyText": "Bu kartın varyantı yok.","visibleWhen": "kart.rows[0].id != null"}},
      {"id": "receteListesi","type": "dataTable","name": "receteListesi","props": {"query": "receteler","columns": ["code","name","outputQuantity","isActive","orderCount"],"emptyText": "Bu stok kartını üreten reçete yok.","visibleWhen": "kart.rows[0].id != null"}},
      {"id": "birimEkleDugmesi","type": "button","name": "birimEkleDugmesi","props": {"text": "Birim ekle","actionType": "openDialog","dialogId": "birimEklePenceresi","disabledWhen": "kullanici.rol != 'TenantAdmin'","disabledReason": "Birim dönüşümlerini yaln?z firma y?neticisi de?i?tirebilir.","visibleWhen": "kart.rows[0].id != null","slot": "actions"}},
      {"id": "birimSilDugmesi","type": "button","name": "birimSilDugmesi","props": {"text": "Sil","actionType": "query","queryId": "birimSil","confirmEnabled": true,"confirmText": "Seçili birim dönüşümü silinsin mi?","refreshQueries": ["birimler"],"slot": "actions"}},
