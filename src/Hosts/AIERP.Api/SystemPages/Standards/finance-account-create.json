{
  "screenKey": "finance-account-create", "title": "Kasa/Banka kartı", "description": "Kasa ve banka hesap kartı oluşturma ve düzenleme: kod, ad, tür, döviz ve yalnız yeni kartta açılış bakiyesi.", "module": "Finans", "version": 2, "stage": "preview",
  "items": {
    "component:komutlar": {"since": 1, "label": "İşlem çubuğu", "requires": ["component:yeniKartDugmesi", "component:kartiAcDugmesi", "query:kart", "query:olustur", "query:guncelle", "component:ozet"]},
    "component:yeniKartDugmesi": {"since": 1, "label": "Yeni kart komutu", "requires": ["component:tur"]},
    "component:kartiAcDugmesi": {"since": 1, "label": "Kayıttan sonra oluşturulan kartı aç", "requires": ["query:kart", "query:olustur"]},
    "component:yeniBaslik": {"since": 1, "label": "Başlık (yeni kart)", "requires": ["query:kart"]},
    "component:kartBasligi": {"since": 1, "label": "Başlık (kayıtlı kart)", "requires": ["query:kart"]},
    "component:durumAktif": {"since": 1, "label": "Durum etiketi: Aktif", "requires": ["query:kart"]},
    "component:durumPasif": {"since": 1, "label": "Durum etiketi: Pasif", "requires": ["query:kart"]},
    "component:zorunluNotu": {"since": 1, "label": "Zorunlu alanlar notu", "requires": ["component:kod", "component:ad"]},
    "component:hesapKarti": {"since": 1, "label": "Kart bölümü: Hesap bilgileri", "requires": ["component:kod", "component:ad", "component:tur", "component:doviz", "component:acilisBakiyesi", "query:kart"]},
    "component:kod": {"since": 1, "label": "Alan: Kod", "requires": ["query:kart"]},
    "component:ad": {"since": 1, "label": "Alan: Ad", "requires": ["query:kart"]},
    "component:tur": {"since": 1, "label": "Alan: Hesap türü", "requires": ["query:kart"]},
    "component:doviz": {"since": 1, "label": "Alan: Döviz", "requires": ["component:kod", "query:kart"]},
    "component:acilisBakiyesi": {"since": 1, "label": "Alan: Açılış bakiyesi (yalnız yeni kart)", "requires": ["query:kart"]},
    "component:acilisNotu": {"since": 1, "label": "Açılış bakiyesi notu", "requires": ["component:acilisBakiyesi"]},
    "query:kart": {"since": 1, "label": "Açılan kasa/banka kartı"},
    "query:olustur": {"since": 1, "label": "Kasa/banka kartı oluştur", "requires": ["component:kod", "component:ad", "component:tur", "component:doviz", "component:acilisBakiyesi"]},
    "query:guncelle": {"since": 1, "label": "Kasa/banka kartını güncelle", "requires": ["component:kod", "component:ad", "component:tur", "component:doviz", "query:kart"]},
    "component:ozet": {"since": 1, "label": "Kayıt özeti (ad, kod, bakiye, hareket)", "requires": ["query:kart"]},
    "component:sekmeler": {"since": 1, "label": "Sekme: Hesap bilgileri", "requires": ["component:hesapKarti", "component:zorunluNotu", "component:acilisNotu"]}
  },
  "definition": {
    "schemaVersion": 2, "template": {"name": "record"},
    "components": [
      {"id": "komutlar", "type": "actionBar", "name": "komutlar", "props": {"saveSequence": ["olustur", "guncelle"], "stopOnError": true, "sequenceWhen": ["olustur=kart.rows[0].id == null && olustur.sonuc.id == null", "guncelle=kart.rows[0].id != null"], "newButton": "yeniKartDugmesi", "afterSaveButton": "kartiAcDugmesi", "saveAndNew": true, "commandWhen": ["saveNew=kart.rows[0].id == null"], "hiddenCommands": ["open", "delete", "filter", "print", "export"], "slot": "commands"}},
      {"id": "ozet", "type": "recordHeader", "name": "ozet", "props": {"icon": "wallet", "title": "{{kart.rows[0].name}}", "subtitle": "{{kart.rows[0].code}}", "fields": ["Bakiye={{kart.rows[0].balance}}", "Hareket={{kart.rows[0].transactionTotalCount}}"], "fieldFormats": ["Bakiye=money", "Hareket=number"], "fieldUnits": ["Bakiye={{kart.rows[0].currencyCode}}"], "slot": "summary"}},
      {"id": "sekmeler", "type": "tabs", "name": "sekmeler", "props": {"tabs": ["Hesap bilgileri=hesapKarti,zorunluNotu,acilisNotu"], "slot": "tabs"}},
      {"id": "yeniKartDugmesi", "type": "button", "name": "yeniKartDugmesi", "props": {"text": "Yeni", "actionType": "page", "pageCode": "@finance-account-create", "target": "sameTab", "params": ["accountType={{tur.value}}"], "slot": "actions"}},
      {"id": "kartiAcDugmesi", "type": "button", "name": "kartiAcDugmesi", "props": {"text": "Kartı aç", "actionType": "page", "pageCode": "@finance-account-create", "target": "sameTab", "params": ["accountId={{olustur.sonuc.id}}"], "visibleWhen": "kart.rows[0].id == null", "slot": "actions"}},
      {"id": "yeniBaslik", "type": "heading", "name": "yeniBaslik", "props": {"text": "Kasa/Banka Kartı Tanımlama", "pageTitle": true, "visibleWhen": "kart.rows[0].id == null", "slot": "above"}},
      {"id": "kartBasligi", "type": "heading", "name": "kartBasligi", "props": {"text": "{{kart.rows[0].code}} · {{kart.rows[0].name}}", "pageTitle": true, "visibleWhen": "kart.rows[0].id != null", "slot": "above"}},
      {"id": "durumAktif", "type": "badge", "name": "durumAktif", "props": {"text": "Aktif", "variant": "success", "visibleWhen": "kart.rows[0].isActive == true", "slot": "above"}},
      {"id": "durumPasif", "type": "badge", "name": "durumPasif", "props": {"text": "Pasif", "variant": "info", "visibleWhen": "kart.rows[0].isActive == false", "slot": "above"}},
      {"id": "zorunluNotu", "type": "text", "name": "zorunluNotu", "props": {"text": "* işaretli alanlar zorunludur: kod, ad ve döviz.", "slot": "note"}},
      {"id": "hesapKarti", "type": "formCard", "name": "hesapKarti", "props": {"title": "Hesap bilgileri", "columns": 3, "inputs": ["kod", "ad", "tur", "doviz", "acilisBakiyesi"], "recordKey": "{{kart.rows[0].id}}", "slot": "section"}},
      {"id": "kod", "type": "input", "name": "kod", "props": {"inputType": "text", "label": "Kod", "required": true, "maxLength": 40, "upperCase": true, "placeholder": "KASA-01", "defaultValue": "{{kart.rows[0].code}}", "slot": "field"}},
      {"id": "ad", "type": "input", "name": "ad", "props": {"inputType": "text", "label": "Ad", "required": true, "maxLength": 120, "defaultValue": "{{kart.rows[0].name}}", "slot": "field"}},
      {"id": "tur", "type": "input", "name": "tur", "props": {"inputType": "select", "label": "Hesap türü", "required": true, "defaultFirst": true, "staticOptions": ["Cash=Kasa", "Bank=Banka"], "defaultValue": "{{kart.rows[0].type}}{{sayfa.parametre.accountType}}", "disabledWhen": "kart.rows[0].id != null || sayfa.parametre.accountType != null", "disabledReason": "Hesap türü listeden gelir; hareketi olan hesabın türü değiştirilemez.", "slot": "field"}},
      {"id": "doviz", "type": "input", "name": "doviz", "props": {"inputType": "text", "label": "Döviz", "required": true, "maxLength": 3, "upperCase": true, "placeholder": "TRY", "pattern": "^[A-Za-z]{3}$", "patternMessage": "Döviz üç harfli kod olmalıdır (ör. TRY).", "defaultValue": "{{kart.rows[0].currencyCode}}", "emptyDefault": "TRY", "slot": "field"}},
      {"id": "acilisBakiyesi", "type": "input", "name": "acilisBakiyesi", "props": {"inputType": "number", "label": "Açılış bakiyesi", "step": 0.01, "visibleWhen": "kart.rows[0].id == null", "slot": "field"}},
      {"id": "acilisNotu", "type": "text", "name": "acilisNotu", "props": {"text": "Açılış bakiyesi yalnız yeni kartta girilir; sonra bakiye hareketlerden hesaplanır. Kasa açılış bakiyesi eksi olamaz. Hareketi olan hesabın türü ve dövizi değiştirilemez.", "slot": "note"}}
    ],
    "queries": [
      {"id": "kart", "name": "kart", "kind": "read", "operation": "finans.hesap.getir", "runOn": "load", "parameters": [{"name": "id", "binding": "{{sayfa.parametre.accountId}}", "type": "guid"}]},
      {"id": "olustur", "name": "olustur", "kind": "insert", "operation": "finans.hesap.olustur", "runOn": "manual", "parameters": [{"name": "code", "binding": "{{kod.value}}", "type": "text"}, {"name": "name", "binding": "{{ad.value}}", "type": "text"}, {"name": "type", "binding": "{{tur.value}}", "type": "text"}, {"name": "currencyCode", "binding": "{{doviz.value}}", "type": "text"}, {"name": "openingBalance", "binding": "{{acilisBakiyesi.value}}", "type": "decimal"}]},
      {"id": "guncelle", "name": "guncelle", "kind": "update", "operation": "finans.hesap.guncelle", "runOn": "manual", "parameters": [{"name": "id", "binding": "{{kart.rows[0].id}}", "type": "guid"}, {"name": "code", "binding": "{{kod.value}}", "type": "text"}, {"name": "name", "binding": "{{ad.value}}", "type": "text"}, {"name": "type", "binding": "{{tur.value}}", "type": "text"}, {"name": "currencyCode", "binding": "{{doviz.value}}", "type": "text"}]}
    ]
  }
}
