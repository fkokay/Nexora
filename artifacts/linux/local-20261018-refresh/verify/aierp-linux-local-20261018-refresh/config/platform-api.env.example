# Copy to /etc/nexora/platform-api.env, replace every CHANGE_ME value, then chmod 600.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
ConnectionStrings__Platform=Server=sql.example.com,1433;Database=AIERPPlatform;User Id=aierp_runtime;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
# Set only when Database__SeparationEnabled=true and the tenant database topology has been provisioned.
ConnectionStrings__Tenant=
Database__SeparationEnabled=false
Authentication__Issuer=AIERP
Authentication__Audience=AIERP
Authentication__SigningKey=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
PluginHost__SigningKey=CHANGE_ME_DIFFERENT_SECRET_AT_LEAST_32_BYTES
# Optional when integration queue encryption is enabled; base64 of exactly 32 random bytes.
# IntegrationQueue__EncryptionKey=
AIService__BaseUrl=http://127.0.0.1:5081
PluginHost__BaseUrl=
IntegrationHost__BaseUrl=
Frontend__Origins__0=https://erp.example.com
Frontend__Origins__1=https://studio.example.com
