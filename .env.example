# Copy this file to deploy/docker/.env and replace every value before starting containers.
MSSQL_SA_PASSWORD=Replace-With-A-Strong-Local-Password-123!
AUTH_SIGNING_KEY=Replace-With-A-Random-Secret-At-Least-32-Bytes
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=Replace-With-A-Strong-Admin-Password-123!
BOOTSTRAP_DISPLAY_NAME=Platform Admin
BOOTSTRAP_TENANT_NAME=Nexora Demo
WORKSPACE_ALLOWED_GIT_HOST=github.com
# Optional for private GitHub repositories. Install the GitHub App on the target repository.
# Contents: Read is enough for checkout; Contents: Write and Pull requests: Write enable PR publishing.
# Keep the private key only in deploy/docker/.env.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
# Optional: set this to enable AI features in Development Studio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
