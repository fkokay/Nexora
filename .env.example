# Copy this file to deploy/docker/.env and replace every value before starting containers.
MSSQL_SA_PASSWORD=Replace-With-A-Strong-Local-Password-123!
AUTH_SIGNING_KEY=Replace-With-A-Random-Secret-At-Least-32-Bytes
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=Replace-With-A-Strong-Admin-Password-123!
BOOTSTRAP_DISPLAY_NAME=Platform Admin
BOOTSTRAP_TENANT_NAME=Nexora Demo
# Enable only after the PlatformDB catalog migration is deployed; migrator provisions and copies each tenant DB.
DATABASE_SEPARATION_ENABLED=false
WORKSPACE_ALLOWED_GIT_HOST=github.com
# One-time GitHub App server setup; private repository installation is authorized in Studio per project.
# Contents: Read is sufficient for checkout. Keep the App private key only in deploy/docker/.env.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_APP_SETUP_CALLBACK_URL=http://localhost:5081/studio/github/setup-callback
GITHUB_STUDIO_REDIRECT_URL=http://localhost:5174/?app=studio
# Optional: set this to enable AI features in Development Studio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional public HTTPS ingress for the Development Studio only. Point DNS here and allow inbound 80/443.
PUBLIC_DOMAIN=studio.example.com
PUBLIC_INGRESS_ORIGIN=https://studio.example.com
# Optional encrypted off-host copy of existing production SQL backups to an S3-compatible service.
OFFSITE_BACKUP_PROVIDER=Other
OFFSITE_BACKUP_ENDPOINT=https://s3.example.com
OFFSITE_BACKUP_REGION=us-east-1
OFFSITE_BACKUP_BUCKET=replace-with-backup-bucket
OFFSITE_BACKUP_PREFIX=nexora
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=
# Generate with: rclone obscure '<long-random-password>'
OFFSITE_BACKUP_CRYPT_PASSWORD_OBSCURED=
OFFSITE_BACKUP_SYNC_INTERVAL_SECONDS=900
